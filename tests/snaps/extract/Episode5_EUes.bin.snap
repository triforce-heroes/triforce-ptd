{
  "CE_005020_0000_CER": "Si no te detienes...\r\n¡nunca te perdonaré!",
  "SM_005020_0210_FAS": "—Id con cuidado.\r\nQue Ávalon os proteja.",
  "CE_005110_0000_CER": "¡Solo queda la mitad!",
  "SM_005020_0020_CER": "—¡Ignis!",
  "CE_005820_0000_CER": "¡Tranquilo! ¡No pasa nada!",
  "BK_5010_0000_NAR": "Cheshire recuperó la cordura,\r\npero su violento ataque\r\nlo había dejado extenuado.",
  "BK_5000_0260_NAR": "Cheshire, cegado por la rabia, se volvió hacia Cereza,\r\nle mostró los dientes... ¡y se abalanzó sobre ella!",
  "IN_5000_0010_CER": "—¡Ya lo tienes, Cheshire!\r\n¡Se va a enterar!",
  "LV_005010_0020_NAR": "La voz firme de Cheshire\r\nle infundió valor.",
  "SM_005020_0060_FAS": "—Aunque he de reconocer que\r\nestoy impresionada de que hayas\r\nllegado tan lejos.",
  "BK_5000_0010_NAR": "Ante ellos se encontraba Púca,\r\nel hada ostentosa de antes.\r\nParecía un tanto chamuscada\r\npor la explosión.",
  "LV_005010_0010_NAR": "[FONT:10 ]Afila tus garras y lánzate.\r\nNo te permitas sentir miedo.[FONT:N ]",
  "BK_5000_0180_NAR": "Una vez más, Cheshire\r\nrechazó la oferta de Púca.",
  "SM_005020_0050_FAS": "—Hago lo que puedo. Ya te dije\r\nque es mi trabajo estar al tanto\r\nde lo que pasa en el bosque.",
  "BK_5000_0100_CER": "—¿Cheshire?",
  "IN_5000_0020_CER": "—¿Un... ángel?\r\n¿Qué pinta aquí?",
  "BK_5000_0060_NAR": "El hada Púca intentaba tentar\r\na Cheshire ofreciéndole el\r\nregreso a Inferno.\r\n¿De veras tenía el poder\r\nde abrir un portal allí mismo?",
  "LV_005905_0000_CER": "¿Te encuentras mejor, Cheshire?\r\n¿Te duele todavía?",
  "_01": "",
  "SM_005020_0180_FAS": "—Creo que es la razón por la que\r\nte adentraste en el bosque.",
  "BK_5000_0170_POO": "—¡Sabandija de trapo!\r\n¡Gato siervo de brujas!",
  "LV_005905_0030_CER": "Me alegro.",
  "CE_005010_0000_CER": "¡Para ya, Lukaon!",
  "CE_005120_0000_CER": "¡Bien! ¡El tercero!",
  "SM_005010_0020_CER": "—Tengo un presentimiento...\r\nLukaon está cerca. Estoy segura.",
  "BK_5010_0040_NAR": "Cheshire no replicó.\r\nAgotado, cerró los ojos.",
  "CE_005805_0010_NAR": "Cheshire reaccionó con furia\r\ny respondió con violentos gruñidos.",
  "CE_005810_0000_CER": "No podré aguantar mucho más...\r\n¡Pero no abandonaré a Cheshire así!",
  "BK_5010_0010_CER": "—Cheshire... ¿por qué\r\nno has entrado en el portal?",
  "CE_005835_0000_CER": "¡Cheshire, para!",
  "LV_005015_0000_NAR": "El viento helador soplaba sin piedad,\r\npero sus corazones no sentían el frío.",
  "CE_005090_0000_CER": "Me llevo lo que le robaste a Cheshire.",
  "CE_005050_0000_CER": "Si pudiera detener esa máquina...",
  "BK_5000_0110_NAR": "Cheshire se aproximó al portal.",
  "BK_5000_0030_POO": "—A ti no tengo nada que decirte,\r\nniña. Sin embargo, tu infernal\r\ncompañero aún tiene que\r\nresponder a mi... propuesta.",
  "CE_005830_0000_NAR": "[FONT:10 ]Vete...[FONT:N ]\r\nCheshire logró recuperar el control\r\npara pronunciar unas palabras.",
  "CE_005825_0010_CER": "¡Casi!",
  "LV_005010_0000_CER": "No tengo miedo.\r\n¿Estás listo, Cheshire?",
  "SM_005020_0150_FAS": "—Por eso estaba esperando...\r\nEsperaba a alguien que nos\r\ndespertara de este mal sueño.",
  "BK_5000_0000_POO": "—¡Alto ahí!",
  "BK_5000_0120_NAR": "Conforme se acercaba al umbral,\r\na Cereza la empezaron a asaltar\r\nlos recuerdos de su viaje juntos.",
  "BK_5000_0190_POO": "—¡Que así sea!\r\nPero las llamas de Inferno han de\r\nser alimentadas. Si tú no regresas,\r\n¡que vaya la niña en tu lugar!",
  "SM_005020_0110_FAS": "—Verás...",
  "LV_005905_0020_NAR": "Pero Cereza habría jurado\r\nque notaba cierta trepidación\r\nen su voz.",
  "CE_005060_0000_CER": "Solo queda uno.\r\n¡Aguanta, Cheshire!",
  "BK_5000_0070_POO": "—¿Y bien, demonio?\r\nYa despreciaste mi generosa oferta\r\nen una ocasión. ¿Cambiarás de\r\nparecer una vez que las llamas\r\nde Inferno te acaricien la melena?",
  "SM_005020_0080_FAS": "—Quizás tengas razón.\r\n¡La próxima vez, te pediré\r\nque me indiques el camino!",
  "LV_005020_0000_CER": "¡Vamos, Cheshire!",
  "CE_005150_0000_CER": "¡No dejaré que me arrebates\r\na Cheshire! ¡Olvídalo!",
  "CE_005815_0010_CER": "¡Aguanta, Cheshire!",
  "LV_005905_0010_NAR": "[FONT:10 ]Estoy bien.[FONT:N ]\r\nCheshire no dijo más.",
  "SM_005020_0120_FAS": "—Vivo en Ávalon desde hace\r\nuna eternidad. Antes era\r\nun hermoso lugar.",
  "LV_005910_0000_CER": "¡Uaaah!",
  "BK_5000_0040_POO": "—Demasiado tiempo has sufrido,\r\ndemonio, bajo el yugo opresor\r\nde la insignificante bruja.\r\n¡Abandónala! Si así lo haces,\r\nabriré con mis propias manos\r\nun portal hacia Inferno.",
  "CE_005805_0000_CER": "¿Estás ahí, Cheshire?\r\n¿No me reconoces?",
  "SM_005020_0160_CER": "—Ignis, ¿eras...?",
  "CE_005190_0000_CER": "¡Allá voy! ¡Cheshire!",
  "SM_005010_0030_NAR": "De algún modo sabía que,\r\nsi seguían avanzando, no\r\nhabría vuelta atrás.",
  "SM_005010_0000_NAR": "Habían regresado al bosque.\r\nApareció un nuevo sendero.",
  "LV_005005_0020_CER": "El corazón del bosque...\r\ndonde nos espera Lukaon.",
  "CE_005030_0000_CER": "Si la explosión me alcanza,\r\nestoy acabada.",
  "IN_5000_0000_CER": "—¡¿Otra vez?! Espera, algo\r\nha cambiado...",
  "CE_005100_0000_CER": "¡Vale, un elemento listo!",
  "IN_5000_0030_CER": "—¡Ya lo tienes, Cheshire!\r\n¡Se va a enterar!",
  "LV_005005_0010_CER": "Ya veo... Debe de ser la entrada.",
  "IN_5010_0010_CER": "—¿Estás preparado, Cheshire?\r\nYo no lo veo claro...",
  "SM_005020_0190_CER": "—¿Te refieres a... Lukaon?",
  "SM_005020_0200_FAS": "—Adelante.\r\nEl sello del altar está roto.",
  "SM_005010_0040_CER": "—Nos acercamos, Cheshire.\r\nEn cuanto estés preparado,\r\nacabaremos con esto.",
  "BK_5000_0240_NAR": "\r\nEntonces...",
  "BK_5010_0020_NAR": "[FONT:9 ]No me fío del raro ese[FONT:N ],\r\nrepuso Cheshire,\r\ny se dio media vuelta.",
  "CE_005820_0010_CER": "No te preocupes. Estoy contigo.",
  "LV_005900_0010_NAR": "Cheshire resopló con fastidio.\r\n[FONT:10 ]Ese engreído no tardará\r\nen asomar el hocico.[FONT:N ]",
  "BK_5010_0060_NAR": "Cereza le cantó una nana\r\nque recordaba de hacía tiempo.",
  "SM_005020_0040_CER": "—¡No podríamos haberlo logrado\r\nsin ti, Ignis! Tus consejos\r\nnos ayudaron muchísimo.",
  "SM_005020_0070_CER": "—Después de tanto recorrer el bosque,\r\ncreo que ya debemos conocerlo\r\nmejor que tú y todo...",
  "BK_5000_0230_NAR": "Cereza no obtuvo respuesta.\r\nPúca reía enloquecido.",
  "CE_005000_0000_CER": "¡Cheshire!\r\n¡Para, Lukaon! ¡Devuélvemelo!",
  "CE_005130_0000_CER": "¡Y el cuarto!\r\n¡Ya hemos recuperado todo\r\nlo que robaste, Lukaon!",
  "SM_005020_0030_FAS": "—Enhorabuena por destruir todos\r\nlos núcleos elementales. ¡Menudo\r\nrevuelo has causado entre las hadas!",
  "SM_005020_0000_FAS": "—Lo has conseguido, niña.",
  "CE_005800_0000_CER": "Cheshire...",
  "CE_005825_0000_CER": "¡Aaah!",
  "BK_5000_0090_NAR": "Con un aparatoso gesto, el hada\r\nabrió una enorme puerta ardiente.\r\nCereza notaba el calor desde\r\nlejos. A los sonidos familiares\r\ndel bosque se les unieron los\r\ntenues gritos de los condenados.",
  "LV_005005_0000_NAR": "Al haber destruido todos los núcleos elementales,\r\nla barrera de las hadas desapareció.",
  "SM_005020_0140_FAS": "—Corrompieron el bosque\r\ne intimidaron a sus habitantes.\r\nLas he visto hacer cosas terribles,\r\ny no fui capaz de evitarlo.",
  "CE_005080_0000_CER": "¡Oh, no, aléjate!",
  "SM_005020_0155_FAS": "—Lo habría hecho yo,\r\nsi todavía...",
  "BK_5000_0020_CER": "—Pero si es el autoproclamado rey.\r\n¿Qué pasa ahora?",
  "SM_005020_0170_FAS": "—Perdona, me he dejado llevar.\r\nUn poco más allá encontrarás\r\nlo que las hadas querían\r\nmantener lejos de tu alcance.",
  "CE_005040_0000_CER": "¡Con mi magia se arreglará!",
  "LV_005015_0010_NAR": "Juntos superarían cualquier obstáculo,\r\ny esa convicción hacía que sus almas\r\nbrillaran con más intensidad que el mismo sol.",
  "CE_005170_0000_CER": "¡Ñiiia!",
  "BK_5010_0030_CER": "—¿Significa eso que...\r\nconfías en mí?",
  "BK_5000_0250_CER": "—Cheshire, ¿qué ocurre?",
  "SM_005020_0100_CER": "—¿Esperando? ¿Por qué?",
  "SM_005020_0010_NAR": "Una voz resonó entre los árboles.\r\nEra uno de los pocos sonidos\r\ndel bosque que calmaban a Cereza.",
  "IN_5010_0000_NAR": "A partir de este punto\r\nno hay vuelta atrás.",
  "CE_005070_0000_CER": "¡Cheshireee!",
  "BK_5000_0220_CER": "—¿Qué le habéis hecho?",
  "CE_005805_0020_CER": "¿Qué puedo hacer?...\r\n¿Lo ayudará mi magia?",
  "SM_005010_0010_NAR": "Parecía llamar a Cereza.\r\nComo si una fuerza misteriosa\r\ntirase de ella.",
  "LV_005900_0000_CER": "¿Crees que el lobo blanco\r\nestá bien?",
  "CE_005180_0000_CER": "¡Ñiiiaaa!",
  "CE_005815_0000_CER": "¡Ahora!",
  "SM_005020_0090_FAS": "—Llevo mucho tiempo esperando\r\na alguien como tú, niña.",
  "SM_005020_0130_FAS": "—Las hadas lo cambiaron."
}
