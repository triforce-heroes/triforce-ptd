{
  "SM_003040_0080_NAR": "Wenn er nicht bald nach Inferno\r\nzurückkehrte, würde Cheshire gewiss\r\nsterben. Der Gedanke, dass er den\r\nHirngespinsten eines vernarrten\r\nKindes nachjagte, erzürnte ihn sehr.",
  "SM_003035_0020_CER": "„Weißt du, du hast mir noch\r\ngar nicht verraten, wie du heißt!“",
  "SM_003020_0030_NAR": "Cheshire schüttelte bloß den Kopf,\r\ndenn seine Stimme hätte gewiss\r\nverraten, wie aufgewühlt er war.",
  "CE_003040_0010_CER": "Ich muss ihm helfen!",
  "SM_003020_0080_CER": "„Wenn ich eine Umbra-Hexe werden will,\r\nkann ich mich doch nicht von so einer\r\nübergroßen Eidechse einschüchtern lassen.\r\nNächstes Mal ist er dran, Cheshire!“",
  "SM_003035_0010_CER": "„W-wirklich? Danke...“",
  "SM_003020_0000_NAR": "Mit geborstener Panzerung ergriff\r\nder Drache hastig die Flucht.",
  "SM_003080_0040_FAS": "„Ihr seid doch nicht\r\netwa verletzt, oder?“",
  "SM_003010_0040_NAR": "Diesmal gab Cheshire keine\r\nspöttische Bemerkung von sich.",
  "SM_003035_0080_LUC": "„Doch als Hexe hast\r\ndu sicherlich die Kraft,\r\ndiesen Fluch zu brechen.“",
  "SM_003080_0200_FAS": "„Ich könnte euch also rasch an Orte\r\nbringen, die ihr bereits besucht habt.“",
  "CE_003050_0000_CER": "Lass es dir schmecken.\r\nStopf dich voll, bis du platzt!",
  "LV_003010_0000_CER": "Hey, dieser Ort...",
  "SM_003050_0140_MOR": "„Vergiss das nie, wenn du dich in weitere\r\nKämpfe mit den Monstern des Waldes\r\nstürzen und diese auch überleben willst.“",
  "LV_003910_0040_CER": "Ich... will stärker werden!",
  "BK_3000_0030_CER": "„Du machst mir keine Angst...\r\nNicht mehr!“",
  "SM_003030_0010_NAR": "Cheshire wandte sich ab.\r\nEr wirkte beinahe so mürrisch wie nach\r\nihrer letzten Begegnung mit der Kreatur.",
  "SM_003035_0120_LUC": "„So ist es... Unzählige Monde sind\r\nvergangen, doch sie wartet noch\r\nimmer außerhalb des Waldes auf mich.“",
  "BK_3030_0070_CER": "\r\n„Cheshire!“",
  "LV_003920_0000_CER": "Ich... Nein... Ich kann nicht...",
  "SM_003050_0130_MOR": "„Der Wert einer Hexe wird daran\r\ngemessen, wie gut sie Dämonen\r\nkontrollieren kann.“",
  "LV_003035_0010_NAR": "Knurrend drängte Cheshire\r\nCereza dazu weiterzugehen.",
  "SM_003035_0150_LUC": "„Wir können diesen Wald gemeinsam\r\nverlassen. Ich werde dir helfen,\r\ndeine Mutter zu retten.\r\n\r\nUnd dann werden wir beide wieder\r\nmit unseren Familien vereint sein!“",
  "LV_003020_0000_CER": "Sind das... Krallenspuren?",
  "BK_3030_0080_NAR": "Es war nur noch eine Frage der Zeit, bis\r\nCheshire überwältigt werden würde. Sollte\r\ndies das Ende der Geschichte sein...?",
  "LV_003035_0020_NAR": "Cereza wiederum fehlte die Kraft,\r\nirgendetwas darauf zu erwidern.",
  "SM_003030_0050_NAR": "Cerezas gute Laune war\r\naugenblicklich ruiniert.",
  "SM_003050_0090_MOR": "„Hör zu, ich habe mit den Vorbereitungen\r\nbegonnen, um dich aus diesem Wald zu holen.“",
  "LV_003905_0010_NAR": "Der Körper der Kreatur war hart\r\nwie Stahl. Cheshire gab ein\r\nfrustriertes Knurren von sich.",
  "LV_003040_0000_NAR": "In der Ferne konnte Cereza den Wasser-\r\nschrein ausmachen. Davor befand sich\r\nein seltsames Objekt aus Metallrohren.",
  "SM_003080_0070_CER": "„Du weißt das doch sicher, oder?“",
  "CE_003805_0000_CER": "Das... Das könnte funktionieren!",
  "BK_3020_0090_NAR": "Von ihrer Angst überwältigt griff\r\nCereza nach Cheshire und rannte davon.",
  "LV_003025_0000_NAR": "Teile eines uralten, umgestürzten Baumes\r\nragten ihr wie Reißzähne entgegen.",
  "SM_003035_0060_CER": "„Lukaon, wer bist du?\r\nWieso hilfst du mir\r\nimmer wieder?“",
  "SM_003020_0070_NAR": "Ein Teil von ihm begriff, dass nur\r\nCereza ihn davor bewahrt hatte,\r\nals Drachenfutter zu enden.\r\n\r\nDoch er akzeptierte es nicht,\r\nvon jemandem gerettet zu werden,\r\nden er als so unterlegen betrachtete.",
  "SM_003080_0030_FAS": "„Und einen weiteren Elementarkern\r\nhabt ihr auch zerstört – dennoch\r\nseht ihr nicht sehr glücklich aus.“",
  "LV_003050_0020_NAR": "Doch sie wusste, dass es zu\r\nspät war, um umzukehren.",
  "LV_003045_0030_CER": "Ich... Ich...",
  "LV_003915_0000_NAR": "Cereza hielt die Tränen zurück und\r\nzwang sich mit all ihrer Kraft vorwärts.",
  "LV_003050_0010_NAR": "Kaum hatte sie dies ausgesprochen,\r\nwurde Cereza von kalter Angst gepackt.",
  "SM_003010_0000_NAR": "Sie waren mit dem Leben davongekommen,\r\ndoch Cheshire war außer sich vor Wut\r\nangesichts Cerezas feigen Rückzugs.",
  "SM_003040_0070_CER": "„I-ich weiß, wie das klingt,\r\naber bisher stimmte doch alles!\r\nWas die Elementarkerne betrifft,\r\nhatte Lukaon ja auch recht, oder?\r\nDas sind keine bloßen Träume!“",
  "SM_003080_0190_FAS": "„Ich kenne übrigens alle\r\ngeheimen Pfade dieses Waldes.“",
  "SM_003080_0000_FAS": "„Sieh an, wen haben wir denn hier?\r\nIch bin ehrlich gesagt erstaunt,\r\ndass ihr es so weit geschafft habt.“",
  "CE_003020_0000_CER": "Ah!",
  "SM_003080_0140_FAS": "„Niemand, der diese Festung betrat,\r\nhat sie je wieder verlassen.\r\nWillst du dennoch dorthin?“",
  "SM_003020_0100_NAR": "Der stolze Dämon wandte sich ab\r\nund tat so, als hörte er sie gar nicht.",
  "LV_003060_0000_CER": "Ich muss Cheshire helfen!",
  "SM_003035_0110_CER": "„Das heißt, auch du versuchst,\r\ndeine Mutter zu finden?“",
  "SM_003020_0090_NAR": "Bei diesen Worten erkannte Cheshire\r\netwas in Cereza, das dem\r\nängstlichen Kind, als das er sie\r\nkennengelernt hatte, noch fehlte.",
  "PH_3020_0000_CER": "Es muss irgendeine Möglichkeit\r\ngeben, ihn zu retten!",
  "SM_003080_0170_FAS": "„Dann wiederum... Bei eurer\r\nZusammenarbeit habt ihr vielleicht\r\nwirklich nichts zu befürchten.“",
  "LV_003075_0020_NAR": "Wofür sie wohl einst genutzt wurden...?\r\nCereza dachte kurz darüber nach und\r\nverwarf den Gedanken dann lieber.",
  "SM_003020_0020_CER": "„Cheshire, alles in Ordnung?\r\nBist du irgendwie verletzt?“",
  "SM_003040_0100_CER": "„Von Lukaon könntest du noch einiges\r\nüber den Umgang mit Damen lernen...“",
  "SM_003040_0010_NAR": "Cheshire bemerkte Cerezas\r\ngerötete Wangen und starrte\r\nsie neugierig an.",
  "BK_3000_0020_NAR": "Es war an der Zeit, endgültig\r\nmit der Kreatur abzurechnen.",
  "SM_003050_0120_CER": "„J-ja, Herrin!“",
  "LV_003005_0000_CER": "Was ist das...?",
  "LV_003010_0010_NAR": "Hier waren sie bereits einmal gewesen.\r\nIhre Wanderung durch den Wald hatte\r\nsie an den Anfang zurückgebracht.",
  "SM_003080_0100_CER": "„Komm schon, spann uns\r\nnicht auf die Folter!“",
  "SM_003080_0090_CER": "„Jetzt klingst du\r\nwie meine Lehrerin!“",
  "SM_003035_0180_LUC": "„Mir geht es genauso. Nie zuvor bin\r\nich jemandem begegnet, der meinen\r\nSchmerz verstand... meinen Traum teilte...“",
  "BK_3030_0050_NAR": "Cheshire setzte der Kreatur immer\r\nweiter heftig zu, doch mit jedem\r\nSchlagabtausch verlor er an Boden.",
  "BK_8110_0030_CER": "„Mag schon sein, dass auch sie dich\r\nnicht nach Hause bringt, aber sie hilft\r\nuns sicher, unserem Ziel näherzukommen!“",
  "SM_003050_0070_NAR": "Lobende Worte von Morgana waren so\r\nselten wie ein Iglu in Inferno. Es\r\nkostete Cereza enorme Willenskraft,\r\nnicht an Ort und Stelle freudige\r\nLuftsprünge zu vollführen.",
  "SM_003050_0000_MOR": "„Cereza, dir geht es gut!\r\nSaba sei Dank...“",
  "LV_003905_0000_CER": "Uff... Das bringt nichts.\r\nEr ist zu stark!",
  "LV_003910_0050_CES": "Was kannst du schon ausrichten?\r\nJeder weiß doch, was für eine\r\nVersagerin du bist.",
  "BK_3030_0130_CER": "„Ich muss stark sein,\r\num eine richtige Hexe zu werden!“",
  "BK_3030_0020_NAR": "Ehe sie wusste, was sie tat, flüchtete\r\nCereza sich ins nächstbeste Versteck.\r\nCheshire dahingegen stürzte sich\r\nohne zu zögern auf den Feind.",
  "SM_003035_0050_LUC": "„Cereza... Welch schöner Name.“",
  "BK_3030_0100_CER": "„Ich kann noch immer... niemanden retten...“",
  "BK_3030_0010_NAR": "[FONT:9 ]Versteck dich irgendwo![FONT:N ]\r\nbrüllte Cheshire und\r\nmachte sich kampfbereit.",
  "BK_3030_0090_CER": "„I-ich kann's nicht...“",
  "SM_003050_0040_NAR": "Cereza konnte ihre kindliche Freude\r\nnicht zurückhalten und erzählte, wie\r\nsie den Jabberwock erledigt hatten.",
  "BK_8110_0000_CER": "„Ein neues Element!“",
  "SM_003020_0050_CER": "„Ich frage mich, ob dieser Feendrache\r\nnoch mal zurückkommt. Aber jetzt\r\nwissen wir immerhin, dass er\r\nnicht unbesiegbar ist!“",
  "CE_003010_0000_CER": "Cheshire!\r\nLass uns deine Erdkräfte nutzen!",
  "SM_003040_0060_NAR": "Cheshire war sprachlos.\r\nSie hatte den Wald betreten\r\naufgrund eines schleierhaften\r\nVersprechens, das ihr ein Junge\r\nin einem Traum gegeben hatte?!",
  "SM_003010_0010_CER": "„...“",
  "LV_003045_0010_NAR": "Mit tollkühner Stimme ließ Cheshire\r\nseine Kampfansage verlauten,\r\ndamit sie Cereza nicht entging.",
  "LV_003050_0000_CER": "Ich frage mich, ob wir hier im\r\nRevier jener Kreatur sind...",
  "LV_003080_0010_CER": "Bitte! Du musst mich zum\r\nletzten Elementarkern bringen!",
  "_31": "",
  "LV_003045_0020_NAR": "Doch ihre Sorge ließ sich\r\ndamit nicht zerstreuen.",
  "SM_003080_0130_FAS": "„Und zwar in einer Festung,\r\nin der nur die boshaftesten\r\naller Feen hausen.“",
  "BK_3020_0000_NAR": "Die stahlharten Flügel der\r\nKreatur ließen Cheshires Klauen\r\nwie Spielzeugkrallen wirken.",
  "SM_003035_0160_CER": "„Lukaon... In Ordnung...\r\nIch werde mein Bestes geben!“",
  "BK_3000_0010_CER": "„Die Kreatur!“",
  "SM_003035_0085_LUC": "„Darüber hinaus...“",
  "LV_003910_0060_CER": "Mami... Mami hat an mich geglaubt!",
  "LV_003920_0020_CER": "Aaah...\r\nSchluss damit...\r\nRuhe!",
  "LV_003070_0020_NAR": "Cheshires Antwort klang gereizt.\r\nEr konnte den Kampf kaum erwarten.",
  "SM_003035_0100_LUC": "„Es geht um deinen Traum...\r\nDu sehnst dich danach, deine\r\nMutter zu retten, nicht wahr?\r\n\r\nDieses traurige Gefühl kenne\r\nich selbst nur zu gut.“",
  "SM_003080_0210_FAS": "„Wenn ich euch den Weg weisen\r\nsoll, sagt mir einfach Bescheid.“",
  "SM_003030_0030_NAR": "Cheshire fing an zu nörgeln, dass\r\nCerezas ständiges Hin und Her\r\nden Kampf erschwert hätte.",
  "SM_003035_0130_LUC": "„Ich will zu ihr, ihre Tränen trocknen...“",
  "LV_003920_0010_CER": "W-was?!",
  "LV_003065_0000_CER": "Das scheint von der Kreatur abgefallen\r\nzu sein... Sie ist also nicht unbesiegbar!",
  "LV_003070_0010_NAR": "[FONT:10 ]Als ob ich jetzt umkehren würde![FONT:N ]",
  "SM_003080_0220_FAS": "„Seht es als meine Art, mich dafür\r\nerkenntlich zu zeigen, dass ihr euch\r\num diese lästigen Feen kümmert.“",
  "SM_003030_0000_NAR": "Sie hatten den fürchterlichen\r\nJabberwock besiegt.\r\nCereza war ganz außer sich!",
  "SM_003030_0080_CER": "„Ah!“",
  "SM_003050_0030_CER": "„Morgana, ich habe ein\r\nriesiges Monster besiegt!\r\nDas hättest du sehen sollen!“",
  "CE_003040_0000_CER": "Cheshire!",
  "SM_003010_0060_NAR": "[FONT:9 ]Komm mir nur nicht in die Quere![FONT:N ]\r\nwar alles, was dem Dämon noch einfiel.",
  "SM_003040_0090_NAR": "[FONT:9 ]Schaffe ich es nicht nach Inferno\r\nzurück, wird meine letzte Tat in\r\ndieser elenden Welt darin bestehen,\r\ndich in Stücke zu reißen![FONT:N ]\r\nbrüllte der aufgebrachte Dämon.",
  "SM_003040_0020_CER": "„Hmm?\r\nE-es ist nichts.\r\n\r\nAh, aber es gibt da etwas, das ich dir\r\nbei dieser Gelegenheit erklären sollte.“",
  "SM_003010_0050_NAR": "Er dachte an den Kampf zurück.\r\nEs war das erste Mal, dass er\r\neine Niederlage erlitten hatte, und\r\nes gefiel ihm ganz und gar nicht.",
  "LV_003075_0010_CER": "Sieh dir all die Käfige an...",
  "SM_003010_0020_NAR": "Cereza stand schweigend da, die Hände zu\r\nFäusten geballt. Mehr als alles andere\r\nwar sie wütend auf sich selbst, da sie\r\nerneut die Furcht hatte siegen lassen.",
  "SM_003020_0060_NAR": "Der Kampf hatte Cereza neue\r\nKraft und auch etwas mehr\r\nSelbstbewusstsein verliehen.\r\nCheshire dahingegen war mürrisch.",
  "SM_003080_0020_FAS": "„Ich hätte mir nie träumen lassen,\r\ndass einmal eine Hexe des Weges\r\nkommt und ihn besiegt.“",
  "LV_003025_0010_NAR": "Cereza wurde das Gefühl nicht los,\r\ndass der Wald von Avalon selbst\r\nsich gegen sie verschworen hatte.",
  "BK_3020_0080_NAR": "[FONT:9 ]Du erbärmlicher Schwächling![FONT:N ]\r\nSein knuddeliger Körper nahm den\r\nharschen Worten nichts an Schärfe.",
  "LV_003030_0000_CER": "Was war das?!",
  "SM_003080_0010_FAS": "„Sogar um den Jabberwock, der selbst\r\nunter den Feen als besonders brutal\r\ngilt, habt ihr euch gekümmert.“",
  "SM_003035_0040_CER": "„Ich heiße Cereza.“",
  "SM_003080_0180_FAS": "„Auch ich bin diese grausamen Feen\r\nleid. Ich hoffe, ihr könnt ihnen\r\neinmal zeigen, was Sache ist!“",
  "SM_003050_0200_CER": "„Uff, du bist ein hoffnungsloser Fall!“",
  "LV_003900_0000_CER": "Juchhuuu!\r\nIch fliege!",
  "LV_003915_0010_NAR": "„Ich darf nicht weinen... Ich muss stark\r\nsein!“, flüsterte sie sich leise zu,\r\ndamit Cheshire es nicht hörte.",
  "SM_003035_0140_LUC": "„Cereza, bitte brich meinen Fluch. Wenn\r\ndu den letzten Elementarkern zerstörst und\r\nzum Herzen des Waldes findest, wird mein\r\nTraum... unser Traum in Erfüllung gehen.“",
  "LV_003020_0010_CER": "Nie im Leben... So große Krallen\r\nhat doch niemand... stimmt's?",
  "LV_003035_0000_NAR": "[FONT:10 ]Du willst den nächsten Elementarkern\r\nfinden, stimmt's? Dann los![FONT:N ]",
  "SM_003080_0050_CER": "„Nein, es geht uns gut.“",
  "SM_003050_0150_NAR": "Nachdem Morganas Erscheinung fort\r\nwar, knurrte Cheshire wütend.",
  "LV_003910_0020_CER": "Ich... will nicht mehr weglaufen!",
  "SM_003050_0110_MOR": "„Die Feenmagie, die den Wald von Avalon\r\nschützt, ist von immenser Stärke. Es\r\nwird ein ähnlich mächtiger Zauber nötig\r\nsein, um dagegen anzukommen. Ich habe\r\neinen Zauberspruch begonnen, doch wird\r\ner erst zum Morgengrauen vollendet sein.\r\nBis dahin musst du überleben.“",
  "SM_003080_0060_CER": "„Hey, wieso verrätst du uns nicht,\r\nwo wir den letzten Elementarkern\r\nfinden können?“",
  "LV_003040_0010_NAR": "Es war ein Käfig – groß genug, dass\r\nMorganas ganzes Haus hineingepasst hätte.",
  "LV_003055_0000_CER": "Wir nähern uns der Kreatur...\r\nSie ist nicht mehr fern, das spüre ich.",
  "SM_003050_0080_MOR": "„Ich denke, du bist bereit für\r\nstärkere magische Techniken.\r\nMit ihnen wirst du in der Lage sein,\r\ndie wahre Macht deines Begleiters\r\nzu entfesseln.“",
  "LV_003910_0000_CES": "Du läufst also vor allem davon?\r\nUnd so willst du eine Hexe werden?",
  "CE_003030_0000_CER": "Oh, oh, was ist jetzt los?\r\nIch glaube, wir haben ihn wütend gemacht.",
  "SM_003050_0050_MOR": "„Es grenzt an ein Wunder, dass du\r\ndas unbeschadet überstanden hast.\r\nIch hatte dich doch angewiesen, dir\r\neinen sicheren Unterschlupf zu suchen!“",
  "SM_003030_0090_NAR": "Sie unterbrachen ihren Streit\r\nund eilten los, um mit dem\r\nweißen Wolf Schritt zu halten.",
  "SM_003035_0030_LUC": "„Ich bin Lukaon.\r\nUnd du?“",
  "LV_003070_0000_CER": "Ich laufe nicht mehr davon.\r\nKomm, Cheshire!",
  "SM_003030_0020_CER": "„Was schmollst du denn jetzt schon\r\nwieder? Wir haben gewonnen!“",
  "SM_003035_0000_LUC": "„Erstaunlich, ihr habt den mächtigen\r\nJabberwock bezwungen. Kaum zu\r\nglauben, dass du dasselbe Mädchen\r\nbist, das ich ganz allein schluchzend\r\nin einem Albtraum vorgefunden habe.\r\nDu bist zweifellos stärker geworden.“",
  "BK_3030_0040_NAR": "Seine Klauen fanden ihr Ziel,\r\ndoch wie schon zuvor war die Kreatur\r\ndavon gänzlich unbeeindruckt.",
  "LV_003920_0030_NAR": "[FONT:10 ]Reiß dich zusammen! Weiter![FONT:N ]\r\nbrüllte der Dämon, um die benommene\r\nCereza voranzutreiben.",
  "SM_003050_0010_NAR": "Vor Cereza erschien ein weiteres\r\nMal Morganas Projektion.\r\n\r\nSie wirkte erleichtert.\r\n",
  "SM_003050_0100_CER": "„Was?“",
  "SM_003050_0060_MOR": "„Offen gestanden bin ich allerdings\r\nüberrascht. Womöglich bist du\r\nstärker geworden, als ich dachte.“",
  "LV_003005_0010_CER": "Hat uns jemand beobachtet...?",
  "LV_003910_0030_CES": "Du hast Angst, nicht wahr?\r\nGeh doch in die Ecke und heule, Feigling!",
  "SM_003050_0180_NAR": "Cheshire schnaubte nur.",
  "BK_3000_0000_NAR": "Mampf, mampf...",
  "PH_3020_0010_CER": "Da!",
  "SM_003035_0090_CER": "„Was denn?“",
  "LV_003075_0000_NAR": "Kaputte Käfige lagen überall verstreut.",
  "LV_003060_0010_CER": "Es muss etwas geben, das ich tun kann!",
  "BK_3020_0060_NAR": "Cheshire versuchte verzweifelt, sich zu\r\nverwandeln, doch Cereza war so verängstigt,\r\ndass ihre Magie versagte.",
  "CE_003020_0010_CER": "Uff!",
  "SM_003040_0000_NAR": "Eine weitere Begegnung mit Lukaon.\r\nDie Erinnerung an den Traum ließ\r\nCerezas junges Herz höher schlagen.",
  "SM_003010_0070_CER": "„...“",
  "LV_003015_0000_CER": "Okay, wow, das ist echt hoch...\r\nAlles wird gut. Nur nicht... runterschauen...",
  "SM_003040_0110_CER": "„Ich habe nichts gesagt! Komm,\r\nsuchen wir den nächsten Kern.“",
  "SM_003080_0160_FAS": "„Das bleibt zu hoffen...“",
  "BK_3020_0050_NAR": "Wie ein Falke, der nach Mäusen Ausschau hält,\r\nsuchte der Feendrache nach seiner Beute.",
  "LV_003045_0000_NAR": "[FONT:10 ]Wenn dieses hässliche Viech noch\r\nmal auftaucht, hau ich es zu Brei![FONT:N ]",
  "LV_003080_0000_CER": "Der weiße Wolf!\r\nSchön, dass es dir gut geht!",
  "SM_003050_0210_NAR": "Und damit war Cerezas gute Laune\r\nebenso schnell wieder verflogen,\r\nwie sie aufgekommen war.",
  "SM_003010_0080_NAR": "Cereza war so in Verzweiflung\r\nversunken, dass sie seine\r\nWorte kaum wahrnahm.",
  "SM_003080_0110_FAS": "„Ojemine...“",
  "SM_003080_0080_FAS": "„Meine Kleine... Eile mit Weile,\r\nwie ich immer zu sagen pflege.“",
  "SM_003020_0040_CER": "„Was für eine Erleichterung...“",
  "SM_003035_0170_CER": "„Ich möchte mehr über dich erfahren.\r\nWir haben so viel gemeinsam!“",
  "SM_003080_0120_FAS": "„Der letzte Elementarkern...\r\nliegt in einem besonders\r\nheiklen Teil dieses Waldes.“",
  "BK_3020_0010_NAR": "Die Kreatur hatte ein neues Opfer erspäht.\r\nCereza wusste, dass sie kämpfen\r\nmusste, doch sie war starr vor Angst.",
  "SM_003010_0030_CER": "„Cheshires Angriffe konnten\r\ngegen den Panzer dieser Kreatur\r\nnicht das Geringste ausrichten...\r\n\r\nW-was soll ich bloß tun?“",
  "SM_003040_0040_NAR": "Cereza erzählte Cheshire, wieso sie\r\nden Wald von Avalon betreten hatte.\r\nDass ihr Lukaon im Traum erschienen war,\r\ndass sie ihre Mutter retten wollte, und\r\ndass ihr eine Kraft versprochen wurde,\r\ndie im Herzen des Waldes auf sie wartete.",
  "CE_003000_0000_CER": "Komm schon, lass mich dir helfen!",
  "BK_3030_0120_CER": "„Ich laufe nicht mehr davon!“",
  "SM_003035_0070_LUC": "„Ein mächtiger Fluch hält mich\r\ngefangen, tief im Herzen dieses Waldes.“",
  "SM_003050_0170_CER": "„Ach, Morgana redet immer so.\r\nKeine Sorge, ich weiß ja, dass du\r\nnicht einfach bloß eine Waffe bist!\r\n\r\nAber es würde dich nicht umbringen,\r\nab und zu auf mich zu hören.“",
  "SM_003080_0150_CER": "„Oh, darauf kannst du Gift nehmen!\r\nIch bin eine Hexe. Und ich bin jetzt\r\nviel stärker als zu Beginn meiner\r\nReise durch diesen Wald!“",
  "SM_003050_0020_MOR": "„Cereza, du siehst... verändert\r\naus. Ist irgendetwas vorgefallen?“",
  "BK_8110_0010_CER": "„Was ist los? Hast du\r\nnicht mal mehr Interesse\r\nan einer neuen Kraft?“",
  "BK_3030_0000_NAR": "Erneut standen sie der\r\nKreatur gegenüber.",
  "CE_003800_0000_CER": "Das würde bestimmt sehr weh tun...\r\nKonzentrier dich! Du musst weiter!",
  "BK_3030_0110_CER": "„...Nein! Nicht schon wieder!“",
  "SM_003030_0060_CER": "„Du weißt aber schon, dass du diesen\r\nFeendrachen nur dank meiner Hilfe\r\nbesiegen konntest, hm? Wie wär's\r\nmit etwas Dankbarkeit?“"
}
