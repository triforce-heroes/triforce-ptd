{
  "BK_9080_0360_NAR": "Den restlichen Verlauf des Abenteuers von\r\nCereza und Cheshire kennen wir, doch wie\r\nsteht es um Jeanne? Was geschah mit ihr,\r\nnachdem sie von ihrem Schicksal erfahren hatte?",
  "BK_9040_0080_NAR": "Sie war ihr so nah! Doch wer auch\r\ndahintersteckte, schien entschlossen,\r\ndie zwei Mädchen getrennt zu halten.\r\nCharles fletschte die Zähne und\r\nbegann zu knurren.",
  "SM_009010_0260_JEA": "„Sehr gut, Dämon. Also dann...\r\nAb in den neuen Körper mit dir!“",
  "LV_009045_0000_SIN": "Meine tapfere Freundin...\r\nIch rate dir, umzukehren...",
  "BK_9020_0030_NAR": "Viele Jahre schon hatte dieses junge Mädchen\r\nCereza aus der Ferne beschützt und behütet.\r\nIhr Name war Jeanne und auch sie war eine\r\nUmbra-Hexe, die am Anfang ihrer Ausbildung stand.",
  "BK_9060_0060_JEA": "„Nein... Nein...\r\nLass ihn los!“",
  "LV_009035_0000_JEA": "Was ist das für ein Ort?\r\nEs stinkt total nach diesen Feen hier...",
  "SM_009020_0210_JEA": "„Aber dein jetziger Körper ist doch sicher\r\nbesser als dieser Fetzenhaufen, den Cereza\r\nmit sich herumschleppt?“",
  "BK_9040_0130_SIN": "Ja... Nenne mich einfach...\r\njenen, der alle Phänomene bestätigt.“",
  "SM_009020_0170_NAR": "Charles blinzelte ungläubig.\r\nNach Inferno... heimschicken?\r\nDas kam unerwartet. Verfügte\r\nJeanne über derartige Kräfte?",
  "CE_009805_0000_SIN": "Jeanne, verlasse diesen Ort.\r\nEs ist noch nicht zu spät.",
  "BK_9080_0350_NAR": "Und so endete das Abenteuer\r\nvon Jeanne und Charles.",
  "SM_009010_0130_NAR": "Jeanne kannte Cereza sehr gut. Mit der\r\nvon einem Dämon besessenen Plüschkatze\r\nvor Augen wurde ihr nun alles klar.",
  "BK_9070_0040_JEA": "„Ich fürchte mein Schicksal nicht.\r\nIch werde mich allem stellen,\r\nwas da kommen mag.“",
  "LV_009020_0020_NAR": "[FONT:10 ]Was?! Ich kann es kaum abwarten,\r\ndass sie mich nach Inferno zurückschickt![FONT:N ]",
  "BK_9050_0110_SIN": "„Jeanne. Diese Vision ist eine Zukunft,\r\ndie dich zweifellos einholen wird, wenn\r\ndu dich nicht von dem Mädchen fernhältst.",
  "BK_9040_0000_JEA": "„Cereza...?!\r\nIch spüre ihre Magie, wenn auch nur\r\nschwach. Und sie ist nicht allein...“",
  "BK_9050_0100_NAR": "[FONT:9 ]Schluss mit den blöden Tricks!\r\nIch reiß dich in Stücke![FONT:N ]\r\nCharles versuchte es mit aller Kraft,\r\ndoch er konnte sich nicht rühren.",
  "BK_9050_0090_NAR": "Ein Bild von Jeanne als erwachsene\r\nFrau... die von einem unbekannten\r\nAngreifer tödlich verletzt wird.",
  "SM_009010_0010_JEA": "„Ist das... Cerezas Plüschkatze? Wusst\r\nich's doch, sie steckt in Schwierigkeiten!“",
  "BK_9050_0130_NAR": "Das Phantom schwebte wieder empor\r\nund blickte aus der Luft mit seinem\r\ndurchdringenden Blick auf sie herab.\r\nDann wandte es sich langsam Cereza zu.",
  "LV_009055_0030_NAR": "Was immer sie hier erwartete, es würde\r\nihr Schicksal auf ewig verändern...",
  "SM_009010_0340_NAR": "Und so begann Jeannes und Chesh–\r\nich meine, Jeannes und Charles' Suche nach Cereza.",
  "BK_9060_0160_SIN": "„Was... was geschieht?\r\nDie Ursprüngliche Erz-Eva...\r\nIst sie etwa erwacht?!“",
  "SM_009010_0020_JEA": "„Ich hatte recht...\r\nDas hier ist keine Feenmagie!“",
  "BK_9050_0120_SIN": "Dieses Schicksal ist jedoch nicht in\r\nStein gemeißelt. Verlasse diesen Ort\r\nund es lässt sich womöglich abwenden.“",
  "LV_009055_0040_NAR": "Diesen Gedanken wurde Jeanne nicht mehr\r\nlos. Das Gefühl unerklärlicher Furcht\r\nbreitete sich langsam in ihr aus.",
  "SM_009010_0330_NAR": "Cheshire hatte nicht viel übrig für\r\nseinen neuen Namen, doch jetzt war\r\nkeine Zeit für weitere Einwände.",
  "BK_9060_0080_SIN": "„Sobald ich mit ihm fertig bin, bist\r\ndu an der Reihe. Ich habe versucht,\r\ndich zu warnen, aber du wolltest ja\r\nleider nicht hören.“",
  "LV_009015_0020_JEA": "...Heulsuse?\r\nAch, du meinst Cereza!",
  "BK_9050_0150_SIN": "„Dann endlich wird die\r\nPhänomen-Bestätigung Wirklichkeit!“",
  "CE_009825_1000_SIN": "Unglaublich... Du hast es geschafft,\r\neinen Dämon darin hausen zu lassen?",
  "SM_009020_0260_CER": "„Cheshire... da bist du ja.\r\nDa lässt man dich einmal kurz allein\r\nund schon verirrst du dich wieder.“",
  "BK_9050_0160_SIN": "",
  "SM_009010_0300_NAR": "[FONT:9 ]Charles?![FONT:N ]\r\nWomöglich war dem Dämon der Name Cheshire\r\nmehr ans Herz gewachsen, als er zugeben mochte.",
  "BK_9060_0120_SIN": "„Das hat keinen Zweck.\r\nDie Ursprüngliche Erz-Eva steht\r\nunter meinem Bann. Sie wird nie\r\nwieder erwachen.“",
  "CE_009825_5000_SIN": "Erbärmlicher Dämon...\r\nDu denkst, du kannst es mit mir aufnehmen?",
  "BK_9040_0070_JEA": "",
  "BK_9020_0070_NAR": "Die Risiken einer solchen Seelenprojektion\r\nwaren ihr bewusst, dennoch zögerte sie\r\nnicht im Geringsten.",
  "SM_009020_0100_NAR": "Allmählich kehrte Farbe in\r\nCerezas Gesicht zurück.",
  "SM_009010_0140_NAR": "Sie dachte kurz nach, dann\r\nkam ihr eine teuflische Idee.",
  "BK_9010_0000_NAR": "Wir haben die Geschichte der ungewöhnlichen Freundschaft\r\nzwischen einer jungen Hexe und einem verirrten Dämon gehört.\r\nDoch zwischen den Seiten schlummert noch ein geheimes Kapitel.",
  "CE_009825_2000_SIN": "Welch bemitleidenswerter Versuch\r\neiner Beschwörung!",
  "SM_009010_0210_JEA": "„Wie du meinst.\r\nViel Glück dann noch.“",
  "LV_009005_0000_JEA": "Was... ist das denn?",
  "BK_9040_0200_JEA": "„Keine Ahnung, was du da faselst,\r\naber ich lasse nicht zu, dass du\r\nmeine Umbra-Schwester anrührst.“",
  "BK_9040_0170_SIN": "„Eine geringe Fehlkalkulation meinerseits...\r\nNichtsdestotrotz wird sie bald mein sein,\r\nund dann werde ich meine Welt bestätigen!“",
  "SM_009020_0130_NAR": "Jeannes Körper war kaum noch sichtbar. Sie\r\nkonnte den Zauber nicht mehr lange halten,\r\nihre vom Körper gelöste Seele wollte zurück.",
  "BK_9020_0040_NAR": "Im Gegensatz zu Cereza wohnte Jeanne im\r\nHexendorf. Und obwohl es verboten war,\r\nschlich sie sich oft hinaus, um ihre\r\nRivalin zu treffen, denn die zwei ließen\r\nsich keine Gelegenheit entgehen, ihre\r\nKräfte zu messen.",
  "BK_9010_0050_CER": "",
  "BK_9040_0020_NAR": "[FONT:9 ]Schau! Dort drüben![FONT:N ]\r\nCharles hatte etwas entdeckt.",
  "CE_009810_0000_SIN": "Wohlan...",
  "SM_009010_0030_NAR": "[FONT:9 ]Wer bist du?[FONT:N ]\r\nCheshires Stimme ließ Jeanne aufschrecken.",
  "CE_009800_2000_SIN": "Habe ich dich!",
  "BK_9070_0060_NAR": "Seiner Kräfte beraubt, begann der\r\nKörper des Phantoms zu flackern\r\nund verschwand schließlich.",
  "LV_009020_0000_JEA": "Wie dem auch sei... Es überrascht mich\r\nnicht gerade, dass sie einen Dämon in\r\neine Plüschkatze beschworen hat.",
  "CE_009810_0020_NAR": "Das Phantom öffnete eine Schriftrolle und\r\nrief eine Fee wie aus dem Nichts herbei.",
  "LV_009050_0000_SIN": "Gehe weiter und du wirst es bereuen...",
  "BK_9040_0010_NAR": "Jeanne wurde unruhig. Die Präsenz,\r\ndie sie spürte, war nicht die einer Fee.",
  "SM_009010_0190_NAR": "Verglichen mit Cheshires zerfleddertem\r\nFilz versprühte deren samtenes Fell\r\neinen strahlenden Glanz. Und doch...",
  "BK_9010_0060_CER": "„Wo bin ich?\r\nCheshire?\r\nCheshire, wo bist du?“",
  "LV_009055_0010_JEA": "Du verbirgst Cereza, nicht wahr?\r\nWo ist sie?!",
  "BK_9050_0080_JEA": "",
  "SM_009010_0000_NAR": "Als Jeanne weiter in den Wald vordrang,\r\nfiel ihr etwas Sonderbares ins Auge.",
  "BK_9040_0180_NAR": "Ein Ausdruck von Wahnsinn trat in die\r\nAugen des Phantoms und eine Art dunkle\r\nEnergie begann darin zu glühen.",
  "BK_9060_0070_NAR": "Charles schrie vor Schmerzen.\r\nDie geisterhaften Flammen fraßen sich\r\nlangsam durch seinen Körper und drohten,\r\nihn in Stücke zu reißen.\r\n",
  "LV_009035_0010_NAR": "[FONT:10 ]Hier findet man immer jede Menge von\r\nihnen. Ideal für einen kleinen Imbiss.[FONT:N ]",
  "BK_9020_0010_JEA": "„Oh nein! Ich hatte angenommen, sie\r\nkäme im Wald ohne meine Hilfe klar...\r\ndoch so etwas wie diese Kraft ist mir\r\nnoch nie untergekommen.“",
  "SM_009020_0160_JEA": "„Ganz einfach: Willst du zurück in diese\r\nramponierte Plüschpuppe oder soll ich\r\ndich nach Inferno heimschicken?“",
  "BK_9080_0340_JEA": "„Was da auch kommen mag... Ich bin bereit!\r\nIch werde die stärkste Hexe von allen sein!“",
  "SM_009010_0120_JEA": "„Moment... Ein Dämon an diesem Ort...\r\nHat Cereza dich etwa heraufbeschworen?“",
  "SM_009010_0240_NAR": "Er hatte allen Grund zur Verzweiflung,\r\ndenn er war kurz davor, von dem\r\nLoch verschluckt zu werden.",
  "CE_009800_1000_SIN": "Die Zeit ist gekommen, alles zu bestätigen!",
  "BK_9060_0050_SIN": "Und wenn euer Flehen dann nicht erhört\r\nwird... erfahrt ihr wahre Verzweiflung.“",
  "LV_009035_0020_NAR": "Der Dämon hatte auf seiner bisherigen\r\nReise das ein oder andere gelernt, und so\r\nnutzte er die Gelegenheit zum Angeben.",
  "SM_009020_0230_NAR": "[FONT:9 ]Außerdem bist du mir zu grob.\r\nDie Kleine da gönnt mir wenigstens\r\nauch mal 'ne Auszeit.[FONT:N ]",
  "BK_9020_0020_JEA": "„Es geht gegen alle Umbra-Doktrinen,\r\naber ich habe keine andere Wahl.“",
  "CE_009835_0000_JEA": "Hör auf, mit ihren Erinnerungen\r\nzu spielen, du Monster!",
  "SM_009010_0200_NAR": "[FONT:9 ]Ich? Einem Menschen vertrauen? Ihr seid alle\r\ngleich! Mich haust du nicht übers Ohr![FONT:N ]\r\nknurrte Cheshire Jeanne an.",
  "BK_9050_0070_NAR": "Im nächsten Moment strömte eine Flut\r\nschrecklicher Visionen auf Jeanne ein.",
  "SM_009020_0120_JEA": "„Sieht aus, als ginge es ihr gut.\r\nSie dürften gleich wieder im Wald landen.\r\nMeine Zeit hingegen ist hier wohl beinahe um.“",
  "BK_9020_0050_JEA": "„Also ehrlich, mit ihr hat man\r\necht keine ruhige Minute!“",
  "SM_009020_0270_NAR": "Mit einem zufriedenen Lächeln\r\ndrückte Cereza Cheshire fest an sich.",
  "BK_9050_0050_SIN": "„Ich werde es dir zeigen, Jeanne...\r\nIch zeige dir, was geschieht, solltest\r\ndu den jetzigen Weg weiterverfolgen.“",
  "BK_9070_0090_JEA": "Cereza?!“",
  "SM_009010_0150_JEA": "„Ich habe einen Vorschlag für dich,\r\nDämon: Ich befreie dich, aber dafür\r\nhilfst du mir, Cereza zu finden.“",
  "BK_9060_0010_SIN": "„...Vielleicht habe ich mich nicht klar\r\nausgedrückt? Ich werde die Phänomen-\r\nBestätigung verwirklichen. Es ist\r\nstatistisch unmöglich, dass ihr\r\ndaran etwas ändert.“",
  "SM_009010_0230_NAR": "[FONT:9 ]W-warte![FONT:N ] brüllte Cheshire, der seine\r\nNotlage nicht länger herunterspielen konnte.",
  "BK_9040_0140_JEA": "„Da verknotet man sich ja die Zunge. Und\r\nich dachte, Herr »Ich-hab-keinen-Namen« da\r\ndrüben wäre schlimm... Egal, wer sich mit\r\neiner Umbra anlegt, wird dafür bezahlen.“",
  "LV_009000_1000_JEA": "Die Älteste würde mir gehörig die Leviten\r\nlesen, wenn sie wüsste, dass ich hier bin.\r\nNa ja, egal, ich bin ihre Predigten gewohnt.",
  "CE_009820_0000_SIN": "Ursprüngliche Erz-Eva,\r\nlass uns in noch größerem Maße\r\nan deinem Schmerz teilhaben!",
  "BK_9010_0110_SIN": "„Es überrascht mich, dass jemand so Junges sich meiner Kraft\r\nwidersetzen konnte. Doch auch du wirst mir bald gehören.“",
  "LV_009000_2000_JEA": "Cereza, wo bist du?\r\nStändig gerät sie in Schwierigkeiten...",
  "SM_009010_0310_JEA": "„Wozu die Aufregung?\r\nIst doch egal, welchen Namen ich\r\ndir gebe, oder? Also los, Charles,\r\nwir haben keine Zeit zu verschwenden.“",
  "BK_9070_0030_SIN": "Jeanne... Du hast dich entschieden...\r\nJenes Schicksal ist nun unabänderlich!“",
  "BK_9000_0000_JEA": "„Was... Was könnte das sein?!\r\nCereza... Nein!“",
  "LV_009010_0000_JEA": "Du kannst die Elemente kontrollieren?\r\nGar nicht schlecht für einen Dämon,\r\nden Cereza heraufbeschworen hat.",
  "BK_9080_0380_NAR": "Wünschen wir ihr Glück auf ihrer Reise und\r\nverstauen dieses Kapitel an einem sicheren Ort.",
  "BK_9010_0090_NAR": "Und was Cheshire betraf... Von ihm war keine\r\nSpur zu sehen. War auch dies das Werk der Feen?",
  "LV_009015_0000_NAR": "[FONT:10 ]Du kennst die kleine Heulsuse also?[FONT:N ]",
  "SM_009010_0320_JEA": "Das ging schnell... Gut, ich habe\r\nmich an meinen Teil der Abmachung\r\ngehalten. Jetzt bist du dran!",
  "BK_9070_0000_SIN": "",
  "BK_9040_0050_NAR": "Jeanne blickte in Cerezas Gesicht.\r\nEs war ganz blass und kalt.",
  "BK_9050_0220_SIN": "„Jeanne, du hast gesehen, was dich erwartet.\r\nUnd dennoch gedenkst du mir zu trotzen?“",
  "BK_9060_0110_JEA": "Mach die Augen auf, du Dummkopf!“",
  "BK_9070_0010_NAR": "Der markerschütternde Schrei des\r\nPhantoms ließ die Luft beben.",
  "SM_009020_0190_NAR": "[FONT:9 ]Als ob ich dir dabei vertrauen\r\nwürde! Bring mich einfach nur dorthin\r\nzurück, wo du mich gefunden hast.[FONT:N ]\r\n",
  "LV_009050_0010_JEA": "Wer ist da?",
  "LV_009020_0030_NAR": "Jeanne fand, dass Charles'\r\nPlüschwangen röter wirkten als üblich.",
  "SM_009020_0320_NAR": "[FONT:9 ]...Allerdings hast du mich vorhin gerettet.\r\nDa kann ich mal eine Ausnahme machen.[FONT:N ]\r\nfügte Cheshire leise hinzu.",
  "BK_9060_0150_NAR": "Die Umgebung wurde plötzlich in\r\nblendend helles Licht getaucht.\r\nFür einen Augenblick schien alles\r\num sie herum in strahlendem Glanz\r\ndahinzuschmelzen.",
  "LV_009055_0000_SIN": "Ich erfreue mich nicht daran, dich sterben zu sehen...\r\nEinmal genügt.",
  "SM_009020_0310_NAR": "[FONT:9 ]Von Menschen lasse ich mir nichts befehlen.[FONT:N ]",
  "BK_9020_0100_JEA": "„Cereza, wo bist du nur...?“",
  "CE_009805_2000_SIN": "Du weißt, was dich erwartet,\r\nund doch widersetzt du dich mir?",
  "BK_9020_0090_JEA": "„Kein Zweifel... Etwas Seltsames\r\nlauert hier im Wald, und damit\r\nmeine ich nicht bloß die Feen.“",
  "SM_009020_0280_NAR": "Cheshire seufzte und runzelte die Stirn.\r\nDoch insgeheim war er erleichtert.",
  "LV_009025_0000_JEA": "Cereza... Sie ist ganz in der Nähe,\r\ndas spüre ich! Aber wo...?",
  "LV_009055_0020_NAR": "Jeannes Stimme hallte durch\r\ndie Stille des Waldes.",
  "BK_9060_0170_SIN": "",
  "LV_009015_0040_JEA": "Cereza und ich sind dazu verpflichtet,\r\nstärker zu werden, denn wir müssen\r\ndas Erbe der Umbra-Hexen beschützen.",
  "CE_009815_0000_SIN": "Du kannst es gewiss kaum erwarten,\r\nwas als Nächstes kommt...",
  "SM_009020_0150_NAR": "[FONT:9 ]...Wofür? Was meinst du damit?[FONT:N ]\r\nerwiderte Charles mit verdutztem Blick.",
  "SM_009010_0270_JEA": "„Wer hätte gedacht, dass mir\r\ndas hier nützlich sein würde...\r\nGut, Dämon, nenne deinen Namen!“",
  "SM_009010_0110_NAR": "[FONT:9 ]Hmpf. Als ob ich wüsste, wo diese Göre steckt![FONT:N ]\r\nantwortete Cheshire, wobei er die Verzweiflung in\r\nseiner Stimme erfolglos zu verbergen versuchte.",
  "BK_9040_0090_NAR": "Dann erschien vor ihnen die Quelle von\r\nJeannes Unbehagen: Eine Gestalt, die wie\r\nein boshaftes Phantom in der Luft schwebte.",
  "CE_009805_1000_SIN": "Bist du bereit, dein Schicksal\r\nzu akzeptieren, Jeanne?",
  "BK_9050_0000_JEA": "„Was ist los?\r\nSag bloß, du hast schon genug.“",
  "BK_9040_0100_NAR": "Unter seinem starren Blick stockte\r\nihnen für einen Moment der Atem.",
  "SM_009010_0080_NAR": "[FONT:9 ]Cereza... Woher kennst du das Mädchen?[FONT:N ]\r\nCheshires Augen verengten sich und er\r\nmusterte Jeanne mit neuem Interesse.",
  "BK_9080_0370_NAR": "Es mag unmöglich sein, das eigene Schicksal\r\nzu ändern, doch Jeannes unbeugsamer Wille\r\nund ihre feste Entschlossenheit werden ihr\r\ngewiss den richtigen Weg weisen.",
  "LV_009040_0000_JEA": "Warte... Diese Risse hier...\r\nIch spüre Cereza auf der anderen Seite!",
  "BK_9040_0120_SIN": "„So trifft man sich wieder, tapfere\r\nFreundin. Oder ist dies der Moment,\r\nda ich mich vorstellen sollte?",
  "SM_009020_0200_JEA": "„...Verstehe.\r\nWie du willst.“",
  "BK_9050_0040_JEA": "„Was... Woher kennst\r\ndu meinen Namen?!“",
  "CE_009825_3000_SIN": "Komme mir nicht in die Quere!",
  "BK_9010_0020_NAR": "Es handelt von zwei jungen Hexen, die ein starkes\r\nBand verknüpfte. Es ist eine Geschichte, die für\r\nimmer geheim bleiben und nie wiederholt werden sollte.",
  "BK_9060_0000_JEA": "„Charles!“",
  "SM_009020_0110_NAR": "Sie war zwar noch nicht wach, doch ihrem\r\nsanften Lächeln nach zu urteilen hatte sie\r\noffenbar einen angenehmen Traum.",
  "BK_9020_0060_NAR": "Jeanne löste ihre Seele von ihrem Körper\r\nund flog auf den Wald von Avalon zu.",
  "BK_9040_0150_SIN": "„Ursprüngliche Erz-Eva.",
  "BK_9060_0030_JEA": "„Hör auf!“",
  "BK_9040_0160_SIN": "Dass ihr fortwährender Widerstand\r\nmich hierherbringen würde...“",
  "SM_009020_0240_JEA": "„Ha... So, so.“",
  "BK_9040_0210_JEA": "„Gib mir Cereza zurück oder du bekommst\r\nden Zorn der Umbra-Hexen zu spüren!“",
  "CE_009830_0000_JEA": "Cerezas Schmerz auszunutzen...\r\nWas für ein feiger Trick!",
  "SM_009010_0160_NAR": "[FONT:9 ]Du willst Cereza finden...?[FONT:N ]\r\nDer Dämon beäugte Jeanne argwöhnisch.",
  "BK_9010_0010_NAR": "Jene, die die Geschichte bis zum Schluss gelesen haben,\r\nerinnern sich womöglich noch an diese Szene.\r\nUnd genau hier beginnt das geheime Kapitel.",
  "BK_9050_0140_SIN": "„...Ursprüngliche Erz-Eva.\r\nDu kannst nicht mehr lange\r\nwiderstehen. Bald wirst du mir\r\ngeben, was ich begehre.“",
  "BK_9050_0230_JEA": "„Ich laufe vor nichts davon.\r\nIch werde die stärkste aller Hexen sein!“",
  "LV_009015_0030_JEA": "Sie ist manchmal etwas nah am Wasser\r\ngebaut, aber hinter ihren Tränen\r\nschlummert eine spektakuläre Macht.",
  "CE_009825_4000_SIN": "Du... Halte dich fern von mir!",
  "SM_009010_0040_JEA": "„Wer ist da?!\r\nZeig dich!“",
  "SM_009010_0280_NAR": "[FONT:9 ]Ich habe keinen![FONT:N ]\r\nDer Dämon zeigte seine Dankbarkeit\r\nauf die einzige ihm bekannte Weise:\r\nmit wütendem Gebrüll.",
  "BK_9040_0060_JEA": "„Cereza!“",
  "SM_009010_0070_JEA": "„Du bist... ein Dämon?\r\nWas tust du hier?\r\nWo ist Cereza?“",
  "CE_009825_0000_SIN": "Ich werde von einem übergroßen\r\nSpielzeug attackiert?",
  "SM_009010_0250_NAR": "[FONT:9 ]Na schön, lass mich in die blöde Katze!\r\nAber wenn das eine Falle ist, fress ich dich![FONT:N ]\r\nWiderwillig stimmte der Dämon Jeannes Plan zu.",
  "CE_009800_0000_SIN": "Widerstand ist zwecklos.",
  "BK_9050_0020_NAR": "Doch die Phantomgestalt blieb ganz\r\nruhig und erhob sich wieder mit\r\neinem Lächeln auf den Lippen.",
  "LV_009040_0020_NAR": "Was erwartete sie auf der anderen Seite?\r\nHatten sie Cereza endlich gefunden...?",
  "BK_9020_0000_JEA": "„Cereza!“",
  "BK_9050_0030_SIN": "„Du begreifst noch immer nicht,\r\nwas geschieht, wenn du dich mir\r\nwidersetzt, oder, Jeanne?“",
  "LV_009030_0000_JEA": "Diese Risse...\r\nSind das irgendwelche Streiche der Feen?",
  "CE_009800_4000_SIN": "Die Ursprüngliche Erz-Eva wird mir gehören!",
  "SM_009020_0140_JEA": "„Gut, Charles, wofür entscheidest du dich?“",
  "SM_009020_0220_NAR": "[FONT:9 ]Bah. Ich kann beide nicht leiden.[FONT:N ]\r\ngrummelte Charles in seiner gewohnt\r\ngereizten Art.",
  "BK_9050_0190_SIN": "„Vielleicht war ich zu nachsichtig. Weide\r\ndich erneut an deinem grausamen Schicksal!“",
  "BK_9060_0040_SIN": "„Oh ja... Diese Worte gebt ihr Menschen\r\nstets von euch im Angesicht einer Niederlage.",
  "LV_009045_0010_JEA": "Charles, warst du das gerade?",
  "SM_009010_0100_JEA": "„Was hast du mit ihr angestellt?\r\nKomm da raus und erkläre dich!“",
  "BK_9050_0180_NAR": "Trotzig erhob Jeanne sich.",
  "LV_009040_0010_NAR": "[FONT:10 ]Was?![FONT:N ]\r\nDer Dämon riss die Augen auf.",
  "BK_9050_0010_NAR": "[FONT:9 ]Der schmeckt sicher scheußlich.\r\nIch fress ihn lieber in einem Happs.[FONT:N ]\r\nDer Dämon leckte sich bereits das Maul.",
  "BK_9040_0110_JEA": "„Du bist derjenige, der vorhin zu mir\r\ngesprochen hat. Wer bist du?“",
  "SM_009010_0090_JEA": "„Ich bin eine Umbra-Hexe...\r\nin Ausbildung. Mein Name ist Jeanne\r\nund ich bin hier, um Cereza zu retten.“",
  "LV_009020_0010_JEA": "Und ich wage zu behaupten,\r\ndass es dir darin sogar gefällt.",
  "SM_009020_0300_JEA": "„Und wehe, du erzählst Cereza, was hier\r\nvorgefallen ist. Ich warne dich!“",
  "BK_9020_0110_NAR": "Jeanne war im Wald von Avalon\r\nangelangt, dessen Luft von einer\r\nbösartigen Präsenz erfüllt war.",
  "BK_9020_0080_NAR": "Schließlich strebte sie danach, Cereza zu\r\nübertreffen und die stärkste aller Umbra-Hexen\r\nzu werden. Feigheit war da fehl am Platze.",
  "BK_9070_0070_NAR": "Wie als Antwort darauf taten sich überall\r\num sie herum Brüche und Risse auf und die\r\nganze Welt begann zu zerbröckeln.",
  "SM_009020_0290_JEA": "„Leb wohl, Charles... nein, Cheshire.“",
  "LV_009025_0010_NAR": "Charles hörte Jeannes Worte,\r\nsagte jedoch nichts dazu.",
  "CE_009810_0010_SIN": "Ich lasse dich von der Furcht kosten,\r\ndie der Ursprünglichen Erz-Eva innewohnt.",
  "BK_9010_0040_CER": "„Cheshire?\r\nWo bist du, Cheshire?!“",
  "BK_9040_0030_NAR": "Jeanne folgte Charles' Blick und vernahm\r\neine kleine Gestalt, die in der Ferne schwebte.",
  "BK_9040_0190_NAR": "Doch Jeanne und Charles schreckten\r\nnicht vor ihm zurück.",
  "BK_9070_0050_SIN": "",
  "SM_009010_0180_NAR": "Jeanne holte ihr eigenes Plüschtier\r\nhervor: eine hübsche rote Plüschkatze.",
  "BK_9010_0070_CER": "",
  "SM_009020_0330_JEA": "„Wenn ich's nicht besser wüsste, würde ich\r\nglatt denken, ich spreche mit einem Menschen!\r\n...Pass auf meine Freundin auf, Fellknäuel.“",
  "CE_009800_3000_SIN": "Es ist sinnlos.",
  "BK_9060_0140_JEA": "Halte dein Versprechen! Wenn du als\r\nUmbra-Hexe einen Funken Stolz in dir hast,\r\nist dies der Zeitpunkt, es zu beweisen!“",
  "CE_009810_0030_NAR": "Mit der Magie des Feenreichs war\r\ndem Schmerz in Cerezas Herzen\r\neine Form gegeben worden.",
  "LV_009025_0020_NAR": "Insgeheim machte er sich allerdings große\r\nSorgen. Er stieß einen Seufzer aus.",
  "BK_9050_0210_NAR": "[FONT:9 ]Die Kleine hat mir gegenüber noch ein\r\nVersprechen zu halten. Also Finger weg![FONT:N ]\r\nDie Kreatur brüllte zornig.",
  "LV_009015_0010_NAR": "Charles beäugte Jeanne misstrauisch.",
  "SM_009010_0290_JEA": "„Verstehe.\r\nDann will ich dich Charles nennen.“",
  "BK_9010_0080_NAR": "Gefangen in einer seltsamen Leere\r\nwar Cereza versteinert worden von\r\neiner mysteriösen Kraft.",
  "BK_9050_0170_JEA": "„Ich sagte doch bereits...\r\nIch lasse nicht zu, dass du\r\nmeine Umbra-Schwester anrührst!“",
  "SM_009010_0060_NAR": "Doch es verlangte ihm bereits\r\nalles ab, das Loch offen zu halten.\r\nEr konnte sich kaum bewegen.",
  "BK_9070_0020_SIN": "„Das ist... unerklärlich!",
  "BK_9080_0390_NAR": "Diese Geschichte wird auf ewig\r\nunser kleines Geheimnis bleiben...",
  "BK_9060_0130_JEA": "„Cereza, hast du unser Versprechen\r\nvergessen? Wir haben uns geschworen,\r\ndass wir gemeinsam stärker werden!",
  "BK_9010_0100_SIN": "„Hab Dank... Die Kraft der Feen\r\nresonierte mit deinen Erinnerungen\r\nund führte mich her.“",
  "BK_9050_0200_SIN": "„Du auch...?!“",
  "BK_9060_0100_JEA": "„Cereza... Cereza!",
  "SM_009020_0180_NAR": "Für einen Augenblick starrte Charles\r\nJeanne stillschweigend an.\r\nDann endlich antwortete er.",
  "BK_9060_0090_JEA": "„Cereza, wach auf!“",
  "BK_9010_0030_CER": "„Bin ich... wieder im Wald?“",
  "BK_9040_0040_NAR": "Es war Cereza.\r\nSie schien völlig regungslos, offenbar\r\neingefroren von einer unbekannten Kraft.",
  "SM_009010_0050_NAR": "[FONT:9 ]Stell dich nicht dumm.\r\nDu hast mich hier drin eingesperrt, oder?[FONT:N ]\r\nsagte Cheshire, während er verzweifelt\r\nversuchte, sich zu befreien.",
  "BK_9060_0020_NAR": "Ein kühles Leuchten erfüllte die rechte Hand des Phantoms.",
  "SM_009020_0250_NAR": "Jeanne musste lächeln, denn ihr war nicht\r\nentgangen, wie der verlegene Dämon wirklich\r\nempfand. Sie nutzte ihre Umbra-Künste, um ihn\r\nseinem Wunsch entsprechend in den vorigen\r\nKörper zurückkehren zu lassen.",
  "BK_9050_0060_NAR": "Jeanne und Charles konnten sich nicht mehr\r\nbewegen. Sie standen unter einem Bann.",
  "LV_009000_0000_JEA": "Dies ist also der berüchtigte Feenwald...\r\nAber hier lauert noch etwas anderes,\r\nda bin ich mir sicher...",
  "SM_009010_0170_JEA": "„So sieht's aus.\r\nWenn du zustimmst, lasse ich dich in\r\neinen Körper wechseln, der sicher ist.\r\nIch habe genau das Richtige hier.“",
  "SM_009010_0220_NAR": "Jeanne wandte dem stolzen Dämon den\r\nRücken zu und wollte allein weitergehen...",
  "BK_9070_0080_JEA": "„Alles... fällt auseinander! War dies\r\nbloß eine Illusion von ihm?",
  "CE_009840_0000_JEA": "Deine Spielereien ziehen bei mir nicht mehr.\r\nKomm schon!"
}
