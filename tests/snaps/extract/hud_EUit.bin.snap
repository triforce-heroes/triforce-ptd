{
  "HUD_PURPOSE_TXT_6020": "Ferma Lukaon.",
  "HUD_INTERACT_TEXT_0036_CER": "Mhm... adesso è troppo buio per leggere.",
  "HUD_NOTICE_TXT_04": "Nuovo spiritello!",
  "HUD_PURPOSE_TXT_4010": "Dirigiti verso la fortezza\r\ndelle fate.",
  "HUD_INTERACT_TEXT_0039_CER": "Niente più mandragora in giro, vero?\r\nBisogna tenere sempre gli occhi aperti\r\nperché cresce davvero in fretta...",
  "HUD_GAMEOVER_TXT_0007": "Le fate spezzarono i sogni\r\ndi Cereza. Il lupo bianco morì\r\naccanto a lei, come a volerle\r\nrimanere accanto per sempre.\r\n",
  "HUD_INTERACT_TEXT_0009_CER": "Ciao, bel pesciolino!\r\nTi auguro di diventare grande e forte!",
  "HUD_GAMEOVER_TXT_0003": "Catturata dalle fate, Cereza\r\nfu rinchiusa in una bara di\r\ncristallo in cima alla Torre,\r\ndove rimase esposta\r\nall'erosione degli elementi.",
  "HUD_GAMEOVER_TXT_0010": "Le fate ridevano: una strana\r\nforza espulse Cereza e\r\nCheshire dal Tír na nÓg.",
  "HUD_PURPOSE_TXT_1030": "Sbrigati!",
  "HUD_PURPOSE_TXT_1130": "Procedete insieme\r\nnella foresta.",
  "HUD_INTERACT_TEXT_0013_CER": "Quando tornerò dalla foresta\r\nsarà meglio riempire di nuovo\r\nla lampada a olio.",
  "HUD_INTERACT_TEXT_0301_CER": "Una fata di metallo... robot?\r\nUseranno anche questa al circo?",
  "HUD_INTERACT_TEXT_0006_CER": "Questa giara è molto vecchia.\r\nMi piacerebbe trovarne una nuova\r\ne più leggera.",
  "HUD_PREVENT_TEXT_0005_CER": "Io... ce la posso fare! Coraggio, Cereza!",
  "HUD_INTERACT_TEXT_0402_CER": "Andiamo bene... Questo dovrebbe\r\ngirare, ma dev'essere rotto. Peccato...",
  "HUD_INTERACT_TEXT_0404_CER": "Tutti questi alberi secchi...\r\nSono state le fate, ne sono sicura.",
  "HUD_PREVENT_TEXT_0003_CER": "Ci sono delle fate...\r\nSe vado di qua mi cattureranno.",
  "HUD_PURPOSE_TXT_1091": "Dirigiti verso il campo\r\ndi addestramento.",
  "HUD_INTERACT_TEXT_0000_CER": "È la casa di Morgana.\r\nSe torno indietro ora, si arrabbierà.",
  "HUD_PURPOSE_TXT_7000": "Immobilizza e sconfiggi\r\ntutti i nemici!",
  "HUD_INTERACT_TEXT_0307_CER": "Oh, no. Da qui non si passa...\r\nDevo fare qualcosa, altrimenti...",
  "HUD_ITEMOBTAIN_TEXT_006": "Ingrediente cristallizzato.\r\nSi mette a gridare per ogni\r\ncosa, quindi meglio infilarla\r\nin fondo allo zaino.",
  "HUD_PURPOSE_TXT_5030": "Avanza verso il Santuario\r\nmaggiore.",
  "HUD_ITEMOBTAIN_TEXT_002": "Energia magica cristallizzata\r\ndella Foresta di Avalon.\r\nUna sola goccia infonde\r\ndolcezza dalla testa ai piedi.",
  "HUD_ITEMOBTAIN_TEXT_011": "Pozione di Umbra in un'ampolla\r\nappuntita, usata per creare onde\r\nd'urto e stordire i nemici nei\r\ndintorni. Si può preparare!",
  "HUD_ITEMOBTAIN_TEXT_102": "Grande gioiello a forma di fiore,\r\ncreato con petali della vitalità.\r\nResistente a qualsiasi forza,\r\ngarantisce lunga vita.",
  "HUD_PURPOSE_TXT_7004": "Sconfiggi tutti i nemici\r\nprotetti da una barriera!",
  "HUD_PURPOSE_TXT_2020": "Cerca di entrare nella\r\nTorre delle fate.",
  "HUD_PURPOSE_TXT_1195": "Dirigiti verso la tenda\r\ndel circo.",
  "HUD_INTERACT_TEXT_0030_CER": "Ora non posso andare a casa.\r\nDevo allenarmi! Aspettavo da tanto\r\nquesto momento!",
  "HUD_PURPOSE_TXT_1081": "Cattura l'erba fuggitiva\r\ncon il Legaccio di rovi.",
  "HUD_ITEMOBTAIN_TEXT_005": "Gemma tonda dal potere lunare,\r\nfonte della forza delle streghe.\r\nPotenzia chi la trova e permette\r\na Cereza di usare le sue tecniche.",
  "HUD_INTERACT_TEXT_0101_CER": "Mhm, l'aria ha un profumo meraviglioso!\r\nQui dovrei riuscire a rilassarmi.",
  "HUD_PURPOSE_TXT_5020": "Segui il lupo bianco finché\r\nnon trovi Lukaon.",
  "HUD_GAMEOVER_TXT_0008": "Gli spiritelli imploravano\r\naiuto, ma Cereza era caduta\r\ne nessuno poteva soccorrerli.",
  "HUD_PURPOSE_TXT_7003": "Evita gli incantesimi\r\ne sconfiggi tutti i nemici!",
  "HUD_INTERACT_TEXT_0209_CER": "Povera altalena. Se solo ci fosse qualcuno\r\nin questa foresta in grado di ripararti...",
  "HUD_INTERACT_TEXT_0223_CER": "Usano gli spiritelli come attrazione\r\nda circo?! Che crudeltà!",
  "HUD_ITEMOBTAIN_TEXT_101": "Piccolo gioiello a forma di petalo,\r\ncreato dalla vera essenza della\r\nforesta. Raccogliendone molti\r\nsi incrementa l'energia vitale.",
  "HUD_ITEMOBTAIN_TEXT_012": "Pozione di Umbra in un'ampolla\r\na forma di petalo, usata per far\r\nrecuperare un po' di energia\r\nvitale a Cereza. Si può preparare!",
  "HUD_PURPOSE_TXT_2030": "Procedi verso la Torre\r\ndelle fate.",
  "HUD_PURPOSE_TXT_6030": "Parla a Lukaon.",
  "HUD_PURPOSE_TXT_4100": "Segui il lupo bianco finché\r\nnon trovi Lukaon.",
  "HUD_GAMEOVER_TXT_0004": "Cereza sprofondò nelle nere\r\nacque del lago. Solo gli\r\nabissi sanno che fine fece.",
  "HUD_ITEMOBTAIN_TEXT_009": "Pozione di Umbra in un'ampolla a forma di\r\nfarfalla. Rende temporaneamente invincibili\r\ne permette di usare le Arti di Umbra più\r\nrapidamente. Si può preparare!",
  "HUD_PURPOSE_TXT_1120": "Trova il modo di tornare\r\nall'Inferno.",
  "HUD_PURPOSE_TXT_3010": "Combatti contro il drago\r\nmostruoso.",
  "HUD_INTERACT_TEXT_0900_CER": "In cima alla porta c'è un'altalena\r\nfatta su misura per gli spiritelli.",
  "HUD_INTERACT_TEXT_0107_CER": "Che cos'è quest'affare? Beh,\r\normai non posso tirarmi indietro...",
  "HUD_PURPOSE_TXT_1020": "Procedi con Jeanne.",
  "HUD_NOTICE_TXT_03": "Nuovo archivio\r\nsbloccato!",
  "HUD_INTERACT_TEXT_0108_CER": "Temo che questa foresta non mi\r\nlascerà andar via tanto facilmente...",
  "HUD_INTERACT_TEXT_0214_CER": "I nostri poster da ricercati sono\r\nsparpagliati un po' ovunque!\r\nChe razza di accoglienza!",
  "HUD_INTERACT_TEXT_0106_CER": "Che lago enorme!\r\nEh? C'è qualcosa impigliato là?",
  "HUD_INTERACT_TEXT_0901_CER": "1,2,3... Sembra che servano\r\ntre spiritelli per aprire la porta.",
  "HUD_GAMEOVER_TXT_1004": "\"Gnam, gnam...\" E pochi\r\nistanti dopo, un angoscioso\r\nurlo risuonò nella foresta.",
  "HUD_INTERACT_TEXT_0201_CER": "Queste tavole sono marce!\r\nOh, spero che reggano...",
  "HUD_MAPCL_B_10": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg presso la Radura\r\nTroncobianco. La nebbia è svanita e\r\ni punti di interesse ora sono segnati.",
  "HUD_MAPCL_B_03": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nel Giardino frondoso.\r\nLa nebbia è svanita e i punti di\r\ninteresse ora sono segnati.",
  "HUD_ITEMRECIPE_TEXT_009": "Pozione in un'ampolla a farfalla per\r\nessere temporaneamente invincibili\r\ne usare le Arti di Umbra in meno tempo.",
  "HUD_PURPOSE_TXT_2010": "Salva gli amici di Colm\r\nda sola.",
  "HUD_MAPCL_B_14": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nelle Terre proibite.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_MAPCL_B_07": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg sull'Altopiano ventoso.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_MAPCL_A_08": "I due sono riusciti a sconfiggere\r\nun Tír na nÓg presso il Bacino\r\ndel colosso, ma sembra che in\r\nquesta zona ce ne siano altri...",
  "HUD_ITEMOBTAIN_TEXT_021": "Riempie l'indicatore di ricarica\r\nmagica e ti permette quindi di\r\nriutilizzare le Arti di Umbra più\r\nvelocemente.",
  "HUD_MAPCL_A_00": "I due sono riusciti a sconfiggere un\r\nTír na nÓg in un posto sconosciuto,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_13": "I due sono riusciti a sconfiggere un\r\nTír na nÓg presso il Poggio dell'oblio,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_PURPOSE_TXT_4020": "Dirigiti da sola verso\r\nla fortezza delle fate.",
  "HUD_ITEMRECIPE_TEXT_012": "Pozione in un'ampolla a forma di\r\npetalo, usata per far recuperare\r\na Cereza dell'energia vitale.",
  "HUD_PURPOSE_TXT_6010": "Riprendi Cheshire dalle\r\ngrinfie di Lukaon.",
  "HUD_MAPCL_B_18": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nella Fortezza di Púca.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_PURPOSE_TXT_1100": "Entra nella Foresta di Avalon.",
  "HUD_STATUSUP_TEXT_202": "Il bracciale si riempie della magia\r\nassorbita e dona potere!",
  "HUD_INTERACT_TEXT_0208_CER": "Questo è molto vecchio.\r\nSarà qui da tantissimo tempo.",
  "HUD_MAPCL_A_04": "I due sono riusciti a sconfiggere un\r\nTír na nÓg presso il Lago Nimueh,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_17": "I due sono riusciti a sconfiggere un\r\nTír na nÓg nel Bosco Legnoarido,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_INTERACT_TEXT_0212_CER": "E questi dovremmo essere io e Cheshire?\r\nMa per favore! Io sono molto più bella!",
  "HUD_MAPCL_A_03": "I due sono riusciti a sconfiggere un\r\nTír na nÓg nel Giardino frondoso,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_10": "I due sono riusciti a sconfiggere\r\nun Tír na nÓg presso la Radura\r\nTroncobianco, ma sembra che in\r\nquesta zona ce ne siano altri...",
  "HUD_INTERACT_TEXT_0031_CER": "Adesso è troppo tardi per andare in città!",
  "HUD_PURPOSE_TXT_4030": "Trova Cheshire.",
  "HUD_ITEMRECIPE_TEXT_011": "Pozione in un'ampolla appuntita\r\nche provoca onde d'urto che\r\nsorprendono i nemici vicini.",
  "HUD_MAPCL_B_08": "Cereza e Cheshire hanno sconfitto\r\ntutti i Tír na nÓg presso il Bacino\r\ndel colosso. La nebbia è svanita e\r\ni punti di interesse ora sono segnati.",
  "HUD_INTERACT_TEXT_0001_CER": "Da qui si arriva in città.\r\nNon che muoia dalla voglia di andarci...",
  "HUD_PREVENT_TEXT_0002_CER": "Devo concentrarmi e sbrigare tutti\r\ni miei lavoretti, altrimenti Morgana\r\nmi lancerà contro tuoni e fulmini.",
  "HUD_INTERACT_TEXT_0309_CER": "Le gabbie sono tutte distrutte.\r\nQualcuno deve aver sfogato così\r\nla sua rabbia.",
  "HUD_INTERACT_TEXT_0405_CER": "Ci sono fiamme ovunque! Non sudavo\r\ncosì nemmeno quando mi addestravo\r\ncon Morgana!",
  "HUD_MAPCL_A_07": "I due sono riusciti a sconfiggere un\r\nTír na nÓg sull'Altopiano ventoso,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_14": "I due sono riusciti a sconfiggere\r\nun Tír na nÓg nelle Terre proibite,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_PURPOSE_TXT_1010": "Procedi.",
  "HUD_PURPOSE_TXT_1110": "Procedi nella foresta.",
  "HUD_STATUSUP_TEXT_201": "Il fiore emana una luce brillante\r\ne conferisce la sua energia!",
  "HUD_INTERACT_TEXT_0014_CER": "Che fastidio! È pieno di insetti!\r\nSciò! Statemi alla larga!",
  "HUD_PURPOSE_TXT_3020": "Prosciuga il lago.",
  "HUD_INTERACT_TEXT_0300_CER": "Quanta polvere! Che schifo...\r\nSarà lo sgabuzzino di qualche fata?",
  "HUD_INTERACT_TEXT_0012_CER": "Forse potrei esprimere un desiderio\r\ndavanti a questa candela... Ti prego, fa'\r\nche Avalon possa realizzare i miei sogni!",
  "HUD_INTERACT_TEXT_0008_CER": "Che bella vista!\r\nStarei sempre qui ad ammirarla...\r\nse solo ne avessi il tempo!",
  "HUD_PURPOSE_TXT_5010": "Calma Cheshire.",
  "HUD_MAPCL_B_13": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg presso il Poggio\r\ndell'oblio. La nebbia è svanita e\r\ni punti di interesse ora sono segnati.",
  "HUD_MAPCL_B_00": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nella zona sconosciuta.\r\nLa nebbia è svanita e i punti di\r\ninteresse ora sono segnati.",
  "HUD_PREVENT_TEXT_0004_CER": "No, non è di qua.\r\nDevo raggiungere il lupo bianco!",
  "HUD_INTERACT_TEXT_0007_CER": "Che cosa ci fa qui il mio libro?\r\nMeglio se lo rimetto a posto,\r\npiù tardi.",
  "HUD_GAMEOVER_TXT_1003": "Il magnanimo Púca aveva\r\nsconfitto i suoi avversari.\r\nIl mondo era ai suoi piedi.",
  "HUD_PURPOSE_TXT_2100": "Dirigiti verso il Grande\r\nAlbero.",
  "HUD_MAPCL_B_17": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nel Bosco Legnoarido.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_MAPCL_B_04": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg presso il Lago Nimueh.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_INTERACT_TEXT_0037_CER": "Di notte la casa di Morgana\r\nfa proprio paura...",
  "HUD_ITEMOBTAIN_TEXT_022": "Cristallo impregnato di potere,\r\na forma di mezzaluna. Si trova\r\nsolo all'Inferno. Permette di\r\nrecuperare potere magico.",
  "HUD_INTERACT_TEXT_0038_CER": "È così buio che se inciampo, rischio\r\ndi combinare qualche guaio!\r\nMeglio stare lontana dallo stagno.",
  "HUD_MAPCL_A_18": "I due sono riusciti a sconfiggere un\r\nTír na nÓg nella Fortezza di Púca,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_PURPOSE_TXT_2050": "Riposa nel Santuario.",
  "HUD_INTERACT_TEXT_0401_CER": "Queste ninfee sono molto utili.\r\nPossono essere usate come\r\nbarche, come piattaforme...",
  "HUD_GAMEOVER_TXT_2001": "Le forze lasciarono Jeanne\r\ne la sua anima svanì: nella\r\nforesta rimasero solo due\r\ngiocattoli senza vita.",
  "HUD_MAPCL_A_06": "I due sono riusciti a sconfiggere un\r\nTír na nÓg nel Bosco Raggiodisole,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_15": "I due sono riusciti a sconfiggere un\r\nTír na nÓg nel Santuario maggiore,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_PREVENT_TEXT_0006_CER": "Muori dalla voglia di vedere che c'è dietro\r\nquella porta, vero? Beh, allora andiamo!",
  "HUD_INTERACT_TEXT_0010_CER": "Tornerò presto. Te lo prometto.",
  "HUD_INTERACT_TEXT_0302_CER": "Questa macchina è più grande di me!\r\nChissà a cosa serve...",
  "HUD_MAPCL_B_09": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg presso le Cascate della\r\nviverna. La nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_INTERACT_TEXT_0020_CER": "Spero che Morgana stia avendo\r\ncura delle viole che le ho regalato...",
  "HUD_ITEMRECIPE_TEXT_010": "Profumo che conferisce per un\r\npo' a Cheshire potere magico\r\nillimitato per le sue tecniche.",
  "HUD_MAPCL_A_02": "I due sono riusciti a sconfiggere un\r\nTír na nÓg sulla Collina di giada,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_11": "I due sono riusciti a sconfiggere un\r\nTír na nÓg nella Torre delle fate,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_INTERACT_TEXT_0035_CER": "Riempire d'acqua un secchio e portarlo\r\na Morgana... Che razza di allenamento\r\nda strega è?",
  "HUD_INTERACT_TEXT_0033_CER": "Ho dimenticato di pulire... ma ora si è\r\nfatto buio e Morgana non dovrebbe\r\naccorgersene.",
  "HUD_INTERACT_TEXT_0029_CER": "Per essere il nido di un ragno è grande!\r\nSembra che il proprietario non sia in casa\r\nin questo momento...",
  "HUD_FORESTGUIDE_TEXT_001": "Una calda e brillante luce guida\r\nCereza a un vicino Santuario...",
  "HUD_PURPOSE_TXT_4090": "Lascia la fortezza e\r\nprocedi nella foresta.",
  "HUD_PURPOSE_TXT_1140": "Salva Cereza.",
  "HUD_PURPOSE_TXT_2012": "Salva gli spiritelli con\r\nentrambi i personaggi.",
  "HUD_PURPOSE_TXT_3070": "Cerca l'ultimo nucleo\r\nelementale.",
  "HUD_MAPCL_B_16": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg presso l'Altare del Re\r\ndelle fate. La nebbia è svanita e\r\ni punti di interesse ora sono segnati.",
  "HUD_MAPCL_B_05": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg sulla Spiaggia Solmibacia.\r\nLa nebbia è svanita e i punti di\r\ninteresse ora sono segnati.",
  "HUD_GAMEOVER_TXT_1002": "Jabberwock inghiottì\r\nCereza in un boccone.\r\nNon sazio, volò a cercare\r\nun'altra preda.",
  "HUD_PURPOSE_TXT_1040": "Vai da Morgana.",
  "HUD_GAMEOVER_TXT_1006": "Superato ogni ostacolo, Lukaon\r\ne Morgana finalmente vissero\r\nper sempre felici e contenti.",
  "HUD_PURPOSE_TXT_2105": "Attraversa l'Altopiano\r\nventoso.",
  "HUD_INTERACT_TEXT_0304_CER": "L'ondeggiare di questa pianta...\r\nè ipnotizzante...",
  "HUD_INTERACT_TEXT_0016_CER": "L'ho riempita mentre Morgana non\r\nguardava! Almeno adesso ne avrà\r\nancora per un po'!",
  "HUD_MAPCL_B_12": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg sulla Torre di vedetta.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_MAPCL_B_01": "Cereza e Cheshire hanno sconfitto\r\ntutti i Tír na nÓg sul Sentiero del\r\nbisbiglio. La nebbia è svanita e\r\ni punti di interesse ora sono segnati.",
  "HUD_PURPOSE_TXT_4060": "Cerca il lupo bianco.",
  "HUD_PREVENT_TEXT_0000_CER": "Sarà meglio che vada da Morgana.\r\nÈ già tardi e chi la sente!",
  "HUD_INTERACT_TEXT_0003_CER": "Queste lampade sono pesanti\r\ned è difficile pulirle.\r\nOh, no. Sono di nuovo sporche...",
  "HUD_INTERACT_TEXT_0407_CER": "Mi gira la testa solo a guardare...",
  "HUD_INTERACT_TEXT_0019_CER": "Credi che i pesci dormano a quest'ora?",
  "HUD_PURPOSE_TXT_4080": "Distruggi l'ultimo nucleo\r\nelementale.",
  "HUD_MAPCL_A_09": "I due sono riusciti a sconfiggere un\r\nTír na nÓg presso le Cascate della\r\nviverna, ma sembra che in questa\r\nzona ce ne siano altri...",
  "HUD_GAMEOVER_TXT_1001": "Le fate applaudirono la\r\nnuova attrazione del circo:\r\n\"Ammirate! Solo magia vera!\"",
  "HUD_PURPOSE_TXT_1050": "Prendi l'acqua dal pozzo a est.",
  "HUD_PURPOSE_TXT_8000": "Completa il Tír na nÓg!",
  "HUD_INTERACT_TEXT_0220_CER": "A vederla da vicino, questa gabbia\r\nè tutta rotta. Forse l'hanno buttata\r\nvia come spazzatura.\r\n",
  "HUD_PURPOSE_TXT_1150": "Procedete insieme\r\nnella foresta.",
  "HUD_PURPOSE_TXT_2011": "Salva gli spiritelli\r\nintrappolati.",
  "HUD_PURPOSE_TXT_3060": "Distruggi il terzo nucleo\r\nelementale.",
  "HUD_MAPCL_B_15": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nel Santuario maggiore.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_MAPCL_B_06": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nel Bosco Raggiodisole.\r\nLa nebbia è svanita e i punti di\r\ninteresse ora sono segnati.",
  "HUD_MAPCL_B_11": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg nella Torre delle fate.\r\nLa nebbia è svanita e i punti\r\ndi interesse ora sono segnati.",
  "HUD_MAPCL_B_02": "Cereza e Cheshire hanno sconfitto tutti\r\ni Tír na nÓg sulla Collina di giada.\r\nLa nebbia è svanita e i punti di\r\ninteresse ora sono segnati.",
  "HUD_GAMEOVER_TXT_1005": "Recuperando infine il suo\r\ncorpo e la sua forza, Lukaon\r\ndivenne il vero re di Avalon.",
  "HUD_PURPOSE_TXT_6040": "Cavalca Cheshire e\r\nscappa dalla foresta.",
  "HUD_PURPOSE_TXT_4070": "Sconfiggi Affinity.",
  "HUD_MAPCL_A_05": "I due sono riusciti a sconfiggere un\r\nTír na nÓg sulla Spiaggia Solmibacia,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_MAPCL_A_16": "I due sono riusciti a sconfiggere un\r\nTír na nÓg presso l'Altare del Re\r\ndelle fate, ma sembra che in questa\r\nzona ce ne siano altri...",
  "HUD_INTERACT_TEXT_0219_CER": "Che scivolo lungo...\r\nMi viene un infarto solo al pensiero...",
  "HUD_PURPOSE_TXT_2040": "Segui gli spiritelli.",
  "HUD_INTERACT_TEXT_0203_CER": "Oh, qui c'è inciso qualcosa...\r\n\"Cattura tutti gli umani che entrano\r\nnella foresta!\"",
  "HUD_INTERACT_TEXT_0104_CER": "C-che cos'è quello?\r\nUn'altra delle opere delle fate?",
  "HUD_INTERACT_TEXT_0216_CER": "Aaah... ah...\r\nChe cosa trasporterà così di corsa?",
  "HUD_INTERACT_TEXT_0500_CER": "È tutto gelato.\r\nE presto lo sarò anch'io...\r\n",
  "HUD_MAPCL_A_01": "I due sono riusciti a sconfiggere un\r\nTír na nÓg sul Sentiero del bisbiglio,\r\nma sembra che in questa zona ce\r\nne siano altri...",
  "HUD_MAPCL_A_12": "I due sono riusciti a sconfiggere un\r\nTír na nÓg sulla Torre di vedetta,\r\nma sembra che in questa zona\r\nce ne siano altri...",
  "HUD_PURPOSE_TXT_1070": "Vai nel giardino di erbe a sud.",
  "HUD_PURPOSE_TXT_1170": "Scappa dal Tír na nÓg.",
  "HUD_PURPOSE_TXT_3040": "Distruggi il terzo nucleo\r\nelementale.",
  "HUD_PURPOSE_TXT_6060": "Sconfiggi Morgana.",
  "HUD_GAMEOVER_TXT_0009": "Catturata dalla fate, l'anima\r\ndi Cereza venne gettata in una\r\nlanterna, dove da allora brucia\r\npiù luminosa di ogni altra.",
  "HUD_PURPOSE_TXT_7002": "Sconfiggi i nemici senza\r\nfarti colpire!",
  "HUD_ITEMOBTAIN_TEXT_004": "Frutto infernale dall'aspetto demoniaco\r\nma dolce e nutriente. Cresce\r\nsu terreni magici e permette a\r\nCheshire di usare le sue tecniche.",
  "HUD_PURPOSE_TXT_4050": "Procedi senza farti vedere.",
  "HUD_INTERACT_TEXT_0218_CER": "\"Gli umani sono benvenuti\r\nnel nostro circo!\"\r\nPerché è scritto nella nostra lingua...?",
  "HUD_PURPOSE_TXT_1180": "Segui il lupo e trova\r\nil nucleo elementale.",
  "HUD_PURPOSE_TXT_1080": "Fai crescere le erbe con\r\nle Arti di Umbra di Cereza.",
  "HUD_INTERACT_TEXT_0217_CER": "\"Vi presentiamo il grande Amadán Dubh!\r\nVenite ad ammirare i suoi miracoli\r\nal Tendone di Amadán!\" Eh?",
  "HUD_INTERACT_TEXT_0105_CER": "Uah!\r\nL'erba è tutta bagnata! Si scivola!",
  "HUD_NOTICE_TXT_02": "Santuario sbloccato!",
  "HUD_INTERACT_TEXT_0211_CER": "Una... tomba?\r\nDi chi sarà mai?",
  "HUD_PURPOSE_TXT_9000": "Esplora la foresta.",
  "HUD_GAMEOVER_TXT_0001": "Cereza cadde nella Foresta\r\ndi Avalon e presto venne\r\ndimenticata da tutti.",
  "HUD_PURPOSE_TXT_2060": "Vai al circo.",
  "HUD_PURPOSE_TXT_2090": "Trova il terzo nucleo\r\nelementale.",
  "HUD_ITEMOBTAIN_TEXT_008": "Ingrediente cristallizzato. Tolto\r\na un povero unicorno, può essere\r\nusato come ornamento in base\r\na lunghezza e brillantezza.",
  "HUD_GAMEOVER_TXT_0005": "La Fortezza di Púca assisté\r\nalla fine di Cereza. La sua\r\nbara di cristallo fu dimenticata.",
  "HUD_INTERACT_TEXT_0017_CER": "Se vado nella foresta diventerò\r\nuna strega forte e non avrò più\r\nbisogno di studiare!",
  "HUD_NOTICE_TXT_01": "Nuova mappa sbloccata!",
  "HUD_PURPOSE_TXT_2070": "Sconfiggi Amadán Dubh.",
  "HUD_INTERACT_TEXT_0018_CER": "Non potrò più godermi questo spettacolo...\r\nMa devo diventare forte. Devo farlo per\r\nmia mamma!",
  "HUD_INTERACT_TEXT_0406_CER": "Che edificio enorme! Ci deve abitare\r\nqualcuno di molto importante.",
  "HUD_GAMEOVER_TXT_0002": "Cereza rimase nella foresta\r\ne la sua bara di cristallo fu\r\nricoperta dal sottobosco.\r\n",
  "HUD_INTERACT_TEXT_0002_CER": "Questa roccia somiglia a una zanna...\r\nE se ci fosse un mostro gigante,\r\nproprio qua, sottoterra?",
  "HUD_INTERACT_TEXT_0310_CER": "Qualcuno deve averci spiato\r\nmentre sorseggiava una tazza di tè...",
  "HUD_GAMEOVER_TXT_0006": "Cereza fu destinata a\r\ntrascorrere l'eternità nella\r\ngabbia illusoria delle fate.",
  "HUD_PURPOSE_TXT_2080": "Distruggi il secondo\r\nnucleo elementale.",
  "HUD_PURPOSE_TXT_1160": "Segui il lupo.",
  "HUD_PURPOSE_TXT_3050": "Sconfiggi Jabberwock.",
  "HUD_PURPOSE_TXT_1060": "Porta l'acqua a Morgana.",
  "HUD_INTERACT_TEXT_0021_CER": "Com'è alto!\r\nSpero proprio di non cadere... oooh...",
  "HUD_INTERACT_TEXT_0034_CER": "Potrei rimanere a guardare il tremolio\r\ndelle fiamme per tutta la notte...",
  "HUD_ITEMOBTAIN_TEXT_003": "Petalo di rosa nera infernale,\r\nil fiore preferito dalle fate\r\nper i loro giardini a causa\r\ndella sua lieve energia magica.",
  "HUD_ITEMOBTAIN_TEXT_010": "Profumo di Umbra in un'ampolla\r\na forma di mezzaluna. Dona a\r\nCheshire potere magico illimitato\r\nper le sue tecniche. Si può preparare!",
  "HUD_ITEMOBTAIN_TEXT_007": "Ingrediente cristallizzato.\r\nPuò avere effetti diversi\r\nsu chi lo consuma in base\r\na quanto viene cotto.",
  "HUD_PURPOSE_TXT_4040": "Cerca Cheshire con\r\nil lupo bianco.",
  "HUD_PREVENT_TEXT_0007_CER": "Io... non posso mollare adesso. Forza,\r\nCereza... Lo stai facendo per Colm!",
  "HUD_INTERACT_TEXT_0004_CER": "Mi chiedo se sia stata Morgana a\r\nscegliere queste lampade. È buffo,\r\nma credo che abbiamo gusti simili!",
  "HUD_INTERACT_TEXT_0400_CER": "Un lago? Non mi fa per niente paura!\r\nMi sento come un pesce nell'acqua.",
  "HUD_PURPOSE_TXT_7001": "Sconfiggi i nemici\r\nnel tempo limite.",
  "HUD_PURPOSE_TXT_1090": "Porta le erbe a Morgana.",
  "HUD_PREVENT_TEXT_0008_CER": "Ho dimenticato la cesta con\r\nle erbe! Meglio non tornare\r\nda Morgana a mani vuote...",
  "HUD_INTERACT_TEXT_0011_CER": "Non sto andando in città!\r\nVado nella Foresta di Avalon!",
  "HUD_PURPOSE_TXT_1190": "Trova il secondo nucleo\r\nelementale."
}
