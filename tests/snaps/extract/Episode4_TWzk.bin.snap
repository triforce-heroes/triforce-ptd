{
  "SM_004080_0040_NAR": "「難得聽你說一句好話。\r\n我要盡情大鬧一場！」\r\n\r\n瑟蕾莎和小柴貓都精神百倍。\r\n他們肩並肩，然後開始把整座要塞\r\n鬧得天翻地覆！",
  "BK_4000_0040_NAR": "母親突然出現在瑟蕾莎的面前。\r\n這是怎麼一回事？",
  "SM_004060_0010_NAR": "只見狼站得直挺挺，\r\n靜靜地注視著瑟蕾莎。\r\n\r\n堅定的眼神就像在說：\r\n我也一起去！",
  "BK_4060_0040_POO": "「願妖精王國榮光永存！」",
  "IN_40000_0020_NAR": "瑟蕾莎著急地追了上去。\r\n",
  "LV_004020_0000_NAR": "隱約可見一座有如城堡般的巨大建築，\r\n矗立在一片昏暗中。",
  "CE_004800_0000_CER": "祂連那種事也辦得到嗎！？\r\n總之……得快點逃走！",
  "SM_004030_0050_CER": "「已經不關我的事了！」",
  "IN_40000_0010_NAR": "瑟蕾莎彷彿被一股力量吸引，\r\n一步步走向母親。",
  "LV_004085_0015_NAR": "小柴貓有點彆扭地回答。",
  "CE_004000_0000_CER": "媽咪！？\r\n怎麼會這樣……",
  "SM_004050_0060_NAR": "瑟蕾莎不顧一切地追了上去，\r\n甚至忘記了恐懼。\r\n",
  "BK_4080_0180_CER": "「對了……\r\n我曾經答應你\r\n會把你送回家吧。」\r\n",
  "BK_4080_0090_NAR": "以瑟蕾莎現在的能力，\r\n她只有一個辦法。",
  "BK_4080_0010_CER": "「小、小柴貓！？」",
  "SM_004020_0070_CER": "「我、我才不怕呢。\r\n我可是魔女！」",
  "LV_004025_0000_CER": "不知道妖精藏身在何處。\r\n必須保持安靜……",
  "SM_004010_0110_NAR": "「對救命恩人用這種態度，你這樣像話嗎！\r\n還不是因為你一直發呆，\r\n才會中那些妖精的無聊法術！」\r\n\r\n小柴貓不服氣地吼了回去。\r\n",
  "LV_004080_0000_CER": "情急之下用了修復魔導術……\r\n這還是我第一次成功呢。",
  "SM_004070_0030_NAR": "你為什麼就是不懂？\r\n我們只想取那個小丫頭的性命！",
  "BK_4020_0090_POO": "「然而，無論汝等有何等幸運，\r\n都終將無法戰勝本王，\r\n汝等可知箇中原由？」",
  "BK_4020_0020_NAR": "說話的是那隻看起來最傲慢的妖精。\r\n",
  "CE_004010_0010_CER": "壞了的話，只要修好就行了！",
  "BK_4020_0100_POO": "「本王為妖精中的翹楚——\r\n以上天賜予之睿智，\r\n引領王國走向光明者——」",
  "SM_004070_0120_CER": "「小柴貓！」",
  "LV_004015_0000_CER": "這、這座森林，我一個人就應付得來。\r\n沒錯，就算只有一個人我也不怕……！",
  "SM_004040_0000_NAR": "瑟蕾莎再次發現了小柴貓。\r\n\r\n一群妖精把祂逼入了絕境，\r\n看來是傷勢太重使祂動彈不得了。",
  "SM_004140_0040_NAR": "瑟蕾莎注意到自己灰頭土臉的，\r\n急忙把臉上的灰燼擦掉。\r\n\r\n小柴貓看著瑟蕾莎的臉，\r\n笑到在地上打滾。",
  "BK_4020_0050_NAR": "看起來很傲慢的妖精\r\n用非常高高在上的態度不停地說著……\r\n但祂的說話方式太古怪，\r\n聽不太懂祂想表達什麼。",
  "BK_4020_0170_POO": "「既然如此，\r\n本王就在此展現\r\n驚天動地的王之力吧！」",
  "SM_004070_0040_NAR": "我不是說了嗎？\r\n只要你別礙我的事，我就送你回魔界！\r\n",
  "BK_4020_0140_CER": "「隨便啦……\r\n總而言之，就是你\r\n害小柴貓受苦的吧？\r\n你這壞孩子，必須接受懲罰！」",
  "SM_004035_0020_NAR": "小柴貓不會有事吧……\r\n她的腦中閃過了一絲擔憂。",
  "SM_004070_0160_CER": "「白狼……謝謝你！」",
  "BK_4070_0010_CER": "「我、我也不管你了。」",
  "LV_004060_0010_CER": "雖然聽不懂祂們的談話內容……\r\n但看祂們說得那麼興奮，\r\n鐵定是在策劃非常惡劣的事！",
  "LV_004925_0000_CER": "「都濕透了。\r\n你看，我就說吧。」",
  "SM_004020_0000_CER": "「哼，我已經熟悉魔導術要怎麼用了，\r\n就算沒有你在也無所謂。」",
  "SM_004035_0010_NAR": "和小柴貓大吵時咄咄逼人的精力，\r\n早已消失殆盡。",
  "SM_004070_0070_NAR": "好了，給你最後一次機會！\r\n你還是執意要妨礙我們嗎？",
  "SM_004110_0110_NAR": "他們一語不發地對望。\r\n得到力量\r\n同時也意味著離別。\r\n\r\n他們的腦海裡不約而同地\r\n閃過了這個想法。",
  "SM_004010_0150_NAR": "然後，瑟蕾莎的怒意終於\r\n徹底爆發了。",
  "BK_4060_0000_POO": "「不！豈有此理！\r\n本王之傀儡竟如此脆弱不堪，\r\n如今本王遭到詛咒火焰灼燒著身軀！」",
  "LV_004005_0010_CER": "真奇怪……\r\n明明有聽到聲音啊……",
  "BK_4080_0060_CER": "「你不要逞強！\r\n現在亂動的話，傷口會更……」",
  "BK_4000_0000_NAR": "有一群妖精正躲起來\r\n窺視著瑟蕾莎他們。\r\n",
  "BK_4080_0100_MOR": "「聽好了，瑟蕾莎。」",
  "SM_004100_0020_CER": "「應該快到萊卡翁\r\n所在的地方了。\r\n我們走吧，小柴貓！」",
  "SM_004050_0090_CER": "「白狼！？」",
  "SM_004090_0030_LUC": "「我很快就可以讓你看到真正的我了……\r\n到時候再好好聊聊吧。」",
  "SM_004050_0010_NAR": "小柴貓被一群妖精抓住了。\r\n其中，唯有一隻妖精\r\n表現得特別高高在上。\r\n",
  "CE_004030_0000_CER": "升天去吧！",
  "SM_004050_0130_CER": "「等、等一下！ 裡面很危險！」",
  "SM_004090_0000_LUC": "「真虧你能\r\n克服重重難關來到這裡。\r\n瑟蕾莎，你真是太厲害了。」",
  "SM_004050_0020_NAR": "那隻妖精好像在說些什麼，\r\n但是距離太遠了，聽不清楚。\r\n",
  "BK_4080_0140_NAR": "那是瑟蕾莎為了成為\r\n像媽媽一樣的魔女而珍惜至今的頭髮。",
  "SM_004080_0025_NAR": "團隊合作得天衣無縫。",
  "LV_004070_0000_CER": "這麼說來，我好像曾經和貞德\r\n一起爬上鐘樓的屋頂……",
  "SM_004050_0125_CER": "「從這裡進去\r\n應該就不會被妖精發現了……\r\n白狼，謝謝你告訴我！」",
  "LV_004055_0000_CER": "這個會延伸到哪裡啊？\r\n小柴貓到底被帶去哪了呢……！",
  "LV_004040_0010_NAR": "要塞的上方，有一道令人毛骨悚然的裂縫。",
  "LV_004090_0000_NAR": "眼前出現一顆散發紅光的球體。\r\n他們終於找到最後的元素核心。",
  "SM_004060_0025_CER": "啊……剛剛的話不要告訴小柴貓喔！」",
  "SM_004050_0070_CER": "「好像沒辦法從這裡進去……\r\n沒有其他入口嗎？」",
  "SM_004030_0040_NAR": "此時，瑟蕾莎突然聽見了熟悉的聲音。\r\n是小柴貓。\r\n\r\n祂好像受傷了，\r\n正在躲避一群妖精的追擊。",
  "LV_004020_0010_CER": "沒事的，瑟蕾莎。就算落單也不用怕……\r\n我一個人沒問題的……\r\n我一個人也辦得到……",
  "CE_004815_0000_CER": "就是現在！",
  "SM_004060_0000_CER": "「白狼，這裡是妖精的要塞。\r\n待在這種地方很危險的。」",
  "LV_004085_0020_CER": "嗯，非常時髦……",
  "BK_4000_0050_CER": "「媽咪……？是媽咪嗎！？」\r\n",
  "BK_4080_0030_NAR": "那是遭受妖精攻擊時受的傷。\r\n小柴貓一直刻意遮掩著。",
  "BK_4070_0040_NAR": "瑟蕾莎說的話在森林裡迴盪。\r\n隨之而來的，是一片沉重的死寂。",
  "Pooka_vo_disappear_01": "唔！方才那是偶然！偶然而非必然！\r\n肯定如此、絕非妄言！",
  "SM_004070_0130_NAR": "瑟蕾莎不顧一切地\r\n飛奔了出去。",
  "BK_4020_0030_CER": "「祂在說人話！\r\n雖然講得有點奇怪……」\r\n",
  "LV_004900_0000_CER": "沒事、沒事的……這片葉子很穩固。\r\n我一定不會沉下去……",
  "SM_004140_0020_CER": "「咦？\r\n怎、怎樣啦？有什麼好看的？」",
  "BK_4000_0020_ROS": "「莎……瑟蕾莎……！」",
  "SM_004010_0130_CER": "「還有，你一直把我當成弱者對待，\r\n但你自己還不是一樣？\r\n一旦落單就什麼也辦不到！」",
  "BK_4080_0240_NAR": "瑟蕾莎把小柴貓緊擁在懷中。\r\n\r\n總覺得小柴貓\r\n似乎也用力地抱住了她。",
  "SM_004110_0010_MOR": "「瑟蕾莎，你的頭髮是怎麼一回事！？\r\n我不是說過要好好愛惜頭髮嗎！？」",
  "SM_004140_0010_CER": "「痛死我了……\r\n真是的，那傢伙搞什麼啊！」",
  "SM_004010_0020_NAR": "瑟蕾莎崩潰地大哭，\r\n好不容易才回過神來。\r\n原來那些全都是\r\n妖精刻意讓她看見的幻影。",
  "SM_004070_0100_NAR": "「誰會相信妖精說的話！\r\n小心我把你們全部吃掉！」",
  "BK_8120_0000_CER": "「這樣一來，我們就破壞了\r\n所有的元素核心！」",
  "SM_004070_0090_NAR": "然後……\r\n小柴貓緩緩地開口了。",
  "SM_004020_0060_NAR": "看見跳出來的兔子，\r\n瑟蕾莎鬆了一口氣……\r\n",
  "SM_004110_0100_CER": "「那是當然的，等著瞧吧。\r\n而且，我一定會到萊卡翁的身邊，\r\n把力量拿到手。\r\n\r\n然後，再把你送回家……」",
  "LV_004010_0003_CER": "媽咪！",
  "BK_4020_0040_POO": "「不知反省的小丫頭！\r\n本王要代替無能的部下，\r\n揮下憤怒的鐵鎚！」\r\n",
  "LV_004930_0000_CER": "好燙！\r\n好猛烈的火焰……會被燒成焦炭的！",
  "BK_4020_0070_CER": "「呃……你好像\r\n不太擅長說人類的語言。\r\n總而言之，\r\n你就是妖精王對吧……？」\r\n",
  "LV_004060_0000_NAR": "可以聽見那群妖精\r\n正在大聲爭論著什麼。",
  "BK_4070_0000_NAR": "接著，祂發出了細微的低鳴聲。",
  "BK_4020_0150_NAR": "小柴貓也等不及要大鬧一場，\r\n準備要祂為先前的惡行付出代價。",
  "SM_004010_0060_NAR": "但瑟蕾莎就只是蜷縮在地上，\r\n不停地哭泣。",
  "SM_004140_0050_CER": "「那個傢伙……\r\n下次我絕對不放過祂！\r\n\r\n小柴貓……\r\n你要笑到什麼時候啊！\r\n\r\n好了，快點站起來，\r\n要出發了！」",
  "SM_004040_0010_CER": "「就、就說……\r\n就說不關我的事了……！」",
  "SM_004110_0050_MOR": "「雖然還有很多話想說，\r\n但還是等你平安歸來之後再說吧。」\r\n",
  "LV_004935_0000_NAR": "瑟蕾莎獨自遇見了妖精。\r\n要怎麼做才能順利逃脫呢？",
  "LV_004065_0000_CER": "竟然有那麼多妖精……！？\r\n我有辦法平安離開這裡嗎？",
  "SM_004050_0030_CER": "「那些妖精到底在盤算什麼？」",
  "SM_004050_0120_NAR": "以瑟蕾莎的體型，\r\n應該可以勉強鑽過去。",
  "SM_004050_0000_CER": "「祂好像……在說些什麼……？」",
  "LV_004010_0010_CER": "媽咪……等等我！！\r\n媽咪！！！",
  "SM_004050_0110_NAR": "牠對著瑟蕾莎嚎叫，彷彿在呼喚她一般，\r\n隨後跑了起來。",
  "SM_004110_0090_MOR": "「縱使妖精不好對付，\r\n也必須盡全力克服困難。\r\n\r\n願魔導的庇佑與你同在。\r\n瑟蕾莎，你一定要平安無事……」",
  "SM_004020_0075_CER": "「我馬上就能找到那隻狼！」",
  "Pooka_vo_disappear_07": "可惡……！\r\n區區見習魔女，竟如此狡詐！",
  "LV_004030_0000_NAR": "瑟蕾莎獨自挺身面對妖精。\r\n到底該怎麼做才能打敗祂們呢？",
  "BK_4020_0120_POO": "「妖精王——普卡！」\r\n",
  "CE_004810_0000_CER": "這樣下去沒完沒了！\r\n得先解決那隻妖精……！",
  "LV_004025_0010_CER": "要是被妖精發現就糟了。\r\n必須保持安靜……",
  "BK_4020_0000_NAR": "他們倏地停下腳步。\r\n周圍瀰漫著令人毛骨悚然的氣息。\r\n然後……",
  "SM_004070_0010_NAR": "總算找到小柴貓了。\r\n祂全身布滿了嚴重的傷口。\r\n",
  "CE_004010_0000_CER": "就用我的修復魔導術\r\n修好那個壞掉的拷問器具……！",
  "BK_4020_0110_POO": "「不錯！本王正是——」",
  "SM_004070_0020_NAR": "藏身在暗處的瑟蕾莎\r\n聽見了妖精的談話內容。\r\n",
  "BK_4020_0080_POO": "「愚蠢之徒！\r\n蠢笨如汝，竟有幸就近目睹本王尊容。\r\n如此蒙受眷顧，值得讚許！」",
  "BK_4090_0010_CER": "「等一下，媽咪！\r\n不要再丟下我一個人！」",
  "LV_004050_0000_CER": "小柴貓真是的……！\r\n居然被妖精抓住，真是粗心！",
  "SM_004010_0100_NAR": "聽了小柴貓的話，\r\n瑟蕾莎倏地站起身。\r\n\r\n她的眼裡全是強烈的憤怒，\r\n和即將奪眶而出的眼淚。",
  "LV_004080_0010_CER": "還可以用在什麼地方呢……？",
  "SM_004010_0010_CER": "「媽咪！！」",
  "LV_004035_0000_CER": "加油，瑟蕾莎！\r\n不可以在這種地方放棄！",
  "BK_4060_0045_POO": "「我按！」",
  "LV_004040_0020_CER": "那是什麼……？\r\n比一般看到的裂縫還要大很多。",
  "SM_004050_0040_NAR": "妖精把小柴貓搬運到建築物裡了。",
  "BK_4080_0080_NAR": "必須趕快\r\n把小柴貓的傷口縫補起來。",
  "LV_004085_0010_NAR": "「這點傷不算什麼。\r\n不過……我不討厭這個蝴蝶結。」",
  "LV_004905_0000_CER": "小柴貓，原來你會游泳！？\r\n我……我不想弄濕衣服！",
  "BK_4080_0190_CER": "「跟惡魔約好卻毀約，\r\n有損魔女的尊嚴。」",
  "SM_004060_0030_NAR": "於是，瑟蕾莎決定\r\n和白狼一起在要塞中前進。\r\n",
  "BK_4080_0160_NAR": "「那樣做沒關係嗎？」\r\n小柴貓擔心地說。\r\n",
  "SM_004080_0010_NAR": "瑟蕾莎突然出現\r\n讓那群妖精大吃了一驚。然後……",
  "SM_004090_0020_LUC": "「惡魔的力量也是你實力的一部分……\r\n你一定可以成為很了不起的魔女。」",
  "LV_004005_0000_CER": "嗯……？\r\n小柴貓，你剛才有說話嗎？",
  "BK_4080_0110_MOR": "「頭髮是暗影魔女的魔導器之一，\r\n也是召喚惡魔的必要物件。」",
  "CE_004030_0020_CER": "永別了！",
  "BK_4000_0010_NAR": "祂們悄悄地站起來，\r\n然後開始吟唱某種咒語。",
  "SM_004030_0030_CER": "「誰要理那種粗暴的傢伙啊。\r\n這座森林，我一個人就能……」",
  "BK_4060_0010_POO": "「然而，縱然此身被燒成灰燼，\r\n本王也絕不輕饒作惡多端之徒！」\r\n",
  "BK_4060_0020_CER": "「那隻妖精在說什麼啊？\r\n難道祂想要犧牲自己……」",
  "LV_004070_0010_CER": "貞德明明很害怕卻還強裝鎮定……呵呵呵。",
  "SM_004080_0020_NAR": "趁妖精還沒回神，\r\n瑟蕾莎跑去放了小柴貓。",
  "BK_4080_0150_NAR": "而她的頭髮正在迅速地\r\n把小柴貓的傷口縫起來。",
  "SM_004100_0000_CER": "「白狼！\r\n幸好你平安無事。」",
  "BK_4080_0120_MOR": "「因此，對魔女而言，\r\n頭髮跟性命同樣重要。」",
  "BK_4080_0040_CER": "「好嚴重的傷……！」",
  "CE_004030_0010_CER": "消逝吧！",
  "SM_004070_0050_NAR": "祂使用的是惡魔的語言。\r\n\r\n那隻看起來最傲慢的妖精，\r\n正在向小柴貓提出交易。",
  "SM_004020_0020_CER": "「小柴貓……！？」",
  "SM_004070_0140_CER": "「別來礙事！」",
  "BK_4070_0030_CER": "「我要跟你絕交！」",
  "BK_4020_0160_POO": "「可悲啊可悲！\r\n比在短命愛情中失戀的天使\r\n還要可悲！」",
  "SM_004110_0020_CER": "「因、因為……\r\n發生了不得已的狀況。」",
  "SM_004010_0170_NAR": "瑟蕾莎的一句話\r\n讓小柴貓突然愣住了。",
  "BK_4080_0200_CER": "「所以說，那個……」",
  "LV_004015_0010_CER": "白狼到底往哪裡去了……\r\n應該是這個方向吧？",
  "LV_004950_0000_CER": "媽咪！\r\n不要丟下我！",
  "SM_004040_0020_NAR": "回過神來，瑟蕾莎才發現\r\n自己已經邁開步伐跑了起來。\r\n而且，是往小柴貓的方向跑……",
  "SM_004140_0060_NAR": "瑟蕾莎鼓起臉頰，\r\n氣呼呼地向前走。\r\n\r\n小柴貓急忙追過去，\r\n偷瞄瑟蕾莎的表情……\r\n\r\n但是看見她鼓起的臉頰，又差點笑出來，\r\n只能拚命忍住笑意。",
  "SM_004010_0140_NAR": "「要是沒有我，你早就變成\r\n那群妖精的食物了！」\r\n\r\n累積了許多不滿的小柴貓\r\n也不甘示弱地回嘴，爭執眼看越演越烈。",
  "CE_004020_0000_CER": "就是現在，小柴貓！\r\n把那傢伙推進去！！",
  "BK_4080_0230_CER": "「小事一樁！」",
  "SM_004035_0000_NAR": "瑟蕾莎總算度過了難關。\r\n這比她想像中的還要吃力。",
  "SM_004020_0010_CER": "「你明明就不能沒有我……\r\n之後你想反悔也來不及了！」",
  "SM_004070_0060_NAR": "瑟蕾莎不寒而慄，\r\n心臟簡直快要結凍了。",
  "SM_004140_0030_CER": "「啊——！怎麼會這樣！\r\n太、太過分了，討厭～！！」",
  "SM_004010_0080_CER": "「小柴貓你這個笨蛋！\r\n竟然對媽咪做那麼過分的事！」",
  "LV_004045_0000_CER": "白狼……你要去哪裡？\r\n難道說你知道其他的入口？",
  "LV_004915_0000_NAR": "看到葉子照著自己的意思漂動，\r\n小柴貓看起來很開心。",
  "SM_004020_0040_NAR": "咕嚕一聲，瑟蕾莎嚥了嚥口水。\r\n\r\n",
  "BK_4020_0010_POO": "「聽好了！小丫頭！　\r\n汝等不但讓本王心愛的王國\r\n陷入苦難與混沌，\r\n還喚醒禁忌之子，到底有何居心！」",
  "BK_8120_0010_CER": "「小柴貓，這是最後的\r\n元素之力了。\r\n一起來試試看吧！」",
  "SM_004070_0000_CER": "「小柴貓……！」",
  "SM_004070_0080_NAR": "妖精逼迫小柴貓做出回答。\r\n瑟蕾莎屏氣凝神地聽下去。",
  "LV_004030_0010_CER": "有沒有什麼……可以用的東西？",
  "SM_004070_0110_NAR": "小柴貓狠狠瞪著那群妖精，\r\n果斷地拒絕了。",
  "CE_004805_0000_CER": "到這裡應該就能安心了吧……",
  "SM_004010_0030_NAR": "但就算只是幻影，\r\n也足夠讓瑟蕾莎心碎了。",
  "SM_004010_0120_CER": "「你這種野蠻的惡魔\r\n怎麼可能懂我的感受！」\r\n",
  "SM_004060_0020_CER": "「白狼，謝謝你……！\r\n其實我一個人有點害怕。",
  "LV_004040_0000_NAR": "眼前出現了一座非常巨大的鐵製建築。\r\n似乎是妖精建造的要塞。",
  "LV_004055_0010_CER": "就連魔導術的訓練\r\n也沒有這麼累人……！",
  "LV_004910_0000_CER": "小、小柴貓！\r\n不要讓葉子漂那麼快！",
  "LV_004085_0000_CER": "我的修復魔導術怎麼樣？\r\n這就是平時練習的成果！",
  "BK_4080_0130_CER": "「眼下的事……\r\n比頭髮重要多了。」",
  "SM_004050_0050_CER": "「小柴貓……！」",
  "BK_4080_0020_NAR": "小柴貓的腳上\r\n裂了一個很大的傷口。\r\n甚至還有一些棉花露了出來。",
  "BK_4060_0070_NAR": "瑟蕾莎和小柴貓被炸飛出去，\r\n爆炸引起的濃煙將兩人吞沒。\r\n他們會平安無事嗎……？",
  "CE_004815_0010_CER": "瞄準那隻妖精！",
  "BK_4000_0030_CER": "「誰在叫我？」",
  "BK_4080_0050_NAR": "再這樣下去，\r\n小柴貓很快就會\r\n因魔力枯竭而死。",
  "SM_004080_0030_CER": "「還有力氣叫，看來沒有大礙。\r\n那我們就來收拾這些傢伙吧！」\r\n",
  "SM_004100_0010_NAR": "看見白狼很有精神的模樣，\r\n瑟蕾莎放下了心中的大石頭。",
  "LV_004920_0000_CER": "「小柴貓！！\r\n就叫你不要那麼快！！」",
  "SM_004030_0010_NAR": "雖然魔導術用得稍微順手些了，\r\n但獨自在這座森林裡前進\r\n還是很吃力。",
  "BK_4060_0030_NAR": "瑟蕾莎他們從普卡的話中察覺到危險，\r\n於是開始拔腿狂奔。\r\n",
  "SM_004050_0115_NAR": "瑟蕾莎跟著牠過去，\r\n接著便看見了一個小洞，\r\n這似乎是通往要塞內部的路。",
  "SM_004030_0020_NAR": "要是有小柴貓在……",
  "LV_004940_0000_NAR": "隱約可見一座奇特的建築\r\n矗立在一片昏暗中。",
  "SM_004050_0100_NAR": "白狼突然出現在瑟蕾莎的面前。",
  "LV_004010_0000_CER": "媽咪？\r\n是媽咪嗎？",
  "BK_4080_0170_CER": "「頭髮這種東西……\r\n再留就有了。」",
  "SM_004080_0000_CER": "「小柴貓！」",
  "LV_004075_0000_CER": "啊，小柴貓……！",
  "IN_4010_0010_NAR": "就這樣，瑟蕾莎和小柴貓\r\n又聚在一起了。\r\n然後他們再度啟程，\r\n去尋找在不知不覺中消失蹤影的狼。",
  "SM_004110_0070_MOR": "「破壞妖精結界的魔導術\r\n只差一點就能完成了。\r\n在那之前，要想盡辦法活下去。」",
  "BK_4080_0220_NAR": "「這樣比較省事。帶著我走吧。」\r\n瑟蕾莎好像聽見祂小聲地說了這句話。",
  "BK_4090_0040_NAR": "母親的慘叫聲在森林裡迴盪著。\r\n聲音如同刀刃一般\r\n刺進了瑟蕾莎的心。",
  "SM_004110_0080_CER": "「我、我知道了。\r\n謝謝你，摩根娜。」",
  "SM_004040_0030_CER": "「我只是不想讓媽咪的\r\n寶貝布偶受損而已！」",
  "BK_4020_0075_CER": "總而言之，\r\n你就是妖精王對吧……？」\r\n",
  "SM_004010_0040_NAR": "小柴貓發出了一聲低鳴，\r\n催促瑟蕾莎快點站起來。\r\n",
  "SM_004110_0000_NAR": "摩根娜的幻影出現了。\r\n\r\n她一看見瑟蕾莎的模樣\r\n便氣得橫眉豎目地說……",
  "LV_004945_0000_CER": "我竟然可以推動這麼巨大的齒輪！\r\n雖然我轉錯方向了……",
  "BK_4080_0210_NAR": "小柴貓變回了布偶的模樣，\r\n縮進瑟蕾莎的懷中。",
  "SM_004110_0040_MOR": "「竟然用自己\r\n珍貴的頭髮來救惡魔……\r\n魔女本該使喚惡魔，\r\n怎能反過來遭惡魔利用？」",
  "SM_004010_0160_CER": "「是我把你召喚出來的！\r\n區區惡魔，只要閉上嘴\r\n乖乖為魔女做事就好！」",
  "SM_004110_0120_CER": "「總之……\r\n打起精神出發吧！」",
  "SM_004010_0070_NAR": "「要不是有我劃破幻覺，\r\n你早就一頭栽下懸崖了！」\r\n\r\n小柴貓的語氣\r\n逐漸激動了起來。",
  "SM_004090_0010_CER": "「這不是我一個人的功勞。\r\n多虧有小柴貓在，\r\n我才能來到這裡。」",
  "SM_004110_0030_NAR": "瑟蕾莎向摩根娜說明了\r\n為了救小柴貓\r\n而剪掉頭髮的事。",
  "BK_4000_0055_ROS": "「過來這裡，瑟蕾莎……\r\n我的寶貝女兒……」",
  "SM_004070_0150_NAR": "白狼主動去當誘餌，\r\n分散了妖精的注意力。\r\n",
  "SM_004020_0030_NAR": "沒有傳來任何回應。\r\n"
}
