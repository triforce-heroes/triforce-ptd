{
  "SM_003040_0080_NAR": "마계로 돌아가지 못하면\r\n죽고 마는 체셔는 어이없는\r\n꿈속 이야기에 울화가 치밀었습니다.",
  "SM_003035_0020_CER": "「아직 네 이름을 몰라.\r\n알려 주지 않을래……?」",
  "SM_003020_0030_NAR": "체셔는 허세를 부리며 대답하지 않았지만\r\n크게 다치지는 않은 모양입니다.\r\n",
  "CE_003040_0010_CER": "빨리 도와줘야 해!",
  "SM_003020_0080_CER": "「저런 걸 무서워하고만 있으면\r\n강한 마녀가 될 수 없어.\r\n\r\n다음엔 꼭 해치울 거야!\r\n……할 수 있어」",
  "SM_003035_0010_CER": "「그, 그런가……?」",
  "SM_003020_0000_NAR": "갑옷이 망가진 괴물은\r\n황급히 도망가 버렸습니다.",
  "SM_003080_0040_FAS": "「어디 다치기라도 했니?」",
  "SM_003010_0040_NAR": "기죽은 목소리로 말하는 세레자를 보고\r\n체셔는 말문이 막혔습니다.",
  "SM_003035_0080_LUC": "「하지만 마녀인 너라면\r\n분명히 내 저주를 풀 수 있어」",
  "SM_003080_0200_FAS": "「너희들이 지금까지 지나간 곳 중에\r\n데려다줄 수 있는 곳이\r\n있을지도 모르겠구나」",
  "CE_003050_0000_CER": "자, 밥 먹을 시간이야.\r\n배가 터지도록 먹으렴!!",
  "LV_003010_0000_CER": "앗, 여기는……",
  "SM_003050_0140_MOR": "「앞으로도 절대\r\n잊지 마세요……」\r\n",
  "LV_003910_0040_CER": "겁쟁이로…… 있긴 싫어!",
  "BK_3000_0030_CER": "「이제 너 같은 건 무섭지 않아!」\r\n",
  "SM_003030_0010_NAR": "하지만 체셔는 고개를 돌리고\r\n본체만체합니다.",
  "SM_003035_0120_LUC": "「응…… 어머니는\r\n숲 밖에서 나를 계속 기다리고 계셔」",
  "BK_3030_0070_CER": "「체셔!」",
  "LV_003920_0000_CER": "으으……\r\n나…… 더는……",
  "SM_003050_0130_MOR": "「어떻게 악마를 복종시키고\r\n자신의 무기로 삼는가로\r\n마녀의 품위가 정해집니다」",
  "LV_003035_0010_NAR": "체셔가 세레자를 나무라듯이\r\n으르렁댑니다.",
  "SM_003035_0150_LUC": "「그리고 함께 숲을 빠져나가자.\r\n너희 어머니를 구하기 위해\r\n나도 힘을 보탤게.\r\n\r\n그렇게 하면 너도 나도\r\n다시 가족과 함께 살 수 있어」",
  "LV_003020_0000_CER": "이건…… 뭐지? 발톱 자국?",
  "BK_3030_0080_NAR": "큰일입니다! 체셔는 이대로\r\n괴물에게 잡아먹히는 걸까요?\r\n",
  "LV_003035_0020_NAR": "……하지만 세레자는 대답할 기운도\r\n없었습니다.",
  "SM_003030_0050_NAR": "모처럼 좋았던 기분을\r\n체셔가 망치네요.",
  "SM_003050_0090_MOR": "「그건 그렇고, 드디어\r\n당신을 구할 준비가 끝났습니다」",
  "LV_003905_0010_NAR": "괴물의 몸은 마치 철같이 단단합니다.\r\n체셔도 분한 듯이 으르렁거립니다.",
  "LV_003040_0000_NAR": "앞에 보이는 것은 물의 사당일까요?\r\n그 바로 앞에 기묘하게 생긴 \r\n굵직한 철장이 우뚝 솟아 있습니다.",
  "SM_003080_0070_CER": "「너는 알고 있지?」",
  "CE_003805_0000_CER": "……!\r\n저거, 쓸 만할지도 몰라……!",
  "BK_3020_0090_NAR": "세레자는 너무 무서운 나머지\r\n체셔를 안아 들고\r\n도망쳐 버렸습니다.",
  "LV_003025_0000_NAR": "입을 벌리고 있는 괴물이 연상되는\r\n커다란 나무가 쓰러져 있군요.",
  "SM_003035_0060_CER": "「저기 류카온.\r\n너는 대체 누구야?\r\n왜 이런 곳에 있는 거야……?」",
  "SM_003020_0070_NAR": "세레자의 활약이 없었다면\r\n지금쯤 괴물의 밥이\r\n되었겠지만……\r\n\r\n자기보다 약한 세레자에게\r\n도움을 받았다는 사실이\r\n도무지 내키지 않았습니다.",
  "SM_003080_0030_FAS": "「……이런.\r\n엘레멘트 코어를 파괴했는데도\r\n근심에 찬 얼굴이구나」",
  "LV_003050_0020_NAR": "……하지만 이제 와서 돌아갈 수는 없습니다.",
  "LV_003045_0030_CER": "나…… 나는……",
  "LV_003915_0000_NAR": "세레자는 눈물을 꾹 참고\r\n자기 등을 떠밀듯 앞으로 나아갔습니다.",
  "LV_003050_0010_NAR": "말하고 나니, 세레자는\r\n두려운 마음이 더 커졌습니다.",
  "SM_003010_0000_NAR": "둘은 안전한 장소까지 왔지만\r\n체셔는 머리끝까지 화가 났네요.",
  "SM_003040_0070_CER": "「하지만 엘레멘트 코어도 늑대도\r\n걔가 말한 대로였잖아?\r\n\r\n그냥 꿈이 아니야.\r\n류카온 말은 진짜야!」",
  "SM_003080_0190_FAS": "「그렇지.\r\n내가 이 숲의 \"비밀 통로\"를\r\n알고 있는데 말이야」",
  "SM_003080_0000_FAS": "「어서 오렴, 꼬마 아가씨.\r\n이렇게나 멀쩡하다니, 솔직히 놀랍구나」",
  "CE_003020_0000_CER": "꺄악",
  "SM_003080_0140_FAS": "「그 요새에 들어가서 나온 자는\r\n아무도 없지. ……그래도 갈 생각이니?」",
  "SM_003020_0100_NAR": "체셔는 고개를 돌린 채\r\n세레자의 말을\r\n못 들은 척했습니다.",
  "LV_003060_0000_CER": "체셔를 구해야 해!",
  "SM_003035_0110_CER": "「혹시\r\n류카온도 엄마랑……?」",
  "SM_003020_0090_NAR": "그렇게 마음먹은 세레자의 눈빛이\r\n체셔와 숲에 들어왔을 때보다\r\n조금 반짝여 보입니다.\r\n",
  "PH_3020_0000_CER": "나도 할 수 있는 게 있을 거야!",
  "SM_003080_0170_FAS": "「뭐, 너희 둘이 함께한다면\r\n걱정할 필요는 없으려나?」",
  "LV_003075_0020_NAR": "대체 왜 우리를……?\r\n하고 세레자는 생각했지만\r\n상상하기를 관뒀습니다.",
  "SM_003020_0020_CER": "「체셔, 괜찮아!? 다치진 않았어?」\r\n",
  "SM_003040_0100_CER": "「……또 그렇게 난폭하게 굴지」\r\n",
  "SM_003040_0010_NAR": "체셔는 살짝 붉게 물든\r\n세레자의 얼굴을 불쾌하다는 듯이\r\n쳐다보았습니다.",
  "BK_3000_0020_NAR": "『이번에야말로 해치워 주마!』\r\n세레자도 괴물을 날카롭게 노려봅니다.",
  "SM_003050_0120_CER": "「아, 알겠어」",
  "LV_003005_0000_CER": "……이건?",
  "LV_003010_0010_NAR": "그곳은 전에도 한 번 온 적 있는 장소였습니다.\r\n돌고 돌아 제자리로 온 모양입니다.",
  "SM_003080_0100_CER": "「빨리 알려 줘!」",
  "SM_003080_0090_CER": "「그런 건 상관없어!」",
  "SM_003035_0180_LUC": "「나도 너를 더욱 알고 싶어.\r\n우리는 같은 아픔을\r\n나누고 있으니까……」",
  "BK_3030_0050_NAR": "한 발짝, 또 한 발짝\r\n괴물에 밀려 막다른 곳으로 내몰린 체셔.",
  "BK_8110_0030_CER": "「너를 집으로 돌려보낼 수 있는\r\n힘은 아닐지도 모르지만……\r\n분명 도움이 될 거야」",
  "SM_003050_0070_NAR": "좀처럼 들을 수 없는 모르가나의\r\n칭찬에 세레자는 기뻐서\r\n날아갈 것 같은 마음을\r\n꼭 붙잡았습니다.",
  "SM_003050_0000_MOR": "「세레자, 무사해서 다행이군요」",
  "LV_003905_0000_CER": "안 돼……\r\n이길 수가, 없어!",
  "LV_003910_0050_CES": "네가 뭘 할 수 있다는 거야?\r\n아무도 너한테 기대하지 않아!",
  "BK_3030_0130_CER": "「난 강한 마녀가 될 거야!」",
  "BK_3030_0020_NAR": "무심코 구석에 숨어 버린 세레자.\r\n체셔는 망설임 없이\r\n괴물에게 뛰어들었습니다.",
  "SM_003035_0050_LUC": "「세레자…… 예쁜 이름이네」",
  "BK_3030_0100_CER": "「난…… 또 구하지 못하는 거야?」",
  "BK_3030_0010_NAR": "『물러나 있어!』\r\n체셔는 세레자에게 소리쳤습니다.",
  "BK_3030_0090_CER": "「나…… 난……」",
  "SM_003050_0040_NAR": "세레자는 흥분하며\r\n재버워크를 물리친 이야기를\r\n들려주었습니다.",
  "BK_8110_0000_CER": "「또 새로운 힘이네!」",
  "SM_003020_0050_CER": "「저 괴물, 다시 돌아올까?\r\n……그래도 저 갑옷만 부수면\r\n어떻게든 될지도 몰라!」",
  "CE_003010_0000_CER": "체셔!\r\n돌 엘레멘트의 힘을 써 봐!",
  "SM_003040_0060_NAR": "……이야기를 들은 체셔는\r\n세레자가 꿈에서 들은 말만 믿고\r\n위험한 숲속으로 나아간다는 사실에\r\n기가 막혀 입이 다물어지지 않았습니다.",
  "SM_003010_0010_CER": "「……」",
  "LV_003045_0010_NAR": "세레자에게 들리도록\r\n일부러 큰 소리로 혼잣말을 하는 체셔.",
  "LV_003050_0000_CER": "혹시 이 주변은\r\n그 커다란 괴물의 영역인 걸까……?",
  "LV_003080_0010_CER": "그럼 부탁해!\r\n나를 마지막 엘레멘트 코어로 데려다줘!",
  "_31": "",
  "LV_003045_0020_NAR": "세레자는 불안한 마음이 더욱 커져만 갑니다.",
  "SM_003080_0130_FAS": "「요정 중에서도 유난히 거친 녀석들이\r\n모여 있다는 요새 안이란다」",
  "BK_3020_0000_NAR": "무시무시한 괴물의 철같이 단단한 몸.\r\n체셔의 발톱이 부러질 것만 같습니다.",
  "SM_003035_0160_CER": "「류카온……\r\n응! 나 열심히 할게!」",
  "BK_3000_0010_CER": "「저 괴물……!」",
  "SM_003035_0085_LUC": "「게다가……」",
  "LV_003910_0060_CER": "어…… 엄마는 나를 믿고 있어!",
  "LV_003920_0020_CER": "싫어……!\r\n그만……! 그만해……!",
  "LV_003070_0020_NAR": "부루퉁하게 대답하지만\r\n체셔도 싸우고 싶어 근질근질했습니다.",
  "SM_003035_0100_LUC": "「네 악몽……\r\n어머니를 만나고 싶다는 강한 마음.\r\n나도 그 마음 뼈저리게 잘 알아.\r\n\r\n그래서 너의 힘이 되고 싶어」",
  "SM_003080_0210_FAS": "「원한다면 언제든지 안내할 테니\r\n나에게 말하려무나」",
  "SM_003030_0030_NAR": "그러자 체셔는 빠릿빠릿하라느니,\r\n달리는 게 느리다느니,\r\n이게 어쩌니 저게 어쩌니\r\n하고 투덜거리기 시작했습니다.",
  "SM_003035_0130_LUC": "「나도 어머니를 만나고 싶어……」",
  "LV_003920_0010_CER": "뭐, 뭐야!?",
  "LV_003065_0000_CER": "갑옷 파편……?\r\n아무리 저 괴물이라도\r\n상처를 입긴 하는구나!",
  "LV_003070_0010_NAR": "『저런 녀석한테 꽁무니를 뺄 생각은 없어』",
  "SM_003080_0220_FAS": "「별거 아니란다.\r\n너희들이 난폭한 요정들을\r\n혼내 준 답례일 뿐이지」",
  "SM_003030_0000_NAR": "무시무시한 재버워크를 물리친\r\n세레자는 매우 기뻤습니다.",
  "SM_003030_0080_CER": "「아!」",
  "SM_003050_0030_CER": "「모르가나, 우리\r\n엄청난 괴물을 해치웠어!」",
  "CE_003040_0000_CER": "체셔!!!",
  "SM_003010_0060_NAR": "『어쨌든 나를 방해하지 마라!』\r\n체셔는 이리 말하는 게 고작이었습니다.",
  "SM_003040_0090_NAR": "『혹시라도 내가 못 돌아가게 되면\r\n너를 찢어 먹어 버리겠다!』\r\n울부짖어도 분노가 가라앉지 않습니다.",
  "SM_003040_0020_CER": "「어……?\r\n아, 아무것도 아니야.\r\n\r\n그보다 아직 체셔한테\r\n이 얘기를 안 했었지」",
  "SM_003010_0050_NAR": "그리고 자랑스러운 발톱으로 괴물에게\r\n상처 하나 입히지 못한 사실을 \r\n떠올리니 분통이 터집니다.",
  "LV_003075_0010_CER": "이렇게나 많이……",
  "SM_003010_0020_NAR": "입을 굳게 닫고 꼼짝하지 않는 세레자.\r\n무서워서 달아난 자신이\r\n한심하기 그지없습니다.",
  "SM_003020_0060_NAR": "살짝 자신이 생겨\r\n기세가 오른 세레자와 다르게\r\n체셔는 언짢은 듯 입을 열지 않았습니다.",
  "SM_003080_0020_FAS": "「설마 그 난폭한 녀석을 쓰러트리는\r\n마녀가 나타날 줄은 생각도 못 했단다」",
  "LV_003025_0010_NAR": "이 아발론의 숲에 있으니\r\n보이는 모든 게 자신을 덮칠 것만 같습니다.",
  "BK_3020_0080_NAR": "『네 탓이다! 나약한 녀석!』\r\n체셔는 세레자에게 고함을 지르지만……",
  "LV_003030_0000_CER": "바, 방금… 뭐지!?",
  "SM_003080_0010_FAS": "「요정 중에서도\r\n특히나 난폭하다는 재버워크가\r\n기다리고 있었는데 말이지」",
  "SM_003035_0040_CER": "「나는…… 세레자」",
  "SM_003080_0180_FAS": "「나도 난폭한 요정들한테는\r\n진저리가 난단다.\r\n너희의 활약을 기대하고 있으마!」",
  "SM_003050_0200_CER": "「이럴 때마다 진짜 꼴 보기 싫어!」",
  "LV_003900_0000_CER": "굉장해~!\r\n하늘을 나는 것 같아!",
  "LV_003915_0010_NAR": "울면 또 나약한 나로 돌아가 버려.\r\n나는 강해질 거야! ……속으로 되뇌었습니다.",
  "SM_003035_0140_LUC": "「그러니까 세레자\r\n부디 내 저주를 풀어 줘.\r\n마지막 엘레멘트 코어를 파괴하고\r\n나에게 와 줘……」",
  "LV_003020_0010_CER": "……설마 아니겠지.\r\n이렇게 큰 발톱 자국이 있을 리가 없어.",
  "LV_003035_0000_NAR": "『다음 엘레멘트 코어를 찾을 거 아냐?\r\n빨리 가!』",
  "SM_003080_0050_CER": "「안 다쳤어」",
  "SM_003050_0150_NAR": "모르가나의 모습이 사라지자\r\n체셔가 불만스러운 소리를 냈습니다.",
  "LV_003910_0020_CER": "나도…… 도망가고 싶지 않아!",
  "SM_003050_0110_MOR": "「하지만 요정의 결계를 파괴하기 위해선\r\n대규모의 마도술이 필요합니다.\r\n\r\n지금부터 조금씩 마법을 준비하면\r\n새벽녘쯤에는 술식이 완성되겠지요.\r\n……그때까지만 버티세요」\r\n",
  "SM_003080_0060_CER": "「그보다\r\n마지막 엘레멘트 코어 위치를 알려 줘」",
  "LV_003040_0010_NAR": "그건 집 한 채가 들어갈 정도로\r\n아주 커다란 우리였습니다.",
  "LV_003055_0000_CER": "근처에 있을 거야…… 그 괴물이……",
  "SM_003050_0080_MOR": "「지금 당신이라면, 더욱 강력한\r\n마술을 사용할 수 있을지도 모르겠네요.\r\n\r\n악마의 힘을 더 끌어낼 수 있을지\r\n시험해 보는 것도 좋겠지요」",
  "LV_003910_0000_CES": "도망가고, 또 도망가고, 도망만 다니지.\r\n넌 도망가는 재주밖에 없어!",
  "CE_003030_0000_CER": "잠깐, 뭐야?\r\n설마 화가 많이 났나……!?",
  "SM_003050_0050_MOR": "「그건 순전히 운이 좋았을 뿐입니다.\r\n안전한 곳에 있으라 말하지 않았나요?」\r\n",
  "SM_003030_0090_NAR": "싸움은 잠시 멈추고\r\n늑대를 쫓아\r\n둘은 힘차게 달려 나갔습니다.",
  "SM_003035_0030_LUC": "「내 이름은 류카온.\r\n……네 이름은?」",
  "LV_003070_0000_CER": "나…… 더는 도망가지 않아.\r\n가자 체셔!",
  "SM_003030_0020_CER": "「뭐야 그 태도는」\r\n",
  "SM_003035_0000_LUC": "「그 사납다는 재버워크까지\r\n쓰러트릴 줄이야……\r\n\r\n역시 너는 다른 아이들과 달라……\r\n무언가 특별한 힘을\r\n가지고 있구나」",
  "BK_3030_0040_NAR": "하지만 체셔의 발톱은\r\n괴물 몸에서 튕겨 나옵니다.",
  "LV_003920_0030_NAR": "『꾸물대지 마, 움직여!』\r\n체셔는 세레자가 정신 차리도록\r\n나직하게 울었습니다.",
  "SM_003050_0010_NAR": "모르가나의 환영이 나타났습니다.\r\n세레자가 무사해 안심한 모양입니다.\r\n\r\n그러고는 세레자의 얼굴을 보고\r\n이렇게 말했습니다.",
  "SM_003050_0100_CER": "「어……?」",
  "SM_003050_0060_MOR": "「……하지만 그 말이 사실이라면\r\n조금은 성장한 모양이군요」\r\n",
  "LV_003005_0010_CER": "설마 여기서 누가\r\n우리를 보고 있던 거야……?",
  "LV_003910_0030_CES": "이제 무서운 경험은 하기 싫잖아?\r\n그럼 구석에서 얌전히 떨고 있어, 이 겁쟁이야!",
  "SM_003050_0180_NAR": "세레자의 말에 체셔는\r\n흥, 하고 콧방귀를 뀌었습니다.",
  "BK_3000_0000_NAR": "와작와작……",
  "PH_3020_0010_CER": "저거다!",
  "SM_003035_0090_CER": "「게다가?」",
  "LV_003075_0000_NAR": "주위에 부서진 우리가 잔뜩 널려 있습니다.",
  "LV_003060_0010_CER": "뭔가…! 뭔가 있을 거야!",
  "BK_3020_0060_NAR": "체셔는 짐승 모습이 되려고 애씁니다.\r\n하지만 몸이 말을 듣지 않네요.",
  "CE_003020_0010_CER": "윽, 아파아…… 으으",
  "SM_003040_0000_NAR": "또 류카온과 만났어……\r\n꿈속의 일을 떠올리니 세레자는 \r\n이상하게도 가슴이 두근거렸습니다.",
  "SM_003010_0070_CER": "「……」",
  "LV_003015_0000_CER": "노…… 높은 곳은, 질색이야……\r\n밑을 안 보면 분명 괜찮을 거야……!",
  "SM_003040_0110_CER": "「아무 말도 안 했거든?\r\n자, 가자」",
  "SM_003080_0160_FAS": "「그러면 좋겠구나……」",
  "BK_3020_0050_NAR": "용처럼 생긴 괴물은\r\n아직도 세레자를 찾고 있습니다.",
  "LV_003045_0000_NAR": "『다음에 또 그 녀석이 오면 박살을 내 주지』",
  "LV_003080_0000_CER": "늑대야!\r\n다행이다, 너도 무사했구나.",
  "SM_003050_0210_NAR": "모처럼 모르가나에게 칭찬받아\r\n기뻤던 마음은\r\n순식간에 사라졌습니다.",
  "SM_003010_0080_NAR": "세레자는 분한 마음에\r\n머리가 복잡해져서\r\n체셔의 말이 들리지 않았습니다.",
  "SM_003080_0110_FAS": "「이런이런……」",
  "SM_003080_0080_FAS": "「으음……\r\n\"서두르다간 일을 그르친다\"라는 말을\r\n알고 있니?」\r\n",
  "SM_003020_0040_CER": "「다행이야……」",
  "SM_003035_0170_CER": "「난 너를 좀 더 알고 싶어!\r\n우리는 분명히 친해질 수 있을 거야」",
  "SM_003080_0120_FAS": "「마지막 엘레멘트 코어가 있는 곳은\r\n이 숲에서 가장 성가신 장소지」",
  "BK_3020_0010_NAR": "괴물이 세레자를 목표로 정했습니다.\r\n\r\n맞서 싸워야 해! 머리는 알고 있지만\r\n발이 얼어붙어 움직이지 않습니다.",
  "SM_003010_0030_CER": "「그 괴물, 체셔도\r\n전혀 상대가 안 됐어……\r\n\r\n난……\r\n난 어떻게 하면……」",
  "SM_003040_0040_NAR": "세레자는 숲에 온 이유를\r\n체셔에게 이야기하기로 했습니다.\r\n\r\n꿈에서 류카온을 봤다는 것,\r\n엄마를 구하려면 힘이 필요하다는 것,\r\n그 힘이 숲속에 있다는 것……",
  "CE_003000_0000_CER": "나도 한다면 한다고!",
  "BK_3030_0120_CER": "「더는 도망가지 않아……!」",
  "SM_003035_0070_LUC": "「나는 숲속에 사로잡혀서\r\n빠져나갈 수 없어……」",
  "SM_003050_0170_CER": "「괜찮아. 모르가나는 저렇게 말했지만\r\n나는 너를 단순한 무기라고\r\n생각하지 않아.\r\n\r\n……그래도 조금은 내 말을\r\n들어줬으면 좋겠어」",
  "SM_003080_0150_CER": "「……무, 물론 갈 거야.\r\n나는 마녀야.\r\n게다가 이 숲에 처음 들어왔을 때보다\r\n훨씬 강해졌다고!」",
  "SM_003050_0020_MOR": "「인상이 조금 달라진 건가요?\r\n전보다 어른스러워진 듯한……」",
  "BK_8110_0010_CER": "「왜 그래 체셔?\r\n웬일로 얌전하네……\r\n이 힘에 별로 관심 없어?」",
  "BK_3030_0000_NAR": "또 무시무시한 괴물이 나타났습니다.",
  "CE_003800_0000_CER": "저거에 당하면……\r\n안 돼 세레자, 그런 생각하지 마!",
  "BK_3030_0110_CER": "「이제 그런 건 싫어!」",
  "SM_003030_0060_CER": "「나도 열심히 싸웠으니까\r\n쟤를 잡을 수 있었던 거야.\r\n고맙단 말 정도는 해도 괜찮잖아!」"
}
