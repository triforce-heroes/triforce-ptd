{
  "SM_002100_0150_COL": "“谢谢你！”",
  "BK_2000_0060_CER": "“我不能害怕，\r\n我要成为强大的魔女……！”",
  "LV_002905_0000_NAR": "“我能感受到一股强大的力量……”\r\n小柴猫似乎感知到了什么。",
  "SM_002100_0040_NAR": "瑟蕾莎回过神来，\r\n发现自己把心里的想法说了出来。",
  "SM_002140_0050_FAS": "“我来正式自我介绍一下吧。\r\n我是这座森林的引路人，伊古妮丝。”",
  "SM_002060_0030_CER": "“小柴猫！\r\n柯尔姆都被你吓到了。\r\n你不能这样吓唬人家。”",
  "LV_002035_0120_CER": "怎么了嘛！没有我谁来用元素之力啊。\r\n别说得好像只有你最厉害！",
  "CE_002815_0000_CER": "嘿、嘿、嘿、看招！",
  "SM_002140_0060_FAS": "“你居然解决了那个马戏团，真厉害。\r\n我果然没看错人。”",
  "SM_002060_0000_COL": "“这里是我们的秘密基地。\r\n本来不应该告诉外人的，\r\n但这次就破例告诉大姐姐吧。”",
  "BK_2000_0050_CER": "“我、我也能战斗！\r\n别小看我！”",
  "LV_002035_0015_NAR": "小柴猫不满地喊叫道。",
  "SM_002130_0135_CER": "“可你为什么说不容易接近？”",
  "LV_002900_0000_CER": "那个小丑帽搞什么啊！\r\n总来妨碍我！",
  "SM_002010_0100_COL": "“我想把被带走的伙伴救回来，\r\n可凭我的力量根本做不到……”",
  "SM_002010_0180_NAR": "生气的小柴猫把头扭到一边。\r\n\r\n但瑟蕾莎还是无法抛下柯尔姆不管。",
  "SM_002010_0010_NAR": "瑟蕾莎想起了摩根娜说过的话。\r\n\r\n在森林中力竭而死的人类\r\n会变成四处游荡的“人魂”……",
  "CE_002070_0000_CER": "来吧，是时候落幕了。",
  "LV_002080_0020_NAR": "瑟蕾莎不禁打了个哈欠，\r\n她的身体感到了疲惫。",
  "SM_002140_0100_NAR": "知道对方是人魂之后，\r\n瑟蕾莎的口吻也轻松了不少。",
  "SM_002130_0150_FAS": "“疯狂的团长直到现在\r\n仍独自在那里持续着表演，\r\n要是被他发现就完了。\r\n\r\n你会被迫配合他的演出\r\n一直到死为止。”",
  "SM_002040_0050_CER": "“你看他们多高兴啊。\r\n\r\n这下柯尔姆跟他们\r\n又能一起生活了。”",
  "SM_002140_0010_CER": "“这、这声音是！”",
  "SM_002140_0210_FAS": "“怎么了？”",
  "SM_002110_0090_CER": "“魔女的头发可是很重要的哦？\r\n你多少给我注意一点好不好！”",
  "_05": "",
  "SM_002130_0120_FAS": "“但下一个元素核心的位置\r\n并不容易接近。”",
  "LV_002930_0000_CER": "迷迭香？对哦……这是驱魔花。\r\n你不用勉强自己过来。",
  "SM_002140_0045_CER": "“你就是那个声音的主人吗？”",
  "CE_002040_0000_CER": "咦？\r\n开关反了，没法按下去？",
  "SM_002130_0080_FAS": "“你在找的是白狼吧？”",
  "_01": "",
  "SM_002130_0110_FAS": "“小妹妹，你现在正朝着目标\r\n走在正确的道路上。”",
  "SM_002040_0180_CER": "“如果我够强，\r\n就能在那时救下妈妈……”",
  "SM_002040_0100_NAR": "话说到一半，\r\n瑟蕾莎突然意识到……",
  "IN_2000_0010_NAR": "面对瑟蕾莎的揶揄，\r\n小柴猫表现出了无所谓的态度。",
  "LV_002070_0010_NAR": "瑟蕾莎忍不住开心大叫。\r\n她还是个孩子呢。",
  "SM_002140_0180_FAS": "“哈哈，别担心。\r\n只要抽干湖水就好。”",
  "_54": "",
  "LV_002005_0030_NAR": "“看起来挺好吃的，我要吃。”",
  "SM_002100_0110_COL": "“我还有最后一个请求，\r\n能麻烦你们帮帮我吗？”",
  "SM_002080_0010_CER": "“小柴猫，怎么样？\r\n我只要想做还是能做到的吧？”",
  "SM_002050_0000_COL": "“大姐姐，谢谢你！”",
  "SM_002140_0220_CER": "“不，没什么。\r\n就算是高处……我也不怕。\r\n谢谢你告诉我这么多！”",
  "LV_002010_0010_CER": "妖精在欺负人魂……\r\n可凭我一个人什么也做不到……",
  "SM_002100_0120_COL": "“如果你们在森林里再发现\r\n被妖精抓住的人魂……\r\n希望你们能像刚才那样救出他们。”",
  "IN_2000_0020_NAR": "“我只是解决了接近我们的麻烦而已。",
  "CE_002080_0000_CER": "呜……！\r\n嗯……呜……呜……！",
  "SM_002130_0160_CER": "“到死为止……？”",
  "SM_002080_0040_NAR": "瑟蕾莎十分不满，\r\n她觉得小柴猫轻视了自己。",
  "LV_002035_0115_NAR": "小柴猫讥笑道。",
  "LV_002040_0030_CER": "我也想跟妈妈一起玩……",
  "BK_2000_0040_NAR": "“碍手碍脚的，给我退下！”\r\n小柴猫怒斥胆怯的瑟蕾莎。",
  "SM_002060_0090_COL": "“这个送给大姐姐。\r\n里面蕴藏着神奇的力量，\r\n应该能帮上你的忙。”",
  "CE_002800_0000_CER": "那个踩着球的很碍事。\r\n我们把那家伙拖下来吧！",
  "SM_002060_0100_CER": "“谢谢你！”",
  "IN_2000_0040_CER": "好吧！",
  "SM_002130_0010_CER": "“你、你是谁！？”",
  "CE_002000_0000_CER": "你倒是下来啊！",
  "SM_002060_0130_COL": "“别客气！如果你还有别的需求，\r\n尽管跟我说。”",
  "LV_002035_0020_CER": "你也想去森林深处吧？\r\n那就别抱怨啦。",
  "SM_002130_0210_FAS": "“我差不多该告辞了。\r\n希望你们一路平安。”",
  "SM_002100_0050_CER": "“狼！？”",
  "LV_002055_0010_NAR": "帮助了人魂，\r\n瑟蕾莎的心情稍微轻松了一些。",
  "LV_002905_0010_CER": "元素核心就在这附近。\r\n肯定就在前方的马戏团帐篷里。",
  "LV_002090_0010_CER": "那是……什么？",
  "BK_2010_0040_LUC": "“别哭……”",
  "SM_002010_0030_COL": "“大姐姐，你是谁？迷路了吗？”",
  "SM_002040_0040_NAR": "“帮了那些东西能有什么好处？”\r\n小柴猫意兴阑珊地问道。",
  "SM_002110_0070_CER": "“小柴猫你这个笨蛋！\r\n我头发都变黏糊糊了！”",
  "SM_002010_0000_CER": "“那该不会是……人魂吧？”",
  "SM_002130_0060_FAS": "“你可以试着问问我，\r\n我能回答你的所有问题。”",
  "SM_002140_0030_NAR": "瑟蕾莎朝着声源望去，\r\n那里站着一个稍显怪异的人魂，\r\n大大的帽子遮住了她的面容。",
  "SM_002040_0070_NAR": "“别人怎么样跟我又有什么关系。”\r\n小柴猫粗暴地回了她一句。",
  "SM_002140_0120_CER": "“不说这个了……\r\n你说你叫伊古妮丝？”",
  "SM_002010_0190_CER": "“总之，我已经决定要帮这个忙了！”",
  "LV_002915_0000_CER": "好有趣！\r\n会一直通到哪里去呢？",
  "LV_002050_0010_CER": "我得当心，千万不能被发现了……",
  "SM_002130_0180_FAS": "“不过你放心，你跟你的恶魔\r\n应该是不会被他轻易杀掉的。”",
  "SM_002140_0150_CER": "“湖底……！？”",
  "SM_002040_0110_CER": "“对了……\r\n是我把你召唤到这里来的。”",
  "SM_002040_0190_NAR": "瑟蕾莎说着，脑中浮现出了\r\n当时没能救下的母亲的身影。",
  "SM_002010_0160_NAR": "他俩产生了激烈的冲突，\r\n互相瞪着对方，\r\n一步也不肯退让。",
  "SM_002010_0070_CER": "“柯尔姆，\r\n你看起来很孤单……\r\n是发生什么了吗？”",
  "SM_002040_0080_CER": "“你在说什么呀？\r\n难道你忍心抛下他们不管？”",
  "LV_002925_0000_CER": "咦！？\r\n我们……交换了位置！？",
  "SM_002020_0080_NAR": "“你这种胆小鬼做得了什么？”\r\n小柴猫嗤笑道。",
  "SM_002020_0000_CER": "“小柴猫！？”",
  "SM_002140_0160_CER": "“那、那正好，\r\n我很会潜水的。”",
  "SM_002110_0080_NAR": "瑟蕾莎慌张地擦拭着头发，\r\n小柴猫瞥了她一眼，假装不知情。",
  "SM_002010_0040_CER": "“原来你会说话！？”",
  "SM_002060_0050_NAR": "“赶紧说正事。”\r\n小柴猫说着瞪了柯尔姆一眼，\r\n它不想浪费时间。",
  "LV_002005_0010_CER": "那是什么？",
  "SM_002050_0010_NAR": "柯尔姆恢复了精神，\r\n说想要感谢瑟蕾莎帮他救出了伙伴。",
  "SM_002080_0000_NAR": "瑟蕾莎一行击退了难缠的妖精。\r\n跟以往相比，瑟蕾莎觉得自己\r\n战斗的本领有了一些长进。",
  "BK_8100_0010_CER": "“我知道啦。\r\n来试试看这次是\r\n什么样的力量吧。”",
  "CE_002030_0000_CER": "平台前的开关看上去很可疑。",
  "CE_002100_0000_CER": "小柴猫……帮帮我！！",
  "SM_002130_0050_CER": "“那也不能轻易相信你……”",
  "SM_002140_0080_FAS": "“真是可怜。”",
  "IN_2000_0000_CER": "看吧，结果你还不是帮忙了。",
  "SM_002010_0080_COL": "“我的伙伴……\r\n被妖精带走了……”",
  "SM_002130_0170_FAS": "“啊……\r\n我是不是吓到你了？”",
  "SM_002010_0110_CER": "“别担心，我们会帮你的。”",
  "LV_002095_0010_CER": "我以前看过这种街头表演。\r\n没想到现在会轮到自己上场……！",
  "SM_002010_0044_CER": "“我叫瑟蕾莎，你呢？”",
  "SM_002140_0230_FAS": "“别客气。”",
  "SM_002020_0040_NAR": "“你死了我也活不了，\r\n所以我才会跟来。”\r\n\r\n它的脸上仿佛写着这句话。",
  "SM_002120_0000_NAR": "“你就不能走快点吗？”\r\n小柴猫对追不上狼的瑟蕾莎感到恼火。",
  "LV_002030_0020_CER": "用上那股力量，\r\n之前过不去的地方应该就能通过了！",
  "CE_002805_0000_CER": "唉，每次都会被躲开！\r\n该怎么做才能让大炮射中呢……！",
  "LV_002030_0010_CER": "刚才得到的新力量……",
  "SM_002010_0120_COL": "“真的吗！？”",
  "SM_002040_0150_NAR": "“就算我刚出生也比你厉害得多。”\r\n没等瑟蕾莎把话说完，\r\n小柴猫就出言讥讽了她。",
  "SM_002140_0110_NAR": "但小柴猫依旧保持沉默。\r\n看来它对人魂没有丝毫兴趣。",
  "LV_002080_0030_NAR": "瑟蕾莎决定在这里休息一下。",
  "SM_002130_0140_FAS": "“前方有一座古旧的马戏团帐篷，\r\n是以前妖精为了引诱人类孩童\r\n进入森林所使用的东西。”",
  "SM_002130_0090_CER": "“你、你怎么知道？”",
  "LV_002910_0000_CER": "等等，这是什么声音！？\r\n朝这里过来了！",
  "SM_002100_0140_CER": "“好，我一定尽力！”",
  "SM_002100_0060_NAR": "看见白狼跑走的身影，\r\n瑟蕾莎一跃而起。",
  "LV_002055_0020_CER": "妖精们也太过分了。\r\n我要把所有人魂都救出来！",
  "CE_002060_0000_CER": "跟开关是联动的呢。",
  "SM_002100_0170_COL": "“大姐姐、猫先生，下次见！”",
  "LV_002090_0020_NAR": "远处能看到一座类似大帐篷的建筑物。\r\n那如血液般鲜红的外观，\r\n仿佛在邀请瑟蕾莎过去。",
  "SM_002140_0070_FAS": "“团长再也玩不了空中飞人了。”",
  "SM_002060_0010_COL": "“咦？跟你在一起的猫先生呢？”",
  "SM_002130_0020_NAR": "突如其来的搭话\r\n让瑟蕾莎吓了一大跳。",
  "SM_002130_0130_CER": "“你居然连元素核心的事都知道！？”",
  "LV_002035_0010_NAR": "“我长这根舌头是为了品尝猎物。\r\n你到底要用我这舌头用多久啊？”",
  "SM_002100_0100_CER": "“嗯，我们赶时间。”",
  "LV_002005_0020_NAR": "瑟蕾莎发现了像水果一样的东西。",
  "SM_002140_0200_CER": "“最高处……”",
  "SM_002080_0030_CER": "“哼，小柴猫你真是坏心眼！”",
  "SM_002100_0090_COL": "“大姐姐，\r\n你们这就要走了？”",
  "SM_002100_0010_NAR": "瑟蕾莎从睡梦中醒来，\r\n心中一直回响着少年的话语。",
  "SM_002050_0020_COL": "“跟我来！”",
  "SM_002140_0190_FAS": "“不过……\r\n你必须先越过巨树才行。\r\n\r\n想要到达湖底深处\r\n就得爬到森林最高处。\r\n这听起来是不是很哲学？”",
  "LV_002920_0000_CER": "朝这边过来了……！？\r\n那、那是什么啊！？",
  "LV_002065_0010_CER": "柯尔姆，你个子小小的，\r\n走起路来倒挺快的呢。",
  "SM_002140_0000_FAS": "“马戏团好玩吗？”",
  "SM_002030_0010_NAR": "面对瑟蕾莎的揶揄，\r\n小柴猫表现出了无所谓的态度。",
  "SM_002060_0060_COL": "“性急的猫先生，\r\n我也有礼物要送你，是那个！”",
  "CE_002050_0000_CER": "这个把手有什么用？",
  "SM_002060_0140_NAR": "说完，柯尔姆跑回了伙伴们的身边。",
  "SM_002030_0020_NAR": "“我只是解决了接近我们的麻烦而已。\r\n毕竟我很强，跟你可不一样。”\r\n\r\n小柴猫说完后，\r\n再一次不屑地哼了一声。",
  "IN_2000_0030_NAR": "毕竟我很强，跟你可不一样。”\r\n小柴猫说完后，再一次不屑地哼了一声。",
  "SM_002100_0130_COL": "“我们会尽最大努力答谢你们的！”",
  "SM_002100_0020_NAR": "她觉得心中十分温暖，\r\n像是突然亮起了一盏明灯。",
  "SM_002130_0220_NAR": "话音刚落，\r\n附近便重归寂静。",
  "SM_002120_0040_NAR": "小柴猫一言不发，\r\n不快地瞪着瑟蕾莎。",
  "_71": "",
  "SM_002040_0120_NAR": "“我才刚出生，\r\n既没有重要的东西也不想要那种东西。”\r\n小柴猫淡然地回答。",
  "SM_002110_0110_CER": "“你、你烦死了！\r\n我很快就能运用自如的！”",
  "SM_002010_0150_CER": "“我们总不能见死不救呀！？”",
  "BK_2010_0020_CER": "“妈妈……我好想你啊……”",
  "CE_002035_0000_CER": "踩下之后，聚光灯就会照亮平台。",
  "SM_002130_0100_FAS": "“你现在也算是森林的一部分，\r\n所以我能看穿你的想法。”",
  "BK_2010_0010_CER": "“为什么门就是不开呢……？”",
  "SM_002040_0000_CER": "“幸好大家都没事。\r\n虽、虽然费了不少功夫。”",
  "SM_002140_0040_CER": "“人魂……？”",
  "CE_002090_0000_CER": "我、我动不了……！",
  "SM_002020_0030_NAR": "瑟蕾莎其实有些高兴，\r\n而小柴猫沉默着，看起来有些不快。",
  "SM_002010_0020_CER": "“你好……你怎么了？”",
  "SM_002140_0090_CER": "“他真的太粗暴了。\r\n我讨厌被人逼着做这做那！”",
  "SM_002130_0040_FAS": "“至少我不是妖精，\r\n你大可以相信我。”",
  "LV_002025_0010_CER": "不行……我还是不能丢下那个人魂不管！",
  "CE_002810_0000_CER": "你的杂耍我已经看腻了！\r\n小柴猫，上吧！",
  "SM_002120_0020_CER": "对了，小柴猫，\r\n能不能让我骑在你身上？\r\n这样很快就能追上了！",
  "SM_002020_0060_CER": "“就算你不肯帮忙，\r\n我一个人也能救出那些人魂！”",
  "SM_002130_0240_CER": "“她到底是谁……？”",
  "CE_002010_0000_CER": "好机会，就是现在！",
  "SM_002120_0010_CER": "我已经跑得很卖力了！",
  "SM_002020_0050_CER": "“哼。”",
  "LV_002080_0010_CER": "呼啊……",
  "SM_002140_0130_CER": "“伊古妮丝，我猜你或许知道\r\n其他元素核心的所在位置……？”",
  "SM_002040_0170_CER": "“我、我用不了多久也会变强的。\r\n我跟野蛮的恶魔可不一样！”",
  "LV_002045_0010_NAR": "必须放下那座吊桥才能进到里面去。",
  "SM_002140_0020_NAR": "熟悉的声音再一次从某处传来。",
  "SM_002010_0090_NAR": "柯尔姆带着哭腔诉说了起来。\r\n\r\n妖精以折磨人魂为乐，\r\n甚至有伙伴被带走后再也没能回来。",
  "SM_002060_0110_COL": "“大姐姐你应该累了吧？\r\n这里很安全，可以在这里休息哦。”",
  "SM_002060_0080_CER": "“它嘴上是这么说，\r\n其实心里高兴着呢。”",
  "LV_002035_0110_NAR": "“哼，谁让你事事都得靠我出力呢。”",
  "BK_2010_0060_LUC": "“你一定能见到你的母亲……\r\n我们都会有那么一天的……”",
  "LV_002085_0020_NAR": "跟人魂们一起玩很开心，\r\n但瑟蕾莎还有非做不可的事。",
  "LV_002040_0020_CER": "还是说，这里是人类曾经住过的地方……？",
  "SM_002100_0160_NAR": "就这样，\r\n瑟蕾莎一行告别了柯尔姆，\r\n出发去寻找白狼。",
  "SM_002100_0070_CER": "“小柴猫，你已经休息够了吧？”",
  "LV_002040_0010_CER": "这是什么地方？\r\n是妖精们的游乐场吗……？",
  "BK_2010_0050_LUC": "“你很强大……\r\n你拥有想要守护珍视之人的强大内心……\r\n所以你一定没问题……”",
  "LV_002085_0010_NAR": "瑟蕾莎再次朝森林深处进发。",
  "SM_002130_0200_FAS": "“可见他们有多么畏惧你们，\r\n尤其是害怕这位恶魔……”",
  "CE_002000_0010_CER": "别老往小柴猫够不到的地方躲啊！",
  "SM_002060_0120_CER": "“这么一说……\r\n我来到这片森林以后就没休息过呢，\r\n的确需要休整一下。\r\n\r\n柯尔姆，谢谢你。”",
  "SM_002140_0140_FAS": "“我当然知道了。\r\n下一个核心沉睡在湖底。”",
  "SM_002100_0030_CER": "下次还能再梦见他吗……",
  "SM_002060_0040_NAR": "“我对这种看起来一点也不好吃的家伙\r\n没兴趣。”小柴猫百无聊赖地说道。",
  "SM_002130_0070_CER": "“咦？\r\n那……你知道白……\r\n你知道黑狼去哪了吗？”",
  "SM_002030_0030_CER": "“好吧！”",
  "LV_002065_0110_CER": "在遇见你之前，\r\n我都不敢相信人魂是真实存在的。",
  "SM_002030_0000_CER": "“看吧，结果你还不是帮忙了。”",
  "SM_002060_0070_NAR": "“原来还有我的份啊。”\r\n小柴猫的语气听起来不太开心，\r\n但明显加快的脚步出卖了它。",
  "LV_002935_0000_CER": "嘿嘿！\r\n怎么样？我一个人救出了所有人哦？",
  "SM_002080_0020_NAR": "但小柴猫的态度很是冷淡。",
  "SM_002100_0000_CER": "“我们都……？”",
  "BK_8100_0000_CER": "“又跟那时一样……”",
  "BK_2000_0020_NAR": "妖精突如其来的袭击\r\n再一次让瑟蕾莎感到害怕。",
  "SM_002020_0020_CER": "“我就知道你会跟来，\r\n毕竟你离不开我嘛。\r\n\r\n那么，你愿意帮忙吗？”",
  "SM_002040_0090_CER": "“跟重要的人分开有多痛苦，\r\n你应该也明白……”",
  "SM_002130_0000_FAS": "“小妹妹，你好。”",
  "SM_002040_0010_NAR": "瑟蕾莎嘴上逞强，\r\n但其实心里对单方面接受小柴猫帮助\r\n这件事感到很不甘心。",
  "SM_002010_0060_COL": "“我叫柯尔姆。”",
  "SM_002130_0190_FAS": "“自从你们踏进森林的那一刻起，\r\n妖精们就已经乱作一团了。”",
  "LV_002015_0010_CER": "小柴猫，那边有妖精在欺负人魂！\r\n我们快去救他！",
  "SM_002040_0020_NAR": "而小柴猫则是一脸无趣地\r\n看着开心的人魂们。",
  "SM_002130_0030_FAS": "“我是谁……\r\n我算是\r\n‘最了解这座森林的人’吧。”",
  "SM_002010_0140_NAR": "瑟蕾莎的话惹怒了小柴猫，\r\n它甚至怀疑自己是不是听错了。",
  "CE_002020_0000_CER": "别想逃！",
  "SM_002110_0100_NAR": "“也没见你能发挥多少它的能力，\r\n保养的本事倒是一等一。”\r\n小柴猫嘲笑着说道。",
  "SM_002140_0170_CER": "“只是不太会浮起来……”",
  "SM_002040_0130_CER": "“你才刚出生？\r\n那也就是说……”",
  "SM_002020_0090_NAR": "但瑟蕾莎假装没听到。",
  "SM_002120_0050_CER": "我就知道不行……小气鬼！",
  "SM_002130_0230_CER": "“消失了……”"
}
