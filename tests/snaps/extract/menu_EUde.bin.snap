{
  "MENU_HELP_TXT_019_01": "Erhöht die Geschwindigkeit, mit der\r\ndie Magie während des Knuddelmodus\r\nregeneriert wird.",
  "MENU_HELP_TXT_103_02": "Im Knuddelmodus wird\r\nCheshires Lebenskraft\r\nwiederhergestellt.",
  "MENU_HELP_TXT_115_01": "Mit diesem Talent kannst du im\r\nBestienmodus [BTN:R2 ] gedrückt halten\r\nund dann loslassen, damit Cheshire\r\nsich auf den Gegner stürzt.",
  "MENU_HELP_TXT_021_01": "Lässt Cheshire Projektile abwehren,\r\nwenn er im Knuddelmodus mit [BTN:RS ]\r\nausgestreckt wird.",
  "MENU_HELP_TXT_204_01": "Im Archivmenü findest du mehr Infos\r\nzu den Charakteren, Gegnern usw.,\r\ndie du auf deiner Reise getroffen hast.",
  "MENU_SKILLTREE_DIALOG_TXT_01": "Hier kannst du gelernte Talente\r\nüben. Möchtest du den Übungsraum\r\nbetreten?",
  "MENU_HELP_TXT_212_02": "Um neue Talente zu lernen, benötigt\r\nCereza Onyxrosen. Cheshire wiederum\r\nbraucht dafür Avalonkonfekt.",
  "MENU_HELP_TXT_104_01": "In seiner Elementarform sind\r\nCheshires Angriffe weitaus stärker\r\nals in seiner Grundform.",
  "MENU_HELP_TXT_112_02": "Entfesselter Cheshire: Drücke [BTN:L1 ],\r\num auszuweichen, und [BTN:R1 ], um einen\r\ngewaltigen Angriff auszuführen.",
  "MENU_HELP_TXT_249_01": "Wählst du einen Unterschlupf über\r\n„Ignis' Pfade“, empfiehlt Ignis dir\r\nstets den Unterschlupf, der in der\r\nNähe von Cerezas nächstem Ziel liegt.",
  "MENU_HELP_TXT_008_01": "Items können viele nützliche\r\nEffekte bewirken. Verwende eines,\r\nindem du auf [BTN:DP ] die entsprechende\r\nRichtung gedrückt hältst.",
  "MENU_HELP_TXT_215_01": "Wenn Cereza Cheshire in seiner\r\nPlüschtierform im Arm herumträgt,\r\nwird dies auch „Knuddelmodus“\r\ngenannt.",
  "MENU_HELP_TXT_211_01": "Im Menü „Vorbereitungen“ können Ce-\r\nreza und Cheshire Kostüme wechseln.\r\nDas Erfüllen gewisser Bedingungen\r\nschaltet Kostüme frei.",
  "MENU_HELP_TXT_207_02": "Nähere dich einem Unterschlupf, um\r\nihn freizuschalten und deiner Karte\r\nhinzuzufügen. Vergiss nicht, neu\r\nentdeckte Unterschlüpfe freizuschalten!",
  "MENU_SKILLTREE_TXT_327": "Halte [BTN:L2 ] gedrückt und rotiere [BTN:LS ],\r\num den ursprünglichen Zustand von\r\nObjekten wiederherzustellen.",
  "MENU_HELP_TXT_229_01": "Es gibt Irrlichter, die Cereza\r\nnachlaufen, wenn du ihnen geholfen\r\nhast. Es reicht allerdings ein\r\neinziger Angriff und sie sind hin.",
  "MENU_SKILLTREE_TXT_423": "Setze als mächtige Attacke am\r\nEnde einer Fessel-Kombo einen\r\nspeziellen Feuer-Elementarangriff\r\nein, wenn du Feuer-Cheshire benutzt.",
  "MENU_HELP_TXT_129_01": "Cheshire kann Cereza mit [BTN:RS ] im\r\nKnuddelmodus ziehen, sodass sich beide\r\nschneller bewegen, solange Cheshire\r\nvorwärts zieht.",
  "MENU_SKILLTREE_TXT_427": "Cheshires Angriffe fügen den Gegnern\r\nnoch mehr Schaden zu.",
  "MENU_HELP_TXT_216_02": "Im Bestienmodus kannst du Cereza\r\nmit [BTN:LS ] und Cheshire mit [BTN:RS ] bewegen.",
  "MENU_HELP_TXT_025_01": "Wenn die halbmondförmigen Symbole\r\nmit einer Linie verbunden sind, musst\r\ndu [BTN:LS ] geneigt halten, bis das\r\nzweite Symbol erreicht ist.",
  "MENU_SKILLTREE_TXT_330": "Lässt dich viel mehr Items tragen.",
  "MENU_SKILLTREE_TXT_323": "Lässt dich noch mehr Items tragen.",
  "MENU_HELP_TXT_111_01": "Da Cheshire ein Dämon ist, kann\r\ner keine Gebiete mit Rosmarin\r\ndurchqueren. Du wirst für Cheshire\r\neinen anderen Weg finden müssen.",
  "MENU_HELP_TXT_107_02": "Greift Cheshire etwas mit der\r\nRankenzunge, kannst du [BTN:R1 ]\r\ngedrückt halten, damit er es\r\nzu sich zieht.",
  "MENU_HELP_TXT_238_01": "Bei dem Horn des Einhorns handelt\r\nes sich um eine in rotem Kristall\r\neingeschlossene Zutat, die zum\r\nBrauen genutzt wird.",
  "MENU_HELP_TXT_207_01": "Die roten Bogen, die man vielerorts\r\nim Wald findet, sind Unterschlüpfe.\r\nBetrachte sie als Stützpunkte, die\r\ndir auf dem Weg durch Avalon helfen.",
  "MENU_HELP_TXT_022_01": "Löst eine Schockwelle aus,\r\nwenn Cheshire in Plüschtierform\r\naufgehoben wird, und betäubt\r\nGegner in der Nähe.",
  "MENU_SKILLTREE_TXT_324": "Pariere gegnerische Projektile,\r\nindem du Cheshire mit [BTN:RS ] ausstreckst.",
  "MENU_SKILLTREE_TXT_420": "Cereza reitet auf Cheshire und\r\nnutzt ihre Magie, um seine wahre\r\ndämonische Macht zu entfesseln.",
  "MENU_HELP_TXT_116_01": "Wenn du einen Gegner mit dem Kiefer-\r\nSymbol siehst, lade eine Attacke mit\r\n[BTN:R2 ] auf und lasse los, damit\r\nCheshire den Gegner verschlingt.",
  "MENU_SKILLTREE_TXT_424": "Drücke im Knuddelmodus [BTN:R2 ],\r\num Cheshire nach einem Gegner\r\nschlagen zu lassen, was diesen\r\nkurz ablenkt.",
  "MENU_HELP_TXT_216_01": "Wenn du Cheshires Bestiengestalt\r\nheraufbeschwörst, sodass die zwei\r\nunabhängig voneinander agieren,\r\nwird dies „Bestienmodus“ genannt.",
  "MENU_POSEMENU_DIALOG_TXT_03": "Nicht gespeicherte Daten gehen\r\nverloren. Willst du wirklich\r\nzum Titelbildschirm zurück?",
  "MENU_HELP_TXT_107_01": "Drücke [BTN:Y ], um Cheshire in\r\nHolz-Cheshire zu verwandeln. In\r\ndieser Form kann Cheshire seine\r\nRankenzunge mit [BTN:R1 ] nutzen.",
  "MENU_HELP_TXT_999_01": "???",
  "MENU_SKILLTREE_TXT_320": "Deine Dornenfessel lädt sich\r\nnoch schneller auf.",
  "MENU_HELP_TXT_109_03": "Wasser-Cheshire kann sogar schwimmen.\r\nBetrittst du in einer anderen Form\r\ndas Wasser, wechselt Cheshire\r\nautomatisch zur Wasser-Form.",
  "MENU_SKILLTREE_TXT_328": "Drücke im Knuddelmodus [BTN:L1 ]\r\nund Cereza lässt magische Energie in\r\nCheshire fließen, wodurch sich seine\r\nMagie-Anzeige umgehend füllt.",
  "MENU_HELP_TXT_103_01": "Cheshire hat seine eigene\r\nLebenskraft. Wenn sie ihm\r\nausgeht, verwandelt er sich\r\nwieder in ein Plüschtier.",
  "MENU_HELP_TXT_212_01": "Untersuche Spiegel in der Nähe von\r\nLaternen mit [BTN:L1 ], um Cereza und\r\nCheshire neue Talente beizubringen.",
  "MENU_SKILLTREE_DIALOG_TXT_02": "Genug geübt?",
  "MENU_HELP_TXT_112_01": "In manchen Situationen kann Cereza\r\nauf Cheshire reiten und dabei mit\r\nihrer Magie seine wahre dämonische\r\nMacht entfesseln.",
  "MENU_HELP_TXT_249_02": "Wenn du nicht weiterweißt, besuche\r\nGegenden, die mit dem Pfotenabdruck\r\ndes weißen Wolfes markiert sind. Dort\r\nwirst du in der Nähe Wolfsspuren finden.",
  "MENU_HELP_TXT_104_02": "Elementarangriffe können auch\r\nbesondere Wirkungen haben und\r\nbeispielsweise gegnerische\r\nSchilde entfernen.",
  "MENU_HELP_TXT_215_02": "Im Knuddelmodus kannst du Cereza\r\nmit [BTN:LS ] bewegen und Cheshire mit\r\n[BTN:RS ] ausstrecken, um nahe Objekte\r\nzu ergreifen.",
  "MENU_HELP_TXT_203_01": "Im Statusmenü kannst du Cerezas und\r\nCheshires Status überprüfen sowie\r\ndie Items, die du besitzt.",
  "MENU_HELP_TXT_026_01": "Wenn das Symbol statt eines Halbmondes\r\naus zwei überlappenden Kreisen besteht\r\nmusst du [BTN:LS ] rasch zweimal in\r\nderen Richtung neigen.",
  "MENU_SKILLTREE_TXT_413": "Drücke zweimal [BTN:L1 ] und Cheshire rast\r\nzu dir zurück, um in den Knuddel-\r\nmodus zu wechseln, wobei er alle\r\nGegner in seiner Bahn wegschleudert.",
  "MENU_HELP_TXT_108_03": "Stein-Cheshire verfügt über\r\neinen harten Körper, von dem die\r\nmeisten Angriffe abprallen, was\r\nihn allerdings Magie kostet.",
  "MENU_HELP_TXT_102_01": "Mit [BTN:R2 ] führt Cheshire Angriffe mit\r\nseinen scharfen Klauen aus, mit\r\ndenen er auch harte Objekte wie\r\nÄste oder Krüge zerstören kann.",
  "MENU_HELP_TXT_221_03": "Drückst du [BTN:START ] in einem Tír na\r\nnÓg, öffnet sich ein Menü, mit dem\r\ndu das Tír na nÓg verlassen und in\r\nden Wald zurückkehren kannst.",
  "MENU_HELP_TXT_213_01": "Drücke [BTN:SELECT ], während du Talente\r\nlernst, um den Übungsraum zu\r\nbetreten, wo du deine bisherigen\r\nTalente ausprobieren kannst.",
  "MENU_SKILLTREE_TXT_304": "Aktiviere den Knuddelmodus\r\nim Kampf, um schrittweise\r\nMagie wiederherzustellen.",
  "MENU_SKILLTREE_TXT_317": "Verlangsamt Gegner, auf die du\r\ngerade die Dornenfessel wirkst,\r\nnoch weiter.",
  "MENU_HELP_TXT_009_02": "Das Fesseln eines Gegners gelingt\r\nnur, wenn eine Aufladeanzeige voll\r\nist. Diese füllt sich mit der Zeit\r\nautomatisch oder mittels Items.",
  "MENU_HELP_TXT_113_01": "Drücke im Bestienmodus [BTN:R1 ], um mit\r\nCheshire Angriffe zu parieren.\r\nDies kostet ihn Magie.",
  "MENU_HELP_TXT_105_02": "Im Knuddelmodus stellt Cheshire\r\nschrittweise Magie wieder her.",
  "MENU_HELP_TXT_027_01": "Manche Fluggegner sind äußerst\r\nschwach und können von einer\r\nsimplen Dornenfessel besiegt werden.",
  "MENU_SKILLTREE_TXT_404": "Drücke [BTN:R3 ], um mit Cheshire\r\nauszuweichen.",
  "MENU_SKILLTREE_TXT_417": "Setze als mächtige Attacke am\r\nEnde einer Fessel-Kombo einen\r\nspeziellen Stein-Elementarangriff\r\nein, wenn du Stein-Cheshire benutzt.",
  "MENU_HELP_TXT_202_01": "Im Kartenmenü kannst du zwischen\r\nder Weltkarte und einzelnen\r\nGebietskarten umschalten,\r\nindem du [BTN:Y ] drückst.",
  "MENU_HELP_TXT_023_01": "Erhöht die Menge an Items,\r\ndie du tragen kannst.",
  "MENU_HELP_TXT_206_01": "Drücke [BTN:L1 ] in der Nähe von Laternen,\r\num das Menü „Vorbereitungen“\r\naufzurufen. Dort kannst du unter\r\nanderem dein Spiel speichern.",
  "MENU_HELP_TXT_210_02": "Um ein Item brauen zu können, wirst\r\ndu erst ein Exemplar davon finden\r\nmüssen, das dir dann als Referenz\r\ndient. Halte die Augen offen!",
  "MENU_CHALLENGE_TXT_12": "Wähle das Tír na nÓg, das du\r\ngegen die Zeit spielen willst.",
  "MENU_CHALLENGE_TXT_01": "Versuche dich erneut an bereits\r\nabgeschlossenen Tír na nÓg.",
  "MENU_SKILLTREE_TXT_308": "Während du dabei bist, die\r\nDornenfessel auf einen Gegner\r\nzu wirken, sind dessen\r\nBewegungen langsamer.",
  "MENU_HELP_TXT_228_02": "Je nach Tor können unterschiedlich\r\nviele Irrlichter nötig sein.\r\nSieh dich um, ob du ein Irrlicht\r\nübersehen hast, wenn du festsitzt.",
  "MENU_HELP_TXT_117_01": "Mit diesem Talent stellst du Magie\r\nwieder her, wenn du Gegner mit\r\ndem Talent „Happs!“ besiegst.",
  "MENU_HELP_TXT_217_01": "Drücke [BTN:L1 ], um zum Knuddelmodus\r\nzu wechseln, wodurch Cheshire\r\nsich wieder in seine Plüschform\r\nverwandelt.",
  "MENU_HELP_TXT_106_01": "Drücke [BTN:L1 ], um Elementarenergie\r\nin der Nähe zu absorbieren. Hast du\r\ngenug absorbiert, steigt Cheshires\r\nMagie-Anzeige dauerhaft.",
  "MENU_SKILLTREE_TXT_408": "Strecke Cheshire mit [BTN:RS ] in die\r\nRichtung aus, in die du dich\r\nbewegst, um ein wenig deine\r\nGeschwindigkeit zu erhöhen.",
  "MENU_HELP_TXT_110_02": "Cheshires Flammengeschosse können\r\nmanche Objekte verbrennen oder Eis\r\nschmelzen. Feuer-Cheshire nimmt\r\nzudem keinen Schaden durch Flammen.",
  "MENU_HELP_TXT_210_01": "Im Menü „Vorbereitungen“ kannst du\r\nZutaten nutzen, um Items zu brauen.\r\nDiese Items kannst du dann\r\nunterwegs einsetzen.",
  "MENU_SKILLTREE_TXT_318": "Fesselst du einen Gegner, nachdem\r\ndieser bestimmte Angriffe ausgeführt\r\nhat, wird der Gegner für längere Zeit\r\ngefesselt und erleidet mehr Schaden.",
  "MENU_HELP_TXT_228_01": "Irrlicht-Tore können mit der\r\nHilfe von Irrlichtern geöffnet\r\nwerden.",
  "MENU_CHALLENGE_TXT_11": "Wähle das Tír na nÓg,\r\ndas du erneut spielen willst.",
  "MENU_CHALLENGE_TXT_02": "Nimm an Herausforderungen\r\ngegen die Zeit teil.",
  "MENU_HELP_TXT_101_01": "Bewege Cheshire mit [BTN:RS ].\r\nEr erklimmt oder springt über\r\nkleine Stufen, während er sich\r\nbewegt.",
  "MENU_HELP_TXT_128_01": "Mit diesem Talent kann Cheshires eine\r\nKombo trotz Elementwechsel fortführen.\r\nWird mit [BTN:A ], [BTN:B ], [BTN:X ] oder [BTN:Y ] aktiviert,\r\nwährend Cheshire angreift/ausweicht.",
  "MENU_HELP_TXT_217_02": "Drücke im Knuddelmodus [BTN:R1 ], um\r\nCheshires dämonische Form herauf-\r\nzubeschwören und zum Bestienmodus\r\nzu wechseln.",
  "MENU_HELP_TXT_201_01": "Drücke [BTN:START ], um das Menü zu\r\nöffnen. Du kannst mit [BTN:L1 ] und [BTN:R1 ]\r\nzwischen „Karte“, „Status“,\r\n„Archiv“ und „System“ wechseln.",
  "MENU_HELP_TXT_024_01": "Erhöht die Wirkung aller\r\ngebrauten Items.",
  "MENU_HELP_TXT_110_01": "Drücke [BTN:A ], um Cheshire in\r\nFeuer-Cheshire zu verwandeln. In\r\ndieser Form kann Cheshire mit [BTN:R1 ]\r\nFlammengeschosse abfeuern.",
  "MENU_SKILLTREE_TXT_418": "Erledige einen Gegner mit „Happs!“,\r\num etwas Magie wiederherzustellen.",
  "MENU_HELP_TXT_239_01": "Der gebackene Gecko ist eine in\r\ngelbem Kristall eingeschlossene\r\nZutat, die zum Brauen genutzt wird.",
  "MENU_SKILLTREE_TXT_510": "Vergrößert den magischen Kreis\r\nder Dornenfessel.",
  "MENU_HELP_TXT_018_01": "Regeneriert langsam Magie,\r\nwährend der Knuddelmodus\r\naktiv ist.",
  "MENU_HELP_TXT_114_01": "Mit diesem Talent führt Cheshire\r\ndurch Drücken von [BTN:R2 ] eine zusätzliche\r\nAttacke aus, wenn erfolgreich ein\r\ngegnerischer Angriff gekontert wurde.",
  "MENU_SKILLTREE_TXT_403": "Lade in der Nähe eines geschwächten\r\nGegners mit [BTN:R2 ] einen Angriff auf\r\nund lasse dann los, um Cheshire dazu\r\nzu bringen, den Gegner zu verschlingen.",
  "MENU_SKILLTREE_TXT_410": "Setze als mächtige Attacke am\r\nEnde einer Fessel-Kombo einen\r\nspeziellen Holz-Elementarangriff\r\nein, wenn du Holz-Cheshire benutzt.",
  "MENU_HELP_TXT_205_01": "Im Systemmenü kannst du die Optionen\r\nändern, die Reiseweisheiten aufrufen,\r\neinen anderen Spielstand laden,\r\nund mehr.",
  "MENU_HELP_TXT_020_01": "Drücke im Knuddelmodus [BTN:L1 ] und\r\nCereza lässt magische Energie in\r\nCheshire fließen, wodurch sich\r\nseine Magie-Anzeige umgehend füllt.",
  "MENU_SKILLTREE_TXT_314": "Hebst du Cheshire vom Boden auf,\r\nwird eine Schockwelle ausgelöst,\r\ndie Gegner in der Nähe betäubt.",
  "MENU_HELP_TXT_226_03": "In der Sektion „Irrlichter“\r\nim Archiv kannst du sehen,\r\nwelchen Irrlichtern du\r\nbereits geholfen hast.",
  "MENU_HELP_TXT_105_01": "Die Anzeige über Cheshires Kopf ist\r\nseine Magie-Anzeige. Diese nimmt\r\nab, wenn er bestimmte Fähigkeiten\r\neinsetzt.",
  "MENU_SKILLTREE_TXT_303": "Halte [BTN:L2 ] gedrückt, um Dornen\r\nherbeizurufen, die den Gegner fesseln.\r\nMuss aufgeladen werden, bevor es\r\nerneut eingesetzt werden kann.",
  "MENU_SKILLTREE_TXT_310": "Deine Dornenfessel kann nun zweimal\r\naufgeladen sein und lässt dich so\r\nmehrere Gegner fesseln.",
  "MENU_HELP_TXT_009_01": "Drücke und halte [BTN:L2 ] in der\r\nNähe eines Gegners, um diesen\r\nmittels Dornenfessel kurzfristig\r\nbewegungsunfähig zu machen.",
  "MENU_HELP_TXT_248_01": "An Laternen und an bestimmten\r\nPunkten der Geschichte wird das Spiel\r\nautomatisch gespeichert. Du siehst\r\ndann dieses Symbol unten rechts.",
  "MENU_SKILLTREE_TXT_407": "Drücke [BTN:R2 ], während du ausweichst,\r\num dich auf den Gegner zu stürzen\r\nund ihn anzugreifen.",
  "MENU_SKILLTREE_TXT_414": "Wechsle Cheshires Element, wenn er\r\nangreift/ausweicht, um während der\r\nVerwandlung deine Kombo fortzuführen.",
  "MENU_HELP_TXT_202_02": "Der Nebel, der manche Bereiche\r\neinzelner Gebiete verdeckt,\r\nwird sich lichten, wenn du\r\nbestimmte Bedingungen erfüllst.",
  "MENU_HELP_TXT_214_01": "Sprichst du mit Ignis, kannst\r\ndu per Schnellreise zu allen\r\nUnterschlüpfen reisen, die\r\nCereza bereits besucht hat.",
  "MENU_SKILLTREE_TXT_419": "Cheshires Angriffe fügen den Gegnern\r\nmehr Schaden zu.",
  "MENU_HELP_TXT_225_01": "Untersuche besonders eindrucksvolle\r\nOrte mit [BTN:L1 ], um die Erinnerungen\r\ndaran im Archiv festzuhalten, wo\r\ndu sie jederzeit nachlesen kannst.",
  "MENU_HELP_TXT_241_01": "Ein violetter Tropfen in\r\nSchmetterlingsform, der deine\r\nUmbra-Künste ein Stück auflädt,\r\nwenn du ihn einsammelst.",
  "MENU_CHALLENGE_DIALOG_TXT_02": "Dieses Tír na nÓg spielen?",
  "MENU_HELP_TXT_222_02": "Wenn du die Bedingungen solcher\r\nMissionen nicht erfüllst, gilt\r\ndas jeweilige Tír na nÓg als\r\ngescheitert.",
  "MENU_HELP_TXT_234_01": "Onyxrosen sind Blumen\r\naus den Tiefen Infernos.\r\nCereza benötigt sie, um\r\nneue Talente zu lernen.",
  "MENU_HELP_TXT_250_01": "Manchmal kann Cereza nicht mit Cheshire\r\nin den Knuddelmodus wechseln – zum\r\nBeispiel, wenn sie allein durch Rosmarin\r\ngehen muss oder wenn Cheshire weit weg ist.",
  "MENU_HELP_TXT_011_01": "Erhöht die Magie, die durch\r\nFesselung eines Gegners\r\nmittels Dornenfessel erhalten\r\nwird.",
  "MENU_HELP_TXT_125_01": "Mit diesem Talent kann Cheshire\r\nsich auf den Gegner stürzen, um ihn\r\nanzugreifen, wenn du [BTN:R2 ] drückst,\r\nwährend Cheshire ausweicht.",
  "MENU_HELP_TXT_029_01": "Triffst du alle halbmondförmigen Symbole,\r\nerscheinen neue. Schließe mehrere Gruppen\r\nvon Symbolen erfolgreich ab, damit der\r\nHexenpuls gelingt. Lasse dabei [BTN:L2 ] nicht los!",
  "MENU_HELP_TXT_208_01": "Speichere das Spiel im Menü \r\n„Vorbereitungen“. Es kann nicht schaden,\r\nneben dem automatischen Speichern\r\nauch regelmäßig manuell zu speichern.",
  "MENU_HELP_TXT_121_01": "Mit diesem Talent wird die letzte\r\nAttacke einer Fessel-Kombo zu\r\neinem Stein-Elementarangriff,\r\nwenn du Stein-Cheshire benutzt.",
  "MENU_SKILLTREE_TXT_406": "Führe einen Aufgeladenen Angriff\r\ndurch, nachdem Cereza einen Gegner\r\ngefesselt hat, um eine mächtige\r\nKomboattacke auszuführen.",
  "MENU_SKILLTREE_TXT_415": "Cheshire kann mehr Schaden\r\neinstecken, bevor er sich in seine\r\nPlüschtierform verwandelt.",
  "MENU_HELP_TXT_230_01": "Setze Stein-Cheshires Stampfattacke\r\nauf den riesigen Pilzen ein, um in\r\nansonsten unerreichbare Höhen\r\nkatapultiert zu werden.",
  "MENU_HELP_TXT_015_01": "Stelle vorübergehend den\r\nursprünglichen Zustand von\r\nObjekten wieder her, indem du [BTN:L2 ]\r\ngedrückt hältst und [BTN:LS ] drehst.",
  "MENU_HELP_TXT_119_01": "Mit diesem Talent kannst du am Ende\r\neiner Fessel-Kombo [BTN:R2 ] drücken, um\r\neine mächtige, weit reichende\r\nAttacke auszuführen.",
  "MENU_HELP_TXT_226_02": "Manche Irrlichter werden eine Bitte\r\nan dich richten. Hilf ihnen, dann\r\nwirst du vielleicht dafür belohnt.",
  "MENU_SKILLTREE_TXT_302": "Setze die Dornenfessel erfolgreich\r\ngegen einen Gegner ein, um ein\r\nwenig Magie wiederherzustellen.",
  "MENU_SKILLTREE_TXT_311": "Erhöht das Tempo, mit dem du im\r\nKnuddelmodus Magie wiederherstellst.",
  "MENU_SKILLTREE_TXT_306": "Deine Dornenfessel lädt sich\r\netwas schneller wieder auf.",
  "MENU_SKILLTREE_TXT_315": "Lässt dich bei erfolgreicher\r\nDornenfessel mehr Magie\r\nwiederherstellen.",
  "MENU_HELP_TXT_130_01": "Mit diesem Talent führt Cheshire\r\neinen kleinen Angriff aus, der\r\nGegner ablenken kann, wenn du im\r\nKnuddelmodus [BTN:R2 ] drückst.",
  "MENU_HELP_TXT_219_01": "Spuren, die der weiße Wolf\r\nüberall im Wald hinterlassen\r\nhat. Nähere dich ihnen, um\r\nmehr von ihnen aufzudecken.",
  "MENU_SKILLTREE_TXT_402": "Halte [BTN:R2 ] gedrückt, um Kraft zu\r\nsammeln, dann lasse los, damit\r\nCheshire sich mit voller Wucht\r\nauf den Gegner stürzt.",
  "MENU_HELP_TXT_108_01": "Drücke [BTN:B ], um Cheshire in\r\nStein-Cheshire zu verwandeln. In\r\ndieser Form kann Cheshire mit [BTN:R1 ]\r\neine Stampfattacke ausführen.",
  "MENU_SKILLTREE_TXT_411": "Lasse auf einen erfolgreichen\r\nKonter mit [BTN:R2 ] einen\r\nzusätzlichen Angriff folgen.",
  "MENU_HELP_TXT_004_01": "Die Blumensymbole unten links\r\nzeigen Cerezas Lebenskraft an.\r\nDiese sinkt, wenn Cereza von\r\nGegnern angegriffen wird.",
  "MENU_HELP_TXT_245_01": "Parfüm in einer Halbmondflasche.\r\nHalte [BTN:DP_R ] und Cheshire steht\r\nzur Ausführung seiner Talente temporär\r\nunbegrenzte Magie zur Verfügung.",
  "MENU_HELP_TXT_221_01": "Die Illusionen der Feen haben\r\nihren Ursprung in einem sogenannten\r\nTír na nÓg. Diese Tír na nÓg sind\r\nüberall im Wald zu finden.",
  "MENU_SKILLTREE_TXT_405": "Cheshire kann ein wenig mehr Schaden\r\neinstecken, bevor er sich in seine\r\nPlüschtierform verwandelt.",
  "MENU_SKILLTREE_TXT_416": "Setze als mächtige Attacke am\r\nEnde einer Fessel-Kombo einen\r\nspeziellen Wasser-Elementarangriff\r\nein, wenn du Wasser-Cheshire benutzt.",
  "MENU_HELP_TXT_242_01": "Ein Kristall in Halbmondform,\r\nder etwas magische Energie\r\nwiederherstellt, wenn du ihn\r\neinsammelst.",
  "MENU_HELP_TXT_226_01": "Gefangene Irrlichter findest\r\ndu überall im Wald. Wenn du\r\neines siehst, drücke [BTN:L1 ], um\r\nes zu befreien.",
  "MENU_HELP_TXT_003_01": "Drücke [BTN:L2 ] in der Nähe eines Ziels, dann\r\nneige [BTN:LS ] mit dem korrekten Timing in\r\nRichtung der halbmondförmigen Symbole,\r\num Cerezas Hexenpuls auszuführen.",
  "MENU_SKILLTREE_TXT_301": "Halte [BTN:L2 ] gedrückt und neige\r\n[BTN:LS ] im richtigen Augenblick,\r\num Pflanzen und andere Objekte\r\nmit Magie zu erfüllen.",
  "MENU_SKILLTREE_TXT_312": "Lässt dich mehr Items tragen.",
  "MENU_HELP_TXT_219_02": "Die Fußspuren des weißen Wolfs\r\nführen Cereza zu ihrem nächsten\r\nZiel. Halte Ausschau nach ihnen,\r\nwenn du nicht weiterweißt.",
  "MENU_HELP_TXT_126_01": "Drücke im Knuddelmodus [BTN:R1 ], kurz\r\nbevor ein gegnerischer Angriff\r\ntrifft, um Cheshire herbeizurufen,\r\nder einen Konterangriff ausführt.",
  "MENU_HELP_TXT_004_02": "Wenn das letzte Blütenblatt\r\nfällt, ist das Spiel beendet.\r\nBehalte Cerezas Lebenskraft\r\nalso stets im Auge.",
  "MENU_HELP_TXT_221_02": "Zerstöre den Kern im Herzen eines\r\nTír na nÓg, um die Illusionen zu\r\nvertreiben, die von ihm ausgehen.",
  "MENU_HELP_TXT_012_01": "Deine Dornenfessel lädt sich\r\netwas schneller wieder auf.",
  "MENU_HELP_TXT_237_01": "Die Mandragorawurzel ist eine\r\nin grünem Kristall eingeschlossene\r\nZutat, die zum Brauen genutzt wird.",
  "MENU_SKILLTREE_TXT_401": "Drücke mit Cheshire [BTN:R1 ], um\r\nbestimmte Angriffe zu parieren.",
  "MENU_HELP_TXT_108_02": "Durch Stampfen kannst du angreifen\r\noder bestimmte Objekte zerstören,\r\nhervorbringen oder umdrehen.",
  "MENU_HELP_TXT_016_01": "Drückst du im letzten Moment [BTN:L1 ], um\r\neinem Gegnerangriff auszuweichen,\r\nwird die Hexenzeit aktiviert, die den\r\nLauf der Zeit kurzzeitig verlangsamt.",
  "MENU_HELP_TXT_233_01": "Bei Avalonkonfekt handelt es sich\r\num äußerst süße Magiekristalle.\r\nCheshire benötigt sie, um\r\nneue Talente zu lernen.",
  "MENU_SKILLTREE_TXT_409": "Drücke [BTN:R2 ] am Ende einer\r\nFessel-Kombo, um eine mächtige\r\nund weitreichende\r\nAttacke auszuführen.",
  "MENU_CHALLENGE_DIALOG_TXT_01": "Items verwenden, um dieses\r\nTír na nÓg freizuschalten?",
  "MENU_HELP_TXT_122_01": "Mit diesem Talent wird die letzte\r\nAttacke einer Fessel-Kombo zu\r\neinem Wasser-Elementarangriff,\r\nwenn du Wasser-Cheshire benutzt.",
  "MENU_HELP_TXT_250_02": "In so einem Fall solltest du\r\ndich genau umsehen und einen\r\nWeg finden, wie du die beiden\r\nwiedervereinen kannst.",
  "MENU_SKILLTREE_TXT_309": "Drücke [BTN:L3 ], um mit Cereza\r\nauszuweichen.",
  "MENU_HELP_TXT_222_01": "In manchen Tír na nÓg musst\r\ndu Missionen mit besonderen\r\nBedingungen erfüllen.",
  "MENU_HELP_TXT_246_01": "Trank in einer Dornenflasche.\r\nHalte [BTN:DP_D ], um eine Schockwelle\r\nzu erzeugen, die Gegner in der\r\nNähe betäubt.",
  "MENU_HELP_TXT_007_01": "Verwende im Knuddelmodus [BTN:L1 ],\r\num Cheshire auf höher gelegene\r\nOrte zu werfen. Manchmal kommt\r\nman nur getrennt weiter.",
  "MENU_HELP_TXT_133_01": "Mit diesem Talent steigerst du\r\nCheshires Angriffskraft. Dies\r\nbetrifft sämtliche Attacken von\r\nCheshire.",
  "MENU_HELP_TXT_232_01": "Cheshire kann Elementarkerne \r\nzerstören, indem er sie angreift.\r\nZerstöre alle Elementarkerne,\r\num Cerezas Mission zu erfüllen.",
  "MENU_SKILLTREE_TXT_332": "Deine Dornenfessel kann nun bis zu \r\nviermal aufgeladen werden, sodass du\r\nnoch mehr Gegner fesseln kannst.",
  "MENU_HELP_TXT_017_01": "Ermöglicht Cereza das\r\nAusweichen mittels [BTN:L3 ].",
  "MENU_SKILLTREE_TXT_425": "Gegner lassen manchmal Items\r\nfallen, wenn du sie mit\r\nPlüschprügel attackierst.",
  "MENU_HELP_TXT_123_01": "Mit diesem Talent wird die letzte\r\nAttacke einer Fessel-Kombo zu\r\neinem Feuer-Elementarangriff,\r\nwenn du Feuer-Cheshire benutzt.",
  "MENU_SKILLTREE_TXT_525": "Vergrößert den magischen Kreis\r\nder Dornenfessel noch mehr.",
  "MENU_SKILLTREE_TXT_532": "Vergrößert den magischen Kreis\r\nder Dornenfessel ein drittes Mal.",
  "MENU_HELP_TXT_010_02": "Gegner sind in der Dornenquetsche länger\r\nbewegungsunfähig und nehmen mehr Schaden\r\nals in der normalen Dornenfessel, wodurch\r\nCheshire sie schneller erledigen kann.",
  "MENU_HELP_TXT_006_01": "Drücke [BTN:L2 ], damit Cereza\r\nihre Umbra-Künste nutzt. Gibt\r\nes Ziele in der Nähe, werden\r\ndiese automatisch anvisiert.",
  "MENU_HELP_TXT_247_01": "Solltest du dich je verlaufen,\r\nhalte nach Leitlichtern\r\nAusschau. Sie weisen dir den\r\nWeg zum nächsten Unterschlupf.",
  "MENU_HELP_TXT_223_01": "Manche Feen benutzen Barrieren\r\nim Kampf. Normale Angriffe können\r\ndiesen Barrieren nichts anhaben.",
  "MENU_SKILLTREE_TXT_421": "Drücke im Knuddelmodus [BTN:R1 ], kurz\r\nbevor dich ein Angriff trifft, um\r\nCheshire herbeizurufen, damit er den\r\nGegner unterbrechen und betäuben kann.",
  "MENU_HELP_TXT_132_01": "Mit diesem Talent steigerst du\r\nCheshires Lebenskraft.",
  "MENU_SKILLTREE_TXT_325": "Deine Dornenfessel kann nun dreimal\r\naufgeladen werden, sodass du bis zu\r\ndrei Gegner fesseln kannst.",
  "MENU_HELP_TXT_209_02": "Gewissen Tír na nÓg kannst du dich\r\nauch im Kampf auf Zeit stellen.\r\nSchaffst du die Herausforderung,\r\nwirst du je nach Leistung belohnt.",
  "MENU_HELP_TXT_002_01": "Durch Drücken von [BTN:L1 ]\r\nkann Cereza mit verschiedenen\r\nObjekten interagieren.",
  "MENU_HELP_TXT_227_01": "Wenn du genug Irrlichter gerettet\r\nhast, gibt dir Colm in der Zuflucht\r\nder Irrlichter vielleicht eine\r\nBelohnung, wenn du ihn besuchst.",
  "MENU_HELP_TXT_243_01": "Medizin in einer Blütenflasche.\r\nHalte [BTN:DP_U ], um damit einen\r\nTeil von Cerezas Lebenskraft\r\nwiederherzustellen.",
  "MENU_HELP_TXT_127_01": "Drücke [BTN:L1 ] rasch zweimal, um\r\nCheshire auf Cereza zustürmen zu lassen,\r\nwobei er durch alle Gegner im Weg pflügt,\r\nbevor er in den Knuddelmodus wechselt.",
  "MENU_SKILLTREE_TXT_329": "Lässt dich bei erfolgreicher\r\nDornenfessel noch mehr Magie\r\nwiederherstellen.",
  "MENU_HELP_TXT_236_01": "Bei Mondperlen handelt es sich um\r\nreine magische Energie in\r\nKristallform. Mit ihnen kann Cereza\r\nbesonders mächtige Talente lernen.",
  "MENU_HELP_TXT_109_02": "Cheshires Wasserstrahl reicht\r\nsehr weit und kann viele Objekte\r\nverschieben sowie Flammen löschen.",
  "MENU_HELP_TXT_013_01": "Verlangsamt Gegner,\r\nwährend die Dornenfessel\r\nauf sie gewirkt wird.",
  "MENU_HELP_TXT_209_01": "Im Menü „Vorbereitungen“ kannst du\r\ndich erneut an bereits geschafften\r\nTír na nÓg versuchen, um z. B.\r\nverpasste Schätze einzusammeln.",
  "MENU_HELP_TXT_120_01": "Mit diesem Talent wird die letzte\r\nAttacke einer Fessel-Kombo zu\r\neinem Holz-Elementarangriff,\r\nwenn du Holz-Cheshire benutzt.",
  "MENU_HELP_TXT_014_01": "Erhöht die Anzahl der Aufladungen\r\nfür deine Dornenfessel und lässt\r\ndich so mehrere Gegner fesseln.",
  "MENU_HELP_TXT_112_03": "Außerdem können mit\r\n[BTN:A ], [BTN:B ], [BTN:X ] und [BTN:Y ]\r\nmächtige Elementarangriffe\r\nausgeführt werden.",
  "MENU_HELP_TXT_231_01": "Kleine Quellen von Elementarenergie\r\nkannst du mit [BTN:L1 ] absorbieren.\r\nEinmal absorbierte Elementarenergie\r\nkann nicht erneut absorbiert werden.",
  "MENU_HELP_TXT_118_01": "Setze im Bestienmodus in der Nähe\r\ngefesselter Gegner einen Aufgeladenen\r\nAngriff mit [BTN:R2 ] ein und Cheshire führt\r\neine mächtige Komboattacke aus.",
  "MENU_HELP_TXT_227_02": "Wenn Colm dir etwas zu sagen hat,\r\nerscheint ein Irrlichtsymbol auf\r\nder Karte. In dem Fall solltest du\r\nunbedingt bei ihm vorbeischauen.",
  "MENU_HELP_TXT_131_01": "Mit diesem Talent bringst du Gegner\r\ndazu, Items fallenzulassen, wenn du\r\nsie mittels Plüschprügel triffst.",
  "MENU_HELP_TXT_218_01": "Im Knuddelmodus kannst du\r\nmit [BTN:RS ] Fuchswedel ergreifen\r\nund dann [BTN:L1 ] drücken, um\r\neinen Sprung auszuführen.",
  "MENU_HELP_TXT_109_01": "Drücke [BTN:X ], um Cheshire in\r\nWasser-Cheshire zu verwandeln. In\r\ndieser Form kann Cheshire mit [BTN:R1 ]\r\neinen Wasserstrahl verschießen.",
  "MENU_HELP_TXT_220_01": "In den Verzerrungen der Feen verstecken\r\nsich viele Trugbilder. Halte [BTN:L2 ]\r\ngedrückt, um sie mit dem Licht des\r\nMagischen Armreifs zu erkennen.",
  "MENU_HELP_TXT_244_01": "Trank in einer Schmetterlingsflasche.\r\nHalte [BTN:DP_L ] und du wirst temporär\r\nunverwundbar und kannst schneller\r\nin Folge Umbra-Künste zaubern.",
  "MENU_HELP_TXT_005_01": "Sammle fünf Blätter der Lebenskraft\r\noder eine Blüte der Lebenskraft,\r\num Cerezas maximale Lebenskraft\r\nzu erhöhen.",
  "MENU_HELP_TXT_240_01": "Sammle fünf Blätter der\r\nLebenskraft, um eine Blüte\r\nder Lebenskraft zu erhalten,\r\ndie Cerezas Lebenskraft steigert.",
  "MENU_HELP_TXT_224_01": "Im Wald verstreute Aufzeichnungen\r\nkannst du einsammeln und dann\r\njederzeit im Archiv-Menü lesen.",
  "MENU_HELP_TXT_001_01": "Bewege Cereza mit [BTN:LS ].\r\nSie erklimmt oder springt über\r\nkleine Stufen, während sie sich\r\nbewegt.",
  "MENU_SKILLTREE_TXT_331": "Weiche einem gegnerischen Angriff im\r\nletzten Moment mit [BTN:L1 ] aus, um deine \r\nSinne zu schärfen und dich kurzzeitig\r\nschneller als gewöhnlich zu bewegen.",
  "MENU_SKILLTREE_TXT_322": "Erhöht die Wirkung von\r\ngebrauten Items.",
  "MENU_HELP_TXT_135_01": "Drücke [BTN:R1 ], damit Cheshire\r\nStufen einer gewissen Höhe\r\nhinabspringt. Diese sind\r\nweiß markiert.",
  "MENU_SKILLTREE_TXT_426": "Erhöht die Wahrscheinlichkeit, dass\r\nmit Plüschprügel attackierte Gegner\r\nItems fallen lassen, und lässt dabei\r\nmehr verschiedene Items erscheinen.",
  "MENU_HELP_TXT_216_03": "Wenn Cheshire für längere Zeit zu\r\nweit von Cereza entfernt ist, ist das\r\ngar nicht gut! Achte darauf, dass die\r\nbeiden immer nahe beieinander sind.",
  "MENU_HELP_TXT_006_02": "Cereza kann die Umbra-Künste\r\nnur einsetzen, wenn sie aufgeladen\r\nsind. Nach Nutzung laden sie sich\r\nallerdings von selbst wieder auf.",
  "MENU_HELP_TXT_223_02": "Um Barrieren zu zerstören, solltest\r\ndu Elementarangriffe ausprobieren.\r\nJede Art von Barriere ist anfällig\r\nfür ein bestimmtes Element.",
  "MENU_SKILLTREE_TXT_422": "Cheshire kann noch mehr Schaden\r\neinstecken, bevor er sich in seine\r\nPlüschtierform verwandelt.",
  "MENU_HELP_TXT_010_01": "Manche Gegner sind verwundbar,\r\nnachdem sie bestimmte Angriffe\r\nausgeführt haben. Drücke und halte\r\ndann [BTN:L2 ] für die Dornenquetsche.",
  "MENU_HELP_TXT_235_01": "Höllenfrüchte sind spezielle\r\nFrüchte, mit denen du Cheshire\r\nbesonders mächtige Talente\r\nbeibringen kannst.",
  "MENU_HELP_TXT_124_01": "Mit diesem Talent kann Cheshire\r\nausweichen, wenn du im Bestienmodus\r\n[BTN:R3 ] drückst.",
  "MENU_SKILLTREE_TXT_326": "Erhöht das Tempo, mit dem du im\r\nKnuddelmodus Magie wiederherstellst,\r\nnoch mehr.",
  "MENU_HELP_TXT_028_01": "Drücke [BTN:L1 ], damit Cereza\r\nStufen einer gewissen Höhe\r\nhinabspringt. Diese sind\r\nweiß markiert."
}
