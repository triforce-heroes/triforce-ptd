{
  "CORE_DIALOG_TXT_112": "Hai ricevuto il costume\r\n\"Cereza nel paese delle meraviglie\".",
  "CORE_DIALOG_TXT_101": "Seleziona Costumi in un Santuario\r\nper cambiare l'aspetto di Cereza\r\ne Cheshire.",
  "AC_NARRATION235_0010": "Le turbolenti acque della cascata\r\nsi gettavano nel lago Nimueh.",
  "CORE_SNPSS_4020": "Cereza scopre che Cheshire\r\nè stato catturato dalle fate,\r\nquindi decide di mettere da\r\nparte le loro incomprensioni\r\ne con l'aiuto del lupo bianco\r\nsi infiltra nella fortezza.",
  "CORE_WISP_TALK_71_FAS": "Bentrovata, Cereza.\r\nRiesci a trovare le impronte di lupo?",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "Ostruzione",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "Rancore",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "Requisiti per lo sblocco: impara\r\ndelle tecniche con Cheshire e...",
  "CORE_WH_TALK_11_COL": "Ce la stiamo spassando alla grande qui,\r\ngrazie a voi. Perché non vi fermate per\r\nun po'?",
  "CORE_SNPSS_6010": "Traditi da Lukaon, Cereza\r\ne Cheshire collaborano per\r\nfermarlo. Tornato finalmente\r\nin sé, Lukaon aiuta i due\r\na trovare una via d'uscita\r\ndalla foresta.",
  "CORE_HTDMMESS_0039_001_H39": "Coff, coff... Scusa... Non mi sento per\r\nniente bene. Non avresti una medicina\r\na portata di mano?",
  "CORE_HTDMQUEST_TXT_0026": "Lo stile è tutto, tesoro... Anche\r\nqui ad Avalon. Vorrei un fiore\r\nche esalti il mio carattere.",
  "AC_NARRATION260_0010": "Dopo aver salvato così tanti spiritelli,\r\nCereza e Cheshire erano diventati\r\ngli eroi degli oppressi di Avalon.",
  "CORE_WH_TALK_04_COL": "Un sacco di spiritelli hanno fatto ritorno!\r\nE tutto grazie a te e a quel... ehm...\r\ntuo amico!",
  "CORE_POSEMENU_TXT_06": "Esci dal Tír na nÓg.",
  "CORE_HTDMMESS_0023_001_H23": "Oooh... Ma perché ho sempre così\r\ntanta fame? Cibo... Mi serve cibo...\r\nDove posso trovare da mangiare?",
  "CORE_WISP_TALK_64_FAS": "Considerami la tua guida per Avalon.\r\nTi condurrò ovunque tu voglia andare.",
  "CORE_SNPSS_3030": "Dopo un'intensa battaglia,\r\nCereza e Cheshire sconfiggono\r\nJabberwock. Guidati dal\r\nlupo bianco, si dirigono al\r\nSantuario dove è tenuto\r\nil nucleo elementale.",
  "CORE_SVSLT_TXT_02": "Seleziona un file da caricare.",
  "AC_CEREZA040_0010": "Nessuno ti vuole bene. Credi davvero\r\nche diventerai una grande strega?",
  "CORE_SNPSS_1000": "Cereza prosegue il suo\r\nviaggio nel regno ostile.\r\nPer qualche motivo, sembra\r\navere una gran fretta...",
  "CORE_HTDMMESS_0013_002_H13": "Posso sentirle... le voci che mi chiamano\r\nda una dimensione sconosciuta...",
  "CORE_WISP_TALK_28_H14": "Evviva, sono finalmente libero!\r\nOra torno a casa e mi preparo\r\nqualcosa di delizioso!",
  "CORE_HTDMMESS_0021_002_H21": "Magari una piuma per il mio\r\ncappello... Così sì che avrei\r\nun posto nel firmamento!",
  "CORE_POSEMENU_TXT_02": "Consulta i tutorial del gioco.",
  "CORE_POSEMENU_TXT_11": "Continua dall'ultimo\r\npunto di salvataggio.",
  "CORE_WISP_TALK_17_H03": "Mi hai salvato... Grazie mille!\r\nOra pensiamo al portone, OK?",
  "TA_9011_0010_COL": "Fai attenzione, amica!",
  "CORE_DIALOG_TXT_005": "Il file di salvataggio di questo\r\nslot verrà cancellato.\r\nVuoi continuare?",
  "CORE_DIALOG_TXT_116": "Hai ricevuto i costumi\r\n\"Arci-Eva Originaria\",\r\n\"Jeanne\" e \"Charles\".",
  "CORE_DIALOG_TXT_105": "Vuoi chiudere il menu dei costumi?",
  "CORE_HAIR_CERESSA_TXT_03": "Risoluzione",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "Imprecazione",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "Oscurità accecante",
  "CORE_WH_TALK_21_COL": "Se trovi altri spiritelli, digli di venire\r\nqui. Di sicuro saranno terrorizzati,\r\ncosì perduti e soli...",
  "CORE_WISP_TALK_21_H07": "Evvai, mi posso muovere di nuovo!\r\nGrazie, amica! È grandioso!",
  "TEST_WISP_TALK_13_H00": "Brrr, ho una brutta sensazione...\r\nTi dispiace se aspettiamo qui?",
  "CORE_HTDMMESS_0004_002_H04": "Uh, ho sempre il terrore che le fate mi\r\nscoprano... Aiutami a trovare qualcosa\r\nper nascondermi, per favore!",
  "CORE_DIALOG_TXT_150": "Imposta l'uso dell'energia\r\nvitale di Cereza. \"Meno\"\r\nriduce i danni, \"Nessuno\"\r\nli ignora.",
  "TA_COM030_0010_CER": "Umpf!",
  "CORE_HTDMQUEST_TXT_0039": "Non mi sento tanto bene... Hai\r\nqualcosa contro il raffreddore?",
  "CORE_WH_TALK_18_COL": "Oh, Cereza, Cheshire!\r\nGrazie di aver salvato tutti!",
  "TA_COM030_0020_CER": "Ehi!",
  "CORE_DIALOG_TXT_154": "Se eseguire il Battito di strega\r\nti sembra difficile, puoi cambiare\r\nle impostazioni e farlo eseguire\r\nautomaticamente. Cosa preferisci?",
  "CORE_WISP_TALK_25_H11": "Grazie dell'aiuto!\r\nForza, andiamocene da qui!",
  "CORE_ARCHIVE_TXT_03": "Pagine del diario trovate nella foresta.",
  "AC_CEREZA130_0010": "Non è vero!",
  "CORE_WH_TALK_02_COL": "Se trovi altri nostri amici, parla\r\nloro di questo posto. Da soli non\r\nsaprebbero dove andare, ricordatelo.",
  "CORE_WISP_TALK_32_H18": "Uff, grazie un milione dell'aiuto!\r\nMaledette fate... La pagheranno!",
  "CORE_HTDMMESS_0029_003_H29": "Questa medicina... Mmmmmmh...\r\nEhi, mi sembra di avere più voglia\r\ned energie.",
  "AC_NARRATION225_0020": "Non potevano immaginare cosa\r\nli aspettasse più avanti...",
  "CORE_HTDMMESS_0034_001_H34": "Argh, la gola mi fa così male...\r\nNon è che avresti qualcosa per\r\nlenire un po' il dolore?",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "Calamità (sfida)",
  "CORE_WH_TALK_17_COL": "Ecco, questo è per voi.\r\nSpero vi sarà utile.",
  "CORE_HTDMMESS_0006_001_H06": "Hai per caso qualcosa che possa\r\nusare come ago? Basta che sia\r\nappuntito, nient'altro.",
  "CORE_SNPSS_2010": "Cereza e Cheshire fanno\r\nla conoscenza di Colm, uno\r\nspiritello i cui amici sono\r\nstati rapiti dalle fate.\r\nDopo aver litigato con\r\nCheshire, Cereza parte\r\ntutta sola per salvarli.",
  "CORE_DIALOG_TXT_009": "Vuoi spostarti in questo luogo?",
  "CORE_SNPSS_0020": "Confidando nelle parole del\r\ngiovane apparso in sogno,\r\nCereza contravviene alle\r\nraccomandazioni della sua\r\nmaestra e si addentra nelle\r\nprofondità della foresta,\r\nlottando contro le sue paure.",
  "CORE_WISP_TALK_30_H16": "Grazie di avermi dato una mano.\r\nHo sentito che nella torre ci sono\r\ntanti miei amici imprigionati...",
  "AC_CEREZA035_0010": "Lascia perdere.\r\nNon cambierai mai...",
  "TA_COM000_0010_CER": "Mmmh?",
  "CORE_HTDMQUEST_TXT_0029": "Uff, che noia... sono senza stimoli.\r\nMi serve un po' di motivazione...",
  "CORE_WISP_TALK_15_H01": "Grazie dell'aiuto... Yaaawn, vado\r\na... cercare un posticino dove\r\nschiacciare un sonnellino.",
  "CORE_DIALOG_TXT_153": "Imposta la difficoltà dei nemici.\r\n\"Debole\" li rende meno aggressivi\r\ne ne riduce la frequenza di attacco.\r\n\"Pusillanime\" ne riduce il numero.",
  "CORE_DIALOG_TXT_140": "Vuoi rivedere le istruzioni di\r\ngioco nei Consigli di viaggio?\r\nPuoi accedervi in qualsiasi\r\nmomento dal menu di sistema.",
  "CORE_SNPSS_5010": "Cereza riesce a calmare\r\nCheshire dopo che questi\r\nera caduto vittima di un\r\nincantesimo di Púca.\r\nPiù uniti che mai grazie\r\na questa esperienza, si\r\naffrettano a riprendere\r\nla ricerca di Lukaon.",
  "CORE_ARCHIVE_TXT_04": "I ricordi di quest'avventura.",
  "CORE_HTDMMESS_0032_001_H32": "Colm si dà così tanta pena per noi...\r\nVoglio fare qualcosa per ringraziarlo.\r\nHai qualche idea?",
  "TA_COM000_0020_CER": "E questo cos'è?",
  "AC_NARRATION240_0010": "Le acque, pure e cristalline,\r\nriempivano di vita la foresta\r\ndi Avalon.",
  "CORE_WISP_TALK_23_H09": "Grazie del tuo inestimabile aiuto.\r\nOcchio però a non cadere vittima\r\ndel mio fascino irresistibile!",
  "AC_NARRATION215_0010": "Il rifugio segreto degli spiritelli,\r\nnascosto nel cuore della foresta.",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "Morte imminente",
  "CORE_HTDMMESS_0028_001_H28": "Se imparo a resistere al dolore, allora\r\nle fate non potranno più farmi paura!\r\nInsegnami a sopportarlo, ti prego...",
  "CORE_DIALOG_TXT_119": "Hai ricevuto il costume\r\n\"Strega maldestra\".",
  "CORE_WISP_TALK_14_02_H16": "Dentro ci sono un sacco di fate...\r\nSpero che stiano tutti bene.",
  "CORE_HTDMMESS_0017_001_H17": "Voglio il bottino grosso! Un pescione di\r\ndimensioni colossali! Ehi, tu, streghetta...\r\nHai mica un'esca adatta da darmi?",
  "AC_NARRATION250_0020": "La sabbia e la brezza soave erano un balsamo\r\nper Cereza, la quale iniziò a pensare che forse\r\nle fate non erano così male come le dipingevano.",
  "CORE_DIALOG_TXT_011": "Il luogo selezionato è\r\nattualmente inaccessibile.",
  "AC_CEREZA145_0010": "Smettila! Smettila di parlare!",
  "CORE_DIALOG_TXT_002": "Questo slot contiene già\r\ndei dati di salvataggio.\r\nVuoi sovrascriverli?",
  "CORE_HAIR_CERESSA_TXT_04": "Un nuovo capitolo",
  "CORE_DIALOG_TXT_111": "Hai ricevuto il costume\r\n\"Cigno elegante\".",
  "CORE_DIALOG_TXT_102": "Vuoi cambiare\r\nil costume di Cereza?",
  "CORE_WISP_TALK_62_COL": "Sono davvero felice che siano tutti salvi.\r\nGrazie mille, Cereza!",
  "CORE_SNPSS_4030": "Cereza salva Cheshire, che\r\nè gravemente ferito. Il lupo\r\nbianco sparisce all'interno\r\ndella fortezza e i due,\r\nfinalmente riuniti, partono\r\nalla sua ricerca.",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "Successo",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "Catene maledette",
  "CORE_POSEMENU_TXT_05": "Riprendi a giocare\r\ndall'ultimo checkpoint\r\ndel Tír na nÓg.",
  "CORE_SNPSS_1010": "Soffrendo ancora per essere\r\nstata separata da sua madre\r\nRosa, Cereza diventa allieva\r\ndella strega Morgana e si\r\naddestra ogni giorno per\r\ndiventare una strega potente.",
  "CORE_HTDMQUEST_TXT_0032": "Vorrei dare qualcosa a un amico\r\nper risollevargli il morale. Non è\r\nche potresti aiutarmi?",
  "CORE_HTDMQUEST_TXT_0021": "Cerco un accessorio che faccia\r\nrisaltare la mia già invidiabile\r\npersonalità. Hai ciò che voglio?",
  "CORE_POSEMENU_TXT_01": "Modifica varie impostazioni di gioco.",
  "AC_IGNIS005_0010": "Salve, hai bisogno dei miei servigi?\r\nI passaggi segreti non hanno...\r\nsegreti per me!",
  "CORE_SNPSS_3020": "Grazie alla presenza di\r\nspirito di Cereza, i due\r\nriescono a scacciare il\r\nmostro. Con rinnovata\r\nfiducia, lei e Cheshire\r\nriprendono la ricerca dei\r\nnuclei elementali.",
  "CORE_SVSLT_TXT_01": "Seleziona uno slot di salvataggio.",
  "CORE_DIALOG_TXT_115": "Hai ricevuto i costumi\r\n\"Occhio destro\" e\r\n\"Osservatrice del tempo\".",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "Fugacità",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "Pioggia e grandine",
  "CORE_HTDMMESS_0015_002_H15": "Ehilà! Dammi un attimo che sto\r\nprendendo appunti su questa pianta.\r\nSono subito da te...",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "Requisiti per lo sblocco: trova\r\ntutti i tesori dei Tír na nÓg e...",
  "CORE_DIALOG_TXT_006": "Una volta cancellato,\r\nil file non potrà più\r\nessere recuperato.\r\nVuoi davvero continuare?",
  "CORE_MISSION_TEXT_0007": "Supera tutti gli ostacoli\r\ne conquista il Tír na nÓg!",
  "CORE_COSTUME_CHESHIRE_TXT_03": "Devo solo trovare il mio cappello\r\ne andrà tutto bene. Non far caso\r\na chi dice che sono pazzo!",
  "CORE_DIALOG_TXT_160": "Vuoi attivare i tutorial per\r\nquesta partita? Puoi disattivarli\r\nin qualsiasi momento tramite\r\nil menu Opzioni.",
  "AC_CEREZA060_0030": "Direzione sbagliata.",
  "CORE_HTDMMESS_0008_001_H08": "Voglio essere forte... Abbastanza da\r\npoter affrontare qualsiasi fata! Mi aiuti?",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "Rancore (sfida)",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "Pazzia (sfida)",
  "CORE_CSRELEASE_CERESSA_TXT_04": "Requisiti per lo sblocco: impara\r\ndelle tecniche con Cereza e...",
  "TEST_WISP_TALK_10": "Uff... Sono felice di averla fatta\r\nfranca, ma quassù ho le vertigini...",
  "TEST_WISP_TALK_03": "Grazie mille!\r\nSeguimi e ti aprirò il portone!",
  "CORE_HTDMMESS_0015_003_H15": "Questa è... mandragora!\r\nEd è in perfetto stato! Devo\r\nassolutamente studiarla!",
  "AC_CEREZA050_0010": "Non sai fare niente da sola. Però\r\ntanto qualcuno verrà a salvarti, no?",
  "CORE_WISP_TALK_44_H30": "Farmi catturare così... Che vergogna!\r\nOra tocca a me proteggere gli altri!",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "Soffrendo ancora per essere\r\nstata separata da sua madre\r\nRosa, Cereza diventa allieva\r\ndella strega Morgana e si\r\naddestra ogni giorno per\r\ndiventare una strega potente.",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "Vendetta",
  "CORE_SNPSS_2020": "Dopo essersi riuniti, Cereza\r\ne Cheshire si imbattono nella\r\nTorre delle fate, dove gli\r\nspiritelli vengono torturati.\r\nDecidono così di intrufolarsi\r\nall'interno.",
  "CORE_NPC_TXT_11": "Usa ingredienti per\r\ncreare degli oggetti.",
  "TEST_WISP_TALK_07": "Sii prudente, poco più avanti c'è\r\nun circo davvero terrificante!",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "Luce inquietante (sfida)",
  "AC_NARRATION225_0010": "Tutti i nuclei elementali erano stati\r\ndistrutti e le barriere erano svanite.",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "Passi e cinguettii (sfida)",
  "CORE_MISSION_TEXT_0003": "Un solo colpo significa sconfitta!\r\nBatti i nemici senza farti toccare!",
  "CORE_WISP_TALK_34_H20": "Argh, mi fa male dappertutto...\r\nGrazie dell'aiuto, signora strega.",
  "CORE_WISP_TALK_54_H40": "Eccomi di ritorno dopo innumerevoli\r\nsofferenze! Ora potrò vivere di nuovo...",
  "CORE_DIALOG_TXT_090": "Seleziona uno slot per salvare\r\ni dati della partita completata.\r\nPuoi caricarli per scoprire altri\r\nsegreti o completare delle zone.",
  "CORE_CSRELEASE_CERESSA_TXT_08": "Requisiti per lo sblocco: completa\r\ntutte le imprese di Jeanne e...",
  "CORE_WISP_TALK_14_H16": "Se riusciamo ad abbassare questa\r\nleva, potrai entrare nella torre!",
  "CORE_BAND_CHESHIRE_TXT_02": "Tempra robusta",
  "AC_NARRATION260_0020": "I pacifici abitanti della foresta avrebbero\r\nnarrato le gesta della strega coraggiosa\r\ne del suo leale compagno per lunghi anni.",
  "CORE_COSTUME_CERESSA_TXT_07": "Una strega forte, ma gentile che\r\nvuole salvare la sua amica a ogni\r\ncosto. Il futuro è nelle sue mani.",
  "CORE_DIALOG_TXT_031": "Vuoi uscire dal Tír na nÓg?",
  "TA_COM025_0020_CER": "D'accordo!",
  "CORE_WISP_TALK_14_03_H16": "Grazie di aver aiutato i miei\r\namici! Corro a dirlo agli altri...",
  "CORE_SNPSS_6020": "Púca assembra un esercito\r\ndi fate per fermare Cereza,\r\nla quale, a dorso di Cheshire,\r\nsi dirige verso una colonna\r\ndi luce creata da Morgana.",
  "AC_NARRATION235_0020": "Di fronte al fragore delle\r\nrapide, Cereza si sentiva\r\nminuscola.",
  "CORE_WISP_TALK_49_H35": "Bene, a quanto pare sono sano e salvo!\r\nOra posso tornare a casa e inventare\r\naltre cose...",
  "CORE_SNPSS_4010": "Sconvolta da un'illusione di\r\nsua madre creata dalle fate,\r\nCereza litiga con Cheshire e\r\nsi separa da lui, dirigendosi\r\ntutta sola verso la fortezza.",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "Eroismo",
  "TA_COM025_0010_CER": "Fiuuu!",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "Caduta libera",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "Limitazioni",
  "CORE_RETRY_TXT_01": "Vuoi usare gli oggetti\r\nselezionati per sbloccare\r\nquesto Tír na nÓg?",
  "AC_CEREZA015_0020": "Non preoccuparti, ti salverò.",
  "CORE_COSTUME_CERESSA_TXT_03": "Una ragazza che decide di scrivere\r\nun libro sulle sue avventure nella\r\nstrana foresta... se sopravviverà.",
  "CORE_SNPSS_1030": "Cereza incontra Cheshire\r\ne, insieme, cominciano il\r\nviaggio alla ricerca del lupo\r\nbianco. Sperano di ottenere\r\nda lui un incredibile potere,\r\naffinché Cereza possa\r\nrispedire Cheshire a casa,\r\nall'Inferno.",
  "CORE_HTDMMESS_0037_001_H37": "Mi piace la tranquillità di questo posto,\r\nma a volte vorrei provare sensazioni\r\nnuove... Hai qualche suggerimento?",
  "CORE_WISP_TALK_39_H25": "C-che f-freddo! Pensavo che sarei diventato\r\nun cubetto di ghiaccio... Grazie! Gliela\r\nfarò pagare a quelle fate, prima o poi...",
  "CORE_HTDMQUEST_TXT_0006": "Vorrei tanto avere un ago per cucire.\r\nSai dove posso trovarne uno?",
  "CORE_HTDMQUEST_TXT_0015": "È da tanto che non faccio\r\nricerche sulle piante. Potresti\r\ndarmi una mano?",
  "CORE_BAND_CHESHIRE_TXT_01": "Predefinito",
  "CORE_MISSION_TEXT_0008": "Sconfiggi tutte le fate!",
  "CORE_HTDMMESS_0029_002_H29": "Dopo essere finito nelle grinfie delle\r\nfate, non ho più voglia di niente...",
  "CORE_WH_TALK_03_COL": "Quelle fate...\r\nPerché sono così crudeli?",
  "CORE_WH_TALK_19_COL": "Tutti vogliono ringraziarvi.\r\nForza, venite qua, ragazzi!",
  "CORE_WISP_TALK_63_FAS": "Cereza, se ti dovessi mai perdere\r\nnella foresta, chiedimi aiuto.",
  "CORE_NPC_TXT_09": "Riprova un Tír na nÓg\r\no affronta la sfida a tempo.",
  "CORE_DIALOG_TXT_121": "Hai ricevuto il costume\r\n\"Osservatrice del tempo\".",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "Illusione",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "Calamità",
  "CORE_WH_TALK_16_COL": "Cereza, Cheshire... Grazie di tutto!\r\nEcco, prendete! Ve lo siete meritato.",
  "CORE_COSTUME_CERESSA_TXT_04": "\"Rispediscimi all'Inferno, brutta\r\nidiota, o ti divoro all'istante!\"\r\nL'ha presa bene, no?",
  "CORE_DIALOG_TXT_021": "Vuoi preparare un miscuglio?",
  "CORE_DIALOG_TXT_032": "Vuoi ricominciare il Tír na nÓg?\r\n(Perderai i progressi attuali.)",
  "CORE_SNPSS_6030": "Morgana svela le sue vere\r\nintenzioni: sacrificare\r\nCheshire per salvare suo\r\nfiglio. Cereza fa appello\r\na tutto il suo coraggio per\r\nopporsi a colei che una\r\nvolta era la sua maestra.",
  "CORE_WISP_TALK_36_H22": "P-posso muovermi? Meno male!\r\nEd è tutto merito tuo... grazie!",
  "AC_NARRATION250_0010": "Il bagliore luminoso dove l'acqua si infrangeva\r\ndolcemente contrastava con l'ambiente sinistro\r\ndella Foresta di Avalon.",
  "TEST_WISP_TALK_12_H00": "Aaah, per un pelo! Con uno\r\nspiritello in più, ce la faremmo!",
  "CORE_HTDMMESS_0004_003_H04": "Grazie, ti devo un grande favore!\r\nCome dici, un rifugio? E dove?!\r\nLì sì che sarei davvero al sicuro!",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "Fatalità",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "Puntura",
  "TA_COM015_0010_CER": "Bene!",
  "CORE_RETRY_TXT_02": "Vuoi riprovare\r\nquesto Tír na nÓg?",
  "TEST_WISP_TALK_08": "Se il direttore ti trova, è la fine...\r\nSii prudente, amica.",
  "CORE_SNPSS_3010": "Un mostro sferra un attacco a\r\nsorpresa a Cereza e Cheshire,\r\ni cui artigli sembrano non\r\navere effetto sulla corazza\r\ndella temibile creatura.\r\nPresa dal panico, Cereza\r\nfugge nel bosco cercando\r\ndi nascondersi.",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "Compressione (sfida)",
  "CORE_SNPSS_1020": "Confidando nelle parole del\r\ngiovane apparso in sogno,\r\nCereza contravviene alle\r\nraccomandazioni della sua\r\nmaestra e si addentra nelle\r\nprofondità della foresta,\r\nlottando contro le sue paure.",
  "CORE_HTDMMESS_0013_003_H13": "Fantastico! Ce l'ho fatta per davvero.\r\nGrazie dell'aiuto, amica mia.",
  "CORE_HTDMMESS_0026_001_H26": "Anche nei momenti più bui, non bisogna\r\ndimenticare la bellezza. Quindi... non è\r\nche potresti portarmi un fiore?",
  "CORE_DIALOG_TXT_170": "Nella Storia di Jeanne, il gioco\r\nsalva automaticamente in certi\r\npunti. Tieni a mente che non è\r\npossibile salvare manualmente.",
  "AC_CEREZA060_0020": "Sei un disastro. Non è nemmeno\r\ndivertente.",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "Protezione (sfida)",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "Puntura (sfida)",
  "CORE_CSRELEASE_CERESSA_TXT_07": "Requisiti per lo sblocco: completa\r\nla Leggenda proibita e...",
  "CORE_HTDMMESS_0021_003_H21": "Ma è perfetto! Proprio quello che volevo!\r\nSono senza parole... Lo mostrerò subito\r\na tutti!",
  "CORE_NPC_TXT_05": "Salva i progressi di gioco.",
  "CORE_MISSION_TEXT_0004": "I rivali battuti lanciano maledizioni!\r\nEvitale e sconfiggi tutti.",
  "CORE_WH_TALK_20_COL": "Ci sono ancora degli spiritelli nella foresta.\r\nVi prego, dovete aiutarli!",
  "CORE_COSTUME_CERESSA_TXT_08": "\"Ho superato mille ostacoli\r\ne trovato la vera me. So che\r\nmi riunirò con il mio principe.\"",
  "AC_IGNIS015_0010": "Ti orienti bene nella foresta?\r\nSe vuoi che ti mostri un passaggio\r\nsegreto, fammelo sapere!",
  "AC_NARRATION215_0020": "Grazie a Cereza e Cheshire,\r\ntornarono a sentirsi grida di\r\ngioia al suo interno.",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "Passi e cinguettii",
  "CORE_WH_TALK_10_COL": "Cereza e il suo amico felino!\r\nCome va? Mi siete mancati.",
  "CORE_ARCHIVE_TXT_99": "Questa voce è ancora\r\nda sbloccare.",
  "CORE_SNPSS_2030": "Cereza e Cheshire salvano gli\r\namici di Colm dalle grinfie\r\ndelle fate. Dopo un gioioso\r\nincontro tra spiritelli, la\r\ncoppia decide di seguirli.",
  "CORE_WISP_TALK_70_FAS": "Se ti perdi, cerca le impronte del lupo\r\nbianco. È una guida valida tanto quanto me.",
  "CORE_WISP_TALK_65_FAS": "Hai trovato delle impronte di lupo?\r\nSe vuoi, ti ci posso portare io.",
  "AC_CEREZA155_0010": "Smettila... ti scongiuro!",
  "CORE_COSTUME_CHESHIRE_TXT_04": "[FONT:10 ]Diventerò una strega fortissima!\r\nE salverò la mia mamma blablabla!\r\nMmmh... Ottima interpretazione.[FONT:N ]",
  "AC_NARRATION240_0020": "Cereza and Cheshire bevvero fino\r\na saziarsi e recuperarono subito\r\nle forze.",
  "TEST_WISP_TALK_04": "Pensavo mi si sarebbe allungato il collo!\r\nFai attenzione a quelle fate, streghetta!",
  "CORE_CSRELEASE_CERESSA_TXT_03": "Requisiti per lo sblocco: vai\r\nveloce nelle sfide a tempo e...",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "Caduta libera (sfida)",
  "CORE_WH_TALK_05_COL": "Abbiamo organizzato dei turni di guardia.\r\nNon permetteremo che le fate trovino il\r\nnostro rifugio!",
  "CORE_WH_TALK_22_COL": "Mi spiace dover sempre chiedere il vostro\r\naiuto, ma vi prego... salvate i nostri\r\namici.",
  "CORE_BAND_CHESHIRE_TXT_04": "Legami vincolanti",
  "CORE_WISP_TALK_58_FAS": "Fai attenzione alle fate. La parola \"pietà\"\r\nnon fa parte del loro vocabolario...",
  "AC_IGNIS200_0010_0020": "Il passaggio segreto ci aspetta...",
  "TEST_WISP_TALK_09": "Io mi nascondo qui.\r\nNon dirlo a nessuno, eh!",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "Evasione (sfida)",
  "AC_CEREZA030_0010": "Codarda... Sei solo un fallimento!",
  "CORE_SNPSS_2060": "Dopo aver distrutto il secondo\r\nnucleo elementale, Cereza e\r\nCheshire provano il loro nuovo\r\npotere mentre continuano la\r\nricerca del lupo bianco.",
  "CORE_HTDMMESS_0021_001_H21": "Ne ho abbastanza di nascondermi...\r\nTrovami qualcosa che mi ponga al centro\r\ndell'attenzione e che mi faccia brillare!",
  "CORE_WISP_TALK_57_FAS": "Meglio attrezzarsi con corde per scalare\r\ne un costume... Ti aspetta un duro lavoro!",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "Vincolo",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "Perseveranza",
  "CORE_HTDMMESS_0013_001_H13": "Ehi, amica... Mi puoi aiutare? Voglio\r\nfare un rituale che mi trasformi in\r\nciò che vorrei veramente essere.",
  "CORE_HTDMMESS_0026_003_H26": "Oh, sei una strega incredibile!\r\nTi meriteresti un bacione!",
  "CORE_COSTUME_CERESSA_TXT_01": "Una giovane strega che parte per\r\nAvalon nell'intento di salvare la\r\nmadre e lì incontra un demone.",
  "CORE_SNPSS_6035": "Cereza assiste alla fine di\r\nMorgana e Lukaon, vittime di\r\nun destino tragico e crudele.\r\nSi volta verso Cheshire per\r\nun ultimo saluto, e infine...",
  "CORE_COSTUME_CERESSA_TXT_05": "Vestiti ormai troppo piccoli per\r\nCereza. Le riportano alla mente\r\nla ricerca della madre.",
  "CORE_DIALOG_TXT_033": "Vuoi ricominciare il Tír na nÓg?",
  "CORE_WISP_TALK_67_FAS": "Il lupo bianco sembra piuttosto lontano,\r\nma non è un problema per la vecchia Ignis!",
  "AC_NARRATION245_0010": "Il palazzo mostrava con chiarezza i segni\r\ndel tempo, ma non era stato comunque\r\nspogliato del tutto della sua maestosità.",
  "CORE_WH_TALK_07_COL": "Al rifugio c'è gran fermento! Spero\r\ndiventerà un luogo dove tutti possano\r\nsentirsi al sicuro.",
  "CORE_DIALOG_TXT_120": "Hai ricevuto il costume\r\n\"Occhio destro\".",
  "CORE_HTDMMESS_0023_002_H23": "Ti prego... Dimmi che mi aiuterai\r\na trovare qualcosa con cui riempirmi\r\nlo stomaco...",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "Pazzia",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "Prigione di rovi",
  "CORE_HTDMMESS_0039_002_H39": "Ecciù! Pensavo che dopo essere\r\ndiventato spiritello, non mi sarei più\r\npreso il raffreddore...",
  "CORE_WISP_TALK_68_FAS": "È facile perdersi nella Foresta di Avalon.\r\nVuoi che ti porti vicino al lupo bianco?",
  "CORE_WH_TALK_12_COL": "Mi sto allenando di brutto, si vede?\r\nLa prossima volta, ci penserò io a\r\nsistemare per bene quelle fate!",
  "CORE_WISP_TALK_24_H10": "Grazie, ehm... tesoro. Ti dà fastidio\r\nse mi aggrego a voi per un po'?",
  "CORE_WH_TALK_08_COL": "Sai che abbiamo creato una pattuglia?\r\nAnche se le fate sono più forti di noi,\r\npotrà comunque esserci utile...",
  "CORE_WISP_TALK_33_H19": "Grazie. Ti sono serviti solamente\r\n34.506.250 secondi per salvarmi.",
  "AC_NARRATION210_0010": "Una torre gigantesca costruita\r\ndalle fate. Strani dispositivi sono\r\ndisseminati tutt'intorno.",
  "AC_NARRATION255_0020": "Quanto tempo ci sarà voluto perché\r\nne crescessero così tante? Erano\r\nsbalorditi di fronte a tale visione.",
  "TEST_WISP_TALK_05": "Persino una piccola fatina mi dà\r\nfilo da torcere... Che nullità sono...",
  "CORE_CSRELEASE_CERESSA_TXT_02": "Requisiti per lo sblocco: salva\r\nabbastanza spiritelli e...",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "Resa dei conti (sfida)",
  "CORE_HTDMMESS_0006_002_H06": "Mmmh, tutti questi aghi non vanno\r\nbene... Come posso lavorare così?",
  "CORE_MISSION_TEXT_0001": "Puoi danneggiare i nemici solo se usi\r\nLegaccio di rovi! Sconfiggili tutti!",
  "CORE_HTDMMESS_0034_002_H34": "Dovrei stare di guardia, ma... con la gola\r\nin questo stato, non potrei mai lanciare\r\nl'allarme se succedesse qualcosa!",
  "CORE_WH_TALK_14_COL": "Il rifugio continua a crescere!\r\nRestate un po' qui con noi a\r\ngiocare, OK?",
  "CORE_COSTUME_CHESHIRE_TXT_05": "Comprato al \"Pygmalion\", famoso\r\nnegozio di giocattoli. Permette di\r\ngiocare con Jeanne e Charles.",
  "CORE_COSTUME_TXT_01": "Seleziona un nuovo costume.",
  "CORE_SNPSS_1070": "Dopo aver distrutto il primo\r\nnucleo elementale, Cereza\r\ne Cheshire si addentrano\r\nsempre di più nella foresta\r\nper trovare gli altri tre.",
  "TA_COM020_0010_CER": "Oooh...",
  "CORE_WH_TALK_01_COL": "Ciao, Cereza. Hai trovato\r\naltri nostri amici, per caso?",
  "AC_NARRATION200_0020": "Dalle profondità della foresta,\r\nil vento trasportava l'eco di un\r\npotere misterioso.",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "Proiezione oscura",
  "CORE_SNPSS_3040": "Cereza and Cheshire distruggono\r\nil terzo nucleo elementale e\r\nsi mettono in marcia verso\r\nl'ultimo, approfittando dei\r\nloro nuovi poteri.",
  "CORE_WISP_TALK_61_FAS": "Ho un messaggio da parte di Colm: \"Voglio\r\nvederti di nuovo! Passa da me appena puoi!\"",
  "CORE_EVENT_PAUSE_TXT_01": "Premi [BTN:START ] per riprendere.",
  "CORE_WISP_TALK_16_H02": "Grazie. Ora me ne torno al rifugio\r\na escogitare qualche piano\r\ndifensivo.",
  "TA_COM020_0020_CER": "Oooh...",
  "AC_IGNIS200_0000_0010": "Non è ora di ciondolare!",
  "CORE_COSTUME_CERESSA_TXT_09": "Costume tradizionale delle streghe\r\napprendiste. Permette di giocare\r\ncon Jeanne e Charles.\r\n",
  "CORE_HTDMMESS_0004_001_H04": "A volte ho solo voglia di nascondermi\r\nda tutto e da tutti. E se mi camuffassi\r\nda pianta? Aiutami, per favore!",
  "CORE_MISSION_TEXT_0005": "Usa gli elementi corretti per\r\neliminare le barriere dei nemici!",
  "CORE_COSTUME_CHESHIRE_TXT_01": "Un demone perduto e irascibile.\r\nAnche sotto forma di morbido\r\npeluche, rimane molto feroce.",
  "TEST_WISP_TALK_55_COL": "Molti altri spiritelli sono intrappolati\r\nin quella torre... Devi salvarli!",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "Schermaglia (sfida)",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "Perseveranza (sfida)",
  "TEST_WISP_TALK_01": "Grazie, amica!",
  "CORE_SNPSS_4050": "I due riescono a distruggere\r\nl'ultimo nucleo elementale e\r\nabbandonano il Santuario,\r\nforti dei loro nuovi poteri.",
  "CORE_MISSION_TEXT_0002": "Sconfiggi tutti i nemici prima che\r\nscada il tempo! Il limite viene\r\nesteso per ogni nemico battuto.",
  "CORE_WISP_TALK_19_H05": "Wow, che sensazione di leggerezza!\r\nGrazie, gattone! Ci vediamo!",
  "AC_NARRATION230_0010": "Davanti a loro si ergeva un magnifico albero,\r\ni cui rami di un bianco abbagliante si allungavano\r\nfin dove poteva giungere l'occhio.",
  "CORE_DIALOG_TXT_091": "Congratulazioni! Hai nuove opzioni:\r\n- Nuovi livelli di difficoltà\r\n- Una storia speciale di Jeanne\r\n- Un menu per i costumi",
  "CORE_HTDMMESS_0028_002_H28": "Comunque, facciamo chiarezza:\r\nio non è che amo il dolore, eh?\r\nNon sono mica masochista...",
  "CORE_NPC_TXT_10": "Cambia i costumi\r\ndi Cereza and Cheshire.",
  "TEST_WISP_TALK_06": "Tutti i miei amici sono stati catturati...\r\nNessuno ha mai fatto ritorno.",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "Catene maledette (sfida)",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "Successo (sfida)",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "La burla",
  "CORE_SNPSS_3050": "Cereza e Cheshire scoprono\r\nche l'ultimo nucleo si trova\r\nnella fortezza di Púca. Per\r\nil suo bene, ma anche per\r\nquello di Lukaon, Cereza\r\ndecide di avventurarsi\r\nall'interno.",
  "CORE_SNPSS_1060": "Per mezzo di un incantesimo,\r\nMorgana si mette in contatto\r\ncon Cereza e le dice che ci\r\nvorrà tempo prima che possa\r\nuscire dalla foresta. Cereza\r\ndecide di andare nuovamente\r\nalla ricerca del lupo bianco.",
  "CORE_WISP_TALK_26_H12": "Sono... libero? Ho paura, ma...\r\nDevo essere forte!",
  "CORE_HTDMMESS_0032_002_H32": "Stavo cercando qualcosa per Colm...\r\ne ho finito per perdermi.",
  "TA_COM010_0010_CER": "Mmmmmh...",
  "AC_CEREZA045_0010": "Scappi, tanto per cambiare?\r\nNon mi sorprende affatto...",
  "CORE_HTDMMESS_0037_003_H37": "Gr... azie... Uh, che odore penetrante...\r\nSarà meglio che ritorni al rifugio prima\r\nche le fate mi scoprano.",
  "TA_COM010_0020_CER": "Mmmh...",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "Morte imminente (sfida)",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "Trasporto (sfida)",
  "CORE_CSRELEASE_CERESSA_TXT_05": "Requisiti per lo sblocco: raccogli\r\nabbastanza ricordi e...",
  "TEST_WISP_TALK_02": "Seguimi! Ti aprirò il portone...",
  "CORE_SNPSS_4040": "Dopo aver sconfitto Púca,\r\nil sedicente re delle fate,\r\ne l'angelo da lui evocato,\r\nCereza e Cheshire procedono\r\nverso l'ultimo nucleo\r\nelementale.",
  "CORE_MISSION_TEXT_0006": "Sbrigati! Più tempo passa e\r\npeggiore sarà il tuo livello.",
  "CORE_COSTUME_CHESHIRE_TXT_02": "Il demone maledice la principessa\r\ne la sua ricerca del vero amore...\r\nCheshire non capisce queste cose.",
  "CORE_HTDMQUEST_TXT_0008": "Voglio diventare più forte. Tu sei\r\nuna strega... Non mi puoi aiutare?",
  "CORE_SNPSS_2070": "I due vanno a caccia del\r\nterzo nucleo elementale,\r\nche si dice giaccia in fondo\r\nal Lago Nimueh. Per riuscire\r\na prosciugarlo, Cereza deve\r\nsalire in cima all'albero più\r\nalto della foresta.",
  "CORE_HTDMMESS_0015_001_H15": "Questa foresta è uno scrigno pieno di\r\nmeraviglie, credimi. Se dovessi trovare\r\nqualche pianta speciale, fammelo sapere!",
  "CORE_HTDMQUEST_TXT_0013": "Vorrei qualcosa che mi elevi...\r\na un altro piano dell'esistenza.\r\nMi aiuti, per favore?",
  "CORE_COSTUME_CERESSA_TXT_02": "Una ballerina che, danzando, narra\r\nla storia di una principessa\r\ncondannata a mutare in cigno.",
  "AC_IGNIS020_0010": "La Foresta di Avalon è pericolosa...\r\nConoscere dei passaggi segreti\r\nè sempre utile.",
  "CORE_HTDMMESS_0008_003_H08": "Ciò mi renderà più forte? Puah, che\r\npuzza! Beh, tornerò al rifugio e lo\r\nproverò... Grazie!",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "Resa dei conti",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "Rotazione",
  "CORE_DIALOG_TXT_130": "Stai per affrontare la fine di\r\nquesta storia. Vuoi proseguire?",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "Guida",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "Luce inquietante",
  "AC_CEREZA135_0010": "Io... Io...!",
  "AC_NARRATION220_0020": "Sulla sommità, si apriva un enorme\r\nsquarcio, simile a una bocca ghignante.\r\nCosa mai stavano tramando le fate?",
  "CORE_COSTUME_CERESSA_TXT_06": "Dopo un sonno di 500 anni,\r\nla prigioniera del fato decide di\r\nprendere in mano il suo destino.",
  "CORE_DIALOG_TXT_030": "Vuoi ricominciare il livello?\r\nPotrai conservare gli oggetti\r\nche hai ottenuto finora.",
  "CORE_HTDMQUEST_TXT_0004": "Avere sempre paura è così brutto.\r\nSe potessi nascondermi per sempre...",
  "CORE_HTDMQUEST_TXT_0017": "I bei pesci si catturano solo\r\ncon una buona esca! Me ne\r\ntroveresti una?",
  "CORE_BAND_CHESHIRE_TXT_03": "Un errore di cui pentirsi",
  "CORE_CSRELEASE_CERESSA_TXT_09": "Requisiti per lo sblocco: completa\r\ntutte le imprese di Jeanne e...",
  "CORE_HTDMMESS_0017_002_H17": "Da queste parti i pesci sono belli in\r\ncarne, ma hanno pure gusti particolari.\r\nSe non faccio attenzione, sarò io l'esca!",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "Veemenza",
  "CORE_DIALOG_TXT_118": "Hai ricevuto il costume\r\n\"Cappellaio matto\".",
  "CORE_SNPSS_1040": "Cereza e Cheshire trovano\r\nil lupo bianco, che tuttavia\r\nfugge subito. Si rimettono\r\ndunque alla sua ricerca,\r\nspingendosi sempre più\r\ndentro la foresta.",
  "AC_NARRATION200_0010": "Cereza avvertì un fresco e penetrante\r\naroma provenire dagli alberi.",
  "CORE_HTDMMESS_0017_003_H17": "Grazie, streghetta! Ora, sotto con la pes-\r\nUn momento... Ho dimenticato la canna!",
  "CORE_DIALOG_TXT_156": "Se hai difficoltà a superare le\r\nbattaglie, puoi cambiare le\r\nimpostazioni relative alla forza\r\ndel nemico o ai danni subiti.",
  "AC_NARRATION255_0010": "Cereza e Cheshire giunsero a uno\r\nstagno disseminato di un numero\r\ninfinito di ninfee.",
  "CORE_ARCHIVE_TXT_01": "I personaggi di questa storia.",
  "CORE_DIALOG_TXT_152": "Cambia il tipo di comandi usati\r\nper le combo legaccio e \"Gnam!\".\r\nScegli tra \"Tieni premuto/Rilascia\"\r\noppure \"Premi\" per eseguirle.",
  "LV_009911_0010_NAR": "Pare che Cheshire non voglia muoversi.\r\nSembra voler dire: \"Perché non lo fai tu?\"",
  "CORE_ARCHIVE_TXT_05": "Gli spiritelli aiutati ad Avalon.",
  "CORE_SNPSS_4060": "Cereza e Cheshire sono\r\nfinalmente riusciti a\r\ndistruggere tutti e quattro\r\ni nuclei elementali.\r\nGuidati dal lupo bianco,\r\nsi mettono in marcia per\r\nincontrarsi con Lukaon.",
  "CORE_HTDMQUEST_TXT_0028": "Dolore... Ho bisogno di dolore!\r\nTu, lì! Dammi il dolore che mi\r\nserve!",
  "CORE_WISP_TALK_38_H24": "(Cereza tende l'orecchio per ascoltare,\r\nma sente soltanto dei rumori...)",
  "CORE_HTDMMESS_0008_002_H08": "Sono un cacciatore, quindi è logico che\r\ndebba essere io a sparare frecce... e non\r\na farmi colpire!",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "Requisiti per lo sblocco: trova\r\nabbastanza pagine del diario e...",
  "CORE_DIALOG_TXT_114": "Hai ricevuto il costume\r\n\"Giorni di gioventù\".",
  "CORE_WISP_TALK_45_H31": "Grazie dell'aiuto. A proposito... Sai\r\nmica se le mie piante stanno bene?",
  "CORE_HTDMMESS_0037_002_H37": "Il lavoro mi ossessiona, e Avalon è\r\nuna foresta paurosa. A volte bisogna\r\ndistrarsi un po', mi spiego?",
  "CORE_HAIR_CERESSA_TXT_01": "Predefinita",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "Compressione",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "Luce travolgente",
  "CORE_WISP_TALK_52_H38": "Finalmente i rinforzi... Meno male che ho\r\ntenuto duro. E adesso, si torna finalmente\r\nalla vita di tutti i giorni...",
  "CORE_SNPSS_2050": "Dopo aver collaborato per\r\nsconfiggere Amadán Dubh,\r\nil direttore del circo,\r\nCereza e Cheshire ispezionano\r\nil tendone alla ricerca di\r\nuno dei nuclei elementali.",
  "TA_COM035_0020_CER": "Come?!",
  "AC_IGNIS010_0010": "Come va? Stavo proprio\r\nper cominciare la mia visita\r\nguidata ai passaggi segreti!",
  "CORE_POSEMENU_TXT_00": "Muovi il cursore per selezionare.",
  "CORE_HTDMQUEST_TXT_0037": "Ho bisogno di una ventata di\r\nnovità nella mia vita. Magari\r\nprovare un nuovo aroma...",
  "CORE_POSEMENU_TXT_04": "Carica una partita salvata.",
  "AC_NARRATION210_0020": "La sua disordinata architettura\r\nera lo specchio del caos che\r\nregnava nel cuore delle fate.",
  "TEST_GIMMICK_TALK_01": "Quest'altalena sembra essere\r\nfatta apposta per uno spiritello.",
  "CORE_WISP_TALK_41_H27": "Ho avuto una visione in cui tu mi salvavi.\r\nChe il nostro incontro sia un segno del\r\ndestino?",
  "TA_9012_0010_COL": "Abbi cura di te là fuori!",
  "CORE_HTDMMESS_0028_003_H28": "Grandioso, era proprio quello che mi\r\nserviva! Ora nulla potrà nuocermi...\r\nCi vediamo al rifugio!",
  "TA_COM035_0010_CER": "Eh?",
  "AC_CEREZA150_0010": "Non è vero! Stai zitta!",
  "AC_CEREZA060_0040": "Sbrigati, non abbiamo tutto il giorno!",
  "AC_NARRATION245_0020": "Cereza ricordò di aver sentito che, molto\r\ntempo fa, in questo luogo risiedeva una\r\nregina delle fate.",
  "CORE_DIALOG_TXT_103": "Vuoi cambiare\r\nil costume di Cheshire?",
  "CORE_HTDMMESS_0032_003_H32": "Oh, grazie mille! Colm l'adorerà!\r\nOra però me ne torno subito\r\nal rifugio!",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "Accelerazione",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "Schermaglia",
  "CORE_DIALOG_TXT_010": "Non è possibile selezionare\r\nil luogo attuale.",
  "CORE_DIALOG_TXT_117": "Hai ricevuto il costume\r\n\"Maledizione d'amore\".",
  "CORE_DIALOG_TXT_104": "Vuoi aprire il menu dei costumi?",
  "CORE_HAIR_CERESSA_TXT_02": "Trecce d'apprendista",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "Brodo primordiale",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "Liberazione",
  "CORE_HTDMQUEST_TXT_0023": "Ho... tanta fame. Dammi\r\nqualcosa di buono da\r\nmangiare... ti prego...",
  "AC_CEREZA055_0010": "Non sei altro che una piagnona.\r\nVai a piangere in qualche angolino!",
  "CORE_POSEMENU_TXT_03": "Torna allo schermo del titolo.",
  "TEST_WISP_TALK_11_H00": "Mi dispiace... Per aprire il portone\r\nmi servono altri due amici.",
  "CORE_SNPSS_2040": "Gli spiritelli portano Cereza\r\ne Cheshire nel loro rifugio\r\nsegreto. Qui, ne approfittano\r\nper riposarsi e poi si recano\r\nnuovamente nella foresta per\r\ncercare i nuclei elementali\r\nrimasti.",
  "CORE_SVSLT_TXT_03": "Seleziona un file da cancellare.",
  "CORE_HTDMMESS_0006_003_H06": "Urrà! Questo sì che ha la punta\r\naffilata. Sarà un ago perfetto!",
  "TA_COM005_0010_CER": "Ehi, Cheshire...",
  "CORE_WH_TALK_15_COL": "Grazie per aver salvato i nostri amici!\r\nEcco una piccola ricompensa\r\nda parte di tutti noi!",
  "CORE_HTDMMESS_0034_003_H34": "Grazie! Adesso torno al rifugio, ma\r\nquando mi sentirò meglio, ti canterò\r\nqualcosa di bello per ringraziarti!",
  "CORE_WISP_TALK_50_H36": "Quelle fate sono terribili!\r\nQuasi mi tagliavano la testa!",
  "CORE_HTDMQUEST_TXT_0034": "Urgh... Ho la gola in fiamme.\r\nHai mica qualche medicinale\r\nda darmi?",
  "CORE_POSEMENU_TXT_07": "Seleziona un file di salvataggio.",
  "AC_NARRATION220_0010": "L'enorme fortezza delle fate si stagliava\r\ncome un'oscura minaccia tra le ombre\r\ndella foresta.",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "Requisiti per lo sblocco: completa\r\ntutte le imprese di Jeanne e...",
  "CORE_WISP_TALK_60_FAS": "Perché una volta non fai un salto\r\nal rifugio? Gli spiritelli sarebbero\r\nraggianti all'idea di vederti.",
  "CORE_HTDMMESS_0029_001_H29": "Che stanchezza... Ogni cosa è una fatica\r\nimmane. Hai per caso qualche medicina?\r\nBasta che agisca in fretta, però!",
  "AC_CEREZA060_0050": "Non è nemmeno capace di controllare\r\ngli elementi... Patetico.",
  "CORE_DIALOG_TXT_113": "Hai ricevuto il costume\r\n\"Demone molesto\".",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "Evasione",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "Protezione",
  "CORE_HTDMMESS_0023_003_H23": "Evviva, del vero cibo! Grazie mille!\r\nAvevo così tanta fame che stavo\r\nquasi per assaggiare te...",
  "CORE_SNPSS_1050": "Il ragazzo del sogno chiede\r\na Cereza di distruggere i\r\nquattro nuclei elementali\r\nnascosti da qualche parte\r\nnella foresta. Con questo\r\nnuovo obiettivo, lei e Cheshire\r\nriprendono la ricerca del\r\nlupo bianco.",
  "CORE_WH_TALK_06_COL": "Tutti gli altri spiritelli si danno un gran\r\ndaffare... Dovrei davvero mettercela\r\ntutta anch'io.",
  "CORE_DIALOG_TXT_008": "Verranno caricati i dati di\r\nquesto slot e perderai ogni\r\nprogresso non salvato.\r\nVuoi continuare?",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "Rotazione (sfida)",
  "CORE_WISP_TALK_66_FAS": "La tua prossima destinazione è un po'\r\nfuori mano. Guarda, ti faccio vedere.",
  "CORE_WH_TALK_09_COL": "Regola numero 1 del rifugio:\r\nNon mischiare lavoro e divertimento.\r\nÈ la sola regola che abbiamo!",
  "CORE_DIALOG_TXT_155": "Se cambi idea, puoi modificare\r\nle impostazioni di aiuto\r\nin qualsiasi momento\r\nnel menu Opzioni.",
  "CORE_ARCHIVE_TXT_02": "I nemici di Cereza.",
  "CORE_HTDMMESS_0039_003_H39": "Grazie, signora strega! Ho anche\r\ntrovato del cibo, quindi credo che\r\nper me sia ora di tornare a casa.",
  "AC_NARRATION230_0020": "Era il simbolo dei re delle fate\r\ndi Avalon da generazioni.",
  "CORE_WISP_TALK_69_FAS": "Il lupo bianco sembra essere vicino.\r\nVedi forse qualche sua impronta?",
  "CORE_WH_TALK_13_COL": "Avete visto com'è migliorato il rifugio?\r\nAbbiamo ancora più spazi per giocare,\r\nadesso!",
  "CORE_SNPSS_6040": "L'avventura nella Foresta di\r\nAvalon ha dato modo a Cereza\r\ndi crescere molto. Con il\r\nricordo dei suoi amici nel\r\ncuore, decide di partire\r\nper un nuovo viaggio.",
  "CORE_DIALOG_TXT_151": "Di solito, gli attacchi speciali di\r\nCheshire consumano magia, ma se vuoi\r\ngiocare in modo più rilassato, scegli\r\n\"Sempre piena\" per non esaurirla mai.",
  "CORE_WH_TALK_23_COL": "Voi due siete i nostri eroi! Tornate\r\npure quando volete, sarete sempre\r\naccolti a braccia aperte!",
  "CORE_WISP_TALK_59_FAS": "Ho sentito che Colm desidera vederti.\r\nPare ti debba dire qualcosa.",
  "CORE_WISP_TALK_47_H33": "Finalmente in salvo... e lo devo a te, dico\r\nbene? Uff, ma perché quelle fate non ci\r\nlasciano in pace?",
  "CORE_WISP_TALK_56_FAS": "Il nucleo successivo si trova in fondo\r\nal lago e per arrivarci devi salire in\r\ncima a un albero altissimo.",
  "CORE_HTDMMESS_0026_002_H26": "Perché le fate devono essere così\r\ncattive? Non sarebbe meglio vivere\r\ntutti in pace e armonia?"
}
