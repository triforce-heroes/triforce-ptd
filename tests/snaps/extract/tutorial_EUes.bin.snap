{
  "TUT_TUTORIAL_TEXT_ph048": "Recoger",
  "TUT_TUTORIAL_TEXT_ph015": "Salto de espiga",
  "TUT_TUTORIAL_TEXT_ph006": "Coger",
  "TUT_TUTORIAL_TEXT_w282": "En los modos contrarreloj,\r\nrecibes recompensas en\r\nfunción de tu rendimiento.\r\n¡Intenta conseguirlas todas!",
  "TUT_TUTORIAL_TEXT_ph011": "Mover a Cereza",
  "TUT_TUTORIAL_TEXT_ph002": "Saltar",
  "TUT_TUTORIAL_TEXT_w165": "Dentro de la distorsión, usa\r\nla magia con [BTN:L2 ] para disipar\r\nla ilusión que envuelve a las\r\nhadas y así poder atacarlas.",
  "TUT_TUTORIAL_TEXT_w561": "Cuando Colm tenga algo que\r\ndecirte, aparecerá la señal del\r\nfuego fatuo en el mapa. Será\r\nun buen momento para visitarlo.",
  "TUT_TUTORIAL_TEXT_g001": "Se ha desbloqueado el menú de atuendos.",
  "TUT_TUTORIAL_TEXT_ch029": "Deslizarse",
  "TUT_TUTORIAL_TEXT_w461": "Pulsa [BTN:R1 ] en el momento adecuado\r\npara que Cheshire pueda\r\ncontratacar al recibir un impacto.",
  "TUT_TUTORIAL_TEXT_ph044": "(Mantener/Soltar) Multibrida",
  "TUT_TUTORIAL_TEXT_w330": "¡Has destruido el núcleo elemental\r\nde piedra y recibido su poder!\r\nPulsa [BTN:B ] para que Cheshire\r\npase a su forma pétrea.",
  "TUT_TUTORIAL_TEXT_w323": "Las técnicas elementales\r\nconsumen magia. Fíjate en el\r\nindicador de Cheshire y cambia\r\nal modo abrazo para recuperarla.",
  "TUT_TUTORIAL_TEXT_ch021": "Revertir",
  "TUT_TUTORIAL_TEXT_ch032": "Esquivar",
  "TUT_TUTORIAL_TEXT_w030": "Los pétalos de la parte inferior de\r\nla pantalla representan la vitalidad\r\nde Cereza. Disminuyen cuando\r\nla ataca el enemigo.",
  "TUT_TUTORIAL_TEXT_w023": "Es el Pulso Brujo más avanzado.\r\nCuando veas un círculo doble,\r\ninclina dos veces [BTN:LS ] rápidamente\r\ny en la dirección correcta.",
  "TUT_TUTORIAL_TEXT_w130": "Alguien parece haber soltado por\r\nel bosque las páginas de un diario.\r\nSi encuentras una, recógela con [BTN:L1 ]\r\npara leerla luego en el archivo.",
  "TUT_TUTORIAL_TEXT_ph019": "Absorber energía ígnea",
  "TUT_TUTORIAL_TEXT_d002": "Elige qué santuario quieres visitar.",
  "TUT_TUTORIAL_TEXT_w430": "Interactúa con una fuente\r\nde energía acuática para\r\nabsorber su poder y cambiar\r\nel nivel de agua de la zona.",
  "TUT_TUTORIAL_TEXT_ch025": "Contrataque",
  "TUT_TUTORIAL_TEXT_w630": "Ahora Cheshire puede\r\nhacer embestidas con [BTN:R2 ]\r\npara acabar con enemigos\r\ndebilitados.",
  "TUT_TUTORIAL_TEXT_ph040": "Aprender técnica",
  "TUT_TUTORIAL_TEXT_w730": "Al montar en Cheshire y\r\nestabilizarlo con su energía\r\nmágica, Cereza puede hacer\r\nuso de su poder demoniaco.",
  "TUT_TUTORIAL_TEXT_ch022": "Revertir",
  "TUT_TUTORIAL_TEXT_ch031": "(Mantener/Soltar) Combo de bridas",
  "TUT_TUTORIAL_TEXT_ph047": "(Mover dos veces) Pulso Brujo",
  "TUT_TUTORIAL_TEXT_w333": "El pisotón de Cheshire pétreo\r\npuede descubrir a enemigos\r\nque se encuentren bajo tierra\r\ny aturdir a los que estén cerca.",
  "TUT_TUTORIAL_TEXT_w320": "¡Has destruido el núcleo elemental\r\nde vegetación y recibido su poder!\r\nPulsa [BTN:Y ] para que Cheshire\r\npase a su forma vegetal.",
  "TUT_TUTORIAL_TEXT_w120": "Los arcos grandes y rojos son santuarios\r\nque se desbloquean al aproximarse a ellos.\r\nAcércate siempre que veas uno.",
  "TUT_TUTORIAL_TEXT_ph009": "(Mantener) Bailar",
  "TUT_TUTORIAL_TEXT_w020": "Cereza puede usar el Pulso Brujo\r\npara hacer crecer plantas infernales.\r\nMantén pulsado [BTN:L2 ] y mueve [BTN:LS ] en la dirección\r\ncorrecta en el momento adecuado.",
  "TUT_TUTORIAL_TEXT_d001": "Ignis guía a Cereza hacia santuarios.",
  "TUT_TUTORIAL_TEXT_w024": "El Pulso Brujo es un Arte de\r\nUmbra fundamental, y en él\r\nse emplea el baile para imbuir\r\na un sujeto de energía mágica.",
  "TUT_TUTORIAL_TEXT_w420": "No hay río ni lago que se resista\r\na Cheshire acuático, ya que\r\nnada con gran agilidad\r\nusando [BTN:RS ].",
  "TUT_TUTORIAL_TEXT_ph050": "(Mantener) Atrapar siguiente enemigo",
  "TUT_TUTORIAL_TEXT_ph043": "(Mantener) Brida espinosa",
  "TUT_TUTORIAL_TEXT_w720": "En el modo contrarreloj, tú\r\neres el rival: compite por\r\nsuperar tu mejor tiempo.",
  "TUT_TUTORIAL_TEXT_ch026": "(Mantener) Tirar",
  "TUT_TUTORIAL_TEXT_w171": "Destruye el núcleo que está\r\nen el corazón del tír na nÓg.\r\nAbre el menú con [BTN:START ] si necesitas\r\nretirarte temporalmente.",
  "TUT_TUTORIAL_TEXT_ph016": "Absorber energía vegetal",
  "TUT_TUTORIAL_TEXT_ph005": "Subir/Bajar escalera",
  "TUT_TUTORIAL_TEXT_ph012": "(Mantener) Brida espinosa",
  "TUT_TUTORIAL_TEXT_ph001": "(Cerca de salientes) Saltar",
  "TUT_TUTORIAL_TEXT_w281": "También puedes enfrentarte\r\nal modo contrarreloj de los\r\ntír na nÓg e intentar conseguir\r\nel mejor tiempo.",
  "TUT_TUTORIAL_TEXT_w081": "Cuando vayan los dos juntos,\r\npuedes mover a Cereza con [BTN:LS ]\r\ny extender a Cheshire con [BTN:RS ].",
  "TUT_TUTORIAL_TEXT_w462": "Los enemigos que sufren un\r\ncontrataque quedan aturdidos\r\ntemporalmente, pero no es posible\r\ncontrarrestar todos los ataques.",
  "TUT_TUTORIAL_TEXT_w100": "Puedes cambiar entre el modo\r\nde movimiento conjunto o independiente\r\nen todo momento. En función de la\r\nsituación, te convendrá usar uno u otro.",
  "TUT_TUTORIAL_TEXT_ph029": "Destruir núcleo",
  "TUT_TUTORIAL_TEXT_w000": "Cereza puede interactuar\r\ncon varios objetos con [BTN:L1 ].\r\n¡Usa [BTN:L1 ] cuando algo\r\nte llame la atención!",
  "TUT_TUTORIAL_TEXT_e009": "¡y ponte manos a la obra!",
  "TUT_TUTORIAL_TEXT_ch011": "Nadar",
  "TUT_TUTORIAL_TEXT_ch002": "(Inclinar hacia un saliente) Saltar",
  "TUT_TUTORIAL_TEXT_w300": "Elige un archivo de guardado.\r\nEl guardado automático tiene\r\nun archivo dedicado; puedes usar\r\nlos otros según te convenga.",
  "TUT_TUTORIAL_TEXT_w700": "Mantén pulsado y suelta [BTN:R2 ]\r\ncerca de un enemigo atrapado\r\npara ejecutar un potente combo.\r\n¡No olvides usarlo!",
  "TUT_TUTORIAL_TEXT_ch015": "Pisotón",
  "TUT_TUTORIAL_TEXT_ch006": "Mover a Cheshire",
  "TUT_TUTORIAL_TEXT_w400": "Para vencer a Morgana, esquiva\r\ncon [BTN:L1 ] en el momento justo para\r\nusar el Tiempo Brujo y moverte\r\nrapidísimo unos instantes.",
  "TUT_TUTORIAL_TEXT_b002": "Cheshire necesita\r\ngotas de Ávalon.",
  "TUT_TUTORIAL_TEXT_ph025": "Transformar (fuego)",
  "TUT_TUTORIAL_TEXT_ph036": "Absorber energía acuática",
  "TUT_TUTORIAL_TEXT_w351": "En su forma ígnea, Cheshire\r\npuede disparar con [BTN:R1 ]\r\nun piroestallido capaz de\r\nabrasar o derretir cuanto toque.",
  "TUT_TUTORIAL_TEXT_e005": "Aquí hay varios ingredientes.\r\nEn el bosque encontrarás más.",
  "TUT_TUTORIAL_TEXT_w051": "No pueden mantenerse alejados\r\ndurante demasiado tiempo: tenlo\r\nen cuenta y vigila la distancia que\r\nlos separa en todo momento.",
  "TUT_TUTORIAL_TEXT_ch019": "Transformar (fuego)",
  "TUT_TUTORIAL_TEXT_e012": "Mantén pulsado [BTN:DP ] para usar los objetos.",
  "TUT_TUTORIAL_TEXT_e001": "Ahora puedes preparar pócimas.",
  "TUT_TUTORIAL_TEXT_ph032": "Modo desatado",
  "TUT_TUTORIAL_TEXT_w900": "Jeanne también puede usar bridas\r\nespinosas con [BTN:L2 ]. Cubre una\r\nenorme área que permite atrapar\r\na muchos rivales a la vez.",
  "TUT_TUTORIAL_TEXT_w751": "Algunas frutas infernales\r\nestán marcadas en el mapa,\r\ny otras se revelarán\r\nal superar los tír na nÓg.",
  "TUT_TUTORIAL_TEXT_w651": "Al usar bridas espinosas\r\nen sucesión, Cereza puede\r\natrapar a dos enemigos\r\na la vez.",
  "TUT_TUTORIAL_TEXT_b006": "Cereza necesita\r\nrosas de ónix.",
  "TUT_TUTORIAL_TEXT_ph026": "(Mantener) Cepo espinoso",
  "TUT_TUTORIAL_TEXT_ph035": "Lanzar fuego fatuo",
  "TUT_TUTORIAL_TEXT_b001": "Las técnicas de Cheshire\r\nestán a la derecha.",
  "TUT_TUTORIAL_TEXT_e006": "Esto es un objeto que puedes\r\npreparar tras encontrarlo.",
  "TUT_TUTORIAL_TEXT_w141": "Algunos de los fuegos fatuos\r\nse encuentran en apuros. Si les\r\nayudas a resolver sus problemas,\r\npodría sucederte algo bueno.",
  "TUT_TUTORIAL_TEXT_w441": "Cada tipo de barrera tiene\r\nun punto débil. Las barreras\r\nde piedra deberían caer ante\r\nun buen golpe.",
  "TUT_TUTORIAL_TEXT_e011": "¡Ha funcionado!",
  "TUT_TUTORIAL_TEXT_e002": "Selecciona «Preparar\r\npócima» en el menú.",
  "TUT_TUTORIAL_TEXT_b005": "Las técnicas de Cereza\r\nestán a la izquierda.",
  "TUT_TUTORIAL_TEXT_ph022": "Transformar (vegetación)",
  "TUT_TUTORIAL_TEXT_ph031": "Extender a Cheshire",
  "TUT_TUTORIAL_TEXT_w910": "Necesita un gran tiempo\r\nde recuperación, pero, si se usa\r\ncontra un gran grupo de enemigos,\r\npuede tener efectos devastadores.",
  "TUT_TUTORIAL_TEXT_w752": "Los objetos que Cereza puede\r\nusar para aprender técnicas\r\nestán ocultos por el bosque.\r\n¡Consulta el mapa y encuéntralos!",
  "TUT_TUTORIAL_TEXT_w010": "Durante el viaje, usa [BTN:L1 ] junto\r\na los faroles para guardar\r\nel progreso.",
  "TUT_TUTORIAL_TEXT_ph039": "Disipar ilusión",
  "TUT_TUTORIAL_TEXT_w310": "Pulsa [BTN:L1 ] para absorber\r\ncon el brazalete mágico el poder\r\nelemental que encuentres en el\r\nbosque.",
  "TUT_TUTORIAL_TEXT_ch012": "Torrente acuático",
  "TUT_TUTORIAL_TEXT_ch001": "Atacar",
  "TUT_TUTORIAL_TEXT_ch016": "Transformar (vegetación)",
  "TUT_TUTORIAL_TEXT_ch005": "Zarpazo",
  "TUT_TUTORIAL_TEXT_w710": "Usa objetos con [BTN:DP ].\r\nPueden llegar a cambiar el curso\r\nde un combate, ¡así que gástalos\r\nsin reparos!",
  "TUT_TUTORIAL_TEXT_w510": "Intenta guiar a los fuegos fatuos\r\npor el tír na nÓg, pero ten\r\nen cuenta que, si reciben\r\nun ataque, los pierdes.",
  "TUT_TUTORIAL_TEXT_f001": "Se ha desbloqueado el menú de tír na nÓg.",
  "TUT_TUTORIAL_TEXT_w410": "Tras ciertos ataques de tus rivales,\r\naparecerá una señal encima de sus\r\ncabezas: usa entonces [BTN:L2 ] para\r\nejecutar una brida más potente.",
  "TUT_TUTORIAL_TEXT_ph023": "Transformar (piedra)",
  "TUT_TUTORIAL_TEXT_ph030": "Mover a Cereza",
  "TUT_TUTORIAL_TEXT_w740": "Cereza aún no tiene el poder\r\nnecesario para derrotar a un rival\r\nella sola. Usa Artes de Umbra\r\npara atrapar enemigos y avanzar.",
  "TUT_TUTORIAL_TEXT_w640": "Una vez que Cereza haya atrapado\r\na un enemigo, mantén pulsado y\r\nsuelta [BTN:R2 ] para que Cheshire\r\nlo embista y ejecute un combo.",
  "TUT_TUTORIAL_TEXT_b004": "Mantén pulsado el botón\r\npara aprender la técnica.",
  "TUT_TUTORIAL_TEXT_w440": "Algunas hadas se protegen\r\nmediante barreras elementales.\r\nEn estos casos, la mayor parte\r\nde los ataques no funcionará.",
  "TUT_TUTORIAL_TEXT_ch008": "(Mantener) Tirar",
  "TUT_TUTORIAL_TEXT_e010": "Tras añadir los ingredientes,\r\nmézclalo todo bien.",
  "TUT_TUTORIAL_TEXT_e003": "¡Prepara un objeto!",
  "TUT_TUTORIAL_TEXT_w140": "Hay fuegos fatuos atrapados por\r\nlas hadas en todo Ávalon. Cuando\r\nencuentres uno, pulsa [BTN:L1 ]\r\npara salvarlo.",
  "TUT_TUTORIAL_TEXT_w040": "Las afiladas zarpas y los colmillos\r\ndel demonio se encargan de las\r\nhadas fácilmente. ¡Araña con [BTN:R2 ]\r\ny demuestra tu ferocidad infernal!",
  "TUT_TUTORIAL_TEXT_e007": "Empecemos con una pócima curativa.",
  "TUT_TUTORIAL_TEXT_b000": "Aquí puedes aprender técnicas.",
  "TUT_TUTORIAL_TEXT_ph027": "(Mantener) Bailar",
  "TUT_TUTORIAL_TEXT_ph034": "Coger fuego fatuo",
  "TUT_TUTORIAL_TEXT_w340": "¡Has destruido el núcleo elemental\r\nde agua y recibido su poder!\r\nPulsa [BTN:X ] para que Cheshire\r\npase a su forma acuática.",
  "TUT_TUTORIAL_TEXT_w411": "El cepo espinoso mantiene\r\natrapados a los enemigos\r\ndurante más tiempo, y hace\r\nque sufran más daño. ¡Pruébalo!",
  "TUT_TUTORIAL_TEXT_w511": "Los fuegos fatuos son\r\nmuy débiles y no pueden\r\nsobrevivir a ningún ataque.\r\n¡Mantenlos a salvo!",
  "TUT_TUTORIAL_TEXT_ch017": "Transformar (piedra)",
  "TUT_TUTORIAL_TEXT_ch004": "Contrataque",
  "TUT_TUTORIAL_TEXT_ch013": "Torrente acuático",
  "TUT_TUTORIAL_TEXT_ch000": "Moverse",
  "TUT_TUTORIAL_TEXT_w311": "Cuando hayas absorbido\r\nsuficiente energía, la barra\r\nde magia aumentará.",
  "TUT_TUTORIAL_TEXT_w102": "En el modo abrazo, se mueven los\r\ndos juntos. Pulsa [BTN:L1 ] para devolver\r\na Cheshire a su forma de muñeco.",
  "TUT_TUTORIAL_TEXT_ph038": "Destruir núcleo elemental",
  "TUT_TUTORIAL_TEXT_w011": "La partida se guarda de forma\r\nautomática en ciertos momentos.\r\nCuando ocurra, verás este icono en la\r\nparte inferior derecha de la pantalla.",
  "TUT_TUTORIAL_TEXT_ch014": "Piroestallido",
  "TUT_TUTORIAL_TEXT_ch007": "Zarpazo",
  "TUT_TUTORIAL_TEXT_e008": "Decide cuántas\r\nquieres preparar...",
  "TUT_TUTORIAL_TEXT_ch010": "Pisotón",
  "TUT_TUTORIAL_TEXT_ch003": "Saltar",
  "TUT_TUTORIAL_TEXT_w101": "En el modo desatado, los dos\r\nse mueven de manera independiente.\r\nPulsa [BTN:R1 ] cuando lleves a Cheshire\r\nen brazos para que salga de un salto.",
  "TUT_TUTORIAL_TEXT_ph028": "(Mover) Pulso Brujo",
  "TUT_TUTORIAL_TEXT_w650": "¡El indicador de recarga de\r\nartes ha aumentado y ahora\r\nCereza puede usar la brida\r\nespinosa dos veces seguidas!",
  "TUT_TUTORIAL_TEXT_b007": "¡Prueba diferentes técnicas!",
  "TUT_TUTORIAL_TEXT_ph020": "(Girar) Magia restauradora",
  "TUT_TUTORIAL_TEXT_ph033": "Modo abrazo",
  "TUT_TUTORIAL_TEXT_w750": "Devorar frutas infernales\r\nle permite a Cheshire aprender\r\nnuevas y poderosas técnicas.",
  "TUT_TUTORIAL_TEXT_w550": "Si te desorientas, busca\r\nlas luces guía, que indican\r\nel camino hacia un santuario\r\ncercano.",
  "TUT_TUTORIAL_TEXT_w450": "La barra de magia se rellena\r\ngradualmente en el modo abrazo.\r\nCambia a este modo cuando\r\nse esté agotando.",
  "TUT_TUTORIAL_TEXT_ch018": "Transformar (agua)",
  "TUT_TUTORIAL_TEXT_e013": "Comprueba qué puedes elaborar con [BTN:Y ].",
  "TUT_TUTORIAL_TEXT_e004": "Este es el menú de pócimas.",
  "TUT_TUTORIAL_TEXT_w050": "Cereza y Cheshire se pueden desplazar\r\nindependientemente. Mueve a Cereza\r\ncon [BTN:LS ] y a Cheshire con [BTN:RS ].",
  "TUT_TUTORIAL_TEXT_ph024": "Transformar (agua)",
  "TUT_TUTORIAL_TEXT_ph037": "Modo abrazo (recuperar magia)",
  "TUT_TUTORIAL_TEXT_w343": "Cheshire acuático puede usar el\r\ntorrente acuático con [BTN:R1 ]. Tiene\r\nlargo alcance y mucha potencia.\r\n¡Pruébalo en varias situaciones!",
  "TUT_TUTORIAL_TEXT_w350": "¡Has destruido el núcleo elemental\r\nde fuego y recibido su poder!\r\nPulsa [BTN:A ] para que Cheshire\r\npase a su forma ígnea.",
  "TUT_TUTORIAL_TEXT_b003": "Mueve el cursor a la técnica\r\nque quieras aprender...",
  "TUT_TUTORIAL_TEXT_ch027": "Mover a izquierda/derecha",
  "TUT_TUTORIAL_TEXT_ph042": "Esquivar",
  "TUT_TUTORIAL_TEXT_w732": "También puedes pulsar [BTN:A ], [BTN:B ],\r\n[BTN:X ] o [BTN:Y ] para utilizar potentes\r\nataques elementales.\r\n¡Aprovéchalos en combate!",
  "TUT_TUTORIAL_TEXT_w721": "El contador se pone en marcha al\r\ncruzar la línea verde o iniciar\r\nun combate. Tu premio dependerá\r\ndel tiempo transcurrido.",
  "TUT_TUTORIAL_TEXT_w325": "Pulsa [BTN:Y ] para devolver a Cheshire\r\na su forma básica. Recuerda\r\nque solo puede contratacar\r\nen esta forma.",
  "TUT_TUTORIAL_TEXT_w125": "Son las huellas del lobo blanco.\r\nSi las sigues, podrás continuar\r\navanzando. ¡Busca más en las\r\ncercanías!",
  "TUT_TUTORIAL_TEXT_w025": "Estas plantas infernales son\r\nmás grandes que las hierbas de\r\nMorgana. El Pulso Brujo requiere\r\nmás magia para que crezcan.",
  "TUT_TUTORIAL_TEXT_w421": "Cheshire solo puede nadar\r\nen su forma acuática. Si entra\r\nen el agua en otra forma, pasará\r\nautomáticamente a la acuática.",
  "TUT_TUTORIAL_TEXT_ph008": "(Mover) Pulso Brujo",
  "TUT_TUTORIAL_TEXT_ph046": "(Mover/Mantener) Pulso Brujo",
  "TUT_TUTORIAL_TEXT_w332": "Cheshire pétreo tiene una piel\r\nmuy dura capaz de repeler\r\ncasi todos los ataques,\r\naunque esto consume magia.",
  "TUT_TUTORIAL_TEXT_w321": "Puedes usar el ataque elemental\r\nde Cheshire vegetal con [BTN:R2 ]\r\ny aprovechar su potencia para\r\nobtener ventaja en el combate.",
  "TUT_TUTORIAL_TEXT_ch023": "Revertir",
  "TUT_TUTORIAL_TEXT_ch030": "(Mantener/Soltar) ¡Ñam!",
  "TUT_TUTORIAL_TEXT_w080": "Cuando Cheshire adopte la forma\r\nde animal de trapo, puedes llevarlo\r\nen brazos y moverte con él.",
  "TUT_TUTORIAL_TEXT_w670": "La huella del lobo en el mapa\r\nindica el lugar adonde Ignis\r\nte sugiere ir. Consúltalo cuando\r\nno sepas cómo avanzar.",
  "TUT_TUTORIAL_TEXT_w280": "Una vez completados, puedes\r\nvolver a enfrentarte a los tír na\r\nnÓg desde los santuarios para\r\nintentar encontrar más tesoros.",
  "TUT_TUTORIAL_TEXT_ph013": "Lanzar a Cheshire",
  "TUT_TUTORIAL_TEXT_ph000": "Moverse",
  "TUT_TUTORIAL_TEXT_ph017": "Absorber energía pétrea",
  "TUT_TUTORIAL_TEXT_ph004": "([BTN:L1 ] pulsado) Empujar/Tirar de cajas",
  "TUT_TUTORIAL_TEXT_w270": "Ignis puede guiar a Cereza\r\nhacia los santuarios del bosque.\r\nAl regresar a uno de ellos,\r\nquizás te lleves una sorpresa.",
  "TUT_TUTORIAL_TEXT_w680": "Cuando esté lejos o haya romero\r\nde por medio, Cheshire no podrá\r\nvolver al modo abrazo. Busca\r\nel modo de reunirlo con Cereza.",
  "TUT_TUTORIAL_TEXT_w480": "Cheshire pétreo puede dar\r\nfuertes pisotones encima de las\r\nsetas gigantes para saltar\r\nmuy alto.",
  "TUT_TUTORIAL_TEXT_w070": "Mantén pulsado [BTN:L2 ] para hacer\r\ncrecer enredaderas infernales que\r\natraparán al enemigo. Consume\r\nel indicador de recarga de artes.",
  "TUT_TUTORIAL_TEXT_w170": "Los tír na nÓg son el origen\r\nde las ilusiones feéricas y se\r\npueden encontrar en cualquier\r\nrincón del bosque.",
  "TUT_TUTORIAL_TEXT_w090": "En el modo abrazo puedes lanzar\r\na Cheshire hacia algunos lugares\r\naltos con [BTN:L1 ]. ¡No dejes nunca de buscar\r\nnuevas formas de seguir avanzando!",
  "TUT_TUTORIAL_TEXT_ch028": "Saltar",
  "TUT_TUTORIAL_TEXT_w460": "Cheshire usa zarpas y colmillos\r\npara aniquilar a sus enemigos,\r\ny también puede devolver\r\nsus ataques.",
  "TUT_TUTORIAL_TEXT_w560": "Cuando hayas ayudado a algunos\r\nfuegos fatuos, reúnete con Colm\r\nen el refugio; ¡quizás te aguarde\r\nuna sorpresa!",
  "TUT_TUTORIAL_TEXT_ph010": "(Mover) Pulso Brujo",
  "TUT_TUTORIAL_TEXT_ph003": "Sacar agua",
  "TUT_TUTORIAL_TEXT_w390": "Gira [BTN:LS ] mientras mantienes [BTN:L2 ]\r\ncerca de objetos rotos para usar\r\nmagia restauradora y devolverlos\r\nbrevemente a su estado original.",
  "TUT_TUTORIAL_TEXT_w660": "Algunos enemigos voladores son\r\nmuy débiles y puedes derrotarlos\r\ncon la brida espinosa.",
  "TUT_TUTORIAL_TEXT_w260": "Cuando te apetezca un cambio,\r\npuedes ir al menú de atuendos\r\ny modificar el aspecto de Cereza\r\ny Cheshire.",
  "TUT_TUTORIAL_TEXT_w690": "Haz que Cheshire embista contra\r\nlos pilares y luego cálmalo.\r\nUsa la magia restauradora\r\nsi los pilares se rompen.",
  "TUT_TUTORIAL_TEXT_ph014": "Extender a Cheshire",
  "TUT_TUTORIAL_TEXT_ph007": "(Mantener) Bailar",
  "TUT_TUTORIAL_TEXT_w160": "La distorsión creada por las hadas\r\nestá llena de ilusiones. Usa tu magia\r\ncon [BTN:L2 ] para disiparlas y revelar\r\nlo que ocultan.",
  "TUT_TUTORIAL_TEXT_ph049": "(Mantener) Atrapar primer enemigo",
  "TUT_TUTORIAL_TEXT_w490": "Los núcleos elementales\r\nde los santuarios pueden ser\r\ndestruidos con los ataques\r\nde Cheshire.",
  "TUT_TUTORIAL_TEXT_w060": "Como es un demonio, Cheshire no puede\r\nsoportar el romero. Cuando esta planta\r\naparezca, Cheshire tendrá que buscar\r\notro camino.",
  "TUT_TUTORIAL_TEXT_ph041": "(Mantener) Brida espinosa",
  "TUT_TUTORIAL_TEXT_w731": "Cheshire desatado puede\r\nesquivar con [BTN:L1 ] y ejecutar\r\nun potente ataque físico\r\ncon [BTN:R1 ].",
  "TUT_TUTORIAL_TEXT_w722": "Los relojes mejoran tu tiempo,\r\npero, si sufres daño, se te suman\r\nsegundos: ve con cuidado.",
  "TUT_TUTORIAL_TEXT_w326": "Pulsa [BTN:Y ] para volver a la forma\r\nde Cheshire vegetal. En la parte\r\ninferior derecha de la pantalla\r\npuedes ver el elemento actual.",
  "TUT_TUTORIAL_TEXT_ch024": "Revertir",
  "TUT_TUTORIAL_TEXT_d003": "Ignis te recomienda ir ahí.",
  "TUT_TUTORIAL_TEXT_w026": "Mantén pulsado [BTN:L2 ] hasta que\r\nel Pulso Brujo se haya ejecutado\r\ncon éxito varias veces seguidas.\r\n¡No lo sueltes antes de acabar!",
  "TUT_TUTORIAL_TEXT_ph018": "Absorber energía acuática",
  "TUT_TUTORIAL_TEXT_w031": "Si se agota la vitalidad de Cereza,\r\nse acabará la historia. No pierdas\r\nde vista la vitalidad restante\r\nen todo momento.",
  "TUT_TUTORIAL_TEXT_w022": "Prueba el Pulso Brujo avanzado:\r\ncuando Cereza baile, inclina\r\ny mantén [BTN:LS ] mientras el marcador\r\nse desplaza por la línea roja.",
  "TUT_TUTORIAL_TEXT_ch020": "Torrente acuático",
  "TUT_TUTORIAL_TEXT_ph045": "(Mantener) Brida espinosa",
  "TUT_TUTORIAL_TEXT_w331": "Cheshire pétreo puede dar\r\nun fuerte pisotón con [BTN:R1 ]\r\npara destrozar, levantar\r\no desenterrar ciertas cosas.",
  "TUT_TUTORIAL_TEXT_w322": "Cheshire vegetal también puede\r\nextender la lengua y agarrar\r\nobjetos con [BTN:R1 ]. Si lo mantienes\r\npulsado, puedes arrastrarlos."
}
