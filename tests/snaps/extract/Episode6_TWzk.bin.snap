{
  "SM_006010_0000_NAR": "他們終於抵達了。\r\n萊卡翁真的就在那裡。\r\n\r\n然而，他卻被關在水晶裡，\r\n臉色發青，簡直就像一具屍體。\r\n",
  "BK_8200_0080_NAR": "「如果沒有你，我應該早就死了。\r\n我很慶幸我們能相遇。\r\n謝謝你。」",
  "SM_006010_0250_LUC": "「我繼承了父親的血統，\r\n可以輕易逃出這座森林。\r\n我們一起離開森林，\r\n去見你的媽媽和我的母親吧！」",
  "PH_6010_0010_NAR": "摩根娜終於成功使出魔導術，\r\n把妖精的封印給解除了。\r\n",
  "SM_006010_0190_NAR": "後來邪惡的妖精\r\n為了阻止繼承王族血脈的萊卡翁復活，\r\n便將他的身體封印於此。\r\n",
  "BK_6040_0010_NAR": "看見這麼多妖精蜂擁而至，\r\n瑟蕾莎緊張地嚥了嚥口水。\r\n但她依舊沒有從萊卡翁身前移動半步。",
  "BK_6020_0130_NAR": "普卡被摩根娜的魔導術擊潰，\r\n接著便斷氣了。\r\n",
  "BK_6030_0090_LUC": "「母親……已經夠了……！\r\n這並不是我期望的……\r\n我不想看到這樣的母親……！」",
  "BK_6020_0020_CER": "「小柴貓……！」",
  "BK_6020_0100_NAR": "瑟蕾莎曾經看過這個大型魔法。\r\n",
  "BK_6020_0090_NAR": "妖精們被一股強大的力量打飛，\r\n像樹葉一樣在空中飛舞。",
  "CE_006805_0000_CER": "別認輸……\r\n別認輸，小柴貓！",
  "BK_8200_0030_CER": "「旅程……？」\r\n",
  "SM_006040_0120_MOR": "「原來如此……\r\n你對惡魔這等生物產生感情了？」",
  "SM_006010_0120_CER": "「妖、妖精！？」",
  "BK_6040_0020_NAR": "就在此時——",
  "SM_006030_0170_POO": "「愚蠢之徒！\r\n\r\n現在正是本王吞噬白獸之魂、\r\n讓王冠得到真正光芒之時！」",
  "SM_006010_0360_CER": "「那還用說嗎！\r\n小柴貓是我重要的朋友，\r\n我怎麼可能拿祂當活祭品！」",
  "CE_006060_0000_CER": "我全都看透了！",
  "BK_6000_0040_CER": "「不會吧……你想拿小柴貓當活祭品嗎？\r\n太過分了！快住手！」",
  "BK_6100_0000_CER": "「小柴貓！」",
  "SM_006030_0060_NAR": "是自稱妖精王的普卡。\r\n平時老是帶著手下的祂，\r\n卻反常地獨自現身了。\r\n\r\n雖然祂看起來傷痕累累，\r\n但還是不能大意。",
  "LV_006020_0000_CER": "加油小柴貓！還差一點！",
  "CE_006150_0000_CER": "啊……！",
  "BK_6030_0000_CER": "「摩根娜……\r\n我完全不是個好孩子。」",
  "BK_6000_0030_CER": "「萊卡翁！？你在做什麼！？」",
  "BK_6020_0210_CER": "「摩根娜……？」",
  "SM_006030_0130_CER": "「萊卡翁！」",
  "SM_006030_0090_POO": "「但是，得先把\r\n那個不祥的白獸之魂\r\n獻給偉大的本王！」",
  "CE_006050_0000_CER": "換我出招！",
  "SM_006020_0010_LUC": "「我的靈魂就快消失了……\r\n今天是能解除封印的最後機會……」",
  "SM_006010_0310_CER": "「咦！？」",
  "CE_006160_0000_CER": "唔！",
  "LV_006010_0000_CER": "攻過來了，交給我！",
  "SM_006010_0050_LUC": "「等一下，瑟蕾莎。\r\n那副軀體只是空殼……\r\n我在這裡。」",
  "SM_006010_0280_CER": "「什、什麼意思……？\r\n我、我是那麼厲害的魔女嗎？」",
  "SM_006010_0400_CER": "「所以，唯有那件事……\r\n唯有那件事我絕對辦不到！」",
  "BK_6020_0170_NAR": "摩根娜一句話也不回答，\r\n只是輕撫著狼的身體。",
  "SM_006020_0000_NAR": "萊卡翁的眼神\r\n已經沒有剛才那般險惡了。",
  "SM_006010_0380_LUC": "「惡魔只不過是\r\n會將人類靈魂啃食殆盡的可怕禽獸。\r\n\r\n你們魔女不也只把祂們\r\n當成戰鬥用的武器嗎？」\r\n",
  "CE_006820_0010_NAR": "『我不會放過那傢伙的。\r\n我要拿回我的力量！』",
  "BK_6010_0010_CER": "「萊卡翁！」",
  "SM_006040_0080_NAR": "瑟蕾莎有好幾次都因為\r\n在練習時失誤而被摩根娜責罵。\r\n\r\n但是摩根娜現在的表情\r\n並不像是一位訓練學生的老師，\r\n反倒像是充滿憎恨的惡魔。",
  "BK_8200_0070_CER": "「小柴貓……」",
  "SM_006010_0220_LUC": "「我失去了身體，\r\n只有靈魂在這隻狼體內苟活。\r\n\r\n不過，有一個方法可以解除那個封印。」",
  "SM_006010_0430_CER": "「萊卡翁……」",
  "CE_006090_0000_CER": "你有使出全力嗎！？",
  "BK_6040_0030_CER": "「小柴貓……！？」",
  "SM_006040_0050_NAR": "轟雷作響。林木喧囂。\r\n冰冷的空氣籠罩四方。\r\n",
  "BK_8200_0020_NAR": "「是嗎……好吧，看來旅程到此為止了。」\r\n小柴貓的聲音聽起來很寂寞。",
  "SM_006030_0140_LUC": "「沒關係的，瑟蕾莎。\r\n我已經沒救了……」",
  "CE_006810_0000_CER": "只要我們同心協力，\r\n就所向無敵！",
  "BK_6020_0120_POO": "「小、小丫頭……\r\n汝該不會是那個魔女的——」",
  "BK_6020_0000_NAR": "甩開如海嘯般襲來的大量妖精後，\r\n小柴貓終於逃出了森林。",
  "BK_6020_0110_CER": "「摩根娜……！」",
  "CE_006010_0000_CER": "小柴貓，加快速度！",
  "SM_006020_0050_CER": "「萊卡翁……」",
  "CE_006120_0000_CER": "已經無法阻止摩根娜了吧……",
  "SM_006010_0350_LUC": "「辦不到……？為什麼？」",
  "SM_006010_0090_NAR": "原來，帶路的白狼體內\r\n寄宿著萊卡翁的靈魂。",
  "BK_8200_0090_CER": "「小柴貓，等一下……！\r\n　\r\n我……竟然忘了那麼重要的事。\r\n忘了遵守和你的約定……！」",
  "SM_006010_0010_CER": "「萊卡翁……？」",
  "IN_6000_0100_MOR": "什麼！？剛才的法術是……！\r\n",
  "SM_006030_0070_CER": "「不好意思，\r\n我現在沒空陪你！」",
  "BK_6000_0050_NAR": "瑟蕾莎的叫聲讓萊卡翁\r\n瞬間遲疑了一下……\r\n\r\n但他很快就重新開始灌注力量。",
  "SM_006010_0110_LUC": "「因為……\r\n我是妖精和人類\r\n所生的孩子……」",
  "CE_005160_0000_CER": "「我們走，小柴貓！！」",
  "SM_006010_0080_LUC": "「沒事的，不要害怕……\r\n如你所見，我的身體被封印了。\r\n但是，魂魄卻逃過了一劫。」\r\n",
  "SM_006010_0260_CER": "「只有魔女才有的東西……？\r\n我能幫上什麼忙嗎……？」",
  "BK_8210_0000_NAR": "守護重要的朋友。",
  "CE_006000_0010_CER": "該怎麼辦才好……",
  "SM_006030_0040_CER": "「你是……！」",
  "BK_6020_0230_MOR": "「把這孩子害成這樣的蠢貨，\r\n竟然還有臉說……！」",
  "BK_6000_0100_CER": "「我還以為我們能成為好朋友！」\r\n",
  "BK_6030_0050_NAR": "「站起來！這傢伙是敵人！」\r\n小柴貓激勵著瑟蕾莎。\r\n",
  "SM_006030_0000_CER": "「對了……\r\n也許我的老師可以幫助你……」",
  "BK_6020_0200_NAR": "那是瑟蕾莎從來沒看過的表情，\r\n既溫柔又平靜。\r\n然而……",
  "BK_6030_0060_NAR": "摩根娜眼看就要再次發動魔法攻擊。\r\n但是，瑟蕾莎卻動也不動。",
  "SM_006030_0110_NAR": "在聽了普卡的話之後，\r\n瑟蕾莎便明白一切了。\r\n背叛妖精王、封印萊卡翁的傢伙，\r\n就是眼前的普卡。\r\n",
  "SM_006030_0030_POO": "「小丫頭！做得好！」",
  "SM_006020_0020_CER": "「怎麼會……」",
  "BK_6020_0150_CER": "「那隻白狼的身體裡\r\n寄宿著一個男孩的靈魂。」",
  "BK_6020_0040_NAR": "妖精的法術如蟒蛇般纏了上來，\r\n以驚人的力量把瑟蕾莎他們\r\n往森林的方向拖。",
  "SM_006040_0010_NAR": "摩根娜突然勃然大怒，\r\n開始襲擊瑟蕾莎他們。\r\n",
  "BK_8200_0060_NAR": "「之前你母親的那件事，\r\n是我做得太過火了。\r\n我想為此向你道歉。」",
  "SM_006040_0090_CER": "「摩根娜，我……」",
  "SM_006010_0170_NAR": "然而，有個邪惡的妖精\r\n不認同那種做法，\r\n\r\n某天祂突然叛變，殺了妖精王，\r\n甚至襲擊了年幼的萊卡翁和他的母親。",
  "BK_6010_0000_NAR": "萊卡翁用盡了所有力量，\r\n連站著都很勉強。\r\n然後……",
  "SM_006040_0060_MOR": "「我至今教導了數十、數百個見習魔女，\r\n讓她們學會魔導術，\r\n再引誘她們進入森林……」",
  "CE_006820_0000_CER": "小柴貓！",
  "SM_006010_0140_NAR": "萊卡翁開始把過去發生的事\r\n娓娓道來。",
  "CE_006020_0000_CER": "快躲開，小柴貓！！",
  "BK_6020_0160_CER": "「不快點救他的話，\r\n他的靈魂會消失的！\r\n求求你，摩根娜！」",
  "CE_006110_0000_CER": "這是回敬你的！",
  "BK_6000_0060_CER": "「小柴貓！」",
  "SM_006010_0030_LUC": "「這一刻總算到來了……\r\n\r\n瑟蕾莎，我就知道\r\n你一定能來到這裡。」",
  "BK_6030_0140_MOR": "「瑟蕾莎，你比其他的\r\n見習魔女還要有潛力。\r\n要是你能捨棄自己的情感，\r\n你早就成為一名出色的魔女了！」",
  "BK_6030_0020_CER": "「可是……我最喜歡摩根娜了。\r\n雖然嚴厲又可怕，卻也很溫柔。\r\n我一直覺得你就像我的媽媽一樣。」",
  "SM_006030_0150_CER": "「萊卡翁，振作一點！」",
  "BK_6030_0130_NAR": "摩根娜面不改色地\r\n把萊卡翁支開。",
  "CE_006815_0000_CER": "要是能破壞那個，\r\n說不定就能幫到小柴貓了……！",
  "SM_006030_0160_CER": "「我絕對不會\r\n把萊卡翁交給你這種傢伙。\r\n\r\n你不過是個冒牌妖精王，\r\n我才不怕你呢！」",
  "BK_6030_0010_CER": "「練習的時候總是失敗，\r\n你的叮嚀也都當耳邊風，\r\n所以老是挨罵。」",
  "SM_006020_0040_LUC": "「你叫小柴貓對吧……\r\n也許你的心……\r\n比我的純潔無瑕多了……」",
  "BK_6100_0010_CER": "",
  "SM_006010_0340_CER": "「我、我辦不到！」",
  "BK_8210_0030_CER": "「我……是魔女。」",
  "BK_8200_0085_NAR": "小柴貓出乎意料的話語\r\n動搖了瑟蕾莎的心。",
  "BK_6040_0000_NAR": "普卡一發出信號，\r\n大量的妖精便從森林各處聚集過來。",
  "SM_006010_0180_NAR": "母親好不容易救出了萊卡翁的靈魂，\r\n卻被驅逐到森林之外，\r\n再也回不了森林。",
  "SM_006010_0100_CER": "「封印？為什麼……？」",
  "PH_6010_0000_NAR": "突然間，巨大的光柱從地面升起，\r\n發出的巨響震撼整座森林。",
  "SM_006010_0240_LUC": "「不過，我今天終於等到了。\r\n等到你成功抵達這裡。\r\n\r\n瑟蕾莎，多虧有你，\r\n我終於可以解除封印了。」",
  "BK_8200_0010_CER": "「我辦不到……！\r\n我……已經不知道該怎麼辦了！」",
  "SM_006040_0100_MOR": "「我跟沒用的丫頭無話可說。\r\n\r\n把那隻破爛惡魔的靈魂交出來，\r\n為了我的兒子萊卡翁，\r\n我要拿祂來獻祭！」",
  "CE_006070_0000_CER": "趁現在，小柴貓！",
  "SM_006010_0270_LUC": "「瑟蕾莎，你已經\r\n為我完成使命了，不是嗎？」",
  "SM_006040_0130_MOR": "「那隻惡魔……是只會在陰曆二月的\r\n滿月之夜誕生的黑暗產物。\r\n祂的靈魂對解除封印是不可或缺的。\r\n\r\n祂不是隨處可見的惡魔，\r\n不能因為你無聊的感情就放祂走！」\r\n",
  "SM_006010_0020_NAR": "話才說完，\r\n瑟蕾莎就聽見了萊卡翁微弱的聲音。",
  "CE_006140_0000_CER": "永別了，摩根娜……！",
  "BK_6030_0120_LUC": "「母親……！母親！」",
  "SM_006040_0020_CER": "「摩、摩根娜，你在說什麼！？\r\n為什麼突然這樣！？」",
  "BK_8200_0050_CER": "「況且什麼……？」\r\n",
  "BK_6040_0040_NAR": "小柴貓一語不發地飛奔出去。\r\n祂的目標正是那道立於\r\n遙遠彼方的光柱。",
  "SM_006030_0010_LUC": "「咦……？」",
  "CE_006040_0000_CER": "蹲下！",
  "SM_006010_0060_NAR": "瑟蕾莎和小柴貓都嚇了一跳。\r\n萊卡翁的聲音\r\n竟然是從白狼的方向傳來的。",
  "SM_006010_0230_LUC": "「只要使用某樣東西就能辦到。\r\n那個東西很特別，只有魔女才有。\r\n\r\n所以每當有見習魔女誤闖這座森林，\r\n我就會試著引導她們來這裡……」",
  "SM_006020_0030_LUC": "「不過，是我錯了。\r\n我一直以為惡魔是沒有心的禽獸，\r\n生來就是要當活祭品的……」",
  "BK_6030_0100_MOR": "「啊，萊卡翁……！\r\n看你神智都不清楚了……\r\n你等著，母親馬上就救你。」",
  "BK_8210_0040_CER": "「不亞於媽咪的強大魔女！」",
  "SM_006010_0210_NAR": "聽著萊卡翁的故事，\r\n瑟蕾莎想起了自己的遭遇，\r\n頓時覺得胸口好難受。",
  "BK_6000_0010_CER": "「一定還有其他解除封印的方法。\r\n我們一起找吧！」",
  "LV_006005_0000_NAR": "小柴貓疾奔如風。\r\n從祂寬闊的背上傳來的體溫\r\n鼓舞了瑟蕾莎的心。",
  "BK_6000_0090_NAR": "瑟蕾莎下定了決心。",
  "SM_006030_0080_POO": "「肅靜，小丫頭。\r\n汝等如欲歸去，本王絕不干涉。」",
  "CE_006080_0000_CER": "太慢了！",
  "BK_8210_0020_NAR": "瑟蕾莎的眼中\r\n透漏著勇氣、意志以及決心。\r\n",
  "_00": "",
  "SM_006030_0050_POO": "「小丫頭，多虧汝等的努力，\r\n本王終於可以如願以償，\r\n得到四處逃匿的白獸之魂！」\r\n",
  "CE_006800_0000_CER": "萊卡翁……！\r\n我絕不會把小柴貓交給你……！",
  "BK_6020_0220_MOR": "「你想……救這孩子？」",
  "CE_006000_0000_CER": "對手是摩根娜，我怎麼可能逃得掉……",
  "BK_8210_0010_NAR": "遵守重要的約定。",
  "SM_006010_0130_LUC": "「等、等一下！不是的！\r\n我和其他的妖精不一樣，\r\n襲擊人類的念頭，我一刻都不曾有過。\r\n\r\n就是這樣……才會遭到封印。」",
  "CE_006130_0000_CER": "但我不能輸！",
  "BK_6000_0070_NAR": "萊卡翁不斷地吸取\r\n小柴貓的力量。\r\n",
  "BK_6020_0180_NAR": "瑟蕾莎覺得很不解，\r\n於是湊近去看摩根娜的表情。",
  "LV_006025_0000_CER": "真遺憾！可別小看魔女！",
  "BK_6020_0005_NAR": "然而……",
  "SM_006040_0030_MOR": "「長久以來的訓練、那個魔導器、\r\n引誘你去森林的夢……」\r\n",
  "SM_006010_0370_LUC": "「把、把惡魔當朋友！？\r\n你在說什麼啊，瑟蕾莎？」",
  "BK_8200_0000_NAR": "「瑟蕾莎，你怎麼了？\r\n你要放棄了嗎？」\r\n\r\n小柴貓的聲音在腦中迴盪。\r\n",
  "SM_006040_0000_MOR": "「瑟蕾莎，你為什麼沒有\r\n把那隻惡魔拿來獻祭……\r\n\r\n你以為我為什麼\r\n要教你魔導術！」",
  "SM_006010_0160_NAR": "妖精王受到所有妖精的愛戴，\r\n而且總是呼籲和平，\r\n鼓勵妖精要與人類和睦相處。\r\n",
  "LV_006015_0000_CER": "小柴貓，小心！",
  "SM_006040_0070_MOR": "「現在終於只差最後一步了……\r\n\r\n怎麼能因為你而白費！」",
  "BK_6000_0020_LUC": "「不，瑟蕾莎。\r\n我已經……沒有時間了！」",
  "SM_006010_0330_LUC": "「來吧，把那隻惡魔的性命交給我。\r\n這樣一來，封印馬上就能解除了！」",
  "SM_006010_0070_CER": "「怎、怎麼回事……？\r\n白狼發出了萊卡翁的聲音？」",
  "BK_6020_0050_NAR": "絕對不可以放棄！\r\n正當瑟蕾莎這樣想的時候——\r\n",
  "CE_005140_0000_CER": "「有我在，小柴貓你別擔心。\r\n盡情使用力量吧！」",
  "BK_6020_0140_CER": "「摩根娜！\r\n我為不守規定的事向你道歉！\r\n但我希望你先趕快救救那隻白狼！」",
  "SM_006030_0120_LUC": "「卑鄙的傢伙……！\r\n不過，我已經不會再躲躲藏藏了。\r\n而交換條件是\r\n你得先讓她離開這座森林……！」",
  "SM_006040_0040_MOR": "「為了解開我兒子萊卡翁的封印，\r\n我不知道下了多少苦心！」\r\n",
  "CE_006820_0020_CER": "嗯，我們上！",
  "SM_006010_0300_LUC": "「把可以當成活祭品的\r\n惡魔帶來這裡了。」",
  "SM_006010_0150_NAR": "萊卡翁是妖精王和人類女子\r\n所誕下的孩子。",
  "BK_6010_0020_NAR": "惡魔會幫助別人。\r\n這種話，應該沒有人相信吧。\r\n但是，瑟蕾莎早就知道這是真的。\r\n",
  "SM_006010_0290_LUC": "「那當然！因為你已經\r\n把解除封印所需的活祭品——」",
  "SM_006010_0040_CER": "「萊卡翁，你沒事對吧？\r\n我馬上讓你出來！」",
  "BK_8200_0040_NAR": "「我們經歷的這些，人類稱之為旅程吧？\r\n不過，你沒能見到母親我也覺得很遺憾。\r\n況且……」\r\n\r\n小柴貓欲言又止。\r\n",
  "SM_006010_0410_LUC": "「怎麼會……」",
  "SM_006030_0020_CER": "「還來得及。\r\n一起去找我的老師吧！\r\n\r\n我不會讓你死在這種地方的！」",
  "BK_6030_0030_MOR": "「別過來！」",
  "SM_006030_0180_POO": "「眾手下，集合吧！\r\n就在今日，舊時代將沒入永恆黑暗，\r\n而新王國將迎來曙光！\r\n來吧！妖精們！」",
  "BK_6000_0080_CER": "「虧我……這麼相信你！」",
  "SM_006010_0390_CER": "「不對！\r\n小柴貓才不是什麼武器。\r\n\r\n我們一路上互相幫助、\r\n合力度過難關，\r\n小柴貓是我的朋友！」",
  "BK_6010_0030_LUC": "「你們兩個……」",
  "BK_6000_0000_NAR": "萊卡翁悲傷的眼神\r\n讓瑟蕾莎難受得快要窒息了。\r\n好想幫助萊卡翁……\r\n瑟蕾莎的這份心意並未因此動搖。",
  "SM_006010_0200_CER": "「萊卡翁也失去了爸爸和媽媽……」",
  "SM_006010_0320_NAR": "萊卡翁的話讓瑟蕾莎\r\n不禁懷疑自己是不是聽錯了。",
  "CE_006030_0000_CER": "跳起來！",
  "SM_006030_0100_NAR": "原來普卡想要的，是萊卡翁的靈魂。\r\n",
  "SM_006010_0420_LUC": "「好吧……我明白了，瑟蕾莎。\r\n既然如此，那就沒辦法了。」",
  "BK_6030_0070_NAR": "就在此時——\r\n應該已經筋疲力竭的萊卡翁\r\n跑到了摩根娜的腳邊緊緊抓住了她，\r\n似乎想要阻止這場紛爭。",
  "CE_006100_0000_CER": "看我這招！",
  "BK_6030_0021_CER": "「所以我真的很努力\r\n想讓你高興！」"
}
