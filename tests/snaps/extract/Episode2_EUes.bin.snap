{
  "SM_002100_0150_COL": "—¡Gracias!",
  "BK_2000_0060_CER": "—Vamos a tranquilizarnos...\r\nVoy a ser bruja. ¡Tengo que ser fuerte!",
  "LV_002905_0000_NAR": "[FONT:10 ]Presiento un gran poder.[FONT:N ]\r\nCheshire percibió algo en las cercanías.",
  "SM_002100_0040_NAR": "Cereza pensó en su próximo\r\nsueño y no pudo evitar sonreír.",
  "SM_002140_0050_FAS": "—Por cierto, aún no me he presentado.\r\nMe llamo Ignis, y soy\r\nla guardiana del bosque.",
  "SM_002060_0030_CER": "—¡Cheshire, cuidado!\r\nNo sé si los fuegos fatuos\r\npueden sufrir infartos, pero\r\nsustos así nunca son buenos.",
  "LV_002035_0120_CER": "¡No me asustas! Recuerda que es mi magia\r\nelemental la que usas para transformarte.",
  "CE_002815_0000_CER": "Gñiii... gñiii... ¡ah!",
  "SM_002140_0060_FAS": "—Me alegro de que os hayáis\r\nencargado del circo. Sabía que\r\nno me equivocaba con vosotros.",
  "SM_002060_0000_COL": "—Es nuestra base secreta.\r\nNormalmente no aceptamos visitas,\r\npero hoy haré una excepción.",
  "BK_2000_0050_CER": "—¡P-puedo luchar!\r\n¡No soy una niña indefensa!",
  "LV_002035_0015_NAR": "Dijo Cheshire con acritud.",
  "SM_002130_0135_CER": "—Vale... Cuéntame más.",
  "LV_002900_0000_CER": "¿Qué le pasa a ese bufón?\r\n¡Qué pesado!",
  "SM_002010_0100_COL": "—Quiero ayudarles,\r\npero yo solo no puedo\r\nenfrentarme a esas hadas.",
  "SM_002010_0180_NAR": "Cheshire dejó bien claro\r\nque él no iba a participar\r\nen el rescate.\r\nPero Cereza estaba decidida.",
  "SM_002010_0010_NAR": "Cereza recordó algo que Morgana\r\nle había contado tiempo atrás.\r\nLos niños que mueren en Ávalon\r\nse convierten en fuegos fatuos.\r\nSus almas son condenadas a vagar\r\npor el bosque eternamente...",
  "CE_002070_0000_CER": "¡Hora del último número!",
  "LV_002080_0020_NAR": "Cereza empezó a bostezar de repente.\r\nEstaba agotada.",
  "SM_002140_0100_NAR": "Ahora que sabía que la voz\r\npertenecía a un fuego fatuo,\r\nCereza se relajó.",
  "SM_002130_0150_FAS": "—El director del circo\r\nesclaviza a esos pobres desgraciados\r\npara que actúen en los espectáculos\r\nhasta que mueran.",
  "SM_002040_0050_CER": "—Mira lo contentos que están.\r\nColm y sus amigos pueden volver\r\na vivir juntos.\r\nCon suerte, será un consuelo\r\nen este maldito bosque...",
  "SM_002140_0010_CER": "—Esa voz...",
  "SM_002140_0210_FAS": "—¿Ocurre algo?",
  "SM_002110_0090_CER": "—¿Sabes lo importante que es el pelo\r\nde las brujas? ¡Ten cuidado!",
  "_05": "",
  "SM_002130_0120_FAS": "—Pero no te resultará tan fácil\r\ncomo crees encontrar\r\nlos núcleos elementales.",
  "LV_002930_0000_CER": "Es verdad, no soportas el romero.\r\nBueno, pues quédate ahí.",
  "SM_002140_0045_CER": "—¡Tú eres la que nos habló antes!",
  "CE_002040_0000_CER": "¡Eh, los interruptores se han dado\r\nla vuelta y no puedo pulsarlos!",
  "SM_002130_0080_FAS": "—Ah, pero tú buscabas un lobo\r\nblanco, ¿no?",
  "_01": "",
  "SM_002130_0110_FAS": "—Confía en el camino que vas\r\na tomar... Es el correcto.",
  "SM_002040_0180_CER": "—Si hubiera sido más fuerte,\r\npodría haberla salvado aquella noche...",
  "SM_002040_0100_NAR": "Pero, al pronunciar estas palabras,\r\nse dio cuenta de algo...",
  "IN_2000_0010_NAR": "Cereza le tomaba el pelo al demonio,\r\nque se limitó a responder con una mirada fría.",
  "LV_002070_0010_NAR": "Cereza chilló de pura felicidad.\r\nAl fin y al cabo, no era más que una niña.",
  "SM_002140_0180_FAS": "—No te preocupes.\r\n¡Solo tienes que drenar el lago!",
  "_54": "",
  "LV_002005_0030_NAR": "[FONT:10 ]Tiene buena pinta. ¡Vamos![FONT:N ]",
  "SM_002100_0110_COL": "—¿Puedo pedirte\r\nun último favor?",
  "SM_002080_0010_CER": "—No he estado mal, ¿verdad?\r\nYa te dije que sé hacer más\r\ncosas, aparte de llevarte en brazos.",
  "SM_002050_0000_COL": "—¡Gracias, Cereza!",
  "SM_002140_0220_CER": "—¡No, nada!\r\nTorres de reloj... estatuas gigantes...\r\n¡Sí, a las brujas nos encantan\r\nlos lugares altos! ¡Gracias!",
  "LV_002010_0010_CER": "Están acosando a uno de esos\r\npobres fuegos fatuos, pero...\r\nyo no puedo ayudarlo sola...",
  "SM_002100_0120_COL": "—Si encuentras por el bosque\r\na otros amigos míos capturados,\r\n¿te importaría rescatarlos\r\ny enviarlos aquí de vuelta?",
  "IN_2000_0020_NAR": "[FONT:10 ]Aniquilaré a cualquiera\r\nque se me acerque.[FONT:N ]",
  "CE_002080_0000_CER": "¡Uggghh!",
  "SM_002130_0160_CER": "—¿Hasta que... mueran?",
  "SM_002080_0040_NAR": "Cereza estaba harta\r\nde la arrogancia de Cheshire.",
  "LV_002035_0115_NAR": "Cheshire miró a Cereza con ira.",
  "LV_002040_0030_CER": "Ojalá hubiera podido jugar\r\ncon mamá en un lugar así.",
  "BK_2000_0040_NAR": "[FONT:9 ]¡Aparta de mi camino![FONT:N ],\r\ngritó Cheshire a la aterrada Cereza.",
  "SM_002060_0090_COL": "—Y para ti tengo esto.\r\nNo sabemos cómo se usa,\r\npero parece contener magia.",
  "CE_002800_0000_CER": "Mientras siga encima de la pelota, no\r\nconseguiremos nada. ¡Vamos a quitársela!",
  "SM_002060_0100_CER": "—¡Gracias!",
  "IN_2000_0040_CER": "¡Conque esas tenemos!",
  "SM_002130_0010_CER": "—¿Q-quién anda ahí?",
  "CE_002000_0000_CER": "¡Baja de ahí!",
  "SM_002060_0130_COL": "—¡De nada! Avísame\r\nsi necesitas algo.",
  "LV_002035_0020_CER": "Con tanta pataleta, podría una pensar que\r\nen realidad tu lengua es para quejarte.\r\nQuieres volver a casa, ¿no?",
  "SM_002130_0210_FAS": "—Bueno, he de marcharme.\r\nOs deseo un buen viaje.",
  "SM_002100_0050_CER": "—¡El lobo blanco!",
  "LV_002055_0010_NAR": "La posibilidad de rescatar a los fuegos fatuos\r\nle levantó el ánimo a Cereza.",
  "LV_002905_0010_CER": "¡El núcleo elemental está cerca!\r\n¿Dentro de aquella carpa, quizás?",
  "LV_002090_0010_CER": "¿Qué es eso?",
  "BK_2010_0040_LUC": "—Sécate las lágrimas...",
  "SM_002010_0030_COL": "—¿Quién eres? ¿Te has perdido?",
  "SM_002040_0040_NAR": "[FONT:9 ]¿Me recuerdas por qué hemos\r\nsalvado a estas cosas?[FONT:N ],\r\npreguntó Cheshire.",
  "SM_002110_0070_CER": "—¡Cheshire!\r\n¡Aaah, ahora tengo el pelo pegajoso!",
  "SM_002010_0000_CER": "—¿Será eso... un fuego fatuo?",
  "SM_002130_0060_FAS": "—Pregúntame algo si no me crees.\r\nTe contestaré a lo que sea.",
  "SM_002140_0030_NAR": "Cereza miró al lugar de donde\r\nprocedía y vio a un peculiar\r\nfuego fatuo embutido en un gorro.",
  "SM_002040_0070_NAR": "[FONT:9 ]¿Y a mí qué me importa?[FONT:N ],\r\nreplicó Cheshire.\r\nLos demonios no suelen\r\nser adalides del altruismo.",
  "SM_002140_0120_CER": "—Has dicho que te llamas Ignis,\r\n¿verdad?",
  "SM_002010_0190_CER": "—¡Yo voy, aunque tenga que\r\nenfrentarme a las hadas sola!",
  "LV_002915_0000_CER": "¡Yupiiii!\r\n¿Adónde me llevará?",
  "LV_002050_0010_CER": "He de andarme con cuidado.\r\nSi me detectan, quién sabe qué será de mí.",
  "SM_002130_0180_FAS": "—Pero no te preocupes.\r\nTu demonio y tú no estiraréis\r\nla pata tan fácilmente.",
  "SM_002140_0150_CER": "—¡¿El fondo del lago?!",
  "SM_002040_0110_CER": "—Oh, supongo que...\r\nyo te aparté de tus seres queridos\r\ncuando te llamé a este mundo...",
  "SM_002040_0190_NAR": "Al hablar, los recuerdos de la noche\r\nque no logró salvar a su madre\r\nse reprodujeron en su mente.",
  "SM_002010_0160_NAR": "La niña y el demonio cruzaron\r\nmiradas desafiantes. Ninguno\r\ndaba su brazo a torcer.",
  "SM_002010_0070_CER": "—Pareces preocupado.\r\n¿Qué te pasa?",
  "SM_002040_0080_CER": "—¿Qué quieres decir?\r\n¿Que los habrías abandonado?",
  "LV_002925_0000_CER": "¿Hemos...\r\nintercambiado el sitio?",
  "SM_002020_0080_NAR": "[FONT:9 ]¿Ah, sí? ¿Y cómo va a ayudar\r\na nadie una mequetrefe como tú?[FONT:N ]\r\nEl demonio se rio de ella\r\ncon una cruel sonrisa.",
  "SM_002020_0000_CER": "—¡Cheshire!",
  "SM_002140_0160_CER": "—Pues qué suerte la mía, porque\r\nse me da mejor hundirme que nadar.",
  "SM_002110_0080_NAR": "Cheshire disfrutó de su tentempié\r\nmientras Cereza intentaba quitarse\r\nla pulpa del pelo sin éxito.",
  "SM_002010_0040_CER": "—¡¿Pu-puedes hablar?!",
  "SM_002060_0050_NAR": "[FONT:9 ]Debemos proseguir. No hay\r\ntiempo para jugar con\r\nestos mocosos[FONT:N ],\r\ndijo Cheshire mirando a Colm.\r\n",
  "LV_002005_0010_CER": "¿Qué será eso?",
  "SM_002050_0010_NAR": "Colm estaba encantado.\r\nLes dijo que quería darles\r\nlas gracias por salvar a sus amigos.",
  "SM_002080_0000_NAR": "Derrotaron a la formidable hada.\r\nCereza sintió que había contribuido,\r\naunque solo fuera un poco.",
  "BK_8100_0010_CER": "—Un momento...\r\n¿Qué poder obtendré\r\nesta vez?",
  "CE_002030_0000_CER": "¿Qué son esos interruptores\r\nque hay delante de las columnas?",
  "CE_002100_0000_CER": "¡Ayúdame, Cheshire!",
  "SM_002130_0050_CER": "—Dijo la voz espeluznante de las sombras.",
  "SM_002140_0080_FAS": "—Una pena.",
  "IN_2000_0000_CER": "Así que, después de tanta\r\ndiscusión, vas a ayudarme.",
  "SM_002010_0080_COL": "—Es por mis amigos...\r\nLas hadas se los llevaron.",
  "SM_002130_0170_FAS": "—Disculpa... ¿Te he asustado?",
  "SM_002010_0110_CER": "—¡Deja que yo me encargue\r\nde esas miserables!",
  "LV_002095_0010_CER": "Ah, una vez vi este número en una feria.\r\nNo esperaba protagonizarlo yo un día...",
  "SM_002010_0044_CER": "—Yo soy Cereza. ¿Cómo te llamas?",
  "SM_002140_0230_FAS": "—No hay de qué.",
  "SM_002020_0040_NAR": "[FONT:9 ]Si te pasa algo a ti,\r\nyo también me la juego[FONT:N ].\r\nEl demonio solo velaba\r\npor sus propios intereses.",
  "SM_002120_0000_NAR": "[FONT:10 ]¿No puedes moverte más rápido?[FONT:N ]\r\nEl lobo se escapaba,\r\ny Cheshire no estaba contento.",
  "LV_002030_0020_CER": "¡Quizás nos sirva para ir a lugares\r\nque antes no podíamos alcanzar!",
  "CE_002805_0000_CER": "¡Esquiva todos nuestros tiros!\r\nAlguna forma habrá de darle...",
  "LV_002030_0010_CER": "Este nuevo poder...",
  "SM_002010_0120_COL": "—¿Qué? ¿Lo dices de verdad?",
  "SM_002040_0150_NAR": "[FONT:9 ]¡Fíjate lo fuerte que soy recién\r\nnacido! ¡Imagina cuando crezca![FONT:N ]\r\nEl demonio interrumpió la reflexión\r\nde Cereza con sus estruendosas carcajadas.",
  "SM_002140_0110_NAR": "Pero Cheshire no dijo nada.\r\nNo parecía tener ningún\r\ninterés en el fuego fatuo.",
  "LV_002080_0030_NAR": "Decidió descansar allí mismo.",
  "SM_002130_0140_FAS": "—Más adelante hay una carpa\r\ncircense que las hadas usan\r\npara atraer a los niños al bosque.",
  "SM_002130_0090_CER": "—¿C-cómo lo sabías?",
  "LV_002910_0000_CER": "¡Qué ruido!...\r\n¡Viene de ahí!",
  "SM_002100_0140_CER": "—¡Te doy mi palabra!",
  "SM_002100_0060_NAR": "Al ver al lobo, Cereza\r\nse puso en pie de inmediato.",
  "LV_002055_0020_CER": "Esas hadas son horribles. ¡No temáis,\r\nfuegos fatuos! ¡Yo os salvaré!",
  "CE_002060_0000_CER": "Ah, funcionan como los interruptores.",
  "SM_002100_0170_COL": "—¡Cuídate, Cereza! ¡Cuídate, gatito!",
  "LV_002090_0020_NAR": "A lo lejos se divisaba una enorme carpa circense\r\ndel color de la sangre. Parecía burlarse de Cereza,\r\ny ella se sentía atraída hacia allí.",
  "SM_002140_0070_FAS": "—Algo me dice que su director\r\nno querrá volver a jugar\r\ncon el trapecio.",
  "SM_002060_0010_COL": "—Oye, ¿adónde ha ido tu amiguito?",
  "SM_002130_0020_NAR": "A Cereza le dio un vuelco el corazón\r\nal oír aquella voz.",
  "SM_002130_0130_CER": "—¿También conoces los núcleos elementales?",
  "LV_002035_0010_NAR": "[FONT:10 ]Mi lengua es para lamer presas.\r\n¿Hasta cuándo me vas a tener haciendo esto?[FONT:N ]",
  "SM_002100_0100_CER": "—Lo siento, tenemos prisa.",
  "LV_002005_0020_NAR": "Cereza vio algo que parecía fruta.",
  "SM_002140_0200_CER": "—Así que el árbol más alto...",
  "SM_002080_0030_CER": "—¡Demonio engreído!",
  "SM_002100_0090_COL": "—Oh, ¿ya os vais?",
  "SM_002100_0010_NAR": "Las últimas palabras del chico\r\naún resonaban en sus oídos.",
  "SM_002050_0020_COL": "—¡Seguidme!",
  "SM_002140_0190_FAS": "—Pero, para llegar, tendrás\r\nque pasar por un enorme árbol.\r\n¿A que es poético que, para\r\nalcanzar el fondo de un lago,\r\nhaya que subir al árbol más alto?",
  "LV_002920_0000_CER": "¡Viene de ahí!\r\n¿Qué es eso?",
  "LV_002065_0010_CER": "Qué rápido andas para tener\r\nunas piernas tan cortas, Colm.",
  "SM_002140_0000_FAS": "—¿Os lo habéis pasado bien\r\nen el circo?",
  "SM_002030_0010_NAR": "Cereza le tomaba el pelo al demonio,\r\nque se limitó a responder con una mirada fría.",
  "SM_002060_0060_COL": "—¡Vaya gato gruñón!\r\n¡También tengo algo para ti!",
  "CE_002050_0000_CER": "¿Para qué servirán estas palancas?",
  "SM_002060_0140_NAR": "Dicho lo cual, Colm se fue\r\na jugar con sus etéreos amigos.",
  "SM_002030_0020_NAR": "[FONT:10 ]Aniquilaré a cualquiera\r\nque se me acerque. Yo sí tengo\r\nfuerza para protegerme a mí mismo[FONT:N ],\r\nreprendió el demonio.",
  "IN_2000_0030_NAR": "[FONT:10 ]Yo sí tengo fuerza\r\npara protegerme a mí mismo[FONT:N ],\r\nreprendió el demonio.",
  "SM_002100_0130_COL": "—Te compensaremos.\r\n¡Prometido!",
  "SM_002100_0020_NAR": "Cereza sentía una calidez en su\r\ninterior, como si en este oscuro\r\ny frío bosque se hubiera encendido\r\nuna llama en su corazón.",
  "SM_002130_0220_NAR": "La voz enmudeció y el silencio\r\nvolvió a envolver el bosque.",
  "SM_002120_0040_NAR": "El demonio no dijo nada.\r\nSu mirada bastó como respuesta.",
  "_71": "",
  "SM_002040_0120_NAR": "[FONT:9 ]Acababa de nacer.\r\nNo siento amor por nadie.\r\nNo necesito amor. Solo fuerza.[FONT:N ]\r\nSu filosofía era simple.",
  "SM_002110_0110_CER": "—¡S-silencio!\r\nEstoy trabajando en ello. ¡Ya verás!",
  "SM_002010_0150_CER": "—¡No podemos abandonarlos!",
  "BK_2010_0020_CER": "—¿M-mamá?\r\n¿Dónde estás, mamá?",
  "CE_002035_0000_CER": "Al pulsar uno, el foco se mueve\r\nhacia lo alto de la columna...",
  "SM_002130_0100_FAS": "—Ahora formas parte del bosque.\r\nPor eso tus asuntos son también\r\nasuntos míos.",
  "BK_2010_0010_CER": "—¿Por...? ¿Por qué no se abre?",
  "SM_002040_0000_CER": "—Menos mal que estáis todos a salvo.\r\nNo esperaba que fuera tan peligroso.",
  "SM_002140_0040_CER": "—¿Un fuego fatuo?",
  "CE_002090_0000_CER": "No puedo... moverme...",
  "SM_002020_0030_NAR": "Cereza se alegraba en secreto de ver\r\na Cheshire, pero él estaba rumiando.",
  "SM_002010_0020_CER": "—Hola, pequeño... ¿Estás bien?",
  "SM_002140_0090_CER": "—¡Era un abusón! Y además pretendía\r\ndarme un papel de relleno en su\r\npatético espectáculo... ¡Ni hablar!",
  "SM_002130_0040_FAS": "—Bueno, por lo menos no soy\r\nuna hada. Te puedes fiar.",
  "LV_002025_0010_CER": "¡No podemos abandonarlo!",
  "CE_002810_0000_CER": "¡Estoy harta de tus trucos!\r\n¡Cheshire!",
  "SM_002120_0020_CER": "¡Iríamos mucho más rápido\r\nsi pudiera montar a tu lomo!",
  "SM_002020_0060_CER": "—Bueno, pues contigo o sin ti,\r\npienso ayudar a estas criaturas.\r\n¡Vas a ver!",
  "SM_002130_0240_CER": "—¿Quién sería?",
  "CE_002010_0000_CER": "¡Es nuestra oportunidad!",
  "SM_002120_0010_CER": "¡Voy tan rápido como puedo!",
  "SM_002020_0050_CER": "—Hum.",
  "LV_002080_0010_CER": "",
  "SM_002140_0130_CER": "—Oye, por cierto, tú no sabrás dónde\r\npodemos echarles el guante a los núcleos\r\nelementales que nos faltan, ¿verdad?",
  "SM_002040_0170_CER": "—¡Yo t-también seré fuerte!\r\nPero con clase, no como otros...",
  "LV_002045_0010_NAR": "No podremos pasar si no bajamos el puente.",
  "SM_002140_0020_NAR": "Una voz familiar volvió a resonar por\r\nentre los árboles.",
  "SM_002010_0090_NAR": "El pobre Colm hacía\r\npucheros al hablar.\r\n\r\nLes contó que las hadas\r\nacorralaban a los fuegos fatuos\r\ny los atormentaban por diversión.",
  "SM_002060_0110_COL": "—Cereza, se te ve cansada.\r\nAquí estamos a salvo. ¿Por qué\r\nno te echas una siestecita?",
  "SM_002060_0080_CER": "—Creo que nunca lo he visto\r\ntan feliz. ¡Gracias!",
  "LV_002035_0110_NAR": "[FONT:10 ]¡Bah, no sabes hacer nada sin mí![FONT:N ]",
  "BK_2010_0060_LUC": "—El cálido abrazo de una madre...\r\nVolverás a sentirlo. Y yo también...",
  "LV_002085_0020_NAR": "Le gustaba jugar con los fuegos fatuos,\r\npero el viaje aún no había tocado a su fin.",
  "LV_002040_0020_CER": "¿Habrán vivido aquí humanos?",
  "SM_002100_0160_NAR": "Se despidieron de Colm\r\ny prosiguieron en busca\r\ndel lobo blanco.",
  "SM_002100_0070_CER": "—Cheshire, ya te has repuesto,\r\n¿verdad?",
  "LV_002040_0010_CER": "¿Qué es este lugar?...",
  "BK_2010_0050_LUC": "—Eres más fuerte de lo que piensas...\r\nTu deseo de salvar a los demás\r\nte impulsará.",
  "LV_002085_0010_NAR": "Cereza se adentró aún más en el bosque.",
  "SM_002130_0200_FAS": "—Eso demuestra que te tienen\r\nmiedo. Y al demonio, claro...",
  "CE_002000_0010_CER": "Cheshire no llega tan alto.\r\n¡Qué injusto!",
  "SM_002060_0120_CER": "—Ahora que lo mencionas...\r\nLlevo en estado de alerta desde\r\nque llegué al bosque.\r\n\r\nGracias por todo, Colm.",
  "SM_002140_0140_FAS": "—Por supuesto que sí.\r\nEl próximo núcleo se encuentra\r\nen el fondo del lago.",
  "SM_002100_0030_CER": "Me pregunto si volveré\r\na verlo...",
  "SM_002060_0040_NAR": "[FONT:9 ]Los mequetrefes como él no\r\nme importan lo más mínimo. [FONT:N ]",
  "SM_002130_0070_CER": "—Vale... Mmm...\r\n¿Has visto algún lobo blan...\r\ndigo... negro por el bosque?",
  "SM_002030_0030_CER": "—¡Conque esas tenemos!",
  "LV_002065_0110_CER": "Antes de conocerte pensaba que los fuegos\r\nfatuos eran cosa de cuentos de hadas.",
  "SM_002030_0000_CER": "—Así que, después de tanta\r\ndiscusión, vas a ayudarme.",
  "SM_002060_0070_NAR": "[FONT:9 ]¿Crees que el hambre de un demonio\r\nse sacia tan fácilmente?[FONT:N ]\r\nPero sus fauces babeaban y\r\ndelataban lo que pensaba realmente.",
  "LV_002935_0000_CER": "¿Lo ves?\r\nTe dije que los salvaría.",
  "SM_002080_0020_NAR": "Pero a Cheshire no se le veía\r\nimpresionado.",
  "SM_002100_0000_CER": "—Y yo también...",
  "BK_8100_0000_CER": "—Es como antes...",
  "BK_2000_0020_NAR": "Una enorme hada los pilló por sorpresa.\r\nY, de nuevo, Cereza se quedó\r\npetrificada de miedo.",
  "SM_002020_0020_CER": "—Sabía que vendrías.\r\nAl fin y al cabo, necesitas mi magia.\r\nYa que estás aquí,\r\n¿y si me echas una patita?",
  "SM_002040_0090_CER": "—¿No sabes lo que se siente cuando\r\nte apartan de alguien a quien quieres?",
  "SM_002130_0000_FAS": "—Hola, jovencita.",
  "SM_002040_0010_NAR": "Cereza intentó que no se le notara\r\nque se avergonzaba de que el demonio\r\nla hubiera vuelto a salvar.",
  "SM_002010_0060_COL": "—Yo soy Colm.",
  "SM_002130_0190_FAS": "—Has causado un gran revuelo\r\nentre esas hadas desde que\r\nte adentraste en el bosque.",
  "LV_002015_0010_CER": "Cheshire, hay un fuego fatuo\r\nen peligro. ¡Vamos a ayudarle!",
  "SM_002040_0020_NAR": "Cheshire no esperaba menos.\r\nSe sentó y miró a los fuegos\r\nfatuos sin interés.",
  "SM_002130_0030_FAS": "—Buena pregunta. Digamos que...\r\nsoy a quien acudes si quieres\r\nsaber cosas del bosque.",
  "SM_002010_0140_NAR": "Colm no fue el único sorprendido\r\npor la declaración de Cereza.",
  "CE_002020_0000_CER": "¡No te escaparás!",
  "SM_002110_0100_NAR": "[FONT:9 ]¿Ah, sí? Tanto pelaje en la cabeza\r\ny mira para lo que te ha servido[FONT:N ],\r\nreplicó el demonio con insolencia.",
  "SM_002140_0170_CER": "—El problema es volver a salir...",
  "SM_002040_0130_CER": "—¿Que acababas de nacer?\r\nEntonces...",
  "SM_002020_0090_NAR": "Cereza hizo como si no\r\nhubiera oído y prosiguió.",
  "SM_002120_0050_CER": "Ya lo suponía.",
  "SM_002130_0230_CER": "—Se ha ido."
}
