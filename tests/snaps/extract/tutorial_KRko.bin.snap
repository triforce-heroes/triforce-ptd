{
  "TUT_TUTORIAL_TEXT_ph048": "바구니 들기",
  "TUT_TUTORIAL_TEXT_ph015": "강아지풀 점프",
  "TUT_TUTORIAL_TEXT_ph006": "물통 들기",
  "TUT_TUTORIAL_TEXT_w282": "타임 어택에서는\r\n평가에 따른 보상을 얻습니다.\r\n모든 보상을 얻기 위해\r\n몇 번이고 도전해 봅시다!",
  "TUT_TUTORIAL_TEXT_ph011": "세레자의 이동",
  "TUT_TUTORIAL_TEXT_ph002": "점프",
  "TUT_TUTORIAL_TEXT_w165": "왜곡된 공간 안에서 다가오는 요정은\r\n평범하게 공격할 수 없습니다.\r\n[BTN:L2 ]로 빛을 계속 쏘아야\r\n공격이 통하게 됩니다.",
  "TUT_TUTORIAL_TEXT_w561": "코룸이 하고 싶은 말이 있을 때\r\n지도에 도깨비불 마크가\r\n표시됩니다.\r\n놓치지 않도록 합시다.",
  "TUT_TUTORIAL_TEXT_g001": "「옷 갈아입기」가 개방되었습니다.",
  "TUT_TUTORIAL_TEXT_ch029": "슬라이딩",
  "TUT_TUTORIAL_TEXT_w461": "적의 공격에 맞춰서\r\n타이밍에 맞게 [BTN:R1 ]로\r\n적의 공격을 튕기고\r\n반격을 할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph044": "(길게 눌러)멀티 바인드",
  "TUT_TUTORIAL_TEXT_w330": "돌의 엘레멘트 코어를 부수고\r\n돌속성의 힘을 얻었습니다!\r\n[BTN:B ]를 누르면 체셔가\r\n\"돌속성 체셔\"로 변합니다.",
  "TUT_TUTORIAL_TEXT_w323": "단, 변신 중 기술은 마력을 소비합니다.\r\n항상 체셔의 머리 위에 표시되는\r\n남은 마력에 주의합시다.\r\n마력은 허그 모드에서 회복됩니다.",
  "TUT_TUTORIAL_TEXT_ch021": "변신 해제",
  "TUT_TUTORIAL_TEXT_ch032": "피하기",
  "TUT_TUTORIAL_TEXT_w030": "화면 좌측 하단에 있는 꽃 마크는\r\n세레자의 체력을 나타냅니다.\r\n체력은 적의 공격을\r\n받으면 줄어듭니다.",
  "TUT_TUTORIAL_TEXT_w023": "보다 어려운 위치 펄스에 도전!\r\n세레자가 춤출 때,\r\n마크가 두 개 겹친 곳에서는\r\n[BTN:LS ]을 빠르게 두 번 기울입시다.",
  "TUT_TUTORIAL_TEXT_w130": "숲에는 누군가가 쓴 수기가\r\n남겨져 있기도 합니다.\r\n[BTN:L1 ]로 주운 수기는\r\n아카이브에서 확인할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph019": "불속성의 힘 흡수",
  "TUT_TUTORIAL_TEXT_d002": "가고 싶은 장소를 골라 봅시다.",
  "TUT_TUTORIAL_TEXT_w430": "물의 엘레멘트의 조각인\r\n물방울을 조사하면\r\n물의 힘을 흡수하여\r\n물의 높이를 바꿀 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ch025": "카운터",
  "TUT_TUTORIAL_TEXT_w630": "체력이 떨어진 적 근처에서\r\n[BTN:R2 ]을 길게 눌렀다 떼어\r\n차지 스트라이크를 사용하면 최후의\r\n일격을 날릴 수 있게 되었습니다!",
  "TUT_TUTORIAL_TEXT_ph040": "스킬 습득",
  "TUT_TUTORIAL_TEXT_w730": "세레자가 체셔의 등에 올라타\r\n마력을 주면, 체셔의\r\n숨겨진 힘을 이끌어 내\r\n각성 상태로 변신합니다!",
  "TUT_TUTORIAL_TEXT_ch022": "변신 해제",
  "TUT_TUTORIAL_TEXT_ch031": "(길게 눌렀다 떼어)바인드 콤보",
  "TUT_TUTORIAL_TEXT_ph047": "(두 번 기울여)위치 펄스",
  "TUT_TUTORIAL_TEXT_w333": "돌속성 체셔가 쓸 수 있는 발 구르기는\r\n지면에 숨어 있는 적을 파헤치거나\r\n주변의 적을 충격파로 기절시키는 등\r\n싸울 때도 도움이 됩니다.",
  "TUT_TUTORIAL_TEXT_w320": "나무의 엘레멘트 코어를 부수고\r\n나무속성의 힘을 얻었습니다!\r\n[BTN:Y ]를 누르면 체셔가\r\n\"나무속성 체셔\"로 변합니다.",
  "TUT_TUTORIAL_TEXT_w120": "빨간 아치가 있는 곳을\r\n\"마녀의 은신처\"라고 하며,\r\n다가가면 세레자가 기억합니다.\r\n발견하면 다가가 봅시다.",
  "TUT_TUTORIAL_TEXT_ph009": "(길게 눌러)춤추기",
  "TUT_TUTORIAL_TEXT_w020": "세레자는 위치 펄스를 써서\r\n식물을 자라게 할 수 있습니다.\r\n[BTN:L2 ]을 누른 채 타이밍에 맞춰\r\n[BTN:LS ]을 기울입시다.",
  "TUT_TUTORIAL_TEXT_d001": "이그니스는 찾아 둔 마녀의 은신처로 길을 안내해 줍니다.",
  "TUT_TUTORIAL_TEXT_w024": "춤을 활용하여\r\n대상에게 마력을 주입하는\r\n엄브라의 마녀의 기본적인 마술.\r\n그것이 \"위치 펄스\"입니다!",
  "TUT_TUTORIAL_TEXT_w420": "물속성 체셔는\r\n물이 두렵지 않습니다.\r\n물속에 뛰어든 후 [BTN:RS ]을 움직이면\r\n능숙하게 헤엄칩니다.",
  "TUT_TUTORIAL_TEXT_ph050": "(길게 눌러)적 하나 더 잡기",
  "TUT_TUTORIAL_TEXT_ph043": "(길게 눌러)가시 바인드",
  "TUT_TUTORIAL_TEXT_w720": "타임 어택은\r\n가장 빠른 기록을 노리는\r\n자신과의 승부입니다!",
  "TUT_TUTORIAL_TEXT_ch026": "(길게 눌러)당기기",
  "TUT_TUTORIAL_TEXT_w171": "가장 깊은 곳에 숨어 있는\r\n핵을 부숴 티르 너 노그를 파괴합시다.\r\n길을 잃었을 땐 [BTN:START ]로\r\n밖에 나갈 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph016": "나무속성의 힘 흡수",
  "TUT_TUTORIAL_TEXT_ph005": "사다리 오르기/내려가기",
  "TUT_TUTORIAL_TEXT_ph012": "(길게 눌러)가시 바인드",
  "TUT_TUTORIAL_TEXT_ph001": "(벼랑으로 기울여)점프",
  "TUT_TUTORIAL_TEXT_w281": "또한, 티르 너 노그를 공략할 때까지의\r\n시간을 측정하는\r\n타임 어택에도 도전할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w081": "함께 이동할 때\r\n[BTN:LS ]으로 세레자를 움직입시다.\r\n[BTN:RS ]으로 체셔를 주변까지\r\n길게 늘일 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w462": "카운터를 맞은 적은 한동안 기절합니다.\r\n하지만 일부 공격은\r\n카운터로 튕길 수 없으므로\r\n방심은 금물입니다.",
  "TUT_TUTORIAL_TEXT_w100": "체셔를 안고 걸을지, 따로 걸을지는\r\n자유롭게 선택할 수 있습니다.\r\n상황에 따라 할 수 있는 것이\r\n다르므로 적절하게 사용해 봅시다.",
  "TUT_TUTORIAL_TEXT_ph029": "핵 부수기",
  "TUT_TUTORIAL_TEXT_w000": "[BTN:L1 ]로 주변을 조사하면\r\n세레자는 다양한 행동을 취합니다.\r\n궁금한 것은\r\n[BTN:L1 ]로 모두 조사해 봅시다.",
  "TUT_TUTORIAL_TEXT_e009": "조합 결정!",
  "TUT_TUTORIAL_TEXT_ch011": "(물속성 체셔)헤엄치기",
  "TUT_TUTORIAL_TEXT_ch002": "(벼랑 쪽으로 기울여)올라가기",
  "TUT_TUTORIAL_TEXT_w300": "페이지를 선택해 이야기를 기록합시다.\r\n자동 기록과는 페이지가 다르니\r\n특정 지점마다 기록해 두는 것을\r\n추천합니다.",
  "TUT_TUTORIAL_TEXT_w700": "가시 바인드로 잡은 적 근처에서\r\n[BTN:R2 ]을 길게 눌렀다 떼어\r\n연계 공격을 날릴 수 있습니다.\r\n위력이 뛰어나니 활용해 봅시다!",
  "TUT_TUTORIAL_TEXT_ch015": "(돌속성 체셔)발 구르기",
  "TUT_TUTORIAL_TEXT_ch006": "체셔의 이동",
  "TUT_TUTORIAL_TEXT_w400": "적의 공격을 [BTN:L1 ]로 피하면\r\n\"위치 타임\"이 발동하여 일시적으로\r\n초고속으로 움직일 수 있습니다.\r\n각성한 힘으로 결전에 임합시다!",
  "TUT_TUTORIAL_TEXT_b002": "체셔가 스킬을 습득하기 위해서는\r\n아발론 드롭이 필요합니다.",
  "TUT_TUTORIAL_TEXT_ph025": "불속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_ph036": "물속성의 힘 흡수",
  "TUT_TUTORIAL_TEXT_w351": "불속성 체셔는 [BTN:R1 ]을 누르면\r\n화염탄을 발사합니다.\r\n화염탄에는 사물을\r\n태우는 효과가 있습니다.",
  "TUT_TUTORIAL_TEXT_e005": "이것이 재료입니다.\r\n숲속에서 얻을 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w051": "단, 둘의 거리가 너무 멀어지면\r\n무슨 일이 일어날지 모릅니다!\r\n너무 멀리 떨어지지 않도록\r\n주의하며 움직입시다.",
  "TUT_TUTORIAL_TEXT_ch019": "불속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_e012": "만든 아이템은 [BTN:DP ]을\r\n길게 눌러 쓸 수 있습니다.",
  "TUT_TUTORIAL_TEXT_e001": "「아이템 조합」이 개방되었습니다.",
  "TUT_TUTORIAL_TEXT_ph032": "언리시 모드로",
  "TUT_TUTORIAL_TEXT_w900": "[BTN:L2 ]을 길게 누르면 잔느도\r\n가시 바인드를 쓸 수 있습니다.\r\n잔느의 가시 바인드는 범위가 넓어\r\n원 안의 적을 한꺼번에 구속할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w751": "인페르노 프루트는\r\n숲 각지에 열려 있으며\r\n그 위치는 상세 지도에\r\n표시되어 있습니다.",
  "TUT_TUTORIAL_TEXT_w651": "가시 바인드를 연속으로 사용하면\r\n두 마리의 적을 동시에\r\n잡을 수 있습니다.",
  "TUT_TUTORIAL_TEXT_b006": "세레자가 스킬을 습득하기 위해서는\r\n오닉스 로즈가 필요합니다.",
  "TUT_TUTORIAL_TEXT_ph026": "(길게 눌러)가시 감옥",
  "TUT_TUTORIAL_TEXT_ph035": "도깨비불 던지기",
  "TUT_TUTORIAL_TEXT_b001": "오른쪽에 보이는 것이\r\n체셔의 스킬.",
  "TUT_TUTORIAL_TEXT_e006": "이것이 사용 아이템입니다.\r\n획득하면 조합할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w141": "개중에 고민이 있는\r\n도깨비불도 있습니다.\r\n그들의 고민을 해결해 주면\r\n좋은 일이 있을지도 모릅니다.",
  "TUT_TUTORIAL_TEXT_w441": "배리어는 몇 가지 종류가 있고\r\n각각 약점이 다릅니다.\r\n돌의 배리어에는 폭발이나\r\n강한 충격이 효과적일 것입니다.",
  "TUT_TUTORIAL_TEXT_e011": "완성!",
  "TUT_TUTORIAL_TEXT_e002": "「아이템 조합」을 선택하고……",
  "TUT_TUTORIAL_TEXT_b005": "왼쪽에 보이는 것이\r\n세레자의 스킬.",
  "TUT_TUTORIAL_TEXT_ph022": "나무속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_ph031": "체셔 늘이기",
  "TUT_TUTORIAL_TEXT_w910": "마도술을 다시 쓸 수 있을 때까지\r\n세레자보다 시간이 더 걸립니다만,\r\n더 많은 적을 동시에 구속하면……?",
  "TUT_TUTORIAL_TEXT_w752": "숲에는 세레자의 강력한 스킬을\r\n일깨워 주는 것도 잠들어 있습니다.\r\n상세 지도의 표시에 의지해서\r\n다양한 장소를 살펴봅시다!",
  "TUT_TUTORIAL_TEXT_w010": "세레자는 [BTN:L1 ]로 주변을 조사합니다.\r\n각지에 있는 랜턴을 조사해\r\n이야기의 흐름을 기록할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph039": "마도기의 빛을 비추기",
  "TUT_TUTORIAL_TEXT_w310": "숲 각지에 잠들어 있는 \"엘레멘트의 조각\"은\r\n[BTN:L1 ]로 조사하면,\r\n마도기에 힘을 흡수시킬 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ch012": "(물속성 체셔)아쿠아스트림",
  "TUT_TUTORIAL_TEXT_ch001": "공격",
  "TUT_TUTORIAL_TEXT_ch016": "나무속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_ch005": "할퀴기 공격",
  "TUT_TUTORIAL_TEXT_w710": "가지고 있는 사용 아이템은\r\n[BTN:DP ]으로 사용할 수 있습니다.\r\n싸움을 유리하게 진행하기 위해\r\n적극적으로 사용합시다!",
  "TUT_TUTORIAL_TEXT_w510": "도깨비불을 티르 너 노그의 안쪽까지\r\n데려가 봅시다.\r\n도깨비불은 공격을 받으면\r\n사라지니 조심합시다……",
  "TUT_TUTORIAL_TEXT_f001": "「티르 너 노그」가 개방되었습니다.",
  "TUT_TUTORIAL_TEXT_w410": "적이 공격할 때, 머리 위에\r\n마크가 표시될 때가 있습니다.\r\n이 때, [BTN:L2 ]로 상대를\r\n더 강하게 잡을 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph023": "돌속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_ph030": "세레자의 이동",
  "TUT_TUTORIAL_TEXT_w740": "세레자 혼자서는\r\n적을 쓰러트릴 수 없습니다.\r\n마도술을 잘 써서\r\n도망칠 길을 만듭시다!",
  "TUT_TUTORIAL_TEXT_w640": "가시 바인드로 붙잡은 적의 근처에서\r\n[BTN:R2 ]을 길게 눌렀다 떼어\r\n차지 스트라이크를 쓰면\r\n연계 공격을 날릴 수 있게 되었습니다!",
  "TUT_TUTORIAL_TEXT_b004": "길게 눌러 습득해 봅시다.",
  "TUT_TUTORIAL_TEXT_w440": "요정은 전투 중에\r\n배리어를 두르기도 합니다.\r\n배리어를 두른 상대에게는\r\n대부분의 공격이 막힙니다.",
  "TUT_TUTORIAL_TEXT_ch008": "(길게 눌러)당기기",
  "TUT_TUTORIAL_TEXT_e010": "재료를 넣은 뒤 솥을 저어 줍시다.",
  "TUT_TUTORIAL_TEXT_e003": "시험해 봅시다.",
  "TUT_TUTORIAL_TEXT_w140": "숲 이곳저곳에 요정들에게 잡힌\r\n도깨비불이 있습니다.\r\n발견하면 [BTN:L1 ]로 구해 줍시다.",
  "TUT_TUTORIAL_TEXT_w040": "악마의 날카로운 발톱은 요정도\r\n가볍게 쓰러트릴 수 있습니다!\r\n[BTN:R2 ]로 할퀴기 공격을 하여\r\n본때를 보여 줍시다!",
  "TUT_TUTORIAL_TEXT_e007": "시험 삼아 힐링 토닉을\r\n만들어 봅시다.",
  "TUT_TUTORIAL_TEXT_b000": "이곳에선 세레자와 체셔의 스킬을 습득할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph027": "(길게 눌러)춤추기",
  "TUT_TUTORIAL_TEXT_ph034": "도깨비불 안기",
  "TUT_TUTORIAL_TEXT_w340": "물의 엘레멘트 코어를 부수고\r\n물속성의 힘을 얻었습니다!\r\n[BTN:X ]를 누르면 체셔가\r\n\"물속성 체셔\"로 변합니다.",
  "TUT_TUTORIAL_TEXT_w411": "강하게 구속했을 때\r\n상대를 잡아 두는 시간이 길어지고\r\n더욱 빨리 쓰러뜨릴 수 있습니다.\r\n새로운 힘으로 강적에 맞섭시다!",
  "TUT_TUTORIAL_TEXT_w511": "도깨비불은 매우 약합니다.\r\n조금이라도 공격받으면\r\n사라져 버리기 때문에\r\n조심해서 안내해 줍시다!",
  "TUT_TUTORIAL_TEXT_ch017": "돌속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_ch004": "카운터",
  "TUT_TUTORIAL_TEXT_ch013": "(물속성 체셔)아쿠아스트림",
  "TUT_TUTORIAL_TEXT_ch000": "악마의 이동",
  "TUT_TUTORIAL_TEXT_w311": "흡수한 힘이\r\n마도기에 가득 찰 때마다\r\n마력 게이지의 최대치가\r\n조금씩 늘어납니다.",
  "TUT_TUTORIAL_TEXT_w102": "체셔를 안은 상태가 \"허그 모드\"입니다.\r\n따로 걷는 상태에서 [BTN:L1 ]을 누르면\r\n체셔가 인형의 모습으로 돌아갑니다.",
  "TUT_TUTORIAL_TEXT_ph038": "엘레멘트 코어 부수기",
  "TUT_TUTORIAL_TEXT_w011": "오른쪽 아래에 마크가 표시될 때는\r\n자동으로 이야기가 기록되며,\r\n자신이 기록한 이야기처럼\r\n불러올 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ch014": "(불속성 체셔)화염탄",
  "TUT_TUTORIAL_TEXT_ch007": "할퀴기 공격",
  "TUT_TUTORIAL_TEXT_e008": "만들 개수를 정하고……",
  "TUT_TUTORIAL_TEXT_ch010": "(돌속성 체셔)발 구르기",
  "TUT_TUTORIAL_TEXT_ch003": "점프",
  "TUT_TUTORIAL_TEXT_w101": "둘이서 따로 걷는 상태를\r\n\"언리시 모드\"라고 합니다.\r\n체셔를 안은 상태에서 [BTN:R1 ]을 누르면\r\n체셔가 튀어나옵니다.",
  "TUT_TUTORIAL_TEXT_ph028": "(기울여서)위치 펄스",
  "TUT_TUTORIAL_TEXT_w650": "마도술 게이지가 두 개로 늘어\r\n세레자가 가시 바인드를\r\n연속으로 사용할 수 있게 되었습니다!",
  "TUT_TUTORIAL_TEXT_b007": "스킬은 숲을 모험하는 데 도움이 될 겁니다.",
  "TUT_TUTORIAL_TEXT_ph020": "(돌려서)레스터레이션",
  "TUT_TUTORIAL_TEXT_ph033": "허그 모드로",
  "TUT_TUTORIAL_TEXT_w750": "획득한 인페르노 프루트는\r\n체셔가 강력한 스킬을\r\n습득하기 위해 사용됩니다.",
  "TUT_TUTORIAL_TEXT_w550": "숲에서 길을 잃었을 때는\r\n\"숲의 이정표\"를 조사합시다.\r\n가까운 마녀의 은신처로\r\n가는 길을 알려 줍니다.",
  "TUT_TUTORIAL_TEXT_w450": "줄어든 마력은 허그 모드로 바꾸면\r\n조금씩 회복할 수 있습니다.\r\n마력은 틈틈이 회복합시다.",
  "TUT_TUTORIAL_TEXT_ch018": "물속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_e013": "또한, 사용 아이템의 효과는\r\n[BTN:Y ]로 볼 수 있습니다.",
  "TUT_TUTORIAL_TEXT_e004": "세레자는 재료를 활용해 아이템을 만들 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w050": "세레자와 체셔는\r\n각자 따로 이동할 수 있습니다.\r\n세레자를 움직이려면 [BTN:LS ]을,\r\n체셔를 움직이려면 [BTN:RS ]을 사용합니다.",
  "TUT_TUTORIAL_TEXT_ph024": "물속성 체셔로 변신",
  "TUT_TUTORIAL_TEXT_ph037": "허그 모드로 마력 회복",
  "TUT_TUTORIAL_TEXT_w343": "물속성 체셔는 [BTN:R1 ]을 누르면\r\n아쿠아스트림을 발사합니다.\r\n사정거리가 길고 위력도 세니\r\n다양한 곳에 쏘아 맞혀 봅시다.",
  "TUT_TUTORIAL_TEXT_w350": "불의 엘레멘트 코어를 부수고\r\n불속성의 힘을 얻었습니다!\r\n[BTN:A ]를 누르면 체셔가\r\n\"불속성 체셔\"로 변합니다.",
  "TUT_TUTORIAL_TEXT_b003": "이 스킬에 커서를 맞춰서……",
  "TUT_TUTORIAL_TEXT_ch027": "좌우 이동",
  "TUT_TUTORIAL_TEXT_ph042": "피하기",
  "TUT_TUTORIAL_TEXT_w732": "또한, [BTN:A ][BTN:B ][BTN:X ][BTN:Y ]로\r\n불・돌・물・나무속성의\r\n공격을 할 수 있습니다.\r\n전력으로 결전에 임합시다!",
  "TUT_TUTORIAL_TEXT_w721": "스타트 라인을 넘거나\r\n전투가 시작되면\r\n시간 계측이 시작됩니다.\r\n공략 시간에 따라 평가가 정해집니다.",
  "TUT_TUTORIAL_TEXT_w325": "나무속성 체셔는 [BTN:Y ]로\r\n원래대로 돌아갑니다.\r\n카운터는 변신하지 않았을 때만\r\n사용할 수 있으니 조심합시다.",
  "TUT_TUTORIAL_TEXT_w125": "하얀 늑대의 발자국을\r\n따라가다 보면 목적지에\r\n가까워집니다.\r\n꼼꼼히 찾아보도록 합시다!",
  "TUT_TUTORIAL_TEXT_w025": "숲의 식물을 키우기 위해서는\r\n위치 펄스를\r\n이전보다 길게\r\n사용하지 않으면 안 됩니다.",
  "TUT_TUTORIAL_TEXT_w421": "단, 헤엄칠 수 있는 건\r\n물속성 체셔뿐입니다.\r\n물에 뛰어들면 자동으로\r\n물속성 체셔가 됩니다.",
  "TUT_TUTORIAL_TEXT_ph008": "(기울여서)위치 펄스",
  "TUT_TUTORIAL_TEXT_ph046": "(길게 기울여)위치 펄스",
  "TUT_TUTORIAL_TEXT_w332": "돌속성 체셔는 몸이 단단해\r\n대부분의 공격을 막을 수 있습니다.\r\n단, 공격받을 때마다\r\n마력이 소비됩니다.",
  "TUT_TUTORIAL_TEXT_w321": "나무속성 체셔는 [BTN:R2 ]로\r\n나무의 기술을 쓸 수 있습니다.\r\n위력이 뛰어나니\r\n적극적으로 사용합시다!",
  "TUT_TUTORIAL_TEXT_ch023": "변신 해제",
  "TUT_TUTORIAL_TEXT_ch030": "(길게 눌렀다 떼어)덥석!",
  "TUT_TUTORIAL_TEXT_w080": "인형의 모습으로 돌아간\r\n체셔를 안으면\r\n둘은 함께 이동할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w670": "월드 맵이나 길 안내에 나오는\r\n발자국 마크는\r\n이그니스의 추천 장소입니다.\r\n길을 잃었을 때 가 봅시다.",
  "TUT_TUTORIAL_TEXT_w280": "한번 핵을 부순 티르 너 노그는\r\n마녀의 은신처에서 재도전할 수 있습니다.\r\n놓친 보물 상자가 있더라도\r\n회수할 수 있으니 안심해도 됩니다!",
  "TUT_TUTORIAL_TEXT_ph013": "체셔 던지기",
  "TUT_TUTORIAL_TEXT_ph000": "세레자의 이동",
  "TUT_TUTORIAL_TEXT_ph017": "돌속성의 힘 흡수",
  "TUT_TUTORIAL_TEXT_ph004": "([BTN:L1 ]을 누른 상태로)상자 당기기/밀기",
  "TUT_TUTORIAL_TEXT_w270": "이그니스는 세레자가 한번 방문한\r\n마녀의 은신처로 다시 안내해 줍니다.\r\n한번 갔던 장소라도 다시 가 보면\r\n새로운 발견이 있을지도……?",
  "TUT_TUTORIAL_TEXT_w680": "근처에 로즈메리가 있는 등의 상황에서\r\n체셔를 허그 모드로 들 수 없습니다.\r\n합류할 방법을 생각해 봅시다.",
  "TUT_TUTORIAL_TEXT_w480": "숲에 있는 커다란 버섯은\r\n돌속성 체셔가 발을 구르면\r\n점프에 이용할 수 있으며\r\n높은 곳도 단숨에 오를 수 있습니다!",
  "TUT_TUTORIAL_TEXT_w070": "세레자는 [BTN:L2 ]을 길게 누르면\r\n마계의 가시덩굴을 소환하여, 적을 구속합니다.\r\n이것을 \"가시 바인드\"라고 합니다.\r\n구속하면 마도술 게이지가 줄어듭니다.",
  "TUT_TUTORIAL_TEXT_w170": "요정들이 만들어 내는\r\n환영의 발생원이 바로\r\n\"환영 요역 티르 너 노그\"입니다.\r\n티르 너 노그는 숲 곳곳에 존재합니다.",
  "TUT_TUTORIAL_TEXT_w090": "허그 모드 중, [BTN:L1 ]을 누르면\r\n체셔를 높은 곳으로 던질 수 있습니다.\r\n높은 곳과 아래를 협력해서 조사하면\r\n새로운 길이 열릴지도 모릅니다.",
  "TUT_TUTORIAL_TEXT_ch028": "점프",
  "TUT_TUTORIAL_TEXT_w460": "체셔는 발톱이나 이빨로\r\n공격할 뿐 아니라, 적의 공격을\r\n튕길 수 있습니다.\r\n이것을 \"카운터\"라고 합니다.",
  "TUT_TUTORIAL_TEXT_w560": "도깨비불을 많이 구했으면\r\n도깨비불의 비밀 기지에 있는\r\n코룸에게 가 봅시다.\r\n보답을 받을 수 있을지도 모릅니다.",
  "TUT_TUTORIAL_TEXT_ph010": "(기울여서)위치 펄스",
  "TUT_TUTORIAL_TEXT_ph003": "물 긷기",
  "TUT_TUTORIAL_TEXT_w390": "부서진 물건 가까이에서\r\n[BTN:L2 ]을 누른 상태로 [BTN:LS ]을 돌리면\r\n부서진 물건을 원래 상태로 되돌리는 마도술,\r\n\"레스터레이션\"을 쓸 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w660": "날아다니는 적은 맷집이 약하고,\r\n가시 바인드로 잡기만 해도\r\n쓰러지는 경우가 있습니다.\r\n\"나는 적은 떨어트리는 것\"입니다!",
  "TUT_TUTORIAL_TEXT_w260": "마녀의 은신처에서는\r\n세레자와 체셔의 의상을\r\n변경할 수 있습니다.\r\n기분에 따라 바꾸어 봅시다.",
  "TUT_TUTORIAL_TEXT_w690": "체셔를 기둥에 부딪치게 하여,\r\n진정시킬 틈을 만듭시다.\r\n만약에 기둥이 부서져도\r\n레스터레이션으로 복구할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ph014": "체셔 늘이기",
  "TUT_TUTORIAL_TEXT_ph007": "(길게 눌러)춤추기",
  "TUT_TUTORIAL_TEXT_w160": "요정이 만들어 낸 왜곡된 공간의 안은\r\n여러 환영이 보여 눈을 어지럽힙니다.\r\n[BTN:L2 ]로 주변을 비춰\r\n보이지 않는 것을 찾아냅시다.",
  "TUT_TUTORIAL_TEXT_ph049": "(길게 눌러)적 하나 잡기",
  "TUT_TUTORIAL_TEXT_w490": "사당에 있는 엘레멘트 코어는\r\n체셔의 공격으로 파괴할 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w060": "악마인 체셔는 로즈메리를\r\n넘어갈 수 없습니다.\r\n로즈메리가 있다면 체셔는\r\n다른 길을 찾아봐야 합니다.",
  "TUT_TUTORIAL_TEXT_ph041": "(길게 눌러)가시 바인드",
  "TUT_TUTORIAL_TEXT_w731": "각성한 체셔는\r\n[BTN:L1 ]로 회피하며,\r\n[BTN:R1 ]로 강력한 공격을\r\n펼칩니다.",
  "TUT_TUTORIAL_TEXT_w722": "타임 어택 중에 시계를 주우면,\r\n타임이 조금 줄어듭니다.\r\n반대로 대미지를 받으면,\r\n타임이 늘어나므로 주의합시다.",
  "TUT_TUTORIAL_TEXT_w326": "아시겠지만, 나무속성 체셔로\r\n변신도 [BTN:Y ]입니다.\r\n어떤 변신을 하고 있는지는,\r\n오른쪽 아래에서 볼 수 있습니다.",
  "TUT_TUTORIAL_TEXT_ch024": "변신 해제",
  "TUT_TUTORIAL_TEXT_d003": "이그니스가 추천하는 곳입니다. 목적지로 향할 때 참고합시다.",
  "TUT_TUTORIAL_TEXT_w026": "지금부터 위치 펄스가\r\n몇 번인가 성공할 때까지,\r\n[BTN:L2 ]을 누른 채로 둡니다.\r\n중간에 떼지 않도록 주의합시다!",
  "TUT_TUTORIAL_TEXT_ph018": "물속성의 힘 흡수",
  "TUT_TUTORIAL_TEXT_w031": "체력이 없어지면\r\n세레자는 목숨을 잃고 맙니다.\r\n남은 체력을\r\n자주 확인합시다.",
  "TUT_TUTORIAL_TEXT_w022": "보다 어려운 위치 펄스에 도전!\r\n세레자가 춤출 때,\r\n마크가 빨갛게 이어지는 중에는\r\n[BTN:LS ]을 계속 기울입시다.",
  "TUT_TUTORIAL_TEXT_ch020": "(물속성 체셔)아쿠아스트림",
  "TUT_TUTORIAL_TEXT_ph045": "(길게 눌러)가시 바인드",
  "TUT_TUTORIAL_TEXT_w331": "돌속성 체셔는 [BTN:R1 ]을 누르면\r\n뛰어올라 발을 구릅니다.\r\n그렇게 하면 밑에 있는 것을\r\n찍어 누르거나 부술 수 있습니다.",
  "TUT_TUTORIAL_TEXT_w322": "나무속성 체셔는 [BTN:R1 ]로\r\n혀를 늘여 물건을 잡을 수 있습니다.\r\n[BTN:R1 ]을 길게 누르면\r\n잡은 물건을 끌어당길 수 있습니다."
}
