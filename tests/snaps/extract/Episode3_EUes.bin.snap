{
  "SM_003040_0080_NAR": "Si no regresaba pronto a Inferno,\r\nCheshire moriría. La idea de que\r\nestaban persiguiendo los caprichos\r\nde una niña enamorada le hervía\r\nla sangre.",
  "SM_003035_0020_CER": "—Por cierto,\r\naún no me has dicho cómo te llamas.",
  "SM_003020_0030_NAR": "Cheshire solo pudo negar\r\ncon la cabeza, por temor a que\r\nsu voz delatara su conmoción.",
  "CE_003040_0010_CER": "¡Tengo que ayudarle!",
  "SM_003020_0080_CER": "—Si quiero convertirme en bruja\r\nde Umbra, no puedo asustarme\r\nde lagartos grandullones como ese.\r\n¡La próxima vez venceremos, Cheshire!",
  "SM_003035_0010_CER": "—¿De... verdad? Gracias...",
  "SM_003020_0000_NAR": "Con la armadura hecha jirones,\r\nel dragón dio media vuelta y huyó.",
  "SM_003080_0040_FAS": "—No os habrán herido, ¿verdad?",
  "SM_003010_0040_NAR": "Por una vez, Cheshire\r\nno se burló de ella.",
  "SM_003035_0080_LUC": "—Dado que eres una bruja,\r\ncreo que posees el poder\r\nde romper el hechizo.",
  "SM_003080_0200_FAS": "—Quizás pueda llevaros a un lugar\r\ndonde ya habéis estado.",
  "CE_003050_0000_CER": "Come, venga...\r\n¡Hasta que revientes!",
  "LV_003010_0000_CER": "Eh, esto me suena.",
  "SM_003050_0140_MOR": "—Si esperas salir con vida de\r\ntus futuros enfrentamientos con\r\nmonstruos, no lo olvides.",
  "LV_003910_0040_CER": "Quiero... ¡ser más fuerte!",
  "BK_3000_0030_CER": "—No me asustas...\r\n¡Ya no!",
  "SM_003030_0010_NAR": "Cheshire se fue. Parecía estar\r\ntan desolado como tras el último\r\nencuentro con el monstruo.",
  "SM_003035_0120_LUC": "—Sí... muchas lunas han pasado\r\ny mi madre aún me espera.",
  "BK_3030_0070_CER": "\r\n—¡Cheshire!",
  "LV_003920_0000_CER": "No... no puedo...",
  "SM_003050_0130_MOR": "—El verdadero valor de una bruja\r\nse mide en función de su talento\r\npara controlar a un demonio.",
  "LV_003035_0010_NAR": "Cheshire gruñó para que Cereza\r\navanzase.",
  "SM_003035_0150_LUC": "—Podemos abandonar el bosque\r\njuntos. Te ayudaré a salvar\r\na tu madre.\r\n\r\n¡Nos reuniremos con nuestras\r\nfamilias de nuevo!",
  "LV_003020_0000_CER": "¿Son... zarpazos?",
  "BK_3030_0080_NAR": "Solo era cuestión de tiempo que\r\nCheshire se quedara sin fuerzas.\r\n¿Acabará aquí nuestra historia?",
  "LV_003035_0020_NAR": "Pero Cereza no lograba reunir valor\r\nsuficiente para contestarle.",
  "SM_003030_0050_NAR": "La felicidad de Cereza se había echado\r\na perder antes de empezar siquiera.\r\n",
  "SM_003050_0090_MOR": "—He empezado ya con los preparativos\r\npara sacarte del bosque.",
  "LV_003905_0010_NAR": "El cuerpo del monstruo era duro\r\ncomo el acero. Cheshire gruñó\r\nde frustración.",
  "LV_003040_0000_NAR": "A lo lejos, Cereza atisbaba el Santuario\r\nde Agua. Delante se erigía una extraña\r\nestructura hecha con tubos de metal.",
  "SM_003080_0070_CER": "—Lo sabes, ¿verdad?",
  "CE_003805_0000_CER": "Igual... ¡eso sirve!",
  "BK_3020_0090_NAR": "Al fin sucumbió a su miedo,\r\nagarró a Cheshire y huyó.",
  "LV_003025_0000_NAR": "Un viejo árbol caído\r\nle mostró los dientes a Cereza.",
  "SM_003035_0060_CER": "—Lukaon, ¿quién eres?\r\n¿Por qué me ayudas?",
  "SM_003020_0070_NAR": "En parte, se había dado cuenta\r\nde que, de no ser por Cereza,\r\nahora sería pasto del dragón.\r\n\r\nPero no podía aceptar\r\nque lo hubiera rescatado\r\nalguien a quien despreciaba.",
  "SM_003080_0030_FAS": "—Y habéis destruido otro núcleo\r\nelemental, pero ¿no estáis\r\ncontentos?",
  "LV_003050_0020_NAR": "Pero sabía que era demasiado tarde\r\npara darse la vuelta.",
  "LV_003045_0030_CER": "Yo... Yo...",
  "LV_003915_0000_NAR": "Cereza contuvo las lágrimas y se abalanzó\r\nhacia delante con toda su fuerza.",
  "LV_003050_0010_NAR": "En cuanto pronunció esas palabras,\r\nel miedo se apoderó de ella.",
  "SM_003010_0000_NAR": "Escaparon sanos y salvos,\r\npero Cheshire estaba furioso\r\npor la cobarde retirada de Cereza.",
  "SM_003040_0070_CER": "—Ya sé cómo suena, ¡pero hasta\r\nahora todo ha sido verdad!\r\nLos núcleos elementales eran\r\ncomo decía Lukaon, ¿no?\r\n¡No son solo sueños!",
  "SM_003080_0190_FAS": "—Conozco los senderos\r\nocultos de este bosque.",
  "SM_003080_0000_FAS": "—Bueno, bueno, ¿a quién tenemos\r\naquí? Sinceramente, me sorprende\r\nque hayáis llegado tan lejos.",
  "CE_003020_0000_CER": "¡Ah!",
  "SM_003080_0140_FAS": "—Nadie que se haya adentrado\r\nen ella ha salido jamás con vida.\r\n¿Seguro que quieres ir?",
  "SM_003020_0100_NAR": "El orgulloso demonio se dio media\r\nvuelta y fingió no oírla.",
  "LV_003060_0000_CER": "¡Tengo que ayudar a Cheshire!",
  "SM_003035_0110_CER": "—Tú también estás buscando\r\na tu madre, ¿verdad?",
  "SM_003020_0090_NAR": "Al pronunciar esas palabras,\r\nCheshire notó algo nuevo\r\nen Cereza que no había percibido\r\nen la niña miedosa que conocía.",
  "PH_3020_0000_CER": "¡Debe de haber algo\r\nque pueda hacer para salvarlo!",
  "SM_003080_0170_FAS": "—Si trabajáis en equipo,\r\nquizás no haya motivo\r\nde preocupación.",
  "LV_003075_0020_NAR": "«¿Para qué serían las jaulas?»,\r\nse preguntó Cereza. Pero decidió\r\nque sería mejor no saberlo.",
  "SM_003020_0020_CER": "—Cheshire, ¿te encuentras bien?\r\n¿Estás herido?",
  "SM_003040_0100_CER": "—Ya podrías aprender de Lukaon\r\ncómo tratar a una dama...",
  "SM_003040_0010_NAR": "Cheshire vio que Cereza\r\nse sonrojaba y le lanzó\r\nuna mirada inquisitoria.\r\n",
  "BK_3000_0020_NAR": "Había llegado la hora\r\nde saldar las cuentas.",
  "SM_003050_0120_CER": "—¡S-sí, señora!",
  "LV_003005_0000_CER": "¿Qué es esto?...",
  "LV_003010_0010_NAR": "Ya habían estado antes allí.\r\nSu paseo por el bosque los había\r\nllevado de vuelta al punto de partida.",
  "SM_003080_0100_CER": "—¡Vamos, no nos dejes así!",
  "SM_003080_0090_CER": "—¡Pareces mi maestra!",
  "SM_003035_0180_LUC": "—Siento lo mismo. Nunca había\r\nconocido a nadie que comprendiera\r\nmi dolor... y compartiera mi sueño.",
  "BK_3030_0050_NAR": "Cheshire continuó embistiendo,\r\npero perdía terreno con cada\r\nacometida.",
  "BK_8110_0030_CER": "—No, no te llevará de vuelta a casa,\r\npero seguro que nos ayudará\r\na acercarnos a nuestro objetivo.",
  "SM_003050_0070_NAR": "Que Morgana la elogiara era\r\nmás raro que un iglú en Inferno.\r\nCereza contuvo sus ganas de\r\nsaltar de puro gozo a duras penas.",
  "SM_003050_0000_MOR": "—Cereza, gracias a Sheba\r\nque estás a salvo.",
  "LV_003905_0000_CER": "Ufff... Nada.\r\n¡Es demasiado fuerte!",
  "LV_003910_0050_CES": "¿Y cómo piensas conseguirlo?\r\nTodos saben que no vales para nada.",
  "BK_3030_0130_CER": "—Voy a convertirme en bruja.\r\n¡Tengo que ser fuerte!",
  "BK_3030_0020_NAR": "Casi como por instinto, Cereza\r\nencontró donde esconderse.\r\nSin dudarlo un instante, Cheshire\r\nse abalanzó sobre el enemigo.",
  "SM_003035_0050_LUC": "—Cereza... qué bonito nombre.",
  "BK_3030_0100_CER": "—Aún no... puedo salvar a nadie...",
  "BK_3030_0010_NAR": "[FONT:9 ]¡Ve a esconderte por ahí![FONT:N ],\r\ngritó Cheshire, preparándose.",
  "BK_3030_0090_CER": "—No... No puedo...",
  "SM_003050_0040_NAR": "Cereza explicó cómo había derrotado\r\nal Jabberwock, incapaz de contener\r\nsu alegría infantil.",
  "BK_8110_0000_CER": "—¡Otro elemento!",
  "SM_003020_0050_CER": "—Me pregunto si esa hada volverá.\r\n¡Pero ahora sabemos que no es\r\ninvencible!",
  "CE_003010_0000_CER": "¡Cheshire, hora de usar tu poder\r\nelemental de piedra!",
  "SM_003040_0060_NAR": "Cheshire se quedó sin palabras.\r\n¡¿Que se había adentrado en el\r\nbosque por la vaga promesa\r\nde un niño en un sueño?!",
  "SM_003010_0010_CER": "—(...)",
  "LV_003045_0010_NAR": "Cheshire gritaba bravuconadas\r\npara que Cereza lo escuchara.",
  "LV_003050_0000_CER": "Me pregunto si estaremos\r\nen el territorio del monstruo.",
  "LV_003080_0010_CER": "¡Por favor, llévame\r\nal último núcleo elemental!",
  "_31": "",
  "LV_003045_0020_NAR": "Eso no la tranquilizaba.",
  "SM_003080_0130_FAS": "—Dentro de una fortaleza\r\nque solo las hadas\r\nmás mezquinas habitan.",
  "BK_3020_0000_NAR": "Las alas del monstruo eran tan duras\r\nque, en comparación, las garras\r\nde Cheshire parecían de juguete.",
  "SM_003035_0160_CER": "—Lukaon...\r\nComprendo. ¡Haré lo que pueda!",
  "BK_3000_0010_CER": "—¡El monstruo!",
  "SM_003035_0085_LUC": "—Y lo que es más...",
  "LV_003910_0060_CER": "Mamá... ¡Mi madre creía en mí!",
  "LV_003920_0020_CER": "Aaa...\r\nBasta...\r\n¡Silencio!",
  "LV_003070_0020_NAR": "Cheshire refunfuñó entre dientes.\r\nArdía en deseos de luchar.",
  "SM_003035_0100_LUC": "—Tu sueño...\r\nDeseas salvar a tu madre, ¿verdad?\r\nConozco demasiado bien esa pena.",
  "SM_003080_0210_FAS": "—Si queréis que os guíe,\r\nsolo tenéis que decirlo.",
  "SM_003030_0030_NAR": "Cheshire gruñó que los\r\nmovimientos de Cereza\r\nle habían dificultado luchar.",
  "SM_003035_0130_LUC": "—¡Quiero ir con ella\r\ny secar sus lágrimas!",
  "LV_003920_0010_CER": "¡¿Q-qué?!",
  "LV_003065_0000_CER": "Parece un trozo de su pellejo...\r\n¡Así que no es invencible!",
  "LV_003070_0010_NAR": "[FONT:10 ]Ni que yo me fuera a dar\r\nmedia vuelta ahora.[FONT:N ]",
  "SM_003080_0220_FAS": "—Será mi modo de daros\r\nlas gracias por encargaros\r\nde esas hadas molestas.",
  "SM_003030_0000_NAR": "Habían vencido al infame Jabberwock.\r\nCereza no cabía en sí de la emoción.",
  "SM_003030_0080_CER": "—¡Ah!",
  "SM_003050_0030_CER": "—¡He derrotado a un monstruo gigante!\r\n¡Ojalá lo hubieras visto!",
  "CE_003040_0000_CER": "¡¡¡Cheshire!!!",
  "SM_003010_0060_NAR": "[FONT:9 ]¡Aparta de mi camino![FONT:N ],\r\nfue todo lo que se le ocurrió decir.",
  "SM_003040_0090_NAR": "[FONT:9 ]¡Si no logro regresar a Inferno,\r\nlo último que haré en este\r\nmiserable mundo será\r\ndespedazarte![FONT:N ],\r\nrugió, furioso, el demonio.",
  "SM_003040_0020_CER": "—¿Eh?\r\nNo es nada.\r\n\r\nEn cualquier caso, ahora que tengo\r\nla ocasión, he de explicarte algo.",
  "SM_003010_0050_NAR": "Recordó el combate.\r\nHasta entonces nunca lo habían\r\nvencido, y el sabor de la derrota\r\nno le gustaba lo más mínimo.",
  "LV_003075_0010_CER": "Míralas...",
  "SM_003010_0020_NAR": "Cereza apretaba los puños\r\nen silencio. Más que nada, estaba\r\nenfadada consigo misma por haberse\r\nrendido a su miedo una vez más.",
  "SM_003020_0060_NAR": "Cereza había recuperado\r\nla confianza en sí misma\r\ntras el combate. Cheshire\r\nestaba de mal humor.",
  "SM_003080_0020_FAS": "—Nunca hubiera imaginado\r\nque una bruja podría derrotarlo.",
  "LV_003025_0010_NAR": "Cereza no podía dejar de pensar\r\nque el bosque de Ávalon tramaba\r\nalgo contra ella.",
  "BK_3020_0080_NAR": "[FONT:9 ]¡Niñata enclenque![FONT:N ]\r\nSu aspecto de muñeco no hacía\r\nmenos hirientes sus palabras.",
  "LV_003030_0000_CER": "¡¿Qué ha sido eso?!",
  "SM_003080_0010_FAS": "—Lograsteis deshaceros incluso\r\ndel monstruoso Jabberwock,\r\nviolento hasta para las hadas.",
  "SM_003035_0040_CER": "—Yo soy Cereza.",
  "SM_003080_0180_FAS": "—Yo también estoy harta\r\nde esas hadas crueles.\r\n¡Ojalá les deis su merecido!",
  "SM_003050_0200_CER": "—¡No tienes remedio!",
  "LV_003900_0000_CER": "¡Yujuuu!\r\n¡Estoy volando!",
  "LV_003915_0010_NAR": "«No puedo llorar... ¡Tengo que ser\r\nfuerte!», se dijo en voz baja para\r\nque Cheshire no la oyera.",
  "SM_003035_0140_LUC": "—Cereza, rompe el hechizo,\r\nte lo ruego. Si destruyes\r\nel último núcleo elemental\r\ny vienes al corazón del bosque,\r\nmi sueño... ¡nuestro sueño\r\npodrá hacerse realidad!",
  "LV_003020_0010_CER": "Imposible... No existe nada que tenga\r\nzarpas tan grandes... ¿verdad?",
  "LV_003035_0000_NAR": "[FONT:10 ]¿No querías encontrar el siguiente núcleo\r\nelemental? ¿A qué esperas?[FONT:N ]",
  "SM_003080_0050_CER": "—No, estamos bien.",
  "SM_003050_0150_NAR": "Cuando Morgana desapareció,\r\nCheshire gruñó enfadado.",
  "LV_003910_0020_CER": "Ya no... ¡No quiero seguir huyendo!",
  "SM_003050_0110_MOR": "—El poder de la magia de las hadas\r\nque protege Ávalon es inmenso.\r\nPara hacerle frente, es necesario\r\nun hechizo de la misma magnitud.\r\nYa he iniciado el encantamiento,\r\npero no estará completo hasta\r\nel anochecer. Has de sobrevivir\r\nhasta entonces.",
  "SM_003080_0060_CER": "—Oye, ¿y si nos dices dónde\r\nencontrar el último núcleo?",
  "LV_003040_0010_NAR": "Era una jaula tan grande que dentro\r\ncabría la casa de Morgana entera.",
  "LV_003055_0000_CER": "Nos acercamos...\r\nFalta poco, lo sé.",
  "SM_003050_0080_MOR": "—Creo que estás preparada\r\npara aprender técnicas mágicas\r\nmás poderosas. Con ellas podrás\r\naprovechar la verdadera fuerza\r\nde tu acompañante.",
  "LV_003910_0000_CES": "Siempre huyendo. ¿Así es\r\ncomo planeas llegar a ser bruja?",
  "CE_003030_0000_CER": "Oh, oh, y ahora, ¿qué?\r\n¿Lo hemos enfadado?",
  "SM_003050_0050_MOR": "—Es un milagro que escaparas\r\nilesa. ¡Te dije que buscaras\r\nun lugar seguro y esperases allí!",
  "SM_003030_0090_NAR": "Interrumpieron su discusión\r\npara salir corriendo tras\r\nel lobo blanco.",
  "SM_003035_0030_LUC": "—Soy Lukaon.\r\n¿Y tú?",
  "LV_003070_0000_CER": "No pienso seguir huyendo.\r\n¡Vamos, Cheshire!",
  "SM_003030_0020_CER": "—¿Qué te pasa esta vez?\r\n¡Hemos ganado!",
  "SM_003035_0000_LUC": "—Has logrado vencer al feroz\r\nJabberwock. Es difícil creer\r\nque seas la misma niña\r\nque encontré llorando sola\r\nen una oscura pesadilla.\r\nTe has vuelto más fuerte.",
  "BK_3030_0040_NAR": "El ataque fue certero,\r\npero, una vez más,\r\nla bestia quedó ilesa.",
  "LV_003920_0030_NAR": "[FONT:10 ]¡Espabila! ¡Muévete![FONT:N ]\r\nEl demonio rugió, intentando\r\nsacar a Cereza de su estupor.",
  "SM_003050_0010_NAR": "La proyección de Morgana\r\nvolvió a aparecerse.\r\n\r\nParecía aliviada.",
  "SM_003050_0100_CER": "—¿Qué?",
  "SM_003050_0060_MOR": "—Pero reconozco mi sorpresa.\r\nQuizás hayas crecido más\r\nde lo que pensaba.",
  "LV_003005_0010_CER": "¿Nos estaba observando alguien?...",
  "LV_003910_0030_CES": "Tienes miedo, ¿verdad?\r\n¡Vete a llorar al rincón, cobarde!",
  "SM_003050_0180_NAR": "Cheshire resopló a modo\r\nde respuesta.",
  "BK_3000_0000_NAR": "Ñam, ñam...",
  "PH_3020_0010_CER": "¡Allí!",
  "SM_003035_0090_CER": "—¿Qué?",
  "LV_003075_0000_NAR": "Había jaulas rotas por todas partes.",
  "LV_003060_0010_CER": "Debe de haber algo que pueda hacer.",
  "BK_3020_0060_NAR": "Cheshire intentó desesperadamente\r\ntransformarse, pero la magia de Cereza\r\nera inestable y no lo logró.",
  "CE_003020_0010_CER": "¡Agh!",
  "SM_003040_0000_NAR": "Un nuevo encuentro con Lukaon.\r\nAl recordar el sueño, el corazón\r\nde Cereza latió con más fuerza.",
  "SM_003010_0070_CER": "—(...)",
  "LV_003015_0000_CER": "Caray, qué alto... No pasa nada.\r\nPero... evita... mirar abajo.",
  "SM_003040_0110_CER": "—¡No he dicho nada!\r\nVamos a buscar el núcleo.",
  "SM_003080_0160_FAS": "—Esperemos...",
  "BK_3020_0050_NAR": "El hada dragontina perseguía a su presa como\r\nsi de un halcón cazando ratones se tratara.",
  "LV_003045_0000_NAR": "[FONT:10 ]La próxima vez que esa cosa se aparezca\r\npor aquí, la pienso hacer picadillo.[FONT:N ]",
  "LV_003080_0000_CER": "¡El lobo blanco!\r\nMe alegro de que estés bien.",
  "SM_003050_0210_NAR": "Y así, el buen humor\r\nde Cereza desapareció\r\ntan rápido como había llegado.",
  "SM_003010_0080_NAR": "Absorta en su propia\r\ndesesperación, Cereza\r\napenas oyó sus palabras.",
  "SM_003080_0110_FAS": "—Ay, ay, ay...",
  "SM_003080_0080_FAS": "—Pequeña... como suelo decir,\r\nlas prisas no son buena compañía.",
  "SM_003020_0040_CER": "—Menos mal...",
  "SM_003035_0170_CER": "—Quiero saber más sobre ti.\r\n¡Tenemos mucho en común!",
  "SM_003080_0120_FAS": "—El último núcleo elemental\r\nestá en un parte complicada\r\ndel bosque.",
  "BK_3020_0010_NAR": "Encontró un nuevo objetivo.\r\nCereza sabía que debía luchar,\r\npero el miedo la había paralizado.",
  "SM_003010_0030_CER": "—Los ataques de Cheshire\r\nno parecieron hacer mella\r\nen la armadura del monstruo...\r\n\r\n¿Qué voy a hacer?",
  "SM_003040_0040_NAR": "Cereza relató a Cheshire los motivos\r\npor los que se había adentrado en el\r\nbosque de Ávalon. Que Lukaon se le\r\napareció en sueños; que ella quería\r\nsalvar a su madre; y que buscaba\r\nun poder escondido en lo más\r\nprofundo del bosque.",
  "CE_003000_0000_CER": "¡Venga, déjame ayudar!",
  "BK_3030_0120_CER": "—¡Basta de huir!",
  "SM_003035_0070_LUC": "—Estoy atrapado en el corazón\r\ndel bosque por un poderoso hechizo.",
  "SM_003050_0170_CER": "—Bueno, Morgana siempre habla así.\r\nNo te preocupes: sé que no eres\r\nuna simple arma.\r\n\r\nPero tampoco pasaría nada si me\r\nhicieras caso de vez en cuando.",
  "SM_003080_0150_CER": "—¡Pues claro que sí! Soy bruja,\r\ny mucho más poderosa que\r\ncuando entré en el bosque.",
  "SM_003050_0020_MOR": "—Te veo... diferente, Cereza.\r\n¿Ha ocurrido algo?",
  "BK_8110_0010_CER": "—¿Qué ocurre?\r\n¿Ya no te interesa\r\nobtener un nuevo poder?",
  "BK_3030_0000_NAR": "Se encontraron cara a cara\r\ncon el monstruo de nuevo.",
  "CE_003800_0000_CER": "Eso seguro que hace pupa...\r\n¡Concéntrate! ¡Hay que avanzar!",
  "BK_3030_0110_CER": "—¡No, esta vez, no!",
  "SM_003030_0060_CER": "—¿Te das cuenta de que has vencido\r\na esa cosa gracias a mí? ¡Podrías estar\r\nun pelín agradecido!"
}
