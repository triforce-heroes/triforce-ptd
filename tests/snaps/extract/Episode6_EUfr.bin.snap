{
  "SM_006010_0000_NAR": "Ils étaient enfin arrivés. Lukaon,\r\nle garçon du rêve de Cereza, les\r\nattendait comme promis. Mais\r\ncontrairement à sa version\r\nonirique, ce Lukaon-ci était pâle\r\net amorphe.",
  "BK_8200_0080_NAR": "[FONT:9 ]T'avais raison. Tout seul,\r\nje serais pas allé loin.\r\nMerci.[FONT:N ]",
  "SM_006010_0250_LUC": "« Lorsque le sceau sera brisé et\r\nque j'aurai recouvré mes pouvoirs\r\nféériques, nous pourrons quitter\r\nla forêt ensemble ! Je t'aiderai à\r\nsauver ta mère... s'il te plaît... »",
  "PH_6010_0010_NAR": "Au loin, ils virent la barrière qui ceignait\r\nla forêt se briser en éclats. Une magie\r\nd'une telle ampleur ne pouvait être\r\nque l'œuvre de Morgana !",
  "SM_006010_0190_NAR": "Incapables de tuer Lukaon, mais\r\nredoutant la résurgence de sa lignée\r\nroyale, les fées rebelles scellèrent\r\nson corps à l'aide d'un puissant\r\nsortilège.",
  "BK_6040_0010_NAR": "Il semblait que jusqu'à la dernière des\r\nfées d'Avalon se tenait là devant\r\nCereza. Ses genoux se mirent à\r\ntrembler, mais peu lui importaient\r\nses chances, elle ne flancherait pas.",
  "BK_6020_0130_NAR": "Mais avant que Púca n'eut fini sa\r\nphrase, Morgana mit un terme à\r\nson existence d'un coup fatal.",
  "BK_6030_0090_LUC": "« S'il te plaît, maman, arrête.\r\nÇa me fait trop de peine\r\nde te voir ainsi. »",
  "BK_6020_0020_CER": "« Chouchou ! »",
  "BK_6020_0100_NAR": "C'était une technique de magie\r\nque Cereza avait déjà vue.",
  "BK_6020_0090_NAR": "Quelque chose balaya les fées\r\ncomme des feuilles au vent.",
  "CE_006805_0000_CER": "Courage, Chouchou...\r\nN'abandonne pas !",
  "BK_8200_0030_CER": "« Notre... aventure ? »",
  "SM_006040_0120_MOR": "« Oh, je vois. Tu t'es fait\r\nun nouvel... ami, c'est cela ? »",
  "SM_006010_0120_CER": "« Une humaine... et une fée ? »",
  "BK_6040_0020_NAR": "Quand soudain...",
  "SM_006030_0170_POO": "« Soit. Il mourra quoi qu'il arrive.\r\nEt quand aura péri la lignée royale,\r\nil n'y aura plus quiconque pour\r\nnous faire de l'ombre ! »",
  "SM_006010_0360_CER": "« Sacrifier Chouchou ?\r\nPas question, c'est mon ami ! »",
  "CE_006060_0000_CER": "Pas moyen !",
  "BK_6000_0040_CER": "« Tu veux vraiment sacrifier\r\nChouchou ? Non, je t'en supplie ! »",
  "BK_6100_0000_CER": "« Chouchou ! »",
  "SM_006030_0060_NAR": "C'était Púca, le roi autoproclamé.\r\nIl ne semblait pas accompagné de\r\nsa cour. Ses atours avaient vu de\r\nmeilleurs jours, mais son élocution\r\nn'avait rien perdu de sa superbe.",
  "LV_006020_0000_CER": "Allez, Chouchou ! On y est presque !",
  "CE_006150_0000_CER": "Gnn... ahh !",
  "BK_6030_0000_CER": "« Morgana... Je sais que je\r\nn'ai pas été une bonne élève. »",
  "BK_6000_0030_CER": "« Lukaon, qu'est-ce que tu fais ? »",
  "BK_6020_0210_CER": "« Morgana ? »",
  "SM_006030_0130_CER": "« Non, Lukaon, ne fais pas ça ! »",
  "SM_006030_0090_POO": "« Et guidés par notre lueur féérique,\r\nnul besoin d'un loup pour vous orienter.\r\nLaissez là cette bête puante. »",
  "CE_006050_0000_CER": "C'est à nous !",
  "SM_006020_0010_LUC": "« Mon âme ne peut plus maintenir\r\ncette forme... je savais que cette\r\nchance serait ma dernière. »",
  "SM_006010_0310_CER": "« Pardon ?! »",
  "CE_006160_0000_CER": "Aahhh !",
  "LV_006010_0000_CER": "Ils arrivent ! Laisse-les-moi !",
  "SM_006010_0050_LUC": "« Non, je suis ici. Ce que tu\r\nvois dans ce cristal n'est\r\nqu'une coquille vide... »",
  "SM_006010_0280_CER": "« Qu-Quoi ?\r\nVraiment ? »",
  "SM_006010_0400_CER": "« Je veux vraiment t'aider mais\r\nje ne peux pas faire ça. »",
  "BK_6020_0170_NAR": "Morgana ne dit rien. Elle caressait\r\ndoucement la fourrure du loup.",
  "SM_006020_0000_NAR": "Dans les yeux de Lukaon, le tourment\r\navait fait place à une douce admiration.",
  "SM_006010_0380_LUC": "« Regarde-le ! Les démons sont\r\ndes créatures infernales qui se\r\nrepaissent des âmes humaines !\r\nVous, les sorcières, devez utiliser\r\nleur pouvoir comme outil ou\r\ncomme arme, et c'est tout ! »",
  "CE_006820_0010_NAR": "[FONT:10 ]Il va payer pour ça.\r\nRécupérons ce qu'il a volé ![FONT:N ]",
  "BK_6010_0010_CER": "« Lukaon ! »",
  "SM_006040_0080_NAR": "Ce n'était pas la première fois\r\nque Morgana tançait Cereza.\r\nMais cette fois, c'était différent.\r\nCe n'était pas sa professeure\r\nstricte qui s'exprimait, mais une\r\npersonne remplie de haine.",
  "BK_8200_0070_CER": "« Chouchou... »",
  "SM_006010_0220_LUC": "« Je ne pouvais qu'errer dans\r\nla forêt en me raccrochant aux\r\nsouvenirs de ma vie humaine.\r\n\r\nMais, Cereza, il existe un moyen\r\nde briser la malédiction. »",
  "SM_006010_0430_CER": "« Lukaon... »",
  "CE_006090_0000_CER": "C'est tout ?!",
  "BK_6040_0030_CER": "« Chouchou ! »",
  "SM_006040_0050_NAR": "Le tonnerre grondait au loin.\r\nLe vent hurlait à travers les arbres.\r\nL'air était glacial.",
  "BK_8200_0020_NAR": "[FONT:9 ]Ah. Alors c'est la fin de notre aventure, c'est ça ?[FONT:N ]\r\nLe démon semblait déçu.",
  "SM_006030_0140_LUC": "« C'est pour le mieux, Cereza.\r\nIci s'arrête mon histoire... »",
  "CE_006810_0000_CER": "Si on fait équipe, personne\r\nne pourra nous arrêter !",
  "BK_6020_0120_POO": "« Infâme sorcière ! J'aurais\r\ndû me douter que tu... »",
  "BK_6020_0000_NAR": "Échappant aux fées, le duo parvint\r\nà sortir de la forêt !",
  "BK_6020_0110_CER": "« Morgana ! »",
  "CE_006010_0000_CER": "Plus vite, Chouchou !",
  "SM_006020_0050_CER": "« Lukaon... »",
  "CE_006120_0000_CER": "Tu n'abandonneras pas, Morgana, hein ?",
  "SM_006010_0350_LUC": "« Pardon ? Et pourquoi pas ? »",
  "SM_006010_0090_NAR": "Et c'était dans ce corps que\r\nLukaon les avait guidés à\r\ntravers la forêt.",
  "BK_8200_0090_CER": "\r\n« Attends, Chouchou !\r\nJ'ai promis de te renvoyer\r\nchez toi, et je tiendrai parole ! »",
  "SM_006010_0010_CER": "« L-Lukaon ? »",
  "IN_6000_0100_MOR": "Cette vitesse... Im-Impossible !",
  "SM_006030_0070_CER": "« On est pas d'humeur à supporter\r\ntes charades. Va-t'en ! »",
  "BK_6000_0050_NAR": "Entendant le désespoir dans la voix\r\nde Cereza, Lukaon hésita un instant...\r\nMais il avait pris sa décision.",
  "SM_006010_0110_LUC": "« Mon sang. Je suis né\r\nd'une humaine et d'une fée. »",
  "CE_005160_0000_CER": "« Allons-y, Chouchou ! »",
  "SM_006010_0080_LUC": "« N'aie pas peur...\r\nMon corps a été scellé, mais\r\nmon âme vagabonde librement\r\ndans le corps de ce loup. »",
  "SM_006010_0260_CER": "« Un pouvoir spécial que seules les\r\nsorcières possèdent ? Dis-moi\r\ncomment je peux t'aider ! »",
  "BK_8210_0000_NAR": "Les amis se protègent mutuellement.",
  "CE_006000_0010_CER": "Que faire... ?",
  "SM_006030_0040_CER": "« Toi ! »",
  "BK_6020_0230_MOR": "« Comment oses-tu... \r\nComment oses-tu dire\r\ncela après ce que tu lui\r\nas fait, petite idiote ! »",
  "BK_6000_0100_CER": "« Je croyais qu'on pourrait être amis ! »",
  "BK_6030_0050_NAR": "[FONT:9 ]Ressaisis-toi. Elle est\r\nnotre ennemie ![FONT:N ]\r\nChouchou poussa\r\nCereza à se relever.",
  "SM_006030_0000_CER": "« Mais bien sûr ! Si on t'amène à ma\r\nprofesseure, elle trouvera forcément\r\nle moyen de te sauver ! »",
  "BK_6020_0200_NAR": "Morgana exprimait quelque chose\r\ndont Cereza ne la savait pas\r\ncapable. De la chaleur... de l'amour.",
  "BK_6030_0060_NAR": "Morgana pouvait attaquer\r\nà tout instant. Mais Cereza\r\nn'arrivait pas à bouger.",
  "SM_006030_0110_NAR": "Quand elle entendit ses mots, Cereza\r\ncomprit. C'était Púca qui avait trahi\r\nle roi des fées. C'était Púca qui avait\r\ndéchiré la famille de Lukaon et l'avait\r\ncondamné à errer dans la forêt, seul.",
  "SM_006030_0030_POO": "« Prodigieux !\r\nC'est touchant de pathétisme ! »",
  "SM_006020_0020_CER": "« Non... »",
  "BK_6020_0150_CER": "« Ce loup est en fait l'esprit\r\nd'un garçon ! »",
  "BK_6020_0040_NAR": "Capturés par les fées, ils\r\nfurent lentement ramenés\r\ndans la forêt.",
  "SM_006040_0010_NAR": "Le courroux de Morgana semblait\r\ngrandir à chaque instant. Elle\r\ns'avança vers Cereza et Chouchou.",
  "BK_8200_0060_NAR": "[FONT:9 ]Je voulais m'excuser pour\r\nce que j'ai fait dans la forêt.[FONT:N ]",
  "SM_006040_0090_CER": "« Morgana, j-je... »",
  "SM_006010_0170_NAR": "Mais une faction de mauvaises\r\nfées conspira contre lui. Après\r\navoir tué le roi de sang-froid,\r\nelles s'en prirent à sa femme\r\net au jeune Lukaon.",
  "BK_6010_0000_NAR": "Coupé du pouvoir de Chouchou,\r\nLukaon tenait à peine sur ses\r\njambes. C'est alors...",
  "SM_006040_0060_MOR": "« Les innombrables jeunes\r\nfilles que j'ai leurrées dans\r\nla forêt... après des années\r\nd'entraînement... tout ça\r\npour rien ! »",
  "CE_006820_0000_CER": "Chouchou !",
  "SM_006010_0140_NAR": "Et le garçon raconta à Cereza\r\nson passé tragique.",
  "CE_006020_0000_CER": "Esquive, Chouchou !",
  "BK_6020_0160_CER": "« Si on ne fait rien, il va mourir.\r\nS'il te plaît, Morgana, est-ce\r\nque tu peux le sauver ? »",
  "CE_006110_0000_CER": "Retour à l'envoyeur !",
  "BK_6000_0060_CER": "« Chouchou ! »",
  "SM_006010_0030_LUC": "« Bienvenue, Cereza.\r\n\r\nJe savais que tu viendrais. »",
  "BK_6030_0140_MOR": "« Quel dommage. Tu aurais pu\r\ndevenir une sorcière talentueuse,\r\nCereza, si seulement tu t'étais\r\nendurcie. Mais tu as toujours\r\nété bien trop sentimentale ! »",
  "BK_6030_0020_CER": "« Tu étais stricte, mais j'ai toujours\r\nsu que tu avais de l'affection pour\r\nmoi. Tu as été... comme une mère. »",
  "SM_006030_0150_CER": "« Ne laisse pas tomber, Lukaon ! »",
  "BK_6030_0130_NAR": "Sans changer d'expression,\r\nelle écarta son fils.",
  "CE_006815_0000_CER": "Si je détruis ça... je devrais\r\npouvoir libérer Chouchou !",
  "SM_006030_0160_CER": "« On ne te laissera pas\r\nl'emporter, compris ?\r\n\r\nEt au fait, je savais que tu mentais\r\nquand tu disais être roi ! »",
  "BK_6030_0010_CER": "« Je faisais beaucoup\r\nd'erreurs à l'entraînement.\r\nJe désobéissais.\r\nJ-Je t'ai déçue... »",
  "SM_006020_0040_LUC": "« Chouchou, c'est ça ?\r\nPardonne mon comportement. Le\r\nmonstre sans cœur... c'était moi. »",
  "BK_6100_0010_CER": "",
  "SM_006010_0340_CER": "« Que... Je... Je ne peux pas ! »",
  "BK_8210_0030_CER": "« Je suis une sorcière de\r\nl'Umbra, comme ma mère. »",
  "BK_8200_0085_NAR": "Cereza fut touchée par les\r\nparoles étonnantes du démon.",
  "BK_6040_0000_NAR": "Au signal de Púca, un nombre\r\nterrifiant de fées jaillit de l'ombre.",
  "SM_006010_0180_NAR": "Sa mère parvint à sauver l'esprit\r\nde Lukaon avant d'être jetée hors\r\ndu royaume des fées, bannie à\r\njamais.",
  "SM_006010_0100_CER": "« Tu as été scellé ? Mais pourquoi ? »",
  "PH_6010_0000_NAR": "Soudain, ils entendirent un craquement\r\nassourdissant et un éclair illumina le ciel.",
  "SM_006010_0240_LUC": "« Oh, Cereza, quel bonheur que\r\ntu sois arrivée ici saine et sauve.\r\nJe t'en supplie, aide-moi à sortir\r\nde ce cauchemar. »",
  "BK_8200_0010_CER": "« Qu'est-ce que je peux bien faire ?\r\nJe ne peux pas battre Morgana ! »",
  "SM_006040_0100_MOR": "« Espèce de bonne à rien...\r\n\r\nLukaon et moi serons réunis de\r\nnouveau. Tu vas me remettre ce\r\ndémon pitoyable immédiatement ! »",
  "CE_006070_0000_CER": "Allez, Chouchou !",
  "SM_006010_0270_LUC": "« Ah, Cereza, tu as déjà apporté\r\nexactement ce qu'il me faut ! »",
  "SM_006040_0130_MOR": "« Un démon né une année\r\nbissextile à la pleine lune...\r\nIl est la clé qui brisera la\r\nmalédiction de Lukaon !\r\nCereza... j'ai attendu trop\r\nlongtemps pour laisser\r\ndes caprices d'enfant\r\ntout gâcher ! »",
  "SM_006010_0020_NAR": "Alors qu'elle prononçait son\r\nnom, Cereza entendit la voix\r\nfaible de Lukaon.",
  "CE_006140_0000_CER": "Au revoir, Morgana...",
  "BK_6030_0120_LUC": "« Maman... Maman ! »",
  "SM_006040_0020_CER": "« Morgana, qu'est-ce que tu\r\ndis ? Qu'est-ce qu'il y a ? »",
  "BK_8200_0050_CER": "« Quoi ? »",
  "BK_6040_0040_NAR": "La masse grouillante des fées\r\nà ses talons, Chouchou galopait\r\nvers le pilier de lumière.",
  "SM_006030_0010_LUC": "« Quoi ? »",
  "CE_006040_0000_CER": "Baisse-toi !",
  "SM_006010_0060_NAR": "Cereza et Chouchou sursautèrent.\r\nLa voix de Lukaon provenait du\r\nloup blanc.",
  "SM_006010_0230_LUC": "« Pour cela, il faut un pouvoir spécial\r\nque seules les sorcières possèdent.\r\n\r\nAlors quand une sorcière entrait dans\r\nla forêt, mon espoir renaissait !\r\nJ'essayais de les guider jusqu'ici, mais... »",
  "SM_006020_0030_LUC": "« Je croyais que les démons étaient\r\ntous des créatures sans cœur.\r\nJe m'étais trompé. »",
  "BK_6030_0100_MOR": "« Sois sans crainte, mon\r\nchéri. Bientôt, tout sera\r\ncomme avant. »",
  "BK_8210_0040_CER": "« Accorde-moi cette danse ! »",
  "SM_006010_0210_NAR": "L'histoire de Lukaon rappelait\r\nson propre passé à Cereza.\r\nSon cœur saignait pour lui.",
  "BK_6000_0010_CER": "« Il doit y avoir un autre moyen.\r\nJe vais t'aider à le trouver ! »",
  "LV_006005_0000_NAR": "Chouchou courait comme le vent.\r\nCereza sentait sa chaleur dans sa\r\ncrinière. Plus rien ne les arrêterait.",
  "BK_6000_0090_NAR": "Cereza savait ce qu'elle devait faire.",
  "SM_006030_0080_POO": "« Allons, nul besoin de querelle !\r\nMes sujets se feront un plaisir de\r\nvous escorter à l'orée de la forêt. »",
  "CE_006080_0000_CER": "Pas assez rapide !",
  "BK_8210_0020_NAR": "L'hésitation et la peur dans les yeux\r\nde Cereza avaient cédé la place au\r\ncourage et à la détermination.",
  "_00": "",
  "SM_006030_0050_POO": "« Au nom de la forêt d'Avalon,\r\nvous avez notre éternelle gratitude.\r\nEt même les arbres chanteront\r\nvos prouesses, c'est une certitude ! »",
  "CE_006800_0000_CER": "Lukaon, tu n'auras pas\r\nChouchou !",
  "BK_6020_0220_MOR": "« Tu veux le sauver ? »",
  "CE_006000_0000_CER": "On ne peut pas échapper à Morgana...",
  "BK_8210_0010_NAR": "Les amis tiennent leurs promesses.",
  "SM_006010_0130_LUC": "« Sois sans crainte.\r\nToutes les fées ne sont pas\r\nmauvaises. Moi, je veux vivre\r\nen harmonie avec les humains.\r\nEt c'est ce qui m'a valu d'être\r\npuni. »",
  "CE_006130_0000_CER": "Mais moi non plus !",
  "BK_6000_0070_NAR": "Le prince des fées avait\r\ncapturé Chouchou et\r\nabsorbait son énergie vitale.",
  "BK_6020_0180_NAR": "Interloquée, Cereza regarda\r\nsa professeure.",
  "LV_006025_0000_CER": "Il ne faut jamais provoquer... une sorcière !",
  "BK_6020_0005_NAR": "Ou du moins le croyaient-ils...",
  "SM_006040_0030_MOR": "« Ce n'est pas encore clair ?\r\nL'entraînement, le bracelet...\r\nle rêve ? »",
  "SM_006010_0370_LUC": "« Ton ami ? Ce démon ?\r\nCereza, mais que racontes-tu ? »",
  "BK_8200_0000_NAR": "[FONT:9 ]Eh bien ? T'abandonnes\r\nsans combattre ?[FONT:N ]\r\n\r\nLa voix de Chouchou résonna\r\ndans la tête de Cereza.",
  "SM_006040_0000_MOR": "« Cereza... Pourquoi ce démon est-il\r\nencore là ? N'as-tu pas atteint l'autel ?\r\n\r\nPourquoi crois-tu que je t'ai\r\nentraînée, toutes ces années ? »",
  "SM_006010_0160_NAR": "Le roi était aimé de ses sujets,\r\net cherchait un moyen de vivre\r\nen harmonie avec les humains.",
  "LV_006015_0000_CER": "Attention, Chouchou !",
  "SM_006040_0070_MOR": "« J'étais si proche, cette fois.\r\nMais il a fallu que tu gâches\r\ntout, sale petite égoïste ! »",
  "BK_6000_0020_LUC": "« Tu ne comprends pas...\r\nC'est ma dernière chance ! »",
  "SM_006010_0330_LUC": "« Vite, je dois absorber le pouvoir du\r\ndémon. Pour qu'enfin... la malédiction\r\nsoit brisée ! »",
  "SM_006010_0070_CER": "« P-Pourquoi le loup blanc\r\nparle comme Lukaon ? »",
  "BK_6020_0050_NAR": "Refusant de céder, Cereza\r\ns'accrochait de toutes ses\r\nforces. Mais alors...",
  "CE_005140_0000_CER": "« Je suis là, Chouchou, tout va bien.\r\nDéchaîne toute ta puissance ! »",
  "BK_6020_0140_CER": "« Morgana !\r\n\r\nJe sais, j'ai désobéi, je suis\r\nvraiment désolée. Mais s'il te\r\nplaît, gronde-moi plus tard. »",
  "SM_006030_0120_LUC": "« Espèce de monstre ! Assez...\r\nJe ne fuirai plus. Mais en échange,\r\nlaisse partir ces deux-là. »",
  "SM_006040_0040_MOR": "« As-tu la moindre idée du temps\r\nque j'ai passé à me préparer au\r\nretour de mon cher Lukaon ? »",
  "CE_006820_0020_CER": "OK ! Allons-y !",
  "SM_006010_0300_LUC": "« Ce démon est parfait. Il fera tout à\r\nfait l'affaire pour briser la malédiction ! »",
  "SM_006010_0150_NAR": "Lukaon était le dernier prince\r\ndes fées, fils de l'ancien roi\r\net de sa femme humaine.",
  "BK_6010_0020_NAR": "Un démon héroïque ? Jamais\r\nun tel altruisme n'avait été cité\r\nde toute l'histoire de l'Enfer.\r\nMais Cereza comprenait.",
  "SM_006010_0290_LUC": "« Oui ! Tu m'as apporté\r\nl'objet du sacrifice ! »",
  "SM_006010_0040_CER": "« Attends, Lukaon.\r\nJe vais te sortir de là. »",
  "BK_8200_0040_NAR": "[FONT:9 ]Comment voudrais-tu que\r\nj'appelle tout ce chemin parcouru\r\npour sauver ta mère ? Tu m'as tant\r\nparlé d'elle que j'avais presque\r\nenvie de la rencontrer...[FONT:N ]\r\nChouchou marqua une pause.",
  "SM_006010_0410_LUC": "« Incroyable... »",
  "SM_006030_0020_CER": "« Il est encore temps.\r\nViens, il faut que tu la voies.\r\n\r\nTu ne mourras pas ici, Lukaon ! »",
  "BK_6030_0030_MOR": "« Disparais ! »",
  "SM_006030_0180_POO": "« Ô fidèles sujets, l'enfant maudit est\r\nenfin à notre merci ! L'astre du roi\r\nusurpateur a sombré, chassé des\r\ncieux par l'astre de Púca ! »",
  "BK_6000_0080_CER": "« Et moi qui te faisais confiance ! »",
  "SM_006010_0390_CER": "« C'est faux. Chouchou n'est pas\r\nun objet. C'est un être vivant avec\r\nses propres pensées, ses rêves !\r\nOn est arrivés ici ensemble, alors\r\nje ne vais pas le laisser tomber et\r\nle sacrifier comme un agneau ! »",
  "BK_6010_0030_LUC": "« Vous deux... »",
  "BK_6000_0000_NAR": "Cereza vit le visage de Lukaon\r\npasser en un instant de l'espoir\r\nà l'accablement.\r\nElle voulait tant l'aider...",
  "SM_006010_0200_CER": "« Tes parents... Tu as traversé\r\ntant d'épreuves, Lukaon. »",
  "SM_006010_0320_NAR": "Cereza n'en croyait pas ses oreilles.\r\nSacrifier Chouchou ?",
  "CE_006030_0000_CER": "Saute !",
  "SM_006030_0100_NAR": "Púca convoitait l'esprit de Lukaon,\r\net le pouvoir royal qu'il contenait.",
  "SM_006010_0420_LUC": "« Désolé, Cereza, mais tu\r\nne me laisses pas le choix. »",
  "BK_6030_0070_NAR": "C'est alors que quelque chose\r\nfit s'arrêter net Morgana.\r\nUsant ses dernières forces,\r\nLukaon avait attrapé sa robe.",
  "CE_006100_0000_CER": "Prends ça !",
  "BK_6030_0021_CER": "« Je voulais juste que\r\ntu sois fière de moi ! »"
}
