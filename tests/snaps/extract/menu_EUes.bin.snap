{
  "MENU_HELP_TXT_019_01": "Una técnica que permite recuperar\r\nmagia más rápido al usar el modo\r\nabrazo durante un combate.",
  "MENU_HELP_TXT_103_02": "Al volver al modo abrazo,\r\nCheshire recupera vitalidad.",
  "MENU_HELP_TXT_115_01": "Permite a Cheshire embestir\r\ncontra el enemigo tras mantener\r\ny soltar [BTN:R2 ] en el modo\r\ndesatado.",
  "MENU_HELP_TXT_021_01": "Una técnica que permite a Cheshire\r\nrechazar proyectiles al extenderlo\r\nen el modo abrazo con [BTN:RS ].",
  "MENU_HELP_TXT_204_01": "En el archivo puedes leer datos\r\nsobre los personajes o enemigos\r\nque hayas conocido en el viaje,\r\nentre otras cosas.",
  "MENU_SKILLTREE_DIALOG_TXT_01": "Aquí puedes probar las técnicas\r\nadquiridas. ¿Quieres entrar en la\r\nsala de entrenamiento?",
  "MENU_HELP_TXT_212_02": "Para aprender nuevas técnicas,\r\nCereza necesita rosas de ónix\r\ny Cheshire, gotas de Ávalon.",
  "MENU_HELP_TXT_104_01": "Los ataques de Cheshire en\r\ncualquiera de sus formas\r\nelementales son más potentes\r\nque los de su forma normal.",
  "MENU_HELP_TXT_112_02": "Cheshire desatado puede\r\nesquivar con [BTN:L1 ] y ejecutar\r\nataques devastadores con [BTN:R1 ].",
  "MENU_HELP_TXT_249_01": "Al seleccionar «Sendas de Ignis»,\r\nse guiará a Cereza hacia\r\nel santuario más cercano\r\na su siguiente objetivo.",
  "MENU_HELP_TXT_008_01": "Los objetos tienen diversos tipos\r\nde efectos útiles. Para usar uno,\r\nmantén pulsado el botón de\r\ndirección correspondiente ([BTN:DP ]).",
  "MENU_HELP_TXT_215_01": "La mecánica con la que Cereza\r\ntransporta a Cheshire en su forma\r\nde muñeco de trapo recibe\r\nel nombre de «modo abrazo».",
  "MENU_HELP_TXT_211_01": "Cereza y Cheshire pueden cambiar\r\nde atuendo desde el menú de\r\npreparativos. Al cumplirse ciertos\r\nrequisitos, recibes nuevos atuendos.",
  "MENU_HELP_TXT_207_02": "Acércate a un santuario para\r\ndesbloquearlo y que se añada\r\nal mapa. Procura desbloquear\r\ntodos los que encuentres.",
  "MENU_SKILLTREE_TXT_327": "Mantén pulsado [BTN:L2 ] mientras giras [BTN:LS ]\r\npara restaurar objetos\r\na su condición original.",
  "MENU_HELP_TXT_229_01": "Tras socorrerlos, algunos fuegos\r\nfatuos seguirán a Cereza, pero\r\nten cuidado: si sufren daño,\r\ncaerán derrotados al instante.",
  "MENU_SKILLTREE_TXT_423": "Ejecuta un ataque especial\r\nde fuego al final de un combo\r\nde bridas con Cheshire ígneo.",
  "MENU_HELP_TXT_129_01": "Cheshire puede tirar de Cereza\r\ncon [BTN:RS ] mientras esté extendido\r\nen el modo abrazo para que\r\nambos vayan más rápido.",
  "MENU_SKILLTREE_TXT_427": "Los ataques de Cheshire infligen\r\naún más daño.",
  "MENU_HELP_TXT_216_02": "En el modo desatado, Cereza\r\nse mueve con [BTN:LS ], y Cheshire,\r\ncon [BTN:RS ].",
  "MENU_HELP_TXT_025_01": "En este Pulso Brujo, mueve\r\ny mantén [BTN:LS ] mientras el marcador\r\nse mueve por la línea roja.",
  "MENU_SKILLTREE_TXT_330": "Permite llevar muchos más objetos.",
  "MENU_SKILLTREE_TXT_323": "Permite llevar aún más objetos.",
  "MENU_HELP_TXT_111_01": "Como es un demonio, Cheshire no\r\npuede atravesar zonas donde haya\r\nromero. En esos lugares tendrás\r\nque encontrar otra ruta para él.",
  "MENU_HELP_TXT_107_02": "Agarra algo con la lengua\r\nde enredadera y mantén\r\npulsado [BTN:R1 ] para atraerlo\r\nhacia ti.",
  "MENU_HELP_TXT_238_01": "El cuerno de unicornio cristalizado\r\nadquiere un color rojo y se utiliza\r\ncomo ingrediente en pociones.",
  "MENU_HELP_TXT_207_01": "Los arcos rojos que encontrarás\r\nen el bosque representan\r\nsantuarios, lugares clave\r\npara orientarte en Ávalon.",
  "MENU_HELP_TXT_022_01": "Una técnica que produce una\r\nsacudida que aturde a los enemigos\r\ncercanos al recoger a Cheshire\r\ncuando está en forma de muñeco.",
  "MENU_SKILLTREE_TXT_324": "Al extender a Cheshire con [BTN:RS ],\r\nrechazas los proyectiles enemigos.",
  "MENU_SKILLTREE_TXT_420": "Cereza monta en Cheshire\r\nusando su magia para estabilizar\r\nel poder desatado del demonio.",
  "MENU_HELP_TXT_116_01": "Mantén pulsado [BTN:R2 ] y suéltalo\r\npara que Cheshire ejecute una\r\nembestida cerca de un enemigo\r\ndebilitado y acabe con él.",
  "MENU_SKILLTREE_TXT_424": "En el modo abrazo\r\npulsa [BTN:R2 ] para que Cheshire\r\ngolpee al enemigo y este se\r\ndistraiga brevemente.",
  "MENU_HELP_TXT_216_01": "También es posible invocar a Cheshire\r\ny moverlo de forma independiente\r\na Cereza. Esto recibe el nombre\r\nde «modo desatado».",
  "MENU_POSEMENU_DIALOG_TXT_03": "Se perderá el progreso que no hayas\r\nguardado. ¿Seguro que quieres ir\r\na la pantalla del título?",
  "MENU_HELP_TXT_107_01": "Pulsa [BTN:Y ] para pasar a la forma\r\nde Cheshire vegetal, en la que\r\npuede extender la lengua de\r\nenredadera con [BTN:R1 ].",
  "MENU_HELP_TXT_999_01": "(?)",
  "MENU_SKILLTREE_TXT_320": "Aumenta más la velocidad\r\na la que se rellena el indicador\r\nde recarga de artes.",
  "MENU_HELP_TXT_109_03": "Cheshire acuático también puede\r\nnadar. Si cambias a alguna otra\r\nforma en el agua, volverá a su forma\r\nacuática automáticamente.",
  "MENU_SKILLTREE_TXT_328": "Pulsa [BTN:L1 ] en el modo abrazo para\r\nque Cereza transmita energía\r\nmágica a Cheshire y su barra\r\nde magia se rellene de inmediato.",
  "MENU_HELP_TXT_103_01": "La vitalidad de Cheshire es\r\nlimitada y, cuando se agota,\r\nvuelve a su forma\r\nde muñeco de trapo.",
  "MENU_HELP_TXT_212_01": "Para enseñar nuevas técnicas\r\na Cereza y Cheshire, usa [BTN:L1 ]\r\nante cualquiera de los espejos que\r\nse encuentran cerca de los faroles.",
  "MENU_SKILLTREE_DIALOG_TXT_02": "¿Quieres dejar de practicar?",
  "MENU_HELP_TXT_112_01": "Con su magia, Cereza puede\r\nestabilizar el poder demoniaco\r\nde Cheshire y montar a su lomo\r\nen algunas situaciones.",
  "MENU_HELP_TXT_249_02": "Cuando te desorientes, ve a\r\nzonas señaladas con la huella del\r\nlobo. Es probable que encuentres\r\nsu rastro en las cercanías.",
  "MENU_HELP_TXT_104_02": "Los ataques elementales pueden\r\ntener efectos especiales, como\r\neliminar los escudos del enemigo.",
  "MENU_HELP_TXT_215_02": "En el modo abrazo Cereza se mueve\r\ncon [BTN:LS ]. Puedes extender a Cheshire\r\ncon [BTN:RS ] para que agarre objetos\r\ncercanos.",
  "MENU_HELP_TXT_203_01": "En la sección de estado puedes\r\nver cómo se encuentran Cereza\r\ny Cheshire y qué objetos tienes.",
  "MENU_HELP_TXT_026_01": "Mientras ejecutes el Pulso Brujo,\r\ninclina [BTN:LS ] dos veces\r\nrápidamente cuando los dos\r\ncírculos queden alineados.",
  "MENU_SKILLTREE_TXT_413": "Pulsa dos veces [BTN:L1 ] para que Cheshire\r\nregrese de inmediato al modo abrazo\r\nmientras embiste a los enemigos\r\nque encuentre por el camino.",
  "MENU_HELP_TXT_108_03": "Cheshire pétreo tiene una piel\r\nmuy dura que puede devolver\r\ncasi todos los ataques, aunque\r\nesto consume magia.",
  "MENU_HELP_TXT_102_01": "Cheshire puede destrozar cosas\r\na zarpazos con [BTN:R2 ]. Es útil\r\npara quitar maleza, o para romper\r\nvasijas u otros objetos.",
  "MENU_HELP_TXT_221_03": "Dentro de un tír na nÓg puedes\r\npulsar [BTN:START ] para abrir un menú\r\nque te permite salir y regresar\r\nal bosque.",
  "MENU_HELP_TXT_213_01": "Al aprender técnicas, pulsa [BTN:SELECT ]\r\npara ir a una sala de entrenamiento\r\ndonde puedes probar las nuevas.",
  "MENU_SKILLTREE_TXT_304": "Si pasas al modo abrazo\r\ndurante un combate,\r\nrecuperarás magia\r\npoco a poco.",
  "MENU_SKILLTREE_TXT_317": "Ralentiza aún más el movimiento\r\nde los enemigos atrapados con\r\nuna brida espinosa.",
  "MENU_HELP_TXT_009_02": "Al atrapar así a un enemigo se agotará\r\nel indicador de recarga de artes.\r\nVolverá a cargarse poco a poco\r\ny también al usar algunos objetos.",
  "MENU_HELP_TXT_113_01": "En el modo desatado, Cheshire\r\npuede rechazar ataques con [BTN:R1 ],\r\npero al hacerlo consume magia.",
  "MENU_HELP_TXT_105_02": "Cheshire recupera magia\r\ngradualmente en el modo\r\nabrazo.",
  "MENU_HELP_TXT_027_01": "Algunos enemigos voladores son\r\nmuy débiles y puedes derrotarlos\r\nfácilmente con la brida espinosa.",
  "MENU_SKILLTREE_TXT_404": "Usa [BTN:R3 ] para esquivar\r\ncon Cheshire.",
  "MENU_SKILLTREE_TXT_417": "Ejecuta un ataque especial de\r\npiedra al final de un combo\r\nde bridas con Cheshire pétreo.",
  "MENU_HELP_TXT_202_01": "En la sección del mapa puedes\r\nusar [BTN:Y ] para cambiar\r\nentre la vista del mapa del mundo\r\ny la del nivel.",
  "MENU_HELP_TXT_023_01": "Una técnica que aumenta la cantidad\r\nde objetos que puedes llevar.",
  "MENU_HELP_TXT_206_01": "Pulsa [BTN:L1 ] cerca de los faroles para\r\nacceder al menú de preparativos,\r\ndonde puedes guardar la partida,\r\nentre otras cosas.",
  "MENU_HELP_TXT_210_02": "Para preparar una pócima, antes\r\ntienes que encontrar el objeto\r\ncorrespondiente para usarlo de\r\nreferencia. ¡Mantente alerta!",
  "MENU_CHALLENGE_TXT_12": "Elige el tír na nÓg contrarreloj\r\nal que te quieras enfrentar.",
  "MENU_CHALLENGE_TXT_01": "Vuelve a probar un tír na nÓg\r\nque ya hayas completado.",
  "MENU_SKILLTREE_TXT_308": "Cuando uses la brida espinosa\r\ncon un enemigo, se ralentizarán\r\nsus movimientos.",
  "MENU_HELP_TXT_228_02": "Para abrir algunas puertas, se\r\nrequiere un número determinado\r\nde fuegos fatuos. Comprueba que\r\nno hayas olvidado ayudar a alguno.",
  "MENU_HELP_TXT_117_01": "Recupera magia al derrotar\r\na enemigos con ¡Ñam!",
  "MENU_HELP_TXT_217_01": "Pulsa [BTN:L1 ] para cambiar al modo\r\nabrazo y devolver a Cheshire\r\na su forma de muñeco de trapo.",
  "MENU_HELP_TXT_106_01": "Absorbe energía elemental\r\ncon [BTN:L1 ]. Si absorbes suficiente,\r\nla barra de magia de Cheshire\r\naumentará permanentemente.",
  "MENU_SKILLTREE_TXT_408": "Extiende a Cheshire con [BTN:RS ]\r\nhacia donde te estés moviendo\r\npara aumentar ligeramente\r\ntu velocidad.",
  "MENU_HELP_TXT_110_02": "Este ataque puede quemar\r\nalgunos objetos y derretir hielo.\r\nAdemás, Cheshire ígneo\r\natraviesa el fuego sin sufrir daño.",
  "MENU_HELP_TXT_210_01": "Desde el menú de preparativos\r\npuedes combinar ingredientes\r\npara preparar pócimas que\r\nluego podrás usar.",
  "MENU_SKILLTREE_TXT_318": "Después de ciertos ataques,\r\natrapa a un enemigo para\r\naumentar el daño y el tiempo\r\nque está inmovilizado.",
  "MENU_HELP_TXT_228_01": "Si encuentras puertas fatuas,\r\npuedes abrirlas con la ayuda\r\nde los fuegos fatuos.",
  "MENU_CHALLENGE_TXT_11": "Elige el tír na nÓg que\r\nquieras volver a probar.",
  "MENU_CHALLENGE_TXT_02": "Enfréntate a diversas\r\nmisiones contrarreloj.",
  "MENU_HELP_TXT_101_01": "Mueve a Cheshire con [BTN:RS ].\r\nCheshire salta automáticamente\r\npor encima de los obstáculos\r\npequeños mientras se mueve.",
  "MENU_HELP_TXT_128_01": "Permite a Cheshire cambiar de\r\nelemento mientras continúa el\r\ncombo. Se activa pulsando [BTN:A ], [BTN:B ], [BTN:X ]\r\no [BTN:Y ] durante un ataque o esquiva.",
  "MENU_HELP_TXT_217_02": "En el modo abrazo, pulsa [BTN:R1 ]\r\npara invocar a Cheshire\r\ny pasar al modo desatado.",
  "MENU_HELP_TXT_201_01": "Abre el menú con [BTN:START ].\r\nPara desplazarte entre\r\nlas secciones del mapa, archivo,\r\nestado y sistema, usa [BTN:L1 ] y [BTN:R1 ].",
  "MENU_HELP_TXT_024_01": "Una técnica que aumenta el efecto\r\nde todas las pociones.",
  "MENU_HELP_TXT_110_01": "Pulsa [BTN:A ] para pasar a la forma\r\nde Cheshire ígneo, en la que puede\r\nusar el piroestallido con [BTN:R1 ].",
  "MENU_SKILLTREE_TXT_418": "Usa ¡Ñam! para acabar con\r\nun enemigo y recupera algo\r\nde magia.",
  "MENU_HELP_TXT_239_01": "La salamandra cristalizada\r\nadquiere un color amarillo\r\ny se utiliza como ingrediente\r\nen pociones.",
  "MENU_SKILLTREE_TXT_510": "Aumenta el tamaño del área\r\nde acción de la brida espinosa.",
  "MENU_HELP_TXT_018_01": "Una técnica que permite recuperar\r\nmagia poco a poco al usar el modo\r\nabrazo durante un combate.",
  "MENU_HELP_TXT_114_01": "Esta técnica permite a Cheshire\r\nencadenar un ataque adicional\r\npulsando [BTN:R2 ] tras ejecutar\r\ncon éxito un contrataque.",
  "MENU_SKILLTREE_TXT_403": "Mantén pulsado [BTN:R2 ] y suéltalo\r\npara ejecutar una embestida\r\ncerca de un enemigo debilitado\r\ny acabar con él.",
  "MENU_SKILLTREE_TXT_410": "Ejecuta un ataque especial de\r\nvegetación al final de un combo\r\nde bridas con Cheshire vegetal.",
  "MENU_HELP_TXT_205_01": "En el menú de sistema puedes\r\ncargar otra partida guardada,\r\nconsultar los consejos de viaje\r\no cambiar diversos ajustes.",
  "MENU_HELP_TXT_020_01": "Pulsa [BTN:L1 ] en el modo abrazo para\r\nque Cereza transmita energía\r\nmágica a Cheshire y su barra\r\nde magia se rellene de inmediato.",
  "MENU_SKILLTREE_TXT_314": "Recoge a Cheshire para ocasionar\r\nuna sacudida que aturda a los\r\nenemigos cercanos.",
  "MENU_HELP_TXT_226_03": "Para comprobar a qué fuegos\r\nfatuos has ayudado puedes\r\nechar un vistazo en la sección\r\ncorrespondiente del menú.",
  "MENU_HELP_TXT_105_01": "El indicador que tiene Cheshire\r\nencima de la cabeza representa\r\nla magia y disminuye al usar\r\nciertas técnicas.",
  "MENU_SKILLTREE_TXT_303": "Mantén pulsado [BTN:L2 ] para atrapar al\r\nenemigo entre espinas. Para volver\r\na usarla, el indicador de recarga\r\nde artes debe estar lleno de nuevo.",
  "MENU_SKILLTREE_TXT_310": "Aumenta la capacidad del indicador\r\nde recarga de artes y permite que\r\nCereza emplee la brida espinosa\r\ndos veces seguidas.",
  "MENU_HELP_TXT_009_01": "Mantén pulsado [BTN:L2 ] cerca de un\r\nenemigo para ejecutar la brida\r\nespinosa e inmovilizarlo\r\ntemporalmente.",
  "MENU_HELP_TXT_248_01": "La partida se guarda de forma\r\nautomática en los faroles y varios\r\npuntos de la historia: fíjate en el\r\nicono de la parte inferior derecha.",
  "MENU_SKILLTREE_TXT_407": "Pulsa [BTN:R2 ] mientras esquivas\r\npara abalanzarte sobre el enemigo.",
  "MENU_SKILLTREE_TXT_414": "Cambia de elemento con\r\nCheshire mientras esquivas\r\no atacas para que se transforme\r\nmientras continúa el combo.",
  "MENU_HELP_TXT_202_02": "La niebla que cubre parte\r\ndel mapa se puede disipar\r\nal cumplir ciertos requisitos.",
  "MENU_HELP_TXT_214_01": "Habla con Ignis para viajar\r\nrápidamente hacia santuarios\r\nque Cereza haya visitado\r\ncon anterioridad.",
  "MENU_SKILLTREE_TXT_419": "Los ataques de Cheshire infligen\r\nmás daño.",
  "MENU_HELP_TXT_225_01": "Busca con [BTN:L1 ] para guardar\r\nrecuerdos de lugares especialmente\r\nmemorables del viaje de Cereza\r\ny Cheshire.",
  "MENU_HELP_TXT_241_01": "Al recoger una, se rellena\r\nel indicador de recarga\r\nde artes para que puedas\r\nvolver a usarlas antes.",
  "MENU_CHALLENGE_DIALOG_TXT_02": "¿Quieres jugar a este tír na nÓg?",
  "MENU_HELP_TXT_222_02": "Si no cumples las condiciones\r\nde una misión determinada,\r\nno superarás el tír na nÓg.",
  "MENU_HELP_TXT_234_01": "Las rosas de ónix son flores\r\nprocedentes de lo más profundo\r\nde Inferno. Cereza las necesita\r\npara aprender nuevas técnicas.",
  "MENU_HELP_TXT_250_01": "A veces, como cuando haya romero\r\ncerca o Cheshire se encuentre lejos,\r\nCereza no podrá llamarlo con\r\nel modo abrazo.",
  "MENU_HELP_TXT_011_01": "Una técnica que aumenta la\r\nmagia que se recupera al atrapar\r\na un enemigo con la brida\r\nespinosa.",
  "MENU_HELP_TXT_125_01": "Con esta técnica Cheshire\r\npuede abalanzarse sobre\r\nel enemigo al pulsar [BTN:R2 ]\r\nmientras esquiva.",
  "MENU_HELP_TXT_029_01": "Es necesario ejecutar el Pulso\r\nBrujo con éxito varias veces para\r\nque surta efecto. Mantén pulsado [BTN:L2 ]\r\nhasta completar el proceso.",
  "MENU_HELP_TXT_208_01": "Puedes guardar la partida desde\r\nel menú de preparativos, aunque\r\nel juego dispone de una función\r\nde guardado automático.",
  "MENU_HELP_TXT_121_01": "Cambia el último ataque\r\nde un combo de bridas a\r\nun ataque especial de\r\npiedra.",
  "MENU_SKILLTREE_TXT_406": "Usa una embestida cuando Cereza\r\ntenga a un enemigo atrapado para\r\nejecutar un potente combo.",
  "MENU_SKILLTREE_TXT_415": "Cheshire podrá sufrir más daño\r\nantes de volver a su forma de\r\nmuñeco.",
  "MENU_HELP_TXT_230_01": "Da un pisotón a las setas grandes\r\ncon Cheshire pétreo para llegar\r\nde un salto a lugares que de otro\r\nmodo serían inalcanzables.",
  "MENU_HELP_TXT_015_01": "Mantén [BTN:L2 ] mientras giras [BTN:LS ] cerca\r\nde un objeto roto para usar la\r\nmagia restauradora y devolverlo\r\ntemporalmente a su estado original.",
  "MENU_HELP_TXT_119_01": "Ejecuta un potente ataque de\r\namplio alcance al pulsar [BTN:R2 ] al\r\nfinal de un combo de bridas.",
  "MENU_HELP_TXT_226_02": "Algunos fuegos fatuos podrían\r\npedirte algún favor. Si los\r\nayudas, quizás te den algo\r\na cambio.",
  "MENU_SKILLTREE_TXT_302": "Usa la brida espinosa con\r\nun enemigo para recuperar\r\nun poco de magia.",
  "MENU_SKILLTREE_TXT_311": "Permite recuperar magia\r\nmás rápido cuando estés\r\nusando el modo abrazo.",
  "MENU_SKILLTREE_TXT_306": "Aumenta ligeramente la velocidad\r\na la que se rellena el indicador de\r\nrecarga de artes.",
  "MENU_SKILLTREE_TXT_315": "Permite recuperar más magia\r\nal acertar con una brida espinosa.",
  "MENU_HELP_TXT_130_01": "En el modo abrazo, Cheshire\r\npuede golpear al enemigo\r\ncon [BTN:R2 ] para distraerlo\r\nbrevemente.",
  "MENU_HELP_TXT_219_01": "Huellas que el lobo blanco\r\nha dejado por todo el bosque.\r\nAl acercarte, se revela parte\r\ndel camino que debes seguir.",
  "MENU_SKILLTREE_TXT_402": "Mantén pulsado [BTN:R2 ] para acumular\r\nenergía y suéltalo para que Cheshire\r\nse abalance sobre el enemigo.",
  "MENU_HELP_TXT_108_01": "Pulsa [BTN:B ] para pasar a la forma\r\nde Cheshire pétreo, en la que\r\npuede dar pisotones potentes\r\ncon [BTN:R1 ].",
  "MENU_SKILLTREE_TXT_411": "Usa [BTN:R2 ] para asestar\r\nun ataque adicional\r\ntras un contrataque.",
  "MENU_HELP_TXT_004_01": "Los iconos de flor de la esquina\r\ninferior izquierda representan la\r\nvitalidad de Cereza, que disminuye\r\ncuando esta sufre ataques.",
  "MENU_HELP_TXT_245_01": "Perfume de Umbra en un frasco con\r\nforma de luna creciente. Mantén [BTN:DP_R ]\r\npara que Cheshire tenga energía\r\nmágica ilimitada temporalmente.",
  "MENU_HELP_TXT_221_01": "Las ilusiones de las hadas tienen\r\nsu origen en los llamados tír na nÓg\r\nque hay por todo el bosque.",
  "MENU_SKILLTREE_TXT_405": "Permite a Cheshire sufrir\r\nmás daño antes de volver\r\na su forma de muñeco.",
  "MENU_SKILLTREE_TXT_416": "Ejecuta un ataque especial\r\nde agua al final de un combo\r\nde bridas con Cheshire acuático.",
  "MENU_HELP_TXT_242_01": "Cristal con forma de luna creciente\r\nimbuido de poder. Recoge uno para\r\nrestaurar algo de energía mágica.",
  "MENU_HELP_TXT_226_01": "Encontrarás fuegos fatuos\r\natrapados en todo tipo de\r\nlugares. Cuando veas\r\nalguno, pulsa [BTN:L1 ] para liberarlo.",
  "MENU_HELP_TXT_003_01": "Pulsa [BTN:L2 ] cerca del objetivo y luego\r\ninclina [BTN:LS ] en la dirección correcta\r\ny en el momento adecuado\r\npara ejecutar el Pulso Brujo.",
  "MENU_SKILLTREE_TXT_301": "Mantén pulsado [BTN:L2 ] mientras\r\nmueves [BTN:LS ] en el momento\r\nadecuado para imbuir de magia\r\nlas plantas y otros objetos.",
  "MENU_SKILLTREE_TXT_312": "Permite llevar más objetos.",
  "MENU_HELP_TXT_219_02": "Las huellas del lobo blanco\r\nguían a Cereza hacia su próximo\r\nobjetivo. Si no encuentras\r\nel camino, búscalas.",
  "MENU_HELP_TXT_126_01": "Pulsa [BTN:R1 ] en el modo abrazo justo\r\nantes de un ataque enemigo para\r\nllamar a Cheshire y que contrataque\r\nmientras pasa al modo desatado.",
  "MENU_HELP_TXT_004_02": "Cuando la vitalidad de Cereza\r\nse haya agotado por completo,\r\nacaba la partida. ¡No pierdas de\r\nvista la vitalidad que le queda!",
  "MENU_HELP_TXT_221_02": "Destruye el núcleo que se encuentra\r\nen el corazón de los tír na nÓg\r\npara romper la ilusión.",
  "MENU_HELP_TXT_012_01": "Con esta técnica, el indicador\r\nde recarga de artes se rellena\r\nmás rápido.",
  "MENU_HELP_TXT_237_01": "La raíz de mandrágora\r\ncristalizada adquiere\r\nun color verde y se utiliza\r\ncomo ingrediente en pociones.",
  "MENU_SKILLTREE_TXT_401": "Pulsa [BTN:R1 ] con Cheshire para que\r\nrechace algunos ataques.",
  "MENU_HELP_TXT_108_02": "El pisotón se puede utilizar\r\na modo de ataque o para\r\naplastar, desenterrar o voltear\r\nobjetos.",
  "MENU_HELP_TXT_016_01": "Esquiva un ataque en el último\r\nmomento con [BTN:L1 ] para activar\r\nel Tiempo Brujo y moverte a gran\r\nvelocidad durante unos instantes.",
  "MENU_HELP_TXT_233_01": "Las gotas de Ávalon son dulces\r\ntrocitos de magia cristalizados,\r\ny Cheshire los necesita para\r\naprender nuevas técnicas.",
  "MENU_SKILLTREE_TXT_409": "Pulsa [BTN:R2 ] al final de un combo\r\nde bridas para ejecutar un potente\r\nataque de amplio alcance.",
  "MENU_CHALLENGE_DIALOG_TXT_01": "¿Quieres usar objetos para\r\ndesbloquear este tír na nÓg?",
  "MENU_HELP_TXT_122_01": "Cambia el último ataque\r\nde un combo de bridas a\r\nun ataque especial de\r\nagua.",
  "MENU_HELP_TXT_250_02": "Investiga los alrededores\r\ny busca el modo de reunir\r\na los dos compañeros.",
  "MENU_SKILLTREE_TXT_309": "Usa [BTN:L3 ] para esquivar\r\ncon Cereza.",
  "MENU_HELP_TXT_222_01": "Algunos tír na nÓg tienen misiones\r\nen las que hay que cumplir ciertos\r\nrequisitos.",
  "MENU_HELP_TXT_246_01": "Poción en un frasco puntiagudo.\r\nMantén [BTN:DP_D ] para producir\r\nuna sacudida que aturda\r\na los enemigos cercanos.",
  "MENU_HELP_TXT_007_01": "En el modo abrazo puedes lanzar\r\na Cheshire hacia zonas más altas\r\npulsando [BTN:L1 ]. A veces será necesario\r\nsepararse para avanzar.",
  "MENU_HELP_TXT_133_01": "Aumenta la potencia de ataque\r\nde Cheshire y afecta a todos\r\nsus ataques.",
  "MENU_HELP_TXT_232_01": "Cheshire puede destruir los núcleos\r\nelementales atacándolos. Para\r\ncumplir la misión de Cereza,\r\ndestruye todos los que encuentres.",
  "MENU_SKILLTREE_TXT_332": "Aumenta la capacidad del indicador\r\nde recarga de artes al máximo y\r\npermite que Cereza emplee la brida\r\nespinosa cuatro veces seguidas.",
  "MENU_HELP_TXT_017_01": "Una técnica que permite a Cereza\r\nesquivar ataques con [BTN:L3 ].",
  "MENU_SKILLTREE_TXT_425": "Ocasionalmente, los enemigos\r\ndejarán caer objetos al ser\r\natacados con un golpe peluche.",
  "MENU_HELP_TXT_123_01": "Cambia el último ataque\r\nde un combo de bridas a\r\nun ataque especial de\r\nfuego.",
  "MENU_SKILLTREE_TXT_525": "Aumenta más el tamaño del área\r\nde acción de la brida espinosa.",
  "MENU_SKILLTREE_TXT_532": "Aumenta aún más el tamaño del área\r\nde acción de la brida espinosa.",
  "MENU_HELP_TXT_010_02": "El cepo espinoso atrapa por más\r\ntiempo al enemigo y este sufre más\r\ndaño que con la brida espinosa.\r\nAsí Cheshire puede vencerlo antes.",
  "MENU_HELP_TXT_006_01": "Pulsa [BTN:L2 ] para usar las Artes de\r\nUmbra de Cereza. Cualquier objetivo\r\npotencial cercano quedará fijado\r\nautomáticamente.",
  "MENU_HELP_TXT_247_01": "Si en alguna ocasión te desorientas,\r\nbusca las luces guía que flotan por\r\nel bosque y que indican el camino\r\nhacia un santuario cercano.",
  "MENU_HELP_TXT_223_01": "Algunas hadas se protegen\r\ncon barreras durante el combate.\r\nLos ataques normales\r\nno sirven en estos casos.",
  "MENU_SKILLTREE_TXT_421": "En el modo abrazo, permite invocar\r\na Cheshire con [BTN:R1 ] justo antes de\r\nrecibir un ataque enemigo para que\r\ncontrataque mientras se transforma.",
  "MENU_HELP_TXT_132_01": "La vitalidad de Cheshire\r\naumenta con esta técnica.",
  "MENU_SKILLTREE_TXT_325": "Aumenta aún más la capacidad\r\ndel indicador de recarga de artes\r\ny permite que Cereza emplee la\r\nbrida espinosa tres veces seguidas.",
  "MENU_HELP_TXT_209_02": "En algunos tír na nÓg puedes\r\nacceder al modo contrarreloj.\r\nDependiendo de tu rendimiento,\r\npodrías obtener recompensas.",
  "MENU_HELP_TXT_002_01": "Cereza puede interactuar con\r\ndistintos objetos pulsando [BTN:L1 ].",
  "MENU_HELP_TXT_227_01": "Cuando hayas rescatado a\r\nsuficientes fuegos fatuos, ve\r\na ver a Colm en el refugio y\r\nquizás te dé una recompensa.",
  "MENU_HELP_TXT_243_01": "Pócima de Umbra en un frasco con\r\nforma de pétalo. Mantén [BTN:DP_U ] para\r\nque Cereza recupere un poco\r\nde vitalidad.",
  "MENU_HELP_TXT_127_01": "Pulsa [BTN:L1 ] rápidamente dos veces para\r\nque Cheshire vuelva rápidamente al\r\nmodo abrazo, chocándose contra los\r\nenemigos que se crucen a su paso.",
  "MENU_SKILLTREE_TXT_329": "Permite recuperar aún más magia\r\nal acertar con una brida espinosa.",
  "MENU_HELP_TXT_236_01": "Las perlas lunares contienen pura\r\nenergía mágica cristalizada que se\r\npuede usar para enseñar a Cereza\r\nciertas técnicas muy potentes.",
  "MENU_HELP_TXT_109_02": "El torrente acuático tiene un\r\nlargo alcance y puede empujar\r\nobjetos y extinguir el fuego.",
  "MENU_HELP_TXT_013_01": "Una técnica que ralentiza\r\nel movimiento de los enemigos\r\nmientras ejecutas la brida\r\nespinosa.",
  "MENU_HELP_TXT_209_01": "Desde el menú de preparativos\r\npuedes volver a enfrentarte a\r\ntír na nÓg ya completados para\r\nintentar encontrar más tesoros.",
  "MENU_HELP_TXT_120_01": "Cambia el último ataque\r\nde un combo de bridas a\r\nun ataque especial de\r\nvegetación.",
  "MENU_HELP_TXT_014_01": "Aumenta la capacidad del indicador\r\nde recarga de artes para que\r\nCereza pueda usar la brida\r\nespinosa varias veces seguidas.",
  "MENU_HELP_TXT_112_03": "También puede usar ataques\r\nelementales potentes con\r\n[BTN:A ], [BTN:B ], [BTN:X ] o [BTN:Y ].",
  "MENU_HELP_TXT_231_01": "Absorbe poder elemental con [BTN:L1 ].\r\nSolo es posible absorber poder\r\nuna única vez de una misma fuente.",
  "MENU_HELP_TXT_118_01": "En el modo desatado, ejecuta\r\nun ataque potente al usar una\r\nembestida sobre un rival atrapado\r\ncon [BTN:R2 ].",
  "MENU_HELP_TXT_227_02": "Cuando Colm tenga algo que\r\ndecirte, aparecerá la señal del\r\nfuego fatuo en el mapa. Será\r\nun buen momento para visitarlo.",
  "MENU_HELP_TXT_131_01": "Con esta técnica los enemigos\r\ndejarán caer objetos al ser\r\natacados con un golpe peluche.",
  "MENU_HELP_TXT_218_01": "En el modo abrazo puedes agarrar\r\nespigas con [BTN:RS ] y después pulsar\r\n[BTN:L1 ] para dar un enorme salto.",
  "MENU_HELP_TXT_109_01": "Pulsa [BTN:X ] para pasar a la forma\r\nde Cheshire acuático, en la que\r\npuede lanzar un torrente de agua\r\ncon [BTN:R1 ].",
  "MENU_HELP_TXT_220_01": "En las distorsiones de las hadas\r\nhay ilusiones que supondrán un\r\nobstáculo para Cereza. Mantén [BTN:L2 ]\r\npara iluminar y desvelar lo oculto.",
  "MENU_HELP_TXT_244_01": "Poción en frasco mariposa.\r\nMantén [BTN:DP_L ] para ser invencible\r\ny usar Artes de Umbra con menor\r\ntiempo de espera temporalmente.",
  "MENU_HELP_TXT_005_01": "Reúne cinco pétalos vitales\r\no una flor vital para aumentar\r\nla vitalidad máxima de Cereza.",
  "MENU_HELP_TXT_240_01": "Reúne cinco pétalos vitales\r\npara formar una flor vital y\r\naumentar la vitalidad de Cereza.",
  "MENU_HELP_TXT_224_01": "Recoge las hojas de diarios que\r\nencuentres por el bosque para\r\nañadirlas al archivo y poder leerlas\r\ndespués.",
  "MENU_HELP_TXT_001_01": "Usa [BTN:LS ] para desplazarte.\r\nCereza salta automáticamente\r\npor encima de los obstáculos\r\npequeños mientras se mueve.",
  "MENU_SKILLTREE_TXT_331": "Esquiva un ataque enemigo en\r\nel último momento con [BTN:L1 ] para\r\nmejorar tu percepción y moverte\r\na gran velocidad temporalmente.",
  "MENU_SKILLTREE_TXT_322": "Aumenta el efecto\r\nde las pócimas.",
  "MENU_HELP_TXT_135_01": "Pulsa [BTN:R1 ] para que Cheshire\r\nbaje de un salto desde obstáculos\r\nmás elevados. Busca salientes\r\nresaltados en blanco.",
  "MENU_SKILLTREE_TXT_426": "Aumenta la probabilidad de que\r\nun enemigo deje caer un objeto\r\ntras un golpe peluche. Además, los\r\nobjetos que caen son más variados.",
  "MENU_HELP_TXT_216_03": "No es bueno que Cheshire\r\nse aleje de Cereza demasiado\r\ntiempo. Intenta mantenerlos\r\ncerca en todo momento.",
  "MENU_HELP_TXT_006_02": "El indicador de recarga de artes\r\nde Cereza se vacía al usar Artes\r\nde Umbra, pero luego se restaura\r\ngradualmente.",
  "MENU_HELP_TXT_223_02": "Para destruir las barreras, prueba\r\nlos ataques elementales. Cada\r\ntipo de barrera es débil frente\r\na un elemento distinto.",
  "MENU_SKILLTREE_TXT_422": "Cheshire podrá sufrir aún más\r\ndaño antes de volver a su forma\r\nde muñeco.",
  "MENU_HELP_TXT_010_01": "Algunos enemigos son vulnerables\r\ntras sufrir ciertos ataques. Cuando\r\nesto ocurra, mantén pulsado [BTN:L2 ]\r\npara ejecutar el cepo espinoso.",
  "MENU_HELP_TXT_235_01": "Las frutas infernales son\r\nnecesarias para enseñar\r\na Cheshire ciertas técnicas\r\nmuy potentes.",
  "MENU_HELP_TXT_124_01": "Una técnica que permite\r\na Cheshire esquivar ataques\r\ncon [BTN:R3 ] en el modo\r\ndesatado.",
  "MENU_SKILLTREE_TXT_326": "Permite recuperar magia\r\naún más rápido en el modo abrazo.",
  "MENU_HELP_TXT_028_01": "Pulsa [BTN:L1 ] para que Cereza\r\nbaje de un salto desde obstáculos\r\nmás elevados. Busca salientes\r\nresaltados en blanco."
}
