{
  "CORE_DIALOG_TXT_112": "세레자의 의상\r\n「이상한 나라의 소녀」를\r\n획득했습니다!",
  "CORE_DIALOG_TXT_101": "마녀의 은신처에 있는\r\n\"옷 갈아입기\"에서\r\n의상을 바꿀 수 있습니다.",
  "AC_NARRATION235_0010": "기세 좋게 물보라를 일으키며\r\n니무에 호수로 흘러내리는 거대한 폭포.",
  "CORE_SNPSS_4020": "요정들에게 붙잡힌 체셔를\r\n발견한 세레자. 다툰 것도 잊고\r\n체셔를 구하기 위해\r\n늑대와 함께 요새로 들어갑니다.",
  "CORE_WISP_TALK_71_FAS": "어서 오렴, 꼬마 아가씨.\r\n늑대 발자국은 찾았니?",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "장벽의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "원념의 요역",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "【획득하기 위해서는……】\r\n체셔의 스킬을 많이 습득하면……?",
  "CORE_WH_TALK_11_COL": "누나랑 고양이 덕분에 매일 즐거워!\r\n자, 우리랑 같이 놀자!",
  "CORE_SNPSS_6010": "힘을 합쳐 류카온의 습격을\r\n이겨 낸 세레자와 체셔.\r\n마음을 고친 류카온과 함께\r\n숲에서 나갈 방법을 찾습니다.",
  "CORE_HTDMMESS_0039_001_H39": "콜록콜록. 미안해요, 마녀.\r\n조금 몸이 아파서…… 혹시 약을 갖고 있나요?",
  "CORE_HTDMQUEST_TXT_0026": "숲에서도 단정한 몸가짐이 중요하지.\r\n내게 어울리는 꽃이 필요해!",
  "AC_NARRATION260_0010": "세레자 일행은 많은 도깨비불을 구해\r\n숲에서 제일가는 인기인이 되었습니다.",
  "CORE_WH_TALK_04_COL": "후후, 다들 천천히 돌아오고 있어.\r\n이것도 누나랑 고양이 덕분이야",
  "CORE_POSEMENU_TXT_06": "티르 너 노그에서 탈출합니다.",
  "CORE_HTDMMESS_0023_001_H23": "우으, 배고파……\r\n먹을 거, 먹을 거, 먹을 거………",
  "CORE_WISP_TALK_64_FAS": "길 안내라면 맡겨주렴.\r\n어디든 데려가 줄 테니까.",
  "CORE_SNPSS_3030": "격전 끝에 재버워크를\r\n물리친 세레자와 체셔.\r\n하얀 늑대에게 안내받으며\r\n코어가 있는 사당으로 향합니다.",
  "CORE_SVSLT_TXT_02": "불러올 페이지를 선택해 주십시오.",
  "AC_CEREZA040_0010": "모두들 널 싫어해.\r\n네가 훌륭한 마녀가 될 리가 없어!",
  "CORE_SNPSS_1000": "불가사의한 공간을\r\n조심조심 나아가는 세레자.\r\n그녀는 서둘러야만 하는\r\n이유가 있는 듯합니다만……",
  "CORE_HTDMMESS_0013_002_H13": "후후…… 들린다. 속삭이는 목소리가……\r\n나도 곧 그 차원으로……",
  "CORE_WISP_TALK_28_H14": "됐다! 이걸로 자유의 몸이야!\r\n자, 돌아가서 맛있는 요리를 만들어야지!",
  "CORE_HTDMMESS_0021_002_H21": "모자에 장식하면…… 후훗!\r\n인기를 한 몸에 받을 겁니다!",
  "CORE_POSEMENU_TXT_02": "조작법을 확인합니다.",
  "CORE_POSEMENU_TXT_11": "이야기를 이어서 플레이합니다.",
  "CORE_WISP_TALK_17_H03": "나를 구해 준 건가…… 고맙군.\r\n좋아! 문을 열 테니 잘 따라와!",
  "TA_9011_0010_COL": "조심해, 누나",
  "CORE_DIALOG_TXT_005": "이 페이지에 기록된\r\n이야기를 삭제합니다.\r\n계속하시겠습니까?",
  "CORE_DIALOG_TXT_116": "세레자의 의상 「아크 이브 오리진」\r\n세레자의 의상 「잔느」\r\n체셔의 의상 「찰스」를\r\n획득했습니다!",
  "CORE_DIALOG_TXT_105": "탈의실에서\r\n나가시겠습니까?",
  "CORE_HAIR_CERESSA_TXT_03": "결의의 증명",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "저주의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "명목의 요역",
  "CORE_WH_TALK_21_COL": "친구들을 만나면 이곳을 알려 줘.\r\n모두 힘든 일을 겪었을 테니까……",
  "CORE_WISP_TALK_21_H07": "와아, 움직일 수 있게 됐어!\r\n누나, 고마워! 아하하하하~!",
  "TEST_WISP_TALK_13_H00": "으으, 왠지 안 좋은 예감이……\r\n우리는 여기서 기다려도 돼……?",
  "CORE_HTDMMESS_0004_002_H04": "아아, 괜찮으려나. 요정이 이쪽으론 안 오겠지?\r\n이봐, 부탁할게! 빨리 몸을 숨길 만한 걸 줘!",
  "CORE_DIALOG_TXT_150": "다음은 받는 대미지에 관한 설정입니다.\r\n세레자와 체셔의 피해량은 어느 정도로 하시겠습니까?\r\n\"적음\"으로 설정하면 받는 대미지가 감소하고,\r\n\"받지 않는다\"로 설정하면 전혀 대미지를 받지 않습니다.",
  "TA_COM030_0010_CER": "정말!",
  "CORE_HTDMQUEST_TXT_0039": "몸 상태가 좋지 않아서요.\r\n약을 나눠 주지 않을래요?",
  "CORE_WH_TALK_18_COL": "아! 누나, 고양아!\r\n모두를 구해 줘서 고마워!",
  "TA_COM030_0020_CER": "좀!",
  "CORE_DIALOG_TXT_154": "앞으로 계속 어려워지는 위치 펄스를\r\n자동으로 쓸 수 있게 설정합니다.\r\n\"자동\"을 선택하면, [BTN:LS ]을 기울이지 않아도\r\n세레자가 위치 펄스를 성공시킵니다.",
  "CORE_WISP_TALK_25_H11": "구해 줘서 고마워!\r\n누나, 같이 여기서 탈출하자……!",
  "CORE_ARCHIVE_TXT_03": "숲에서 주운 누군가의 수기입니다.",
  "AC_CEREZA130_0010": "아, 아니야!",
  "CORE_WH_TALK_02_COL": "도깨비불을 구하면 이곳을 알려 줘.\r\n길을 모르는 아이도 있을 테니까……",
  "CORE_WISP_TALK_32_H18": "후아! 살았어, 고마워!\r\n이런 나쁜 요정들……! 절대 용서하지 않을 거야!",
  "CORE_HTDMMESS_0029_003_H29": "이게 약…… 흐음…… 이렇게까지 해 주다니……\r\n나도 좀…… 힘을 내 볼까……",
  "AC_NARRATION225_0020": "이 앞에는 도대체 어떤 것이\r\n둘을 기다리고 있을까요……?",
  "CORE_HTDMMESS_0034_001_H34": "으음, 목소리가 잘 안 나와……\r\n마녀야, 혹시 약 좀 갖고 있니?",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "전화의 시련",
  "CORE_WH_TALK_17_COL": "누나, 고양아, 이거 받아!\r\n선물이야…… 도움이 됐으면 좋겠어",
  "CORE_HTDMMESS_0006_001_H06": "이봐, 당신. 바늘 대신 쓸 만한 거 없어?\r\n사용하기 편리한 게 필요한데……",
  "CORE_SNPSS_2010": "친구가 요정에게 납치당해\r\n슬퍼하는 도깨비불 코룸.\r\n세레자는 체셔와 다투면서도\r\n코룸을 도와주려고 합니다.",
  "CORE_DIALOG_TXT_009": "이 장소로 이동하시겠습니까?",
  "CORE_SNPSS_0020": "꿈속에서 본 소년의 말을 믿으며\r\n스승인 모르가나와의 약속을\r\n어기고 숲속으로 들어간 세레자.\r\n조심조심 숲길을 나아갑니다.",
  "CORE_WISP_TALK_30_H16": "고마워, 덕분에 살았어. 들은 바로는\r\n탑 안에 많은 도깨비불이 잡혀 있대……",
  "AC_CEREZA035_0010": "빨리 포기해 버려.\r\n지금까지 늘 그래 왔잖아?",
  "TA_COM000_0010_CER": "어?",
  "CORE_HTDMQUEST_TXT_0029": "으음…… 다 귀찮아……\r\n사는 것도…… 귀찮아……",
  "CORE_WISP_TALK_15_H01": "으음…… 구해 줘서 고마워……\r\n볕 좋은 장소에…… 가고 싶어……",
  "CORE_DIALOG_TXT_153": "먼저 적의 강함에 관한 설정입니다.\r\n나오는 적의 강함은 어느 정도로 하시겠습니까?\r\n\"약함\"으로 설정하면 적의 행동이 바뀌며,\r\n\"매우 약함\"은 출현하는 적의 조합도 바뀝니다.",
  "CORE_DIALOG_TXT_140": "지금까지 배운 조작법을\r\n모험의 지혜에서 확인하시겠습니까?\r\n※모험의 지혜는 시스템에서\r\n언제든지 확인할 수 있습니다.",
  "CORE_SNPSS_5010": "푸카 때문에 폭주하던\r\n체셔를 진정시킨 세레자.\r\n둘은 끈끈한 우정을 느끼며\r\n서둘러 류카온에게 향합니다.",
  "CORE_ARCHIVE_TXT_04": "숲에서 찾은 여행의 추억입니다.",
  "CORE_HTDMMESS_0032_001_H32": "늘 열심히 하는 코룸 군에게 선물을 주고 싶어.\r\n마녀야, 미안한데 나를 도와줄 수 있어?",
  "TA_COM000_0020_CER": "이건…?",
  "AC_NARRATION240_0010": "퐁퐁 솟아나는 아름다운 물.\r\n아발론의 숲에서 나는 생명의 원천입니다.",
  "CORE_WISP_TALK_23_H09": "어머, 나를 구해 주다니 멋진 마음가짐이야.\r\n역시 내가 아름답기 때문일까…… 후후.",
  "AC_NARRATION215_0010": "숲속에 우두커니 서 있는\r\n도깨비불의 비밀 기지.",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "사선의 요역",
  "CORE_HTDMMESS_0028_001_H28": "고통을 받고, 진짜 고통을 알면\r\n요정 따위 무섭지 않아.\r\n소녀여, 내게 고통을 줘……",
  "CORE_DIALOG_TXT_119": "체셔의 의상\r\n「얼렁뚱땅 마녀」를\r\n획득했습니다!",
  "CORE_WISP_TALK_14_02_H16": "탑 안은 요정으로 가득하대……\r\n모두 별일 없어야 하는데……",
  "CORE_HTDMMESS_0017_001_H17": "목표는 월척! 그리고 풍어!\r\n거기 지나가는 마녀야! 내게 미끼를 줄 수 있어?",
  "AC_NARRATION250_0020": "요정들에게도 착한 마음이 남아 있을까……\r\n그런 생각이 세레자의 머리를 스칩니다.",
  "CORE_DIALOG_TXT_011": "지금은 이 장소로\r\n이동할 수 없습니다.",
  "AC_CEREZA145_0010": "그만해…… 듣고 싶지 않아!",
  "CORE_DIALOG_TXT_002": "이 페이지에는 이미 기록된\r\n이야기가 있습니다.\r\n이야기를 덮어쓰시겠습니까?",
  "CORE_HAIR_CERESSA_TXT_04": "여행을 떠나는 마녀 매듭",
  "CORE_DIALOG_TXT_111": "세레자의 의상 \r\n「우아한 백조」를\r\n획득했습니다!",
  "CORE_DIALOG_TXT_102": "세레자의 의상을 갈아입히시겠습니까?",
  "CORE_WISP_TALK_62_COL": "모두 무사해서 다행이야……\r\n정말 고마워, 누나!",
  "CORE_SNPSS_4030": "상처 입은 체셔를 구하고\r\n무사히 다시 만난 세레자.\r\n자취를 감춘 늑대를 찾아\r\n함께 요새 안을 달려갑니다.",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "타개의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "금족의 요역",
  "CORE_POSEMENU_TXT_05": "티르 너 노그에 있는\r\n체크 포인트부터 다시 시작합니다.",
  "CORE_SNPSS_1010": "엄마 로자와 떨어지게 되어\r\n마음의 상처를 입은 세레자.\r\n강한 마녀가 되기 위해\r\n마녀 모르가나를 스승으로 모시며\r\n가르침을 받고 있습니다.",
  "CORE_HTDMQUEST_TXT_0032": "힘들어하는 친구를 위해서 선물을\r\n주고 싶어. 좀 도와줄래?",
  "CORE_HTDMQUEST_TXT_0021": "이 몸이 더 돋보이도록\r\n화려한 장식품을 부탁합니다!",
  "CORE_POSEMENU_TXT_01": "다양한 설정을 합니다.",
  "AC_IGNIS005_0010": "어서 오렴, 무슨 일이니?\r\n비밀 통로라면 내게 맡기거라!",
  "CORE_SNPSS_3020": "세레자의 활약으로\r\n괴물을 쫓아낸 체셔 일행.\r\n자신감을 얻은 세레자는\r\n다시 코어를 찾아 떠납니다.",
  "CORE_SVSLT_TXT_01": "기록할 페이지를 선택해 주십시오.",
  "CORE_DIALOG_TXT_115": "세레자의 의상\r\n「깨어나는 어둠의 눈」,\r\n「시간 여행자」를\r\n획득했습니다!",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "찰나의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "우박의 요역",
  "CORE_HTDMMESS_0015_002_H15": "흐음, 메모하자……\r\n이 식물의 생태는……",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "【획득하기 위해서는……】\r\n티르 너 노그에서 모든 보물 상자를 얻으면……?",
  "CORE_DIALOG_TXT_006": "후회하지 않으시겠습니까?\r\n이야기를 삭제하면\r\n원래대로 되돌릴 수 없습니다.\r\n계속하시겠습니까?",
  "CORE_MISSION_TEXT_0007": "다양한 장애물을 뛰어넘어\r\n티르 너 노그를 공략하라!",
  "CORE_COSTUME_CHESHIRE_TXT_03": "모자를 쓰고 있으면 언제나 행복해.\r\n주변에서 아무리 이상하다고 해도\r\n매일 이유 없는 파티를 열 테다!",
  "CORE_DIALOG_TXT_160": "이번 이야기에서는\r\n조작법 설명을 표시하시겠습니까?\r\n※설정의 \"기본 사항에 대하여\"에서\r\n언제든지 변경할 수 있습니다.",
  "AC_CEREZA060_0030": "목적지는 거기가 아니야",
  "CORE_HTDMMESS_0008_001_H08": "힘을 원해. 요정에게도 지지 않을 힘이……\r\n당신 마녀지? 그럼…… 뭔가 방법 없을까?",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "원념의 시련",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "폭주의 시련",
  "CORE_CSRELEASE_CERESSA_TXT_04": "【획득하기 위해서는……】\r\n세레자의 스킬을 많이 습득하면……?",
  "TEST_WISP_TALK_10": "으…… 운 좋게 빠져나왔지만\r\n높은 곳은 질색인데……",
  "TEST_WISP_TALK_03": "누나, 고마워!\r\n따라와! 문을 열어 줄게!",
  "CORE_HTDMMESS_0015_003_H15": "오오, 만드라고라! 게다가 상태도 좋아!\r\n빨리 가서 연구해야지! 나중에 또 보자!",
  "AC_CEREZA050_0010": "혼자서는 아무것도 못하는 주제에.\r\n누군가가 구해 줄 거라 믿고 있지!?",
  "CORE_WISP_TALK_44_H30": "붙잡히다니 이런 불찰이! 고맙다, 소녀여!\r\n이제 다시 모두를 지킬 수 있겠군!",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "엄마 로자와 떨어지게 되어\r\n마음의 상처를 입은 세레자.\r\n강한 마녀가 되기 위해\r\n마녀 모르가나를 스승으로 모시며\r\n가르침을 받고 있습니다.",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "보복의 요역",
  "CORE_SNPSS_2020": "합류한 세레자와 체셔는\r\n도깨비불들이 괴롭힘당하고 있는\r\n페어리랜드 타워를 발견하고는\r\n내부로 침입했습니다.",
  "CORE_NPC_TXT_11": "사용 아이템을 조합합니다.",
  "TEST_WISP_TALK_07": "이 너머로는 조심해야 해!\r\n엄청 무서운 서커스가 있어!",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "요광의 시련",
  "AC_NARRATION225_0010": "모든 엘레멘트 코어를 부수고\r\n커다란 결계를 풀은 세레자 일행.",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "답명의 시련",
  "CORE_MISSION_TEXT_0003": "적의 공격은 모두 치명상이 된다!\r\n공격을 피해 적을 전멸시켜라!",
  "CORE_WISP_TALK_34_H20": "으윽, 아프군……\r\n구해 줘서 고마워, 마녀야!",
  "CORE_WISP_TALK_54_H40": "영겁의 시간을 넘어, 내가 다시 돌아왔다.\r\n자…… 다시 한번 생을 살아가리……",
  "CORE_DIALOG_TXT_090": "진행된 이야기를 기록합니다.\r\n여기서 기록한 이야기를 불러오면\r\n지금 상태를 유지한 채로\r\n이야기를 재개할 수 있습니다.",
  "CORE_CSRELEASE_CERESSA_TXT_08": "【획득하기 위해서는……】\r\n잔느의 용감한 모습을 목격하면……?",
  "CORE_WISP_TALK_14_H16": "레버를 당기면 탑 안으로 들어갈 수 있대!\r\n부탁이야, 모두를 구해 줘……!",
  "CORE_BAND_CHESHIRE_TXT_02": "강력한 앞발",
  "AC_NARRATION260_0020": "숲의 그 누구도 둘을 잊지 못할 겁니다.\r\n끈끈한 우정으로 이어진 착한 마녀와 악마를……",
  "CORE_COSTUME_CERESSA_TXT_07": "친구를 위기에서 구할 강인함과\r\n상냥함을 지닌 마녀. 어떤 미래가 오더라도\r\n나는 할 수 있어.",
  "CORE_DIALOG_TXT_031": "티르 너 노그의 밖으로 나가시겠습니까?",
  "TA_COM025_0020_CER": "좋았어!",
  "CORE_WISP_TALK_14_03_H16": "내 친구를 살려 줬다고 들었어!\r\n다른 도깨비불들한테도 알려 줘야지……!",
  "CORE_SNPSS_6020": "푸카가 불러낸 수많은 요정.\r\n체셔는 세레자를 등에 태우고\r\n모르가나가 만든 빛의 기둥을\r\n향해 달려갑니다.",
  "AC_NARRATION235_0020": "뱃속까지 울리는 소리에\r\n세레자는 숨을 삼켰습니다.",
  "CORE_WISP_TALK_49_H35": "덕분에 목숨은 건졌어요. 감사해요.\r\n빨리 가서 생각난 아이디어를 시험해야겠어요",
  "CORE_SNPSS_4010": "요정이 만든 엄마의 환영 때문에\r\n크게 다툰 세레자와 체셔.\r\n세레자는 체셔와 헤어지고\r\n혼자서 요새로 향합니다.",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "용맹한 전투의 요역",
  "TA_COM025_0010_CER": "후우……",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "활주의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "제약의 요역",
  "CORE_RETRY_TXT_01": "아이템을 사용해서\r\n타임 어택을 플레이하시겠습니까?",
  "AC_CEREZA015_0020": "안심해, 구해 줄게!",
  "CORE_COSTUME_CERESSA_TXT_03": "이상한 나라를 여행하는 소녀는 생각했다.\r\n돌아가면 이곳에 관한 책을 써야겠어.\r\n……돌아갈 수 있다면 말이지.",
  "CORE_SNPSS_1030": "악마 체셔와 만난 세레자.\r\n체셔를 마계로 돌려보내기 위해\r\n힘이 숨겨진 곳을 알고 있다는\r\n하얀 늑대를 찾아 떠납니다.",
  "CORE_HTDMMESS_0037_001_H37": "여기는 조용해서 좋긴 한데\r\n조금 기분 전환을 하고 싶어.\r\n뭔가 좋은 물건 없어?",
  "CORE_WISP_TALK_39_H25": "추워, 추워, 추워, 추워어! 얼어 죽을 뻔했어요!\r\n당신에겐 감사를! 그리고 요정에겐 복수를……!",
  "CORE_HTDMQUEST_TXT_0006": "재봉할 때 쓰는 바늘이 필요해.\r\n그게 어디 있는지 알아?",
  "CORE_HTDMQUEST_TXT_0015": "신기한 식물을 조사하려고.\r\n미안하지만 잘 부탁해!",
  "CORE_BAND_CHESHIRE_TXT_01": "이야기 속의 모습",
  "CORE_MISSION_TEXT_0008": "맞서는 요정들을 쓰러뜨려라!",
  "CORE_HTDMMESS_0029_002_H29": "요정이 괴롭힌 뒤로……\r\n도통…… 기운이 나질 않아……",
  "CORE_WH_TALK_03_COL": "요정들……\r\n어째서 이런 끔찍한 짓을 하는 걸까……",
  "CORE_WH_TALK_19_COL": "모두 둘에게 인사하고 싶대!\r\n얘들아, 모여~!",
  "CORE_WISP_TALK_63_FAS": "꼬마 아가씨, 꼬마 아가씨.\r\n혹시 길을 잃거든, 내게 말해 주렴.",
  "CORE_NPC_TXT_09": "티르 너 노그에서\r\n재도전 또는 타임 어택을 합니다.",
  "CORE_DIALOG_TXT_121": "세레자의 의상\r\n「시간 여행자」를\r\n획득했습니다!",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "환술의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "전화의 요역",
  "CORE_WH_TALK_16_COL": "누나, 고양아, 늘 고마워!\r\n보답으로 이걸 줄게!",
  "CORE_COSTUME_CERESSA_TXT_04": "나를 마계에 돌려보내 줘!\r\n그렇지 않으면 너를 잡아먹을 거야!\r\n……후후, 꽤 닮았지?",
  "CORE_DIALOG_TXT_021": "조합을 시작하시겠습니까?\r\n",
  "CORE_DIALOG_TXT_032": "타임 어택을 재시작하시겠습니까?\r\n(현재 기록은 남지 않습니다.)",
  "CORE_SNPSS_6030": "본성을 드러낸 모르가나는\r\n체셔의 영혼을 제물로 삼기 위해\r\n둘을 공격하지만,\r\n세레자는 꿋꿋이 맞섭니다.",
  "CORE_WISP_TALK_36_H22": "어라? 움직이네?\r\n아아, 네가 구해 준 거구나. 고마워",
  "AC_NARRATION250_0010": "음침한 숲과는 전혀 다르게\r\n잔잔한 파도가 밀려오는 예쁜 바닷가.",
  "TEST_WISP_TALK_12_H00": "으음, 조금만 더! 한 명만 더 있으면\r\n문을 열 수 있을 것 같아……",
  "CORE_HTDMMESS_0004_003_H04": "살았다…… 앗, 비밀 기지? 너, 길을 알고 있어?\r\n좋아! 여기에 숨어 있는 것보다 안전해!",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "치명의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "강창의 요역",
  "TA_COM015_0010_CER": "그래!",
  "CORE_RETRY_TXT_02": "티르 너 노그에 재도전하시겠습니까?",
  "TEST_WISP_TALK_08": "서커스 단장에게 들키기라도 하면……\r\n으으, 조심해 누나……",
  "CORE_SNPSS_3010": "체셔의 발톱도 통하지 않는\r\n무서운 괴물에게 습격당한 세레자 일행.\r\n세레자는 불안에 떨며\r\n들키지 않도록 숲을 나아갑니다.",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "분골의 시련",
  "CORE_SNPSS_1020": "꿈속에서 본 소년의 말을 믿으며\r\n스승인 모르가나와의 약속을\r\n어기고 숲속으로 들어간 세레자.\r\n조심조심 숲길을 나아갑니다.",
  "CORE_HTDMMESS_0013_003_H13": "후후…… 기뻐. 정말 가져다주다니.\r\n내 부탁을 들어줘서 고마워, 누나",
  "CORE_HTDMMESS_0026_001_H26": "어떤 상황에서도 아름다움을\r\n추구하는 마음은 중요해.\r\n거기 당신! 내게 어울리는 꽃을 가져다줄래?",
  "CORE_DIALOG_TXT_170": "잔느 외전에서는, 특정 지점에서\r\n자동으로 이야기가 기록됩니다.\r\n수동으로 기록할 수 없으므로\r\n주의합시다.",
  "AC_CEREZA060_0020": "너 정말 서툴구나. 남 말할 처지가 아냐",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "수호의 시련",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "강창의 시련",
  "CORE_CSRELEASE_CERESSA_TXT_07": "【획득하기 위해서는……】\r\n금지된 전설을 독파하면……?",
  "CORE_HTDMMESS_0021_003_H21": "아주 훌륭합니다! 뷰티풀! 엘레건트!\r\n고맙습니다! 비밀 기지에 가서 자랑하겠습니다!",
  "CORE_NPC_TXT_05": "모험의 진행 상황을 기록합니다.",
  "CORE_MISSION_TEXT_0004": "적이 쓰러진 곳에 저주가 남는다!\r\n저주를 피해 적을 쓰러트려라!",
  "CORE_WH_TALK_20_COL": "친구들은 아직 숲에 있을 거야……\r\n모두를 구해 줘……!",
  "CORE_COSTUME_CERESSA_TXT_08": "강한 적을 해치우고 진짜 나를 찾으면\r\n나만의 왕자님과 함께할 수 있어.\r\n그런 까마득한 꿈을 안고 내일도 모험한다.",
  "AC_IGNIS015_0010": "모험은 순조롭니?\r\n비밀 통로도 유용하게 사용해 주렴",
  "AC_NARRATION215_0020": "세레자 일행의 활약으로\r\n활기를 되찾았습니다.",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "답명의 요역",
  "CORE_WH_TALK_10_COL": "누나, 고양아, 어서 와!\r\n모두 둘을 만나고 싶어 했어!",
  "CORE_ARCHIVE_TXT_99": "아직 개방되지 않은 항목입니다.",
  "CORE_SNPSS_2030": "요정에게 납치된 코룸의 친구를\r\n구한 세레자와 체셔.\r\n기뻐하는 도깨비불에게 떠밀려\r\n그들의 뒤를 따라갑니다.",
  "CORE_WISP_TALK_70_FAS": "길을 잃으면 늑대 발자국을 찾으렴.\r\n그 아이도 훌륭한 안내자니까…… 후후.",
  "CORE_WISP_TALK_65_FAS": "늑대 발자국은 찾았니?\r\n괜찮다면 근처까지 안내해 줄까?",
  "AC_CEREZA155_0010": "아냐…… 그만해!",
  "CORE_COSTUME_CHESHIRE_TXT_04": "난 반드시 강한 마녀가 되겠어!\r\n꼭 엄마를 구할 거야!\r\n……흥, 그 녀석은 언제나 이런 느낌이지.",
  "AC_NARRATION240_0020": "그 물을 실컷 마시고\r\n세레자와 체셔는 기운을 되찾았습니다.",
  "TEST_WISP_TALK_04": "목이 늘어나는 줄 알았네!\r\n요정들을 조심해!",
  "CORE_CSRELEASE_CERESSA_TXT_03": "【획득하기 위해서는……】\r\n타임 어택에서 좋은 성적을 거두면……?",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "활주의 시련",
  "CORE_WH_TALK_05_COL": "최근엔 다 같이 순찰을 하고 있어.\r\n요정이 이곳을 발견하면 큰일이니까!",
  "CORE_WH_TALK_22_COL": "항상 둘에게만 부탁해서 미안해……\r\n앞으로도 친구들을 구해 줘",
  "CORE_BAND_CHESHIRE_TXT_04": "인연의 리본",
  "CORE_WISP_TALK_58_FAS": "요정들을 조심하렴.\r\n그 녀석들은 적당히란 걸 모르거든",
  "AC_IGNIS200_0010_0020": "비밀 통로에 초대할게!",
  "TEST_WISP_TALK_09": "나, 여기 숨어 있어.\r\n아무한테도 말하면 안 돼!",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "도피의 시련",
  "AC_CEREZA030_0010": "너 같은 겁쟁이는 어차피 실패할 거야!",
  "CORE_SNPSS_2060": "두 번째 엘레멘트 코어를\r\n파괴한 세레자와 체셔.\r\n새로 손에 넣은 힘을 시험하며\r\n늑대의 흔적을 찾습니다.",
  "CORE_HTDMMESS_0021_001_H21": "숨는 건 죽어도 싫습니다!\r\n요정들보다 눈에 띄기 위해!\r\n이 몸은 화려해질 겁니다!",
  "CORE_WISP_TALK_57_FAS": "높은 곳에다가 물가……\r\n아가씨는 시련이 끊이지 않는구나, 하하",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "속박의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "추적의 요역",
  "CORE_HTDMMESS_0013_001_H13": "후후…… 누나, 내게 힘을 빌려줘……\r\n내가 굉장해지기 위한\r\n의식에 쓸 도구가 필요해……",
  "CORE_HTDMMESS_0026_003_H26": "고마워, 귀여운 마녀야!\r\n이걸로 난 오늘도 해피야! 후후후!",
  "CORE_COSTUME_CERESSA_TXT_01": "아직 마도술이 서툰 마녀 견습생 소녀.\r\n엄마를 구하기 위해 아발론의 숲에 들어가\r\n길을 잃은 악마와 운명적으로 만나게 된다.",
  "CORE_SNPSS_6035": "모르가나와 류카온.\r\n운명에 농락당한 두 사람의\r\n최후를 지켜보고, 체셔와도\r\n작별 인사를 한 세레자는……",
  "CORE_COSTUME_CERESSA_TXT_05": "세레자의 지난날의 복장.\r\n엄마를 찾아 여행을 떠난 기억은\r\n그녀의 마음속 깊이 새겨져 있다.",
  "CORE_DIALOG_TXT_033": "티르 너 노그를 재시작하시겠습니까?",
  "CORE_WISP_TALK_67_FAS": "늑대는…… 조금 멀리 있는 것 같구나.\r\n좋아. 숲의 안내자에게 맡기렴!",
  "AC_NARRATION245_0010": "시간의 흐름도 잊은 듯\r\n고요하게 서 있는 커다란 궁전.",
  "CORE_WH_TALK_07_COL": "비밀 기지, 엄청 떠들썩해졌지?\r\n모두가 편히 쉴 수 있는 곳이 되면 좋겠어",
  "CORE_DIALOG_TXT_120": "세레자의 의상\r\n「깨어나는 어둠의 눈」을\r\n획득했습니다!",
  "CORE_HTDMMESS_0023_002_H23": "배가…… 배가……\r\n먹을…… 거…… 으어어어어어……",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "폭주의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "가시 감옥 요역",
  "CORE_HTDMMESS_0039_002_H39": "콜록…… 으으, 도깨비불이 되면……\r\n병도 나을 거라고 생각했는데…… 콜록",
  "CORE_WISP_TALK_68_FAS": "이 숲은 길을 잃기 쉬우니까.\r\n늑대가 있는 곳까지 데려다줄까?",
  "CORE_WH_TALK_12_COL": "나, 몸을 단련하기로 했어.\r\n그 누구도 요정들에게 납치당하지 않도록……!",
  "CORE_WISP_TALK_24_H10": "고마워, 으음…… 누나, 려나?\r\n나, 누나 따라갈래",
  "CORE_WH_TALK_08_COL": "들어 봐, 비밀 기지의 방위대를 만들었어!\r\n그래도 요정들은 이길 수 없겠지만……",
  "CORE_WISP_TALK_33_H19": "내가 잡힌 지 대략 3450만 하고도 6250초……\r\n해방시켜 줘서 대단히 고맙군",
  "AC_NARRATION210_0010": "아주 커다란 요정의 탑.\r\n기묘한 기구가 주변을 맴돌고 있습니다.",
  "AC_NARRATION255_0020": "이만큼이나 자랄 때까지 얼마나 걸렸을까요.\r\n숲의 놀라운 힘에 탄성이 절로 나왔습니다.",
  "TEST_WISP_TALK_05": "요정에게 맞서지도 못해……\r\n난 안 되는 걸까……",
  "CORE_CSRELEASE_CERESSA_TXT_02": "【획득하기 위해서는……】\r\n도깨비불을 많이 구하면……?",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "사투의 시련",
  "CORE_HTDMMESS_0006_002_H06": "으음, 사용하기 힘든 바늘뿐이라 곤란해.\r\n이런 바늘로는 하기 힘들겠어……",
  "CORE_MISSION_TEXT_0001": "구속 중에만 공격이 통한다!\r\n가시 바인드를 써서 싸워라!",
  "CORE_HTDMMESS_0034_002_H34": "내가 이래 봬도 순찰 담당인데……\r\n목 상태가 이러면 여차할 때 소리를 못 질러……",
  "CORE_WH_TALK_14_COL": "후후, 비밀 기지가 더 넓어졌어!\r\n누나랑 고양이도 많이 놀다 가!",
  "CORE_COSTUME_CHESHIRE_TXT_05": "고급 인형 가게 피그말리온의\r\n인기 상품은 질감이 부드러워 좋다.\r\n※잔느&찰스 조작으로 바뀝니다.",
  "CORE_COSTUME_TXT_01": "갈아입을 의상을 선택해 주십시오.",
  "CORE_SNPSS_1070": "첫 번째 엘레멘트 코어를\r\n파괴한 세레자와 체셔.\r\n남은 세 개도 파괴하기 위해\r\n숲속 깊은 곳으로 나아갑니다.",
  "TA_COM020_0010_CER": "하아……",
  "CORE_WH_TALK_01_COL": "아, 누나.\r\n으음…… 다른 친구들은 찾았어?",
  "AC_NARRATION200_0020": "안쪽에서 바람을 타고 신비한 힘의 숨결이\r\n흘러오는 것이 느껴집니다.",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "암흑의 요역",
  "CORE_SNPSS_3040": "세 번째 엘레멘트 코어도\r\n파괴한 세레자와 체셔.\r\n새로 얻은 물의 힘을 쓰며\r\n마지막 코어를 향해 갑니다.",
  "CORE_WISP_TALK_61_FAS": "코룸이 전하는 메시지란다.\r\n『우리들을 만나러 와 줘』……라는구나",
  "CORE_EVENT_PAUSE_TXT_01": "[BTN:START ]로 다시 읽기",
  "CORE_WISP_TALK_16_H02": "고마워, 이 은혜는 잊지 않을게. \r\n기지에 돌아가서 요정에게 잡혔을 때의\r\n규칙을 다시 생각해야겠어……",
  "TA_COM020_0020_CER": "아아~",
  "AC_IGNIS200_0000_0010": "잘 따라오렴!",
  "CORE_COSTUME_CERESSA_TXT_09": "정통 엄브라의 마도술을 배우는 견습 마녀.\r\n세레자와는 서로를 인정하는 좋은 라이벌이다.\r\n※잔느&찰스 조작으로 바뀝니다.",
  "CORE_HTDMMESS_0004_001_H04": "여기는 무서운 것투성이야. 잘 숨어야 해……\r\n옳지, 식물인 척하면……! 이봐, 나 좀 도와줘!",
  "CORE_MISSION_TEXT_0005": "적은 배리어를 두르고 있다!\r\n변신을 잘 활용하여 싸워라!",
  "CORE_COSTUME_CHESHIRE_TXT_01": "혈기 왕성한 악마.\r\n작은 인형의 몸에도 아랑곳하지 않고\r\n자랑스러운 발톱으로 요정을 공격한다.",
  "TEST_WISP_TALK_55_COL": "요정들의 탑에 다른 친구들이……\r\n누나, 모두를 구해 줘……!",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "난전의 시련",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "추적의 시련",
  "TEST_WISP_TALK_01": "누나, 고마워!",
  "CORE_SNPSS_4050": "마지막 코어를 파괴한 \r\n세레자와 체셔.\r\n새로 얻은 불의 힘을 시험하며\r\n사당을 뒤로하고 떠납니다.",
  "CORE_MISSION_TEXT_0002": "제한 시간 내에 전멸시켜라!\r\n적을 격파하면 시간이 연장된다!",
  "CORE_WISP_TALK_19_H05": "와, 몸이 가벼워졌어!\r\n고마워, 아기 고양아. 또 보자!",
  "AC_NARRATION230_0010": "끝이 보이지 않을 만큼 높고\r\n투명할 정도로 새하얀 나무.",
  "CORE_DIALOG_TXT_091": "축하합니다! 당신은 이야기를 끝까지 다 진행하였습니다!\r\n・ 이야기의 난이도를 고를 수 있게 되었습니다.\r\n・ 잔느 외전을 플레이할 수 있게 되었습니다.\r\n・ 마녀의 은신처에서 \"옷 갈아입기\"가 개방되었습니다.",
  "CORE_HTDMMESS_0028_002_H28": "혹시나 해서 말하는데…… 착각하지 마.\r\n……아픈 건 확실히 아프다고 느끼고\r\n고통을 좋아하는 건 아냐",
  "CORE_NPC_TXT_10": "가지고 있는 의상으로 갈아입습니다.",
  "TEST_WISP_TALK_06": "요정한테 잡혀간 친구들……\r\n아무도 돌아오지 못했어……",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "금족의 시련",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "타개의 시련",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "광대의 요역",
  "CORE_SNPSS_3050": "마지막 엘레멘트 코어가\r\n요정들의 요새에 있다는 사실을\r\n알게 된 세레자와 체셔.\r\n세레자는 류카온을 위해서라도\r\n요새에 침입하기로 합니다.",
  "CORE_SNPSS_1060": "마법을 통해 모르가나에게\r\n숲에서 당장 빠져나오는 것은\r\n어렵다는 말을 들은 세레자는\r\n늑대를 계속 쫓기로 합니다.",
  "CORE_WISP_TALK_26_H12": "으으, 살았나……?\r\n무섭……지만 나도 힘을 내야지……",
  "CORE_HTDMMESS_0032_002_H32": "선물할 걸 찾다가 여기까지 와 버렸어.\r\n나도 참 어지간하다니까",
  "TA_COM010_0010_CER": "흐음……",
  "AC_CEREZA045_0010": "또 도망갈 셈이지?\r\n그럴 줄 알았어!",
  "CORE_HTDMMESS_0037_003_H37": "덕분에 살았어 ……윽. 냄새는 조금 지독하지만……\r\n요정에게 발견되면 큰일이니까 일단 돌아갈까……",
  "TA_COM010_0020_CER": "으음……",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "사선의 시련",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "운반의 시련",
  "CORE_CSRELEASE_CERESSA_TXT_05": "【획득하기 위해서는……】\r\n다양한 추억의 책갈피를 모으면……?",
  "TEST_WISP_TALK_02": "따라와!\r\n문을 열어 줄게!",
  "CORE_SNPSS_4040": "요정왕을 자칭하는 푸카와\r\n그가 소환한 어피니티의 환영을\r\n쓰러트린 세레자와 체셔는\r\n코어를 파괴하기 위해\r\n요새를 나아갑니다.",
  "CORE_MISSION_TEXT_0006": "시간에 따라 평가가 바뀐다!\r\n최대한 빠르게 공략하라!",
  "CORE_COSTUME_CHESHIRE_TXT_02": "악마는 아름다운 공주에게 저주를 걸어\r\n순진한 사랑을 가지고 논다……\r\n그런 복장에 체셔도 당황하는데?",
  "CORE_HTDMQUEST_TXT_0008": "나는 강해지고 싶어.\r\n넌 마녀니까 뭔가 방법이 없을까?",
  "CORE_SNPSS_2070": "호수 밑에 잠긴 세 번째 코어.\r\n호숫물을 빼기 위해\r\n세레자와 체셔는 숲에서\r\n가장 높은 거대수에 오릅니다.",
  "CORE_HTDMMESS_0015_001_H15": "와아, 이 숲은 정말 신기한 게 많아!\r\n혹시 너, 신기한 식물도 가지고 있어?",
  "CORE_HTDMQUEST_TXT_0013": "날 한 차원 끌어올릴 의식에\r\n사용할 도구를 준비해 줘",
  "CORE_COSTUME_CERESSA_TXT_02": "저주에 의해 백조가 된 공주를 연기하는\r\n작고 가련한 발레리나.\r\n저 높이 빛나는 별을 좇아, 이야기를 그린다.",
  "AC_IGNIS020_0010": "아발론의 숲은 위험해.\r\n비밀 통로는 분명 도움이 될 거란다",
  "CORE_HTDMMESS_0008_003_H08": "이게 강해지는 도구라고? ……윽, 냄새!\r\n비밀 기지에 가서 시험해 볼까…… 고마워!",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "사투의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "윤회의 요역",
  "CORE_DIALOG_TXT_130": "이 앞으로 나아가면\r\n이야기는 끝으로 향합니다.\r\n마음의 준비는 되셨습니까?",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "선도의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "요광의 요역",
  "AC_CEREZA135_0010": "난…… 난……!",
  "AC_NARRATION220_0020": "그 위에는 섬뜩한 균열이 입을 벌리고 있습니다.\r\n요정들은 대체 무슨 일을 꾸미고 있는 걸까요?",
  "CORE_COSTUME_CERESSA_TXT_06": "500년에 걸친 잠으로부터 깨어난 공주가\r\n잃어버린 기억을 되찾고 운명과 맞선다.\r\n그런 상상을 불러일으키는 신비로운 복장.",
  "CORE_DIALOG_TXT_030": "현재 단계를 리셋하시겠습니까?\r\n내용물을 입수한 보물 상자는\r\n리셋되지 않습니다.",
  "CORE_HTDMQUEST_TXT_0004": "더 이상 무서운 일은 겪기 싫어.\r\n어떻게든 숨어서 살고 싶어……",
  "CORE_HTDMQUEST_TXT_0017": "좋은 미끼를 써야 대어를 낚지!\r\n최상급의 미끼, 부탁한다!",
  "CORE_BAND_CHESHIRE_TXT_03": "방심의 증거",
  "CORE_CSRELEASE_CERESSA_TXT_09": "【획득하기 위해서는……】\r\n잔느의 용감한 모습을 목격하면……?",
  "CORE_HTDMMESS_0017_002_H17": "이곳의 물고기는 큰 데다가 입맛이 고급이야.\r\n방심하면 내가 잡아먹힐 수도 있다구",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "노도의 요역",
  "CORE_DIALOG_TXT_118": "체셔의 의상\r\n「미치광이 모자 장수」를\r\n획득했습니다!",
  "CORE_SNPSS_1040": "하얀 늑대를 발견해도\r\n늑대는 금세 없어집니다.\r\n세레자와 체셔는 늑대를 쫓아\r\n숲속으로 향합니다.",
  "AC_NARRATION200_0010": "세레자를 에워싼\r\n푸릇푸릇한 나무 내음.",
  "CORE_HTDMMESS_0017_003_H17": "고마워, 마녀야! 그럼 낚시를 시작해……\r\n아니, 이런! 내 낚싯대를 놓고 왔네!",
  "CORE_DIALOG_TXT_156": "싸우는 것이 어렵다고 생각하십니까?\r\n적의 강함과, 받는 피해량을\r\n조정할 수 있습니다.",
  "AC_NARRATION255_0010": "세레자와 체셔는\r\n커다란 연꽃밭을 찾았습니다.",
  "CORE_ARCHIVE_TXT_01": "이야기의 등장인물입니다.",
  "CORE_DIALOG_TXT_152": "편리한 스킬 \"바인드 콤보\"와 \"덥석!\"의 사용법을 고릅니다.\r\n\"길게 누르기\"가 기본 설정입니다만,\r\n더 쉽게 \"한 번 누르기\"로 스킬을 사용할 수도 있습니다.",
  "LV_009911_0010_NAR": "체셔는 조금도 움직일 생각이 없나 봅니다.\r\n마치 『알아서 해』라고 말하는 듯합니다.",
  "CORE_ARCHIVE_TXT_05": "숲에서 만나 친해진 도깨비불입니다.",
  "CORE_SNPSS_4060": "드디어 모든 엘레멘트 코어를\r\n파괴한 세레자와 체셔.\r\n늑대에게 안내받으며\r\n류카온이 있는 곳으로 향합니다.",
  "CORE_HTDMQUEST_TXT_0028": "고통…… 고통이 더 필요해!\r\n소녀여, 내게 고통을 줘……!",
  "CORE_WISP_TALK_38_H24": "읍…… 읍.\r\n흡…… 흡, 읍읍……",
  "CORE_HTDMMESS_0008_002_H08": "나는 사냥꾼이다. 활로 공격하는 쪽 말이야……\r\n공격당하는 건 딱 질색이라고……",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "【획득하기 위해서는……】\r\n다양한 수기를 모으면……?",
  "CORE_DIALOG_TXT_114": "세레자의 의상\r\n「지난날의 추억」을\r\n획득했습니다!",
  "CORE_WISP_TALK_45_H31": "구해 줘서 고마워.\r\n그런데 나의 식물들은 무사할까?\r\n혹시 너는 알고 있니?",
  "CORE_HTDMMESS_0037_002_H37": "너무 일만 하면 마음이 힘들어져.\r\n위험한 숲이지만 쉬는 것도 중요하다고 생각해.",
  "CORE_HAIR_CERESSA_TXT_01": "이야기 속의 모습",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "분골의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "위광의 요역",
  "CORE_WISP_TALK_52_H38": "구해 주러 왔구나. 참고 기다리길 잘했어.\r\n이제 엉망이 된 루틴을 되찾아야지……",
  "CORE_SNPSS_2050": "서커스 단장 아마단 도브를\r\n함께 무찌른 세레자와 체셔.\r\n엘레멘트 코어를 찾아\r\n서커스장 안을 둘러봅니다.",
  "TA_COM035_0020_CER": "어!?",
  "AC_IGNIS010_0010": "몸 상태는 어떠니?\r\n지금 비밀 통로 투어를 서비스 중이란다!",
  "CORE_POSEMENU_TXT_00": "커서를 움직여서 항목을 선택해 주십시오.",
  "CORE_HTDMQUEST_TXT_0037": "조금 기분 전환을 하고 싶어.\r\n향기 나는 거 없어?",
  "CORE_POSEMENU_TXT_04": "기록한 이야기를 불러옵니다.",
  "AC_NARRATION210_0020": "요정들의 고약한 마음을 드러내는 듯한\r\n소음에 세레자는 풀이 죽었습니다.",
  "TEST_GIMMICK_TALK_01": "문에는 작은 시소가 붙어 있습니다.\r\n딱 도깨비불만한 크기입니다.",
  "CORE_WISP_TALK_41_H27": "점괘로 알았어. 네가 나를 구해 준다고 하더라.\r\n혹시…… 네가 내 운명의 상대……?",
  "TA_9012_0010_COL": "누나, 무리하지 마",
  "CORE_HTDMMESS_0028_003_H28": "후후, 이걸로 나는 고통에 강해질 수 있어……!\r\n소녀여, 고맙다! 비밀 기지에서 보자고!",
  "TA_COM035_0010_CER": "앗!?",
  "AC_CEREZA150_0010": "아, 아냐! 아니야!",
  "AC_CEREZA060_0040": "있잖아~ 이러다 해가 다 지겠어",
  "AC_NARRATION245_0020": "옛날 옛적에 요정왕의 왕비가 살았다고……\r\n그런 소문을 세레자도 들어 봤습니다.",
  "CORE_DIALOG_TXT_103": "체셔의 의상을 갈아입히시겠습니까?",
  "CORE_HTDMMESS_0032_003_H32": "고마워, 이제 코룸 군도 기뻐할 거야!\r\n……그리고 미안한데 비밀 기지로\r\n가는 길을 알려 줄 수 있어?",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "격화의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "난전의 요역",
  "CORE_DIALOG_TXT_010": "현재 위치한 장소이므로\r\n이동할 수 없습니다.",
  "CORE_DIALOG_TXT_117": "체셔의 의상\r\n「사랑을 저주하는 그림자」를\r\n획득했습니다!",
  "CORE_DIALOG_TXT_104": "탈의실로\r\n이동하시겠습니까?",
  "CORE_HAIR_CERESSA_TXT_02": "견습생의 땋은 머리",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "기원의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "은총의 요역",
  "CORE_HTDMQUEST_TXT_0023": "으으으, 배고파……\r\n먹을 거 없나……",
  "AC_CEREZA055_0010": "울보, 겁쟁이, 떼쟁이!\r\n뒤에 조용히 숨어 있는 게 어울려!",
  "CORE_POSEMENU_TXT_03": "타이틀 화면으로 돌아갑니다.",
  "TEST_WISP_TALK_11_H00": "미안해. 앞으로 두 명은 더 있어야\r\n이 문을 열 수 있어……",
  "CORE_SNPSS_2040": "도깨비불이 사는 비밀 기지에\r\n초대받은 세레자와 체셔.\r\n잠시 휴식을 취한 둘은\r\n다시 코어를 찾아 떠납니다.",
  "CORE_SVSLT_TXT_03": "삭제할 페이지를 선택해 주십시오.",
  "CORE_HTDMMESS_0006_003_H06": "어머, 뾰족하기도 해라!\r\n가공하면 좋은 바늘이 되겠어!\r\n고마워, 작은 마녀야! 덕분에 살았어!",
  "TA_COM005_0010_CER": "있잖아, 체셔",
  "CORE_WH_TALK_15_COL": "친구들을 구해 줘서 고마워!\r\n모두 함께 준비한 누나를 위한 선물이야!",
  "CORE_HTDMMESS_0034_003_H34": "고마워! 나는 비밀 기지로 돌아갈게.\r\n다 나으면 내 노래 들려줄게!",
  "CORE_WISP_TALK_50_H36": "요정들은 난폭해! \r\n목이 끊어졌으면 어쩔 뻔했어!\r\n너도 그렇게 생각하지? 그렇지?",
  "CORE_HTDMQUEST_TXT_0034": "목 상태가 안 좋아서……\r\n마녀야, 혹시 약 가지고 있지 않아?",
  "CORE_POSEMENU_TXT_07": "기록할 페이지를 선택해 주십시오.",
  "AC_NARRATION220_0010": "어둑한 곳에 자리한 요정들의 커다란 요새.",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "【획득하기 위해서는……】\r\n잔느의 용감한 모습을 목격하면……?",
  "CORE_WISP_TALK_60_FAS": "가끔 비밀 기지에 가 보는 건 어떠니?\r\n다들 아가씨랑 너무 놀고 싶다는구나",
  "CORE_HTDMMESS_0029_001_H29": "흐음, 피곤해…… 모든 게 귀찮아……\r\n응? 약……? 뭐, 귀찮은 게 아니라면……",
  "AC_CEREZA060_0050": "엘레멘트의 힘, 잘 못 쓰는구나",
  "CORE_DIALOG_TXT_113": "세레자의 의상\r\n「건방진 악마」를\r\n획득했습니다!",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "도피의 요역",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "수호의 요역",
  "CORE_HTDMMESS_0023_003_H23": "와아~ 먹을 걸 줘서 고마워!\r\n하마터면 널 먹어 버릴 뻔했어, 헤헷!",
  "CORE_SNPSS_1050": "꿈속의 소년은 세레자에게\r\n네 개의 엘레멘트 코어를\r\n부숴 달라고 부탁했습니다.\r\n목적이 생긴 세레자와 체셔는\r\n또다시 늑대를 뒤쫓습니다.",
  "CORE_WH_TALK_06_COL": "정말 의지가 되는 친구들이야.\r\n나도 정신 바짝 차려야겠어……",
  "CORE_DIALOG_TXT_008": "이 이야기를 불러와\r\n이어서 플레이할 수 있습니다.\r\n기록하지 않은 이야기는 삭제됩니다.\r\n계속하시겠습니까?",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "윤회의 시련",
  "CORE_WISP_TALK_66_FAS": "가야 할 길은 좀 더 앞에 있단다.\r\n자, 내가 안내해 줄게.",
  "CORE_WH_TALK_09_COL": "\"놀 땐 놀고, 일할 땐 일하고\".\r\n이게 비밀 기지의 유일한 규칙이야!",
  "CORE_DIALOG_TXT_155": "변경하고 싶을 때는\r\n설정의 \"조작 난이도에 대하여\"에서\r\n변경할 수 있습니다.",
  "CORE_ARCHIVE_TXT_02": "세레자에게 맞서는 적입니다.",
  "CORE_HTDMMESS_0039_003_H39": "고마워요, 마녀.\r\n먹을 것도 주웠으니 슬슬 기지로 돌아가야지……",
  "AC_NARRATION230_0020": "그것은 예로부터 요정왕들이 모시던\r\n아발론의 숲의 신성한 나무였습니다.",
  "CORE_WISP_TALK_69_FAS": "이 근처에서 늑대의 기척이 느껴져.\r\n발자국이 가까이 있는 게 아닐까?",
  "CORE_WH_TALK_13_COL": "비밀 기지를 넓혔어. 봤어?\r\n놀 장소가 엄청 늘었다구!",
  "CORE_SNPSS_6040": "아발론의 숲에서의 모험을 통해\r\n눈에 띄게 성장한 세레자.\r\n소중한 친구와의 약속을 품고\r\n새로운 여정을 떠납니다.",
  "CORE_DIALOG_TXT_151": "화려하게 싸우고 싶어 하는 체셔를 위해,\r\n기술을 쓸 때 마력량이 줄어드는 정도를 선택합니다.\r\n\"줄지 않는다\"로 설정하면\r\n마력 게이지가 전혀 줄지 않습니다.",
  "CORE_WH_TALK_23_COL": "둘은 우리들의 영웅이야!\r\n언제든지 놀러 와. 기다리고 있을게!",
  "CORE_WISP_TALK_59_FAS": "그러고 보니 코룸이 보고 싶다고 하더구나.\r\n아가씨한테 하고 싶은 말이 있다던데",
  "CORE_WISP_TALK_47_H33": "……흐음, 살았군. 구해 줘서 고마워.\r\n요정들도 참, 좀 살살하면 덧나나",
  "CORE_WISP_TALK_56_FAS": "다음 코어는 호수 밑에 있단다.\r\n먼저 거대수가 있는 곳으로 가면 돼",
  "CORE_HTDMMESS_0026_002_H26": "하아, 요정들은 왜 나쁜 짓을 하는 걸까.\r\n다들 사이좋게 지내면 좋을 텐데……"
}
