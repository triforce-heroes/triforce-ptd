{
  "CE_005020_0000_CER": "Fermati... o non\r\nti perdonerò mai!",
  "SM_005020_0210_FAS": "\"Siate prudenti, voi due.\r\nE Avalon vi protegga.\"",
  "CE_005110_0000_CER": "E due! Ne mancano ancora due!",
  "SM_005020_0020_CER": "\"Ignis!\"",
  "CE_005820_0000_CER": "Calmati, va tutto bene!",
  "BK_5010_0000_NAR": "Cheshire era tornato in sé,\r\nma quel violento attacco\r\nlo aveva lasciato sconvolto.",
  "BK_5000_0260_NAR": "Cheshire, accecato dall'ira, si voltò verso Cereza.\r\nIl demone scoprì le zanne... e attaccò!",
  "IN_5000_0010_CER": "\"Bravo, Cheshire!\r\nFacciamogliela vedere!\"",
  "LV_005010_0020_NAR": "La voce ferma di Cheshire\r\nriempì Cereza di coraggio.",
  "SM_005020_0060_FAS": "\"Devo dire, però... che sono davvero\r\ncolpita dai tuoi progressi.\"",
  "BK_5000_0010_NAR": "Di fronte a loro c'era Púca,\r\nl'altezzosa fata già incontrata.\r\nSembrava leggermente\r\nustionato dall'esplosione.",
  "LV_005010_0010_NAR": "[FONT:10 ]Salta dentro ad artigli spianati.\r\nNon cedere alla paura.[FONT:N ]",
  "BK_5000_0180_NAR": "Cheshire aveva nuovamente\r\nrifiutato l'offerta di Púca.",
  "SM_005020_0050_FAS": "\"Ho fatto solo il mio dovere. Come ti ho detto,\r\nè mio compito sapere quel che succede in Avalon.\"",
  "BK_5000_0100_CER": "\"Cheshire?\"",
  "IN_5000_0020_CER": "\"Un a-angelo?!\r\nChe ci fa uno di quelli qui?\"",
  "BK_5000_0060_NAR": "La fata Púca cercava di\r\ntentare Cheshire, offrendogli\r\nun ritorno all'Inferno. Aveva\r\ndavvero il potere di aprire\r\nun portale lì seduta stante?",
  "LV_005905_0000_CER": "Cheshire, ti senti meglio?\r\nTi fa ancora male?",
  "_01": "",
  "SM_005020_0180_FAS": "\"Credo sia il motivo per cui\r\nsei entrata in questa foresta.\"",
  "BK_5000_0170_POO": "\"Maledetto schiavo ripieno di lana!\r\nGattaccio servo di una strega!\"",
  "LV_005905_0030_CER": "Mi fa piacere.",
  "CE_005010_0000_CER": "Lukaon, fermati subito!",
  "CE_005120_0000_CER": "Bene! Ora sono tre!",
  "SM_005010_0020_CER": "\"Sento che... Lukaon è poco\r\npiù avanti, ne sono sicura.\"",
  "BK_5010_0040_NAR": "Cheshire non rispose,\r\nma chiuse gli occhi, stremato.",
  "CE_005805_0010_NAR": "Cheshire reagì furiosamente,\r\nrispondendo con violenti ruggiti.",
  "CE_005810_0000_CER": "Non resisterò molto a lungo...\r\nMa non posso lasciare Cheshire così!",
  "BK_5010_0010_CER": "\"Cheshire...\r\nPerché non sei entrato nel portale?\"",
  "CE_005835_0000_CER": "Cheshire... fermati!",
  "LV_005015_0000_NAR": "Un freddo vento tagliente soffiava senza sosta.\r\nMa i loro cuori non erano per niente freddi.",
  "CE_005090_0000_CER": "Mi riprendo quello che hai rubato a Cheshire.",
  "CE_005050_0000_CER": "Devo fermare quella macchina...",
  "BK_5000_0110_NAR": "Cheshire si avvicinò\r\nlentamente al portale.",
  "BK_5000_0030_POO": "\"Da te un bel niente, mocciosa.\r\nIl tuo infernale compagno, tuttavia,\r\ndeve ancora rispondere alla\r\nnostra... proposta.\"",
  "CE_005830_0000_NAR": "[FONT:10 ]Vai... scappa...[FONT:N ]\r\nCheshire riuscì a tornare in sé e\r\na pronunciare quelle poche parole.",
  "CE_005825_0010_CER": "Troppo vicino!",
  "LV_005010_0000_CER": "Non ho paura.\r\nCheshire, tu sei pronto?",
  "SM_005020_0150_FAS": "\"Ecco perché ho atteso...\r\nAttendevo qualcuno che potesse\r\nrisvegliarci da quest'incubo.\"",
  "BK_5000_0000_POO": "\"Fermi!\"",
  "BK_5000_0120_NAR": "Quando Cheshire arrivò alla soglia,\r\nCereza fu investita da tutti\r\ni ricordi della loro avventura.",
  "BK_5000_0190_POO": "\"E sia!\r\nMa le fiamme infernali devono\r\nessere alimentate: se non da te,\r\nda quella vile ragazzina!\"",
  "SM_005020_0110_FAS": "\"Vedi...\"",
  "LV_005905_0020_NAR": "Ma Cereza era sicura di aver sentito\r\nuna lieve sfumatura di fusa nella sua voce.",
  "CE_005060_0000_CER": "Ne resta solo una.\r\nResisti, Cheshire!",
  "BK_5000_0070_POO": "\"Ebbene, demone?\r\nHai rifiutato la nostra generosa\r\nofferta in passato, ma cosa dirai\r\nquando le calde fiamme dell'Inferno\r\nti accarezzeranno?”",
  "SM_005020_0080_FAS": "\"Forse hai ragione.\r\nLa prossima volta sarò io\r\na chiederti delle indicazioni!\"",
  "LV_005020_0000_CER": "Cheshire! Combattiamo!",
  "CE_005150_0000_CER": "Nessuno si può prendere Cheshire!\r\nNon pensarci nemmeno!",
  "CE_005815_0010_CER": "Resisti, Cheshire!",
  "LV_005905_0010_NAR": "[FONT:10 ]Sto bene.[FONT:N ]\r\nCheshire non aggiunse altro.",
  "SM_005020_0120_FAS": "\"Vivo nella Foresta di Avalon da molto tempo.\r\nUna volta era un luogo stupendo, bellissimo.\"",
  "LV_005910_0000_CER": "Uaaah!",
  "BK_5000_0040_POO": "\"Troppo a lungo, demone, hai\r\nsofferto sotto l'oppressivo giogo\r\ndi quella strega malvagia.\r\n\r\nAbbandonala! E per nostra mano\r\nti verrà aperto un portale per l'Inferno!\"",
  "CE_005805_0000_CER": "Cheshire! Ci sei?\r\nNon mi riconosci?",
  "SM_005020_0160_CER": "\"Ignis, ma tu...\"",
  "CE_005190_0000_CER": "Andiamo, Cheshire!!!",
  "SM_005010_0030_NAR": "Cereza sapeva che, una volta\r\nfatto quel passo, non avrebbe\r\npiù potuto tornare indietro.",
  "SM_005010_0000_NAR": "Erano ritornati nella foresta. Un nuovo\r\nsentiero si apriva davanti a loro.",
  "LV_005005_0020_CER": "Il cuore della foresta...\r\nDove ci attende Lukaon.",
  "CE_005030_0000_CER": "Se l'esplosione mi colpisce\r\nsono spacciata...",
  "IN_5000_0000_CER": "\"Di nuovo?! Ehi, c'è qualcosa di diverso...\"",
  "CE_005100_0000_CER": "Bene, un elemento recuperato!",
  "IN_5000_0030_CER": "\"Bravo, Cheshire!\r\nFacciamogliela vedere!\"",
  "LV_005005_0010_CER": "Ecco... Dev'essere l'entrata...",
  "IN_5010_0010_CER": "\"Sei pronto, Cheshire?\r\nIo non sono sicura...\"",
  "SM_005020_0190_CER": "\"Vuoi dire... Lukaon?\"",
  "SM_005020_0200_FAS": "\"Vai.\r\nIl sigillo dell'altare ora è spezzato.\"",
  "SM_005010_0040_CER": "\"Ci stiamo avvicinando, Cheshire.\r\nQuando sei pronto, mettiamo fine\r\na questa storia.\"",
  "BK_5000_0240_NAR": "Ma poi...",
  "BK_5010_0020_NAR": "[FONT:9 ]Come potevo fidarmi di quello lì?[FONT:N ]\r\nrispose Cheshire,\r\nprima di voltarsi.",
  "CE_005820_0010_CER": "Niente paura, ci sono qui io.",
  "LV_005900_0010_NAR": "Cheshire sbuffò indispettito.\r\n[FONT:10 ]Vedremo il suo brutto muso\r\nfra non molto, ne sono sicuro.[FONT:N ]",
  "BK_5010_0060_NAR": "Cereza gli cantò una nenia\r\nche risaliva a molto tempo prima.",
  "SM_005020_0040_CER": "\"Non ce l'avremmo mai fatta senza di te, Ignis!\r\nI tuoi consigli sono stati preziosi.\"",
  "SM_005020_0070_CER": "\"Abbiamo esplorato questa foresta\r\ncosì a lungo che ormai la conosciamo\r\nmeglio di te.\"",
  "BK_5000_0230_NAR": "La domanda di Cereza non trovò\r\nrisposta. Púca rideva istericamente.",
  "CE_005000_0000_CER": "Cheshire!\r\nLukaon, fermo! Lascialo!",
  "CE_005130_0000_CER": "E... quattro!\r\nCi siamo ripresi quello che hai rubato, Lukaon!",
  "SM_005020_0030_FAS": "\"Hai distrutto tutti e quattro i nuclei,\r\ncongratulazioni. Hai seminato\r\nil panico tra quelle fate!\"",
  "SM_005020_0000_FAS": "\"Finalmente ce l'hai fatta, mia cara.\"",
  "CE_005800_0000_CER": "Cheshire...",
  "CE_005825_0000_CER": "Aaah!",
  "BK_5000_0090_NAR": "Con un gesto plateale, la fata\r\naprì un grande portale infuocato.\r\nCereza poteva sentire il calore\r\nprovenire dal suo interno. I suoni\r\ndella foresta si mischiarono alle\r\nfioche grida dei dannati.",
  "LV_005005_0000_NAR": "Dato che tutti i nuclei elementali erano\r\nstati distrutti, la barriera eretta\r\ndalle fate era scomparsa.",
  "SM_005020_0140_FAS": "\"Hanno corrotto la foresta\r\ne terrorizzato i suoi abitanti.\r\nLe ho viste fare cose orribili,\r\nsenza poter intervenire.\"",
  "CE_005080_0000_CER": "Oh no! Scappa!!!",
  "SM_005020_0155_FAS": "\"Lo avrei fatto io stessa, se solo...\"",
  "BK_5000_0020_CER": "\"Ah, il nostro autoproclamatosi re.\r\nCosa vuole stavolta?\"",
  "SM_005020_0170_FAS": "\"... Scusami, mi sono lasciata trasportare.\r\nPoco più avanti c'è colui che le fate\r\nnon volevano tu incontrassi.\"",
  "CE_005040_0000_CER": "La mia magia può aggiustare tutto!",
  "LV_005015_0010_NAR": "Assieme avrebbero superato ogni ostacolo.\r\nQuesta certezza faceva brillare i loro cuori più del sole.",
  "CE_005170_0000_CER": "Ungh!",
  "BK_5010_0030_CER": "\"Quindi... ti fidi di me?\"",
  "BK_5000_0250_CER": "\"Cheshire? Che ti succede?\"",
  "SM_005020_0100_CER": "\"Aspettavi... perché?\"",
  "SM_005020_0010_NAR": "Una voce risuonò tra gli alberi.\r\nEra uno dei pochi suoni di quella foresta\r\nche poteva tranquillizzare Cereza.",
  "IN_5010_0000_NAR": "Questo è il punto\r\ndi non ritorno.",
  "CE_005070_0000_CER": "Cheshireee!",
  "BK_5000_0220_CER": "\"Cosa gli hai fatto?!\"",
  "CE_005805_0020_CER": "Che faccio adesso...\r\nForse posso aiutarlo con la magia?",
  "SM_005010_0010_NAR": "Pareva chiamare Cereza, come\r\nse una strana forza la attirasse.",
  "LV_005900_0000_CER": "Credi che il lupo bianco stia bene?",
  "CE_005180_0000_CER": "Nnngh!",
  "CE_005815_0000_CER": "Ora!",
  "SM_005020_0090_FAS": "\"... Era tanto che aspettavo di conoscere\r\nqualcuno come te, mia cara.\"",
  "SM_005020_0130_FAS": "\"... Ma le fate lo hanno trasformato.\""
}
