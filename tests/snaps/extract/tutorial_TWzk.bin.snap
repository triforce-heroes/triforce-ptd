{
  "TUT_TUTORIAL_TEXT_ph048": "拿籃子",
  "TUT_TUTORIAL_TEXT_ph015": "狗尾草跳躍",
  "TUT_TUTORIAL_TEXT_ph006": "提水桶",
  "TUT_TUTORIAL_TEXT_w282": "在計時模式中，\r\n可獲取與評價相符的獎勵。\r\n請不斷挑戰，\r\n直到獲得所有獎勵。",
  "TUT_TUTORIAL_TEXT_ph011": "瑟蕾莎移動",
  "TUT_TUTORIAL_TEXT_ph002": "跳躍",
  "TUT_TUTORIAL_TEXT_w165": "在扭曲空間中無法直接攻擊\r\n襲來的妖精。\r\n按著[BTN:L2 ]持續照光，\r\n攻擊才能發揮效果。",
  "TUT_TUTORIAL_TEXT_w561": "柯爾姆有話想說時，\r\n地圖上會顯示人魂的記號。\r\n小心不要看漏了。",
  "TUT_TUTORIAL_TEXT_g001": "已解鎖「更換服裝」。",
  "TUT_TUTORIAL_TEXT_ch029": "滑行",
  "TUT_TUTORIAL_TEXT_w461": "配合敵人的攻擊，\r\n在適當時機按下[BTN:R1 ]，\r\n可反彈遭受的攻擊，\r\n並發動反擊。",
  "TUT_TUTORIAL_TEXT_ph044": "（長按）多重束縛",
  "TUT_TUTORIAL_TEXT_w330": "破壞了石之元素核心，\r\n成功獲得石之力！\r\n按下[BTN:B ]可讓小柴貓\r\n變身為「石靈小柴貓」。",
  "TUT_TUTORIAL_TEXT_w323": "不過，變身時使用技能會消耗魔力，\r\n請留意小柴貓頭上顯示的剩餘魔力。\r\n在抱抱模式時會恢復魔力。",
  "TUT_TUTORIAL_TEXT_ch021": "解除變身",
  "TUT_TUTORIAL_TEXT_ch032": "迴避",
  "TUT_TUTORIAL_TEXT_w030": "左下方的花瓣記號\r\n代表瑟蕾莎的體力。\r\n體力會因遭受敵人攻擊而減少。",
  "TUT_TUTORIAL_TEXT_w023": "挑戰更難的魔女脈衝吧。\r\n當瑟蕾莎在跳舞，\r\n且兩個記號重疊的時候，\r\n請快速推動[BTN:LS ]兩次。",
  "TUT_TUTORIAL_TEXT_w130": "某人寫下的筆記\r\n有時會遺留在森林中。\r\n按[BTN:L1 ]拾取筆記後\r\n可以從記錄檔案裡查看撿到的筆記。",
  "TUT_TUTORIAL_TEXT_ph019": "吸收火之力",
  "TUT_TUTORIAL_TEXT_d002": "選擇想去的地方吧。",
  "TUT_TUTORIAL_TEXT_w430": "透過調查水珠——\r\n也就是水之元素碎片，\r\n可以吸收其力量，\r\n並改變水位。",
  "TUT_TUTORIAL_TEXT_ch025": "反擊",
  "TUT_TUTORIAL_TEXT_w630": "透過在體力不足的敵人附近\r\n長按[BTN:R2 ]後放開，\r\n今後可以使出蓄力突擊\r\n給敵人致命一擊了！",
  "TUT_TUTORIAL_TEXT_ph040": "學習技能",
  "TUT_TUTORIAL_TEXT_w730": "今後只要瑟蕾莎乘坐在小柴貓的背上\r\n並灌注魔力，\r\n就可以喚醒小柴貓潛在的力量，\r\n使其變為覺醒狀態！",
  "TUT_TUTORIAL_TEXT_ch022": "解除變身",
  "TUT_TUTORIAL_TEXT_ch031": "（長按後放開）束縛連擊",
  "TUT_TUTORIAL_TEXT_ph047": "（推動兩次）魔女脈衝",
  "TUT_TUTORIAL_TEXT_w333": "石靈小柴貓可以用踐踏\r\n挖出藏在地底的敵人，\r\n衝擊波還能使周圍敵人失去意識。\r\n相信在戰鬥時非常有幫助。",
  "TUT_TUTORIAL_TEXT_w320": "破壞了木之元素核心，\r\n成功獲得木之力！\r\n按下[BTN:Y ]可讓小柴貓\r\n變身為「木靈小柴貓」。",
  "TUT_TUTORIAL_TEXT_w120": "有紅色拱門的地方\r\n叫做「魔女藏身處」，\r\n只要靠近，瑟蕾莎就會記得在哪裡。\r\n看到就去一趟吧！",
  "TUT_TUTORIAL_TEXT_ph009": "（長按）跳舞",
  "TUT_TUTORIAL_TEXT_w020": "瑟蕾莎可用魔女脈衝讓植物生長。\r\n長按[BTN:L2 ]，\r\n並看準時機推動[BTN:LS ]吧！",
  "TUT_TUTORIAL_TEXT_d001": "伊古妮絲會帶領你前往已知的魔女藏身處。",
  "TUT_TUTORIAL_TEXT_w024": "靈活運用舞蹈動作，\r\n將魔力灌注給目標的「魔女脈衝」，\r\n是暗影魔女的基礎魔導術。",
  "TUT_TUTORIAL_TEXT_w420": "水靈小柴貓完全不怕水。\r\n躍入水中推動[BTN:RS ]，\r\n便能自由自在地游泳。",
  "TUT_TUTORIAL_TEXT_ph050": "（長按）抓住另一隻",
  "TUT_TUTORIAL_TEXT_ph043": "（長按）荊棘束縛",
  "TUT_TUTORIAL_TEXT_w720": "在計時模式可以挑戰自己，\r\n以最佳記錄為目標而努力！",
  "TUT_TUTORIAL_TEXT_ch026": "（長按）拉動",
  "TUT_TUTORIAL_TEXT_w171": "破壞隱藏在最深處的核心，\r\n突破提爾納諾吧！\r\n迷路時也可以按[BTN:START ]離開。",
  "TUT_TUTORIAL_TEXT_ph016": "吸收木之力",
  "TUT_TUTORIAL_TEXT_ph005": "爬上／爬下梯子",
  "TUT_TUTORIAL_TEXT_ph012": "（長按）荊棘束縛",
  "TUT_TUTORIAL_TEXT_ph001": "（往懸崖方向推動）跳躍",
  "TUT_TUTORIAL_TEXT_w281": "另外，也可以挑戰競爭攻略\r\n提爾納諾所需時間的計時模式。",
  "TUT_TUTORIAL_TEXT_w081": "一起前進時，\r\n推動[BTN:LS ]移動瑟蕾莎。\r\n推動[BTN:RS ]可讓小柴貓往周圍延伸。",
  "TUT_TUTORIAL_TEXT_w462": "被反擊擊中的敵人會失去意識。\r\n但部分攻擊無法反擊，\r\n請勿大意！",
  "TUT_TUTORIAL_TEXT_w100": "可自由切換前進模式，\r\n選擇兩人分頭或一起前進。\r\n不同模式下可採取的行動也不同，\r\n請視情況靈活運用。",
  "TUT_TUTORIAL_TEXT_ph029": "破壞核心",
  "TUT_TUTORIAL_TEXT_w000": "按下[BTN:L1 ]調查物品，\r\n瑟蕾莎便會採取各種行動。\r\n如果對什麼東西感到好奇，\r\n就按下[BTN:L1 ]一探究竟吧！",
  "TUT_TUTORIAL_TEXT_e009": "確定調製！",
  "TUT_TUTORIAL_TEXT_ch011": "（水靈小柴貓）游泳",
  "TUT_TUTORIAL_TEXT_ch002": "（往懸崖方向推動）攀爬",
  "TUT_TUTORIAL_TEXT_w300": "可以選擇頁面記錄故事。\r\n由於與自動記錄的頁面不同，\r\n建議可以在每個轉折點留下記錄。",
  "TUT_TUTORIAL_TEXT_w700": "靠近用荊棘束縛捕捉的敵人，\r\n長按[BTN:R2 ]後放開\r\n可以使出聯合攻擊。\r\n此攻擊威力強大，請務必妥善利用。",
  "TUT_TUTORIAL_TEXT_ch015": "（石靈小柴貓）踐踏",
  "TUT_TUTORIAL_TEXT_ch006": "小柴貓移動",
  "TUT_TUTORIAL_TEXT_w400": "用[BTN:L1 ]迴避敵人的攻擊，\r\n就會發動「魔女時間」，\r\n暫時可以用超快速移動。\r\n用覺醒的力量分出勝負吧！",
  "TUT_TUTORIAL_TEXT_b002": "小柴貓要學習技能\r\n會用到阿瓦隆結晶。",
  "TUT_TUTORIAL_TEXT_ph025": "變身為火靈小柴貓",
  "TUT_TUTORIAL_TEXT_ph036": "吸收水之力",
  "TUT_TUTORIAL_TEXT_w351": "火靈小柴貓\r\n在按下[BTN:R1 ]時會發射火焰彈。\r\n物體被火焰彈擊中會起火燃燒。",
  "TUT_TUTORIAL_TEXT_e005": "這就是素材。\r\n可以在森林裡撿到。",
  "TUT_TUTORIAL_TEXT_w051": "不過，若兩人距離太遠，\r\n不知道會發生什麼事！\r\n前進時注意要保持適當的距離。",
  "TUT_TUTORIAL_TEXT_ch019": "變身為火靈小柴貓",
  "TUT_TUTORIAL_TEXT_e012": "長按[BTN:DP ]可使用製作完成的道具。",
  "TUT_TUTORIAL_TEXT_e001": "已解鎖「調製道具」。",
  "TUT_TUTORIAL_TEXT_ph032": "切換成解放模式",
  "TUT_TUTORIAL_TEXT_w900": "長按[BTN:L2 ]，\r\n貞德也能使用荊棘束縛。\r\n貞德的荊棘束縛作用範圍廣，\r\n可以一次捕捉圓圈中的敵人。",
  "TUT_TUTORIAL_TEXT_w751": "煉獄果實生長在森林的各地。\r\n生長地點會記錄在詳細地圖上。",
  "TUT_TUTORIAL_TEXT_w651": "連續使用荊棘束縛\r\n可以同時捕捉兩個敵人。",
  "TUT_TUTORIAL_TEXT_b006": "瑟蕾莎要學習技能\r\n會需要縞瑪瑙薔薇。",
  "TUT_TUTORIAL_TEXT_ph026": "（長按）荊棘牢籠",
  "TUT_TUTORIAL_TEXT_ph035": "投擲人魂",
  "TUT_TUTORIAL_TEXT_b001": "右邊是小柴貓的技能。",
  "TUT_TUTORIAL_TEXT_e006": "這就是可用道具。\r\n取得後，便能調製該道具。",
  "TUT_TUTORIAL_TEXT_w141": "森林裡有些人魂愁眉苦臉的。\r\n若能傾聽祂們的煩惱，\r\n也許會有好事發生。",
  "TUT_TUTORIAL_TEXT_w441": "屏障分為幾種，\r\n各個屏障的弱點不同。\r\n對石之屏障使用爆炸\r\n或賦予強烈衝擊比較有效。",
  "TUT_TUTORIAL_TEXT_e011": "完成！",
  "TUT_TUTORIAL_TEXT_e002": "選擇「調製道具」……",
  "TUT_TUTORIAL_TEXT_b005": "左邊是瑟蕾莎的技能。",
  "TUT_TUTORIAL_TEXT_ph022": "變身為木靈小柴貓",
  "TUT_TUTORIAL_TEXT_ph031": "伸長小柴貓",
  "TUT_TUTORIAL_TEXT_w910": "雖然再次使用時\r\n所需的時間比瑟蕾莎長，\r\n不過當同時捲入更多敵人時，\r\n將會……？",
  "TUT_TUTORIAL_TEXT_w752": "森林裡沉睡著可以令瑟蕾莎覺醒，\r\n並獲得強力技能的東西。\r\n參考詳細地圖的標示\r\n在各處尋找看看吧！",
  "TUT_TUTORIAL_TEXT_w010": "按下[BTN:L1 ]可以讓瑟蕾莎調查物品。\r\n調查各地的燈籠，\r\n即可記錄故事進度。",
  "TUT_TUTORIAL_TEXT_ph039": "照射魔導器之光",
  "TUT_TUTORIAL_TEXT_w310": "「元素碎片」沉睡在森林裡，\r\n按下[BTN:L1 ]調查，\r\n就可將它的力量吸收進魔導器。",
  "TUT_TUTORIAL_TEXT_ch012": "（水靈小柴貓）水柱激流",
  "TUT_TUTORIAL_TEXT_ch001": "攻擊",
  "TUT_TUTORIAL_TEXT_ch016": "變身為木靈小柴貓",
  "TUT_TUTORIAL_TEXT_ch005": "抓擊",
  "TUT_TUTORIAL_TEXT_w710": "可以按[BTN:DP ]使用所持的可用道具。\r\n為了使戰況對自己有利，\r\n請盡量使用吧！",
  "TUT_TUTORIAL_TEXT_w510": "帶著人魂前往提爾納諾的深處吧。\r\n請注意，人魂受到攻擊就會消失……",
  "TUT_TUTORIAL_TEXT_f001": "已解鎖「提爾納諾」。",
  "TUT_TUTORIAL_TEXT_w410": "當敵人要攻擊時，\r\n有時頭上會出現記號。\r\n今後只要在這時按下[BTN:L2 ]，\r\n就可以更強力地捕捉對手了。\r\n",
  "TUT_TUTORIAL_TEXT_ph023": "變身為石靈小柴貓",
  "TUT_TUTORIAL_TEXT_ph030": "瑟蕾莎移動",
  "TUT_TUTORIAL_TEXT_w740": "光靠瑟蕾莎一個人無法打倒敵人。\r\n妥善運用魔導術，\r\n製造逃跑的路徑吧！",
  "TUT_TUTORIAL_TEXT_w640": "透過在荊棘束縛捕捉到的敵人附近，\r\n長按[BTN:R2 ]後放開使出蓄力突擊，\r\n今後可以使出聯合攻擊了！",
  "TUT_TUTORIAL_TEXT_b004": "長按並學習技能。",
  "TUT_TUTORIAL_TEXT_w440": "妖精在戰鬥時\r\n有時候會展開屏障。\r\n面對展開屏障的對手，\r\n大多數攻擊是不管用的。",
  "TUT_TUTORIAL_TEXT_ch008": "（長按）拉動",
  "TUT_TUTORIAL_TEXT_e010": "放入素材後，請攪動大釜。",
  "TUT_TUTORIAL_TEXT_e003": "試試看吧。",
  "TUT_TUTORIAL_TEXT_w140": "在森林各處都有被妖精捉住的人魂。\r\n若發現被捉住的人魂，\r\n就按[BTN:L1 ]來解救祂們吧！",
  "TUT_TUTORIAL_TEXT_w040": "惡魔的利爪，\r\n連妖精都能輕易擊敗。\r\n按下[BTN:R2 ]使出抓擊，\r\n讓妖精見識我們的厲害！\r\n",
  "TUT_TUTORIAL_TEXT_e007": "請試著作作看療癒藥水。",
  "TUT_TUTORIAL_TEXT_b000": "可以在此學習兩人的技能。",
  "TUT_TUTORIAL_TEXT_ph027": "（長按）跳舞",
  "TUT_TUTORIAL_TEXT_ph034": "擁抱人魂",
  "TUT_TUTORIAL_TEXT_w340": "破壞了水之元素核心，\r\n成功獲得水之力！\r\n按下[BTN:X ]可讓小柴貓\r\n變身為「水靈小柴貓」。",
  "TUT_TUTORIAL_TEXT_w411": "強力拘束敵人時，\r\n拘束時間會變長，\r\n能更快打倒對方。\r\n用這份嶄新的力量迎擊強敵吧！",
  "TUT_TUTORIAL_TEXT_w511": "人魂非常脆弱，\r\n稍微被攻擊就會消失。\r\n請小心謹慎地為祂們帶路！",
  "TUT_TUTORIAL_TEXT_ch017": "變身為石靈小柴貓",
  "TUT_TUTORIAL_TEXT_ch004": "反擊",
  "TUT_TUTORIAL_TEXT_ch013": "（水靈小柴貓）水柱激流",
  "TUT_TUTORIAL_TEXT_ch000": "惡魔移動",
  "TUT_TUTORIAL_TEXT_w311": "每當吸收的力量裝滿魔導器，\r\n魔力計量條的最大值就會少量提升。",
  "TUT_TUTORIAL_TEXT_w102": "一起前進的狀態稱為「抱抱模式」。\r\n兩人分頭前進時按下[BTN:L1 ]，\r\n小柴貓會回到布偶狀態。",
  "TUT_TUTORIAL_TEXT_ph038": "破壞元素核心",
  "TUT_TUTORIAL_TEXT_w011": "當右下角出現記號時，\r\n將自動記錄故事。\r\n跟自行記錄的故事一樣，\r\n之後可以讀取。",
  "TUT_TUTORIAL_TEXT_ch014": "（火靈小柴貓）火焰彈",
  "TUT_TUTORIAL_TEXT_ch007": "抓擊",
  "TUT_TUTORIAL_TEXT_e008": "確定製作數量後……",
  "TUT_TUTORIAL_TEXT_ch010": "（石靈小柴貓）踐踏",
  "TUT_TUTORIAL_TEXT_ch003": "跳躍",
  "TUT_TUTORIAL_TEXT_w101": "兩人分頭前進的狀態稱為「解放模式」。\r\n一起前進時按下[BTN:R1 ]，\r\n小柴貓會衝出來。",
  "TUT_TUTORIAL_TEXT_ph028": "（推動操控搖桿）魔女脈衝",
  "TUT_TUTORIAL_TEXT_w650": "魔導術計量條增為兩個，\r\n今後瑟蕾莎可以連續使用\r\n荊棘束縛了！",
  "TUT_TUTORIAL_TEXT_b007": "在森林探險時，技能想必能派上用場。",
  "TUT_TUTORIAL_TEXT_ph020": "（旋轉）回復",
  "TUT_TUTORIAL_TEXT_ph033": "切換成抱抱模式",
  "TUT_TUTORIAL_TEXT_w750": "獲得的煉獄果實\r\n可以讓小柴貓學習強大的技能。",
  "TUT_TUTORIAL_TEXT_w550": "在森林裡迷路時，\r\n就調查森林路標吧。\r\n它會告訴你前往附近\r\n魔女藏身處的路。",
  "TUT_TUTORIAL_TEXT_w450": "切換成抱抱模式，\r\n可以漸漸回復減少的魔力。\r\n魔力減少就馬上回復吧。",
  "TUT_TUTORIAL_TEXT_ch018": "變身為水靈小柴貓",
  "TUT_TUTORIAL_TEXT_e013": "另外，按下[BTN:Y ]能確認可用道具的效果。",
  "TUT_TUTORIAL_TEXT_e004": "瑟蕾莎能夠用素材製作可用道具。",
  "TUT_TUTORIAL_TEXT_w050": "瑟蕾莎與小柴貓，\r\n可以個別移動。\r\n[BTN:LS ]移動瑟蕾莎。\r\n[BTN:RS ]移動小柴貓。",
  "TUT_TUTORIAL_TEXT_ph024": "變身為水靈小柴貓",
  "TUT_TUTORIAL_TEXT_ph037": "抱抱模式下回復魔力",
  "TUT_TUTORIAL_TEXT_w343": "水靈小柴貓\r\n在按下[BTN:R1 ]時會發射水柱激流。\r\n不僅射程長，也很強而有力。\r\n試著用它射擊各式各樣的東西吧！",
  "TUT_TUTORIAL_TEXT_w350": "破壞了火之元素核心，\r\n成功獲得火之力！\r\n按下[BTN:A ]可讓小柴貓\r\n變身為「火靈小柴貓」。",
  "TUT_TUTORIAL_TEXT_b003": "將游標移到此技能上方……",
  "TUT_TUTORIAL_TEXT_ch027": "左右移動",
  "TUT_TUTORIAL_TEXT_ph042": "迴避",
  "TUT_TUTORIAL_TEXT_w732": "另外還可以透過[BTN:A ][BTN:B ][BTN:X ][BTN:Y ]\r\n使出火、石、水、木攻擊。\r\n發揮真正的力量一決勝負吧！",
  "TUT_TUTORIAL_TEXT_w721": "一跨越開始線或開始戰鬥，\r\n便會開始計時。\r\n評價會依據攻略時間而定。",
  "TUT_TUTORIAL_TEXT_w325": "木靈小柴貓時按下[BTN:Y ]，\r\n就能變回原本的小柴貓。\r\n請注意，\r\n只能在未變身時使出反擊。",
  "TUT_TUTORIAL_TEXT_w125": "是白狼的足跡。\r\n追著白狼足跡前進，\r\n就可以接近目標。\r\n請找找看有沒有更多白狼足跡。",
  "TUT_TUTORIAL_TEXT_w025": "如果要培育森林裡的植物，\r\n跟之前相比，\r\n需要更長時間\r\n持續使用魔女脈衝。",
  "TUT_TUTORIAL_TEXT_w421": "不過只有水靈小柴貓會游泳。\r\n躍入水中就會自動切換為\r\n水靈小柴貓。",
  "TUT_TUTORIAL_TEXT_ph008": "（推動操控搖桿）魔女脈衝",
  "TUT_TUTORIAL_TEXT_ph046": "（持續推動）魔女脈衝",
  "TUT_TUTORIAL_TEXT_w332": "石靈小柴貓身體堅固，\r\n能承受大多數攻擊。\r\n但是每承受一次攻擊，\r\n魔力就會減少。",
  "TUT_TUTORIAL_TEXT_w321": "木靈小柴貓，\r\n可透過[BTN:R2]使出木之招式。\r\n木之招式威力強大，\r\n請盡量使用吧！",
  "TUT_TUTORIAL_TEXT_ch023": "解除變身",
  "TUT_TUTORIAL_TEXT_ch030": "（長按後放開）咬殺！",
  "TUT_TUTORIAL_TEXT_w080": "抱起回到布偶型態的小柴貓，\r\n兩人便可一起移動。",
  "TUT_TUTORIAL_TEXT_w670": "在世界地圖或帶路時會出現的腳印，\r\n代表伊古妮絲推薦的地點。\r\n迷路時，就去那裡看看吧。",
  "TUT_TUTORIAL_TEXT_w280": "可以從魔女藏身處\r\n再次挑戰破壞過核心的提爾納諾。\r\n也可回收先前錯過的寶箱，\r\n不用擔心。",
  "TUT_TUTORIAL_TEXT_ph013": "投擲小柴貓",
  "TUT_TUTORIAL_TEXT_ph000": "瑟蕾莎移動",
  "TUT_TUTORIAL_TEXT_ph017": "吸收石之力",
  "TUT_TUTORIAL_TEXT_ph004": "（按住[BTN:L1 ]）拉／推箱子",
  "TUT_TUTORIAL_TEXT_w270": "伊古妮絲會帶領瑟蕾莎\r\n前往各地的魔女藏身處。\r\n回到去過的地點，\r\n或許會有新發現。",
  "TUT_TUTORIAL_TEXT_w680": "在部分地方，\r\n例如附近有迷迭香的時候，\r\n無法讓小柴貓回到抱抱模式。\r\n想想看怎麼讓他們會合吧。",
  "TUT_TUTORIAL_TEXT_w480": "石靈小柴貓可透過踐踏\r\n在森林裡的大蘑菇上跳躍。\r\n就算想去高的地方，\r\n只要一跳就能抵達！",
  "TUT_TUTORIAL_TEXT_w070": "長按[BTN:L2 ]，\r\n可使瑟蕾莎召喚魔界荊棘捕捉敵人。\r\n這叫做「荊棘束縛」。\r\n拘束敵人會消耗魔導術計量條。",
  "TUT_TUTORIAL_TEXT_w170": "妖精製造的幻覺，\r\n就是來自「幻影妖域提爾納諾」。\r\n森林各地存在著多處提爾納諾。",
  "TUT_TUTORIAL_TEXT_w090": "在抱抱模式中按[BTN:L1 ]，\r\n可將小柴貓投擲到高處。\r\n透過高處與低處通力合作，\r\n有機會開闢新道路。",
  "TUT_TUTORIAL_TEXT_ch028": "跳躍",
  "TUT_TUTORIAL_TEXT_w460": "小柴貓不只可以用爪子和尖牙\r\n攻擊敵人，還能反彈敵人的攻擊。\r\n這叫做「反擊」。",
  "TUT_TUTORIAL_TEXT_w560": "幫助很多人魂之後，\r\n就去人魂秘密基地找柯爾姆吧。\r\n說不定能得到謝禮。",
  "TUT_TUTORIAL_TEXT_ph010": "（推動操控搖桿）魔女脈衝",
  "TUT_TUTORIAL_TEXT_ph003": "汲水",
  "TUT_TUTORIAL_TEXT_w390": "在壞掉的物體附近\r\n一邊按[BTN:L2 ]一邊轉動[BTN:LS ]，\r\n可以使用讓壞掉物品恢復原狀的魔導術——\r\n「回復」。",
  "TUT_TUTORIAL_TEXT_w660": "飛行的敵人較不耐打，\r\n有時光是用荊棘束縛便能擊倒。\r\n「敵人會飛，就打下來」！",
  "TUT_TUTORIAL_TEXT_w260": "在魔女藏身處，\r\n可以幫瑟蕾莎和小柴貓換衣服。\r\n換個心情在森林探險吧！",
  "TUT_TUTORIAL_TEXT_w690": "使小柴貓去撞柱子，\r\n製造安撫的時機吧。\r\n即使柱子損壞，\r\n也可以使用「回復」來修復。",
  "TUT_TUTORIAL_TEXT_ph014": "伸長小柴貓",
  "TUT_TUTORIAL_TEXT_ph007": "（長按）跳舞",
  "TUT_TUTORIAL_TEXT_w160": "在妖精製造的扭曲空間中，\r\n會出現各種幻覺阻礙你前進。\r\n按[BTN:L2 ]照亮周圍，\r\n找出隱藏的事物吧。",
  "TUT_TUTORIAL_TEXT_ph049": "（長按）抓住第一隻",
  "TUT_TUTORIAL_TEXT_w490": "可以讓小柴貓\r\n攻擊祠中的元素核心，\r\n並將其破壞。\r\n",
  "TUT_TUTORIAL_TEXT_w060": "小柴貓是惡魔，\r\n不能經過有迷迭香的地方。\r\n如果遇到迷迭香，\r\n小柴貓應該就要找別條路走了……",
  "TUT_TUTORIAL_TEXT_ph041": "（長按）荊棘束縛",
  "TUT_TUTORIAL_TEXT_w731": "處在覺醒狀態下的小柴貓\r\n可以透過[BTN:L1 ]迴避，\r\n或透過[BTN:R1 ]使出\r\n強勁的攻擊。",
  "TUT_TUTORIAL_TEXT_w722": "若在計時模式期間撿起時鐘，\r\n累計時間會稍微減少。\r\n相對的若是受到傷害，\r\n累計時間則會增加，還請留意。",
  "TUT_TUTORIAL_TEXT_w326": "複習一下，要變身為木靈小柴貓\r\n也是按[BTN:Y ]。\r\n畫面右下方可查看是否已變身。",
  "TUT_TUTORIAL_TEXT_ch024": "解除變身",
  "TUT_TUTORIAL_TEXT_d003": "這就是伊古妮絲的推薦。請參考這個前進。",
  "TUT_TUTORIAL_TEXT_w026": "接下來，\r\n在成功使用數次魔女脈衝前，\r\n請持續按住[BTN:L2 ]，\r\n並務必留意不要在中途放開！",
  "TUT_TUTORIAL_TEXT_ph018": "吸收水之力",
  "TUT_TUTORIAL_TEXT_w031": "體力一旦耗盡，\r\n瑟蕾莎就會失去性命。\r\n請隨時注意剩下的體力。",
  "TUT_TUTORIAL_TEXT_w022": "挑戰更難的魔女脈衝吧。\r\n當瑟蕾莎在跳舞，\r\n且記號變紅擴張的時候，\r\n請持續推動[BTN:LS ]。",
  "TUT_TUTORIAL_TEXT_ch020": "（水靈小柴貓）水柱激流",
  "TUT_TUTORIAL_TEXT_ph045": "（長按）荊棘束縛",
  "TUT_TUTORIAL_TEXT_w331": "石靈小柴貓\r\n在按下[BTN:R1 ]後會踐踏。\r\n踐踏可擠壓或破壞下方物體。",
  "TUT_TUTORIAL_TEXT_w322": "另外，變身成木靈小柴貓時，\r\n可透過[BTN:R1 ]伸長舌頭抓住物體。\r\n持續按住[BTN:R1 ]，\r\n還能拉動抓住的物體。"
}
