{
  "SM_002100_0150_COL": "„Danke sehr!“",
  "BK_2000_0060_CER": "„Komm schon, Cereza, reiß dich zusammen.\r\nIch muss stark sein, um eine richtige\r\nHexe zu werden!“",
  "LV_002905_0000_NAR": "[FONT:10 ]Es gibt eine Kraft hier. Eine große...[FONT:N ]\r\nCheshire hatte etwas in ihrer Nähe gespürt.",
  "SM_002100_0040_NAR": "Der bloße Gedanke an den nächsten\r\nTraum sorgte dafür, dass sie ein\r\nLächeln nicht unterdrücken konnte.",
  "SM_002140_0050_FAS": "„Da fällt mir ein, dass ich mich noch\r\ngar nicht vorgestellt habe. Ich bin\r\nIgnis, die Hüterin dieses Waldes.“",
  "SM_002060_0030_CER": "„Pass doch auf, Cheshire! Keine\r\nAhnung, ob Irrlichter einen Herzinfarkt\r\nbekommen können, aber sich so zu\r\nerschrecken kann nicht gesund sein!“",
  "LV_002035_0120_CER": "Ach, hör schon auf! Vergiss nicht,\r\nwessen Elementarmagie du für deine\r\nVerwandlungen benutzt!",
  "CE_002815_0000_CER": "Hnngh... Argh... Ha!",
  "SM_002140_0060_FAS": "„Ihr habt euch prima um den Zirkus\r\ngekümmert. Ich wusste, ich habe\r\nmich nicht in dir getäuscht.“",
  "SM_002060_0000_COL": "„Das ist unser geheimer Zufluchtsort!\r\nEigentlich ist er nur für Irrlichter,\r\naber ich mache mal eine Ausnahme.“",
  "BK_2000_0050_CER": "„I-ich kann auch kämpfen!\r\nBehandle mich nicht wie\r\nein hilfloses Kind!“",
  "LV_002035_0015_NAR": "Cheshire klang sehr unzufrieden.",
  "SM_002130_0135_CER": "„Na gut... Erzähl mir mehr.“",
  "LV_002900_0000_CER": "Was ist das für ein komischer Hofnarr?\r\nStändig legt er uns Steine in den Weg!",
  "SM_002010_0100_COL": "„Ich würde ihnen gerne helfen,\r\naber allein kann ich gegen\r\ndiese Feen nichts ausrichten!“",
  "SM_002010_0180_NAR": "Cheshire machte deutlich, dass er\r\nmit dieser Rettungsaktion nichts\r\nzu tun haben wollte.\r\nDoch Cereza war fest entschlossen.",
  "SM_002010_0010_NAR": "Cereza erinnerte sich an etwas,\r\ndas ihr Morgana vor langer Zeit\r\nerzählt hatte.\r\nKinder, die in Avalon umkommen,\r\nwerden zu Irrlichtern, ihre Seelen\r\ndazu verdammt, auf ewig im Wald\r\numherzuirren.",
  "CE_002070_0000_CER": "Zeit fürs große Finale!",
  "LV_002080_0020_NAR": "Cereza gähnte unwillkürlich.\r\nSie war sehr erschöpft.",
  "SM_002140_0100_NAR": "Nun, da Cereza wusste, dass die\r\nStimme einem Irrlicht gehörte,\r\nwar sie viel entspannter.",
  "SM_002130_0150_FAS": "„Der verrückte Zirkusdirektor dort\r\nversklavt Unglückliche, die dann\r\nbis zu ihrem Tode in seinen\r\nVorstellungen auftreten müssen.“",
  "SM_002040_0050_CER": "„Sieh doch nur, wie glücklich sie\r\nsind! Colm und seine Freunde können\r\nwieder zusammenleben.\r\nVielleicht finden sie dadurch etwas\r\nTrost in diesem verlassenen Wald...“",
  "SM_002140_0010_CER": "„Diese Stimme...!“",
  "SM_002140_0210_FAS": "„Stimmt etwas nicht?“",
  "SM_002110_0090_CER": "„Weißt du überhaupt, wie wichtig\r\ndas Haar einer Hexe ist?\r\nPass doch besser auf!“",
  "_05": "",
  "SM_002130_0120_FAS": "„Allerdings werden diese\r\nElementarkerne nicht so leicht\r\nzu finden sein, wie du denkst.“",
  "LV_002930_0000_CER": "Ach, du kannst Rosmarin ja nicht leiden.\r\nNa schön, bleib einfach, wo du bist.",
  "SM_002140_0045_CER": "„Du bist diejenige, die vorhin\r\nmit uns gesprochen hat!“",
  "CE_002040_0000_CER": "Hey, die Schalter wurden gedreht\r\nund lassen sich jetzt betätigen!",
  "SM_002130_0080_FAS": "„Oh, aber du suchst doch nach\r\neinem weißen Wolf, nicht wahr?“",
  "_01": "",
  "SM_002130_0110_FAS": "„Hab Vertrauen in den Pfad, den du\r\nbeschreitest... Es ist der richtige.“",
  "SM_002040_0180_CER": "„Wäre ich stärker gewesen, hätte ich\r\nsie in jener Nacht retten können...“",
  "SM_002040_0100_NAR": "Doch kaum hatte Cereza dies\r\ngesagt, wurde ihr etwas klar...",
  "IN_2000_0010_NAR": "Für Cerezas neckische Bemerkung hatte\r\nder Dämon nur einen kühlen Blick übrig.",
  "LV_002070_0010_NAR": "Cereza quietschte vor Vergnügen.\r\nSie war letzten Endes eben noch ein Kind.",
  "SM_002140_0180_FAS": "„Mach dir da mal keinen Kopf.\r\nDu musst nur das Wasser ablassen!“",
  "_54": "",
  "LV_002005_0030_NAR": "[FONT:10 ]Sieht lecker aus. Nichts wie hin![FONT:N ]",
  "SM_002100_0110_COL": "„Kann ich euch noch um\r\neine Sache bitten?“",
  "SM_002080_0010_CER": "„Nicht schlecht, hm? Ich sag's ja, ich\r\nhab noch mehr auf dem Kasten, als dich\r\nbloß durch die Gegend zu schleppen.“",
  "SM_002050_0000_COL": "„Danke, Cereza!“",
  "SM_002140_0220_CER": "„Nein, alles gut!\r\nGlockentürme... Riesenstatuen...\r\nJepp! Hexen lieben hoch gelegene\r\nOrte! Danke für die Hilfe!“",
  "LV_002010_0010_CER": "Eines der armen Irrlichter wird\r\nvon den Feen gequält... Aber...\r\nAllein kann ich nichts ausrichten...",
  "SM_002100_0120_COL": "„Falls ihr im Wald weiteren meiner\r\ngefangenen Freunde begegnet,\r\nwärt ihr dann so lieb, sie auch zu\r\nbefreien und hierherzuschicken?“",
  "IN_2000_0020_NAR": "[FONT:10 ]Ich erledige alle,\r\ndie mir zu nahe kommen.[FONT:N ]",
  "CE_002080_0000_CER": "Hnnnngh!",
  "SM_002130_0160_CER": "„Bis... zu ihrem Tode?“",
  "SM_002080_0040_NAR": "Cereza hatte die Nase voll von\r\nCheshires arrogantem Gehabe.",
  "LV_002035_0115_NAR": "Cheshire funkelte Cereza bedrohlich an.",
  "LV_002040_0030_CER": "Ich wünschte, ich hätte mit Mami\r\nan so einem Ort spielen können...",
  "BK_2000_0040_NAR": "[FONT:9 ]Aus dem Weg![FONT:N ]\r\nblaffte Cheshire die\r\nverängstigte Cereza an.",
  "SM_002060_0090_COL": "„Und für dich habe ich das hier. Wir\r\nwissen nicht, wie man's benutzt, doch\r\nes scheint irgendwie magisch zu sein.“",
  "CE_002800_0000_CER": "Solange er auf diesem Ball hockt,\r\nkommen wir nicht weiter. Wir sollten\r\nihm den Ball unterm Hintern wegziehen!",
  "SM_002060_0100_CER": "„Vielen Dank!“",
  "IN_2000_0040_CER": "Ach, wirklich?",
  "SM_002130_0010_CER": "„W-wer ist da?!“",
  "CE_002000_0000_CER": "Komm da runter!",
  "SM_002060_0130_COL": "„Nicht der Rede wert!\r\nLass mich wissen, wenn du\r\nsonst noch was brauchst.“",
  "LV_002035_0020_CER": "So, wie du dich ständig beschwerst, könnte\r\nman eher meinen, deine Zunge wär zum\r\nJammern da. Du willst nach Hause, oder?",
  "SM_002130_0210_FAS": "„Wie auch immer,\r\nich muss nun weiter.\r\nIch wünsche euch beiden\r\neine gute Reise.“",
  "SM_002100_0050_CER": "„Der weiße Wolf!“",
  "LV_002055_0010_NAR": "Der Gedanke an die Rettung der Irrlichter\r\nließ Cerezas Herz etwas höher schlagen.",
  "LV_002905_0010_CER": "Der Elementarkern ist nah!\r\nVielleicht in dem Zelt dort...?",
  "LV_002090_0010_CER": "Was ist das denn?",
  "BK_2010_0040_LUC": "„Genug der Tränen...“",
  "SM_002010_0030_COL": "„Wer bist denn du?\r\nHast du dich verlaufen?“",
  "SM_002040_0040_NAR": "[FONT:9 ]Was hatte es jetzt für einen\r\nSinn, diese Dinger zu retten?[FONT:N ]\r\nfragte er geradeheraus.",
  "SM_002110_0070_CER": "„Cheshire!\r\nAaah, jetzt ist mein Haar total verklebt!“",
  "SM_002010_0000_CER": "„Ist das etwa ein... Irrlicht?“",
  "SM_002130_0060_FAS": "„Frag mich doch mal etwas, wenn\r\ndu mir nicht glaubst. Ich werde\r\ndir jede Frage beantworten.“",
  "SM_002140_0030_NAR": "Cereza folgte der Richtung der\r\nStimme und erblickte ein seltsames\r\nIrrlicht mit einem großen Hut.",
  "SM_002040_0070_NAR": "[FONT:9 ]Was kümmern die mich?[FONT:N ]\r\nantwortete Cheshire.\r\nDämonen sind eben nicht gerade für\r\nihre Selbstlosigkeit bekannt.",
  "SM_002140_0120_CER": "„Du sagtest, dein Name\r\nsei Ignis, richtig?“",
  "SM_002010_0190_CER": "„Ich gehe jetzt – und wenn ich diese\r\nFeen ganz allein bekämpfen muss!“",
  "LV_002915_0000_CER": "Jippiiieee!\r\nIch frage mich, wohin das führt?",
  "LV_002050_0010_CER": "Ich muss vorsichtig sein. Wenn sie mich\r\nentdecken, stecke ich in der Klemme.",
  "SM_002130_0180_FAS": "„Doch keine Sorge. So leicht\r\nwerden du und dein Dämon\r\nschon nicht ins Gras beißen.“",
  "SM_002140_0150_CER": "„Am Grunde des Sees?!“",
  "SM_002040_0110_CER": "„Oh... Ich schätze, ich habe dich von\r\njenen getrennt, die du liebst, als ich\r\ndich in diese Welt gerufen habe...“",
  "SM_002040_0190_NAR": "Als sie dies sagte, musste sie wieder\r\nan jene Nacht denken, in der sie ihre\r\nMutter nicht hatte retten können.",
  "SM_002010_0160_NAR": "Das Mädchen und der Dämon starrten\r\neinander an. Keiner wollte nachgeben.",
  "SM_002010_0070_CER": "„Du siehst besorgt aus, Colm.\r\nIst irgendetwas passiert?“",
  "SM_002040_0080_CER": "„Was sagst du denn da? Du würdest\r\nsie also einfach zurücklassen?“\r\n",
  "LV_002925_0000_CER": "Haben wir... Plätze getauscht...?",
  "SM_002020_0080_NAR": "[FONT:9 ]Ach? Was kann ein Schwächling\r\nwie du schon ausrichten?[FONT:N ]\r\nDer Dämon lachte leise, sein Maul\r\nzu einem gehässigen Grinsen verzogen.",
  "SM_002020_0000_CER": "„Cheshire!“",
  "SM_002140_0160_CER": "„Na, das ist ja ein Glück...\r\nIch kann sowieso viel besser\r\nuntergehen als schwimmen...“",
  "SM_002110_0080_NAR": "Cheshire verspeiste genüsslich seinen\r\nImbiss, während Cereza erfolglos\r\nversuchte, das Fruchtfleisch\r\naus ihren Haaren zu quetschen.",
  "SM_002010_0040_CER": "„D-du kannst ja sprechen!“",
  "SM_002060_0050_NAR": "[FONT:9 ]Wir müssen weiter. Wir haben\r\nkeine Zeit, mit diesen\r\nWinzlingen herumzualbern.[FONT:N ]\r\nsagte Cheshire, während er Colm beäugte.",
  "LV_002005_0010_CER": "Was mag das sein?",
  "SM_002050_0010_NAR": "Colm freute sich riesig und erklärte,\r\ner wolle sich dafür erkenntlich zeigen,\r\ndass sie seine Freunde gerettet haben.",
  "SM_002080_0000_NAR": "Sie hatten die furchterregende Fee\r\nbesiegt. Und Cereza hatte das Gefühl,\r\ndass sie zumindest geringfügig dazu\r\nbeigetragen hatte.",
  "BK_8100_0010_CER": "„Ich weiß, nur mit der Ruhe.\r\nIch frage mich, was für eine Kraft\r\nes dir diesmal verleihen wird...“",
  "CE_002030_0000_CER": "Was sind das für Schalter\r\nvor diesen Säulen?",
  "CE_002100_0000_CER": "Cheshire, hilf mir!",
  "SM_002130_0050_CER": "„...Sagt die gruselige Stimme\r\naus den Schatten.“",
  "SM_002140_0080_FAS": "„Was für ein Jammer.“",
  "IN_2000_0000_CER": "Ach, erst machst du so ein Theater,\r\nund am Schluss hilfst du doch!",
  "SM_002010_0080_COL": "„Die Feen... haben meine\r\nFreunde verschleppt...“",
  "SM_002130_0170_FAS": "„Verzeihung... Habe ich\r\ndir damit Angst gemacht?“",
  "SM_002010_0110_CER": "„Dann werde ich mich eben um\r\ndiese Feen-Fieslinge kümmern!“",
  "LV_002095_0010_CER": "Hey, dieses Kunststück hab ich mal auf einem\r\nJahrmarkt gesehen. Hätte nicht gedacht,\r\ndass ich es selbst mal aufführen müsste...",
  "SM_002010_0044_CER": "„Ich bin Cereza. Und du?“",
  "SM_002140_0230_FAS": "„Gern geschehen.“",
  "SM_002020_0040_NAR": "[FONT:9 ]Wenn dir was passiert,\r\nbin ich auch dran.[FONT:N ]\r\nDer Dämon dachte letztlich\r\neben nur an sich selbst.",
  "SM_002120_0000_NAR": "[FONT:10 ]Geht das nicht schneller?[FONT:N ]\r\nDer Wolf lief ihnen davon und Cheshire\r\nwar nicht glücklich darüber.",
  "LV_002030_0020_CER": "Vielleicht können wir damit\r\nOrte erreichen, die vorher\r\nunzugänglich waren!",
  "CE_002805_0000_CER": "Ständig weicht er den Schüssen aus!\r\nIrgendwie müssen wir ihn doch treffen\r\nkönnen...",
  "LV_002030_0010_CER": "Diese neue Kraft...",
  "SM_002010_0120_COL": "„Was, wirklich?!“",
  "SM_002040_0150_NAR": "[FONT:9 ]Neugeboren und schon so stark!\r\nWarte nur, bis ich groß bin![FONT:N ]\r\nDer Dämon unterbrach Cerezas\r\nGrübelei mit stürmischem Gelächter.",
  "SM_002140_0110_NAR": "Cheshire dahingegen gab keinen\r\nTon von sich. Das Irrlicht schien\r\nihn nicht zu interessieren.",
  "LV_002080_0030_NAR": "Und so beschloss sie,\r\nhier eine kleine Rast einzulegen.",
  "SM_002130_0140_FAS": "„Wenn du weitergehst, wirst du auf ein\r\ngroßes Zirkuszelt stoßen, mit dem die\r\nFeen Menschenkinder in den Wald locken.“",
  "SM_002130_0090_CER": "„W-woher weißt du das?“",
  "LV_002910_0000_CER": "Dieses Geräusch...!\r\nEs bewegt sich auf uns zu!",
  "SM_002100_0140_CER": "„Ich gebe dir mein Wort!“",
  "SM_002100_0060_NAR": "Beim Anblick des weißen\r\nWolfes sprang Cereza auf.",
  "LV_002055_0020_CER": "Diese Feen sind einfach fürchterlich.\r\nKeine Angst, Irrlichter! Ich rette euch!",
  "CE_002060_0000_CER": "Oh, sie sind mit den Schaltern gekoppelt.",
  "SM_002100_0170_COL": "„Pass auf dich auf, Cereza.\r\nUnd du auch, Kätzchen!“",
  "LV_002090_0020_NAR": "In der Ferne stach ein massives, blutrotes Zelt empor.\r\nEs schien Cereza zu verspotten, und sie fühlte sich\r\nauf seltsame Weise davon angezogen.",
  "SM_002140_0070_FAS": "„Ich wage zu behaupten, dass der\r\nZirkusdirektor so bald keinen Spaß\r\nmehr mit seiner Schaukel haben wird.“",
  "SM_002060_0010_COL": "„Nanu? Wo ist denn dein\r\nKatzenkumpane hin?“",
  "SM_002130_0020_NAR": "Die Stimme kam so unerwartet, dass\r\nCerezas Herz einen Sprung machte.\r\n",
  "SM_002130_0130_CER": "„Sogar über die Elementarkerne\r\nweißt du Bescheid?!“",
  "LV_002035_0010_NAR": "[FONT:10 ]Meine Zunge ist dazu da, sich an Feinden\r\nzu laben. Wie oft muss das hier noch sein?[FONT:N ]",
  "SM_002100_0100_CER": "„Tut mir leid,\r\naber wir haben's eilig!“",
  "LV_002005_0020_NAR": "Cereza entdeckte etwas,\r\ndas wie eine Frucht aussah.",
  "SM_002140_0200_CER": "„Der höchste Baum, hm...“",
  "SM_002080_0030_CER": "„Hmpf, eingebildeter Dämon!“",
  "SM_002100_0090_COL": "„Och, ihr geht schon?“",
  "SM_002100_0010_NAR": "Die letzten Worte des Jungen\r\nhallten in ihren Ohren nach.\r\n",
  "SM_002050_0020_COL": "„Folgt mir!“",
  "SM_002140_0190_FAS": "„Jedoch führt der einzige Weg\r\ndorthin über einen gewaltigen Baum.\r\nUm an den Grund des Sees zu gelangen,\r\nmusst du also zunächst den höchsten\r\nBaum des Waldes erklimmen.\r\nIst das nicht poetisch?“",
  "LV_002920_0000_CER": "Es kommt hierher!\r\nWas ist das für ein Ding?!",
  "LV_002065_0010_CER": "Du bist ganz schön flink für so\r\nein kleines Kerlchen, Colm!",
  "SM_002140_0000_FAS": "„Hattet ihr Spaß im Zirkus?“",
  "SM_002030_0010_NAR": "Für Cerezas neckische Bemerkung hatte\r\nder Dämon nur einen kühlen Blick übrig.",
  "SM_002060_0060_COL": "„Was für ein mürrisches Kätzchen!\r\nDabei hab ich auch was für dich!“",
  "CE_002050_0000_CER": "Was diese Hebel wohl tun...?",
  "SM_002060_0140_NAR": "...sprach's und eilte davon,\r\num mit seinen geisterhaften\r\nGefährten umherzutollen.",
  "SM_002030_0020_NAR": "[FONT:10 ]Ich erledige alle, die mir zu\r\nnahe kommen. Im Gegensatz zu dir\r\nweiß ich mich zu verteidigen.[FONT:N ]\r\nfuhr der Dämon sie an.",
  "IN_2000_0030_NAR": "[FONT:10 ]Im Gegensatz zu dir weiß\r\nich mich zu verteidigen.[FONT:N ]\r\nfuhr der Dämon sie an.",
  "SM_002100_0130_COL": "„Wir werden uns auch erkenntlich\r\nzeigen, versprochen!“",
  "SM_002100_0020_NAR": "Cereza verspürte eine Wärme in\r\nder Brust, als wäre inmitten dieses\r\nfinsteren, kalten Waldes eine Flamme\r\nin ihrem Herzen entfacht worden.",
  "SM_002130_0220_NAR": "Die Stimme verklang, und Stille\r\nlegte sich wieder über den Wald.",
  "SM_002120_0040_NAR": "Der Dämon erwiderte nichts, doch sein\r\ntrotziger Blick war Cereza Antwort genug.",
  "_71": "",
  "SM_002040_0120_NAR": "[FONT:9 ]Ich wurde gerade erst geboren.\r\nEs gibt keinen, den ich liebe.\r\nIch brauche keine Liebe. Nur Stärke.[FONT:N ]\r\nDie Philosophie des Dämons war simpel.",
  "SM_002110_0110_CER": "„S-sei still!\r\nIch arbeite noch dran, wart's nur ab!“",
  "SM_002010_0150_CER": "„Na, wir können sie doch\r\nnicht einfach im Stich lassen!“",
  "BK_2010_0020_CER": "„M-Mami?\r\nWo bist du, Mami?“",
  "CE_002035_0000_CER": "Wenn man einen betätigt, richtet\r\nsich der Scheinwerfer auf die Säule...",
  "SM_002130_0100_FAS": "„Du bist nun ein Teil dieses Waldes.\r\nDas heißt, deine Angelegenheiten\r\nsind auch meine Angelegenheiten.“",
  "BK_2010_0010_CER": "„Warum... Warum geht es nicht auf?“",
  "SM_002040_0000_CER": "„Bin ich froh, dass es euch allen gut\r\ngeht. Das war riskanter, als ich dachte.“",
  "SM_002140_0040_CER": "„Ein Irrlicht?“",
  "CE_002090_0000_CER": "Ich kann mich... nicht bewegen...",
  "SM_002020_0030_NAR": "Cereza war insgeheim glücklich,\r\ndoch Cheshire wirkte mürrisch.",
  "SM_002010_0020_CER": "„Hallo, mein Kleiner.\r\nAlles in Ordnung?“",
  "SM_002140_0090_CER": "„Das war vielleicht ein Grobian!\r\nUnd ich soll auch noch ungefragt in\r\nseiner Show mitmachen? Nein, danke!“",
  "SM_002130_0040_FAS": "„Nun, eine Fee bin ich jedenfalls nicht.\r\nDarauf kannst du dich verlassen.“",
  "LV_002025_0010_CER": "Wir können die Irrlichter\r\nnicht einfach im Stich lassen!",
  "CE_002810_0000_CER": "Ich hab genug von deinen Tricks!\r\nCheshire!",
  "SM_002120_0020_CER": "Wir könnten viel schneller\r\nvorankommen, wenn du mich\r\nauf deinem Rücken reiten ließest!",
  "SM_002020_0060_CER": "„Ob du nun dabei bist oder nicht,\r\nich werde diese Irrlichter retten!\r\nDu wirst schon sehen!“",
  "SM_002130_0240_CER": "„Wer war das bloß...?“",
  "CE_002010_0000_CER": "Das ist unsere Chance!",
  "SM_002120_0010_CER": "Ich laufe schon, so schnell ich kann!",
  "SM_002020_0050_CER": "„Hmpf.“",
  "LV_002080_0010_CER": "",
  "SM_002140_0130_CER": "„Du weißt nicht zufällig, wo wir\r\ndie restlichen Elementarkerne\r\nfinden, oder, Ignis?“",
  "SM_002040_0170_CER": "„I-ich werde auch noch stärker!\r\nAber auf viel stilvollere Weise\r\nals eine gewisse andere Kreatur!“",
  "LV_002045_0010_NAR": "Wir müssen erst diese Zugbrücke runterlassen.",
  "SM_002140_0020_NAR": "Eine bekannte Stimme hallte durch den Wald.",
  "SM_002010_0090_NAR": "Colms Unterlippe zitterte\r\nbei diesen Worten.\r\n\r\nEr erklärte, dass die Feen gerne\r\nIrrlichter zusammentrieben und\r\nnur zum Spaß quälten.",
  "SM_002060_0110_COL": "„Cereza, du siehst müde aus.\r\nHier ist es sicher, also warum\r\nruhst du dich nicht ein wenig aus?“",
  "SM_002060_0080_CER": "„Ich glaube, so glücklich war er\r\nschon lange nicht mehr. Danke!“",
  "LV_002035_0110_NAR": "[FONT:10 ]Hmpf, ohne mich kriegst du\r\neben nichts auf die Reihe![FONT:N ]",
  "BK_2010_0060_LUC": "„Die liebevolle Umarmung einer\r\nMutter... Du wirst sie bald wieder\r\nspüren können. Genau wie ich...“",
  "LV_002085_0020_NAR": "Sie spielte gern mit den Irrlichtern, doch\r\nihre Reise war noch lange nicht vorbei.",
  "LV_002040_0020_CER": "Oder... lebten hier einmal Menschen?",
  "SM_002100_0160_NAR": "Sie verabschiedeten sich von Colm\r\nund setzten die Verfolgungsjagd\r\nfort. Der weiße Wolf war nicht fern!",
  "SM_002100_0070_CER": "„Cheshire! Ich hoffe,\r\ndu bist startklar?“",
  "LV_002040_0010_CER": "Was ist das eigentlich für ein Ort...?\r\nEin Feenspielplatz vielleicht?",
  "BK_2010_0050_LUC": "„Du bist stärker, als du denkst...\r\nDein Wunsch, andere zu retten,\r\nwird dir Stärke verleihen...“",
  "LV_002085_0010_NAR": "Cereza machte sich wieder in den Wald auf.",
  "SM_002130_0200_FAS": "„Das beweist doch, dass sie sich vor dir\r\nfürchten. Und vor dem Dämon natürlich...“",
  "CE_002000_0010_CER": "Da kommt Cheshire nicht ran.\r\nDas ist doch unfair!",
  "SM_002060_0120_CER": "„Jetzt, wo du es sagst...\r\nIch war bisher ganz schön nervös\r\nseit ich diesen Wald betreten habe.\r\n\r\nDanke für alles, Colm.“",
  "SM_002140_0140_FAS": "„Aber natürlich weiß ich das.\r\nDer nächste Kern liegt am\r\nGrunde des Sees.“",
  "SM_002100_0030_CER": "Wann ich ihn wohl\r\nwiedersehen werde...",
  "SM_002060_0040_NAR": "[FONT:9 ]Schwächlinge wie der da\r\nsind mir doch egal.[FONT:N ]",
  "SM_002130_0070_CER": "„In Ordnung... Ähm... Hast du in\r\nletzter Zeit irgendwelche wei–\r\nschwarzen Wölfe im Wald gesehen?“",
  "SM_002030_0030_CER": "„Ach, wirklich!“",
  "LV_002065_0110_CER": "Ehrlich gesagt habe ich euch Irrlichter\r\nbis zu unserer Begegnung immer für\r\nein Ammenmärchen gehalten.",
  "SM_002030_0000_CER": "„Ach, erst machst du so ein Theater,\r\nund am Schluss hilfst du doch!“",
  "SM_002060_0070_NAR": "[FONT:9 ]Denkst du, der Appetit eines\r\nDämons ist so leicht zu stillen?[FONT:N ]\r\nEr gab sich völlig ungerührt, doch der\r\nSpeichel, der aus seinem Maul tropfte,\r\nstrafte ihn Lügen.",
  "LV_002935_0000_CER": "Siehst du? Ich hab doch gesagt,\r\ndass ich sie selbst retten werde.",
  "SM_002080_0020_NAR": "Doch Cheshire war nicht beeindruckt.",
  "SM_002100_0000_CER": "„Genau wie ich...“",
  "BK_8100_0000_CER": "„Genau wie letztes Mal...“",
  "BK_2000_0020_NAR": "Eine gewaltige Fee überraschte sie.\r\nWieder einmal war Cereza wie\r\nversteinert vor Furcht.",
  "SM_002020_0020_CER": "„Wusst ich's doch, dass du noch\r\nkommst! Immerhin brauchst du meine\r\nmagische Energie. Nun, das heißt\r\nwohl, ich kann wieder auf deine\r\nscharfen Krallen zählen?“",
  "SM_002040_0090_CER": "„Du weißt wohl nicht, wie es ist,\r\nwenn man gewaltsam von einer\r\ngeliebten Person getrennt wird!“",
  "SM_002130_0000_FAS": "„Hallo, meine Kleine.“",
  "SM_002040_0010_NAR": "Cereza versuchte, sich nichts anmerken zu\r\nlassen, doch sie war beschämt, dass der\r\nDämon sie wieder hatte retten müssen.",
  "SM_002010_0060_COL": "„Ich heiße Colm!“",
  "SM_002130_0190_FAS": "„Ihr habt für große Aufregung\r\nunter den Feen gesorgt, seit\r\nihr diesen Wald betreten habt.“",
  "LV_002015_0010_CER": "Cheshire, ein Irrlicht steckt in\r\nder Klemme. Helfen wir ihm!",
  "SM_002040_0020_NAR": "Cheshire dahingegen hatte nichts anderes\r\nerwartet. Er saß da und betrachtete die\r\nIrrlichter mit desinteressierter Miene.",
  "SM_002130_0030_FAS": "„Eine gute Frage. Sagen wir... Ich bin die\r\nPerson, mit der man spricht, wenn man\r\nwissen möchte, was hier im Wald vorgeht.“",
  "SM_002010_0140_NAR": "Colm war nicht der Einzige, den\r\nCerezas kühne Behauptung überraschte.",
  "CE_002020_0000_CER": "Du entkommst uns nicht!",
  "SM_002110_0100_NAR": "[FONT:9 ]Ach? Dafür, dass du so viel davon hast,\r\nhat's dir bisher herzlich wenig geholfen.[FONT:N ]\r\ngab der Dämon überraschend frech zurück.",
  "SM_002140_0170_CER": "„Das einzige Problem ist\r\ndas Wiederauftauchen...“",
  "SM_002040_0130_CER": "„Du wurdest gerade erst geboren?\r\nDann bist du also...“",
  "SM_002020_0090_NAR": "Cereza tat so, als hätte sie das\r\nnicht gehört, und ging weiter.",
  "SM_002120_0050_CER": "Ja, das dachte ich mir.",
  "SM_002130_0230_CER": "„Weg ist sie...“"
}
