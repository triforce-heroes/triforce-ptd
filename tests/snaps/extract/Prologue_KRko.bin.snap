{
  "SM_000040_0050_NAR": "그렇게 말은 했지만\r\n세레자는 아발론의 숲이 신경 쓰여\r\n일이 손에 잡히지 않습니다.",
  "BK_0020_0000_NAR": "일을 마치고 나면,\r\n언제나처럼 마도술 훈련이 시작됩니다.",
  "SM_000070_0090_CER": "「모르가나는 나를 전혀\r\n칭찬해 주지 않는단 말이지.\r\n마도술을 잘 해냈을 때도 그렇고」",
  "BK_0020_0030_NAR": "그건 누구나 시선을 빼앗길 정도로\r\n예쁘게 반짝이는 마도기였습니다.",
  "SM_000020_0050_CER": "「잔느…… 하지만, 나……」",
  "SM_000070_0020_NAR": "그때, 꿈속에서 신기한 소년이\r\n했던 말이 떠올랐습니다.",
  "LV_000050_0000_CER": "싫어어어어어어!!!",
  "BK_0010_0070_NAR": "그 꿈은 매일같이 꾸는 악몽이었습니다.\r\n하지만 오늘 꿈은 평소와 조금\r\n달랐습니다.",
  "LV_000900_0000_NAR": "『지금 난 기분이 안 좋아. 다 찢어 버리겠어!』\r\n악마는 갑자기 나타난 요정에게 달려들었습니다.",
  "SM_000040_0180_MOR": "으흠!",
  "SM_000055_0070_CER": "「저 꽃,\r\n모르가나한테 어울리려나……?」",
  "SM_000040_0060_NAR": "그걸 눈치챈 모르가나는\r\n세레자를 꾸짖었습니다.",
  "SM_000060_0070_MOR": "「그리고 세레자, 오늘따라 머릿결이\r\n거칠어 보이는데……\r\n설마 머리 손질을 게을리하고\r\n있지는 않겠지요?」",
  "LV_000035_0000_CER": "앗!?",
  "SM_000060_0110_CER": "「물론이지! 훈련 전까지는\r\n꼭 손질해 둘게」",
  "SM_000020_0060_JEA": "「……너도 참……」",
  "SM_000060_0080_CER": "「그럴 리가 없잖아!\r\n……오늘은 아직 안 했지만」",
  "SM_000070_0030_LUC": "\"내가…… 힘을 줄게……\r\n어머니를 구할 힘을……\"",
  "SM_000060_0000_NAR": "세레자는 가득찬 바구니를\r\n자신 있게 건넸습니다.",
  "LV_000105_0000_CER": "살짝 부족한가?",
  "BK_0000_0050_NAR": "그 여자아이의 단 하나뿐인 희망은\r\n주위의 눈을 피해 감옥에 있는 엄마를 만나러 가는 것이었습니다.",
  "SM_000060_0185_NAR": "그날 밤……",
  "SM_000050_0040_NAR": "……세레자가 자신 없어 하는\r\n일이기 때문입니다.",
  "LV_000905_0000_CER": "이건…… 요정들의 보물 상자?\r\n뭐가 들어 있을까……?",
  "BK_0000_0060_NAR": "\r\n엄마는 좁고 차가운 감옥에서도\r\n아이에게 늘 미소를 보였고, 무한한 애정을 주었습니다.",
  "LV_000090_0000_CER": "자, 너희들이 가장 좋아하는 마력을 줄게!",
  "LV_000085_0010_NAR": "평소에는 해를 피해 땅속에 숨어 있지만\r\n마력을 주면 한꺼번에 튀어나옵니다.",
  "SM_000050_0070_NAR": "세레자는 순순히 밭으로 향했습니다.",
  "IN_0010_0040_JEA": "얼마 안 남았어. 서두르자!",
  "SM_000060_0030_NAR": "바구니 안에는 제비꽃 화환이\r\n같이 들어 있었습니다.",
  "IN_0025_0002_JEA": "세레자!",
  "SM_000050_0000_NAR": "물이 가득 든 물통을 건네자, 모르가나는\r\n만족한 듯이 고개를 끄덕였습니다.",
  "LV_000055_0000_MOR": "세레자!\r\n세레자!",
  "BK_0000_0010_NAR": "현자와 마녀는 싸움을 피하기 위해\r\n규칙을 정해 서로를 멀리해 왔지만,\r\n어느 현자와 마녀가 사랑에 빠져,\r\n한 아이가 태어났습니다.",
  "BK_0010_0020_LUC": "「내가…… 힘을 줄게……\r\n어머니를 구할 힘을……」",
  "LV_000005_0000_CER": "뭔가…… 보이기 시작했어",
  "SM_000060_0040_NAR": "그러나 모르가나는 얼굴빛도 안 바꾸고\r\n평소와 다름없는 말투로 말했습니다.",
  "SM_000020_0020_JEA": "「뭐 하고 있어!」",
  "IN_0010_0000_JEA": "왜 그래, 세레자!\r\n꾸물대지 마!",
  "LV_000935_0000_CER": "후우, 슬슬 훈련할 시간이네.\r\n모르가나한테 혼나기 전에 빨리 마당으로 가자",
  "BK_0020_0200_NAR": "모르가나는 세레자의 말을 듣지 않고\r\n뒤돌며 말했습니다.",
  "BK_0000_0020_NAR": "마치 보석처럼 예쁜 여자아이였습니다.",
  "SM_000070_0050_NAR": "하지만 모르가나에게 아발론의 숲에는\r\n절대 들어가선 안 된다고\r\n몇 번이나 주의를 받았었습니다.",
  "IN_0010_0030_CER": "아, 알겠어!",
  "SM_000070_0140_CER": "「……그렇지, 아까만 해도\r\n한 번 더 기회를 줬으면\r\n성공할 수 있었다고」",
  "IN_0000_0040_WIC": "「거기서 뭐 하는 거야!」\r\n",
  "BK_0010_0110_CER": "「하지만 그 숲은……」",
  "IN_0000_0030_WID": "마을에서 나가!",
  "SM_000055_0000_CER": "「해냈다!」",
  "SM_000040_0100_CER": "「그, 그 정돈, 알고 있어」",
  "SM_000055_0030_CER": "「틀림없이 모르가나도 놀랄 거야!」",
  "SM_000030_0000_JEA": "「이런, 들켰어.\r\n저들은 내가 잡아 둘게……\r\n여기서부터는 너 혼자 가!」",
  "IN_0025_0004_JEA": "이쪽이야!",
  "SM_000040_0110_MOR": "「그럼 해가 지기 전에\r\n남은 일을 끝내 주세요」",
  "BK_0010_0060_CER": "「또 그 꿈을…… 그런데……」",
  "SM_000040_0160_NAR": "매일 시키는 일도\r\n세레자의 수행을 위해서였죠.",
  "LV_000080_0000_NAR": "물을 긷고 옮긴다.\r\n단순한 심부름 같지만……",
  "BK_0020_0100_NAR": "세레자는 소환술에 성공하겠다며\r\n기합이 들어가 있습니다.",
  "SM_000070_0080_NAR": "그렇게 생각하니 모르가나에 대한 불만이\r\n점점 쏟아져 나왔습니다.",
  "SM_000070_0110_NAR": "그렇게 체셔에게 불만을\r\n털어놓다가 문득 가지고 있던\r\n마도기가 눈에 들어왔습니다.",
  "BK_0010_0140_NAR": "그곳에는 스승인 모르가나가\r\n얼굴을 찌푸리고 서 있었습니다.",
  "SM_000040_0040_CER": "「……바로 시작할게」",
  "SM_000040_0150_NAR": "모르가나도 세레자와 똑같이\r\n마녀 일족에게 추방당한 몸인데다가,\r\n의지할 사람도 없는 세레자를 거두어 준\r\n은인이기도 했습니다.",
  "BK_0010_0130_MOR": "「세레자, 무얼 하고 있나요?」",
  "BK_0010_0050_CER": "「알았어……! 꼭 갈게!」",
  "SM_000060_0020_CER": "「그리고\r\n예쁜 제비꽃이 피어 있길래\r\n모르가나한테 어울릴까 싶어서……」",
  "SM_000060_0130_NAR": "모르가나는 그렇게 말하고는\r\n집으로 돌아가 버렸습니다.",
  "SM_000050_0060_CER": "「그, 그런 거 아냐!」",
  "LV_000910_0000_CER": "잠깐, 농담이지!?\r\n꺄아아아아아!",
  "BK_0000_0150_NAR": "여자아이의 이름은 세레자입니다.",
  "IN_0025_0003_JEA": "들켜 버리겠어!",
  "LV_000110_0000_CER": "이게 마지막이야!",
  "SM_000060_0010_CER": "「봐 봐, 모르가나!\r\n오늘은 이렇게 많이 수확했어!」",
  "LV_000020_0000_CER": "아, 알겠어!",
  "BK_0000_0120_NAR": "마을 변두리에 사는 한 추방된 마녀의\r\n곁에서 어느새 조금 성장한 여자아이의\r\n모습을 볼 수 있었습니다.",
  "LV_000920_0000_CER": "「엄마……?」",
  "SM_000060_0090_MOR": "「준비됐나요, 세레자?」",
  "IN_0020_0030_WIA": "쌤통이다!",
  "SM_000020_0080_JEA": "「세레자!!」",
  "SM_000060_0170_NAR": "남은 일도 열심히 하자!\r\n이렇게 마음을 다잡고\r\n세레자는 집으로 향했습니다.",
  "SM_000060_0100_MOR": "「엄브라의 마녀에게 머리카락은\r\n마도기이자, 악마를 불러내는 데\r\n필요한 것이기도 합니다.\r\n\r\n따라서 마녀에게 자신의 머리카락은\r\n목숨과도 같은 가치를 지니는 겁니다.\r\n당연히 알고 있겠지요?」",
  "LV_001025_0010_NAR": "체셔는 그 향기를 맡자마자\r\n다가가고 싶지 않다며 난리를 쳤습니다.",
  "LV_000120_0000_CER": "으윽…… 이 냄새만 안 나면\r\n괜찮을 텐데……",
  "SM_000070_0170_LUC": "\"아발론의 숲으로 와 줘……\r\n그러면 하얀 늑대가\r\n널 안내해 줄 거야……\"",
  "IN_0020_0000_WIA": "저리 가!",
  "LV_001025_0020_NAR": "아무래도 이 향기에는\r\n악마를 괴롭히는 힘이 있는 듯합니다.",
  "BK_0000_0080_NAR": "여자아이가 열 살이 되던 날\r\n엄마는 더욱더 어두운 어둠 속에\r\n봉인되어 버렸습니다.",
  "LV_000010_0000_CER": "나한테 왜 그러는 거야……",
  "BK_0000_0110_NAR": "그로부터 세월이 지나……",
  "LV_00015_0010_CER": "기다려, 잔느!\r\n난 너같이 뭐든 잘 해내지\r\n못한단 말이야!",
  "LV_000075_0000_CER": "무, 무거워……!\r\n너무 담았……나?",
  "PH_0020_0010_NAR": "그것이 자기 운명을\r\n크게 바꿀 것이라는 사실은 꿈에도 모른 채……",
  "SM_000055_0020_NAR": "평소에는 마력 조절을 못 해서\r\n실패하기 일쑤였지요.",
  "BK_0010_0010_CER": "「넌…… 누구야?」",
  "SM_000055_0010_NAR": "세레자는 성공해서 아주 기쁜 모양입니다.",
  "IN_0000_0010_WIB": "불결해……",
  "LV_000125_0000_NAR": "세레자는 지금부터 자기가 할 일을 생각하니\r\n살짝 무서워졌습니다. ……하지만 넘치는\r\n호기심이 그녀의 등을 힘차게 밀었습니다.",
  "SM_000070_0150_NAR": "악마만 소환한다면\r\n요정들은 아무것도 아닙니다.",
  "SM_000070_0040_CER": "「그래, 아발론의 숲에 가면……」",
  "BK_0020_0140_NAR": "큰일이 났습니다.\r\n악마는 머리카락에 깃든 상태로\r\n소환하지 않으면 조종할 수 없습니다.",
  "BK_0000_0040_NAR": "여자아이는 마녀의 마을에서 자랐지만,\r\n주위 마녀들은 규칙을 어기고 태어난\r\n그 여자아이를 못마땅해했습니다.\r\n",
  "BK_0020_0210_MOR": "「마녀가 악마를 두려워하다니요.\r\n당신에게 이 훈련은 아직\r\n빨랐나 보군요」\r\n",
  "SM_000020_0070_JEA": "「간다! 따라와!」",
  "SM_000020_0040_JEA": "「빨리 와, 세레자. 시간이 없어!\r\n이 기회를 놓치면 네 엄마랑\r\n두 번 다시……!」\r\n",
  "SM_000060_0050_MOR": "「……당연히\r\n이 정도는 수확해야죠.\r\n이런 일로 들뜨지 마세요」",
  "BK_0000_0070_NAR": "하지만, 그 자그마한 행복조차\r\n결국 끝이 다가왔습니다.",
  "LV_000040_0000_CER": "으, 으읏……!",
  "BK_0010_0040_LUC": "「아발론의 숲으로 와 줘……\r\n그러면 하얀 늑대가\r\n널 안내해 줄 거야……」",
  "LV_000085_0000_NAR": "모르가나가 기르고 있는 허브는 단순한 약초가\r\n아닙니다. 이건 무척 안 좋은 냄새를 풍기는\r\n마계의 식물이랍니다.",
  "SM_000050_0010_MOR": "「다음은 조합에 쓸 허브를 수확하세요」",
  "SM_000070_0000_NAR": "모르가나가 떠난 뒤 세레자는\r\n친구 체셔에게 오늘 일어난 일을\r\n이야기했습니다.",
  "BK_0020_0060_MOR": "「또한 오늘은 2월의 보름달이 뜨는 밤.\r\n마력이 가장 넘치는 날이니\r\n악마를 소환하기에 적합한 날이지요.\r\n\r\n……이해했나요, 세레자?」",
  "BK_0020_0010_NAR": "오늘은 드디어\r\n지금까지 배운 소환술을\r\n실습하는 날이었습니다.",
  "LV_000025_0000_CER": "조금만 더……\r\n기다려 줘, 엄마",
  "BK_0020_0090_CER": "「뭐, 그렇지!」",
  "LV_000115_0000_CER": "이제 충분하지?",
  "SM_000010_0000_CER": "서둘러야겠어……!",
  "SM_000040_0000_MOR": "「일도 하지 않고 졸고 있다니\r\n아주 여유롭나 보군요」",
  "LV_000915_0000_CER": "굉장해……! 역시 잔느야.\r\n고마워!",
  "BK_0020_0050_MOR": "「이것은, 미숙한 견습생을\r\n보조하기 위한 마도기입니다」",
  "IN_0000_0020_WIC": "가까이 오지 마!",
  "SM_000070_0120_CER": "「뭐, 뭐라는 거야!\r\n마도기를 멋대로 가지고 나가면\r\n모르가나한테 또 엉덩이를 맞을 거야!」",
  "BK_0010_0090_CER": "「신기한 남자아이가 나타나서\r\n나한테 아발론의 숲에 가면\r\n힘을 주겠다는 말을 했어」",
  "LV_000015_0000_CER": "기다려, 잔느.\r\n난 그렇게 빨리 못 달려",
  "SM_000040_0070_MOR": "「세레자, 저 숲에 뭐가 있나요?\r\n설마 잊진 않았겠지요?」",
  "BK_0010_0100_CER": "「그 힘이 있으면\r\n분명 엄마를 구할 수 있을 거야……」",
  "BK_0020_0020_MOR": "「오늘 훈련에는 이걸 사용할 겁니다」",
  "LV_000925_0000_CER": "「뭐야 이거……!\r\n싫어, 이리 오지 마……!」",
  "BK_0020_0180_MOR": "「오늘 훈련은 여기까지 하도록 하죠」",
  "SM_000070_0160_CER": "「나, 숲으로 갈래!\r\n무사히 돌아오면\r\n모르가나도 칭찬해 주겠지.\r\n\r\n그럼 가자, 체셔!」",
  "SM_000070_0070_NAR": "아직도 나를 애라 생각하고\r\n과장해서 말한 게 틀림없어……",
  "SM_000020_0000_CER": "「엄마……」",
  "SM_000040_0120_CER": "「알았어, 알았어~\r\n먼저 물을 길어 오는 거지?」",
  "SM_000040_0030_NAR": "그렇게 말하자 모르가나가\r\n무서운 눈빛으로 세레자를 쏘아봤습니다.",
  "IN_0025_0001_JEA": "뭐 하고 있어!",
  "BK_0020_0220_NAR": "모르가나는 세레자에게\r\n마도기를 정리하라 하고는\r\n자리를 떠났습니다.",
  "SM_000060_0140_CER": "「……알았어」",
  "BK_0000_0000_NAR": "옛날 옛적 어느 곳에\r\n빛의 일족 \"루멘의 현자\"와\r\n어둠의 일족 \"엄브라의 마녀\"라는\r\n신기한 힘을 다루는\r\n일족이 있었습니다.",
  "LV_000940_0000_CER": "마도술이 잘 되는 느낌이야……!\r\n이 마도기 덕분이구나",
  "LV_000005_0010_CER": "여긴……",
  "LV_000055_0010_MOR": "어디 있나요? 세레자!!",
  "SM_000050_0050_MOR": "「불만이라도 있나요?」",
  "BK_0000_0030_NAR": "하지만 아빠 현자는\r\n먼 곳으로 쫓겨나는 벌을 받았고\r\n엄마 마녀는 어두운 감옥에\r\n평생 갇히게 되었습니다.\r\n",
  "SM_000050_0020_NAR": "세레자는 그 말을 듣고\r\n자기도 모르게 표정이 굳어졌습니다.",
  "IN_0010_0010_JEA": "세레자, 이걸 써!",
  "LV_000070_0000_CER": "우왓, 휴……",
  "SM_000030_0010_CER": "「기다려 잔느! 나 혼자서는……」",
  "BK_0000_0140_NAR": "언젠가 강한 마녀가 되어\r\n엄마를 구할 날을 꿈꾸며……",
  "SM_000070_0130_NAR": "하지만 지금이라면 모르가나의 눈을 피해\r\n숲으로 갈 기회입니다.",
  "BK_0020_0120_NAR": "세레자는 여느 때와 달리 순조롭게\r\n소환술 절차를 밟아 갑니다.\r\n그리고……",
  "SM_000040_0090_MOR": "「저 숲에는 무서운 요정들이\r\n살고 있어요.\r\n절대로 들어가면 안 됩니다」",
  "LV_000095_0000_CER": "빨리 나오렴!",
  "IN_0025_0000_JEA": "빨리 와!",
  "SM_000040_0170_NAR": "세레자는 모르가나의 기대에 부응하고자\r\n가까운 우물로 향했습니다.",
  "LV_000080_0010_NAR": "이건 힘 조절과 균형 감각을 단련하는\r\n엄브라의 마녀 비전의 훈련 중 하나입니다.",
  "SM_000040_0140_NAR": "모르가나는 무서운 스승이었지만,\r\n세레자는 모르가나를 좋아했습니다.",
  "LV_000100_0000_CER": "좋은데!",
  "IN_0000_0000_WIA": "부정한 녀석!",
  "SM_000040_0130_MOR": "「……대답은 한 번만 하세요」",
  "SM_000055_0040_NAR": "기분 좋아진 세레자는 수확을\r\n계속하려다 정원 구석에 피어 있는\r\n예쁜 꽃을 발견했습니다.",
  "LV_000030_0000_CER": "엄마!",
  "LV_000060_0000_MOR": "왜 그러나요?\r\n일은 끝난 건가요?",
  "SM_000070_0010_CER": "「빨리 어엿한 마녀가 되고 싶은데……\r\n그러면 지금 당장이라도 엄마를……」\r\n",
  "BK_0020_0190_CER": "「하, 한 번만 더 하게 해 줘!\r\n다음엔 꼭……」",
  "BK_0010_0120_NAR": "아발론의 숲에는 사람을 공격하는\r\n요정이 살고 있어, 결코 다가가지\r\n말라고 접근이 금지되어 있었습니다.",
  "BK_0010_0030_CER": "「힘……?」",
  "BK_0020_0160_NAR": "위험했던 순간\r\n악마는 소멸했습니다.\r\n무언가에 깃들지 않은 악마는\r\n결국 마력이 고갈되어 죽기 때문입니다.",
  "PH_0020_0000_NAR": "이렇게 세레자는\r\n모르가나의 말을 어기고\r\n아발론의 숲을 향해 달려갔습니다.",
  "SM_000070_0060_CER": "「모르가나는 언제나\r\n\"숲은 위험합니다. 들어가면 안 돼요.\"\r\n라고 말하는데, 그렇게나 위험한\r\n장소일까?」",
  "BK_0020_0080_MOR": "「오늘은 한층 더 의욕이 넘치는군요?」",
  "LV_000930_0000_CER": "어? 저렇게 마구 뛰어다니는 거야!?\r\n빨리 잡아야겠어……!",
  "LV_000130_0000_CER": "……들어간다, 체셔",
  "SM_000040_0010_CER": "「미안해, 모르가나.\r\n잠깐만 쉬려고 했는데\r\n나도 모르게……」",
  "LV_000945_0010_CER": "아파라……\r\n험한 꼴을 당했네",
  "BK_0010_0080_NAR": "세레자는 친구 체셔에게\r\n그 이야기를 했습니다.",
  "LV_001025_0000_NAR": "세레자의 코를 간질이는 풋풋한 향기.\r\n그건 액막이로 쓰이는 로즈메리 꽃이었습니다.",
  "LV_000065_0000_CER": "영차…… 영차……",
  "IN_0020_0020_WIA": "사라져!",
  "SM_000060_0160_NAR": "하지만 세레자는 모르가나의\r\n엄격함 속에 애정이 있다는 사실을\r\n알고 있었습니다.",
  "BK_0000_0130_NAR": "여자아이는 지금\r\n그 추방된 마녀와 함께 살며\r\n험난한 수행을 하고 있습니다.",
  "BK_0000_0100_NAR": "혼자가 된 여자아이에게 위로가 되었던 건\r\n엄마가 만들어 준 인형 체셔뿐이었습니다.",
  "LV_000010_0010_CER": "그만해……\r\n이제, 그만해……!",
  "BK_0000_0090_NAR": "여자아이는 엄마를 구하려 필사적으로\r\n매달렸지만, 그 연약한 힘으로는\r\n어찌할 방도가 없었고……",
  "SM_000060_0120_MOR": "「좋습니다.\r\n그럼 다음 일을 시작하세요.\r\n서두르지 않으면 해가 질 겁니다」",
  "SM_000060_0150_NAR": "모르가나의 엄격한 태도에\r\n세레자는 기가 죽을 때도 있습니다.",
  "IN_0020_0010_WIA": "귀찮은 아이네!"
}
