{
  "CORE_DIALOG_TXT_112": "Tu as obtenu la tenue\r\n« Monde merveilleux ».",
  "CORE_DIALOG_TXT_101": "Sélectionne Tenues dans un\r\nsanctuaire pour changer l'aspect\r\nde Cereza et Chouchou.",
  "AC_NARRATION235_0010": "Les eaux bouillonnantes de cette chute\r\nse jetaient dans le lac Nimueh.",
  "CORE_SNPSS_4020": "Chouchou a été capturé\r\npar les fées. Mettant leur\r\nquerelle de côté, Cereza\r\ninfiltre la forteresse des\r\nfées avec l'aide inespérée\r\ndu loup blanc.",
  "CORE_WISP_TALK_71_FAS": "Salutations, Cereza.\r\nAs-tu découvert des\r\nempreintes de loup ?",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "Obstruction",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "Rancœur",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "Déverrouillage : apprends des\r\ncompétences avec Chouchou, et...",
  "CORE_WH_TALK_11_COL": "Grâce à vous, tout le monde s'amuse, ici.\r\nVous devriez rester et jouer un peu avec\r\nnous !",
  "CORE_SNPSS_6010": "Trahis par Lukaon, Cereza\r\net Chouchou tentent de\r\nle stopper. Réalisant ce\r\nqu'il a fait, Lukaon les\r\naide à trouver un moyen\r\nde sortir de la forêt.",
  "CORE_HTDMMESS_0039_001_H39": "Atchi ! Atcha ! Snif... je be\r\nsens pas très bien... Tu aurais\r\nun rebède pour boi ?",
  "CORE_HTDMQUEST_TXT_0026": "La beauté est présente tout\r\nautour de nous. J'aimerais\r\nune fleur pour ne pas l'oublier.",
  "AC_NARRATION260_0010": "Après avoir secouru autant de wisps, Cereza et\r\nChouchou étaient devenus les héros des opprimés\r\nd'Avalon.",
  "CORE_WH_TALK_04_COL": "Des tas de wisps sont revenus !\r\nEt ça, c'est grâce à toi et ton...\r\nton ami, là !",
  "CORE_POSEMENU_TXT_06": "Quitter le tír na nÓg.",
  "CORE_HTDMMESS_0023_001_H23": "Oh... J'ai faim... si faim...\r\nÔ nourriture chérie... Où es-tu... ?",
  "CORE_WISP_TALK_64_FAS": "Dis-toi que je suis un peu ton guide en\r\nAvalon. Je peux t'emmener où tu veux.",
  "CORE_SNPSS_3030": "Après un combat épique,\r\nCereza et Chouchou vainquent\r\nJabberwock. Guidés par le\r\nloup blanc, ils se dirigent\r\nvers le sanctuaire abritant\r\nle noyau élémentaire.",
  "CORE_SVSLT_TXT_02": "Sélectionne un fichier à charger.",
  "AC_CEREZA040_0010": "Personne t'aime.\r\nEt tu crois que tu deviendras\r\nune grande sorcière ?",
  "CORE_SNPSS_1000": "Cereza poursuit sa route\r\ndans le royaume hostile.\r\nElle semble étrangement\r\npressée...",
  "CORE_HTDMMESS_0013_002_H13": "Je les entends, tu sais...\r\nles voix qui m'appellent à les rejoindre\r\ndans la dimension de l'au-delà.",
  "CORE_WISP_TALK_28_H14": "Youhou, enfin libre ! Je vais rentrer,\r\net avaler un goûter géant !",
  "CORE_HTDMMESS_0021_002_H21": "Un sourire, une plume au chapeau...\r\nC'est le début de la gloire !",
  "CORE_POSEMENU_TXT_02": "Voir les tutoriels.",
  "CORE_POSEMENU_TXT_11": "Continuer à partir de la\r\ndernière sauvegarde.",
  "CORE_WISP_TALK_17_H03": "Tu m'as sauvé... merci mille fois.\r\nAlors, on va ouvrir cette porte ?",
  "TA_9011_0010_COL": "Sois prudente !",
  "CORE_DIALOG_TXT_005": "Le fichier de sauvegarde de\r\ncet emplacement va être effacé.\r\nContinuer ?",
  "CORE_DIALOG_TXT_116": "Tu as obtenu les tenues\r\n« Arch-Ève originelle »,\r\n« Jeanne » et « Charles ».",
  "CORE_DIALOG_TXT_105": "Fermer le menu des tenues ?",
  "CORE_HAIR_CERESSA_TXT_03": "Déterminée",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "Imprécation",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "Obscurité aveuglante",
  "CORE_WH_TALK_21_COL": "Si vous trouvez des wisps,\r\ndites-leur de venir ici. Tout seuls,\r\nils auront les chocottes.",
  "CORE_WISP_TALK_21_H07": "Enfin, je suis de nouveau libre !\r\nMerci, l'amie ! C'est génial !",
  "TEST_WISP_TALK_13_H00": "Brrr, quelque chose me file les chocottes...\r\nÇa te dérange si on attend ici ?",
  "CORE_HTDMMESS_0004_002_H04": "J'ai toujours tellement peur que des fées\r\ndébarquent... aide-moi à trouver quelque\r\nchose pour me cacher, s'il te plaît !",
  "CORE_DIALOG_TXT_150": "Choisis le paramètre pour\r\nla vitalité. « Moins »\r\natténuera les dégâts,\r\net « Aucun » les ignorera.",
  "TA_COM030_0010_CER": "Humpf !",
  "CORE_HTDMQUEST_TXT_0039": "Je suis complètement\r\nenrhubée. T'aurais pas\r\nun rebède contre ça ?",
  "CORE_WH_TALK_18_COL": "Oh ! Cereza, et M. Chouchou !\r\nMerci d'avoir secouru tout\r\nle monde !",
  "TA_COM030_0020_CER": "Hé !",
  "CORE_DIALOG_TXT_154": "Si tu trouves la Pulsation un peu trop\r\ndifficile, tu peux changer les paramètres\r\npour laisser Cereza l'utiliser seule.\r\nQue préfères-tu ?",
  "CORE_WISP_TALK_25_H11": "Merci pour ton aide !\r\nMaintenant, filons d'ici !",
  "CORE_ARCHIVE_TXT_03": "Feuillets de journaux trouvés dans la forêt",
  "AC_CEREZA130_0010": "C'est pas vrai !",
  "CORE_WH_TALK_02_COL": "Chaque fois que tu trouves des wisps,\r\nn'oublie pas de leur indiquer cet\r\nendroit. Tout seuls, ils seront perdus...",
  "CORE_WISP_TALK_32_H18": "Ouf, merci pour ton aide ! Ces sales fées...\r\nelles vont voir ce qu'elles vont voir !",
  "CORE_HTDMMESS_0029_003_H29": "Ce remède... HmmmmMMM !\r\nTu sais quoi, je sens ma motivation\r\nrevenir au galop !",
  "AC_NARRATION225_0020": "Ils ne pouvaient imaginer ce qui les attendait au-delà.",
  "CORE_HTDMMESS_0034_001_H34": "Argh, j'ai la gorge en feu...\r\nTu aurais quelque chose pour m'aider ?",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "Calamité (défi)",
  "CORE_WH_TALK_17_COL": "Tenez, c'est pour vous.\r\nJ'espère que ça vous servira.",
  "CORE_HTDMMESS_0006_001_H06": "Tu aurais quelque chose qui pourrait\r\nme servir d'aiguille ? Un truc pointu\r\ndevrait faire l'affaire.",
  "CORE_SNPSS_2010": "Cereza et Chouchou font la\r\nrencontre de Colm, un wisp\r\ndont les amis ont été\r\nenlevés par les fées.\r\nFâchée avec Chouchou,\r\nCereza part seule les aider.",
  "CORE_DIALOG_TXT_009": "Se téléporter dans ce lieu ?",
  "CORE_SNPSS_0020": "S'en remettant aux paroles du\r\ngarçon apparu dans ses rêves,\r\nCereza brave les consignes\r\nde sa professeure et part\r\npour la grande forêt hostile,\r\nfaisant taire ses peurs.",
  "CORE_WISP_TALK_30_H16": "Merci, tu m'as sauvé. Je crois que beaucoup\r\nde mes amis sont aussi enfermés dans la tour...",
  "AC_CEREZA035_0010": "Laisse tomber.\r\nTu changeras jamais.",
  "TA_COM000_0010_CER": "Hmm ?",
  "CORE_HTDMQUEST_TXT_0029": "Pff... j'ai zéro énergie...\r\nJ'ai besoin qu'on me motive...",
  "CORE_WISP_TALK_15_H01": "Merci pour ton aide... Ouaaah, je suis\r\ncrevé, moi, je vais aller faire une sieste.",
  "CORE_DIALOG_TXT_153": "Choisis les paramètres pour les ennemis.\r\n« Faible » rend les ennemis moins agressifs\r\net réduit la fréquence des attaques. « Facile »\r\nréduit le nombre d'ennemis à combattre.",
  "CORE_DIALOG_TXT_140": "Revoir toutes les instructions\r\ndans le menu Conseils de voyage?\r\n*Ce menu est disponible à tout\r\nmoment depuis le menu Système.",
  "CORE_SNPSS_5010": "Envoûté par un sort de\r\nPúca, Chouchou se retourne\r\ncontre Cereza, qui parvient\r\nà le calmer. Plus soudés\r\nque jamais, ils se hâtent\r\nde trouver Lukaon.",
  "CORE_ARCHIVE_TXT_04": "Souvenirs de l'aventure",
  "CORE_HTDMMESS_0032_001_H32": "Colm est toujours tellement altruiste...\r\nJ'aimerais lui rendre la pareille.\r\nTu aurais une idée ?",
  "TA_COM000_0020_CER": "Qu'est-ce que c'est... ?",
  "AC_NARRATION240_0010": "Des cours d'eau cristallins, sources\r\nde vie, traversaient la forêt d'Avalon.",
  "CORE_WISP_TALK_23_H09": "Merci de m'avoir aidé. Mais s'il te\r\nplaît, ne succombe pas à mon charme.",
  "AC_NARRATION215_0010": "La base secrète des wisps,\r\ndissimulée dans la forêt.",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "Mort imminente",
  "CORE_HTDMMESS_0028_001_H28": "Si j'apprends à résister à la douleur,\r\nles fées ne me feront plus peur !\r\nAlors aide-moi, s'il te plaît...",
  "CORE_DIALOG_TXT_119": "Tu as obtenu la tenue\r\n« La sorcière maladroite ».",
  "CORE_WISP_TALK_14_02_H16": "Il y a un paquet de fées à l'intérieur...\r\nJ'espère que tout le monde va bien...",
  "CORE_HTDMMESS_0017_001_H17": "Je veux pêcher ! Un groooos poisson !\r\nToi, la jeune sorcière ! Tu dois bien avoir\r\nun appât pour ça ? Steuplé !",
  "AC_NARRATION250_0020": "Savourant le sable chaud et la brise fraîche,\r\nCereza se disait que le cœur des fées n'était\r\npeut-être pas entièrement mauvais.",
  "CORE_DIALOG_TXT_011": "Le lieu sélectionné est\r\nactuellement inaccessible.",
  "AC_CEREZA145_0010": "Arrête, tais-toi !",
  "CORE_DIALOG_TXT_002": "Cet emplacement contient\r\ndéjà une sauvegarde.\r\nÉcraser les données ?",
  "CORE_HAIR_CERESSA_TXT_04": "Un nouveau chapitre",
  "CORE_DIALOG_TXT_111": "Tu as obtenu la tenue\r\n« Cygne gracieux ».",
  "CORE_DIALOG_TXT_102": "Changer la tenue de Cereza ?",
  "CORE_WISP_TALK_62_COL": "Je suis content que tout le monde soit\r\nsain et sauf. Merci infiniment, Cereza !",
  "CORE_SNPSS_4030": "Cereza libère Chouchou,\r\nqui est gravement blessé.\r\nEnfin réunis, ils repartent\r\nà la poursuite du loup\r\nblanc à l'intérieur de la\r\nforteresse.",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "Percée",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "Entraves maudites",
  "CORE_POSEMENU_TXT_05": "Reprendre au dernier point\r\nde sauvegarde du tír na nÓg.",
  "CORE_SNPSS_1010": "Souffrant encore d'avoir été\r\narrachée à sa mère Rosa,\r\nCereza est devenue l'apprentie\r\nde Morgana, s'entraînant tous\r\nles jours pour devenir elle\r\naussi une puissante sorcière.",
  "CORE_HTDMQUEST_TXT_0032": "J'aimerais offrir quelque chose\r\nà un ami pour lui faire plaisir.\r\nTu pourrais m'aider ?",
  "CORE_HTDMQUEST_TXT_0021": "Aurais-tu une idée éblouissante\r\npour mettre ma personnalité\r\nfascinante en valeur ?",
  "CORE_POSEMENU_TXT_01": "Ajuster divers paramètres de jeu.",
  "AC_IGNIS005_0010": "Besoin de mes services ?\r\nLes chemins secrets, ça me connaît !",
  "CORE_SNPSS_3020": "Grâce à la présence d'esprit\r\nde Cereza, le duo parvient\r\nà repousser la créature.\r\nAvec une assurance accrue,\r\nCereza repart à la recherche\r\ndu noyau avec Chouchou.",
  "CORE_SVSLT_TXT_01": "Sélectionne un emplacement.",
  "CORE_DIALOG_TXT_115": "Tu as obtenu les tenues\r\n« L'Œil Droit » et\r\n« Observatrice du temps ».",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "Fugacité",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "Neige et grêle",
  "CORE_HTDMMESS_0015_002_H15": "Ah, tu vois, j'étais en train de noter\r\nun fait fascinant sur cette plante...",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "Déverrouillage : trouve tous\r\nles trésors des tír na nÓg, et...",
  "CORE_DIALOG_TXT_006": "Une fois effacé, le fichier ne\r\npourra plus être restauré.\r\nEffacer ce fichier ?",
  "CORE_MISSION_TEXT_0007": "Surmonte toutes les épreuves et\r\nprends le contrôle du tír na nÓg !",
  "CORE_COSTUME_CHESHIRE_TXT_03": "Si j'ai mon chapeau, tout ira\r\nbien. Et tant pis si on me\r\ntraite de fou !",
  "CORE_DIALOG_TXT_160": "Activer les tutoriels tout au\r\nlong de cette partie ? Tu peux\r\nmodifier ce paramètre à tout\r\ninstant à partir des options.",
  "AC_CEREZA060_0030": "Mauvais chemin.",
  "CORE_HTDMMESS_0008_001_H08": "Je veux être fort... Assez pour mettre la\r\npâtée aux fées ! Tu pourrais m'aider ?",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "Rancœur (défi)",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "Aliénation (défi)",
  "CORE_CSRELEASE_CERESSA_TXT_04": "Déverrouillage : apprends des\r\ncompétences avec Cereza, et...",
  "TEST_WISP_TALK_10": "Oooh... je suis content de m'en\r\nêtre sorti, mais j'ai le vertige...",
  "TEST_WISP_TALK_03": "Merci, sœurette !\r\nSuis-moi, je vais ouvrir le portail !",
  "CORE_HTDMMESS_0015_003_H15": "Mais c'est... une mandragore !\r\nEn parfait état, en plus !\r\nIl faut que je l'étudie !",
  "AC_CEREZA050_0010": "Tu sais rien faire toute seule. Heureusement\r\nqu'il y toujours quelqu'un pour te sauver, hein ?",
  "CORE_WISP_TALK_44_H30": "Me faire attraper comme ça... la honte...\r\nÀ mon tour de protéger les autres, maintenant !",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "Souffrant encore d'avoir été\r\narrachée à sa mère Rosa,\r\nCereza est devenue l'apprentie\r\nde Morgana, s'entraînant tous\r\nles jours pour devenir elle\r\naussi une puissante sorcière.",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "Représailles",
  "CORE_SNPSS_2020": "Réunis, Cereza et Chouchou\r\ntrouvent le donjon féérique,\r\noù les wisps sont martyrisés.\r\nIls se faufilent à l'intérieur.",
  "CORE_NPC_TXT_11": "Utiliser des ingrédients pour\r\nconcocter des objets.",
  "TEST_WISP_TALK_07": "Sois prudente, il y a un cirque\r\nvraiment terrifiant pas loin !",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "Lueur sinistre (défi)",
  "AC_NARRATION225_0010": "Tous les noyaux élémentaires avaient été\r\ndétruits, et les barrières anéanties.",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "Broyage (défi)",
  "CORE_MISSION_TEXT_0003": "Remporte le combat sans\r\nte faire toucher.",
  "CORE_WISP_TALK_34_H20": "Bouh, j'ai mal partout.\r\nMerci, mademoiselle la sorcière.",
  "CORE_WISP_TALK_54_H40": "Me voilà de retour dans le temps\r\nprésent. Je vais enfin pouvoir vivre\r\nà nouveau ma vie comme je l'entends...",
  "CORE_DIALOG_TXT_090": "Choisis un emplacement pour\r\nsauvegarder ta partie terminée.\r\nContinue avec ce fichier pour découvrir\r\ndes secrets et terminer des zones.",
  "CORE_CSRELEASE_CERESSA_TXT_08": "Déverrouillage : découvre tous\r\nles exploits de Jeanne, et...",
  "CORE_WISP_TALK_14_H16": "Si on abaisse ce levier, tu devrais\r\npouvoir entrer dans la tour !",
  "CORE_BAND_CHESHIRE_TXT_02": "Gros bras",
  "AC_NARRATION260_0020": "Les paisibles habitants de la forêt chanteraient\r\nlongtemps la bravoure de la sorcière au cœur\r\nd'or et de son opiniâtre ami démoniaque.",
  "CORE_COSTUME_CERESSA_TXT_07": "Une sorcière tenace et bienveillante\r\nqui n'abandonne jamais ses amis.\r\nL'avenir lui appartient.",
  "CORE_DIALOG_TXT_031": "Sortir du tír na nÓg ?",
  "TA_COM025_0020_CER": "OK !",
  "CORE_WISP_TALK_14_03_H16": "Il paraît que t'as aidé mes amis !\r\nFaut vite que j'aille le dire aux autres...",
  "CORE_SNPSS_6020": "Púca rameute une armée\r\nde fées pour stopper Cereza.\r\nLa prenant sur son dos,\r\nChouchou file avec elle\r\njusqu'à un pilier de lumière\r\ncréé par Morgana.",
  "AC_NARRATION235_0020": "Cereza se sentit toute petite\r\nface aux rapides rugissants.",
  "CORE_WISP_TALK_49_H35": "Je rêve pas, je suis sauvé ?\r\nJe vais pouvoir rentrer et recommencer\r\nà inventer des trucs.",
  "CORE_SNPSS_4010": "Bouleversée par une illusion\r\nde sa mère créée par les\r\nfées, Cereza se brouille avec\r\nChouchou et l'abandonne,\r\nse rendant alors seule au\r\nfort des fées.",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "Bravoure",
  "TA_COM025_0010_CER": "Pfiou !",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "Plongeon",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "Limitations",
  "CORE_RETRY_TXT_01": "Utiliser les objets requis\r\npour débloquer ce tír na nÓg ?",
  "AC_CEREZA015_0020": "T'inquiète pas, je vais te sauver.",
  "CORE_COSTUME_CERESSA_TXT_03": "Une jeune fille qui écrira un livre\r\nsur ses aventures dans l'étrange\r\nforêt... si elle survit.",
  "CORE_SNPSS_1030": "Cereza, après avoir invoqué\r\nChouchou, part avec lui à la\r\nrecherche du loup blanc.\r\nCelui-ci détiendrait un\r\npouvoir fabuleux qui pourrait\r\nrenvoyer Chouchou en Enfer.",
  "CORE_HTDMMESS_0037_001_H37": "J'aime bien le calme du quotidien ici,\r\nmais j'ai besoin d'un peu de changement.\r\nTu aurais des suggestions ?",
  "CORE_WISP_TALK_39_H25": "F-F-F-Froid ! J'ai cru que je me\r\ntransformais en sorbet ! Merci !",
  "CORE_HTDMQUEST_TXT_0006": "J'ai besoin d'une aiguille de couture.\r\nTu saurais où en trouver une ?",
  "CORE_HTDMQUEST_TXT_0015": "J'aimerais étudier à nouveau\r\nles plantes. Tu crois que tu\r\npourrais m'assister ?",
  "CORE_BAND_CHESHIRE_TXT_01": "Par défaut",
  "CORE_MISSION_TEXT_0008": "Élimine toutes les fées !",
  "CORE_HTDMMESS_0029_002_H29": "Depuis que les fées m'ont capturée...\r\nj'ai plus goût à rien...",
  "CORE_WH_TALK_03_COL": "Ces fées...\r\nPourquoi elles sont aussi cruelles ?",
  "CORE_WH_TALK_19_COL": "Tout le monde tient à vous\r\ndire merci. Hé, venez tous !",
  "CORE_WISP_TALK_63_FAS": "Cereza, si tu te perds en forêt, n'hésite\r\npas à me demander de l'aide.",
  "CORE_NPC_TXT_09": "Retenter un tír na nÓg ou\r\ntenter le défi temporel.",
  "CORE_DIALOG_TXT_121": "Tu as obtenu la tenue\r\n« Observatrice du temps ».",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "Illusion",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "Calamité",
  "CORE_WH_TALK_16_COL": "Cereza, Chouchou, merci pour tout !\r\nJ'aimerais vous prouver ma gratitude.",
  "CORE_COSTUME_CERESSA_TXT_04": "« Renvoie-moi en Enfer, petite\r\ngourde, ou je t'écharpe ! »\r\nConvaincant, non ?",
  "CORE_DIALOG_TXT_021": "Faire une concoction ?",
  "CORE_DIALOG_TXT_032": "Recommencer le tír na nÓg ?\r\n(La progression actuelle sera perdue.)",
  "CORE_SNPSS_6030": "Morgana révèle son intention\r\nde sacrifier Chouchou pour\r\nsauver la vie de son fils.\r\nCereza rassemble son\r\ncourage pour s'opposer à\r\ncelle qui fut sa professeure.",
  "CORE_WISP_TALK_36_H22": "Je... Je peux à nouveau bouger ?\r\nEt c'est grâce à toi... merci !",
  "AC_NARRATION250_0010": "Une crique lumineuse où l'eau clapotait\r\ndoucement, en contraste frappant avec la\r\nsinistre forêt d'Avalon.",
  "TEST_WISP_TALK_12_H00": "Aaarh ! Presque ! Avec un wisp\r\nde plus, on y arriverait !",
  "CORE_HTDMMESS_0004_003_H04": "Merci, t'es la meilleure !\r\nAttends, un refuge ? Où ça ?\r\nJ'y serai bien plus à l'abri qu'ici !",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "Danger",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "Perforation",
  "TA_COM015_0010_CER": "C'est ça !",
  "CORE_RETRY_TXT_02": "Retenter ce tír na nÓg ?",
  "TEST_WISP_TALK_08": "Si le directeur te trouve, ce sera fini\r\npour toi... Sois prudente !",
  "CORE_SNPSS_3010": "Le duo se heurte à une\r\ncréature dont l'armure\r\nrésiste aux griffes de\r\nChouchou. Prise de\r\npanique, Cereza s'enfuit\r\npour se cacher.",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "Compression (défi)",
  "CORE_SNPSS_1020": "S'en remettant aux paroles du\r\ngarçon apparu dans ses rêves,\r\nCereza brave les consignes\r\nde sa professeure et part\r\npour la grande forêt hostile,\r\nfaisant taire ses peurs.",
  "CORE_HTDMMESS_0013_003_H13": "Oh... Génial ! Tu m'as compris !\r\nMerci pour ton aide, sœurette.",
  "CORE_HTDMMESS_0026_001_H26": "Même dans les instants les plus sombres,\r\nil ne faut pas oublier la beauté. Alors\r\ntu pourrais m'apporter une fleur ?",
  "CORE_DIALOG_TXT_170": "Lors de l'histoire de Jeanne, le jeu\r\nest automatiquement sauvegardé\r\nà certains points. Il n'est pas possible\r\nde sauvegarder manuellement.",
  "AC_CEREZA060_0020": "T'es nul. C'est pathétique.",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "Protection (défi)",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "Perforation (défi)",
  "CORE_CSRELEASE_CERESSA_TXT_07": "Déverrouillage : termine\r\nLégende interdite, et...",
  "CORE_HTDMMESS_0021_003_H21": "Waouh, la classe ! C'est pile ce qui\r\nme fallait ! Je suis ravi ! Vite, il faut\r\nque j'aille crâner devant les autres !",
  "CORE_NPC_TXT_05": "Sauvegarder la partie.",
  "CORE_MISSION_TEXT_0004": "Évite les pièges des vaincus\r\net élimine tous les ennemis !",
  "CORE_WH_TALK_20_COL": "Il y a encore des wisps dans la forêt.\r\nS'il vous plaît, allez les chercher !",
  "CORE_COSTUME_CERESSA_TXT_08": "Si je surmonte les épreuves et\r\ntrouve mon vrai moi, je pourrai\r\nretrouver mon prince.",
  "AC_IGNIS015_0010": "Tout se passe bien ? Si tu\r\nveux que je t'emmène sur un\r\nchemin secret, dis-le-moi.",
  "AC_NARRATION215_0020": "Grâce à Cereza et Chouchou,\r\nla joie avait commencé à retentir à nouveau.",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "Broyage",
  "CORE_WH_TALK_10_COL": "Cereza et son ami le chat !\r\nVous allez bien ? Vous me\r\nmanquiez.",
  "CORE_ARCHIVE_TXT_99": "Cette catégorie n'est\r\npas encore débloquée.",
  "CORE_SNPSS_2030": "Cereza et Chouchou libèrent\r\nles amis de Colm. Après de\r\njoyeuses retrouvailles, le\r\nduo suit ses nouveaux\r\ncompagnons.",
  "CORE_WISP_TALK_70_FAS": "Si jamais tu te perds, cherche\r\nles empreintes du loup blanc.\r\nIl connaît la forêt aussi bien que moi.",
  "CORE_WISP_TALK_65_FAS": "Tu as trouvé des empreintes de loup ?\r\nSi tu veux, je sais où il y en a.",
  "AC_CEREZA155_0010": "Arrête... s'il te plaît !",
  "CORE_COSTUME_CHESHIRE_TXT_04": "[FONT:10 ]« Quand je serai grande et forte,\r\nje sauverai ma maman ! »\r\nBien imité, nan ?[FONT:N ]",
  "AC_NARRATION240_0020": "Cereza et Chouchou y burent et se\r\nsentirent instantanément rafraîchis.",
  "TEST_WISP_TALK_04": "J'ai cru que mon cou s'allongeait !\r\nGare aux fées, sœurette !",
  "CORE_CSRELEASE_CERESSA_TXT_03": "Déverrouillage : surpasse-toi\r\ndans les défis temporels et...",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "Plongeon (défi)",
  "CORE_WH_TALK_05_COL": "On a organisé des tours de surveillance.\r\nPas question que ces fées trouvent\r\nnotre refuge !",
  "CORE_WH_TALK_22_COL": "Désolé de toujours solliciter\r\nvotre aide. Mais si vous pouvez,\r\nsauvez nos amis, s'il vous plaît.",
  "CORE_BAND_CHESHIRE_TXT_04": "Ruban d'affection",
  "CORE_WISP_TALK_58_FAS": "Méfie-toi des fées. La pitié ne\r\nfait pas partie de leur vocabulaire.",
  "AC_IGNIS200_0010_0020": "Le chemin secret attend...",
  "TEST_WISP_TALK_09": "Je resterai planqué ici.\r\nNe le dis à personne !",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "Évasion (défi)",
  "AC_CEREZA030_0010": "T'es une trouillarde. Tu rates tout !",
  "CORE_SNPSS_2060": "Après avoir détruit le\r\nsecond noyau, Cereza\r\net Chouchou testent\r\nleur nouveau pouvoir,\r\ntout en continuant à\r\npoursuivre le loup blanc.",
  "CORE_HTDMMESS_0021_001_H21": "J'en ai marre de me cacher... Trouve-moi\r\nquelque chose qui me permette de me\r\nmontrer au grand jour... de briller !",
  "CORE_WISP_TALK_57_FAS": "Prépare de quoi escalader et nager...\r\nIl y a du sport en perspective.",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "Restriction",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "Pugnacité",
  "CORE_HTDMMESS_0013_001_H13": "Hé... sœurette. Aide-moi, tu veux\r\nbien ? C'est une mission de la\r\nplus haute importance, crois-moi.",
  "CORE_HTDMMESS_0026_003_H26": "Oh, tu es merveilleuse !\r\nMerci beaucoup !",
  "CORE_COSTUME_CERESSA_TXT_01": "Une jeune sorcière qui part pour\r\nAvalon dans l'espoir de sauver\r\nsa mère et y rencontre un démon.",
  "CORE_SNPSS_6035": "Cereza assiste à l'agonie\r\nde Morgana et Lukaon, tous\r\ndeux victimes d'un destin\r\ntragique et cruel. Puis elle\r\nse tourne vers Chouchou\r\npour lui dire adieu, et enfin...",
  "CORE_COSTUME_CERESSA_TXT_05": "Des vêtements désormais trop\r\npetits. Ils lui rappellent combien\r\nelle a cherché sa mère.",
  "CORE_DIALOG_TXT_033": "Recommencer le tír na nÓg ?",
  "CORE_WISP_TALK_67_FAS": "On dirait que le loup blanc est un peu loin.\r\nCe n'est pas ce qui arrêtera Ignis !",
  "AC_NARRATION245_0010": "Les ravages du temps n'avaient pas épargné ce lieu,\r\nmais n'avaient pu effacer sa splendeur d'antan.",
  "CORE_WH_TALK_07_COL": "Il y a de l'animation au refuge !\r\nJ'espère qu'il deviendra un lieu où\r\ntous les wisps seront en sécurité.",
  "CORE_DIALOG_TXT_120": "Tu as obtenu la tenue\r\n« L'Œil Droit ».",
  "CORE_HTDMMESS_0023_002_H23": "S'il te plaît... Apporte-moi quelque chose\r\nà manger... pour l'amour de mon estomac...",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "Aliénation",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "Prison de ronces",
  "CORE_HTDMMESS_0039_002_H39": "Pfff... je pensais que les wisps\r\nne dombaient pas balades, boi...",
  "CORE_WISP_TALK_68_FAS": "On se perd facilement dans\r\nla forêt d'Avalon... Je peux\r\nt'accompagner jusqu'au loup blanc ?",
  "CORE_WH_TALK_12_COL": "Je sais pas si ça se voit, mais je\r\nfais de la muscu. La prochaine fois,\r\nje ferai la tête au carré aux fées !",
  "CORE_WISP_TALK_24_H10": "Merci, ma... jolie. Ça te dérange si on\r\nfait un petit bout de chemin ensemble ?",
  "CORE_WH_TALK_08_COL": "On a organisé une patrouille ! Enfin,\r\non a aucune chance contre les fées,\r\nmais question de principe...",
  "CORE_WISP_TALK_33_H19": "Merci, ça t'a pris que...\r\n34 506 250 secondes pour me sauver.",
  "AC_NARRATION210_0010": "Une tour gigantesque bâtie par les fées.\r\nD'étranges dispositifs étaient éparpillés tout autour.",
  "AC_NARRATION255_0020": "Combien de temps a-t-il fallu pour qu'il en pousse autant ?\r\nIls étaient en admiration devant cette prouesse.",
  "TEST_WISP_TALK_05": "Même une toute petite fée\r\nme rosse... je suis un gros nul...",
  "CORE_CSRELEASE_CERESSA_TXT_02": "Déverrouillage : sauve\r\nsuffisamment de wisps et...",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "Grand final (défi)",
  "CORE_HTDMMESS_0006_002_H06": "Hm... Aucune de ces aiguilles ne\r\nconvient. Je fais quoi, moi,\r\nmaintenant ?",
  "CORE_MISSION_TEXT_0001": "Seuls les ennemis piégés par Entrave\r\nroncière peuvent subir des dégâts.",
  "CORE_HTDMMESS_0034_002_H34": "Je suis censée monter la garde, mais...\r\nAvec la gorge dans cet état, je ne\r\npourrai jamais donner l'alerte !",
  "CORE_WH_TALK_14_COL": "Le refuge s'est encore agrandi !\r\nVenez y jouer avec nous, à l'occasion !",
  "CORE_COSTUME_CHESHIRE_TXT_05": "Achetée au Pygmalion, un magasin\r\nde jouets exclusifs. Permet de jouer\r\navec Jeanne/Charles.",
  "CORE_COSTUME_TXT_01": "Sélectionne ta nouvelle tenue.",
  "CORE_SNPSS_1070": "Cereza et Chouchou détruisent\r\nle premier noyau élémentaire\r\net se mettent à la recherche\r\ndes trois autres, s'enfonçant\r\ntoujours plus loin dans la forêt.",
  "TA_COM020_0010_CER": "Aahh...",
  "CORE_WH_TALK_01_COL": "Tiens, Cereza.\r\nTu as trouvé d'autres wisps ?",
  "AC_NARRATION200_0020": "Elle percevait le murmure d'un pouvoir mystérieux,\r\ntransporté du cœur de la forêt par les arbres.",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "Projection obscure",
  "CORE_SNPSS_3040": "Ayant détruit le troisième\r\nnoyau élémentaire, Cereza\r\net Chouchou profitent de\r\nleur nouveau pouvoir en\r\nfaisant route vers l'ultime\r\nnoyau.",
  "CORE_WISP_TALK_61_FAS": "Petit message de la part de Colm :\r\n« Tu me manques ! Viens vite me voir ! »",
  "CORE_EVENT_PAUSE_TXT_01": "Appuie sur [BTN:START ] pour continuer.",
  "CORE_WISP_TALK_16_H02": "Merci. Je vais rentrer au refuge et\r\nsonger à des stratégies de défense...",
  "TA_COM020_0020_CER": "Aahh...",
  "AC_IGNIS200_0000_0010": "Pas le moment de flâner !",
  "CORE_COSTUME_CERESSA_TXT_09": "La tenue officielle des apprenties\r\nsorcières. Permet de jouer avec\r\nJeanne/Charles.",
  "CORE_HTDMMESS_0004_001_H04": "Parfois, j'aimerais me cacher du\r\nmonde. Et si j'utilisais une plante... ?\r\nTu pourrais m'aider ?",
  "CORE_MISSION_TEXT_0005": "Les ennemis utilisent des barrières !\r\nÉlimine-les avec l'élément adéquat !",
  "CORE_COSTUME_CHESHIRE_TXT_01": "Un démon perdu et irascible.\r\nMême sous forme de peluche,\r\nil reste féroce.",
  "TEST_WISP_TALK_55_COL": "D'autres wisps sont enfermés dans\r\nla tour... Tu dois aussi les sauver !",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "Escarmouche (défi)",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "Pugnacité (défi)",
  "TEST_WISP_TALK_01": "Merci, sœurette !",
  "CORE_SNPSS_4050": "Le duo parvient à détruire\r\nl'ultime noyau. Forts de\r\nleur nouveau pouvoir, ils\r\nquittent le sanctuaire.",
  "CORE_MISSION_TEXT_0002": "Bats tous les ennemis avant la fin du temps imparti.\r\nChaque ennemi vaincu octroie un délai supplémentaire !",
  "CORE_WISP_TALK_19_H05": "Oooh, je me sens bien plus léger !\r\nMerci, chaton, et à plus !",
  "AC_NARRATION230_0010": "Un arbre imposant se dressait devant eux.\r\nSes branches d'un blanc pur s'étendaient à l'infini.",
  "CORE_DIALOG_TXT_091": "Bravo ! Nouvelles options :\r\n- Difficulté pour une nouvelle partie\r\n- Partie spéciale avec Jeanne\r\n- Menu des tenues",
  "CORE_HTDMMESS_0028_002_H28": "Attends, qu'une chose soit claire,\r\nj'aime pas avoir mal. Je suis pas maso.",
  "CORE_NPC_TXT_10": "Changer les tenues de\r\nCereza et Chouchou.",
  "TEST_WISP_TALK_06": "On a emmené mes amis...\r\net aucun n'est revenu...",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "Entraves maudites (défi)",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "Percée (défi)",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "Guignol",
  "CORE_SNPSS_3050": "L'ultime noyau élémentaire\r\nse trouve dans la forteresse\r\nde Púca. Pour son propre\r\nsalut, mais aussi celui de\r\nLukaon, Cereza décide de\r\ns'aventurer à l'intérieur.",
  "CORE_SNPSS_1060": "Usant d'une projection\r\nmagique, Morgana ordonne\r\nà Cereza de se cacher\r\njusqu'à être secourue.\r\nMais Cereza repart à la\r\npoursuite du loup blanc.",
  "CORE_WISP_TALK_26_H12": "Je suis... libre ? J'ai peur, mais...\r\nje dois être fort !",
  "CORE_HTDMMESS_0032_002_H32": "J'ai cherché quelque chose pour lui,\r\net je me suis perdu...",
  "TA_COM010_0010_CER": "Hmmmm.",
  "AC_CEREZA045_0010": "Tu fuis, comme d'habitude ?\r\nÇa ne me surprend pas.",
  "CORE_HTDMMESS_0037_003_H37": "Mer... ci... ça... ça sent fort, dis-moi...\r\nJe ferais bien de rentrer avant que\r\nles fées me reniflent.",
  "TA_COM010_0020_CER": "Mmm...",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "Mort imminente (défi)",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "Transport (défi)",
  "CORE_CSRELEASE_CERESSA_TXT_05": "Déverrouillage : collecte assez\r\nde souvenirs et...",
  "TEST_WISP_TALK_02": "Suis-moi ! Je vais ouvrir le portail !",
  "CORE_SNPSS_4040": "Après avoir vaincu le roi\r\ndes fées Púca et l'ange\r\nqu'il a invoqué, Cereza et\r\nChouchou poursuivent leur\r\nquête du dernier noyau.",
  "CORE_MISSION_TEXT_0006": "Le rang baisse avec le temps,\r\ndépêche-toi de terminer !",
  "CORE_COSTUME_CHESHIRE_TXT_02": "Le démon maudit la princesse\r\net sa quête d'amour...\r\nChouchou n'y comprend rien.",
  "CORE_HTDMQUEST_TXT_0008": "Je veux être plus fort. Tu es une\r\nsorcière, tu saurais comment faire ?",
  "CORE_SNPSS_2070": "Le troisième noyau serait\r\nquelque part au fond du\r\nlac Nimueh. Pour drainer\r\nle lac, Cereza doit grimper\r\nau sommet du plus grand\r\narbre de la forêt.",
  "CORE_HTDMMESS_0015_001_H15": "Cette forêt est un écrin à merveilles !\r\nSi tu découvres quelque plante étrange\r\nviens m'en faire part, je t'en prie !",
  "CORE_HTDMQUEST_TXT_0013": "J'aimerais m'élever... au plan\r\nsupérieur de l'existence.\r\nAide-moi, sœurette...",
  "CORE_COSTUME_CERESSA_TXT_02": "Une ballerine qui danse pour\r\nraconter l'histoire d'une\r\nprincesse changée en cygne.",
  "AC_IGNIS020_0010": "La forêt d'Avalon est dangereuse.\r\nHeureusement qu'il y a les\r\nchemins secrets.",
  "CORE_HTDMMESS_0008_003_H08": "C'est censé m'aider, ça ? Berk, mais\r\nça pue ! Je vais retourner au\r\nrefuge et l'essayer... merci !",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "Grand final",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "Rotation",
  "CORE_DIALOG_TXT_130": "La fin de cette histoire\r\napproche. Continuer ?",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "Aiguillage",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "Lueur sinistre",
  "AC_CEREZA135_0010": "Je... Je... !",
  "AC_NARRATION220_0020": "Au-dessus, une faille géante s'ouvrait telle une\r\nbouche béante. Qu'y préparaient donc les fées... ?",
  "CORE_COSTUME_CERESSA_TXT_06": "Après avoir dormi 500 ans, la\r\nprisonnière du destin décide\r\nde forger son avenir.",
  "CORE_DIALOG_TXT_030": "Réinitialiser l'étage en cours ?\r\nTu pourras conserver\r\nles objets obtenus.",
  "CORE_HTDMQUEST_TXT_0004": "Je ne veux plus avoir peur tout le temps.\r\nJ'aimerais trouver une bonne cachette.",
  "CORE_HTDMQUEST_TXT_0017": "À bon poisson, bon hameçon !\r\nTu pourrais m'aider à trouver\r\nun appât appétissant ?",
  "CORE_BAND_CHESHIRE_TXT_03": "Dérapage regrettable",
  "CORE_CSRELEASE_CERESSA_TXT_09": "Déverrouillage : découvre tous\r\nles exploits de Jeanne, et...",
  "CORE_HTDMMESS_0017_002_H17": "Les poissons sont bien dodus, ici, mais ils\r\nont aussi un goût particulier. Si je fais\r\npas attention, c'est moi qu'ils vont boulotter.",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "Véhémence",
  "CORE_DIALOG_TXT_118": "Tu as obtenu la tenue\r\n« Le chapelier fou ».",
  "CORE_SNPSS_1040": "Cereza et Chouchou trouvent\r\nle loup blanc, mais il leur\r\néchappe. Ils se remettent à\r\nsa poursuite, s'enfonçant\r\ntoujours plus dans la forêt.",
  "AC_NARRATION200_0010": "Cereza baignait dans la fraîche\r\nodeur boisée des arbres.",
  "CORE_HTDMMESS_0017_003_H17": "Merci, jeune sorcière. À nous deux, les\r\npoiss... Oh non, j'ai oublié ma canne !",
  "CORE_DIALOG_TXT_156": "Si les combats sont trop retors,\r\ntu peux modifier la force des\r\nennemis ou les dégâts reçus.",
  "AC_NARRATION255_0010": "Cereza et Chouchou arrivèrent à un étang\r\nparsemé à l'infini de nénuphars.",
  "CORE_ARCHIVE_TXT_01": "Protagonistes de l'histoire",
  "CORE_DIALOG_TXT_152": "Règle le combo d'entrave et Miam ! Contrôle leur\r\nutilisation avec « Maintenir » pour maintenir puis\r\nrelâcher, ou laisse Chouchou les utiliser en\r\nappuyant une fois sur le bouton d'attaque.",
  "LV_009911_0010_NAR": "Chouchou ne semble pas avoir l'intention\r\nd'agir. Il semble dire « Débrouille-toi seule. »",
  "CORE_ARCHIVE_TXT_05": "Wisps sauvés en Avalon",
  "CORE_SNPSS_4060": "Cereza et Chouchou ont\r\nréussi à détruire les quatre\r\nnoyaux élémentaires.\r\nGuidés par le loup blanc,\r\nils se dirigent vers le\r\nlieu où se trouve Lukaon.",
  "CORE_HTDMQUEST_TXT_0028": "J'ai besoin d'avoir mal !\r\nToi, là ! Fais-moi souffrir !\r\nJ'en ai besoin !",
  "CORE_WISP_TALK_38_H24": "(Ce wisp semble vouloir dire quelque\r\nchose, mais ça n'a ni queue ni tête...)",
  "CORE_HTDMMESS_0008_002_H08": "Je suis un chasseur. Alors les flèches,\r\nje préfère les décocher que de me les\r\nprendre !",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "Déverrouillage : trouve\r\nassez de journaux, et...",
  "CORE_DIALOG_TXT_114": "Tu as obtenu la tenue\r\n« Jeunesse ».",
  "CORE_WISP_TALK_45_H31": "Merci de m'avoir aidé. Est-ce que tu\r\nsais si... mes plantes vont bien ?",
  "CORE_HTDMMESS_0037_002_H37": "Je suis un bourreau de travail, et Avalon\r\nest une forêt effrayante... alors parfois, il\r\nfaut pouvoir se changer les idées.",
  "CORE_HAIR_CERESSA_TXT_01": "Par défaut",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "Compression",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "Lueur imposante",
  "CORE_WISP_TALK_52_H38": "Enfin, des secours... Heureusement que\r\nj'ai tenu bon. Je vais pouvoir reprendre\r\nle train-train quotidien...",
  "CORE_SNPSS_2050": "Après avoir uni leurs forces\r\npour vaincre le directeur du\r\ncirque Amadán Dubh,\r\nCereza et Chouchou cherchent\r\nle noyau élémentaire dans le\r\nchapiteau.",
  "TA_COM035_0020_CER": "Hein ?!!",
  "AC_IGNIS010_0010": "Tu tombes bien, j'allais\r\npartir en balade sur\r\nles chemins secrets !",
  "CORE_POSEMENU_TXT_00": "Déplacer le curseur et sélectionner.",
  "CORE_HTDMQUEST_TXT_0037": "J'ai besoin de changement.\r\nUne nouvelle senteur, peut-être...",
  "CORE_POSEMENU_TXT_04": "Charger une sauvegarde.",
  "AC_NARRATION210_0020": "Sa construction rocambolesque était à l'image\r\ndu chaos régnant dans le cœur des fées.",
  "TEST_GIMMICK_TALK_01": "Cette balançoire à bascule semble\r\nêtre faite pour un wisp.",
  "CORE_WISP_TALK_41_H27": "J'ai eu une vision... où tu me sauvais.\r\nNotre rencontre est-elle... le fruit du destin ?",
  "TA_9012_0010_COL": "Évite les embrouilles !",
  "CORE_HTDMMESS_0028_003_H28": "Exactement ce qu'il me fallait !\r\nElles ne pourront plus me faire de mal !\r\nOn se retrouve au refuge !",
  "TA_COM035_0010_CER": "Hein ?",
  "AC_CEREZA150_0010": "N'importe quoi ! Tais-toi !",
  "AC_CEREZA060_0040": "T'es vraiment lent !",
  "AC_NARRATION245_0020": "Cereza se rappela avoir entendu qu'une reine\r\ndes fées résidait jadis dans un tel lieu.",
  "CORE_DIALOG_TXT_103": "Changer la tenue de Chouchou ?",
  "CORE_HTDMMESS_0032_003_H32": "Merci, Colm va adorer !\r\nAllez, je file au refuge !",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "Accélération",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "Escarmouche",
  "CORE_DIALOG_TXT_010": "Tu ne peux pas sélectionner\r\nton emplacement actuel.",
  "CORE_DIALOG_TXT_117": "Tu as obtenu la tenue\r\n« Excommunieur de l'amour ».",
  "CORE_DIALOG_TXT_104": "Ouvrir le menu des tenues ?",
  "CORE_HAIR_CERESSA_TXT_02": "Nattes d'écolière",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "Origine",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "Délivrance",
  "CORE_HTDMQUEST_TXT_0023": "J'ai faim... si faim...\r\nDonne-moi quelque chose\r\nde bon à manger... par pitié.",
  "AC_CEREZA055_0010": "T'es rien qu'une pleurnicharde !\r\nT'es bonne qu'à chialer dans ton coin !",
  "CORE_POSEMENU_TXT_03": "Retourner à l'écran titre.",
  "TEST_WISP_TALK_11_H00": "Désolé, mais pour ouvrir cette porte,\r\nil me faudra deux autres amis.",
  "CORE_SNPSS_2040": "Les wisps mènent Cereza\r\net Chouchou dans leur\r\nrefuge. Après avoir repris\r\ndes forces, le duo repart\r\nà la recherche des noyaux\r\nélémentaires restants.",
  "CORE_SVSLT_TXT_03": "Sélectionne le fichier à effacer.",
  "CORE_HTDMMESS_0006_003_H06": "Youpi ! C'est pointu, c'est piquant,\r\nc'est parfait ! Je vais pouvoir faire\r\nune super aiguille avec ça !",
  "TA_COM005_0010_CER": "Hé, Chouchou.",
  "CORE_WH_TALK_15_COL": "Merci d'avoir secouru nos amis !\r\nTenez, en guise de remerciement\r\nde la part de tout le monde !",
  "CORE_HTDMMESS_0034_003_H34": "Merci, je vais aller au refuge.\r\nQuand j'irai mieux, je chanterai\r\nquelque chose pour toi.",
  "CORE_WISP_TALK_50_H36": "Ces fées sont vraiment méchantes !\r\nElles ont failli me couper la tête, j'en ai\r\nbesoin, moi !",
  "CORE_HTDMQUEST_TXT_0034": "Rrrrg... j'ai trop mal à la gorge...\r\nTu n'aurais pas un médicament\r\npour moi, dis ?",
  "CORE_POSEMENU_TXT_07": "Sélectionner une sauvegarde.",
  "AC_NARRATION220_0010": "La forteresse des fées, écrasante dans la forêt sombre.",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "Déverrouillage : découvre tous\r\nles exploits de Jeanne, et...",
  "CORE_WISP_TALK_60_FAS": "Tu devrais nous rendre visite au refuge,\r\nun de ces quatre. Les wisps seront\r\nravis de te voir.",
  "CORE_HTDMMESS_0029_001_H29": "Chuis complètement à plat...\r\nPeux à peine bouger... Un remède ?\r\nTant que ça agit vite...",
  "AC_CEREZA060_0050": "Même pas capable de contrôler\r\nles éléments... Ridicule.",
  "CORE_DIALOG_TXT_113": "Tu as obtenu la tenue\r\n« Fichu démon ».",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "Évasion",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "Protection",
  "CORE_HTDMMESS_0023_003_H23": "Waouh, de la vraie nourriture !\r\nJ'avais tellement faim que\r\nj'allais te manger toute crue.",
  "CORE_SNPSS_1050": "Le garçon apparu dans ses\r\nrêves demande à Cereza\r\nde détruire quatre noyaux\r\nélémentaires. Chouchou et\r\nelle doivent donc retrouver\r\nle loup blanc.",
  "CORE_WH_TALK_06_COL": "Tous les autres wisps se rendent\r\ntellement utiles... je devrais prendre\r\nexemple sur eux.",
  "CORE_DIALOG_TXT_008": "Les données de ce fichier vont\r\nêtre chargées et toute progression\r\nactuelle non sauvegardée sera\r\neffacée. Continuer ?",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "Rotation (défi)",
  "CORE_WISP_TALK_66_FAS": "Ta prochaine destination se situe dans\r\nun lieu retiré. Je vais te montrer.",
  "CORE_WH_TALK_09_COL": "Règle numéro un du refuge :\r\nOn ne mélange pas travail et\r\nloisirs. C'est la seule règle.",
  "CORE_DIALOG_TXT_155": "Si tu changes d'avis, ces paramètres\r\npeuvent être modifiés à tout moment\r\ndepuis le menu Options.",
  "CORE_ARCHIVE_TXT_02": "Ennemis de Cereza",
  "CORE_HTDMMESS_0039_003_H39": "Merci, mademoiselle la sorcière. J'ai\r\naussi trouvé de quoi grignoter, alors\r\nje vais pouvoir rentrer au refuge.",
  "AC_NARRATION230_0020": "Il était le symbole des rois des fées\r\nd'Avalon depuis des générations.",
  "CORE_WISP_TALK_69_FAS": "Le loup blanc ne doit plus être loin.\r\nVois-tu des empreintes qu'il aurait\r\npu laisser ?",
  "CORE_WH_TALK_13_COL": "On a amélioré le refuge, vous\r\navez remarqué ? Maintenant, on\r\na encore plus d'aires de jeu !",
  "CORE_SNPSS_6040": "Cereza sort grandie de\r\nses épreuves dans la\r\nforêt. Avec les souvenirs\r\nde ses amis dans son\r\ncœur, elle repart pour\r\nde nouvelles aventures.",
  "CORE_DIALOG_TXT_151": "Les attaques spéciales de Chouchou\r\nutilisent normalement de la magie,\r\nmais si tu choisis « Toujours pleine »,\r\nla jauge de magie restera au maximum.",
  "CORE_WH_TALK_23_COL": "Vous êtes nos héros ! Vous serez\r\ntoujours les bienvenus ici.\r\nNous vous attendrons !",
  "CORE_WISP_TALK_59_FAS": "Il paraît que Colm veut te voir.\r\nIl a quelque chose à te dire, apparemment.",
  "CORE_WISP_TALK_47_H33": "Enfin libéré. Je devrais sûrement être\r\nreconnaissant. Mais ce que j'apprécierais\r\nc'est que ces fées se calment un peu.",
  "CORE_WISP_TALK_56_FAS": "Le troisième noyau élémentaire est au\r\nfond du lac, et tu dois grimper au sommet\r\nd'un grand arbre pour l'atteindre.",
  "CORE_HTDMMESS_0026_002_H26": "Ça me désole que les fées soient aussi\r\ncruelles. Si seulement on pouvait vivre\r\nen paix avec elles..."
}
