{
  "SM_004080_0040_NAR": "[FONT:9 ]Meglio così che quando piagnucoli.\r\nUna lezione, eh? Con piacere![FONT:N ]\r\n\r\nCereza e Cheshire erano pronti.",
  "BK_4000_0040_NAR": "Come poteva essere?\r\nDi fronte a Cereza c'era sua madre.",
  "SM_004060_0010_NAR": "Ma il lupo bianco continuò\r\na fissarla, senza muoversi.\r\n\r\n\"Andiamo assieme!\"\r\npareva dirle lo sguardo\r\ndeterminato del lupo.",
  "BK_4060_0040_POO": "\"Lunga vita al regno delle fate!\"\r\n",
  "IN_40000_0020_NAR": "Tentando disperatamente\r\ndi raggiungere la madre,\r\navanzò sempre più veloce.",
  "LV_004020_0000_NAR": "Appena visibile nella foschia del\r\ncrepuscolo, una grande struttura\r\nsi innalzava in cielo come la guglia\r\ndi un castello.",
  "CE_004800_0000_CER": "Questo tizio è pieno di risorse.\r\n... Mmmh, meglio scappare!",
  "SM_004030_0050_CER": "\"Umpf, non mi interessa!\"",
  "IN_40000_0010_NAR": "Cereza venne attirata in avanti,\r\nverso l'apparizione.",
  "LV_004085_0015_NAR": "Disse Cheshire, con voce un po' imbarazzata.",
  "CE_004000_0000_CER": "Mamma? Non può essere...",
  "SM_004050_0060_NAR": "Sprezzante del pericolo, Cereza\r\nsi affrettò a seguire le fate\r\ndentro il loro maniero.",
  "BK_4080_0180_CER": "\"E poi, se non fosse stato per me,\r\nnon saresti finito in questo\r\npasticcio.\"",
  "BK_4080_0090_NAR": "Riuscì a pensare a un\r\nsolo modo per farlo.",
  "BK_4080_0010_CER": "\"Cheshire!\"",
  "SM_004020_0070_CER": "\"B-bel tentativo, Avalon, ma\r\nci vuole altro per spaventarmi.\"",
  "LV_004025_0000_CER": "Ci potrebbero essere fate ovunque.\r\nMeglio se faccio silenzio.",
  "SM_004010_0110_NAR": "[FONT:9 ]È così che mi ringrazi di averti salvata?\r\nSe tu non fossi così incapace, forse\r\nnon dovrei combattere io le tue battaglie![FONT:N ]\r\n\r\nCheshire non voleva cedere.",
  "LV_004080_0000_CER": "Magia riparatrice...\r\nNon ero mai riuscita a farla funzionare.",
  "SM_004070_0030_NAR": "[FONT:9 ]È semplice:\r\nci serve quella ragazza...[FONT:N ]",
  "BK_4020_0090_POO": "\"Anche gli alberi di Avalon si chinano\r\ndi fronte a noi in segno di obbedienza.\"",
  "BK_4020_0020_NAR": "A parlare era la fata dall'aria nobile di prima.",
  "CE_004010_0010_CER": "Se è rotto, si aggiusta!",
  "BK_4020_0100_POO": "\"Noi siamo Púca il saggio.\r\nPúca il magnanimo.\"",
  "SM_004070_0120_CER": "\"Cheshire!\"",
  "LV_004015_0000_CER": "Posso attraversare questa\r\nforesta benissimo da sola.\r\nNon ho p-paura!",
  "SM_004040_0000_NAR": "Cereza vide di nuovo Cheshire.\r\n\r\nNon poteva muoversi a causa delle\r\nferite, ed era circondato dalle fate.",
  "SM_004140_0040_NAR": "Capendo quel che era successo,\r\nCereza si affrettò a ripulirsi il viso.\r\n\r\nLo spettacolo era troppo per Cheshire,\r\nche si rotolò tra le risate.",
  "BK_4020_0050_NAR": "La fata dall'aria nobile\r\ncontinuò il suo altero monologo.\r\nA causa del forte accento,\r\nperò, era quasi incomprensibile.",
  "BK_4020_0170_POO": "\"Siamo costretti a evocare\r\nuna punizione celeste per\r\nfarli pentire della loro insolenza!\"",
  "SM_004070_0040_NAR": "[FONT:9 ]Tu non intrometterti e noi\r\nti faremo tornare nel regno dei demoni![FONT:N ]",
  "BK_4020_0140_CER": "\"Ma... OK... allora sei stato tu\r\na maltrattare Cheshire!\r\nQui c'è un re che ha bisogno\r\ndi una bella sculacciata!\"",
  "SM_004035_0020_NAR": "Cheshire... Cereza non riusciva\r\na non pensare a lui.",
  "SM_004070_0160_CER": "\"Grazie!\"",
  "BK_4070_0010_CER": "\"Vorrei non averti mai evocato!\"",
  "LV_004060_0010_CER": "Non capisco cosa dicono.\r\nMa se le conosco, sarà di sicuro\r\nqualcosa di assolutamente malvagio.",
  "LV_004925_0000_CER": "\"Sono bagnata fradicia.\r\nTi avevo detto di andare piano!\"",
  "SM_004020_0000_CER": "\"Non ho mica bisogno di lui.\r\nPosso badare a me stessa!\"",
  "SM_004035_0010_NAR": "L'ottimismo giunto dopo essersi separata\r\nda Cheshire era svanito da tempo.",
  "SM_004070_0070_NAR": "[FONT:9 ]Allora, cos'hai deciso?\r\nÈ la tua ultima possibilità, demone![FONT:N ]",
  "SM_004110_0110_NAR": "Cereza e Cheshire si guardarono.\r\nOttenere il potere da Lukaon avrebbe\r\nsignificato la fine della loro avventura\r\ne dirsi addio.",
  "SM_004010_0150_NAR": "Poi arrivò la goccia che\r\nfece traboccare il demone.",
  "BK_4060_0000_POO": "\"Oh che dolore!\r\nI nostri celesti lacchè sconfitti...\r\nLe fiamme della sconfitta si avvicinano.\"",
  "LV_004005_0010_CER": "Mi sembra di aver sentito qualcosa...",
  "BK_4080_0060_CER": "\"Stai fermo. Se continui a muoverti\r\ncosì peggiorerai le cose.\"",
  "BK_4000_0000_NAR": "Cereza e Cheshire non erano soli.\r\nNell'ombra, occhi luminosi li osservavano.",
  "BK_4080_0100_MOR": "\"Ricorda, Cereza...\"",
  "SM_004100_0020_CER": "\"Ci stai portando da Lukaon?\r\nDovremmo essere vicini...\r\nForza, Cheshire, sbrigati!\"",
  "SM_004050_0090_CER": "\"Tu!\"",
  "SM_004090_0030_LUC": "\"Presto ci incontreremo.\r\nCereza, manca poco ormai...\"",
  "SM_004050_0010_NAR": "Le fate avevano catturato Cheshire.\r\nTra di loro, ce n'era una che si\r\ndistingueva dalle altre per\r\nla sua aria nobile.",
  "CE_004030_0000_CER": "Adesso torniamo in Paradiso.",
  "SM_004050_0130_CER": "\"Attenzione!\"",
  "SM_004090_0000_LUC": "\"Cereza, tu mi sorprendi.\r\nNon c'è ostacolo che tu\r\nnon riesca a superare.\"",
  "SM_004050_0020_NAR": "Sembrava stesse parlando\r\na Cheshire, ma Cereza non\r\npoteva sentire quel che si\r\ndicevano.",
  "BK_4080_0140_NAR": "Erano le preziose ciocche che Cereza\r\nsi lasciava crescere per assomigliare\r\na sua madre.",
  "SM_004080_0025_NAR": "Fu un ammirevole lavoro\r\ndi squadra.",
  "LV_004070_0000_CER": "Questo mi ricorda quando sono salita\r\nsulla torre dell'orologio con Jeanne...",
  "SM_004050_0125_CER": "\"Da qui potrò entrare senza che\r\nquelle malefiche fate mi vedano.\r\nGrazie!\"",
  "LV_004055_0000_CER": "Questa torre non finisce mai...\r\nCheshire... dove ti stanno portando?",
  "LV_004040_0010_NAR": "Lungo le sue mura,\r\nnel metallo, si apriva una crepa,\r\ncome un'orrenda fauce.",
  "LV_004090_0000_NAR": "La sfera ardeva brillando di luce rossa.\r\nI due erano giunti all'ultimo nucleo elementale.",
  "SM_004060_0025_CER": "\"... Non dirlo a Cheshire, però.\"",
  "SM_004050_0070_CER": "\"Niente...\r\nCi dev'essere un'altra entrata.\"",
  "SM_004030_0040_NAR": "Cereza udì una voce familiare.\r\nEra Cheshire.\r\n\r\nFerito, stava fuggendo\r\nda un gruppo di fate.",
  "LV_004020_0010_CER": "Cereza, ce la puoi fare\r\nda sola... Non ti serve\r\nl'aiuto di nessuno...",
  "CE_004815_0000_CER": "Ora!",
  "SM_004060_0000_CER": "\"Ascoltami: questa fortezza\r\nbrulica di fate. È meglio se te\r\nne stai fuori.\"",
  "LV_004085_0020_CER": "Sì, penso ti calzi a pennello.",
  "BK_4000_0050_CER": "\"Mamma? Sei davvero tu?\"",
  "BK_4080_0030_NAR": "Le fate non erano state gentili\r\ncon il loro ostaggio. Cheshire non\r\npoteva più contenere il dolore.",
  "BK_4070_0040_NAR": "Le parole di Cereza riecheggiarono tra\r\ngli alberi. Poi cadde il silenzio.",
  "Pooka_vo_disappear_01": "Non è stata altro che fortuna!\r\nFortuna, hai capito?! Ascolta!",
  "SM_004070_0130_NAR": "Cereza era saltata fuori senza\r\nsapere veramente che fare.",
  "BK_4020_0030_CER": "\"Ehi,\r\nquella fata parla la nostra lingua!\r\n... Credo.\"",
  "LV_004900_0000_CER": "Non c'è da preoccuparsi...\r\nUna foglia del genere non ci\r\ncreerà problemi... giusto?",
  "SM_004140_0020_CER": "\"... Mmh?\r\nMa che fai?\"",
  "BK_4000_0020_ROS": "\"Cer... Cereza...\"",
  "SM_004010_0130_CER": "\"E tanto per essere chiari:\r\ndici che sono debole, ma non puoi\r\nsopravvivere senza di me, ricordi!?\"",
  "BK_4080_0240_NAR": "Cereza strinse forte a sé Cheshire.\r\n\r\nIn qualche modo, sentì che anche\r\nCheshire stava facendo lo stesso.",
  "SM_004110_0010_MOR": "\"Cereza, cos'hai fatto\r\nai capelli?!\"",
  "SM_004140_0010_CER": "\"Ouh...\r\nPerò, che tipo quello...\"",
  "SM_004010_0020_NAR": "L'attacco di Cheshire\r\naveva spezzato l'illusione,\r\nma aveva anche causato\r\nun vero shock a Cereza.",
  "SM_004070_0100_NAR": "[FONT:9 ]Come se mi fidassi di una fata!\r\nVi divorerò tutte, una per una![FONT:N ]",
  "BK_8120_0000_CER": "\"Quello era il nucleo numero quattro.\r\nAbbiamo distrutto tutti i nuclei elementali!\"",
  "SM_004070_0090_NAR": "Poi udì il familiare,\r\nprofondo ruggito...",
  "SM_004020_0060_NAR": "... Un piccolo coniglio\r\napparve tra i cespugli.\r\nCereza sospirò di sollievo.",
  "SM_004110_0100_CER": "\"Oh, le sconfiggerò eccome.\r\nE poi incontrerò Lukaon,\r\notterrò quel potere e ti\r\nfarò tornare a casa...\"",
  "LV_004010_0003_CER": "Mamma!",
  "BK_4020_0040_POO": "\"Vergogna! La sua insolenza non ha limite!\r\nPentiti, ché l'ira di un sovrano, una\r\nvolta attizzata, non è facile da spegnere.\"",
  "LV_004930_0000_CER": "Ah!\r\nSe non sto attenta finisco arrosto!",
  "BK_4020_0070_CER": "\"È inutile, dev'essere qualche\r\nstrano dialetto delle fate.\r\nInsomma, che vuoi dirci?\r\nChe sei il re delle fate?\"",
  "LV_004060_0000_NAR": "All'interno, le fate stavano discutendo animatamente.",
  "BK_4070_0000_NAR": "Cheshire ruppe il silenzio con un minaccioso ruggito.",
  "BK_4020_0150_NAR": "Cheshire sembrava felicissimo\r\ndi eseguire.",
  "SM_004010_0060_NAR": "... Ma le lacrime non si fermavano.",
  "SM_004140_0050_CER": "\"Ora è una faccenda personale.\r\nQuella brutta fata deve sperare\r\ndi non incontrarmi più.\r\n\r\nE tu, micione, basta ridere sotto i baffi.\r\n\r\nForza, diamoci una mossa!\"",
  "SM_004040_0010_CER": "\"In che guaio si è andato a cacciare...\r\n... No, non andrò a soccorrerlo!\"",
  "SM_004110_0050_MOR": "\"Normalmente, adesso ti\r\nspetterebbe una bella ramanzina.\r\nMa ciò dovrà aspettare fino\r\nal tuo ritorno a casa.\"",
  "LV_004935_0000_NAR": "Cereza stavolta era da sola.\r\nCome avrebbe fatto a cavarsela?",
  "LV_004065_0000_CER": "Guarda tutte quelle fate!\r\nCome farò a uscire da qui?",
  "SM_004050_0030_CER": "\"Che vuole quella fata da Cheshire?\"",
  "SM_004050_0120_NAR": "Era sufficientemente grande\r\nper essere attraversata da\r\nun'apprendista strega.",
  "SM_004050_0000_CER": "\"Con chi sta parlando...?\"",
  "LV_004010_0010_CER": "Mamma, aspetta! Mamma! Ti prego!",
  "SM_004050_0110_NAR": "Prima di correre via,\r\nattirò la sua attenzione.",
  "SM_004110_0090_MOR": "\"Le fate sono delle temibili avversarie,\r\nma sfrutta tutti i miei insegnamenti\r\ne potrai sconfiggerle.\r\n\r\nPossa la luna illuminare il tuo\r\ncammino... Abbi cura di te, Cereza.\"",
  "SM_004020_0075_CER": "\"Bene. Dove si è cacciato quel lupo?\"",
  "Pooka_vo_disappear_07": "Sei solo una streghetta mocciosa.\r\nCome osi far soffrire così Púca?!",
  "LV_004030_0000_NAR": "Cereza si trovava da sola contro le fate.\r\nCome pensava di poterle sconfiggere?",
  "BK_4020_0120_POO": "\"Púca,\r\nl'unico vero re della Foresta di Avalon!\"",
  "CE_004810_0000_CER": "Non finiscono più!\r\nDobbiamo far fuori quella fata!",
  "LV_004025_0010_CER": "Se quelle fate mi vedono, saranno guai.\r\nMeglio muoversi piano.",
  "BK_4020_0000_NAR": "Qualcosa li fermò.\r\nUna strana presenza...\r\nNon erano soli.",
  "SM_004070_0010_NAR": "Avevano finalmente trovato Cheshire.\r\nEra coperto di ferite\r\nda capo a piedi.",
  "CE_004010_0000_CER": "Quello strumento di tortura...\r\nMa se lo aggiusto con la magia...",
  "BK_4020_0110_POO": "\"... Pausa drammatica...\"",
  "SM_004070_0020_NAR": "Nascosta nell'ombra, Cereza con\r\nsorpresa si rese conto di poter\r\ncapire ciò che dicevano le fate.",
  "BK_4020_0080_POO": "\"Quale insolenza!\r\nDinanzi a noi tutti si inginocchiano.\r\nE chi ha quattro zampe, ne piega due.\"",
  "BK_4090_0010_CER": "\"Arrivo, mamma!\r\nNon lasciarmi di nuovo sola!\"",
  "LV_004050_0000_CER": "Oh, Cheshire, in che guaio ti sei\r\ncacciato stavolta...",
  "SM_004010_0100_NAR": "Incapace di accettare i soprusi\r\ndi Cheshire, Cereza balzò in piedi.\r\n\r\nDietro alle lacrime, i suoi\r\nocchi ardevano d'ira.",
  "LV_004080_0010_CER": "Chissà se ha effetto su\r\nqualcos'altro...?",
  "SM_004010_0010_CER": "\"Mamma!\"",
  "LV_004035_0000_CER": "Ci sono quasi...\r\nNon posso mollare!",
  "BK_4060_0045_POO": "\"... Lunga vita a Púca.\"",
  "LV_004040_0020_CER": "Cos'è... questo?\r\nC'erano un sacco di crepe nella\r\nforesta, ma questa è diversa.",
  "SM_004050_0040_NAR": "Le fate lo condussero in\r\nuna specie di fortezza.",
  "BK_4080_0080_NAR": "Cereza doveva suturare la ferita\r\nil prima possibile.",
  "LV_004085_0010_NAR": "[FONT:10 ]Questo taglio non è niente.\r\nMa... questo nastro non è male.[FONT:N ]",
  "LV_004905_0000_CER": "Cheshire, tu sai nuotare?!\r\nI-io mi rifiuto. Non voglio bagnarmi i capelli.",
  "BK_4080_0190_CER": "\"Ho promesso di farti tornare\r\na casa. Parola di strega di Umbra.\"",
  "SM_004060_0030_NAR": "E così,\r\nCereza e il lupo bianco penetrarono\r\nnella roccaforte nemica.",
  "BK_4080_0160_NAR": "[FONT:9 ]Non dare la colpa a me se\r\npoi la tua maestra si arrabbia.[FONT:N ]\r\ndisse piano Cheshire.",
  "SM_004080_0010_NAR": "L'improvvisa comparsa dei due intrusi\r\naveva seminato il panico nella fortezza.",
  "SM_004090_0020_LUC": "\"Già, il controllo che hai su quel\r\ndemone è prova delle tue abilità.\"",
  "LV_004005_0000_CER": "Mh? Cheshire, hai detto qualcosa?",
  "BK_4080_0110_MOR": "\"Come il sangue scorre nelle vene,\r\ncosì la magia fluisce dai capelli\r\ndi una strega.\"",
  "CE_004030_0020_CER": "Addio.",
  "BK_4000_0010_NAR": "Sussurrando un incantesimo,\r\nle fate fecero la loro mossa.",
  "SM_004030_0030_CER": "\"No, meglio senza quel gattaccio!\r\nPosso trovare Lukaon da sola!\"",
  "BK_4060_0010_POO": "\"Pur se noi stessi saremo consumati dal fuoco,\r\nquesti intrusi non passeranno oltre!\"",
  "BK_4060_0020_CER": "\"Cosa sta dicendo...?\r\nHo un brutto presentimento.\"",
  "LV_004070_0010_CER": "Faceva la dura...\r\nma io lo sapevo che aveva paura.",
  "SM_004080_0020_NAR": "Cereza ne approfittò per liberare\r\nCheshire dalle catene.",
  "BK_4080_0150_NAR": "Come previsto, la loro magia funzionò\r\ne la ferita di Cheshire si richiuse\r\nin un istante.",
  "SM_004100_0000_CER": "\"Quell'ululato...\r\nSei riuscito a uscire dalla fortezza!\"",
  "BK_4080_0120_MOR": "\"Prenditi cura del tuo strumento\r\npiù prezioso e difendilo\r\na costo della vita.\"",
  "BK_4080_0040_CER": "\"Che brutto taglio!\"",
  "CE_004030_0010_CER": "Di' le tue preghiere!",
  "SM_004070_0050_NAR": "Parlavano in enochiano, la lingua\r\ndegli angeli e dei demoni. La fata\r\ndall'aria nobile stava cercando di\r\nstringere un accordo con Cheshire.",
  "SM_004020_0020_CER": "\"Cheshire?\"",
  "SM_004070_0140_CER": "\"Fuori dai piedi!\"",
  "BK_4070_0030_CER": "\"Bene! Come vuoi, abbiamo chiuso!\"",
  "BK_4020_0160_POO": "\"L'umana e il demone osano\r\nminacciare Púca, il cui nome\r\nincute timore in tutti e tre i regni?\"",
  "SM_004110_0020_CER": "\"S-scusa... Io, ecco...\r\nMi servivano per una cosa.\"",
  "SM_004010_0170_NAR": "Cheshire strinse gli occhi.\r\nPer un istante, rimase in silenzio.",
  "BK_4080_0200_CER": "\"Q-quel che intendo è che...\"",
  "LV_004015_0010_CER": "Dov'è andato quel lupo...\r\nDev'essere di qua.",
  "LV_004950_0000_CER": "Mamma... Non andartene!",
  "SM_004040_0020_NAR": "Ma senza nemmeno rendersene conto,\r\nCereza stava già andando verso Cheshire.",
  "SM_004140_0060_NAR": "Cereza partì tutta seria.\r\n\r\nCheshire, trattenendo a malapena\r\nle risate, la seguì.\r\n\r\nQuando Cereza si voltava, però,\r\nle risate tornavano a squassarlo.\r\n",
  "SM_004010_0140_NAR": "[FONT:9 ]Ma sentila! Non dureresti cinque\r\nminuti in questa foresta senza di me![FONT:N ]\r\n\r\nIl loro litigio stava per arrivare al culmine.",
  "CE_004020_0000_CER": "Ora, Cheshire!",
  "BK_4080_0230_CER": "\"Certo, vostra maestà.\"",
  "SM_004035_0000_NAR": "In qualche modo Cereza riuscì a passare.\r\nAvventurarsi da sola si stava rivelando\r\nben più difficile di quanto avesse previsto.",
  "SM_004020_0010_CER": "\"Non venire a frignare da me\r\nquando la tua magia sarà esaurita!\"",
  "SM_004070_0060_NAR": "Cereza sentì il cuore\r\nbatterle nel petto.",
  "SM_004140_0030_CER": "\"Ma che...?!\r\nOh, lasciami stare!\"",
  "SM_004010_0080_CER": "\"Cheshire, come hai potuto?\r\nCome hai potuto farle questo!\"",
  "LV_004045_0000_CER": "Dove vai? Conosci\r\nun'altra entrata?",
  "LV_004915_0000_NAR": "Cheshire si divertiva un mondo\r\na guidare la foglia di ninfea di qua e di là.",
  "SM_004020_0040_NAR": "Cereza ebbe un brivido.\r\nLa tensione salì, finché...",
  "BK_4020_0010_POO": "\"Fermi! Ogni vostro sconsiderato passo\r\nsemina la rovina nel nostro regno.\r\nNon permetteremo di risvegliare\r\nil bambino maledetto dal suo sonno.\"",
  "BK_8120_0010_CER": "\"Sai bene cosa vuol dire:\r\nquesto è l'ultimo potere elementale.\r\nProviamolo!\"",
  "SM_004070_0000_CER": "\"Cheshire!\"",
  "SM_004070_0080_NAR": "Cereza attese la risposta\r\ntrattenendo il fiato.",
  "LV_004030_0010_CER": "Ci dev'essere qualcosa qui\r\nattorno che posso usare...",
  "SM_004070_0110_NAR": "Nonostante il corpo martoriato,\r\ngli occhi di Cheshire\r\nardevano temerari.",
  "CE_004805_0000_CER": "Ce l'abbiamo fatta...\r\nOK, diamoci da fare.",
  "SM_004010_0030_NAR": "Lei cadde in ginocchio.\r\nL'ultimo urlo di sua madre le\r\nrisuonava ancora nelle orecchie.",
  "SM_004010_0120_CER": "\"Non sono affatto stupita...\r\nNon mi aspetto che un demone\r\ncome te sia in grado di capire!\"",
  "SM_004060_0020_CER": "\"Grazie...\r\nSai, a dire il vero, avevo un po'\r\npaura ad andare da sola.\"",
  "LV_004040_0000_NAR": "Una gigantesca struttura di metallo si stagliava\r\ndavanti a lei. Era un forte eretto dalle fate.",
  "LV_004055_0010_CER": "Questo è più duro persino\r\ndel mio addestramento da strega.",
  "LV_004910_0000_CER": "C-Cheshire! Vai più piano!",
  "LV_004085_0000_CER": "Che te ne pare?\r\nNon sono poi così scarsa, eh?",
  "BK_4080_0130_CER": "\"Scusa, Morgana, ma c'è\r\nqualcosa di più importante.\"",
  "SM_004050_0050_CER": "\"Cheshire...\"",
  "BK_4080_0020_NAR": "La zampa di Cheshire era ferita.\r\nDal taglio perdeva cotone\r\ned energia magica.",
  "BK_4060_0070_NAR": "Un'esplosione proiettò i due in cielo.\r\nSarebbe stata la loro fine...?",
  "CE_004815_0010_CER": "Prendiamolo!",
  "BK_4000_0030_CER": "\"Chi va là?\"",
  "BK_4080_0050_NAR": "Se la ferita non fosse stata curata,\r\ni fili infusi di magia che legavano Cheshire\r\na quel mondo non sarebbero durati a lungo.",
  "SM_004080_0030_CER": "\"Bene che sei pronto a combattere.\r\nQueste maledette fate stanno per\r\nprendersi una bella lezione!\"",
  "SM_004100_0010_NAR": "Cereza era sollevata.\r\nIl lupo era vivace come sempre.",
  "LV_004920_0000_CER": "\"Cheshire, rallenta!\"",
  "SM_004030_0010_NAR": "Cereza era di certo diventata più\r\nforte dal suo ingresso nella foresta.\r\nTuttavia, farsi strada da sola\r\nsi stava rivelando più difficile\r\ndel previsto.",
  "BK_4060_0030_NAR": "I due avvertirono il pericolo nelle\r\nparole di Púca e corsero via.",
  "SM_004050_0115_NAR": "Cereza lo seguì e lo ritrovò\r\nfermo presso una piccola\r\napertura sul muro della fortezza.",
  "SM_004030_0020_NAR": "Se solo Cheshire fosse qui...",
  "LV_004940_0000_NAR": "Una strana struttura apparve dal buio,\r\nstagliandosi davanti a Cereza.",
  "SM_004050_0100_NAR": "Lo sfuggente lupo bianco era\r\ncomparso proprio davanti a Cereza.",
  "LV_004010_0000_CER": "Mamma? Sei tu?",
  "BK_4080_0170_CER": "\"Tranquillo, ricresceranno.\"",
  "SM_004080_0000_CER": "\"Cheshire!\"",
  "LV_004075_0000_CER": "Cheshire!",
  "IN_4010_0010_NAR": "Cereza e Cheshire, di nuovo uniti!\r\nE ancora una volta, non c'era\r\ntraccia del lupo bianco.\r\nL'intrepida coppia riprese il cammino.",
  "SM_004110_0070_MOR": "\"Il mio incantesimo è quasi\r\ncompletato. Presto potrò farti\r\nuscire da quella foresta.\r\nResisti solo un altro po'.\"",
  "BK_4080_0220_NAR": "[FONT:9 ]Beh, diamoci una mossa, che dici?[FONT:N ]\r\naggiunse stridulo.",
  "BK_4090_0040_NAR": "L'immagine scomparve\r\ncon un grido agghiacciante\r\nche riecheggiò tra gli alberi.",
  "SM_004110_0080_CER": "\"Oh... G-grazie, Morgana.\"",
  "SM_004040_0030_CER": "Darò solo un'occhiata.\r\nNon permetterò che succeda\r\nqualcosa al mio gatto di pezza.",
  "BK_4020_0075_CER": "\"Insomma, che vuoi dirci?\r\nChe sei il re delle fate?\"",
  "SM_004010_0040_NAR": "Cheshire guardò Cereza.\r\nLe disse di sbrigarsi\r\ne di andare avanti.",
  "SM_004110_0000_NAR": "Apparve la spettrale immagine\r\ndi Morgana.\r\n\r\nRivolse uno sguardo a Cereza\r\ne aggrottò le sopracciglia.",
  "LV_004945_0000_CER": "Ops, non credo debba girare da quella parte...\r\nVabbè, comunque funziona.",
  "BK_4080_0210_NAR": "Ma prima che potesse finire la\r\nfrase, Cheshire ritornò alla sua\r\nforma in miniatura.",
  "SM_004110_0040_MOR": "\"Per salvare un demone?\r\nCereza, non scordare chi è\r\nla padrona e chi il servitore.\"",
  "SM_004010_0160_CER": "\"Non scordare chi ti ha evocato qui!\r\nFai il bravo demone e ubbidiscimi!\"",
  "SM_004110_0120_CER": "\"Dai, ci siamo quasi!\"",
  "SM_004010_0070_NAR": "[FONT:9 ]Se non mi fossi occupato\r\ndi quella visione, saresti finita\r\nin fondo a quel burrone![FONT:N ]\r\n\r\nIl demone era sempre più\r\ninfastidito.",
  "SM_004090_0010_CER": "\"Non ho fatto tutto da sola.\r\nNon ce l'avrei mai fatta\r\nsenza l'aiuto di Cheshire.\"",
  "SM_004110_0030_NAR": "Cereza spiegò che aveva\r\ndovuto usare i suoi capelli\r\nper salvare Cheshire.",
  "BK_4000_0055_ROS": "\"Sì, mia amata Cereza.\r\nVieni, da questa parte...\"",
  "SM_004070_0150_NAR": "Per fortuna il lupo bianco\r\ntenne a bada le fate più vicine.",
  "SM_004020_0030_NAR": "Nessuna risposta."
}
