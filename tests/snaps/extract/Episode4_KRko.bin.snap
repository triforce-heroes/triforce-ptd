{
  "SM_004080_0040_NAR": "『네가 한 말치고 마음에 드는군.\r\n마음껏 날뛰어 주마!』\r\n\r\n세레자도 체셔도 기운이 넘치네요.\r\n둘은 요새를 뒤흔들 정도로\r\n날뛰기 시작했습니다!",
  "BK_4000_0040_NAR": "어떻게 된 일일까요?\r\n눈앞에 세레자의 엄마가\r\n나타났습니다.",
  "SM_004060_0010_NAR": "늑대는 똑바로 선 채로\r\n세레자를 지긋이 바라봤습니다.\r\n\r\n그 눈빛은 마치\r\n같이 가자!\r\n라고 간절히 말하는 듯했습니다.",
  "BK_4060_0040_POO": "「요정 왕국에 영광이 있으리라!」",
  "IN_40000_0020_NAR": "세레자는 서둘러 달려갔습니다.\r\n",
  "LV_004020_0000_NAR": "어둑한 곳에 우뚝 서 있는\r\n성처럼 커다란 건물이 보이기 시작했습니다.",
  "CE_004800_0000_CER": "쟤, 저런 것도 할 수 있어!?\r\n……어쨌든 도망가자!",
  "SM_004030_0050_CER": "「……이제 나랑은 상관없어!」",
  "IN_40000_0010_NAR": "세레자는 빨려 들어가듯이\r\n엄마 곁으로 걸어갑니다.",
  "LV_004085_0015_NAR": "체셔가 살짝 쑥스럽다는 듯 대답했습니다.",
  "CE_004000_0000_CER": "엄마!?\r\n설마 그럴 리가……",
  "SM_004050_0060_NAR": "세레자는 두려움도 잊은 채\r\n요정들의 뒤를 쫓았습니다.\r\n",
  "BK_4080_0180_CER": "「그보다……\r\n내가 약속했었지.\r\n너를 집으로 돌려보내 주겠다고」\r\n",
  "BK_4080_0090_NAR": "지금 세레자가 취할 수 있는\r\n방법이 딱 하나 있었습니다.",
  "BK_4080_0010_CER": "「체, 체셔!?」",
  "SM_004020_0070_CER": "「따, 딱히 안 무섭거든.\r\n나는 마녀라고!」",
  "LV_004025_0000_CER": "요정이 어디에 있을지 몰라.\r\n조용히, 조용히……",
  "SM_004010_0110_NAR": "『기껏 도와줬더니 그게 할 말이냐!\r\n네가 멍하게 있으니까 요정 녀석들의\r\n하찮은 마술에 걸리는 거잖아!』\r\n\r\n체셔도 지지 않고 맞섭니다.",
  "LV_004080_0000_CER": "엉겁결에 쓰긴 했는데…\r\n복구의 마도술, 처음으로 성공했어",
  "SM_004070_0030_NAR": "왜 이해를 못 하는 거지?\r\n우리는 그 꼬마의 목숨만 있으면 된다!",
  "BK_4020_0090_POO": "「다만 행운이라 하여도\r\n짐의 적수로는 한참 모자라니\r\n……이 어찌나 안타까운 일일꼬?」",
  "BK_4020_0020_NAR": "가장 잘난 듯 행동하던 요정입니다.",
  "CE_004010_0010_CER": "부서졌으면 고치면 되지!",
  "BK_4020_0100_POO": "「요정 중의 요정……\r\n하늘이 내려 주신 지혜를 지니고\r\n이 왕국에 광명을 드리우는 자……」",
  "SM_004070_0120_CER": "「체셔!」",
  "LV_004015_0000_CER": "이, 이 정도 숲, 혼자서도 충분해.\r\n그래, 혼자서도 무섭지 않아……!",
  "SM_004040_0000_NAR": "세레자는 다시 체셔를 발견했습니다.\r\n\r\n아무래도 심한 상처를 입은 탓에\r\n움직일 수 없어 궁지에 몰린 듯합니다.",
  "SM_004140_0040_NAR": "세레자는 자기 얼굴이 더러워진 걸\r\n알아채고 황급히 얼굴을 닦아 냅니다.\r\n\r\n체셔는 세레자의 얼굴을 보고\r\n한참을 웃어 대네요.",
  "BK_4020_0050_NAR": "잘난 체하던 요정이 아주 잘난 태도로\r\n말을 이어 갔지만……\r\n말투가 너무 독특해서 뭘 말하고 싶은지\r\n잘 모르겠습니다.",
  "BK_4020_0170_POO": "「그렇다면……\r\n천지가 두려워하는 왕의 힘\r\n여기서 선사하겠노라!」",
  "SM_004070_0040_NAR": "방해만 하지 않는다면\r\n너를 마계로 돌려보내 주겠다는데!",
  "BK_4020_0140_CER": "「……그렇구나.\r\n어쨌든 네가 체셔를\r\n이런 꼴로 만든 거지?\r\n그런 나쁜 아이한텐 벌을 줄 거야!」",
  "SM_004035_0020_NAR": "체셔는 괜찮을까……?\r\n걱정이 머릿속을 스쳤습니다.",
  "SM_004070_0160_CER": "「늑대야…… 고마워!」",
  "BK_4070_0010_CER": "「나, 나도 너 같은 거 몰라」",
  "LV_004060_0010_CER": "무슨 얘기를 하고 있는지는 모르겠지만……\r\n저렇게 흥분한 걸 보니 무척 나쁜 짓을\r\n꾸미고 있는 게 틀림없어!",
  "LV_004925_0000_CER": "「다 젖었잖아.\r\n그러니까 내가 뭐랬어」",
  "SM_004020_0000_CER": "「흥, 나도 마도술에\r\n익숙해졌으니까\r\n체셔가 없어도 문제없어」",
  "SM_004035_0010_NAR": "체셔와 대판 다퉜던 그때의 기세는\r\n이미 다 날아가 버렸습니다.",
  "SM_004070_0070_NAR": "그럼 마지막으로 기회를 주마!\r\n우리를 방해할 건가, 안 할 건가!",
  "SM_004110_0110_NAR": "둘은 서로를 묵묵히 바라보았습니다.\r\n힘을 얻는다는 것은\r\n서로 이별하게 된다는 뜻입니다.\r\n\r\n그 사실이 각자의 머릿속을\r\n스쳐 지나갔습니다.",
  "SM_004010_0150_NAR": "그리고 결국 세레자의 분노가\r\n폭발했습니다.",
  "BK_4060_0000_POO": "「오오, 어찌 이런 일이!\r\n짐의 꼭두각시가 허망하게 쓰러지고\r\n저주의 불꽃은 짐을 불태우는구나!」",
  "LV_004005_0010_CER": "이상하네…… 목소리가 들린 것 같은데……",
  "BK_4080_0060_CER": "「무리하지 마!\r\n지금 움직이면 상처가 더……」",
  "BK_4000_0000_NAR": "요정들이 어둠 속에서 몰래\r\n세레자와 체셔를 엿보고 있습니다.",
  "BK_4080_0100_MOR": "\"알겠나요, 세레자\"",
  "SM_004100_0020_CER": "「류카온이 있는 곳까지\r\n이제 얼마 안 남았어.\r\n가자, 체셔!」",
  "SM_004050_0090_CER": "「……늑대구나!」",
  "SM_004090_0030_LUC": "「곧 내 진짜 모습으로 만나겠네……\r\n그때 많은 이야기를 나누자」",
  "SM_004050_0010_NAR": "체셔는 요정들에게 잡혀 있었습니다.\r\n요정들 가운데서 잘난 듯 행동하는\r\n한 요정이 보입니다.",
  "CE_004030_0000_CER": "하늘로 돌아가!",
  "SM_004050_0130_CER": "「자, 잠깐만! 안쪽은 위험해!」",
  "SM_004090_0000_LUC": "「여러 고난을 이겨 내고\r\n여기까지 잘 와 줬어.\r\n넌 정말 대단해, 세레자」",
  "SM_004050_0020_NAR": "그 요정이 무어라 말하는 듯했지만\r\n멀어서 잘 들리지 않습니다.",
  "BK_4080_0140_NAR": "엄마처럼 멋진 마녀가 되기 위해\r\n기른 소중한 머리카락이었습니다.",
  "SM_004080_0025_NAR": "아주 눈부신 팀워크입니다.",
  "LV_004070_0000_CER": "그러고 보니 잔느랑 같이\r\n시계탑 꼭대기까지 올라간 적이 있었지……",
  "SM_004050_0125_CER": "「여기로 가면 요정한테 들키지 않고\r\n안으로 들어갈 수 있겠네……\r\n늑대야, 알려 줘서 고마워!」\r\n",
  "LV_004055_0000_CER": "이거, 어디까지 이어지는 거야?\r\n체셔는 대체 어디까지 끌려간 거냐구……!",
  "LV_004040_0010_NAR": "요새 위에는 섬뜩한 균열이 입을 벌리고 있습니다.\r\n",
  "LV_004090_0000_NAR": "새빨간 빛을 내뿜는 구체.\r\n둘은 마침내 마지막 엘레멘트 코어가\r\n있는 곳에 도착했습니다.",
  "SM_004060_0025_CER": "……아, 방금 말은 체셔한텐 비밀이야!」",
  "SM_004050_0070_CER": "「여기로 들어갈 순 없겠네……\r\n다른 입구는 없을까?」",
  "SM_004030_0040_NAR": "그때 익숙한 소리가 들려왔습니다.\r\n체셔입니다.\r\n\r\n아무래도 상처를 입어\r\n요정들한테서 도망가고 있나 봅니다.",
  "LV_004020_0010_CER": "괜찮아 세레자.\r\n혼자서도 무섭지 않아…… 혼자서도 문제없어…… 혼자서도 할 수 있어……",
  "CE_004815_0000_CER": "지금이야!",
  "SM_004060_0000_CER": "「늑대야,\r\n여기는 요정들의 요새야.\r\n이런 곳에 있으면 위험해」",
  "LV_004085_0020_CER": "응, 무척 잘 어울려……",
  "BK_4000_0050_CER": "「엄마……? 엄마야!?」\r\n",
  "BK_4080_0030_NAR": "요정들이 입힌 상처였습니다.\r\n체셔가 상처를 감추고 있었나 봅니다.",
  "BK_4070_0040_NAR": "숲에서 세레자의 목소리가 메아리칩니다.\r\n그리고 무거운 정적이 찾아왔습니다.",
  "Pooka_vo_disappear_01": "아니! 이건 우연일 뿐! 아무렴!\r\n결코 필연이 아니니라, 우연이고말고!",
  "SM_004070_0130_NAR": "세레자는 앞뒤 생각하지 않고\r\n뛰쳐나가 버렸습니다.",
  "BK_4020_0030_CER": "「쟤 사람 말을 하고 있어!\r\n……좀 말투가 이상하지만」\r\n",
  "LV_004900_0000_CER": "괜찮아, 괜찮아…… 튼튼한 잎이잖아.\r\n안 가라앉을 거야, 틀림없어……",
  "SM_004140_0020_CER": "「……어?\r\n뭐, 뭐야? 뭐가 웃긴데?」",
  "BK_4000_0020_ROS": "「자…… 세레자……!」",
  "SM_004010_0130_CER": "「게다가 날 겁쟁이 취급하는데\r\n너도 어차피 혼자서는\r\n아무것도 못 하잖아!」",
  "BK_4080_0240_NAR": "세레자는 체셔를\r\n꼭 껴안았습니다.\r\n\r\n왠지 체셔도 같이\r\n꼭 껴안은 듯한 기분이 들었습니다.",
  "SM_004110_0010_MOR": "「세레자, 그 머리는 어떻게 된 거죠?\r\n머리카락은 소중히 다루라고\r\n말했을 텐데요!」",
  "SM_004140_0010_CER": "「아파라……\r\n쟤 진짜 뭐야!」",
  "SM_004010_0020_NAR": "세레자는 울부짖었고\r\n곧 가까스로 제정신을 차렸습니다.\r\n모든 게 요정들이 보여 준\r\n환각이었습니다.",
  "SM_004070_0100_NAR": "『요정이 하는 말 따위, 믿음이 안 가는군.\r\n너희들 모조리 먹어 치워 주마!』",
  "BK_8120_0000_CER": "「이걸로 모든\r\n엘레멘트 코어를 부쉈네!」",
  "SM_004070_0090_NAR": "그러자……\r\n체셔가 천천히 입을 열었습니다.",
  "SM_004020_0060_NAR": "뛰쳐나온 토끼를 보고\r\n안도의 한숨을 내쉽니다……\r\n",
  "SM_004110_0100_CER": "「……물론 이겨 낼 거야.\r\n그리고 류카온한테 가서\r\n반드시 힘을 손에 넣을 거야.\r\n\r\n그러면 너도 집으로……」",
  "LV_004010_0003_CER": "엄마!",
  "BK_4020_0040_POO": "「본인의 과오를 반성 않는 어린것이여\r\n못난 가신을 대신하여\r\n짐이 분노의 철퇴를 내리노라!」\r\n",
  "LV_004930_0000_CER": "아뜨뜨!\r\n엄청난 화염이야…… 새까맣게 타 버릴 거야!",
  "BK_4020_0070_CER": "「으음…… 사람 말을\r\n그리 잘하진 못하는구나.\r\n그니까 네가\r\n요정들의 왕이라는 소리지……?」\r\n",
  "LV_004060_0000_NAR": "요정들이 큰 소리로 무언가에 대해\r\n이야기를 나누는 소리가 들렸습니다.",
  "BK_4070_0000_NAR": "그리고 나지막이 으르렁거렸습니다.",
  "BK_4020_0150_NAR": "체셔도 지금까지의 복수를 위해\r\n날뛰고 싶어 몸이 근질근질합니다.",
  "SM_004010_0060_NAR": "하지만 세레자는 웅크린 채로\r\n울음을 멈추지 않네요.",
  "SM_004140_0050_CER": "「그 녀석…… 다음에 만나면\r\n가만 안 둘 거야!\r\n\r\n……체셔\r\n넌 언제까지 웃고 있을 거야!\r\n\r\n빨리 일어나.\r\n출발할 거니까!」",
  "SM_004040_0010_CER": "「나, 나랑은……\r\n나랑은 상관없다고……!」",
  "SM_004110_0050_MOR": "「……하고 싶은 말은 산더미 같지만\r\n그건 당신이 무사히\r\n돌아온 뒤에 하도록 하지요」\r\n",
  "LV_004935_0000_NAR": "홀로 요정과 마주쳐 버린 세레자.\r\n이 상황을 어떻게 헤쳐 나갈 수 있을까요?",
  "LV_004065_0000_CER": "요정이 이렇게나 많아……?\r\n이런 곳에서 무사히 나갈 수 있을까?",
  "SM_004050_0030_CER": "「저 요정들, 뭐 하려는 거지?」",
  "SM_004050_0120_NAR": "세레자라면\r\n간신히 들어갈 수 있어 보입니다.",
  "SM_004050_0000_CER": "「무슨…… 얘기를 하고 있나……?」",
  "LV_004010_0010_CER": "엄마, 잠깐… 기다려!!\r\n엄마!!!",
  "SM_004050_0110_NAR": "하얀 늑대는 마치 세레자를\r\n부르듯이 울고는 달려갔습니다.",
  "SM_004110_0090_MOR": "「요정을 상대하기는 힘들겠지만\r\n모든 힘을 다해서 이겨 내세요.\r\n\r\n당신에게 마도의 가호가\r\n있기를 빌겠습니다.\r\n세레자, 제발 무사하세요……」",
  "SM_004020_0075_CER": "「늑대도 금방 찾아낼 거야!」",
  "Pooka_vo_disappear_07": "으으음……!\r\n마녀 견습생 주제에, 참으로 건방지구나!",
  "LV_004030_0000_NAR": "홀로 요정들과 맞서는 세레자.\r\n대체 어떻게 하면 해치울 수 있을까요?",
  "BK_4020_0120_POO": "「요정왕 푸카이니라!」\r\n",
  "CE_004810_0000_CER": "이럴 수가, 끝이 없잖아!\r\n저 요정을 먼저 해치워야겠어……!",
  "LV_004025_0010_CER": "요정들한테 발견되면 큰일 날 거야.\r\n조용히, 조용히……",
  "BK_4020_0000_NAR": "불현듯 걸음을 멈추는 세레자와 체셔.\r\n주위에서 섬뜩한 분위기가 느껴집니다.\r\n그러자……",
  "SM_004070_0010_NAR": "드디어 체셔를 발견했습니다.\r\n온몸에 심한 상처를 입었네요.",
  "CE_004010_0000_CER": "저 부서진 고문 기구를 내 복구의 마도술로……!",
  "BK_4020_0110_POO": "「오오, 짐이야말로……」",
  "SM_004070_0020_NAR": "구석에서 숨죽이고 있는 세레자의 귀에\r\n요정이 하는 말이 들려왔습니다.",
  "BK_4020_0080_POO": "「참으로 미련한 자로다!\r\n이리 미련한 자임에도\r\n짐을 알현하는 행운을 취하는구나」",
  "BK_4090_0010_CER": "「기다려, 엄마!\r\n제발 혼자 두지 마!」",
  "LV_004050_0000_CER": "체셔, 정말 바보 같아……\r\n잡혀 버리다니!",
  "SM_004010_0100_NAR": "체셔의 말에 세레자는\r\n들고일어났습니다.\r\n\r\n세레자의 눈에 분노가 어리고\r\n눈물이 쏟아집니다.",
  "LV_004080_0010_CER": "다른 곳에도 쓸 수 있지 않을까……?",
  "SM_004010_0010_CER": "「엄마!!」",
  "LV_004035_0000_CER": "힘내자, 세레자!\r\n여기서 포기하면 안 돼!",
  "BK_4060_0045_POO": "「……에잇」",
  "LV_004040_0020_CER": "저게 뭐지…?\r\n평소에 보던 균열보다 훨씬 커.",
  "SM_004050_0040_NAR": "요정들은 체셔를\r\n건물 안으로 끌고 갔습니다.",
  "BK_4080_0080_NAR": "서둘러 체셔의 상처를\r\n막아야 합니다.",
  "LV_004085_0010_NAR": "『이 정도 상처는 별거 아냐.\r\n……하지만 이 리본은 괜찮군』",
  "LV_004905_0000_CER": "체셔, 너 헤엄칠 수 있어!?\r\n……나, 나는 옷이 젖는 게 싫어",
  "BK_4080_0190_CER": "「악마와의 약속을 저버리다니\r\n마녀의 자존심이 용납하지 않아」",
  "SM_004060_0030_NAR": "이렇게 세레자는\r\n하얀 늑대와 함께\r\n요새에 들어가기로 했습니다.\r\n",
  "BK_4080_0160_NAR": "『그래도 괜찮겠어?』\r\n체셔가 걱정되는 듯 말합니다.",
  "SM_004080_0010_NAR": "갑자기 나타난 세레자를 보고\r\n요정들이 혼비백산하네요. 그리고……",
  "SM_004090_0020_LUC": "「악마의 힘도 네 실력이지……\r\n너는 분명 멋진 마녀가 될 거야」",
  "LV_004005_0000_CER": "응……?\r\n체셔, 뭔 말 했어?",
  "BK_4080_0110_MOR": "\"엄브라의 마녀에게 머리카락은\r\n마도기이자, 악마를 불러내는 데\r\n필요한 것이기도 합니다\"",
  "CE_004030_0020_CER": "잘 가!",
  "BK_4000_0010_NAR": "요정들은 슬쩍 일어나\r\n주문을 외우기 시작했습니다.",
  "SM_004030_0030_CER": "「그런 난폭한 애, 난 몰라.\r\n이런 숲쯤이야, 나 혼자……」",
  "BK_4060_0010_POO": "「다만 이 한 몸 불사를지언정\r\n악자를 용서할쏘냐!」\r\n",
  "BK_4060_0020_CER": "「저 요정, 뭐라고 하는 거야?\r\n설마 자기를 희생해서……」",
  "LV_004070_0010_CER": "잔느, 자기도 무서우면서\r\n오기를 부렸었지…… 후후후",
  "SM_004080_0020_NAR": "요정들이 허둥대는 사이에\r\n세레자가 체셔를 풀어 줍니다.",
  "BK_4080_0150_NAR": "그 머리카락이 체셔의 상처를\r\n순식간에 꿰매 주었습니다.",
  "SM_004100_0000_CER": "「늑대야!\r\n다행이야, 무사했구나」",
  "BK_4080_0120_MOR": "\"따라서 마녀에게 자신의 머리카락은\r\n목숨과도 같은 가치를 지니는 겁니다\"",
  "BK_4080_0040_CER": "「상처가 심각해……!」",
  "CE_004030_0010_CER": "가 버려!",
  "SM_004070_0050_NAR": "……그건 악마들이 쓰는 언어였습니다.\r\n\r\n아까 그 잘난 듯 행동하던 요정이\r\n체셔에게 거래를 제안하고 있었습니다.",
  "SM_004020_0020_CER": "「체셔……!?」",
  "SM_004070_0140_CER": "「방해하지 마!」",
  "BK_4070_0030_CER": "「너랑은 절교야!」",
  "BK_4020_0160_POO": "「가엾고 처량하도다!\r\n못 이룰 사랑에 애타는\r\n천사보다도 처량하도다!」",
  "SM_004110_0020_CER": "「이, 이건……\r\n어쩔 수 없는 상황이었어」",
  "SM_004010_0170_NAR": "세레자의 그 한마디에\r\n체셔가 움직임을 멈췄습니다.",
  "BK_4080_0200_CER": "「그러니까, 그……」",
  "LV_004015_0010_CER": "하얀 늑대는 어디로 갔을까……\r\n이쪽이겠지?",
  "LV_004950_0000_CER": "엄마!\r\n날 두고 가지 마!",
  "SM_004040_0020_NAR": "세레자는 어느새\r\n뛰쳐나가고 있었습니다.\r\n체셔를 향해서……",
  "SM_004140_0060_NAR": "세레자는 볼을 부풀리고\r\n화를 내며 걷기 시작했습니다.\r\n\r\n체셔는 서둘러 뒤쫓아가\r\n세레자 얼굴을 슬쩍 들여다보는데……\r\n\r\n그 빵빵한 얼굴을 보고 다시 웃음이\r\n터지려는 걸 간신히 참았습니다.",
  "SM_004010_0140_NAR": "『내가 없었다면 너는 진작에\r\n요정의 먹이가 됐을걸!』\r\n\r\n불만이 쌓였던 체셔도 이에 반박하며\r\n다툼은 점점 거칠어집니다.",
  "CE_004020_0000_CER": "지금이야, 체셔!\r\n녀석을 밀어 넣어!!",
  "BK_4080_0230_CER": "「맡겨만 둬!」",
  "SM_004035_0000_NAR": "간신히 고난을 이겨 낸 세레자.\r\n그것은 생각했던 것보다\r\n훨씬 더 어려운 일이었습니다.",
  "SM_004020_0010_CER": "「내가 없으면 곤란한 건 자기면서……\r\n나중에 후회한다 해도 늦었어!」",
  "SM_004070_0060_NAR": "세레자는 간담이 서늘해져\r\n심장이 멎을 뻔했습니다.",
  "SM_004140_0030_CER": "「아앗! 이게 뭐야!\r\n너, 너무해 진짜~!!」",
  "SM_004010_0080_CER": "「체셔, 이 바보!\r\n엄마를 그렇게 만들다니!」",
  "LV_004045_0000_CER": "늑대야, 어디로 가는 거야?\r\n혹시 다른 입구를 알고 있어?",
  "LV_004915_0000_NAR": "자기 맘대로 잎을 움직일 수 있어서\r\n체셔는 기분이 좋나 봅니다.",
  "SM_004020_0040_NAR": "세레자는 침을 꿀꺽 삼킵니다.\r\n\r\n",
  "BK_4020_0010_POO": "「듣거라! 짐의 위대한 왕국에\r\n근심과 혼돈을 초래하는 어린것이여\r\n어찌 금단의 아이를 각성시켜\r\n악행을 저지르려 하는가!」",
  "BK_8120_0010_CER": "「체셔, 엘레멘트의 힘도\r\n이게 마지막이야.\r\n같이 시험해 보자!」",
  "SM_004070_0000_CER": "「체셔……!」",
  "SM_004070_0080_NAR": "체셔에게 대답을 독촉하는 요정들.\r\n세레자는 숨을 멈추고 귀 기울였습니다.",
  "LV_004030_0010_CER": "뭔가… 뭔가 쓸 만한 게 없을까?",
  "SM_004070_0110_NAR": "체셔는 요정들을 노려보며\r\n딱 잘라 거절했습니다.",
  "CE_004805_0000_CER": "여기까지 왔으니까 괜찮겠지……",
  "SM_004010_0030_NAR": "비록 환각일지라도\r\n세레자의 마음에 깊은 상처를 내기에는\r\n충분했습니다.",
  "SM_004010_0120_CER": "「너 같은 야만스러운 악마가\r\n내 마음을 어떻게 알겠어!」\r\n",
  "SM_004060_0020_CER": "「늑대야, 고마워……!\r\n사실 혼자서는 조금 불안했거든.",
  "LV_004040_0000_NAR": "눈앞에 아주 커다란 철제 건물이 보입니다.\r\n요정들이 세운 요새인 듯합니다.",
  "LV_004055_0010_CER": "마도술 훈련할 때도 이렇게까지\r\n힘들지 않았어……!",
  "LV_004910_0000_CER": "체, 체셔!\r\n좀 더 천천히 움직여!",
  "LV_004085_0000_CER": "어때? 내 복구의 마도술.\r\n평소에 열심히 연습한 보람이 있네!",
  "BK_4080_0130_CER": "「지금…… 이 머리카락보다\r\n훨씬 소중한 게 있어」",
  "SM_004050_0050_CER": "「체셔……!」",
  "BK_4080_0020_NAR": "체셔 다리를 보니 큰 상처가\r\n활짝 벌어져 있었습니다.\r\n솜도 조금 삐져나와 있네요.",
  "BK_4060_0070_NAR": "폭발에 휩쓸려 날아가 버린\r\n세레자와 체셔.\r\n둘은 무사할까요……?",
  "CE_004815_0010_CER": "저 요정을 노려!",
  "BK_4000_0030_CER": "「……누구야?」",
  "BK_4080_0050_NAR": "이대로는 금방 마력이 고갈되어\r\n체셔가 죽고 말 겁니다.",
  "SM_004080_0030_CER": "「짖을 기운이 있는 거 보니 괜찮나 봐.\r\n그럼, 이제 이 녀석들을 해치워 볼까!」\r\n",
  "SM_004100_0010_NAR": "무사해 보이는 하얀 늑대를 보고\r\n세레자는 가슴을 쓸어내렸습니다.",
  "LV_004920_0000_CER": "「체셔!!\r\n천천히 움직이라니까!!」",
  "SM_004030_0010_NAR": "마도술을 조금\r\n쓸 수 있게 되었지만\r\n홀로 이 숲을 헤쳐 나가는 건\r\n그리 쉬운 일이 아닙니다.",
  "BK_4060_0030_NAR": "푸카라고 하는 요정의 말에\r\n위험을 느낀 둘은 서둘러 달렸습니다.",
  "SM_004050_0115_NAR": "그 뒤를 따라가니 그곳에는\r\n요새의 안쪽까지 이어질 듯한\r\n작은 구멍이 뚫려 있었습니다.",
  "SM_004030_0020_NAR": "체셔가 있었더라면……",
  "LV_004940_0000_NAR": "어둑한 곳에 우뚝 서 있는\r\n기묘한 모습의 건물이 보이기 시작했습니다.",
  "SM_004050_0100_NAR": "하얀 늑대가\r\n갑자기 세레자 앞에 나타났습니다.",
  "LV_004010_0000_CER": "엄마?\r\n엄마야?",
  "BK_4080_0170_CER": "「머리는……\r\n다시 기르면 되지」",
  "SM_004080_0000_CER": "「체셔!」",
  "LV_004075_0000_CER": "앗, 체셔……!",
  "IN_4010_0010_NAR": "이렇게 세레자와 체셔가\r\n다시 만났습니다.\r\n그리고 어느새 사라진\r\n늑대를 찾아서 다시 걷기 시작했습니다.",
  "SM_004110_0070_MOR": "「요정의 결계를 파괴할 마도술이\r\n완성되기까지 얼마 남지 않았습니다.\r\n그때까지 어떻게 해서든 버티세요」",
  "BK_4080_0220_NAR": "『이게 더 편하군. 이대로 데려가』\r\n……라고 작게 말한 것 같았습니다.",
  "BK_4090_0040_NAR": "숲속에 울려 퍼지는 엄마의 비명 소리.\r\n그 소리는 마치 칼날처럼\r\n세레자의 마음을 도려냈습니다.",
  "SM_004110_0080_CER": "「아, 알겠어.\r\n고마워, 모르가나」",
  "SM_004040_0030_CER": "……엄마가 주신 소중한 인형이\r\n망가지는 게 싫을 뿐이야!",
  "BK_4020_0075_CER": "그니까 네가\r\n요정들의 왕이라는 소리지……?」",
  "SM_004010_0040_NAR": "체셔가 으르렁거리며\r\n『빨리 일어서』라고 세레자를 재촉합니다.\r\n",
  "SM_004110_0000_NAR": "모르가나의 환영이 나타났습니다.\r\n\r\n모르가나는 세레자를 보고\r\n눈썹을 치켜올리며 말했습니다.",
  "LV_004945_0000_CER": "이렇게 커다란 톱니바퀴도 움직일 수 있어!\r\n……반대로 돌려 버렸지만",
  "BK_4080_0210_NAR": "체셔는 인형 모습으로 돌아가\r\n세레자의 품에 들어왔습니다.",
  "SM_004110_0040_MOR": "「악마를 구하기 위해\r\n소중한 머리카락을 쓰다니……\r\n악마를 이용해야 할 마녀가\r\n악마에게 이용당하면 어찌하나요!」",
  "SM_004010_0160_CER": "「널 불러낸 건 나야!\r\n악마면 악마답게 입 다물고\r\n마녀의 말에 따르란 말이야!」",
  "SM_004110_0120_CER": "「……어쨌든\r\n힘내서 가 보자!」",
  "SM_004010_0070_NAR": "『내가 환각을 공격하지 않았으면\r\n이미 너는 절벽 아래로\r\n곤두박질쳤을걸!』\r\n\r\n체셔는 점점\r\n목소리가 거칠어졌습니다.",
  "SM_004090_0010_CER": "「나 혼자 한 게 아니야.\r\n체셔도 함께여서\r\n여기까지 올 수 있었어」",
  "SM_004110_0030_NAR": "세레자는 체셔를 구하기 위해\r\n머리카락을 잘랐다고\r\n모르가나에게 설명했습니다.",
  "BK_4000_0055_ROS": "「이리로 오렴, 세레자……\r\n우리 예쁜 세레자……」",
  "SM_004070_0150_NAR": "하얀 늑대가 미끼가 되어\r\n요정들의 주의를 끕니다.\r\n",
  "SM_004020_0030_NAR": "아무런 대답도 없습니다.\r\n"
}
