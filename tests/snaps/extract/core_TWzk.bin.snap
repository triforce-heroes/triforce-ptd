{
  "CORE_DIALOG_TXT_112": "獲得瑟蕾莎的服裝\r\n「夢遊仙境的少女」！",
  "CORE_DIALOG_TXT_101": "可以在魔女藏身處\r\n選「更換服裝」來換衣服。",
  "AC_NARRATION235_0010": "巨大瀑布落入妮姆薇湖，\r\n激起強烈的水花。",
  "CORE_SNPSS_4020": "瑟蕾莎發現被妖精捉住的\r\n小柴貓。她放下之前的爭吵，\r\n和狼一起潛入妖精要塞\r\n營救小柴貓。",
  "CORE_WISP_TALK_71_FAS": "嗨，小姑娘。\r\n你找到白狼的足跡了嗎？",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "障壁的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "怨念的妖域",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "【想要拿到手……】\r\n只要學到很多小柴貓的技能就會……？",
  "CORE_WH_TALK_11_COL": "多虧了你們，每天都很開心！\r\n快來跟我們一起玩！",
  "CORE_SNPSS_6010": "瑟蕾莎和小柴貓\r\n共同擊退襲擊他們的萊卡翁。\r\n萊卡翁醒悟後，幫助兩人\r\n尋找離開森林的方法。",
  "CORE_HTDMMESS_0039_001_H39": "咳咳，抱歉，魔女小姐。\r\n我身體不太舒服……你有藥嗎？",
  "CORE_HTDMQUEST_TXT_0026": "就算在森林裡，打扮也是很重要。\r\n我想要適合自己的花！",
  "AC_NARRATION260_0010": "瑟蕾莎和小柴貓救出許多人魂，\r\n最後成了森林裡最受歡迎的人。",
  "CORE_WH_TALK_04_COL": "呵呵，大家一個一個地回來了。\r\n多虧姐姐和貓咪幫忙。",
  "CORE_POSEMENU_TXT_06": "離開提爾納諾。",
  "CORE_HTDMMESS_0023_001_H23": "唉……肚子好餓……\r\n食物、食物、食物……",
  "CORE_WISP_TALK_64_FAS": "帶路的事就交給我。\r\n我能帶你們去任何地方！",
  "CORE_SNPSS_3030": "一番激戰後，瑟蕾莎和小柴貓\r\n終於打倒賈巴沃克。\r\n在白狼的引導之下，\r\n兩人出發前往核心所在的神祠。",
  "CORE_SVSLT_TXT_02": "請選擇要讀取的頁面。",
  "AC_CEREZA040_0010": "大家都討厭你。\r\n你絕不可能成為強大的魔女！",
  "CORE_SNPSS_1000": "瑟蕾莎在奇異的空間中\r\n戰戰兢兢地前進。\r\n她似乎有不得不趕路的理由……",
  "CORE_HTDMMESS_0013_002_H13": "呵呵……聽到了。我聽到低語呢喃……\r\n我也馬上就要去那個次元了……",
  "CORE_WISP_TALK_28_H14": "太好啦——我自由了！\r\n回家做一頓美味大餐吧！",
  "CORE_HTDMMESS_0021_002_H21": "如果在帽子上加點裝飾……嗯。\r\n絕對會大受歡迎！",
  "CORE_POSEMENU_TXT_02": "確認遊玩方式。",
  "CORE_POSEMENU_TXT_11": "可以遊玩接下來的故事。",
  "CORE_WISP_TALK_17_H03": "謝謝你救了我！\r\n好！跟我來，我幫你開門！",
  "TA_9011_0010_COL": "姐姐你要小心。",
  "CORE_DIALOG_TXT_005": "即將清除記錄在此頁面的故事，\r\n是否確定繼續？",
  "CORE_DIALOG_TXT_116": "獲得瑟蕾莎的服裝\r\n「統治者‧夏娃‧原型」、「貞德」！\r\n獲得小柴貓的服裝\r\n「查爾斯」！",
  "CORE_DIALOG_TXT_105": "要離開更衣室嗎？",
  "CORE_HAIR_CERESSA_TXT_03": "決心的象徵",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "詛咒的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "瞑目的妖域",
  "CORE_WH_TALK_21_COL": "如果找到我的同伴，就把這裡告訴祂們。\r\n畢竟大家應該都過得很痛苦……",
  "CORE_WISP_TALK_21_H07": "啊哈——我可以動了！\r\n謝謝姐姐，哇哈哈哈哈！",
  "TEST_WISP_TALK_13_H00": "不知為何有不好的預感……（顫抖）\r\n我們能待在這等嗎……？",
  "CORE_HTDMMESS_0004_002_H04": "沒問題嗎？妖精不會到這裡來吧？\r\n拜託你！快給我能躲藏的東西！",
  "CORE_DIALOG_TXT_150": "以下將確認承受的傷害量相關設定。\r\n請設定瑟蕾莎小柴貓承受傷害的程度。\r\n若選擇「較少」，今後承受的傷害會減少；\r\n若選擇「不承受」，今後將不會承受傷害。",
  "TA_COM030_0010_CER": "真是的！",
  "CORE_HTDMQUEST_TXT_0039": "身體好不舒服。\r\n可以分點藥給我嗎？",
  "CORE_WH_TALK_18_COL": "姐姐、貓咪！\r\n謝謝你們幫助大家！",
  "TA_COM030_0020_CER": "喂！",
  "CORE_DIALOG_TXT_154": "接下來，魔女脈衝會變得越來越難。\r\n若不放心，可以設定自動使出。\r\n若選擇「自動」，即使不推動[BTN:LS ]，\r\n瑟蕾莎也會成功使出魔女脈衝。",
  "CORE_WISP_TALK_25_H11": "謝謝你救了我！\r\n姐姐，我們一起逃出去吧……！",
  "CORE_ARCHIVE_TXT_03": "在森林裡撿到的，某人的筆記。",
  "AC_CEREZA130_0010": "才、才不是！",
  "CORE_WH_TALK_02_COL": "救了人魂，你就告訴祂們要來這裡。\r\n畢竟我想有些人魂不認得路……",
  "CORE_WISP_TALK_32_H18": "呼——得救了，謝謝！\r\n可惡的妖精……！絕不原諒祂們！",
  "CORE_HTDMMESS_0029_003_H29": "這就是藥……嗯……你都幫我到這種地步了……\r\n我也稍微……試著振作一點吧……",
  "AC_NARRATION225_0020": "究竟在前方\r\n有什麼在等著他們呢……？",
  "CORE_HTDMMESS_0034_001_H34": "嗯，發不太出聲音……\r\n魔女小姐，你有沒有藥？",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "戰禍的考驗",
  "CORE_WH_TALK_17_COL": "姐姐你們收下這個！\r\n這是給兩位的謝禮……希望能派上用場。",
  "CORE_HTDMMESS_0006_001_H06": "我說你，有沒有能代替針的東西？\r\n我需要好用的針……",
  "CORE_SNPSS_2010": "人魂柯爾姆很沮喪，\r\n因為祂的同伴被妖精捉走了。\r\n瑟蕾莎跟小柴貓一邊鬥嘴，\r\n一邊前去救助柯爾姆的同伴。",
  "CORE_DIALOG_TXT_009": "是否移動到此地？",
  "CORE_SNPSS_0020": "瑟蕾莎相信夢中少年說的話，\r\n將摩根娜老師的吩咐拋諸腦後，\r\n逕自走入了森林。\r\n她戰戰兢兢在森林中前進。",
  "CORE_WISP_TALK_30_H16": "謝謝你救了我。\r\n聽說好像不少同伴都被捉到塔裡……",
  "AC_CEREZA035_0010": "快放棄吧。\r\n你一向如此不是嗎！？",
  "TA_COM000_0010_CER": "咦？",
  "CORE_HTDMQUEST_TXT_0029": "嗯……麻煩死了……\r\n連活著……都提不起勁……",
  "CORE_WISP_TALK_15_H01": "嗯——謝謝你救了我——\r\n好想去可以好好曬太陽的地方……",
  "CORE_DIALOG_TXT_153": "首先是敵人強度的設定。\r\n請設定敵人的強度。\r\n若選擇「較弱」，將改變敵人行動模式；\r\n選擇「弱爆」，還會改變出現的敵人組合。",
  "CORE_DIALOG_TXT_140": "是否查看「冒險的智慧」\r\n以複習目前所學的遊玩方法？\r\n※「冒險的智慧」可以隨時從「系統」查看。",
  "CORE_SNPSS_5010": "瑟蕾莎成功安撫\r\n因普卡而失控的小柴貓。\r\n友情越發堅定的兩人\r\n一起趕往萊卡翁所在地。",
  "CORE_ARCHIVE_TXT_04": "在森林中找到的，旅程的回憶。",
  "CORE_HTDMMESS_0032_001_H32": "柯爾姆一直非常努力，我想慰勞祂。\r\n魔女小姐，能麻煩你幫個忙嗎？",
  "TA_COM000_0020_CER": "這是……？",
  "AC_NARRATION240_0010": "源源不絕湧出的美麗泉水，\r\n是阿瓦隆森林的生命泉源。",
  "CORE_WISP_TALK_23_H09": "感謝你救了我，真是心地善良的好人。\r\n想必是因為我的美貌令人著迷……呵呵。",
  "AC_NARRATION215_0010": "人魂的秘密基地，\r\n悄悄佇立在森林裡。",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "生死的妖域",
  "CORE_HTDMMESS_0028_001_H28": "承受痛苦、明白痛苦，就不會害怕妖精了。\r\n女孩啊，給我痛苦……",
  "CORE_DIALOG_TXT_119": "獲得小柴貓的服裝\r\n「狂暴魔女」！",
  "CORE_WISP_TALK_14_02_H16": "塔裡好像有很多妖精……\r\n希望大家都沒事……",
  "CORE_HTDMMESS_0017_001_H17": "我要釣到大魚！而且要很多！\r\n那個魔女小姐！能給我魚餌嗎？",
  "AC_NARRATION250_0020": "妖精說不定還保留著一點善良溫柔的心……\r\n這個想法突然間掠過瑟蕾莎的腦海。",
  "CORE_DIALOG_TXT_011": "目前無法移動到此地。",
  "AC_CEREZA145_0010": "別再說了……我不想聽！",
  "CORE_DIALOG_TXT_002": "此頁面有已記錄的故事。\r\n要覆蓋這個故事嗎？",
  "CORE_HAIR_CERESSA_TXT_04": "啟程魔女的編髮",
  "CORE_DIALOG_TXT_111": "獲得瑟蕾莎的服裝\r\n「可愛主角」！",
  "CORE_DIALOG_TXT_102": "要幫瑟蕾莎換衣服嗎？",
  "CORE_WISP_TALK_62_COL": "大家沒事真是太好了……\r\n姐姐，真的很謝謝你！",
  "CORE_SNPSS_4030": "瑟蕾莎救出受傷的小柴貓，\r\n兩人終於平安會合。\r\n他們追著消失的狼，\r\n一起往要塞深處跑去。",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "突破的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "枷鎖的妖域",
  "CORE_POSEMENU_TXT_05": "從提爾納諾內部檢查點重新開始。",
  "CORE_SNPSS_1010": "因與母親羅莎分開而心碎的\r\n瑟蕾莎，為了成為強大的魔女，\r\n拜魔女摩根娜為師，\r\n日復一日地修行。",
  "CORE_HTDMQUEST_TXT_0032": "我想慰勞一下疲憊的朋友。\r\n你能幫我嗎？",
  "CORE_HTDMQUEST_TXT_0021": "我想要華麗的裝飾品，\r\n好讓自己更耀眼！",
  "CORE_POSEMENU_TXT_01": "進行各種設定。",
  "AC_IGNIS005_0010": "嗨，有事找我？\r\n想知道秘密捷徑的話，就交給我吧！",
  "CORE_SNPSS_3020": "多虧有瑟蕾莎大顯身手，\r\n兩人成功驅逐怪物。\r\n稍微有點自信的瑟蕾莎\r\n再次踏上尋找核心之旅。",
  "CORE_SVSLT_TXT_01": "請選擇要記錄的頁面。",
  "CORE_DIALOG_TXT_115": "獲得瑟蕾莎的服裝\r\n「甦醒的黑暗之眼」、\r\n「時間旅人」！",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "剎那的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "冰雨的妖域",
  "CORE_HTDMMESS_0015_002_H15": "嗯，筆記筆記……\r\n這株植物的生態是……",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "【想要拿到手……】\r\n若取得提爾納諾裡所有的寶箱……？",
  "CORE_DIALOG_TXT_006": "真的不後悔？\r\n故事清除後無法復原。\r\n是否確定繼續？",
  "CORE_MISSION_TEXT_0007": "跨越各式各樣的障礙，\r\n攻克提爾納諾！",
  "CORE_COSTUME_CHESHIRE_TXT_03": "戴上帽子總讓我感到幸福。\r\n無論旁人怎麼罵我是怪人都無妨，\r\n每個平凡的日子都是一場派對。",
  "CORE_DIALOG_TXT_160": "在這次的遊戲中，\r\n是否要顯示遊玩方法說明呢？\r\n※可從「設定」的「基本」中\r\n隨時更改設定。",
  "AC_CEREZA060_0030": "不是往那邊走。",
  "CORE_HTDMMESS_0008_001_H08": "我要力量。不輸給妖精的力量……\r\n既然你是魔女，應該有些頭緒吧？",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "怨念的考驗",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "失控的考驗",
  "CORE_CSRELEASE_CERESSA_TXT_04": "【想要拿到手……】\r\n只要學到很多瑟蕾莎的技能就會……？",
  "TEST_WISP_TALK_10": "呃……逃出來了雖然很高興，\r\n但我有懼高症……",
  "TEST_WISP_TALK_03": "謝謝姐姐！\r\n跟我來！我幫你開門！",
  "CORE_HTDMMESS_0015_003_H15": "喔！是曼德拉草！而且長得不錯！\r\n得趕快帶回去研究一下！再見啦！",
  "AC_CEREZA050_0010": "明明一個人什麼都辦不到。\r\n反正你覺得總會有人來幫你吧！？",
  "CORE_WISP_TALK_44_H30": "被捉住實在羞愧萬分！謝謝你，女孩！\r\n這下我又能保護大家了！",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "因與母親羅莎分開而心碎的\r\n瑟蕾莎，為了成為強大的魔女，\r\n拜魔女摩根娜為師，\r\n日復一日地修行。",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "報復的妖域",
  "CORE_SNPSS_2020": "瑟蕾莎和小柴貓會合後，\r\n找到凌虐人魂的妖精樂園之塔，\r\n決定闖入塔內。",
  "CORE_NPC_TXT_11": "調製可用道具。",
  "TEST_WISP_TALK_07": "到前面要小心！\r\n那裡有很可怕的馬戲團！",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "妖光的考驗",
  "AC_NARRATION225_0010": "瑟蕾莎兩人破壞所有的元素核心，\r\n解開了大規模的結界。",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "跺地的考驗",
  "CORE_MISSION_TEXT_0003": "敵人的所有攻擊都會造成致命傷！\r\n在無傷狀態下，將敵人全數殲滅！",
  "CORE_WISP_TALK_34_H20": "全身都好痛……\r\n謝謝你救了我，魔女小姐！",
  "CORE_WISP_TALK_54_H40": "漫長的時光流逝，我又翩翩歸來。\r\n是時候……重新開始人生……",
  "CORE_DIALOG_TXT_090": "記錄已經讀完的故事。\r\n在此讀取故事記錄，\r\n即可繼承目前的狀態\r\n再次開始遊玩故事。",
  "CORE_CSRELEASE_CERESSA_TXT_08": "【想要拿到手……】\r\n只要目睹了貞德的英姿就會……？",
  "CORE_WISP_TALK_14_H16": "好像壓下拉桿就能進去塔裡了！\r\n求求你，幫助大家……",
  "CORE_BAND_CHESHIRE_TXT_02": "可靠的大力士",
  "AC_NARRATION260_0020": "森林裡所有人都不會忘記他們倆。\r\n建立堅定友情的善良魔女與惡魔……",
  "CORE_COSTUME_CERESSA_TXT_07": "自己一定能成為強大又善良的魔女，\r\n在朋友遇到危機時趕去救援。\r\n未來就在我的掌握之中。",
  "CORE_DIALOG_TXT_031": "是否離開提爾納諾？",
  "TA_COM025_0020_CER": "好！",
  "CORE_WISP_TALK_14_03_H16": "聽說你幫助了我的同伴！\r\n我得告訴其他人魂……！",
  "CORE_SNPSS_6020": "普卡召喚出大量妖精。\r\n小柴貓載著瑟蕾莎，\r\n跑向摩根娜製造的光柱。",
  "AC_NARRATION235_0020": "聽著足以震盪身軀的聲響，\r\n瑟蕾莎不禁深吸一口氣。",
  "CORE_WISP_TALK_49_H35": "看來是得救了，感謝你！\r\n我要趕快回去，試試腦袋裡迸出的新點子！",
  "CORE_SNPSS_4010": "妖精製造瑟蕾莎母親的幻象，\r\n導致瑟蕾莎與小柴貓大吵一架。\r\n兩人負氣分道揚鑣，\r\n瑟蕾莎獨自前往妖精要塞。",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "奮戰的妖域",
  "TA_COM025_0010_CER": "呼……",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "滑行的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "制約的妖域",
  "CORE_RETRY_TXT_01": "是否使用道具解鎖此計時模式？",
  "AC_CEREZA015_0020": "放心，我會救你！",
  "CORE_COSTUME_CERESSA_TXT_03": "在仙境旅行的少女，\r\n決定回去後要把這段遊歷寫成書。\r\n前提是她回得去的話……",
  "CORE_SNPSS_1030": "瑟蕾莎遇見了惡魔小柴貓。\r\n為了送小柴貓回魔界，\r\n她必須找到\r\n知曉力量所在的白狼。",
  "CORE_HTDMMESS_0037_001_H37": "我很喜歡這裡，能讓人平靜。\r\n但還是想稍微轉換心情。你有什麼好東西嗎？",
  "CORE_WISP_TALK_39_H25": "好冷好冷好冷好冷！快凍死我了！\r\n謝謝你！然後我要向妖精復仇……！",
  "CORE_HTDMQUEST_TXT_0006": "好想要裁縫用的針。\r\n你知道哪裡能找到嗎？",
  "CORE_HTDMQUEST_TXT_0015": "我想去調查稀有植物。\r\n不好意思，麻煩你幫個忙吧！",
  "CORE_BAND_CHESHIRE_TXT_01": "跟故事裡一樣",
  "CORE_MISSION_TEXT_0008": "打倒阻擋去路的妖精！",
  "CORE_HTDMMESS_0029_002_H29": "曾經被妖精捉住欺負……\r\n後來……就一直提不起勁來……",
  "CORE_WH_TALK_03_COL": "那些妖精……\r\n為什麼會做出這麼殘酷的事呢……",
  "CORE_WH_TALK_19_COL": "大家想跟兩位道謝！\r\n喂——大家過來！",
  "CORE_WISP_TALK_63_FAS": "小姑娘，小姑娘。\r\n迷路的話要跟我說喔！",
  "CORE_NPC_TXT_09": "再次挑戰提爾納諾或計時模式。",
  "CORE_DIALOG_TXT_121": "獲得瑟蕾莎的服裝\r\n「時間旅人」！",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "幻術的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "戰禍的妖域",
  "CORE_WH_TALK_16_COL": "姐姐、貓咪，謝謝你們！\r\n這個謝禮要送給你們！",
  "CORE_COSTUME_CERESSA_TXT_04": "把我送回魔界！\r\n不然就把你吃掉！\r\n呵呵……學得很像吧？",
  "CORE_DIALOG_TXT_021": "是否開始調製？",
  "CORE_DIALOG_TXT_032": "是否重新挑戰計時模式？\r\n（不會保留目前的記錄。）",
  "CORE_SNPSS_6030": "露出真面目的摩根娜\r\n凶狠地朝兩人襲來，\r\n她打算拿小柴貓的靈魂獻祭。\r\n面對恩師，瑟蕾莎決心迎戰。",
  "CORE_WISP_TALK_36_H22": "咦，可以動了……？\r\n原來是你救了我，謝謝你——",
  "AC_NARRATION250_0010": "海灘色彩繽紛，波浪靜靜拍打過來，\r\n與氣氛詭異的森林形成鮮明對比。",
  "TEST_WISP_TALK_12_H00": "還差一點！\r\n差一個人就能開門了……",
  "CORE_HTDMMESS_0004_003_H04": "得救了……咦，秘密基地？你知道怎麼走嗎！？\r\n太好了！去秘密基地比躲在這裡安全多了！",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "致命的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "剛槍的妖域",
  "TA_COM015_0010_CER": "對了！",
  "CORE_RETRY_TXT_02": "是否再度挑戰此提爾納諾？",
  "TEST_WISP_TALK_08": "如果被馬戲團團長發現就……\r\n姐姐你要小心……",
  "CORE_SNPSS_3010": "兩人遭到恐怖怪物襲擊，\r\n連小柴貓的利爪都不管用。\r\n瑟蕾莎雖然恐懼不安，\r\n仍避開怪物耳目在森林中前進。",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "碎骨的考驗",
  "CORE_SNPSS_1020": "瑟蕾莎相信夢中少年說的話，\r\n將摩根娜老師的吩咐拋諸腦後，\r\n逕自走入了森林。\r\n她戰戰兢兢在森林中前進。",
  "CORE_HTDMMESS_0013_003_H13": "呵呵……我好高興。你真的拿來了。\r\n謝謝姐姐答應我的要求。",
  "CORE_HTDMMESS_0026_001_H26": "不管面對什麼情況，\r\n最重要的是有一顆追求美麗的心。\r\n你願意帶適合我的花給我嗎？",
  "CORE_DIALOG_TXT_170": "在貞德外傳中，\r\n將自動於故事的幾個轉折點記錄故事。\r\n請留意，無法手動記錄。",
  "AC_CEREZA060_0020": "你真是笨手笨腳，\r\n沒資格笑別人。",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "守護的考驗",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "剛槍的考驗",
  "CORE_CSRELEASE_CERESSA_TXT_07": "【想要拿到手……】\r\n只要讀完禁忌傳說就會……？",
  "CORE_HTDMMESS_0021_003_H21": "太棒啦！漂亮！高雅！\r\n感謝！我得秀給秘密基地所有人看！！",
  "CORE_NPC_TXT_05": "記錄冒險進度。",
  "CORE_MISSION_TEXT_0004": "打倒敵人後，地上會殘留詛咒。\r\n戰鬥時請小心！",
  "CORE_WH_TALK_20_COL": "同伴應該都還在森林裡……\r\n大家就拜託你們了！",
  "CORE_COSTUME_CERESSA_TXT_08": "只要打敗強敵並找到真正的自我，\r\n就一定能和屬於我的王子殿下在一起。\r\n懷著小小的夢想，明天繼續踏上旅途。",
  "AC_IGNIS015_0010": "森林冒險還順利嗎？\r\n建議你善用秘密捷徑！",
  "AC_NARRATION215_0020": "多虧瑟蕾莎他們大顯身手，\r\n讓這裡重拾歡笑。",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "跺地的妖域",
  "CORE_WH_TALK_10_COL": "歡迎姐姐和貓咪！\r\n大家都很想你們！",
  "CORE_ARCHIVE_TXT_99": "此項目尚未解鎖。",
  "CORE_SNPSS_2030": "瑟蕾莎和小柴貓救出了\r\n柯爾姆被妖精捉住的同伴。\r\n沉浸在重逢喜悅中的人魂，\r\n催促兩人跟著祂們走。",
  "CORE_WISP_TALK_70_FAS": "迷路時就找白狼的足跡吧！\r\n那孩子也是個優秀的帶路者……呵呵。",
  "CORE_WISP_TALK_65_FAS": "你找到白狼的足跡了嗎？\r\n要不要帶你到足跡附近呢？",
  "AC_CEREZA155_0010": "不……別說了！",
  "CORE_COSTUME_CHESHIRE_TXT_04": "我一定要成為強大的魔女！\r\n絕對要救出媽咪！\r\n哼……那傢伙老是這副調調。",
  "AC_NARRATION240_0020": "瑟蕾莎和小柴貓大口喝下那水，\r\n彷彿新生。",
  "TEST_WISP_TALK_04": "我還以為脖子要被拉斷了！\r\n小心那些妖精！",
  "CORE_CSRELEASE_CERESSA_TXT_03": "【想要拿到手……】\r\n若在計時模式下取得優異的成績……？",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "滑行的考驗",
  "CORE_WH_TALK_05_COL": "最近大家會輪流巡邏。\r\n畢竟要是妖精發現這裡就糟了！",
  "CORE_WH_TALK_22_COL": "抱歉，老是在麻煩你們……\r\n接下來我的同伴也拜託你們了。",
  "CORE_BAND_CHESHIRE_TXT_04": "友情的緞帶",
  "CORE_WISP_TALK_58_FAS": "要小心妖精。\r\n祂們的字典裡可沒有寬容這個詞。",
  "AC_IGNIS200_0010_0020": "歡迎來到秘密捷徑！",
  "TEST_WISP_TALK_09": "我在這裡躲著。\r\n不可以告訴別人喔！",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "逃避的考驗",
  "AC_CEREZA030_0010": "像你這麼軟弱，註定會失敗！",
  "CORE_SNPSS_2060": "瑟蕾莎和小柴貓\r\n破壞了第二個元素核心。\r\n兩人一邊嘗試新獲得的力量，\r\n一邊尋找狼的痕跡。",
  "CORE_HTDMMESS_0021_001_H21": "我絕不躲躲藏藏！\r\n我要盛裝打扮，比妖精還耀眼！",
  "CORE_WISP_TALK_57_FAS": "又是高處又是水邊……\r\n小姑娘還要繼續接受考驗，哈哈！",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "束縛的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "追蹤的妖域",
  "CORE_HTDMMESS_0013_001_H13": "呵呵……姐姐，幫幫我吧……\r\n我想要能變強大的儀式道具……",
  "CORE_HTDMMESS_0026_003_H26": "謝謝你，可愛的魔女小姐！\r\n我又過了開心的一天！呵呵！",
  "CORE_COSTUME_CERESSA_TXT_01": "少女是還不成熟的見習魔女，\r\n為獲得力量拯救母親，進入阿瓦隆森林。\r\n有如命中注定一般，與迷失的惡魔相遇。",
  "CORE_SNPSS_6035": "摩根娜與萊卡翁。\r\n瑟蕾莎送走了這兩位\r\n命運乖舛的人，\r\n並和小柴貓道別——",
  "CORE_COSTUME_CERESSA_TXT_05": "瑟蕾莎的昔日服裝。\r\n這段尋母之旅的所見所聞\r\n已深深地刻在她的心裡。",
  "CORE_DIALOG_TXT_033": "是否重新挑戰提爾納諾？",
  "CORE_WISP_TALK_67_FAS": "白狼……好像離這裡有點遠。\r\n好，就交給我這個森林的嚮導吧！",
  "AC_NARRATION245_0010": "宏偉的宮殿無聲地佇立於此，\r\n安靜得彷彿被時間洪流遺忘。",
  "CORE_WH_TALK_07_COL": "秘密基地變得好熱鬧，對吧！\r\n希望大家在這裡可以好好放鬆。",
  "CORE_DIALOG_TXT_120": "獲得瑟蕾莎的服裝\r\n「甦醒的黑暗之眼」！",
  "CORE_HTDMMESS_0023_002_H23": "肚子……肚子餓……\r\n食……物……嗚咕咕咕咕咕……",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "失控的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "荊牢的妖域",
  "CORE_HTDMMESS_0039_002_H39": "咳咳、呼……我還以為變成人魂……\r\n老毛病也會痊癒……咳咳。",
  "CORE_WISP_TALK_68_FAS": "畢竟在這座森林裡很容易迷路嘛！\r\n要不要帶你去白狼附近呢？",
  "CORE_WH_TALK_12_COL": "為了不再讓妖精帶走任何一個人……\r\n我要鍛鍊身體！",
  "CORE_WISP_TALK_24_H10": "謝謝……姐姐？可以這樣叫你嗎？\r\n我會跟著你走。",
  "CORE_WH_TALK_08_COL": "聽我說聽我說，我們組成了秘密基地防衛隊！\r\n不過，應該敵不過妖精就是了……",
  "CORE_WISP_TALK_33_H19": "從我被捉到獲救，\r\n差不多過了3,450萬又6,250秒……\r\n非常感謝你救我出來。",
  "AC_NARRATION210_0010": "巨大無比的妖精之塔。\r\n還有奇特的交通工具跑來跑去。",
  "AC_NARRATION255_0020": "要花多少時間，才能孕育出如此廣大的蓮葉田？\r\n森林的生命力，不禁令人發出讚嘆。",
  "TEST_WISP_TALK_05": "連正面迎戰妖精我都辦不到……\r\n我真的很沒用……",
  "CORE_CSRELEASE_CERESSA_TXT_02": "【想要拿到手……】\r\n只要幫助了大量人魂就會……？",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "死戰的考驗",
  "CORE_HTDMMESS_0006_002_H06": "嗯……這些針都好難用。\r\n用這種針不能工作啊……",
  "CORE_MISSION_TEXT_0001": "只有拘束敵人時才能造成傷害！\r\n快運用荊棘束縛戰鬥！",
  "CORE_HTDMMESS_0034_002_H34": "我好歹也是個巡邏員……\r\n喉嚨不舒服的話，緊急時刻沒辦法大喊……",
  "CORE_WH_TALK_14_COL": "呵呵，秘密基地變更大了！\r\n姐姐你們也盡情地玩吧！",
  "CORE_COSTUME_CHESHIRE_TXT_05": "高級玩偶店畢馬龍的熱賣商品，\r\n摸起來質感光滑，附身感覺一級棒。\r\n※操作角色將更改為貞德＆查爾斯。\r\n",
  "CORE_COSTUME_TXT_01": "請選擇要更換的服裝。",
  "CORE_SNPSS_1070": "瑟蕾莎和小柴貓\r\n破壞了第一個元素核心。\r\n為了破壞其餘三個核心，\r\n他們往森林深處繼續前進。",
  "TA_COM020_0010_CER": "唉……",
  "CORE_WH_TALK_01_COL": "姐姐！\r\n那個……你找到其他同伴了嗎？",
  "AC_NARRATION200_0020": "她能感受到一股力量乘著風\r\n從深處帶來不可思議的氣息。",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "闇影的妖域",
  "CORE_SNPSS_3040": "瑟蕾莎和小柴貓\r\n破壞了第三個元素核心。\r\n兩人運用新獲得的水之力，\r\n往最後的核心前進。",
  "CORE_WISP_TALK_61_FAS": "我幫柯爾姆帶口信。\r\n祂說……「希望有空再來看看我們。」",
  "CORE_EVENT_PAUSE_TXT_01": "按下[BTN:START ]再次開始閱讀。",
  "CORE_WISP_TALK_16_H02": "謝謝你！我得回到基地，\r\n制定一套被妖精捉住時的守則……",
  "TA_COM020_0020_CER": "嘖……",
  "AC_IGNIS200_0000_0010": "緊緊跟著我！",
  "CORE_COSTUME_CERESSA_TXT_09": "學習正統暗影魔導術的見習魔女。\r\n與瑟蕾莎彼此認同，是很好的競爭對手。\r\n※ 操作角色將更改為貞德＆查爾斯。",
  "CORE_HTDMMESS_0004_001_H04": "這裡盡是可怕的東西。得想辦法躲起來……\r\n對了，假裝成植物……！你來幫忙！",
  "CORE_MISSION_TEXT_0005": "敵人有屏障護體！\r\n快運用變身戰鬥！",
  "CORE_COSTUME_CHESHIRE_TXT_01": "血氣方剛的迷失惡魔。\r\n今天也揮舞自豪的爪子狂揍妖精，\r\n毫不在意那狹窄的布偶身體。",
  "TEST_WISP_TALK_55_COL": "還有同伴在妖精塔裡……\r\n姐姐，祂們就拜託你了……！",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "混戰的考驗",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "追蹤的考驗",
  "TEST_WISP_TALK_01": "謝謝姐姐！",
  "CORE_SNPSS_4050": "兩人破壞了最後的核心。\r\n獲得火之力的瑟蕾莎和小柴貓，\r\n一邊摸索力量的運用方式，\r\n一邊離開神祠。",
  "CORE_MISSION_TEXT_0002": "在限制時間內將敵人全數殲滅！\r\n打敗敵人能延長時間限制！",
  "CORE_WISP_TALK_19_H05": "哇——身體變得好輕盈！\r\n謝謝你小貓咪，再見！",
  "AC_NARRATION230_0010": "近乎透明的純白巨木，\r\n高聳到幾乎難以仰視。",
  "CORE_DIALOG_TXT_091": "恭喜！你讀完了整個故事。\r\n‧可以選擇故事難度了。\r\n‧可以遊玩貞德外傳了。\r\n‧可以在魔女藏身處「更換服裝」了。",
  "CORE_HTDMMESS_0028_002_H28": "事先聲明，別誤會了……\r\n我會覺得痛，而且我才不喜歡痛苦。",
  "CORE_NPC_TXT_10": "更換成其他已持有的服裝。",
  "TEST_WISP_TALK_06": "被妖精捉走的朋友……\r\n都沒有再回來……",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "枷鎖的考驗",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "突破的考驗",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "小丑的妖域",
  "CORE_SNPSS_3050": "兩人得知最後一個元素核心\r\n在妖精鎮守的要塞。\r\n瑟蕾莎下定決心，哪怕是為了\r\n萊卡翁也要闖入要塞。",
  "CORE_SNPSS_1060": "瑟蕾莎透過魔法與摩根娜交談，\r\n得知要立刻離開森林並不容易，\r\n於是她決定繼續追尋狼的蹤跡。",
  "CORE_WISP_TALK_26_H12": "嗚……我得救了……？\r\n好可怕，不過……我也會加油的……",
  "CORE_HTDMMESS_0032_002_H32": "我跑來跑去想找慰勞品，\r\n結果跑來這了。真是傷腦筋。",
  "TA_COM010_0010_CER": "唔……",
  "AC_CEREZA045_0010": "又要逃跑了吧？\r\n打從一開始就知道你會逃了！",
  "CORE_HTDMMESS_0037_003_H37": "幫大忙了……噁。有點太臭……\r\n被妖精發現就糟了，不如先回去一趟吧……",
  "TA_COM010_0020_CER": "嗯……",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "生死的考驗",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "搬運的考驗",
  "CORE_CSRELEASE_CERESSA_TXT_05": "【想要拿到手……】\r\n只要蒐集各種回憶書籤就會……？",
  "TEST_WISP_TALK_02": "跟我來！\r\n我幫你開門！",
  "CORE_SNPSS_4040": "瑟蕾莎和小柴貓\r\n擊敗自稱妖精王的普卡，\r\n以及祂召喚出來的幻象親和，\r\n並為了破壞核心繼續深入要塞。",
  "CORE_MISSION_TEXT_0006": "評價會隨時間變化！\r\n要盡速攻克！",
  "CORE_COSTUME_CHESHIRE_TXT_02": "惡魔對美麗的公主施咒，\r\n任意玩弄她純潔的愛……\r\n這樣的衣服讓小柴貓也充滿疑惑？",
  "CORE_HTDMQUEST_TXT_0008": "我想變強。\r\n你是魔女，能幫幫我嗎？",
  "CORE_SNPSS_2070": "第三個核心沉眠於湖底。\r\n為了抽乾湖水，\r\n瑟蕾莎和小柴貓\r\n挑戰攀上森林裡最高的巨樹。",
  "CORE_HTDMMESS_0015_001_H15": "哇——森林裡好多有趣的東西！\r\n喂，就是你！你有什麼稀有植物嗎？",
  "CORE_HTDMQUEST_TXT_0013": "我需要你使用儀式道具\r\n來提升我的次元。",
  "CORE_COSTUME_CERESSA_TXT_02": "惹人憐愛的小芭蕾女伶，\r\n飾演受到詛咒變成天鵝的公主。\r\n為了成為頂尖的閃耀之星，隨故事起舞。",
  "AC_IGNIS020_0010": "阿瓦隆森林危機四伏。\r\n秘密捷徑一定會派上用場。",
  "CORE_HTDMMESS_0008_003_H08": "這是能讓人變強的道具？噁……好臭！\r\n我帶回秘密基地試試看……謝啦！",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "死戰的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "輪轉的妖域",
  "CORE_DIALOG_TXT_130": "一旦繼續往前，\r\n故事便會邁向尾聲。\r\n做好心理準備了嗎？",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "引導的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "妖光的妖域",
  "AC_CEREZA135_0010": "我……我……！",
  "AC_NARRATION220_0020": "上面有一道令人毛骨悚然的裂縫。\r\n妖精究竟在打什麼鬼主意？",
  "CORE_COSTUME_CERESSA_TXT_06": "公主沉睡了500年後終於甦醒，\r\n她找回記憶並勇敢面對自己的命運。\r\n這套神秘服裝，不禁讓人如此想像。",
  "CORE_DIALOG_TXT_030": "是否重置目前所在的樓層？\r\n已獲得的寶箱不會重置。",
  "CORE_HTDMQUEST_TXT_0004": "我已經厭倦活在恐懼中了。\r\n只想找個地方躲著過日子……",
  "CORE_HTDMQUEST_TXT_0017": "要釣大魚就需要好魚餌！\r\n高級魚餌就拜託你了！",
  "CORE_BAND_CHESHIRE_TXT_03": "大意的傷痕",
  "CORE_CSRELEASE_CERESSA_TXT_09": "【想要拿到手……】\r\n只要目睹了貞德的英姿就會……？",
  "CORE_HTDMMESS_0017_002_H17": "這附近的魚巨大又挑嘴。\r\n一不小心我就成了牠們的餌。",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "怒濤的妖域",
  "CORE_DIALOG_TXT_118": "獲得小柴貓的服裝\r\n「瘋帽客」！",
  "CORE_SNPSS_1040": "雖然找到了白狼，\r\n但是牠一溜煙就跑了。\r\n瑟蕾莎和小柴貓跟在後頭，\r\n往森林深處走去。",
  "AC_NARRATION200_0010": "蓊鬱樹木散發的香氣，\r\n在瑟蕾莎的身邊瀰漫。",
  "CORE_HTDMMESS_0017_003_H17": "謝謝魔女小姐！那就趕快去釣……\r\n釣個頭！我忘記拿釣竿啦！",
  "CORE_DIALOG_TXT_156": "是否覺得戰鬥難度很高呢？\r\n可以調整敵人強度與承受的傷害量。",
  "AC_NARRATION255_0010": "瑟蕾莎和小柴貓發現一大片蓮葉田。",
  "CORE_ARCHIVE_TXT_01": "在故事中登場的人物。",
  "CORE_DIALOG_TXT_152": "可以選擇如何使出「束縛連擊」\r\n和「咬殺！」這兩個好用的技能。\r\n基礎用法為「長按後放開」，若想快速使用，\r\n也可以設定成「按一下」便使出技能。",
  "LV_009911_0010_NAR": "小柴貓看起來完全不想動。\r\n全身上下都像在說「你自己來就好」。",
  "CORE_ARCHIVE_TXT_05": "在森林中認識，並變成好朋友的人魂。",
  "CORE_SNPSS_4060": "瑟蕾莎和小柴貓\r\n終於破壞了四個元素核心。\r\n在狼的引導下，\r\n兩人快步前往萊卡翁所在之處。",
  "CORE_HTDMQUEST_TXT_0028": "痛苦……我需要更多痛苦！\r\n女孩啊，讓我痛不欲生吧……！",
  "CORE_WISP_TALK_38_H24": "咕……嘎……\r\n嘎……咕、咯咕……",
  "CORE_HTDMMESS_0008_002_H08": "我是獵人，是射箭的那一方。\r\n我可不想當被射的獵物……",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "【想要拿到手……】\r\n只要蒐集各種筆記就會……？",
  "CORE_DIALOG_TXT_114": "獲得瑟蕾莎的服裝\r\n「昔日回憶」！",
  "CORE_WISP_TALK_45_H31": "謝謝你救我出來。\r\n是說我的植物還好吧？你知道它們怎麼樣了嗎？",
  "CORE_HTDMMESS_0037_002_H37": "滿腦子都是工作的話，會變得神經緊繃。\r\n雖然身在危險的森林，但適時放鬆還是很重要的。",
  "CORE_HAIR_CERESSA_TXT_01": "跟故事裡一樣",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "碎骨的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "威光的妖域",
  "CORE_WISP_TALK_52_H38": "救援終於來了。看來忍住是對的。\r\n好啦，該回歸正軌了……",
  "CORE_SNPSS_2050": "兩人合力擊敗馬戲團團長——\r\n阿瑪丹‧杜布。\r\n他們仔細調查馬戲團帳篷內部，\r\n尋找元素核心。",
  "TA_COM035_0020_CER": "嗯！？",
  "AC_IGNIS010_0010": "最近好嗎？\r\n現正提供秘密捷徑的導覽服務！",
  "CORE_POSEMENU_TXT_00": "請移動游標選擇項目。",
  "CORE_HTDMQUEST_TXT_0037": "我想換個心情。\r\n你有線香之類的東西嗎？",
  "CORE_POSEMENU_TXT_04": "讀取故事記錄。",
  "AC_NARRATION210_0020": "彷彿反映出妖精醜陋內心的吵雜氣氛，\r\n讓瑟蕾莎感到鬱悶不已。",
  "TEST_GIMMICK_TALK_01": "門上有個小小的蹺蹺板，\r\n正好跟人魂差不多大。",
  "CORE_WISP_TALK_41_H27": "神算如我，早就知道你會來救我。\r\n難道……你是我的命運之人……？",
  "TA_9012_0010_COL": "姐姐你別逞強喔。",
  "CORE_HTDMMESS_0028_003_H28": "呵呵，這樣我就更耐痛了！\r\n這位女孩，感謝你！秘密基地再會吧！",
  "TA_COM035_0010_CER": "咦！？",
  "AC_CEREZA150_0010": "不、不是！不是的！",
  "AC_CEREZA060_0040": "我說你，再這樣下去就要天黑囉？",
  "AC_NARRATION245_0020": "瑟蕾莎也聽說過，\r\n很久以前妖精王妃就住在這裡……",
  "CORE_DIALOG_TXT_103": "要幫小柴貓換衣服嗎？",
  "CORE_HTDMMESS_0032_003_H32": "謝謝，柯爾姆會很開心！\r\n那個……能順便告訴我秘密基地怎麼走嗎？",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "激化的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "混戰的妖域",
  "CORE_DIALOG_TXT_010": "無法移動到目前所在地。",
  "CORE_DIALOG_TXT_117": "獲得小柴貓的服裝\r\n「咒愛陰影」！",
  "CORE_DIALOG_TXT_104": "是否移動到更衣室？",
  "CORE_HAIR_CERESSA_TXT_02": "見習魔女的辮子",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "始源的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "恩寵的妖域",
  "CORE_HTDMQUEST_TXT_0023": "嗚嗚嗚，我好餓……\r\n給我食物……",
  "AC_CEREZA055_0010": "愛哭鬼、膽小鬼、窩囊廢！\r\n最適合蹲在角落偷偷摸摸了！",
  "CORE_POSEMENU_TXT_03": "返回標題畫面。",
  "TEST_WISP_TALK_11_H00": "抱歉，要打開這扇門，\r\n還需要兩個人左右……",
  "CORE_SNPSS_2040": "人魂將瑟蕾莎和小柴貓\r\n帶往祂們居住的秘密基地。\r\n兩人養足精神後重返森林，\r\n準備繼續破壞核心。",
  "CORE_SVSLT_TXT_03": "請選擇要刪除的頁面。",
  "CORE_HTDMMESS_0006_003_H06": "好極了，這個尖尖的很棒！\r\n加工一下就能當裁縫針了！\r\n謝謝你，小魔女！幫了我大忙！",
  "TA_COM005_0010_CER": "喂，小柴貓。",
  "CORE_WH_TALK_15_COL": "感謝你們幫助我的同伴！\r\n這是大家一起準備、要給你們的謝禮！",
  "CORE_HTDMMESS_0034_003_H34": "謝謝！我先回秘密基地了。\r\n等喉嚨恢復，我唱歌給你們聽！",
  "CORE_WISP_TALK_50_H36": "妖精也太粗魯了！如果頭斷了怎麼辦！\r\n你也這樣覺得吧？對吧！？",
  "CORE_HTDMQUEST_TXT_0034": "喉嚨不舒服……\r\n魔女小姐，你有藥嗎？",
  "CORE_POSEMENU_TXT_07": "請選擇要記錄的頁面。",
  "AC_NARRATION220_0010": "昏暗中，妖精的巨大要塞森然聳立。",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "【想要拿到手……】\r\n只要目睹貞德的英姿就會……？",
  "CORE_WISP_TALK_60_FAS": "要不要偶爾去一趟秘密基地？\r\n大家好像都很想跟小姑娘你一起玩！",
  "CORE_HTDMMESS_0029_001_H29": "嗯，好懶……全都麻煩死了……\r\n啊？藥嗎……？如果不麻煩的話……",
  "AC_CEREZA060_0050": "你真的很不會用元素之力。",
  "CORE_DIALOG_TXT_113": "獲得瑟蕾莎的服裝\r\n「神氣惡魔」！",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "逃避的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "守護的妖域",
  "CORE_HTDMMESS_0023_003_H23": "哇——謝謝你的食物！\r\n差點餓到把你吃了，嘿嘿！",
  "CORE_SNPSS_1050": "瑟蕾莎受夢中少年請託，\r\n要破壞森林裡的四個元素核心。\r\n兩人確立目標後，\r\n再次追尋狼的蹤影。",
  "CORE_WH_TALK_06_COL": "同伴個個都非常可靠。\r\n我也要加油……",
  "CORE_DIALOG_TXT_008": "將讀取此故事的進度繼續遊戲。\r\n未記錄的故事將會消失，\r\n是否確定繼續？",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "輪轉的考驗",
  "CORE_WISP_TALK_66_FAS": "你該走的路就在前面不遠處。\r\n走吧，我為你帶路！",
  "CORE_WH_TALK_09_COL": "「該玩就玩，該工作就工作。」\r\n這是秘密基地的唯一守則！",
  "CORE_DIALOG_TXT_155": "想變更時，\r\n可從「設定」的「遊戲難度」中\r\n隨時更改設定。",
  "CORE_ARCHIVE_TXT_02": "阻撓瑟蕾莎的敵人。",
  "CORE_HTDMMESS_0039_003_H39": "謝謝你，魔女小姐。\r\n食物也有了，差不多該趕快回基地……",
  "AC_NARRATION230_0020": "那是阿瓦隆森林的神木。\r\n從古至今，在這祭祀著好幾位妖精王。",
  "CORE_WISP_TALK_69_FAS": "我感受到附近有白狼的氣息。\r\n這一帶應該有足跡吧？",
  "CORE_WH_TALK_13_COL": "看到了嗎？秘密基地擴建了。\r\n增加了好多好多遊樂場！",
  "CORE_SNPSS_6040": "經歷阿瓦隆森林的冒險後，\r\n瑟蕾莎有了突飛猛進的成長。\r\n她銘記著與摯友的約定，\r\n開啟一段嶄新的旅程。",
  "CORE_DIALOG_TXT_151": "小柴貓想轟轟烈烈地戰鬥，可以為祂\r\n選擇使用技能時魔力計量條的消耗量。\r\n若選擇「不減少」，\r\n今後將不會消耗魔力計量條。",
  "CORE_WH_TALK_23_COL": "兩位是我們的英雄！\r\n隨時歡迎你們來玩，等你們喔！",
  "CORE_WISP_TALK_59_FAS": "對了，柯爾姆想見你。\r\n祂說有話想告訴小姑娘你。",
  "CORE_WISP_TALK_47_H33": "呼……得救了。我要跟你道謝。\r\n不過那些妖精就不能安分一點嗎……",
  "CORE_WISP_TALK_56_FAS": "下一個核心在湖底。\r\n首先要往巨樹前進。",
  "CORE_HTDMMESS_0026_002_H26": "唉……妖精到底為什麼要那麼殘忍。\r\n大家好好相處不行嗎……"
}
