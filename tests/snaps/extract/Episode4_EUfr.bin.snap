{
  "SM_004080_0040_NAR": "[FONT:9 ]Bien dit. Ça me plaît plus\r\nque t'entendre chialer.\r\nUne punition ? Avec plaisir ![FONT:N ]\r\n\r\nCereza et Chouchou voyaient rouge.",
  "BK_4000_0040_NAR": "Comment se pouvait-il... ?\r\nDevant Cereza se tenait sa mère.",
  "SM_004060_0010_NAR": "Mais le loup la regarda\r\nsans bouger.\r\n\r\n« On y va ensemble ! »\r\nSemblait dire son regard.",
  "BK_4060_0040_POO": "« Vive le royaume des fées ! »",
  "IN_40000_0020_NAR": "Dans sa hâte de rejoindre sa mère,\r\nelle marchait de plus en plus vite.",
  "LV_004020_0000_NAR": "À peine visible dans la pénombre,\r\nun gigantesque bâtiment perçait le\r\nciel telle la flèche d'une église.",
  "CE_004800_0000_CER": "Il est plein de surprises, celui-là.\r\nBon, nous ferions mieux de filer !",
  "SM_004030_0050_CER": "« Pff. Pas mon problème ! »",
  "IN_40000_0010_NAR": "Cereza se sentait irrésistiblement\r\nattirée vers l'apparition.",
  "LV_004085_0015_NAR": "Chouchou avait dit cela d'un air gêné.",
  "CE_004000_0000_CER": "Maman ? C'est impossible...",
  "SM_004050_0060_NAR": "Oubliant le péril de sa situation,\r\nCereza se rua à la poursuite\r\ndes fées jusqu'à leur forteresse.",
  "BK_4080_0180_CER": "« Et puis c'est un peu moi qui\r\nt'ai mis dans ce pétrin. »",
  "BK_4080_0090_NAR": "Pour cela, un seul moyen.",
  "BK_4080_0010_CER": "« Chouchou ! »",
  "SM_004020_0070_CER": "« B-Bien tenté, Avalon, mais il\r\nen faut plus pour effrayer une\r\nsorcière. »",
  "LV_004025_0000_CER": "Il peut y avoir des fées n'importe\r\noù. Je ne dois pas faire de bruit.",
  "SM_004010_0110_NAR": "[FONT:9 ]Je te sauve la vie, et c'est ainsi\r\nque tu me remercies ? Si t'étais\r\npas aussi empotée, j'aurais pas\r\nbesoin de tout faire pour toi ![FONT:N ]\r\nChouchou n'avait pas l'intention\r\nde fléchir.",
  "LV_004080_0000_CER": "De la magie restauratrice...\r\nJe n'avais encore jamais réussi ça.",
  "SM_004070_0030_NAR": "[FONT:9 ]C'est simple,\r\nil nous faut juste\r\nla fille...[FONT:N ]",
  "BK_4020_0090_POO": "« Même les arbres d'Avalon se\r\ncourbent en signe d'allégeance. »",
  "BK_4020_0020_NAR": "C'était la fée royale.",
  "CE_004010_0010_CER": "Quand c'est cassé,\r\nil faut réparer !",
  "BK_4020_0100_POO": "« Je suis Púca le sage.\r\nPúca le magnanime. »",
  "SM_004070_0120_CER": "« Chouchou ! »",
  "LV_004015_0000_CER": "Je peux très bien me débrouiller seule\r\ndans cette forêt. J-Je n'ai pas peur !",
  "SM_004040_0000_NAR": "Cereza aperçut à nouveau Chouchou.\r\n\r\nIncapable de bouger en raison de ses\r\nblessures, il était cerné par les fées.",
  "SM_004140_0040_NAR": "Réalisant ce qui s'était passé,\r\nCereza se nettoya vite le visage.\r\n\r\nMais c'en était trop pour Chouchou.\r\nIl se tordait de rire.",
  "BK_4020_0050_NAR": "La fée royale poursuivait\r\nson monologue altier. Mais\r\nson fort accent le rendait\r\nquasi incompréhensible.",
  "BK_4020_0170_POO": "« Nous ferons pleuvoir sur eux un\r\nchâtiment céleste qui leur fera\r\nregretter leur irrévérence ! »",
  "SM_004070_0040_NAR": "[FONT:9 ]Alors ne nous embête pas, et\r\non s'assurera que tu retournes\r\nau royaume des démons ![FONT:N ]",
  "BK_4020_0140_CER": "« Oh là... Alors c'est toi qui as fait\r\ndu mal à mon pauvre Chouchou !\r\nTon royal derrière mérite\r\nune bonne fessée ! »",
  "SM_004035_0020_NAR": "Chouchou... Cereza ne pouvait\r\ns'empêcher de penser à lui.",
  "SM_004070_0160_CER": "« Merci ! »",
  "BK_4070_0010_CER": "« J'aurais préféré ne jamais t'invoquer ! »",
  "LV_004060_0010_CER": "Je ne comprends pas ce qu'elles disent,\r\nmais connaissant les fées, ça doit être\r\nune sale affaire !",
  "LV_004925_0000_CER": "« Me voilà trempée. Je\r\nt'avais dit de ralentir ! »",
  "SM_004020_0000_CER": "« Personne a besoin de toi, Chouchou.\r\nJe peux me débrouiller seule ! »",
  "SM_004035_0010_NAR": "L'optimisme qu'elle avait ressenti\r\naprès s'être séparée de Chouchou\r\ns'était depuis longtemps envolé.",
  "SM_004070_0070_NAR": "[FONT:9 ]Que décides-tu ? C'est ta\r\ndernière chance, démon ![FONT:N ]",
  "SM_004110_0110_NAR": "Cereza et Chouchou échangèrent un\r\nregard. Obtenir le pouvoir de Lukaon\r\nmarquerait la fin de leur aventure.\r\nIls devraient alors se dire adieu.",
  "SM_004010_0150_NAR": "Puis vint l'étincelle qui mit le\r\nfeu aux poudres.",
  "BK_4060_0000_POO": "« Ô drame ! Notre allié céleste a\r\nété terrassé... Les flammes de la\r\ndéfaite se font brûlantes. »",
  "LV_004005_0010_CER": "Je jurerais avoir entendu\r\nquelque chose...",
  "BK_4080_0060_CER": "« Reste tranquille, ou tu ne feras\r\nqu'empirer les choses. »",
  "BK_4000_0000_NAR": "Cereza et Chouchou n'étaient\r\npas seuls. Deux yeux luisants\r\nles observaient dans l'ombre.",
  "BK_4080_0100_MOR": "« N'oublie jamais, Cereza... »",
  "SM_004100_0020_CER": "« Tu veux nous mener à Lukaon ?\r\nOn ne doit plus être loin...\r\nAllez, Chouchou, dépêche ! »",
  "SM_004050_0090_CER": "« Toi ! »",
  "SM_004090_0030_LUC": "« Bientôt, nous nous rencontrerons.\r\nComme j'ai hâte, Cereza... »",
  "SM_004050_0010_NAR": "Les fées avaient capturé Chouchou.\r\nParmi elles se trouvait une fée\r\nd'apparence royale qui se\r\ndistinguait des autres.",
  "CE_004030_0000_CER": "Bon retour au Paradis.",
  "SM_004050_0130_CER": "« Attention à toi ! »",
  "SM_004090_0000_LUC": "« N'y a-t-il rien qui puisse\r\nt'arrêter ? Tu ne cesses de\r\nm'épater, Cereza. »",
  "SM_004050_0020_NAR": "Cette fée semblait s'adresser à\r\nChouchou, mais Cereza était trop\r\nloin pour entendre quoi que ce soit.",
  "BK_4080_0140_NAR": "Cereza avait laissé pousser ces précieux\r\ncheveux pour ressembler à sa mère.",
  "SM_004080_0025_NAR": "Quel admirable travail d'équipe.",
  "LV_004070_0000_CER": "Ça me rappelle quand on escaladait\r\nle clocher, Jeanne et moi...",
  "SM_004050_0125_CER": "« Je devrais pouvoir entrer par\r\nlà sans me faire repérer par\r\nces méchantes fées. Merci ! »",
  "LV_004055_0000_CER": "Cette tour n'en finit pas...\r\nOù t'emmènent-ils, Chouchou ?",
  "LV_004040_0010_NAR": "Au-dessus, une immense faille\r\ndéchirait l'air, telle une bouche\r\nbéante.",
  "LV_004090_0000_NAR": "La sphère rougeoyante brûlait. Ils avaient\r\natteint le dernier noyau élémentaire.",
  "SM_004060_0025_CER": "« Mais ne le répète pas\r\nà Chouchou ! »",
  "SM_004050_0070_CER": "« Zut... Il doit bien y avoir\r\nun autre moyen d'entrer. »",
  "SM_004030_0040_NAR": "Cereza entendit une voix familière.\r\nLa voix de Chouchou.\r\n\r\nIl était blessé et fuyait des fées.",
  "LV_004020_0010_CER": "Tu réussiras seule, Cereza...\r\nTu n'as besoin de personne\r\npour t'aider...",
  "CE_004815_0000_CER": "Maintenant !",
  "SM_004060_0000_CER": "« Écoute, cette forteresse est truffée\r\nde fées. Tu devrais rester en dehors\r\nde ça. »",
  "LV_004085_0020_CER": "Oui, il te va parfaitement.",
  "BK_4000_0050_CER": "« Maman ? Est-ce vraiment toi ? »",
  "BK_4080_0030_NAR": "Les fées n'avaient pas épargné\r\nleur captif. Chouchou ne pouvait\r\nplus cacher sa douleur.",
  "BK_4070_0040_NAR": "Les derniers mots de Cereza résonnèrent\r\nentre les arbres. Puis le silence retomba.",
  "Pooka_vo_disappear_01": "C'était juste de la chance et rien d'autre !\r\nTu m'entends ? Juste de la chance !",
  "SM_004070_0130_NAR": "Cereza avait jailli de sa cachette\r\nsans le moindre plan d'action en tête.",
  "BK_4020_0030_CER": "« Oh,\r\ncette fée parle notre langue !\r\n... Enfin je crois. »",
  "LV_004900_0000_CER": "Pas de quoi s'inquiéter... Une feuille\r\naussi grosse ne cèdera pas sous\r\nnotre poids... N'est-ce pas ?",
  "SM_004140_0020_CER": "« Hmm ?\r\nQuoi, qu'est-ce qu'il y a ? »",
  "BK_4000_0020_ROS": "« Cer... Cereza... »",
  "SM_004010_0130_CER": "« Et au cas où c'est pas clair pour\r\ntoi : tu dis que je suis faible, mais\r\nsans moi, tu survis pas non plus,\r\ntu l'as déjà oublié, ça ?",
  "BK_4080_0240_NAR": "Cereza serra Chouchou dans\r\nses bras. Et il lui sembla que\r\nChouchou faisait de même.",
  "SM_004110_0010_MOR": "« Cereza, qu'est-il arrivé\r\nà tes cheveux ?! »",
  "SM_004140_0010_CER": "« Ouille...\r\nC'est quoi son problème, à celui-là ? »",
  "SM_004010_0020_NAR": "L'attaque de Chouchou\r\navait brisé l'illusion,\r\nmais Cereza était\r\nsous le choc.",
  "SM_004070_0100_NAR": "[FONT:9 ]Faire confiance à une fée,\r\njamais ! Je vous dévorerai\r\njusqu'à la dernière ![FONT:N ]",
  "BK_8120_0000_CER": "« C'était le quatrième. On a détruit\r\ntous les noyaux élémentaires ! »",
  "SM_004070_0090_NAR": "Puis elle entendit le profond\r\ngrognement si familier...",
  "SM_004020_0060_NAR": "... Un petit lapin sautilla hors\r\ndes fourrés. Cereza soupira\r\nde soulagement.",
  "SM_004110_0100_CER": "« Oh, je les vaincrai, ça oui.\r\nEt après, je retrouverai Lukaon,\r\nje récupérerai le pouvoir, et je\r\nte renverrai chez toi. »",
  "LV_004010_0003_CER": "Maman !",
  "BK_4020_0040_POO": "« Fui ! Quelle fieffée insolence !\r\nRepentez-vous promptement, car\r\nl'ire d'un roi ne sait être aisément\r\napaisée ! »",
  "LV_004930_0000_CER": "Ah ! Si je ne fais pas attention,\r\nje vais finir grillée à point !",
  "BK_4020_0070_CER": "« Je laisse tomber, ça doit être\r\nune sorte de dialecte féérique.\r\nTu as dit que tu étais le roi des\r\nfées, ou un truc du genre ? »",
  "LV_004060_0000_NAR": "À l'intérieur, un différend semblait\r\navoir éclaté parmi les fées.",
  "BK_4070_0000_NAR": "Chouchou émit un grondement menaçant.",
  "BK_4020_0150_NAR": "Chouchou semblait entièrement d'accord.",
  "SM_004010_0060_NAR": "... Mais ses larmes\r\ncontinuaient à couler.",
  "SM_004140_0050_CER": "« Trop, c'est trop. Cette sale fée\r\nn'a pas intérêt à se retrouver à\r\nnouveau devant moi. \r\n\r\nFini de rire, Chouchounet.\r\n\r\nAllez, en route ! »",
  "SM_004040_0010_CER": "« Dans quoi il s'est encore fourré,\r\ncelui-là... Non, ça me regarde pas ! »",
  "SM_004110_0050_MOR": "« En temps normal, tu aurais eu\r\ndroit à une belle remontrance.\r\nMais cela devra attendre que\r\ntu sois rentrée saine et sauve. »",
  "LV_004935_0000_NAR": "Cette fois-ci, Cereza était seule.\r\nComment allait-elle se sortir de là ?",
  "LV_004065_0000_CER": "Ça en fait, des fées ! Comment je\r\nvais me sortir de là, moi ?",
  "SM_004050_0030_CER": "« Que fait cette fée avec Chouchou ? »",
  "SM_004050_0120_NAR": "L'ouverture était juste assez\r\ngrande pour une apprentie sorcière.",
  "SM_004050_0000_CER": "« À qui il parle, là... ? »",
  "LV_004010_0010_CER": "Attends, maman ! S'il te plaît !",
  "SM_004050_0110_NAR": "Il émit un court hurlement\r\navant de détaler.",
  "SM_004110_0090_MOR": "« Les fées sont de redoutables\r\nennemies. Sers-toi de tout ce que\r\nje t'ai appris pour les vaincre.\r\n\r\nQue la lune éclaire ton chemin.\r\nSois prudente, Cereza. »",
  "SM_004020_0075_CER": "« D'ailleurs, où est ce loup ? »",
  "Pooka_vo_disappear_07": "Tu n'es qu'une sorcière puérile.\r\nComment oses-tu me faire\r\nsouffrir de la sorte ?",
  "LV_004030_0000_NAR": "Cereza était seule face aux fées.\r\nComment allait-elle les vaincre ?",
  "BK_4020_0120_POO": "« Je suis Púca, l'authentique et\r\nlégitime Roi de la forêt d'Avalon ! »",
  "CE_004810_0000_CER": "Il en vient sans cesse !\r\nOn doit éliminer cette fée !",
  "LV_004025_0010_CER": "Si les fées me repèrent, ça ira\r\nmal pour moi. Pas un bruit...",
  "BK_4020_0000_NAR": "Quelque chose les fit s'arrêter.\r\nUne étrange présence...\r\nIls n'étaient pas seuls.",
  "SM_004070_0010_NAR": "Ils avaient enfin trouvé Chouchou.\r\nSon corps entier était couvert\r\nde blessures.",
  "CE_004010_0000_CER": "Cet instrument de torture...\r\nje peux peut-être le réparer\r\navec ma magie restauratrice...",
  "BK_4020_0110_POO": "« Petite pause... pour l'emphase. »",
  "SM_004070_0020_NAR": "Dissimulée dans l'ombre, Cereza\r\nfut surprise de comprendre ce que\r\nl'une des fées disait.",
  "BK_4020_0080_POO": "« Insolents ! Mettez un genou à terre\r\ndevant nous. Ou deux genoux pour\r\nceux qui ont quatre pattes.",
  "BK_4090_0010_CER": "« J'arrive, maman !\r\nNe me laisse plus jamais ! »",
  "LV_004050_0000_CER": "Oh Chouchou, dans quel pétrin\r\ntu t'es encore fourré ?",
  "SM_004010_0100_NAR": "Ne supportant plus les affronts de\r\nChouchou, Cereza bondit sur ses pieds.\r\n\r\nDerrière les larmes, ses yeux\r\nbrûlaient de rage.",
  "LV_004080_0010_CER": "Ça fonctionnerait peut-être\r\nsur autre chose ?",
  "SM_004010_0010_CER": "« Maman ! »",
  "LV_004035_0000_CER": "Si près du but... pas question\r\nd'abandonner maintenant !",
  "BK_4060_0045_POO": "« Longue vie à Púca ! »",
  "LV_004040_0020_CER": "Qu'est-ce que... ?! Ce n'est pas la\r\npremière faille que je vois dans cette\r\nforêt, mais celle-là, elle dépasse tout !",
  "SM_004050_0040_NAR": "Les fées l'emportèrent\r\ndans leur forteresse.",
  "BK_4080_0080_NAR": "Cereza devait suturer la blessure\r\naussi vite que possible.",
  "LV_004085_0010_NAR": "[FONT:10 ]C'était qu'une égratignure.\r\nMais... le nœud est pas mal.[FONT:N ]",
  "LV_004905_0000_CER": "Tu sais nager, Chouchou ?! J-Je\r\npasse mon tour. Je n'ai pas envie\r\nque mes cheveux soient mouillés.",
  "BK_4080_0190_CER": "« J'ai promis de te renvoyer chez toi,\r\nparole de sorcière de l'Umbra. »",
  "SM_004060_0030_NAR": "Et ainsi, Cereza et le loup\r\nblanc s'introduisirent dans\r\nla forteresse ennemie.",
  "BK_4080_0160_NAR": "[FONT:9 ]Viens pas dire que c'est ma faute si ta prof pète un câble.[FONT:N ]\r\nDit Chouchou tout bas.",
  "SM_004080_0010_NAR": "L'apparition soudaine de deux\r\nintrus mit la forteresse des\r\nfées en effervescence.",
  "SM_004090_0020_LUC": "« Ah, la façon dont tu contrôles ce démon \r\nprouve bien ton talent de sorcière. »",
  "LV_004005_0000_CER": "Hm ? Tu as dit quelque chose, Chouchou ?",
  "BK_4080_0110_MOR": "« Tel le sang dans les veines,\r\nla magie coule dans les\r\ncheveux des sorcières. »",
  "CE_004030_0020_CER": "Adieu.",
  "BK_4000_0010_NAR": "Murmurant un enchantement,\r\nles fées passèrent à l'action.",
  "SM_004030_0030_CER": "« Non, je n'ai pas besoin de lui !\r\nJe peux traverser la forêt toute seule ! »",
  "BK_4060_0010_POO": "« Mais quand bien même elles nous consumeraient,\r\nces maraudeurs-là n'iront pas plus loin ! »",
  "BK_4060_0020_CER": "« Mais qu'est-ce qu'il raconte... ?\r\nÇa ne me dit rien qui vaille. »",
  "LV_004070_0010_CER": "Elle jouait les intrépides... mais\r\nje savais qu'elle mourait de peur.",
  "SM_004080_0020_NAR": "Cereza en profita pour libérer\r\nChouchou de ses entraves.",
  "BK_4080_0150_NAR": "La magie des cheveux de Cereza\r\nreferma la blessure en un instant.",
  "SM_004100_0000_CER": "« Ce hurlement...\r\nTu as réussi à sortir de la forteresse ! »",
  "BK_4080_0120_MOR": "« Prends-en soin comme la\r\nprunelle de tes yeux, et\r\nprotège-les de tout ton cœur. »",
  "BK_4080_0040_CER": "« Quelle balafre... ! »",
  "CE_004030_0010_CER": "Fais tes prières !",
  "SM_004070_0050_NAR": "Ils parlaient en énochien, la langue\r\ndes anges et des démons. La fée\r\nroyale semblait tenter de passer\r\nun accord avec Chouchou.",
  "SM_004020_0020_CER": "« Chouchou ? »",
  "SM_004070_0140_CER": "« Écartez-vous ! »",
  "BK_4070_0030_CER": "« C'est bon ! J'en ai marre, c'est fini ! »",
  "BK_4020_0160_POO": "« Une humaine et un démon osent\r\ndéfier Púca, celui dont le nom\r\nsuffit à répandre l'effroi dans les\r\ntrois royaumes ? »",
  "SM_004110_0020_CER": "« P-Pardon. Je... J'ai\r\ndû les utiliser. »",
  "SM_004010_0170_NAR": "Chouchou plissa les yeux.\r\nIl resta un instant immobile.",
  "BK_4080_0200_CER": "« C-Ce que je veux dire, c'est que... »",
  "LV_004015_0010_CER": "Où a filé le loup blanc... ?\r\nSûrement par là.",
  "LV_004950_0000_CER": "Maman... ne me laisse pas !",
  "SM_004040_0020_NAR": "Mais avant même de songer à ce qu'elle\r\nfaisait, Cereza se dirigeait vers lui.",
  "SM_004140_0060_NAR": "Cereza partit en trombe, irritée.\r\n\r\nS'efforçant en vain de se retenir\r\nde rire, Chouchou la suivit.\r\n\r\nMais c'était plus fort que lui, le\r\nmoindre coup d'œil vers elle le\r\nfaisait pouffer incontrôlablement.",
  "SM_004010_0140_NAR": "[FONT:9 ]Tu t'es vue ?! Tu survivrais\r\npas cinq minutes dans cette\r\nforêt sans moi ![FONT:N ]\r\n\r\nLa dispute s'envenimait.",
  "CE_004020_0000_CER": "Maintenant, Chouchou !",
  "BK_4080_0230_CER": "« Bien, Majesté. »",
  "SM_004035_0000_NAR": "Cereza s'en était sortie. Mais seule,\r\nl'aventure s'avérait bien plus difficile\r\nque prévu.",
  "SM_004020_0010_CER": "« Et viens pas miauler chez moi\r\nquand t'auras plus de magie ! »",
  "SM_004070_0060_NAR": "Cereza sentit son cœur\r\nbondir dans sa poitrine.",
  "SM_004140_0030_CER": "« Mais... ?!\r\nOh, mais arrête, hein ! »",
  "SM_004010_0080_CER": "« Comment, Chouchou ? Comment\r\ntu as pu lui faire ça ?! »",
  "LV_004045_0000_CER": "Tu vas où ? Tu connais une\r\nautre entrée ?",
  "LV_004915_0000_NAR": "Chouchou semblait beaucoup\r\ns'amuser à pagayer à tout va\r\navec son nénuphar.",
  "SM_004020_0040_NAR": "Cereza frissonna. Son angoisse\r\nmonta, quand soudain...",
  "BK_4020_0010_POO": "« Halte-là ! Chacun de vos pas impudents\r\nsème la ruine dans notre royaume. Nous\r\nne pouvons vous laisser sortir cet\r\nenfant maudit de son sommeil. »",
  "BK_8120_0010_CER": "« Tu sais ce que ça veut dire :\r\nvoici ton dernier pouvoir\r\nélémentaire. Essaie-le donc ! »",
  "SM_004070_0000_CER": "« Chouchou ! »",
  "SM_004070_0080_NAR": "Le souffle coupé, Cereza\r\nattendit sa réponse.",
  "LV_004030_0010_CER": "Il doit bien y avoir quelque chose\r\nque je puisse utiliser...",
  "SM_004070_0110_NAR": "Chouchou était en piteux état,\r\nmais ses yeux luisaient d'une\r\ndéfiance farouche.",
  "CE_004805_0000_CER": "Ça, c'est fait...\r\nBien, reprenons nos affaires.",
  "SM_004010_0030_NAR": "Elle tomba à genoux, les\r\ncris de sa mère retentissant\r\nencore en elle.",
  "SM_004010_0120_CER": "« Ça m'étonne pas de toi. Comme\r\nsi un démon dans ton genre\r\ncomprenait ce genre de chose ! »",
  "SM_004060_0020_CER": "« Merci... Tu sais, en\r\nfait j'avais un peu peur\r\nd'y aller toute seule. »",
  "LV_004040_0000_NAR": "Une imposante structure métallique\r\nse dressait devant ses yeux. C'était\r\nun fort bâti par les fées.",
  "LV_004055_0010_CER": "Même mon entraînement de sorcière\r\nn'était pas aussi éreintant.",
  "LV_004910_0000_CER": "Ch-Chouchou ! Pas si vite !",
  "LV_004085_0000_CER": "Alors, qu'est-ce que tu en dis ?\r\nJe suis pas si nulle, hein ?",
  "BK_4080_0130_CER": "« Désolée, Morgana, mais j'ai trouvé\r\nquelque chose de plus important. » ",
  "SM_004050_0050_CER": "« Chouchou... »",
  "BK_4080_0020_NAR": "Une grande balafre déchirait la jambe\r\nde Chouchou. Du coton s'en échappait,\r\nainsi que son énergie magique.",
  "BK_4060_0070_NAR": "Une explosion les propulsa en l'air.\r\nEst-ce que leur fin avait sonné ?",
  "CE_004815_0010_CER": "Attrapons-le !",
  "BK_4000_0030_CER": "« Qui est là ? »",
  "BK_4080_0050_NAR": "S'ils ne s'occupaient pas de la blessure,\r\nles fils magiques qui reliaient Chouchou\r\nà ce monde ne tiendraient pas longtemps.",
  "SM_004080_0030_CER": "« Je vois que tu es prêt à en\r\ndécoudre. Tant mieux, ces vilaines\r\nfées méritent une punition. »",
  "SM_004100_0010_NAR": "Cereza soupira de soulagement.\r\nLe loup semblait plus vif que jamais.",
  "LV_004920_0000_CER": "« Chouchou, ralentis ! »",
  "SM_004030_0010_NAR": "Assurément, Cereza était plus forte\r\nqu'à son arrivée dans la forêt.\r\nCependant, se débrouiller seule\r\ndans cette forêt était plus ardu\r\nqu'elle ne l'aurait imaginé.",
  "BK_4060_0030_NAR": "Sentant le danger dans les paroles\r\nde Púca, ils prirent la fuite.",
  "SM_004050_0115_NAR": "Cereza se lança à sa poursuite et\r\nretrouva le loup devant une petite\r\nouverture menant dans la forteresse.",
  "SM_004030_0020_NAR": "Si seulement Chouchou était là...",
  "LV_004940_0000_NAR": "Une étrange structure se détacha dans la\r\npénombre, immense, devant Cereza.",
  "SM_004050_0100_NAR": "L'insaisissable loup blanc\r\napparut juste devant Cereza.",
  "LV_004010_0000_CER": "Maman ? C'est toi ?",
  "BK_4080_0170_CER": "« T'inquiète pas, ils repousseront. »",
  "SM_004080_0000_CER": "« Chouchou ! »",
  "LV_004075_0000_CER": "Chouchou !",
  "IN_4010_0010_NAR": "Cereza et Chouchou étaient réunis !\r\nMais le loup blanc avait à nouveau\r\ndisparu. L'intrépide duo repartit\r\nà l'aventure.",
  "SM_004110_0070_MOR": "« Mon sortilège est presque prêt.\r\nJe pourrai bientôt te faire sortir\r\nde cette forêt. Tiens bon ! »",
  "BK_4080_0220_NAR": "[FONT:9 ]Bon, on bouge, ou quoi ?[FONT:N ]\r\nAjouta-t-il dans un couinement.",
  "BK_4090_0040_NAR": "La silhouette disparut avec\r\nun cri effroyable qui résonna\r\nà travers les arbres.",
  "SM_004110_0080_CER": "« Oh... M-Merci, Morgana. »",
  "SM_004040_0030_CER": "Je veux juste regarder de plus\r\nprès. Je voudrais pas qu'on abîme\r\nma peluche.",
  "BK_4020_0075_CER": "« Alors, tu es le roi des fées ou\r\nun truc du genre, c'est ça ? »",
  "SM_004010_0040_NAR": "Chouchou regarda Cereza avec\r\nmépris. Il lui fit comprendre\r\nqu'elle devait continuer.",
  "SM_004110_0000_NAR": "L'hologramme fantomatique de Morgana\r\napparut.\r\nElle jeta un regard à Cereza et fronça\r\nles sourcils.",
  "LV_004945_0000_CER": "Oups, je ne crois pas que ce soit censé\r\ntourner dans ce sens... Enfin, moi,\r\nça m'est bien égal.",
  "BK_4080_0210_NAR": "Mais avant qu'elle ne puisse\r\nfinir, Chouchou avait repris\r\nsa forme de peluche.",
  "SM_004110_0040_MOR": "« Tu les as utilisés pour un démon ?!\r\nCereza, n'oublie jamais qui est au\r\nservice de qui ! »",
  "SM_004010_0160_CER": "« N'oublie pas qui t'a invoqué !\r\nAlors comporte-toi comme un gentil\r\ndémon, et fais ce que je te dis ! »",
  "SM_004110_0120_CER": "« Allez, on y est presque ! »",
  "SM_004010_0070_NAR": "[FONT:9 ]Ça suffit ! Si je m'étais pas\r\noccupé de l'illusion, t'aurais\r\nfini en bas de la falaise ![FONT:N ]\r\n\r\nLe démon était de plus en\r\nplus irrité.",
  "SM_004090_0010_CER": "« Je n'étais pas toute seule.\r\nSans Chouchou, je ne serais\r\njamais arrivée aussi loin. »",
  "SM_004110_0030_NAR": "Cereza raconta comment elle avait\r\nsauvé Chouchou avec ses cheveux.",
  "BK_4000_0055_ROS": "« Oui, ma douce Cereza.\r\nViens à moi... »",
  "SM_004070_0150_NAR": "Heureusement, le loup blanc\r\ns'était interposé.",
  "SM_004020_0030_NAR": "Pas de réponse."
}
