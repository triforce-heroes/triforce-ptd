{
  "SM_006010_0000_NAR": "Sie hatten es endlich geschafft.\r\nLukaon, der Junge aus Cerezas\r\nTräumen, wartete wie versprochen\r\nauf sie. Doch im Gegensatz zu\r\nseiner Traumweltengestalt wirkte\r\ndieser Lukaon blass und leblos.",
  "BK_8200_0080_NAR": "[FONT:9 ]Und du hattest recht. Allein hätte\r\nich es niemals so weit geschafft.\r\nDanke.[FONT:N ]",
  "SM_006010_0250_LUC": "„Wenn das Siegel erst gebrochen und\r\nmeine Feenkraft wiederhergestellt\r\nwurde, können wir den Wald gemeinsam\r\nverlassen! Dann helfe ich dir, deine\r\nMutter zu retten, also... bitte...“",
  "PH_6010_0010_NAR": "Morgana war es gelungen, die Barriere\r\nzu brechen, die den Wald umschloss.",
  "SM_006010_0190_NAR": "Die aufsässigen Feen konnten somit\r\nLukaon nicht töten, doch fürchteten sie\r\nweiterhin die Rückkehr seines königlichen\r\nBlutes und versiegelten daher seinen\r\nKörper mit einem mächtigen Zauber.",
  "BK_6040_0010_NAR": "Es wirkte beinahe, als hätte sich ganz\r\nAvalons Feenvolk vor Cereza versammelt.\r\nSie spürte, wie sie weiche Knie bekam.\r\nDoch ganz gleich, wie die Chancen auch\r\nstanden, sie weigerte sich aufzugeben.",
  "BK_6020_0130_NAR": "Ehe Púca ausreden konnte, streckte\r\nMorgana ihn blitzartig nieder.",
  "BK_6030_0090_LUC": "„Bitte, Mutter, hör auf.\r\nIch kann es nicht ertragen,\r\ndich so zu sehen.“",
  "BK_6020_0020_CER": "„Cheshire!“",
  "BK_6020_0100_NAR": "Diese Magie war Cereza bekannt.",
  "BK_6020_0090_NAR": "Irgendetwas ließ die Feen wie vom\r\nWind erfasstes Laub davonfliegen.",
  "CE_006805_0000_CER": "Du schaffst es, Cheshire...\r\nGib nicht auf!",
  "BK_8200_0030_CER": "„Unserer... Reise?“",
  "SM_006040_0120_MOR": "„Oh, ich verstehe. Du hast also\r\neinen neuen »Freund« gefunden, hm?“",
  "SM_006010_0120_CER": "„Mensch... und Fee?“",
  "BK_6040_0020_NAR": "Dann plötzlich...",
  "SM_006030_0170_POO": "„Wie es ihnen beliebt! Sterben wird\r\ner in jedem Falle. Und alsbald seine\r\nkönigliche Linie erloschen ist, stellt\r\nUns niemand mehr in den Schatten!“",
  "SM_006010_0360_CER": "„Ich soll Cheshire opfern?\r\nUnmöglich, er ist doch mein Freund!“",
  "CE_006060_0000_CER": "Nichts da!",
  "BK_6000_0040_CER": "„Du willst Cheshire wirklich opfern?\r\nTu das nicht, ich flehe dich an!“",
  "BK_6100_0000_CER": "„Cheshire!“",
  "SM_006030_0060_NAR": "Es war Púca, der selbst ernannte König,\r\ndiesmal offenbar ohne sein übliches\r\nGefolge.\r\nPúcas Kleidung hatte schon bessere\r\nTage gesehen, doch seine Rhetorik\r\nwar noch immer... einzigartig.",
  "LV_006020_0000_CER": "Weiter so, Cheshire! Fast geschafft!",
  "CE_006150_0000_CER": "Ha... Aaah!",
  "BK_6030_0000_CER": "„Morgana... Ich weiß, ich war\r\ndir keine gute Schülerin.“",
  "BK_6000_0030_CER": "„Lukaon, was tust du da?“",
  "BK_6020_0210_CER": "„Morgana?“",
  "SM_006030_0130_CER": "„Nein, Lukaon, nicht!“",
  "SM_006030_0090_POO": "„Geführt von Unsrer Feen Licht, bedarf\r\nes keines weisenden Wolfes mehr. Die\r\nlumpige Bestie mögen sie zurücklassen.“",
  "CE_006050_0000_CER": "Jetzt sind wir dran!",
  "SM_006020_0010_LUC": "„Meine Seele kann diese Gestalt nicht\r\nmehr lange erhalten... Ich wusste,\r\ndies würde meine letzte Chance sein.“",
  "SM_006010_0310_CER": "„Was?!“",
  "CE_006160_0000_CER": "Waaah!",
  "LV_006010_0000_CER": "Sie kommen! Überlass sie mir!",
  "SM_006010_0050_LUC": "„Nein, ich bin hier. Was du in jenem\r\nKristall erblickst, ist leider nichts\r\nweiter als eine leere Hülle...“",
  "SM_006010_0280_CER": "„W-was?\r\nHab ich das?“",
  "SM_006010_0400_CER": "„Ich will dir ja helfen, aber...\r\ndas kann ich einfach nicht tun.“",
  "BK_6020_0170_NAR": "Morgana sagte nichts. Sie streichelte\r\nnur sanft das Fell des Wolfs.",
  "SM_006020_0000_NAR": "Die Wut und Trauer in Lukaons Blick\r\nwaren plötzlich verschwunden.",
  "SM_006010_0380_LUC": "„Sieh ihn doch an! Dämonen sind\r\nhöllische Kreaturen, die sich an\r\nmenschlichen Seelen laben!\r\nIhr Hexen macht euch ihre Kraft\r\nzunutze, ihr gebraucht sie als\r\nWerkzeug, als Waffe, sonst nichts!“",
  "CE_006820_0010_NAR": "[FONT:10 ]Dafür wird er bezahlen. Holen wir\r\nuns zurück, was er gestohlen hat![FONT:N ]",
  "BK_6010_0010_CER": "„Lukaon!“",
  "SM_006040_0080_NAR": "Cereza hatte schon so manche\r\nStrafpredigt von Morgana ertragen\r\nmüssen, doch dies war etwas anderes.\r\nDies waren nicht bloß die Worte\r\neiner strikten Lehrerin, sie waren\r\nvielmehr von purem Hass erfüllt.",
  "BK_8200_0070_CER": "„Cheshire...“",
  "SM_006010_0220_LUC": "„Mir blieb nur noch, durch den Wald zu\r\nstreifen und verzweifelt an der Erinnerung\r\nmeiner menschlichen Seite festzuhalten.\r\n\r\nAber... es gibt einen Weg,\r\ndiesen Fluch zu brechen, Cereza.“",
  "SM_006010_0430_CER": "„Lukaon...“",
  "CE_006090_0000_CER": "Ist das alles?!",
  "BK_6040_0030_CER": "„Cheshire!“",
  "SM_006040_0050_NAR": "Krachender Donner erklang in der Ferne,\r\nbrüllender Wind stieß durch die Bäume\r\nund frostige Kälte lag in der Luft.",
  "BK_8200_0020_NAR": "[FONT:9 ]Ach so. Tja, dann ist das wohl das Ende unserer Reise, hmm?[FONT:N ]\r\nDer Dämon klang enttäuscht.",
  "SM_006030_0140_LUC": "„So ist es am besten, Cereza.\r\nMeine Zeit ist gekommen...“",
  "CE_006810_0000_CER": "Wenn wir zusammenarbeiten,\r\nkann uns niemand aufhalten!",
  "BK_6020_0120_POO": "„Die verhasste Hexe! Uns hätte\r\ngleich klar sein sollen, dass–“",
  "BK_6020_0000_NAR": "Sie entkamen den Klauen der Feen und\r\nschafften es gemeinsam aus dem Wald!",
  "BK_6020_0110_CER": "„Morgana!“",
  "CE_006010_0000_CER": "Cheshire, schneller!",
  "SM_006020_0050_CER": "„Lukaon...“",
  "CE_006120_0000_CER": "Morgana, du wirst nicht aufhören, oder?",
  "SM_006010_0350_LUC": "„...Was soll das heißen? Wieso nicht?“",
  "SM_006010_0090_NAR": "Und es war jener Körper,\r\nmit dem Lukaon sie durch\r\nden Wald geführt hatte.",
  "BK_8200_0090_CER": "„Cheshire,\r\nwarte! Ich habe versprochen, dich\r\nnach Hause zu bringen. Dieses\r\nVersprechen will ich halten!“",
  "SM_006010_0010_CER": "„L-Lukaon?“",
  "IN_6000_0100_MOR": "Diese Geschwindigkeit... U-unmöglich!",
  "SM_006030_0070_CER": "„Auf dein rätselhaftes Gefasel können\r\nwir gerade echt verzichten. Hau ab!“",
  "BK_6000_0050_NAR": "Lukaon hörte die Verzweiflung in Cerezas\r\nStimme und hielt für einen Augenblick\r\ninne. Doch sein Entschluss stand fest.",
  "SM_006010_0110_LUC": "„Es ist wegen meines Blutes.\r\nIch wurde geboren aus der\r\nVereinigung von Mensch und Fee.“",
  "CE_005160_0000_CER": "„Auf geht's, Cheshire!“",
  "SM_006010_0080_LUC": "„Hab keine Angst...\r\nMein Körper wurde zwar versiegelt,\r\ndoch meine Seele nutzt den Körper\r\ndieses Wolfes, um frei zu wandeln.“",
  "SM_006010_0260_CER": "„Eine Kraft, über die nur wir Hexen\r\nverfügen? Sag einfach, was du\r\nbrauchst. Wie kann ich dir helfen?“",
  "BK_8210_0000_NAR": "Freunde beschützen einander.",
  "CE_006000_0010_CER": "Was sollen wir nur tun...?",
  "SM_006030_0040_CER": "„Du!“",
  "BK_6020_0230_MOR": "„Was fällt dir ein...\r\nWie kannst du es wagen, so etwas zu\r\nsagen, nach dem, was du ihm angetan\r\nhast, du törichtes Mädchen!“",
  "BK_6000_0100_CER": "„Ich dachte, wir könnten Freunde sein!“",
  "BK_6030_0050_NAR": "[FONT:9 ]Reiß dich zusammen.\r\nSie ist unser Feind![FONT:N ]\r\nCheshire versuchte, Cereza\r\nwieder auf die Beine zu helfen.",
  "SM_006030_0000_CER": "„Aber natürlich! Wenn wir dich zu\r\nmeiner Lehrerin bringen, wird sie\r\neinen Weg finden, dich zu retten!“",
  "BK_6020_0200_NAR": "In deren Gesicht lag etwas, das\r\nCereza nie erwartet hätte: Ein\r\nAusdruck voller Wärme und Liebe.",
  "BK_6030_0060_NAR": "Morgana würde jeden Moment wieder\r\nangreifen. Aber Cereza konnte\r\nsich einfach nicht bewegen.",
  "SM_006030_0110_NAR": "Als Cereza ihn so sprechen hörte,\r\nwurde ihr alles klar: Púca war es,\r\nder den Feenkönig betrogen hatte.\r\nPúca war schuld daran, dass Lukaons\r\nFamilie zerrissen worden war und Lukaon\r\neinsam im Wald hatte umherirren müssen.",
  "SM_006030_0030_POO": "„Wundervoll!\r\nO welch prächtiger Pathos!“",
  "SM_006020_0020_CER": "„Nein...“",
  "BK_6020_0150_CER": "„Dieser Wolf hier ist in\r\nWahrheit der Geist eines Jungen!",
  "BK_6020_0040_NAR": "Die Feen hatten sie erwischt\r\nund so wurden sie langsam\r\nzurück in den Wald gezerrt.",
  "SM_006040_0010_NAR": "Morgana schien Sekunde um\r\nSekunde zorniger zu werden.\r\nSie trat auf Cereza und Cheshire zu.",
  "BK_8200_0060_NAR": "[FONT:9 ]Ich will mich entschuldigen für\r\ndas, was ich im Wald getan habe.[FONT:N ]",
  "SM_006040_0090_CER": "„Morgana, i-ich...“",
  "SM_006010_0170_NAR": "Doch eine Gruppe bösartiger Feen\r\nverschwor sich gegen ihn. Nachdem\r\nsie den König kaltblütig ermordet\r\nhatten, nahmen sie dessen Frau und\r\nden jungen Lukaon ins Visier.",
  "BK_6010_0000_NAR": "Ohne Cheshires Kraft konnte sich\r\nLukaon kaum noch auf den Beinen\r\nhalten. Und dann...",
  "SM_006040_0060_MOR": "„Unzählige Mädchen habe\r\nich in diesen Wald gelockt...\r\nJedes von ihnen brauchte\r\njahrelanges Training...\r\nUnd alles war umsonst!“",
  "CE_006820_0000_CER": "Cheshire!",
  "SM_006010_0140_NAR": "Und so erzählte der Junge Cereza\r\nvon seiner tragischen Vergangenheit.",
  "CE_006020_0000_CER": "Weich aus, Cheshire!",
  "BK_6020_0160_CER": "Wenn wir nichts unternehmen,\r\nwird er sterben. Bitte, Morgana,\r\nkannst du ihn retten?“",
  "CE_006110_0000_CER": "Hier hast du's zurück!",
  "BK_6000_0060_CER": "„Cheshire!“",
  "SM_006010_0030_LUC": "„Willkommen, Cereza.\r\n\r\nIch wusste, du würdest es schaffen.“",
  "BK_6030_0140_MOR": "„Eine Schande. Du hättest eine\r\ngroße Hexe werden können, Cereza,\r\nhättest du nur deine Gefühle besser\r\nim Zaum gehalten... Doch du warst\r\nschon immer so verdammt weichherzig!“",
  "BK_6030_0020_CER": "„Du warst zwar streng, doch ich wusste\r\nimmer, dass ich dir etwas bedeutete.\r\nDu warst... wie eine Mutter für mich.“",
  "SM_006030_0150_CER": "„Lukaon, du darfst nicht aufgeben!“",
  "BK_6030_0130_NAR": "Mit unveränderter Miene stieß\r\nMorgana ihren Sohn fort.",
  "CE_006815_0000_CER": "Wenn ich das zerstöre...\r\nkann ich Cheshire womöglich befreien!",
  "SM_006030_0160_CER": "„Wir lassen nicht zu, dass du\r\nihn mitnimmst, verstanden?\r\n\r\nUnd übrigens war mir schon klar,\r\ndass du gar kein echter König bist!“",
  "BK_6030_0010_CER": "„Ich habe ständig Fehler gemacht\r\nbeim Training und deine Regeln\r\nmissachtet. I-ich weiß,\r\nich habe dich enttäuscht...“",
  "SM_006020_0040_LUC": "„Cheshire, richtig? Vergib mir,\r\nwas ich beinahe getan hätte. Der\r\neinzig Herzlose hier... war ich.“",
  "BK_6100_0010_CER": "",
  "SM_006010_0340_CER": "„Was... Ich... Das kann ich nicht!“",
  "BK_8210_0030_CER": "„Ich bin eine Umbra-Hexe,\r\ngenau wie meine Mutter.“",
  "BK_8200_0085_NAR": "Die unerwarteten Worte des\r\nDämons rührten Cereza zutiefst.",
  "BK_6040_0000_NAR": "Als Reaktion auf Púcas Kommando\r\nsprang eine erschreckend große\r\nAnzahl Feen aus der Finsternis.",
  "SM_006010_0180_NAR": "Lukaons Mutter gelang es noch,\r\nseine Seele zu retten, doch dann\r\nwurde sie aus dem Feenkönigreich\r\nfür immer und ewig vertrieben.",
  "SM_006010_0100_CER": "„Du wurdest versiegelt? Aber wieso?“",
  "PH_6010_0000_NAR": "Urplötzlich ertönte ein ohrenbetäubender\r\nKnall und ein Blitz erhellte den Himmel.",
  "SM_006010_0240_LUC": "„Oh, Cereza, ich bin so glücklich,\r\ndass du unversehrt zu mir gefunden\r\nhast. Nun flehe ich dich an, mich\r\naus diesem Albtraum zu befreien.“",
  "BK_8200_0010_CER": "„Was soll ich denn tun?! Ich kann\r\ndoch nicht gegen Morgana kämpfen!“",
  "SM_006040_0100_MOR": "„Du nutzloses Mädchen...\r\n\r\nLukaon und ich werden wieder vereint\r\nsein. Du wirst mir diesen elenden\r\nDämon auf der Stelle übergeben.“",
  "CE_006070_0000_CER": "Los, Cheshire!",
  "SM_006010_0270_LUC": "„Ach, Cereza, du hast bereits genau\r\ndas zu mir gebracht, das ich benötige!“",
  "SM_006040_0130_MOR": "„Ein Dämon, geboren unter dem\r\nVollmond eines Schaltjahrs...\r\nDiese Kreatur ist der Schlüssel,\r\num Lukaons Fluch zu brechen!\r\nIch habe so lange darauf gewartet,\r\nCereza... Ich lasse nicht zu,\r\ndass mir die Launen eines\r\nKindes in die Quere kommen!“",
  "SM_006010_0020_NAR": "Als Cereza nach ihm rief,\r\nvernahm sie Lukaons Stimme,\r\nwenn auch nur schwach.",
  "CE_006140_0000_CER": "Lebe wohl, Morgana...",
  "BK_6030_0120_LUC": "„Mutter... Mutter!“",
  "SM_006040_0020_CER": "„Morgana, was sagst du da?\r\nWas ist denn auf einmal los?“",
  "BK_8200_0050_CER": "„Was ist?“",
  "BK_6040_0040_NAR": "Mit dem wimmelnden Feenheer\r\ndicht auf den Fersen preschte\r\nCheshire der Lichtsäule entgegen.",
  "SM_006030_0010_LUC": "„Was?“",
  "CE_006040_0000_CER": "Duck dich!",
  "SM_006010_0060_NAR": "Cereza und Cheshire erschraken.\r\nEs war niemand anderes als der weiße\r\nWolf, der mit Lukaons Stimme sprach.",
  "SM_006010_0230_LUC": "„Dazu bedarf es einer speziellen Kraft,\r\nüber die nur ihr Hexen verfügt.\r\n\r\nUnd so weckte es stets große Hoffnung in\r\nmir, wenn eine Hexe den Wald betrat! Ich\r\ntat alles, sie zu mir zu führen, doch...“",
  "SM_006020_0030_LUC": "„Ich dachte, alle Dämonen\r\nwären herzlose Monster...\r\nDoch ich habe mich geirrt.“",
  "BK_6030_0100_MOR": "„Sorge dich nicht, mein Junge.\r\nBald wird alles wieder so\r\nsein, wie es einst war.“",
  "BK_8210_0040_CER": "„Komm, lasst uns tanzen!“",
  "SM_006010_0210_NAR": "Lukaons Geschichte erinnerte Cereza\r\nan ihre eigene Vergangenheit.\r\nEr tat ihr unbeschreiblich leid.",
  "BK_6000_0010_CER": "„Es muss einen anderen Weg geben.\r\nIch helfe dir, ihn zu finden!“",
  "LV_006005_0000_NAR": "Cheshire rannte wie der Wind.\r\nCereza spürte seine warme Mähne.\r\nNichts konnte sie jetzt noch aufhalten.\r\n",
  "BK_6000_0090_NAR": "Cereza wusste, was sie zu tun hatte.",
  "SM_006030_0080_POO": "„So lassen sie die Querelen! Unsre\r\nUntertanen werden sie mit Freuden\r\nan den Rand des Waldes eskortieren.“",
  "CE_006080_0000_CER": "Zu langsam!",
  "BK_8210_0020_NAR": "Alle Furcht und Zögerlichkeit in\r\nCerezas Augen war einem Ausdruck von\r\nMut und Entschlossenheit gewichen.",
  "_00": "",
  "SM_006030_0050_POO": "„Im Namen von ganz Avalon sei sie\r\nmit Dank überschüttet! Wahrlich,\r\ndie Bäume selbst werden ihren\r\nruhmreichen Taten Balladen widmen.“",
  "CE_006800_0000_CER": "Lukaon! Ich lasse dich\r\nCheshire nicht haben!",
  "BK_6020_0220_MOR": "„Du willst ihn retten?“",
  "CE_006000_0000_CER": "Wir können Morgana nicht entkommen...",
  "BK_8210_0010_NAR": "Freunde halten ihre Versprechen.",
  "SM_006010_0130_LUC": "„Sei unbesorgt.\r\nNicht alle Feen sind wie jene,\r\ndie du getroffen hast. Ich möchte\r\nin Harmonie mit den Menschen leben.\r\nDoch dafür wurde ich mit\r\ndiesem Schicksal gestraft.“",
  "CE_006130_0000_CER": "Aber ich werde auch nicht klein beigeben!",
  "BK_6000_0070_NAR": "Der Feenprinz hatte Cheshire\r\nin seiner Gewalt und saugte\r\nihm die Lebenskraft aus.",
  "BK_6020_0180_NAR": "Verwirrt blickte Cereza\r\nihre Lehrerin an.",
  "LV_006025_0000_CER": "Legt... Legt euch nicht mit einer Hexe an!",
  "BK_6020_0005_NAR": "Zumindest schien es so...",
  "SM_006040_0030_MOR": "„Begreifst du es immer noch nicht?\r\nDas Training, der Armreif...\r\nder Traum?“",
  "SM_006010_0370_LUC": "„Dein Freund? Dieser Dämon?\r\nCereza, was sagst du denn da!“",
  "BK_8200_0000_NAR": "[FONT:9 ]Was ist? Gibst du dich\r\nohne Kampf geschlagen?[FONT:N ]\r\n\r\nCereza hörte Cheshires Stimme\r\nin ihrem Kopf widerhallen.",
  "SM_006040_0000_MOR": "„Cereza... Wieso ist dieser Dämon noch\r\nhier? Hast du nicht den Altar erreicht?\r\n\r\nWas glaubst du wohl war der Zweck\r\nall deines jahrelangen Trainings?!“",
  "SM_006010_0160_NAR": "Jener König wurde von seinen Untertanen\r\ngeliebt und suchte sogar nach Wegen,\r\nim Einklang mit den Menschen zu leben.",
  "LV_006015_0000_CER": "Cheshire, Vorsicht!",
  "SM_006040_0070_MOR": "„Dieses Mal war ich so nahe dran.\r\nDoch du musstest alles ruinieren,\r\ndu selbstsüchtige Göre!“\r\n",
  "BK_6000_0020_LUC": "„Du begreifst es nicht...\r\nDies ist meine letzte Chance!“",
  "SM_006010_0330_LUC": "„Rasch, ich muss die Kraft des Dämons\r\nabsorbieren. Nach so langer Zeit...\r\nwird der Fluch endlich gebrochen!“",
  "SM_006010_0070_CER": "„W-wieso klingt der weiße\r\nWolf wie Lukaon...?“",
  "BK_6020_0050_NAR": "Cereza weigerte sich noch immer\r\naufzugeben und hielt sich mit\r\naller Macht fest. Doch dann...",
  "CE_005140_0000_CER": "„Cheshire, ich bin bei dir, alles ist gut.\r\nEntfessle deine wahre Kraft!“",
  "BK_6020_0140_CER": "„Morgana!\r\n\r\nEs tut mir wirklich leid, dass ich\r\ndir nicht gehorcht habe. Aber bitte\r\nhebe dir die Schelte für später auf.“",
  "SM_006030_0120_LUC": "„Du Monster! Doch genug... Ich werde\r\nnicht mehr davonlaufen, wenn du im\r\nGegenzug diese zwei ziehen lässt.“",
  "SM_006040_0040_MOR": "„Weißt du überhaupt, wie lange\r\nich mich auf die Rückkehr meines\r\ngeliebten Lukaons vorbereit habe?!“",
  "CE_006820_0020_CER": "Okay, auf geht's!",
  "SM_006010_0300_LUC": "„Dieser Dämon ist perfekt. Er ist genau\r\ndas Richtige, um den Fluch zu brechen!“",
  "SM_006010_0150_NAR": "Lukaon war der letzte Feenprinz,\r\nSohn des ehemaligen Feenkönigs\r\nund dessen menschlicher Königin.",
  "BK_6010_0020_NAR": "Ein heroischer Dämon?\r\nVon solch Selbstlosigkeit hatte\r\nman in ganz Inferno noch nicht\r\ngehört. Aber Cereza verstand es.",
  "SM_006010_0290_LUC": "„Ja! Du hast mir das\r\nnötige Opfer gebracht!“",
  "SM_006010_0040_CER": "„Warte, Lukaon.\r\nIch hole dich dort raus!“",
  "BK_8200_0040_NAR": "[FONT:9 ]Wie sonst würdest du diese ganze\r\nAktion zur Rettung deiner Mutter\r\nnennen? Du hast so viel von ihr\r\ngeredet, langsam hab ich selbst\r\ngehofft, sie treffen zu können...[FONT:N ]\r\nCheshire hielt inne.",
  "SM_006010_0410_LUC": "„Ich fasse es nicht...“",
  "SM_006030_0020_CER": "„Es ist noch nicht zu spät.\r\nKomm, wir müssen dich zu ihr bringen.\r\n\r\nIch lasse dich hier nicht sterben, Lukaon!“",
  "BK_6030_0030_MOR": "„Verschwinde!“",
  "SM_006030_0180_POO": "„O Feenbrüder, das verwünschte Kind ist\r\nzum Greifen nahe! Die Sonne des falschen\r\nKönigs erreicht ihren Tiefpunkt und fortan\r\nwird Púcas Stern hell am Himmel erstrahlen!“",
  "BK_6000_0080_CER": "„Und ich habe dir vertraut!“",
  "SM_006010_0390_CER": "„Du irrst dich. Cheshire ist kein\r\nWerkzeug. Er ist ein Lebewesen mit\r\neigenen Gedanken und Träumen! Wir\r\nhaben es nur so weit geschafft, weil\r\nwir zusammengehalten haben. Ich lasse\r\nnicht zu, dass er geopfert wird!“",
  "BK_6010_0030_LUC": "„Ihr zwei...“",
  "BK_6000_0000_NAR": "Lukaons Gesicht, das Cereza eben\r\nnoch so hoffnungsvoll angeblickt\r\nhatte, verfinsterte sich vor Trauer.\r\nSie wollte ihm so gerne helfen...",
  "SM_006010_0200_CER": "„Deine Eltern... Lukaon,\r\ndu hast so viel durchgemacht.“",
  "SM_006010_0320_NAR": "Cereza konnte nicht glauben, was sie\r\nda hörte. Sie sollte Cheshire opfern?",
  "CE_006030_0000_CER": "Spring!",
  "SM_006030_0100_NAR": "Púca hatte es auf die königliche Macht\r\nabgesehen, die Lukaons Seele innewohnte.",
  "SM_006010_0420_LUC": "„Verzeih mir, Cereza,\r\ndoch du lässt mir keine Wahl.“",
  "BK_6030_0070_NAR": "Dann plötzlich geschah etwas,\r\ndas Morgana dazu brachte innezuhalten.\r\nMit letzter Kraft klammerte\r\nLukaon sich an ihr Gewand.",
  "CE_006100_0000_CER": "Wie ist das?",
  "BK_6030_0021_CER": "„Ich wollte nur, dass\r\ndu stolz auf mich bist!“"
}
