{
  "SM_002100_0150_COL": "「謝謝你！」",
  "BK_2000_0060_CER": "「我可不能害怕。\r\n我要成為強大的魔女……！」",
  "LV_002905_0000_NAR": "「我感受到了一股莫名的強大力量……」\r\n小柴貓感覺到了什麼。",
  "SM_002100_0040_NAR": "瑟蕾莎回過神來，\r\n才發現自己把心聲說出口了。",
  "SM_002140_0050_FAS": "「向你正式自我介紹。\r\n我是這座森林的嚮導——伊古妮絲。」",
  "SM_002060_0030_CER": "「小柴貓別這樣，\r\n柯爾姆會害怕的。\r\n不可以嚇祂。」\r\n",
  "LV_002035_0120_CER": "怎樣這樣，我也有在用元素之力好不好。\r\n少自以為了不起！",
  "CE_002815_0000_CER": "看招看招看招看招——！",
  "SM_002140_0060_FAS": "「你們能通過那個馬戲團真是不簡單。\r\n我果然沒有看走眼。」",
  "SM_002060_0000_COL": "「這裡是我們的秘密基地。\r\n本來應該要對外人保密的，\r\n但姐姐是例外。」",
  "BK_2000_0050_CER": "「我、我也可以戰鬥！\r\n不要小看我！」",
  "LV_002035_0015_NAR": "小柴貓發出不悅的低鳴。",
  "SM_002130_0135_CER": "「不過，你為什麼會那樣說？」",
  "LV_002900_0000_CER": "那個小丑帽是怎樣啊？\r\n一直來礙事！",
  "SM_002010_0100_COL": "「雖然想去救被擄走的同伴，\r\n但光靠我一個實在是無能為力……」",
  "SM_002010_0180_NAR": "小柴貓很生氣，\r\n於是別過頭不再理她。\r\n\r\n即使如此，瑟蕾莎還是無法\r\n放著柯爾姆不管。",
  "SM_002010_0010_NAR": "瑟蕾莎想起了摩根娜說過的話。\r\n\r\n筋疲力竭而死的人類會變成「人魂」，\r\n在森林裡徘徊……",
  "CE_002070_0000_CER": "來吧，壓軸好戲上場了！",
  "LV_002080_0020_NAR": "瑟蕾莎忍不住哈欠連連。\r\n她的身體已經非常疲憊了。",
  "SM_002140_0100_NAR": "知道對方是人魂之後，\r\n瑟蕾莎說起話來就比較沒顧慮了。",
  "SM_002130_0150_FAS": "「那裡有個瘋狂的團長，\r\n到現在仍在獨自舉行公演，\r\n一旦被他發現就完了。\r\n\r\n到死為止\r\n都得一直在馬戲團配合祂。」",
  "SM_002040_0050_CER": "「可是大家都非常開心啊。\r\n\r\n這樣一來，柯爾姆和那些孩子們\r\n又能一起生活了。」",
  "SM_002140_0010_CER": "「那、那個聲音是！」",
  "SM_002140_0210_FAS": "「怎麼了嗎？」",
  "SM_002110_0090_CER": "「頭髮對魔女而言很重要好不好？\r\n拜託你也多少顧慮一下！」",
  "_05": "",
  "SM_002130_0120_FAS": "「但是，你應該無法輕易接近\r\n下一個元素核心的所在地。」",
  "LV_002930_0000_CER": "迷迭香？原來如此，畢竟是除魔的花。\r\n你就不用勉強過來了。",
  "SM_002140_0045_CER": "「那個聲音的主人就是你嗎？」",
  "CE_002040_0000_CER": "咦？\r\n開關反轉，不能壓了？",
  "SM_002130_0080_FAS": "「你在找的是白狼吧？」",
  "_01": "",
  "SM_002130_0110_FAS": "「小姑娘你正走在\r\n通往目的地的正確道路上。」",
  "SM_002040_0180_CER": "「要是我夠強大，\r\n當時就能把媽咪……」\r\n",
  "SM_002040_0100_NAR": "說到一半，\r\n瑟蕾莎突然驚覺。",
  "IN_2000_0010_NAR": "瑟蕾莎壞心眼地說，\r\n但小柴貓卻一副事不關己的樣子。",
  "LV_002070_0010_NAR": "開心的瑟蕾莎情不自禁地大喊。\r\n她還只是個孩子。",
  "SM_002140_0180_FAS": "「哈哈，這個你不用擔心。\r\n只要把湖水抽乾就好。」",
  "_54": "",
  "LV_002005_0030_NAR": "「看起來真好吃，我來把它吃掉吧。」",
  "SM_002100_0110_COL": "「那我想再拜託你\r\n最後一件事，可以嗎？」",
  "SM_002080_0010_CER": "「怎麼樣啊？ 小柴貓。\r\n只要我有心還是能辦到的吧？」\r\n",
  "SM_002050_0000_COL": "「謝謝你，姐姐！」",
  "SM_002140_0220_CER": "「沒有，沒事，什麼事也沒有。\r\n高的地方……我也一樣不怕。\r\n謝謝你告訴我這麼多！」",
  "LV_002010_0010_CER": "妖精在欺負人魂……\r\n但我一個人根本無能為力……",
  "SM_002100_0120_COL": "「如果你又在森林裡\r\n看見我的同伴們被妖精抓住，\r\n我希望你能像剛才一樣伸出援手。」",
  "IN_2000_0020_NAR": "「我只是把靠過來的礙事傢伙收拾掉而已。",
  "CE_002080_0000_CER": "唔……！\r\n嗯……唔……嗚……！",
  "SM_002130_0160_CER": "「到死為止……」",
  "SM_002080_0040_NAR": "瑟蕾莎對小柴貓瞧不起人的態度\r\n越來越不滿了。",
  "LV_002035_0115_NAR": "小柴貓嘲諷地笑了。",
  "LV_002040_0030_CER": "我也好想跟媽咪一起玩……",
  "BK_2000_0040_NAR": "「礙事，退到後面去！」\r\n小柴貓對著\r\n嚇到不知所措的瑟蕾莎大喊。",
  "SM_002060_0090_COL": "「至於姐姐，就送你這個吧。\r\n據說裡頭蘊藏著不可思議的力量，\r\n說不定能派上用場。」",
  "CE_002800_0000_CER": "那個踩球的傢伙真棘手！\r\n把祂拉下來吧！",
  "SM_002060_0100_CER": "「謝謝你！」",
  "IN_2000_0040_CER": "是喔！",
  "SM_002130_0010_CER": "「是、是誰！？」",
  "CE_002000_0000_CER": "你給我下來！",
  "SM_002060_0130_COL": "「嗯！有其他困擾的話儘管跟我說。」",
  "LV_002035_0020_CER": "你不也想去森林的深處嗎？\r\n那就不要抱怨了。",
  "SM_002130_0210_FAS": "「那麼，我就先告辭了。\r\n祝小姑娘你們一路平安。」",
  "SM_002100_0050_CER": "「白狼！？」",
  "LV_002055_0010_NAR": "成功幫助人魂\r\n讓瑟蕾莎的心裡好過了一些。",
  "LV_002905_0010_CER": "元素核心就在附近。\r\n我想一定是在前方的馬戲團帳篷裡。",
  "LV_002090_0010_CER": "那個是……什麼？",
  "BK_2010_0040_LUC": "「別哭……」",
  "SM_002010_0030_COL": "「姐姐，你是誰？迷路了嗎？」",
  "SM_002040_0040_NAR": "「幫助那種東西有什麼意義？」\r\n小柴貓傻眼地說。\r\n",
  "SM_002110_0070_CER": "「討厭，小柴貓是大笨蛋！\r\n害我的頭髮變得黏呼呼的！」",
  "SM_002010_0000_CER": "「那個……難道是人魂？」",
  "SM_002130_0060_FAS": "「你可以問我任何問題來當作測試。\r\n不管是什麼我都會為你解答。」",
  "SM_002140_0030_NAR": "瑟蕾莎望過去，\r\n站在那裡的是一個有點奇怪的人魂，\r\n帽簷遮住了祂的面孔。",
  "SM_002040_0070_NAR": "「別人怎樣都跟我無關。」\r\n小柴貓冷漠地回嘴。",
  "SM_002140_0120_CER": "「別說這個了……\r\n你說你叫伊古妮絲對吧？」",
  "SM_002010_0190_CER": "「總而言之，我已經決定要去了！」\r\n",
  "LV_002915_0000_CER": "真好玩——！\r\n這個會延伸到哪裡呢？",
  "LV_002050_0010_CER": "我得小心前進，不要被發現了……",
  "SM_002130_0180_FAS": "「但是別擔心，小姑娘和那邊的惡魔。\r\n以你們的程度是不會任祂宰割的。」",
  "SM_002140_0150_CER": "「湖底……！？」",
  "SM_002040_0110_CER": "「對耶。\r\n是我把你召喚到這裡來的。」",
  "SM_002040_0190_NAR": "瑟蕾莎喃喃自語，腦海中浮現了\r\n當時沒能拯救的母親身影。\r\n",
  "SM_002010_0160_NAR": "雙方展開激烈的爭執，\r\n他們互相瞪視著，\r\n一步也不肯退讓。",
  "SM_002010_0070_CER": "「柯爾姆，\r\n你看起來非常寂寞……\r\n發生什麼事了？」",
  "SM_002040_0080_CER": "「說那什麼話？\r\n難道你忍心對祂們置之不理嗎？」\r\n",
  "LV_002925_0000_CER": "咦！？\r\n我們……互換了嗎！？",
  "SM_002020_0080_NAR": "「你這種膽小鬼能做什麼啊？」\r\n小柴貓嗤之以鼻。\r\n\r\n",
  "SM_002020_0000_CER": "「小柴貓！？」",
  "SM_002140_0160_CER": "「那、那真是太好了。\r\n沉入水中可是我的強項。」",
  "SM_002110_0080_NAR": "瑟蕾莎急忙擦拭頭髮，\r\n小柴貓瞥了她一眼，佯裝不知。",
  "SM_002010_0040_CER": "「原來你會說話啊！？」",
  "SM_002060_0050_NAR": "「比起這個，有什麼事快點說。」\r\n一心想趕路的小柴貓\r\n瞪了柯爾姆一眼。\r\n\r\n",
  "LV_002005_0010_CER": "那個是什麼？",
  "SM_002050_0010_NAR": "徹底恢復精神的柯爾姆說，\r\n想送他們東西\r\n作為拯救同伴們的謝禮。",
  "SM_002080_0000_NAR": "瑟蕾莎他們成功擊退了難纏的妖精。\r\n雖然跟之前的戰鬥比起來並不明顯，\r\n但瑟蕾莎感覺到自己的成長。",
  "BK_8100_0010_CER": "「我知道啦。\r\n先來試試看這是\r\n什麼樣的力量吧。」",
  "CE_002030_0000_CER": "平台前面的開關好可疑。",
  "CE_002100_0000_CER": "小柴貓……救救我！！",
  "SM_002130_0050_CER": "「要我相信你……說是這麼說……」",
  "SM_002140_0080_FAS": "「可憐啊。」",
  "IN_2000_0000_CER": "什麼嘛，結果你還不是幫忙了。\r\n",
  "SM_002010_0080_COL": "「我的同伴……\r\n被妖精帶走了……」",
  "SM_002130_0170_FAS": "「哎呀……\r\n我是不是嚇到你了？」",
  "SM_002010_0110_CER": "「好吧。我們來幫你。」\r\n",
  "LV_002095_0010_CER": "我有看過這種街頭表演。\r\n沒想到會輪到自己上場……！",
  "SM_002010_0044_CER": "「我叫瑟蕾莎。你呢？」",
  "SM_002140_0230_FAS": "「不客氣。」",
  "SM_002020_0040_NAR": "「你死掉的話我也會跟著死，\r\n所以我才只好跟上來。」\r\n\r\n祂的表情彷彿在那樣說著。",
  "SM_002120_0000_NAR": "「你不能再跑快一點嗎？」\r\n瑟蕾莎無法追上狼的腳步，\r\n令小柴貓感到很煩躁。",
  "LV_002030_0020_CER": "只要運用那股力量，\r\n說不定就能通過之前過不去的地方了！",
  "CE_002805_0000_CER": "討厭，祂一下子就躲開了！\r\n怎麼樣才能用大炮擊中呢……！？",
  "LV_002030_0010_CER": "剛才得到的力量……",
  "SM_002010_0120_COL": "「真的嗎！？」",
  "SM_002040_0150_NAR": "「就算剛出生，\r\n我也比你強很多。」\r\n小柴貓沒等瑟蕾莎說完，\r\n就嘲諷地笑了。",
  "SM_002140_0110_NAR": "但是小柴貓卻始終沉默，一句話也不說。\r\n似乎對人魂完全不感興趣。",
  "LV_002080_0030_NAR": "瑟蕾莎決定在這裡稍微休息一下。",
  "SM_002130_0140_FAS": "「這條路的前方，\r\n有一個老舊的馬戲團帳篷，\r\n是以前妖精把人類小孩\r\n誘騙到森林裡時所使用的。」",
  "SM_002130_0090_CER": "「你、你怎麼知道？」",
  "LV_002910_0000_CER": "等等，那是什麼聲音！？\r\n往這邊過來了！",
  "SM_002100_0140_CER": "「只要是我力所能及的事，我一定會幫！」",
  "SM_002100_0060_NAR": "看見狼跑遠的身影，\r\n瑟蕾莎猛地起身。",
  "LV_002055_0020_CER": "妖精們的所作所為實在太過分了。\r\n我一定要把人魂全部救出來！",
  "CE_002060_0000_CER": "拉桿會跟著開關一起動呢。",
  "SM_002100_0170_COL": "「姐姐、貓咪，下次再見——！」",
  "LV_002090_0020_NAR": "遠處可以看見一個像大型帳篷的建築物。\r\n聳立的血紅建築彷彿在邀請瑟蕾莎前往。",
  "SM_002140_0070_FAS": "「團長那傢伙，\r\n再也無法享受高空鞦韆了。」",
  "SM_002060_0010_COL": "「咦？剛才跟你在一起的貓咪呢？」",
  "SM_002130_0020_NAR": "突然被搭話，\r\n瑟蕾莎嚇得心臟縮了起來。",
  "SM_002130_0130_CER": "「你連元素核心的事都知道嗎！？」",
  "LV_002035_0010_NAR": "「我的舌頭是用來品嚐獵物的。\r\n到底還得做這種事到什麼時候？」",
  "SM_002100_0100_CER": "「嗯，要趕緊追上去。」",
  "LV_002005_0020_NAR": "瑟蕾莎發現了像是水果的東西。",
  "SM_002140_0200_CER": "「最高處……」",
  "SM_002080_0030_CER": "「哼，小柴貓是大壞蛋！」",
  "SM_002100_0090_COL": "「姐姐，\r\n你們要走了嗎？」",
  "SM_002100_0010_NAR": "從夢中醒來的瑟蕾莎，\r\n不斷在心裡回想少年所說的話。",
  "SM_002050_0020_COL": "「跟我來！」",
  "SM_002140_0190_FAS": "「不過，\r\n在那之前必須先越過巨樹。\r\n\r\n想抵達深邃的湖底，\r\n就得先登上這座森林的最高處。\r\n不覺得富有哲理嗎？」",
  "LV_002920_0000_CER": "往這邊過來了……！？\r\n那、那是什麼啊！？",
  "LV_002065_0010_CER": "柯爾姆，你明明很嬌小，\r\n走起路來卻很迅速呢。",
  "SM_002140_0000_FAS": "「馬戲團好玩嗎？」",
  "SM_002030_0010_NAR": "瑟蕾莎壞心眼地說，\r\n但小柴貓卻一副事不關己的樣子。",
  "SM_002060_0060_COL": "「真是隻性急的貓咪。\r\n要送給貓咪的禮物是那個！」",
  "CE_002050_0000_CER": "這根拉桿是做什麼的？",
  "SM_002060_0140_NAR": "語畢，柯爾姆\r\n就跑去找祂的同伴們了。",
  "SM_002030_0020_NAR": "「我只是把靠過來的礙事傢伙收拾掉而已。\r\n我跟你不一樣，我很強。」\r\n\r\n一說完，\r\n小柴貓又嘲諷般地哼了一聲。",
  "IN_2000_0030_NAR": "我跟你不一樣，我很強。」\r\n一說完，小柴貓又嘲諷般地哼了一聲。",
  "SM_002100_0130_COL": "「我會好好答謝你的！」\r\n",
  "SM_002100_0020_NAR": "他的話\r\n像是一盞點在瑟蕾莎胸口的明燈，\r\n讓她覺得心裡暖呼呼的。\r\n",
  "SM_002130_0220_NAR": "語畢，\r\n周遭就再度回歸了寧靜。",
  "SM_002120_0040_NAR": "小柴貓什麼也沒回答，\r\n只是一臉不高興地瞪著瑟蕾莎。",
  "_71": "",
  "SM_002040_0120_NAR": "「我才剛出生而已。\r\n沒什麼珍惜的事物，也不想擁有。」\r\n小柴貓一臉事不關己地回答。\r\n",
  "SM_002110_0110_CER": "「少、少囉嗦。\r\n我很快就會用順手了！」",
  "SM_002010_0150_CER": "「你的意思是叫我別管嗎！？」",
  "BK_2010_0020_CER": "「我好想你……我好想你喔，媽咪……」",
  "CE_002035_0000_CER": "踩踏之後聚光燈就會照亮平台。",
  "SM_002130_0100_FAS": "「如今小姑娘你也算是森林的一部分了。\r\n所以，你的想法我也一清二楚。」",
  "BK_2010_0010_CER": "「為什麼門就是打不開……？」",
  "SM_002040_0000_CER": "「幸好大家都沒事。\r\n雖、雖然敵人有點不好對付。」",
  "SM_002140_0040_CER": "「人魂……？」",
  "CE_002090_0000_CER": "動、動彈……不得……！",
  "SM_002020_0030_NAR": "其實瑟蕾莎有點開心，\r\n但小柴貓一語不發，看起來不太高興。",
  "SM_002010_0020_CER": "「你怎麼了……？發生什麼事了嗎？」",
  "SM_002140_0090_CER": "「那傢伙真的很粗暴耶。\r\n我最討厭人家強迫我做事了！」",
  "SM_002130_0040_FAS": "「至少我並不是妖精。\r\n你可以儘管相信我。」",
  "LV_002025_0010_CER": "我還是無法丟下那個人魂不管！",
  "CE_002810_0000_CER": "你的秀我已經看膩了！\r\n小柴貓！",
  "SM_002120_0020_CER": "對了小柴貓，\r\n可以讓我坐在你的背上嗎？\r\n這樣的話馬上就能追上了！",
  "SM_002020_0060_CER": "「就算你不幫我，\r\n我也會靠自己救出那些人魂！」",
  "SM_002130_0240_CER": "「那個人到底是誰……？」",
  "CE_002010_0000_CER": "現在正是大好機會！",
  "SM_002120_0010_CER": "我已經盡全力跑了！",
  "SM_002020_0050_CER": "「哼。」",
  "LV_002080_0010_CER": "哈啊——",
  "SM_002140_0130_CER": "「伊古妮絲。如果是你的話，\r\n應該會知道其他元素核心的\r\n所在位置……吧？」",
  "SM_002040_0170_CER": "「我、我很快就能變強了。\r\n因為我跟野蠻的惡魔不一樣！」\r\n",
  "LV_002045_0010_NAR": "必須放下那座吊橋，否則就進不去了。",
  "SM_002140_0020_NAR": "某處傳來了\r\n曾經聽過的聲音。",
  "SM_002010_0090_NAR": "柯爾姆的聲音聽起來好像快要哭了。\r\n\r\n據祂所說，\r\n妖精們最喜歡玩弄人魂，\r\n甚至有同伴從此一去不回。",
  "SM_002060_0110_COL": "「姐姐，你應該累了吧？\r\n這裡很安全，可以稍微休息一下。」\r\n",
  "SM_002060_0080_CER": "「祂嘴上那樣說，\r\n其實心裡是很高興的。」",
  "LV_002035_0110_NAR": "「哼，要不是有我出力，\r\n你根本什麼也辦不到。」",
  "BK_2010_0060_LUC": "「你一定能再次見到母親的……\r\n我也一樣——」",
  "LV_002085_0020_NAR": "雖然和人魂們一起玩很開心，\r\n但瑟蕾莎還有非做不可的事。",
  "LV_002040_0020_CER": "還是說，曾經有人住在這裡呢……？",
  "SM_002100_0160_NAR": "於是瑟蕾莎他們\r\n和柯爾姆道別後，\r\n便出發去尋找白狼了。",
  "SM_002100_0070_CER": "「小柴貓，你已經休息夠了吧？」",
  "LV_002040_0010_CER": "這裡是什麼地方？\r\n是妖精們的遊樂場嗎……？",
  "BK_2010_0050_LUC": "「你擁有強大的力量……\r\n以及渴望守護摯愛親人的堅強意志……\r\n所以，不要緊的……」",
  "LV_002085_0010_NAR": "瑟蕾莎再次往森林深處前進。",
  "SM_002130_0200_FAS": "「這就足以看出祂們對你們的畏懼。\r\n尤其是對那個惡魔……」",
  "CE_002000_0010_CER": "別老是逃去小柴貓搆不到的地方！",
  "SM_002060_0120_CER": "「經你這麼一說……\r\n我來到這座森林後就沒放鬆過了，\r\n那就休息一下吧。\r\n\r\n柯爾姆，謝謝你為我們做了這麼多。」",
  "SM_002140_0140_FAS": "「那當然。\r\n下一個元素核心就沉睡在湖底。」",
  "SM_002100_0030_CER": "什麼時候\r\n才能再夢見他呢……",
  "SM_002060_0040_NAR": "「我對這種看起來難吃的傢伙沒興趣。」\r\n小柴貓一臉事不關己地說。",
  "SM_002130_0070_CER": "「咦？\r\n嗯……那你知不知道，\r\n白……黑狼往哪邊走了？」",
  "SM_002030_0030_CER": "「是喔！」",
  "LV_002065_0110_CER": "在遇見你之前，\r\n我從沒想過人魂真的存在。",
  "SM_002030_0000_CER": "「什麼嘛，結果你還不是幫忙了。」\r\n",
  "SM_002060_0070_NAR": "「什麼嘛，就這樣喔。」\r\n小柴貓一臉不高興地說，\r\n但依舊快步跑了過去。\r\n",
  "LV_002935_0000_CER": "嘿嘿！\r\n怎麼樣？只靠我一個人就救了大家唷？",
  "SM_002080_0020_NAR": "然而，小柴貓卻一臉不以為然。",
  "SM_002100_0000_CER": "「『我也一樣』……？」",
  "BK_8100_0000_CER": "「又跟那時候一樣了……」",
  "BK_2000_0020_NAR": "妖精突然襲擊了過來。\r\n瑟蕾莎果然\r\n又怕到動彈不得了。\r\n",
  "SM_002020_0020_CER": "「看吧……你終究還是跟上來了。\r\n畢竟你沒辦法跟我分開。\r\n\r\n所以你願意幫忙了嗎？」",
  "SM_002040_0090_CER": "「你應該也能體會\r\n與重要的人分開的痛苦……」",
  "SM_002130_0000_FAS": "「喂，那邊的小姑娘。」",
  "SM_002040_0010_NAR": "瑟蕾莎表面上逞強，\r\n其實心裡對一味受到小柴貓\r\n幫助的自己感到很失望。",
  "SM_002010_0060_COL": "「我叫柯爾姆。」",
  "SM_002130_0190_FAS": "「事實上，\r\n自從你們踏進森林，\r\n妖精們就亂成一團了。」",
  "LV_002015_0010_CER": "小柴貓，前面有人魂被欺負了！\r\n我們去救祂！",
  "SM_002040_0020_NAR": "而另一方面，\r\n小柴貓則是興味索然地\r\n望著高興的人魂們。",
  "SM_002130_0030_FAS": "「這個嘛……\r\n應該可以說是\r\n『最了解這座森林的人』吧。」",
  "SM_002010_0140_NAR": "小柴貓懷疑自己聽錯了，\r\n祂立刻反駁瑟蕾莎。",
  "CE_002020_0000_CER": "休想逃！",
  "SM_002110_0100_NAR": "「明明就不會善加利用，\r\n保養倒是做得很勤快。」\r\n小柴貓嘲諷地笑。",
  "SM_002140_0170_CER": "「只可惜我不擅長浮起來……」",
  "SM_002040_0130_CER": "「原來你才剛出生嗎……？\r\n那樣的話，你不就……」\r\n",
  "SM_002020_0090_NAR": "不過，\r\n瑟蕾莎選擇裝作沒聽到。",
  "SM_002120_0050_CER": "我就知道不行。小氣鬼！",
  "SM_002130_0230_CER": "「消失了……」"
}
