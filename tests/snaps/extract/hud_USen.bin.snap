{
  "HUD_PURPOSE_TXT_6020": "Stop Lukaon.",
  "HUD_INTERACT_TEXT_0036_CER": "Hmm...it's too dark to read now.",
  "HUD_NOTICE_TXT_04": "New Wisp Added!",
  "HUD_PURPOSE_TXT_4010": "Head to the \r\nfaeries' fortress.",
  "HUD_INTERACT_TEXT_0039_CER": "No more Mandragora...right? \r\nGot to keep an eye out, \r\nthey grow back so quickly...",
  "HUD_GAMEOVER_TXT_0007": "Cereza's dreams came to an end\r\nat the hands of the faeries.\r\nThe white wolf's remains lay near her, \r\nas if wanting to be at her side.",
  "HUD_INTERACT_TEXT_0009_CER": "Oh, what a cute little fishy!\r\nI hope you grow up big and strong!",
  "HUD_GAMEOVER_TXT_0003": "Captured by the faeries, Cereza was\r\nsealed away at the top of Faerieland\r\nTower, her crystal coffin slowly\r\nworn down by the wind and rain.",
  "HUD_GAMEOVER_TXT_0010": "The faeries' malicious laughter filled the area\r\nas Cereza and Cheshire were ejected from\r\nthe Tír na nÓg by a mysterious force.",
  "HUD_PURPOSE_TXT_1030": "Hurry ahead.",
  "HUD_PURPOSE_TXT_1130": "Proceed through \r\nthe forest together.",
  "HUD_INTERACT_TEXT_0013_CER": "I'd better be sure to refill the lamp oil\r\nonce I'm back from the forest.",
  "HUD_INTERACT_TEXT_0301_CER": "A faerie automaton...made of metal?\r\nDo they use this in the circus too...?",
  "HUD_INTERACT_TEXT_0006_CER": "This jug is positively ancient.\r\nA new, lighter one would be nice.",
  "HUD_PREVENT_TEXT_0005_CER": "I, I can handle this! Come on Cereza!",
  "HUD_INTERACT_TEXT_0402_CER": "Well...This spinny-thing \r\nseems to be broken, too bad.",
  "HUD_INTERACT_TEXT_0404_CER": "All the trees are dried and dead...\r\nIt must be the faeries' work, I'm sure of it.",
  "HUD_PREVENT_TEXT_0003_CER": "Faeries...I'd get caught in an instant if I went that way.",
  "HUD_PURPOSE_TXT_1091": "Head up to the training ground.",
  "HUD_INTERACT_TEXT_0000_CER": "It's Morgana's house.\r\n...If I go back now, she'll be mad.",
  "HUD_PURPOSE_TXT_7000": "Bind and defeat all enemies!",
  "HUD_INTERACT_TEXT_0307_CER": "Oh no, is this a dead end...?\r\nI've got to do something, or else...",
  "HUD_ITEMOBTAIN_TEXT_006": "A compound sealed in crystal.\r\nBreaks out into a screaming fit\r\nover every little thing: best \r\nto pack it deep in your rucksack.",
  "HUD_PURPOSE_TXT_5030": "Proceed through \r\nthe Overgrown Shrine.",
  "HUD_ITEMOBTAIN_TEXT_002": "Magical energy, crystallised by Avalon.\r\nOne bite sends a rush of rich\r\nsweetness from head to toe,\r\ninstantly enrapturing anyone.",
  "HUD_ITEMOBTAIN_TEXT_011": "An Umbran potion in a thorn-laced bottle.\r\nUse it to create a shockwave, \r\nstunning all nearby enemies.\r\n*You can now concoct more on your own!",
  "HUD_ITEMOBTAIN_TEXT_102": "A large, flower shaped jewel formed\r\nfrom Vitality Petals. Said to be resilient\r\nto any and all force, those who acquire\r\nit are promised long-lasting life.",
  "HUD_PURPOSE_TXT_7004": "Defeat all the barriered enemies!",
  "HUD_PURPOSE_TXT_2020": "Find a way into \r\nFaerieland Tower.",
  "HUD_PURPOSE_TXT_1195": "Head to the circus tent.",
  "HUD_INTERACT_TEXT_0030_CER": "I can't be going to the house now! \r\nIt's time for training! I've been waiting for this!",
  "HUD_PURPOSE_TXT_1081": "Catch the runaway herb \r\nwith Thorn Bind.",
  "HUD_ITEMOBTAIN_TEXT_005": "A round jewel possessing the power of the moon,\r\nthe source of every witch's strength. Enhances\r\nthe abilities of any witch who finds it.\r\n*Allows Cereza to unlock powerful skills.",
  "HUD_INTERACT_TEXT_0101_CER": "Mmm, the air tastes fantastic!\r\nI should be able to relax here.",
  "HUD_PURPOSE_TXT_5020": "Follow the white wolf \r\nto Lukaon.",
  "HUD_GAMEOVER_TXT_0008": "The wisps still cry out for help, but\r\nwith Cereza fallen, there is no one\r\nleft to extend a hand.",
  "HUD_PURPOSE_TXT_7003": "Avoid the curses and defeat all enemies!",
  "HUD_INTERACT_TEXT_0209_CER": "Poor old swing. If only this forest had\r\nsomeone who could fix you...",
  "HUD_INTERACT_TEXT_0223_CER": "They're using wisps as circus attractions?!\r\nHow cruel!",
  "HUD_ITEMOBTAIN_TEXT_101": "A small jewel shaped like a petal.\r\nFormed from the very life essence\r\nof the forest, collecting several\r\nis said to increase your vitality.",
  "HUD_ITEMOBTAIN_TEXT_012": "Umbran medicine in a bottle shaped like a petal.\r\nUse it to slightly restore Cereza's vitality.\r\n*You can now concoct more on your own!",
  "HUD_PURPOSE_TXT_2030": "Proceed through \r\nFaerieland Tower.",
  "HUD_PURPOSE_TXT_6030": "Talk to Lukaon.",
  "HUD_PURPOSE_TXT_4100": "Follow the white wolf \r\nto Lukaon.",
  "HUD_GAMEOVER_TXT_0004": "Cereza sank to the black depths\r\nof the lake; only its bottom dwellers \r\nknowing what became of her.",
  "HUD_ITEMOBTAIN_TEXT_009": "An Umbran potion cased in a butterfly bottle.\r\nGrants temporary invincibility and increased\r\nspeed casting Umbran Arts.\r\n*You can now concoct more on your own!",
  "HUD_PURPOSE_TXT_1120": "Look for a way back to Inferno.",
  "HUD_PURPOSE_TXT_3010": "Fight the monstrous dragon.",
  "HUD_INTERACT_TEXT_0900_CER": "This gate has a see-saw on it,\r\njust the right size for a wisp...",
  "HUD_INTERACT_TEXT_0107_CER": "What is this thing?! Well, looks \r\nlike there's no turning back now...",
  "HUD_PURPOSE_TXT_1020": "Hurry ahead with Jeanne.",
  "HUD_NOTICE_TXT_03": "New Archive Unlocked!",
  "HUD_INTERACT_TEXT_0108_CER": "I guess this forest won't let me out \r\nthat easily...",
  "HUD_INTERACT_TEXT_0214_CER": "Our wanted posters are just scattered everywhere!\r\nWhat an incredibly rude bunch!",
  "HUD_INTERACT_TEXT_0106_CER": "What a huge lake!\r\nHm? Is something...stuck?",
  "HUD_INTERACT_TEXT_0901_CER": "1,2,3...Looks like we'll need\r\nthree wisps to open this gate.",
  "HUD_GAMEOVER_TXT_1004": "*Chomp* *crunch, crunch* *gulp*...\r\nA few moments later, a pitiful cry\r\nechoed through the otherwise silent forest.",
  "HUD_INTERACT_TEXT_0201_CER": "These boards are rotten!\r\nOh, I hope they don't collapse...",
  "HUD_MAPCL_B_10": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Chalkroot Hollow!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_03": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Leafy Nook!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_ITEMRECIPE_TEXT_009": "A potion in a butterfly bottle.\r\nGrants temporary invincibility \r\nand faster Umbran Arts recasting.",
  "HUD_PURPOSE_TXT_2010": "Save Colm's friends alone.",
  "HUD_MAPCL_B_14": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Forbidden Grounds!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_07": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Windy Knot!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_A_08": "Working together, the two vanquished\r\nthe Tír na nÓg in Giant's Basin!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_ITEMOBTAIN_TEXT_021": "Pick one up to recover \r\nthe Spell Cooldown gauge,\r\nallowing Cereza to cast Umbran \r\nArts again more quickly.",
  "HUD_MAPCL_A_00": "Working together, the two vanquished\r\na Tír na nÓg in a place unknown!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_13": "Working together, the two vanquished\r\na Tír na nÓg in Forgotten Knoll!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_PURPOSE_TXT_4020": "Head to the \r\nfaeries' fortress alone.",
  "HUD_ITEMRECIPE_TEXT_012": "Medicine in a petal-shaped bottle.\r\nUse it to slightly restore \r\nCereza's vitality.",
  "HUD_PURPOSE_TXT_6010": "Take Cheshire back \r\nfrom Lukaon.",
  "HUD_MAPCL_B_18": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Púca's Fortress!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_PURPOSE_TXT_1100": "Go to Avalon Forest.",
  "HUD_STATUSUP_TEXT_202": "The brace becomes filled with the magic \r\nCereza has absorbed, and offers her its power!",
  "HUD_INTERACT_TEXT_0208_CER": "This one's quite old.\r\nIt seems like it's been here for a long time.",
  "HUD_MAPCL_A_04": "Working together, the two vanquished\r\na Tír na nÓg in Lake Nimueh!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_17": "Working together, the two vanquished\r\na Tír na nÓg in Ashenbark Woods!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_INTERACT_TEXT_0212_CER": "Is this supposed to be me and Cheshire?\r\nCome on, I'm way cuter than this!",
  "HUD_MAPCL_A_03": "Working together, the two vanquished\r\na Tír na nÓg in Leafy Nook!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_10": "Working together, the two vanquished\r\na Tír na nÓg in Chalkroot Hollow!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_INTERACT_TEXT_0031_CER": "It's much too late to be heading into town now!",
  "HUD_PURPOSE_TXT_4030": "Find Cheshire.",
  "HUD_ITEMRECIPE_TEXT_011": "A potion in a thorn-laced bottle.\r\nUse it to create a shockwave,\r\nstunning all nearby enemies.",
  "HUD_MAPCL_B_08": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Giant's Basin!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_INTERACT_TEXT_0001_CER": "This gate leads to town.\r\n...Not that I particularly want to go.",
  "HUD_PREVENT_TEXT_0002_CER": "I need to focus on my chores...\r\nor Morgana will have a thundering fit again.",
  "HUD_INTERACT_TEXT_0309_CER": "Every cage is completely destroyed.\r\nSomeone must've had a big tantrum.",
  "HUD_INTERACT_TEXT_0405_CER": "Flames everywhere! Even Morgana's hardest \r\ntraining doesn't make me sweat this much!",
  "HUD_MAPCL_A_07": "Working together, the two vanquished\r\na Tír na nÓg in Windy Knot!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_14": "Working together, the two vanquished\r\na Tír na nÓg in Forbidden Grounds!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_PURPOSE_TXT_1010": "Proceed forward.",
  "HUD_PURPOSE_TXT_1110": "Proceed through the forest.",
  "HUD_STATUSUP_TEXT_201": "The flower lets out a brilliant light, \r\nbestowing its energy!",
  "HUD_INTERACT_TEXT_0014_CER": "Ugh, there are so many bugs!\r\nJust...stay away from me!",
  "HUD_PURPOSE_TXT_3020": "Drain the lake.",
  "HUD_INTERACT_TEXT_0300_CER": "The dust in here is just awful...\r\nIs this some sort of faerie storeroom?",
  "HUD_INTERACT_TEXT_0012_CER": "Maybe I can say a little wish to this candle.\r\nPlease...may Avalon make my dreams come true!",
  "HUD_INTERACT_TEXT_0008_CER": "Wow, such a lovely view!\r\nI could just stay here forever...\r\nbut no time for that!",
  "HUD_PURPOSE_TXT_5010": "Calm Cheshire down.",
  "HUD_MAPCL_B_13": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Forgotten Knoll!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_00": "Cereza and Cheshire vanquished all\r\nTír na nÓg in the unknown region!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_PREVENT_TEXT_0004_CER": "This isn't the way. I need to catch the white wolf!",
  "HUD_INTERACT_TEXT_0007_CER": "What's my textbook doing here?!\r\nI'd better put it away later.",
  "HUD_GAMEOVER_TXT_1003": "The magnanimous Púca had\r\ndefeated all who dared oppose him.\r\nThe world was now his for the taking.",
  "HUD_PURPOSE_TXT_2100": "Head to the Great Tree.",
  "HUD_MAPCL_B_17": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Ashenbark Woods!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_04": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Lake Nimueh!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_INTERACT_TEXT_0037_CER": "Morgana's house seems scarier at night...",
  "HUD_ITEMOBTAIN_TEXT_022": "A power-imbued crystal the shape \r\nof a crescent moon. Typically only \r\nfound in Inferno, it can restore\r\nsome of the user's magic energy.",
  "HUD_INTERACT_TEXT_0038_CER": "It's so dark, I'll be in trouble if I stumble!\r\nI'd better stay away from the pond...",
  "HUD_MAPCL_A_18": "Working together, the two vanquished\r\na Tír na nÓg in Púca's Fortress!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_PURPOSE_TXT_2050": "Rest at the Sanctuary.",
  "HUD_INTERACT_TEXT_0401_CER": "These lily pads are proving to be useful.\r\nThey can be boats, stepping stones...",
  "HUD_GAMEOVER_TXT_2001": "Her strength having left her,\r\nJeanne's soul faded away.\r\nSoon all that remained in the\r\nforest were two lifeless toys.",
  "HUD_MAPCL_A_06": "Working together, the two vanquished\r\na Tír na nÓg in Sunspeckled Grove!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_15": "Working together, the two vanquished\r\na Tír na nÓg in Overgrown Shrine!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_PREVENT_TEXT_0006_CER": "You're chomping to see what's behind that\r\ndoor, aren't you. Well come on then, let's go.",
  "HUD_INTERACT_TEXT_0010_CER": "I'll be back soon, I promise.",
  "HUD_INTERACT_TEXT_0302_CER": "This machine's bigger than I am!\r\nI wonder what it's used for...",
  "HUD_MAPCL_B_09": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Wyvern Falls!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_INTERACT_TEXT_0020_CER": "I hope Morgana will take good care\r\nof the violets I gave her...",
  "HUD_ITEMRECIPE_TEXT_010": "Perfume in a crescent moon bottle.\r\nTemporarily gives Cheshire unlimited \r\nmagic energy to perform skills.",
  "HUD_MAPCL_A_02": "Working together, the two vanquished\r\na Tír na nÓg in Jade Hill!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_11": "Working together, the two vanquished\r\na Tír na nÓg in Faerieland Tower!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_INTERACT_TEXT_0035_CER": "Fetch a bucket of water and carry it \r\nto Morgana...is this really witch training?",
  "HUD_INTERACT_TEXT_0033_CER": "Forgot to clean this...but Morgana \r\nshouldn't notice when it's this dark.",
  "HUD_INTERACT_TEXT_0029_CER": "What a big spider's nest!\r\nIt seems like the owner isn't home...",
  "HUD_FORESTGUIDE_TEXT_001": "A warmly glowing light guides\r\nCereza to a nearby Sanctuary...",
  "HUD_PURPOSE_TXT_4090": "Leave the fortress and\r\nproceed through the forest.",
  "HUD_PURPOSE_TXT_1140": "Save Cereza.",
  "HUD_PURPOSE_TXT_2012": "Save the wisps together.",
  "HUD_PURPOSE_TXT_3070": "Search for the last \r\nElemental Core.",
  "HUD_MAPCL_B_16": "Cereza and Cheshire vanquished all\r\nTír na nÓg in the Altar of the Faerie King!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_05": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Sunkissed Shore!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_GAMEOVER_TXT_1002": "The Jabberwock swallowed Cereza\r\nwhole, but was far from sated.\r\nHe took to the skies to search\r\nfor his next morsel.",
  "HUD_PURPOSE_TXT_1040": "Go to Morgana.",
  "HUD_GAMEOVER_TXT_1006": "Morgana and Lukaon - the two had\r\nconquered all obstacles and could now\r\nbe together, living happily ever after.",
  "HUD_PURPOSE_TXT_2105": "Proceed through Windy Knot.",
  "HUD_INTERACT_TEXT_0304_CER": "The way this plant waves back and forth...\r\nit's almost mesmerising...",
  "HUD_INTERACT_TEXT_0016_CER": "I filled it up when Morgana wasn't looking!\r\nShe surely won't run out now!",
  "HUD_MAPCL_B_12": "Cereza and Cheshire vanquished all\r\nTír na nÓg in the Watchtower!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_01": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Whispering Path!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_PURPOSE_TXT_4060": "Search for the white wolf.",
  "HUD_PREVENT_TEXT_0000_CER": "I'd better go talk to Morgana.\r\nI'm already late. She's getting angrier by the second!",
  "HUD_INTERACT_TEXT_0003_CER": "These heavy lamps are so hard to clean.\r\nOh my, they've gotten dirty again...",
  "HUD_INTERACT_TEXT_0407_CER": "Just watching this is making me dizzy...",
  "HUD_INTERACT_TEXT_0019_CER": "Do you think the fish sleep at this hour?",
  "HUD_PURPOSE_TXT_4080": "Destroy the final \r\nElemental Core.",
  "HUD_MAPCL_A_09": "Working together, the two vanquished\r\na Tír na nÓg in Wyvern Falls!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_GAMEOVER_TXT_1001": "The faeries roared in applause\r\nfor the new attraction they\r\nhad procured.\r\n\"Only real magic here, friends...\"",
  "HUD_PURPOSE_TXT_1050": "Draw water at \r\nthe eastern well.",
  "HUD_PURPOSE_TXT_8000": "Complete the Tír na nÓg!",
  "HUD_INTERACT_TEXT_0220_CER": "Looking closely, this cage is all battered.\r\nI wonder if it was tossed out as rubbish.",
  "HUD_PURPOSE_TXT_1150": "Proceed through \r\nthe forest together.",
  "HUD_PURPOSE_TXT_2011": "Save the trapped wisps.",
  "HUD_PURPOSE_TXT_3060": "Destroy the third \r\nElemental Core.",
  "HUD_MAPCL_B_15": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Overgrown Shrine!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_06": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Sunspeckled Grove!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_11": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Faerieland Tower!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_MAPCL_B_02": "Cereza and Cheshire vanquished all\r\nTír na nÓg in Jade Hill!\r\nThe ominous fog has been lifted.\r\nPoints of interest are now marked.",
  "HUD_GAMEOVER_TXT_1005": "Finally regaining both his body and\r\nhis original strength, Lukaon settled as\r\nthe true king of Avalon...after taking \r\na moment of silence for the sacrifices \r\nmade along the way.",
  "HUD_PURPOSE_TXT_6040": "Ride Cheshire and escape \r\nthe forest.",
  "HUD_PURPOSE_TXT_4070": "Defeat Affinity.",
  "HUD_MAPCL_A_05": "Working together, the two vanquished\r\na Tír na nÓg in Sunkissed Shore!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_16": "Working together, the two vanquished a \r\nTír na nÓg in the Altar of the Faerie King!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_INTERACT_TEXT_0219_CER": "That was quite the lengthy slide...\r\nJust thinking about it makes my bottom hurt.",
  "HUD_PURPOSE_TXT_2040": "Follow the Wisps.",
  "HUD_INTERACT_TEXT_0203_CER": "Hm? Something's carved here...\r\n“Capture all humans who enter the forest!”",
  "HUD_INTERACT_TEXT_0104_CER": "Wh-what is that?!\r\nDid the faeries do that as well?!",
  "HUD_INTERACT_TEXT_0216_CER": "Ahh...hah...\r\nWhat cargo is it carrying in such a hurry?",
  "HUD_INTERACT_TEXT_0500_CER": "Everything is completely frozen.\r\nI'll be too before long...",
  "HUD_MAPCL_A_01": "Working together, the two vanquished\r\na Tír na nÓg in Whispering Path!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_MAPCL_A_12": "Working together, the two vanquished\r\na Tír na nÓg in the Watchtower!\r\nYet it still seems there are other \r\nTír na nÓg in this region...",
  "HUD_PURPOSE_TXT_1070": "Go to the southern herb field.",
  "HUD_PURPOSE_TXT_1170": "Escape the Tír na nÓg.",
  "HUD_PURPOSE_TXT_3040": "Destroy the third \r\nElemental Core.",
  "HUD_PURPOSE_TXT_6060": "Defeat Morgana.",
  "HUD_GAMEOVER_TXT_0009": "Caught by the faeries, \r\nCereza's spirit was tossed into \r\na lantern, where it burned\r\nbrighter than any ever since.",
  "HUD_PURPOSE_TXT_7002": "Defeat enemies \r\nwithout getting hit!",
  "HUD_ITEMOBTAIN_TEXT_004": "A rare, demonic-looking fruit from Inferno\r\nthat requires magically rich soil to survive.\r\nFull of nutrients and devilishly sweet.\r\n*Allows Cheshire to unlock powerful skills.",
  "HUD_PURPOSE_TXT_4050": "Proceed without \r\ngetting spotted.",
  "HUD_INTERACT_TEXT_0218_CER": "“Humans are welcome at our circus!”\r\nWhy is it written in human language...?",
  "HUD_PURPOSE_TXT_1180": "Follow the wolf and find \r\nthe Elemental Core.",
  "HUD_PURPOSE_TXT_1080": "Grow herbs with \r\nCereza's Umbran Arts.",
  "HUD_INTERACT_TEXT_0217_CER": "“Presenting the rare talent, Amadán Dubh!\r\nBehold his miracles at Amadán's Big Top!”...?",
  "HUD_INTERACT_TEXT_0105_CER": "Whoa!\r\nThe grass is all wet and slippery!",
  "HUD_NOTICE_TXT_02": "Sanctuary Unlocked!",
  "HUD_INTERACT_TEXT_0211_CER": "Is this...a grave?\r\nI wonder whose it is...",
  "HUD_PURPOSE_TXT_9000": "Explore the forest.",
  "HUD_GAMEOVER_TXT_0001": "Cereza perished among the trees\r\nof Avalon Forest, eventually fading\r\nfrom the memories of all who knew her.",
  "HUD_PURPOSE_TXT_2060": "Go to the circus.",
  "HUD_PURPOSE_TXT_2090": "Find the third \r\nElemental Core.",
  "HUD_ITEMOBTAIN_TEXT_008": "A compound sealed in crystal.\r\nKnocked straight off a poor unicorn. \r\nMay be used for ornamental purposes,\r\ndepending on their length and sparkle.",
  "HUD_GAMEOVER_TXT_0005": "Púca's Fortress brought Cereza\r\nto her knees. Her crystal coffin was\r\ndiscarded in a forgotten corner.",
  "HUD_INTERACT_TEXT_0017_CER": "I can become a powerful witch if I go to the forest.\r\nI won't need to study any more!",
  "HUD_NOTICE_TXT_01": "New Map Unlocked!",
  "HUD_PURPOSE_TXT_2070": "Defeat Amadán Dubh.",
  "HUD_INTERACT_TEXT_0018_CER": "I won't be able to enjoy this view any more...\r\nbut I've got to be strong for Mummy!",
  "HUD_INTERACT_TEXT_0406_CER": "What a monstrously large building...\r\nIt must be very important, I'll say.",
  "HUD_GAMEOVER_TXT_0002": "Cereza met her end deep within the\r\nforest, her crystal coffin gradually\r\nswallowed by the forest undergrowth.",
  "HUD_INTERACT_TEXT_0002_CER": "This rock looks just like a fang...\r\nWhat if there was a giant monster,\r\njust underneath the ground here...",
  "HUD_INTERACT_TEXT_0310_CER": "Someone must've been spying on us\r\nover a nice cup of tea...",
  "HUD_GAMEOVER_TXT_0006": "Cereza's luck had run out. \r\nShe was doomed to spend \r\neternity inside a faerie cage \r\nof illusions.",
  "HUD_PURPOSE_TXT_2080": "Destroy the second \r\nElemental Core.",
  "HUD_PURPOSE_TXT_1160": "Follow the wolf.",
  "HUD_PURPOSE_TXT_3050": "Defeat the Jabberwock.",
  "HUD_PURPOSE_TXT_1060": "Give the well water \r\nto Morgana.",
  "HUD_INTERACT_TEXT_0021_CER": "This is so high up!\r\nJust imagine if I fell...ohh...",
  "HUD_INTERACT_TEXT_0034_CER": "I could watch the flames of these \r\nflicker at night forever...",
  "HUD_ITEMOBTAIN_TEXT_003": "The petal from a black rose that blooms \r\nin Inferno. The faint magical energy \r\nit possesses makes it a favoured garden \r\nchoice of faeries as well.",
  "HUD_ITEMOBTAIN_TEXT_010": "Umbran perfume in a crescent moon bottle.\r\nUse it to temporarily give Cheshire \r\nunlimited magic energy to perform skills.\r\n*You can now concoct more on your own!",
  "HUD_ITEMOBTAIN_TEXT_007": "A compound sealed in crystal.\r\nInterestingly, can have various \r\neffects on the user depending \r\non how well it is baked.",
  "HUD_PURPOSE_TXT_4040": "Search for Cheshire \r\nwith the white wolf.",
  "HUD_PREVENT_TEXT_0007_CER": "I...I can't give up now. Come on, Cereza...\r\nYou're doing this for Colm!",
  "HUD_INTERACT_TEXT_0004_CER": "I wonder if Morgana chose these lamps.\r\nFunny, I think we may have similar taste!",
  "HUD_INTERACT_TEXT_0400_CER": "A lake? I'm not scared in the least!\r\nI'm like a fish in the water.",
  "HUD_PURPOSE_TXT_7001": "Defeat enemies within \r\nthe time limit!",
  "HUD_PURPOSE_TXT_1090": "Take the herbs to Morgana.",
  "HUD_PREVENT_TEXT_0008_CER": "I forgot the herb basket! Better not\r\ngo back to Morgana empty handed...",
  "HUD_INTERACT_TEXT_0011_CER": "I'm not going to town.\r\nI'm going to Avalon Forest!",
  "HUD_PURPOSE_TXT_1190": "Find the second \r\nElemental Core."
}
