{
  "CE_005020_0000_CER": "멈추지 않으면 나……\r\n널 용서하지 않을 거야!!!",
  "SM_005020_0210_FAS": "「너희의 행운을 바라마.\r\n아발론의 숲의 가호가 있기를……」",
  "CE_005110_0000_CER": "됐다! 두 개째야!",
  "SM_005020_0020_CER": "「이그니스!」",
  "CE_005820_0000_CER": "진정해, 괜찮으니까……!",
  "BK_5010_0000_NAR": "드디어 체셔가 정신을 차렸나 봅니다.\r\n하지만 푸카의 마술 때문에 피곤한 건지\r\n축 늘어져 있습니다.",
  "BK_5000_0260_NAR": "체셔는 세레자를 노려보며\r\n크게 울부짖고는\r\n이빨을 보이며 덤벼들었습니다!",
  "IN_5000_0010_CER": "「그렇지, 체셔.\r\n우리 둘의 힘을 보여 주자!」",
  "LV_005010_0020_NAR": "체셔가 시원스럽게 대답합니다.\r\n그 말을 듣고 세레자도 용기를 얻었습니다.",
  "SM_005020_0060_FAS": "「……그렇지만\r\n아가씨가 여기까지 해낼 줄이야,\r\n나도 상상하지 못했어」",
  "BK_5000_0010_NAR": "세레자의 앞에 나타난 것은\r\n요새에서 패배하고\r\n도망간 요정 푸카였습니다.",
  "LV_005010_0010_NAR": "『\"생각하기 전에 뛰어들어라.\"\r\n……그러면 무서울 게 없지』",
  "BK_5000_0180_NAR": "체셔는 이번에도\r\n푸카의 권유를 거절했습니다.",
  "SM_005020_0050_FAS": "「하하, 내 역할을 다했을 뿐이란다.\r\n\"이 숲을 누구보다 잘 아는 자\"로서」",
  "BK_5000_0100_CER": "「체셔……」",
  "IN_5000_0020_CER": "「서, 설마…… 천사!?\r\n왜 이런 곳에……」",
  "BK_5000_0060_NAR": "푸카는 체셔를 마계에 돌려보내 주겠다고\r\n다시 유혹했습니다.\r\n무려 이번에는 체셔 눈앞에서\r\n마계로 가는 문을 열어 주겠다는 겁니다.",
  "LV_005905_0000_CER": "체셔, 상처는 괜찮아?\r\n아프진 않고?",
  "_01": "",
  "SM_005020_0180_FAS": "「그리고……\r\n꼬마 아가씨가 숲에 들어온 이유도\r\n그게 목적이었지?」",
  "BK_5000_0170_POO": "「존귀한 짐의 자비를 걷어차다니\r\n저 어린것보다도 미련한 자로구나!!!」",
  "LV_005905_0030_CER": "후훗, 그럼 됐어",
  "CE_005010_0000_CER": "류카온, 이제 그만해!!",
  "CE_005120_0000_CER": "좋아, 세 개째!!",
  "SM_005010_0020_CER": "「느껴져…… 이 너머에 류카온이……」\r\n",
  "BK_5010_0040_NAR": "체셔는 아무 말도 하지 않고\r\n조용히 눈을 감았습니다.",
  "CE_005805_0010_NAR": "체셔는 이성을 잃은 듯 날뛰며\r\n아무런 대답도 하지 않습니다.",
  "CE_005810_0000_CER": "더 이상 받아넘기긴 힘들어……!\r\n하지만 체셔를 이대로 놔둘 수는 없어!",
  "BK_5010_0010_CER": "「체셔…… 왜 그때\r\n구멍에 안 들어간 거야?」",
  "CE_005835_0000_CER": "그만해, 체셔……!",
  "LV_005015_0000_NAR": "얼어붙을 듯한 찬 바람이 사정없이 불어옵니다.\r\n하지만 둘의 마음은 조금도 춥지 않았습니다.",
  "CE_005090_0000_CER": "네가 뺏어 간 체셔의 힘, 돌려받아야겠어!",
  "CE_005050_0000_CER": "이 기계를 멈추기만 하면……",
  "BK_5000_0110_NAR": "체셔는 조심스럽게 구멍에 다가갔습니다.",
  "BK_5000_0030_POO": "「발칙한 어린것이여.\r\n짐이 바라는 것은 네가 아니도다!\r\n\r\n마의 존재여, 거듭 짐의 말을 듣거라!」",
  "CE_005830_0000_NAR": "『도망쳐……』\r\n체셔가 쥐어짜듯이 신음했습니다.",
  "CE_005825_0010_CER": "잠깐 기다려!",
  "LV_005010_0000_CER": "나는 무섭지 않아.\r\n……체셔, 너는?",
  "SM_005020_0150_FAS": "「나는 그 악몽을 끝낼 힘을 가진 자를\r\n기다리고 있었단다」",
  "BK_5000_0000_POO": "「기다리거라」",
  "BK_5000_0120_NAR": "이대로 구멍에 뛰어들어 버리는 걸까?\r\n그런 생각을 하니 세레자의 머릿속에\r\n체셔와의 추억들이 스쳐 갔습니다.",
  "BK_5000_0190_POO": "「그토록 그 어린것에\r\n복종하고 싶다면\r\n마음껏 유희하라!\r\n그 목숨 다할 때까지!」\r\n",
  "SM_005020_0110_FAS": "「그렇고말고」",
  "LV_005905_0020_NAR": "살짝 목을 울리는 소리가 들렸습니다.",
  "CE_005060_0000_CER": "하나 남았어!\r\n기다려, 체셔!",
  "BK_5000_0070_POO": "「아아, 그대는 이미 여러 번\r\n짐의 제안을 거절했도다!\r\n하지만 지금 어둠의 문을 열어\r\n그 완고한 마음 움직이겠노라!」",
  "SM_005020_0080_FAS": "「하하하! 그렇겠구나.\r\n그럼 이제부터 너희들에게\r\n길 안내를 맡겨 볼까?」",
  "LV_005020_0000_CER": "가자! 체셔!",
  "CE_005150_0000_CER": "이제 누구에게도 체셔를 뺏기지 않아!\r\n절대로 안 보낼 거야!!",
  "CE_005815_0010_CER": "기다려, 체셔!",
  "LV_005905_0010_NAR": "『딱히 아프진 않아』\r\n체셔는 그 말만 하고 입을 다물었지만……",
  "SM_005020_0120_FAS": "「나는 오랫동안\r\n이 아발론의 숲에서 살고 있었어.\r\n옛날에는 아주 아름답고\r\n조용한 숲이었단다」",
  "LV_005910_0000_CER": "야아아아아아아앗!",
  "BK_5000_0040_POO": "「오오, 불쌍한 외톨이 악마여,\r\n미련한 어린것의 종자였으나\r\n짐이 그대를 해방하노라.\r\n\r\n짐이 개방한 문을 넘어\r\n마의 땅으로 돌아갈지어다!」",
  "CE_005805_0000_CER": "체셔! 대답 좀 해 봐!\r\n내가 누군지 모르겠어!?",
  "SM_005020_0160_CER": "「이그니스……?」",
  "CE_005190_0000_CER": "지금 갈게, 체셔!!!",
  "SM_005010_0030_NAR": "하지만 어째서일까요.\r\n세레자는 이 길을 가면 두 번 다시\r\n돌아오지 못할 듯한 느낌이 들었습니다.",
  "SM_005010_0000_NAR": "숲으로 돌아온 세레자.\r\n눈앞에 새로운 길이\r\n펼쳐져 있었습니다.",
  "LV_005005_0020_CER": "저 너머에…… 류카온이 기다리고 있어……",
  "CE_005030_0000_CER": "그 공격을 맞으면 버티지 못할 거야!",
  "IN_5000_0000_CER": "「저 녀석은……!」",
  "CE_005100_0000_CER": "우선 하나!",
  "IN_5000_0030_CER": "「그렇지, 체셔.\r\n우리 둘의 힘을 보여 주자!」",
  "LV_005005_0010_CER": "저기 보이는 건…… 입구?",
  "IN_5010_0010_CER": "「체셔, 각오는 됐어?\r\n나는……」",
  "SM_005020_0190_CER": "「……!\r\n류카온……!?」",
  "SM_005020_0200_FAS": "「자, 가거라.\r\n제단의 봉인은 이미 풀려 있단다」",
  "SM_005010_0040_CER": "「이제 다 왔어, 체셔……\r\n이 너머에 분명\r\n우리가 목표한 게 있어.\r\n마음의 준비가 되면 같이 가자」",
  "BK_5000_0240_NAR": "그리고……",
  "BK_5010_0020_NAR": "『그런 녀석들은 신용할 수 없으니까』\r\n체셔는 고개를 휙 돌렸습니다.",
  "CE_005820_0010_CER": "문제없어, 내가 곁에 있잖아……!",
  "LV_005900_0010_NAR": "『어차피 또 거만한 얼굴로 나타날 테지』\r\n체셔는 신경도 쓰이지 않는 모양입니다.",
  "BK_5010_0060_NAR": "잠이 든 체셔를 위해\r\n세레자는 자장가를 불러 주었습니다.",
  "SM_005020_0040_CER": "「이그니스 덕분이야.\r\n여러모로 알려 줘서 고마워」",
  "SM_005020_0070_CER": "「어쩌면 이제 우리가\r\n이 숲을 더 잘 알지도 모르겠네?」",
  "BK_5000_0230_NAR": "푸카는 웃기만 할 뿐, 말이 없군요.\r\n체셔는 괴로운 듯이 계속 신음합니다.",
  "CE_005000_0000_CER": "체셔!!\r\n안 돼, 류카온!! 체셔를 돌려줘!!!",
  "CE_005130_0000_CER": "네 개째!\r\n다 돌려받았네, 류카온!",
  "SM_005020_0030_FAS": "「네 개의 엘레멘트 코어의 봉인을\r\n잘 풀어 주었구나. 요정들도\r\n천지가 뒤바뀐 듯 당황하고 있단다」",
  "SM_005020_0000_FAS": "「꼬마 아가씨. 드디어 해냈구나!」",
  "CE_005800_0000_CER": "체셔……!",
  "CE_005825_0000_CER": "위험해!",
  "BK_5000_0090_NAR": "푸카 앞에 커다란 구멍이 뚫렸습니다.\r\n그곳에서 소름 돋는 소리가 흘러나오자\r\n숲의 나무들이 소란을 피웁니다.\r\n구멍은 정말 마계로 가는 문이었습니다.",
  "LV_005005_0000_NAR": "모든 엘레멘트 코어를 파괴하여\r\n요정들의 결계가 흔적도 없이 사라집니다.",
  "SM_005020_0140_FAS": "「숲의 이치를 꺾고 생명을 학대하며\r\n도깨비불을 장난감 다루듯 했지……\r\n녀석들의 잔인한 행동을\r\n이 눈으로 계속 지켜보고 있었어」",
  "CE_005080_0000_CER": "이럴 수가, 도망가야 해!",
  "SM_005020_0155_FAS": "「나도\r\n옛날 같은 힘이 있었다면, 사실……」",
  "BK_5000_0020_CER": "「자칭 요정왕이구나.\r\n이번에는 무슨 일이야?」",
  "SM_005020_0170_FAS": "「……이런, 슬픈 얘기는 이만하자꾸나.\r\n이 너머에 녀석들이 필사적으로\r\n숨기고 있는 게 잠들어 있단다」",
  "CE_005040_0000_CER": "내 마도술로 뭐든지 고치겠어!",
  "LV_005015_0010_NAR": "둘이 함께라면 어떤 고난이라도 이겨 낼 수 있어.\r\n그런 믿음이 태양처럼 둘의 마음을\r\n비추고 있었습니다.",
  "CE_005170_0000_CER": "",
  "BK_5010_0030_CER": "「……그 말은,\r\n나는 믿고 있다는 거야?」",
  "BK_5000_0250_CER": "「왜, 왜 그래, 체셔……?」",
  "SM_005020_0100_CER": "「어……?\r\n우리를……?」",
  "SM_005020_0010_NAR": "여기에 도달하기까지\r\n몇 번이고 들었던 목소리가\r\n나무 사이로 들려옵니다.",
  "IN_5010_0000_NAR": "이 길을 가면 두 번 다시\r\n돌아오지 못할 듯한 느낌이 듭니다.",
  "CE_005070_0000_CER": "체셔어어어어!!!",
  "BK_5000_0220_CER": "「체셔한테 무슨 짓을 한 거야!」",
  "CE_005805_0020_CER": "어떻게 해야 하지?\r\n내 마력으로…… 되돌릴 수 있을까?",
  "SM_005010_0010_NAR": "길 너머에서 세레자를 부르는 듯한\r\n신기한 기운이 느껴집니다.",
  "LV_005900_0000_CER": "그러고 보니……\r\n늑대는 무사할까?",
  "CE_005180_0000_CER": "",
  "CE_005815_0000_CER": "지금이야……!",
  "SM_005020_0090_FAS": "「……나는 너희들 같은 존재를\r\n계속 기다리고 있었단다」",
  "SM_005020_0130_FAS": "「……하지만 그 평화를 깨 버린 게\r\n요정들이지」"
}
