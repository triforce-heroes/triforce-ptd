{
  "CORE_DIALOG_TXT_112": "Has recibido el atuendo\r\n«Cereza en el país de las maravillas».",
  "CORE_DIALOG_TXT_101": "Selecciona «Atuendos» en un santuario\r\npara cambiar el aspecto de Cereza\r\ny de Cheshire.",
  "AC_NARRATION235_0010": "Las agitadas aguas de la cascada fluían\r\nhasta desembocar en el lago Nimueh.",
  "CORE_SNPSS_4020": "Cereza descubre que las hadas\r\nhan capturado a Cheshire,\r\nasí que decide olvidar\r\nlas rencillas y se infiltra\r\nen la fortaleza con la ayuda\r\ndel lobo blanco.",
  "CORE_WISP_TALK_71_FAS": "Saludos, Cereza.\r\n¿Has encontrado\r\nhuellas de lobo?",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "Obstrucción",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "Resentimiento",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "Requisitos: Aprende\r\ntécnicas con Cheshire y...",
  "CORE_WH_TALK_11_COL": "Nos lo estamos pasando bomba por aquí,\r\ngracias a vosotros. ¿Por qué no os quedáis\r\nuna temporadita?",
  "CORE_SNPSS_6010": "Traicionados por Lukaon,\r\nCereza y Cheshire colaboran\r\npara detenerlo. Finalmente,\r\nLukaon vuelve en sí y ayuda\r\na la pareja a escapar del bosque.",
  "CORE_HTDMMESS_0039_001_H39": "Cof, cof... ¡Achús! Ay, perdón...\r\nMe he puesto fatal. ¿Tienes\r\nalguna medicina a mano?",
  "CORE_HTDMQUEST_TXT_0026": "El estilo lo es todo incluso aquí\r\nen Ávalon, cariño. Quiero una\r\nflor que combine con mi carácter.",
  "AC_NARRATION260_0010": "Cereza y Cheshire, salvadores de un sinfín\r\nde fuegos fatuos, se habían convertido\r\nen héroes para los más desfavorecidos.",
  "CORE_WH_TALK_04_COL": "¡Han vuelto muchos fuegos fatuos!\r\n¡Y todo gracias a ti y a ese...\r\namigo tuyo!",
  "CORE_POSEMENU_TXT_06": "Sal del tír na nÓg.",
  "CORE_HTDMMESS_0023_001_H23": "Ay... ¿Por qué tengo siempre\r\ntanta hambre?... Comida...\r\n¿Dónde puedo encontrar comida?",
  "CORE_WISP_TALK_64_FAS": "Considérame tu guía de Ávalon.\r\nTe llevaré adonde quieras.",
  "CORE_SNPSS_3030": "Cereza y Cheshire vencen\r\nal Jabberwock en una batalla\r\ntrepidante. Guiados por\r\nel lobo blanco, se dirigen\r\nal santuario donde\r\nse halla el núcleo elemental.",
  "CORE_SVSLT_TXT_02": "Selecciona el archivo que quieras cargar.",
  "AC_CEREZA040_0010": "Nadie te quiere. ¿De verdad crees\r\nque vas a convertirte en una gran bruja?",
  "CORE_SNPSS_1000": "Cereza prosigue su periplo\r\npor el reino hostil.\r\nParece tener prisa,\r\npor algún motivo...",
  "CORE_HTDMMESS_0013_002_H13": "Puedo oírlas... Las voces que me llaman\r\ndesde una dimensión desconocida...",
  "CORE_WISP_TALK_28_H14": "¡Viva! Por fin soy libre... ¡En cuanto\r\nregrese me voy a dar un homenaje!",
  "CORE_HTDMMESS_0021_002_H21": "Lo que necesito es un adorno\r\nideal para mi sombrero...\r\n¡Así iría directo al estrellato!",
  "CORE_POSEMENU_TXT_02": "Consulta los tutoriales del juego.",
  "CORE_POSEMENU_TXT_11": "Continúa desde el último\r\npunto de guardado.",
  "CORE_WISP_TALK_17_H03": "Me has salvado... ¡Cuánto te lo agradezco!\r\nVenga, y ahora centrémonos en abrir\r\nla puerta, ¿de acuerdo?",
  "TA_9011_0010_COL": "¡Ve con cuidado, amiga!",
  "CORE_DIALOG_TXT_005": "Se borrarán estos\r\ndatos de guardado.\r\n¿Quieres continuar?",
  "CORE_DIALOG_TXT_116": "Has recibido los atuendos\r\n«Arquieva original»,\r\n«Jeanne» y «Charles».",
  "CORE_DIALOG_TXT_105": "¿Quieres cerrar el menú de atuendos?",
  "CORE_HAIR_CERESSA_TXT_03": "Atrevido",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "Imprecación",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "Oscuridad cegadora",
  "CORE_WH_TALK_21_COL": "Si encontráis más fuegos fatuos,\r\ndecidles que vengan aquí. Seguro\r\nque pasan mucho miedo solos...",
  "CORE_WISP_TALK_21_H07": "¡Genial, ya puedo moverme otra vez!\r\n¡Gracias, apañada! ¡Molas mazo!",
  "TEST_WISP_TALK_13_H00": "Me da muy mala espina todo esto...\r\n¿Te importa que esperemos aquí?",
  "CORE_HTDMMESS_0004_002_H04": "Ay... Me da miedo que las hadas me\r\ndescubran. ¡Tienes que encontrar algo\r\nque me ayude a ocultarme!",
  "CORE_DIALOG_TXT_150": "Selecciona los ajustes\r\nde vitalidad. «Menos»\r\nreduce el daño y «Ninguno»\r\nlo ignora.",
  "TA_COM030_0010_CER": "¡Mpf!",
  "CORE_HTDMQUEST_TXT_0039": "No me encuentro bien...\r\n¿Tienes algo para el resfriado?",
  "CORE_WH_TALK_18_COL": "¡Ah, Cereza, Cheshire!\r\n¡Gracias por salvar a todo el mundo!",
  "TA_COM030_0020_CER": "¡Oye!",
  "CORE_DIALOG_TXT_154": "Si te resulta difícil usar el\r\nPulso Brujo, puedes cambiar\r\nlos ajustes para que Cereza\r\nlo ejecute sola. ¿Qué prefieres?",
  "CORE_WISP_TALK_25_H11": "¡Gracias por la ayuda!\r\nVenga, ¡salgamos de aquí!",
  "CORE_ARCHIVE_TXT_03": "Páginas del diario encontradas",
  "AC_CEREZA130_0010": "¡No es verdad!",
  "CORE_WH_TALK_02_COL": "Si te cruzas con algún fuego fatuo,\r\nháblale de este sitio. Solo no sabrá\r\nadónde ir, recuérdalo.",
  "CORE_WISP_TALK_32_H18": "¡Uf, un millón de gracias!\r\nMalditas hadas... ¡Se van a enterar!",
  "CORE_HTDMMESS_0029_003_H29": "Este remedio... Mmm...\r\nPues oye, igual con esto\r\nme suben los ánimos...",
  "AC_NARRATION225_0020": "¿Qué les esperaba más adelante?\r\nNo podían imaginarlo...",
  "CORE_HTDMMESS_0034_001_H34": "Jo, cómo me duele la garganta...\r\n¿No tendrás algo por ahí\r\nque me la suavice un poco?",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "Calamidad (Prueba)",
  "CORE_WH_TALK_17_COL": "Tomad, para vosotros.\r\nEspero que os resulte útil.",
  "CORE_HTDMMESS_0006_001_H06": "¿Tienes algo que pueda usar\r\na modo de aguja? Con que\r\nsea puntiagudo me vale.",
  "CORE_SNPSS_2010": "Cereza y Cheshire encuentran\r\na Colm, un fuego fatuo cuyos\r\namigos han sido raptados\r\npor las hadas. Cereza discute\r\ncon Cheshire y acaba\r\npartiendo al rescate de los\r\nfuegos fatuos en solitario.",
  "CORE_DIALOG_TXT_009": "¿Quieres desplazarte a esta zona?",
  "CORE_SNPSS_0020": "Cereza decide confiar en las\r\npalabras del niño de sus\r\nsueños y, en contra de las\r\nadvertencias de su maestra,\r\nse adentra en la espesura\r\ndel gran bosque, luchando\r\ncontra sus propios miedos.",
  "CORE_WISP_TALK_30_H16": "Gracias por echarme un cable.\r\nDicen que en la torre tienen\r\na muchos de mis amigos...",
  "AC_CEREZA035_0010": "Ríndete de una vez.\r\nNunca cambiarás...",
  "TA_COM000_0010_CER": "¿Mmm?",
  "CORE_HTDMQUEST_TXT_0029": "Uf... Qué aburrimiento.\r\nNecesito algún estímulo...",
  "CORE_WISP_TALK_15_H01": "Gracias por echarme una mano...\r\nVoy a... buscar un sitio\r\npara echar una cabezadita...",
  "CORE_DIALOG_TXT_153": "Ajusta la dificultad de los enemigos.\r\n«Débil» los hace menos agresivos\r\ny reduce la frecuencia de sus ataques.\r\n«Reducida» modera el número de rivales.",
  "CORE_DIALOG_TXT_140": "¿Quieres ver las instrucciones\r\ndel juego en los consejos de viaje?\r\nSiempre puedes consultarlas\r\ndesde el menú de sistema.",
  "CORE_SNPSS_5010": "Cereza calma a Cheshire\r\ndespués de que este cayera\r\nbajo el influjo de uno de los\r\nhechizos de Púca. Fortalecido\r\nsu vínculo gracias a esta\r\nexperiencia, se apresuran\r\na reanudar la búsqueda\r\nde Lukaon.",
  "CORE_ARCHIVE_TXT_04": "Recuerdos de la aventura",
  "CORE_HTDMMESS_0032_001_H32": "Colm se esfuerza tanto por nosotros...\r\nQuiero hacer algo por él para\r\ncompensárselo. ¿Qué se te ocurre?",
  "TA_COM000_0020_CER": "¿Qué es esto?...",
  "AC_NARRATION240_0010": "Las aguas, puras y cristalinas,\r\nllenaban de vida el bosque de Ávalon.",
  "CORE_WISP_TALK_23_H09": "Gracias por tu inestimable ayuda.\r\nY ahora no vayas a caer rendida\r\nante mi arrebatador encanto, ¿eh?",
  "AC_NARRATION215_0010": "Este era el refugio secreto\r\nde los fuegos fatuos, oculto\r\nen el corazón del bosque.",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "Muerte inminente",
  "CORE_HTDMMESS_0028_001_H28": "Si me sobrepongo al dolor, ¡las hadas\r\nno me darán miedo nunca más!\r\nEnséñame a soportarlo, anda...",
  "CORE_DIALOG_TXT_119": "Has recibido el atuendo\r\n«Bruja mocosa».",
  "CORE_WISP_TALK_14_02_H16": "Dentro hay muchas hadas, pero...\r\nEn fin, espero que todo salga bien.",
  "CORE_HTDMMESS_0017_001_H17": "¡A por el pez gordo! ¡Ven, pescadito!...\r\n¡Oye, tú, bruja! ¿Te sobra un cebo?",
  "AC_NARRATION250_0020": "La arena y la suave brisa eran un bálsamo\r\npara Cereza, que empezó a pensar que las\r\nhadas no eran tan malas como las pintaban.",
  "CORE_DIALOG_TXT_011": "No es posible viajar\r\na la zona designada.",
  "AC_CEREZA145_0010": "¡Para! ¡Deja de hablar!",
  "CORE_DIALOG_TXT_002": "Existen datos de guardado\r\nanteriores en este archivo.\r\n¿Quieres sobrescribirlos?",
  "CORE_HAIR_CERESSA_TXT_04": "Un nuevo capítulo",
  "CORE_DIALOG_TXT_111": "Has recibido el atuendo\r\n«Cisne elegante».",
  "CORE_DIALOG_TXT_102": "¿Quieres cambiar\r\nel atuendo de Cereza?",
  "CORE_WISP_TALK_62_COL": "Cuánto me alegro de que todos estén\r\na salvo. ¡Muchas gracias, Cereza!",
  "CORE_SNPSS_4030": "Cereza rescata a Cheshire,\r\nque está gravemente herido.\r\nEl lobo blanco desaparece\r\nen la fortaleza, y la pareja\r\ndecide buscarlo.",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "Logro",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "Cadenas malditas",
  "CORE_POSEMENU_TXT_05": "Vuelve a empezar desde\r\nel último punto de control\r\ndel tír na nÓg.",
  "CORE_SNPSS_1010": "Afligida aún por verse\r\nseparada de Rosa —su madre—,\r\nCereza se convierte en\r\naprendiz de la hechicera\r\nMorgana y entrena a diario\r\npara convertirse\r\nen una poderosa bruja.",
  "CORE_HTDMQUEST_TXT_0032": "Quiero darle algo a mi amigo\r\npara levantarle la moral.\r\n¿Qué se te ocurre?",
  "CORE_HTDMQUEST_TXT_0021": "Busco un accesorio que realce\r\nmis ya bellas facciones.\r\n¿Tienes algo que me sirva?",
  "CORE_POSEMENU_TXT_01": "Cambia diversos ajustes del juego.",
  "AC_IGNIS005_0010": "Hola. ¿Necesitas mis servicios?\r\n¡Conozco todos los atajos\r\ny caminos secretos!",
  "CORE_SNPSS_3020": "Gracias a la mente despierta\r\nde Cereza, la pareja consigue\r\nespantar al monstruo.\r\nCon confianzas renovadas,\r\nretoman su misión.",
  "CORE_SVSLT_TXT_01": "Selecciona un archivo de guardado.",
  "CORE_DIALOG_TXT_115": "Has recibido los atuendos\r\n«Ojo Derecho» y\r\n«Observadora del tiempo».",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "Fugacidad",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "Granizo",
  "CORE_HTDMMESS_0015_002_H15": "¡Hola! Espera, acabo de apuntar\r\nunas cuantas notas sobre esta\r\nplanta y te atiendo en un tris.",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "Requisitos: Encuentra los tesoros\r\nde todos los tír na nÓg y...",
  "CORE_DIALOG_TXT_006": "Una vez borrados,\r\nno se podrán recuperar.\r\n¿Seguro que quieres\r\neliminarlos?",
  "CORE_MISSION_TEXT_0007": "¡Supera los obstáculos\r\ny conquista el tír na nÓg!",
  "CORE_COSTUME_CHESHIRE_TXT_03": "Solo tengo que encontrar mi sombrero\r\ny todo irá como la seda. ¡No les hagas\r\ncaso a los que dicen que estoy loco!",
  "CORE_DIALOG_TXT_160": "¿Quieres activar los\r\ntutoriales en esta partida?\r\nPuedes desactivarlos\r\ndesde el menú de opciones.",
  "AC_CEREZA060_0030": "Por ahí no.",
  "CORE_HTDMMESS_0008_001_H08": "Quiero ser fuerte... ¡Lo suficiente para\r\nenfrentarme a cualquier hada! ¿Me ayudas?",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "Resentimiento (Prueba)",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "Demencia (Prueba)",
  "CORE_CSRELEASE_CERESSA_TXT_04": "Requisitos: Aprende\r\ntécnicas con Cereza y...",
  "TEST_WISP_TALK_10": "Ufff... Me alegro de haber escapado,\r\npero odio las alturas...",
  "TEST_WISP_TALK_03": "¡Muchas gracias!\r\n¡Sígueme y abriré la puerta!",
  "CORE_HTDMMESS_0015_003_H15": "¡Es... raíz de mandrágora!\r\n¡Y en perfecto estado!\r\nTengo que investigarla ipso facto.",
  "AC_CEREZA050_0010": "Sola no sirves para nada.\r\nPero ya vendrá alguien a salvarte, ¿verdad?",
  "CORE_WISP_TALK_44_H30": "¡Mira que haberme dejado atrapar!\r\n¡Pienso proteger a los demás\r\npara compensar mi error!",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "Afligida aún por verse\r\nseparada de Rosa —su madre—,\r\nCereza se convierte en\r\naprendiz de la hechicera\r\nMorgana y entrena a diario\r\npara convertirse\r\nen una poderosa bruja.",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "Venganza",
  "CORE_SNPSS_2020": "Tras reunirse con Cheshire,\r\nla pareja encuentra la Torre\r\nde las Hadas, donde torturan\r\na los fuegos fatuos,\r\ny consigue entrar en ella.",
  "CORE_NPC_TXT_11": "Usa ingredientes para preparar\r\npócimas.",
  "TEST_WISP_TALK_07": "¡Mucho cuidado! Ese circo terrorífico\r\nestá un poco más adelante...",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "Luz inquietante (Prueba)",
  "AC_NARRATION225_0010": "Destruidos todos los núcleos elementales,\r\nlas barreras habían caído al fin.",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "Feudo (Prueba)",
  "CORE_MISSION_TEXT_0003": "¡Los golpes enemigos son letales!\r\nEvítalos y acaba con todos.",
  "CORE_WISP_TALK_34_H20": "Arg, me duele todo...\r\nPero gracias por salvarme, brujita.",
  "CORE_WISP_TALK_54_H40": "Regreso tras una eternidad de sufrimiento.\r\nAhora podré vivir de nuevo...",
  "CORE_DIALOG_TXT_090": "Elige un archivo para guardar\r\nla partida terminada. En ella\r\npodrás seguir buscando secretos\r\no completar zonas sin acabar.",
  "CORE_CSRELEASE_CERESSA_TXT_08": "Requisitos: Completa\r\nlas hazañas de Jeanne y...",
  "CORE_WISP_TALK_14_H16": "Si logramos bajar la palanca,\r\n¡podrás entrar en la torre!",
  "CORE_BAND_CHESHIRE_TXT_02": "Patas robustas",
  "AC_NARRATION260_0020": "Los pacíficos habitantes del bosque cantaron\r\nlas hazañas de la bruja amable y su leal\r\ncompañero durante largos años.",
  "CORE_COSTUME_CERESSA_TXT_07": "Una bruja fuerte y amable que quiere\r\nsalvar a su amiga a toda costa. Pase\r\nlo que pase, el mañana es suyo.",
  "CORE_DIALOG_TXT_031": "¿Quieres salir del tír na nÓg?",
  "TA_COM025_0020_CER": "¡Vale!",
  "CORE_WISP_TALK_14_03_H16": "¡Gracias por ayudar a mis amigos!\r\nVoy corriendo a decírselo a los demás...",
  "CORE_SNPSS_6020": "Púca convoca a un ejército\r\npara detener a Cereza, quien,\r\na lomos de Cheshire,\r\nse dirige hacia un pilar\r\nde luz creado por Morgana.",
  "AC_NARRATION235_0020": "Ante el temible estruendo\r\nde los rápidos, Cereza\r\nse sentía diminuta.",
  "CORE_WISP_TALK_49_H35": "¡Bien, parece que ya estoy a salvo!\r\nHora de ponerse a inventar otra vez...",
  "CORE_SNPSS_4010": "Las hadas crean una ilusión\r\nde la madre de Cereza que\r\nlleva a esta a pelearse con\r\nCheshire. Tras separarse,\r\nCereza se dirige en solitario\r\na la fortaleza.",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "Valentía",
  "TA_COM025_0010_CER": "¡Uf!",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "Caída libre",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "Limitaciones",
  "CORE_RETRY_TXT_01": "¿Quieres usar los objetos\r\nseleccionados para\r\ndesbloquear este tír na nÓg?",
  "AC_CEREZA015_0020": "No te preocupes; te salvaré.",
  "CORE_COSTUME_CERESSA_TXT_03": "La muchacha decide escribir un libro\r\nsobre las peculiaridades de esta\r\nextraña tierra... si logra regresar.",
  "CORE_SNPSS_1030": "Cereza encuentra a Cheshire\r\ny, juntos, comienzan la\r\nbúsqueda del lobo blanco.\r\nEsperan que este preste su\r\nincreíble poder a Cereza para\r\nque pueda enviar a Cheshire\r\nde nuevo a su hogar, Inferno.",
  "CORE_HTDMMESS_0037_001_H37": "Aprecio la tranquilidad de estos\r\nlares, pero me apetece probar\r\nsensaciones nuevas... ¿Alguna idea?",
  "CORE_WISP_TALK_39_H25": "¡Q-qué f-frío! Pensé que me iba a convertir\r\nen un cubito de hielo... ¡Gracias!\r\nEsas hadas me las pagarán algún día...",
  "CORE_HTDMQUEST_TXT_0006": "Ojalá tuviese una aguja para coser.\r\n¿Sabes dónde puede haber una?",
  "CORE_HTDMQUEST_TXT_0015": "Hace mucho que no investigo\r\nnada sobre las plantas.\r\n¿Podrías echarme una mano?",
  "CORE_BAND_CHESHIRE_TXT_01": "Por defecto",
  "CORE_MISSION_TEXT_0008": "¡Derrota a las hadas enemigas!",
  "CORE_HTDMMESS_0029_002_H29": "Desde que me atraparon las hadas...\r\ntodo me parece un incordio.",
  "CORE_WH_TALK_03_COL": "Malditas hadas...\r\n¿Por qué se empeñan en ser tan malas?",
  "CORE_WH_TALK_19_COL": "Todo el mundo quiere daros las gracias.\r\n¡Venga, chicos, no os cortéis!",
  "CORE_WISP_TALK_63_FAS": "Si alguna vez te pierdes en el bosque,\r\navísame: yo te puedo ayudar.",
  "CORE_NPC_TXT_09": "Afronta un tír na nÓg de nuevo\r\no juega su modo contrarreloj.",
  "CORE_DIALOG_TXT_121": "Has recibido el atuendo\r\n«Observadora del tiempo».",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "Ilusión",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "Calamidad",
  "CORE_WH_TALK_16_COL": "Cereza, Cheshire... ¡Gracias por todo!\r\nTomad, os lo habéis ganado.",
  "CORE_COSTUME_CERESSA_TXT_04": "«Serás idiota... ¡Mándame de vuelta\r\na Inferno o te zampo en tres bocados!»\r\nComo para tomárselo a la ligera...",
  "CORE_DIALOG_TXT_021": "¿Comenzar a preparar la pócima?",
  "CORE_DIALOG_TXT_032": "¿Reiniciar el tír na nÓg?\r\n(Perderás el progreso actual.)",
  "CORE_SNPSS_6030": "Morgana revela su verdadero\r\nplan: sacrificar a Cheshire\r\npara salvar a su hijo.\r\nCereza hace acopio de valor\r\npara enfrentarse\r\na su antigua maestra.",
  "CORE_WISP_TALK_36_H22": "¿P-puedo moverme?... ¡Menos mal!\r\n¡Gracias por haberme salvado!",
  "AC_NARRATION250_0010": "El colorido de los árboles y el suave mecer\r\nde las olas contrastaban con la habitual\r\nlobreguez del bosque de Ávalon.",
  "TEST_WISP_TALK_12_H00": "¡Huy, qué poco ha faltado!\r\n¡Con un fuego fatuo más llegaría!",
  "CORE_HTDMMESS_0004_003_H04": "Gracias, te debo una muy grande.\r\n¿Cómo dices? ¿Un refugio?... ¿¡Dónde!?\r\n¡Allí sí que estaría a salvo!",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "Fatalidad",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "Pinchazo",
  "TA_COM015_0010_CER": "¡Bien!",
  "CORE_RETRY_TXT_02": "¿Quieres reintentar\r\neste tír na nÓg?",
  "TEST_WISP_TALK_08": "Si te encuentra el jefe, se acabó\r\nlo que se daba... Ándate con ojo.",
  "CORE_SNPSS_3010": "Un monstruo ataca por\r\nsorpresa a Cereza y a\r\nCheshire, cuyas garras\r\nparecen incapaces de penetrar\r\nla armadura de la temible\r\ncriatura. Transida por el\r\nmiedo, Cereza huye\r\npor el bosque tratando\r\nde ocultarse.",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "Compresión (Prueba)",
  "CORE_SNPSS_1020": "Cereza decide confiar en las\r\npalabras del niño de sus\r\nsueños y, en contra de las\r\nadvertencias de su maestra,\r\nse adentra en la espesura\r\ndel gran bosque, luchando\r\ncontra sus propios miedos.",
  "CORE_HTDMMESS_0013_003_H13": "¡Alucinante! Lo has conseguido de verdad.\r\nAmiga, eres un tesoro.",
  "CORE_HTDMMESS_0026_001_H26": "No conviene descuidar la imagen jamás.\r\nPor eso... quiero que me traigas una flor,\r\nsi tienes tiempo.",
  "CORE_DIALOG_TXT_170": "En las hazañas de Jeanne,\r\nla partida se guarda de forma\r\nautomática en ciertos puntos. No\r\nes posible guardar manualmente.",
  "AC_CEREZA060_0020": "No sé qué voy a hacer contigo.\r\nNo tienes remedio.",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "Protección (Prueba)",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "Pinchazo (Prueba)",
  "CORE_CSRELEASE_CERESSA_TXT_07": "Requisitos: Completa\r\nLeyenda prohibida y...",
  "CORE_HTDMMESS_0021_003_H21": "¡Es perfecto! ¡Justo lo que buscaba!\r\nMe dejas sin palabras... ¡Voy a enseñárselo\r\nya mismo a todo el mundo!",
  "CORE_NPC_TXT_05": "Guarda el progreso de la partida.",
  "CORE_MISSION_TEXT_0004": "¡Derrota a todos los rivales y evita\r\nlas maldiciones que lanzan al morir!",
  "CORE_WH_TALK_20_COL": "Todavía quedan muchos fuegos fatuos\r\nen el bosque. ¡Tenéis que ayudarnos!",
  "CORE_COSTUME_CERESSA_TXT_08": "«He superado mil obstáculos y\r\nme he rencontrado a mí misma.\r\nSé que me reuniré con mi príncipe.»",
  "AC_IGNIS015_0010": "¿Te orientas bien por el bosque?\r\nSi necesitas que te lleve por algún\r\ncamino secreto, ¡avísame!",
  "AC_NARRATION215_0020": "Gracias a Cereza y a Cheshire,\r\nvolvían a oírse gritos de alegría\r\nen su interior.",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "Feudo",
  "CORE_WH_TALK_10_COL": "¡Hola, Cereza y... compañía felina!\r\n¿Qué tal? Os echaba de menos.",
  "CORE_ARCHIVE_TXT_99": "Sección actualmente bloqueada",
  "CORE_SNPSS_2030": "Cereza y Cheshire rescatan\r\na los amigos de Colm de las\r\ngarras de las hadas. Tras\r\nel feliz rencuentro entre\r\nlos fuegos fatuos, la pareja\r\ndecide seguirlos.",
  "CORE_WISP_TALK_70_FAS": "Si te pierdes en algún momento,\r\nbusca las huellas del lobo blanco.\r\nÉl te guiará tan bien como yo.",
  "CORE_WISP_TALK_65_FAS": "¿Has encontrado huellas de lobo?\r\nSi quieres, te puedo llevar cerca\r\nde algunas.",
  "AC_CEREZA155_0010": "Para de una vez... ¡Por favor!",
  "CORE_COSTUME_CHESHIRE_TXT_04": "[FONT:10 ]¡Voy a ser una bruja muy poderosa!\r\n¡Y voy a salvar a mi mamá y tal y cual!\r\nMmm... Excelente interpretación.[FONT:N ]",
  "AC_NARRATION240_0020": "Cereza y Cheshire bebieron hasta\r\nsaciarse y recuperaron sus fuerzas\r\nde inmediato.",
  "TEST_WISP_TALK_04": "¡Pensaba que me crecería el cuello!\r\n¡Mucho cuidado con las hadas, amiga!",
  "CORE_CSRELEASE_CERESSA_TXT_03": "Requisitos: Logra buenas marcas\r\nen misiones contrarreloj y...",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "Caída libre (Prueba)",
  "CORE_WH_TALK_05_COL": "Nos estamos turnando para montar\r\nla guardia. ¡No vamos a permitir\r\nque las hadas descubran el refugio!",
  "CORE_WH_TALK_22_COL": "Perdonad que siempre os esté\r\npidiendo ayuda, pero, por favor...\r\nsalvad a nuestros amigos.",
  "CORE_BAND_CHESHIRE_TXT_04": "Vendas de afecto",
  "CORE_WISP_TALK_58_FAS": "Cuidado con las hadas. La palabra «piedad»\r\nno está en su diccionario...",
  "AC_IGNIS200_0010_0020": "El camino secreto nos aguarda...",
  "TEST_WISP_TALK_09": "Voy a esconderme aquí.\r\n¡No se lo cuentes a nadie!",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "Evasión (Prueba)",
  "AC_CEREZA030_0010": "Cobarde... ¡Estás destinada a fracasar!",
  "CORE_SNPSS_2060": "Tras destruir el segundo\r\nnúcleo elemental, Cereza\r\ny Cheshire prueban sus nuevos\r\npoderes mientras reanudan\r\nla búsqueda del lobo blanco.",
  "CORE_HTDMMESS_0021_001_H21": "Odio pasar desapercibido... Búscame algo\r\nque me convierta en el foco de atención.\r\n¡Algo que me haga brillar de verdad!",
  "CORE_WISP_TALK_57_FAS": "Pues nada, ve a por equipo de escalada\r\ny un bañador. ¡Tienes mucha tarea\r\npor delante!",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "Ataduras",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "Perseverancia",
  "CORE_HTDMMESS_0013_001_H13": "Oye, amiga... ¿me ayudas?\r\nQuiero celebrar un ritual que\r\nme convierta en lo que aspiro a ser.",
  "CORE_HTDMMESS_0026_003_H26": "¡Hala! ¡Eres una bruja increíble!\r\n¡Te mereces un beso por salada!",
  "CORE_COSTUME_CERESSA_TXT_01": "Una joven bruja, que viaja a Ávalon\r\npara salvar a su madre, se topa\r\ninesperadamente con un demonio.",
  "CORE_SNPSS_6035": "Cereza presencia el final\r\nde Morgana y Lukaon,\r\nvíctimas de un cruel\r\ny trágico destino.\r\nEntonces se da media\r\nvuelta para despedirse\r\nde Cheshire por última\r\nvez...",
  "CORE_COSTUME_CERESSA_TXT_05": "Ropas que a Cereza ya no le sirven.\r\nLe traen a la memoria la búsqueda\r\nde su madre.",
  "CORE_DIALOG_TXT_033": "¿Reiniciar el tír na nÓg?",
  "CORE_WISP_TALK_67_FAS": "El lobo blanco parece estar lejos,\r\npero ¡no es problema para Ignis!",
  "AC_NARRATION245_0010": "El paso del tiempo había hecho mella\r\nen el palacio, pero no lo había desprovisto\r\npor completo de su majestuosidad.",
  "CORE_WH_TALK_07_COL": "¡El refugio está a reventar!\r\nEspero que se convierta\r\nen un lugar seguro para todos.",
  "CORE_DIALOG_TXT_120": "Has recibido el atuendo\r\n«Ojo Derecho».",
  "CORE_HTDMMESS_0023_002_H23": "Por favor... dime que me ayudarás\r\na encontrar algo con lo que\r\nllenarme el buche...",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "Demencia",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "Prisión de espinas",
  "CORE_HTDMMESS_0039_002_H39": "¡Aaaachús! Pensé que al convertirme\r\nen fuego fatuo había dicho adiós\r\na los resfriados...",
  "CORE_WISP_TALK_68_FAS": "Es fácil desorientarse en el bosque\r\nde Ávalon... ¿Quieres que te lleve\r\ncerca del lobo blanco?",
  "CORE_WH_TALK_12_COL": "He estado haciendo ejercicio. ¿Se nota?\r\n¡Se van a enterar esas apestosas hadas\r\nla próxima vez que me vean!",
  "CORE_WISP_TALK_24_H10": "Gracias, guapa. Oye... ¿te importa\r\nque vayamos juntos un rato?",
  "CORE_WH_TALK_08_COL": "¿Sabes que hemos creado una patrulla?\r\nAunque las hadas sean más fuertes\r\nque nosotros, de algo servirá...",
  "CORE_WISP_TALK_33_H19": "Gracias. Solo has necesitado\r\n34 506 250 segundos para salvarme.",
  "AC_NARRATION210_0010": "Alrededor de la base de la inmensa\r\ntorre, construida por las hadas,\r\nhabía todo tipo de artilugios.",
  "AC_NARRATION255_0020": "¿Cuánto tiempo había hecho falta\r\npara que creciera semejante número de\r\nnenúfares? La estampa era impresionante.",
  "TEST_WISP_TALK_05": "No puedo ni con las más pequeñas...\r\nQué inútil soy...",
  "CORE_CSRELEASE_CERESSA_TXT_02": "Requisitos: Salva a suficientes\r\nfuegos fatuos y...",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "Duelo (Prueba)",
  "CORE_HTDMMESS_0006_002_H06": "Mmm... Estas agujas no sirven para nada.\r\n¿Cómo voy a trabajar así?",
  "CORE_MISSION_TEXT_0001": "¡Usa la brida espinosa para atrapar\r\ny derrotar a todos tus enemigos!",
  "CORE_HTDMMESS_0034_002_H34": "Trabajo de vigilante, pero, con la garganta\r\nasí... ¿cómo voy a avisar a los demás\r\nsi encuentro algún peligro?",
  "CORE_WH_TALK_14_COL": "¡El refugio sigue creciendo!\r\nQuedaos un rato y jugad\r\ncon nosotros, ¿vale?",
  "CORE_COSTUME_CHESHIRE_TXT_05": "Comprado en «Pygmalion», famosa\r\ntienda de juguetes. Nota: Jugarás\r\ncon Jeanne y Charles.",
  "CORE_COSTUME_TXT_01": "Elige el atuendo que quieras ponerte.",
  "CORE_SNPSS_1070": "Tras destruir el primer\r\nnúcleo elemental, Cereza\r\ny Cheshire siguen\r\nadentrándose en el bosque\r\npara hallar los otros tres.",
  "TA_COM020_0010_CER": "Oooh...",
  "CORE_WH_TALK_01_COL": "Hola, Cereza. ¿Has encontrado\r\na alguno de nuestros amigos?",
  "AC_NARRATION200_0020": "El viento arrastraba, desde\r\nlas profundidades del bosque,\r\nel eco de un poder misterioso.",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "Proyección oscura",
  "CORE_SNPSS_3040": "Cereza y Cheshire destruyen\r\nel tercer núcleo elemental\r\ny marchan en pos del último,\r\naprovechando sus nuevos\r\npoderes.",
  "CORE_WISP_TALK_61_FAS": "Colm te envía un mensaje: «¡Quiero\r\nvolver a verte! ¡Pásate cuando puedas!».",
  "CORE_EVENT_PAUSE_TXT_01": "Pulsa [BTN:START ] para continuar.",
  "CORE_WISP_TALK_16_H02": "Gracias. Me vuelvo al refugio a pensar\r\nen nuevas medidas de seguridad...",
  "TA_COM020_0020_CER": "Oooh...",
  "AC_IGNIS200_0000_0010": "¡No te entretengas!",
  "CORE_COSTUME_CERESSA_TXT_09": "Atuendo tradicional de aprendiz de\r\nbruja portado por la rival de Cereza.\r\nNota: Jugarás con Jeanne y Charles.",
  "CORE_HTDMMESS_0004_001_H04": "A veces siento que necesito esconderme.\r\n¿Quizás camuflándome con una planta?...\r\n¡Ayúdame, por favor!",
  "CORE_MISSION_TEXT_0005": "¡Usa los elementos correctos para\r\neliminar las barreras de tus enemigos!",
  "CORE_COSTUME_CHESHIRE_TXT_01": "Un demonio perdido con muy mal genio.\r\nNi siquiera su nuevo y peluchoso\r\ncuerpo puede contener sus impulsos.",
  "TEST_WISP_TALK_55_COL": "¡Hay más de los nuestros atrapados\r\nen esa torre! ¡Sálvalos, te lo ruego!",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "Escaramuza (Prueba)",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "Perseverancia (Prueba)",
  "TEST_WISP_TALK_01": "¡Gracias, amiga!",
  "CORE_SNPSS_4050": "La pareja consigue destruir\r\nel último núcleo elemental\r\ny abandonan el santuario\r\narmados con nuevos poderes.",
  "CORE_MISSION_TEXT_0002": "¡Derrota a los enemigos antes\r\nde que acabe el tiempo! El límite\r\nse extenderá por cada rival derrotado.",
  "CORE_WISP_TALK_19_H05": "¡Qué ligero me siento!\r\n¡Gracias, cuca! ¡Nos vemos!",
  "AC_NARRATION230_0010": "Ante ellos se alzaba un magnífico árbol,\r\ncuyas níveas ramas, interminables,\r\nllegaban hasta donde alcanzaba la vista.",
  "CORE_DIALOG_TXT_091": "¡Enhorabuena! Nuevas opciones:\r\n- Elegir la dificultad en partidas nuevas\r\n- Historia especial de Jeanne\r\n- Menú de atuendos",
  "CORE_HTDMMESS_0028_002_H28": "A ver, dejemos clara una cosa: lo de que\r\nel dolor es un placer era una exageración.\r\nNo me tengo por masoquista...",
  "CORE_NPC_TXT_10": "Cambia los atuendos de Cereza y de Cheshire.",
  "TEST_WISP_TALK_06": "Atraparon a todos mis amigos...\r\nNo he vuelto a verlos jamás.",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "Cadenas malditas (Prueba)",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "Logro (Prueba)",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "La burla",
  "CORE_SNPSS_3050": "Cereza y Cheshire descubren\r\nque el último núcleo está\r\nen la fortaleza de Púca.\r\nCereza decide arriesgarse\r\na entrar en ella por el bien\r\nde Lukaon... y por el suyo\r\npropio.",
  "CORE_SNPSS_1060": "Cereza logra comunicarse con\r\nMorgana gracias a un hechizo,\r\ny esta le cuenta las\r\ndificultades que entraña\r\nsalir del bosque. Cereza\r\ndecide buscar una vez más\r\nal lobo blanco.",
  "CORE_WISP_TALK_26_H12": "¿Libre al fin?... Me da miedo, pero...\r\n¡tengo que ser fuerte!",
  "CORE_HTDMMESS_0032_002_H32": "Estaba buscando algo para Colm...\r\ny he acabado perdiéndome.",
  "TA_COM010_0010_CER": "Mmmmm...",
  "AC_CEREZA045_0010": "¿Huyes, para variar?\r\nNo me sorprende lo más mínimo...",
  "CORE_HTDMMESS_0037_003_H37": "Caray... qué olor tan potente...\r\nMás me vale volverme al refugio\r\nantes de que las hadas lo detecten.",
  "TA_COM010_0020_CER": "Mmm...",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "Muerte inminente (Prueba)",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "Transporte (Prueba)",
  "CORE_CSRELEASE_CERESSA_TXT_05": "Requisitos:\r\nReúne recuerdos y...",
  "TEST_WISP_TALK_02": "¡Sígueme! Voy a abrir la puerta...",
  "CORE_SNPSS_4040": "Tras derrotar a Púca,\r\nel autoproclamado rey de las\r\nhadas, y al ángel que había\r\ninvocado, Cereza y Cheshire\r\nprosiguen la búsqueda del\r\núltimo núcleo elemental.",
  "CORE_MISSION_TEXT_0006": "¡Apresúrate! Tu nivel disminuye\r\ncon el paso del tiempo.",
  "CORE_COSTUME_CHESHIRE_TXT_02": "El demonio maldice a la princesa\r\ny su búsqueda del amor verdadero.\r\nEste Cheshire no entiende nada...",
  "CORE_HTDMQUEST_TXT_0008": "Quiero hacerme más fuerte. Tú eres\r\nuna bruja... ¿No se te ocurre nada?",
  "CORE_SNPSS_2070": "La pareja busca el tercer\r\nnúcleo elemental, del que\r\nse dice que yace en el fondo\r\ndel lago Nimueh. Para drenar\r\nel lago, Cereza debe trepar\r\nal árbol más alto del bosque.",
  "CORE_HTDMMESS_0015_001_H15": "Te aseguro que este bosque está plagado\r\nde maravillas. Si te topas con alguna\r\nplanta peculiar, ¡avísame!",
  "CORE_HTDMQUEST_TXT_0013": "Quiero algo que me eleve...\r\na otro plano de existencia.\r\n¿Me ayudas, por favor?",
  "CORE_COSTUME_CERESSA_TXT_02": "Una bailarina que interpreta a una\r\nprincesa destinada a convertirse en\r\ncisne blanco y relata su historia danzando.",
  "AC_IGNIS020_0010": "Ávalon es un bosque peligroso...\r\nConocer los caminos secretos\r\nsiempre resulta útil.",
  "CORE_HTDMMESS_0008_003_H08": "¿Así me volveré más fuerte? ¡Uf, qué peste!\r\nVale, regresaré al refugio para probar...\r\n¡Gracias!",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "Duelo",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "Rotación",
  "CORE_DIALOG_TXT_130": "Estás aproximándote\r\nal final de la historia.\r\n¿Quieres continuar?",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "Guía",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "Luz inquietante",
  "AC_CEREZA135_0010": "Yo... ¡Yo...!",
  "AC_NARRATION220_0020": "En su punto más alto se abría una gran\r\nfisura, retorcida como una sonrisa\r\nmalévola. ¿Qué tramaban las hadas?...",
  "CORE_COSTUME_CERESSA_TXT_06": "Tras un sueño de medio milenio,\r\nal principio es prisionera del destino,\r\npero pronto toma las riendas de su vida.",
  "CORE_DIALOG_TXT_030": "¿Quieres reiniciar el nivel?\r\nPuedes conservar los objetos\r\nque hayas obtenido hasta ahora.",
  "CORE_HTDMQUEST_TXT_0004": "Tener siempre miedo es un rollo.\r\nSi pudiera encontrar un buen escondite...",
  "CORE_HTDMQUEST_TXT_0017": "¡Para pescar hace falta un buen\r\ncebo! ¿Me buscas uno?",
  "CORE_BAND_CHESHIRE_TXT_03": "Un desliz lamentable",
  "CORE_CSRELEASE_CERESSA_TXT_09": "Requisitos: Completa\r\nlas hazañas de Jeanne y...",
  "CORE_HTDMMESS_0017_002_H17": "Aquí los pescaditos están bien gordos,\r\npero son la mar de suspicaces. Si no tengo\r\ncuidado, ¡acabaré haciendo de cebo yo!",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "Vehemencia",
  "CORE_DIALOG_TXT_118": "Has recibido el atuendo\r\n«Sombrerero loco».",
  "CORE_SNPSS_1040": "Cereza y Cheshire encuentran\r\nal lobo blanco, que escapa\r\nenseguida. Vuelven a seguir\r\nsus pasos, adentrándose\r\nmás y más en el bosque.",
  "AC_NARRATION200_0010": "Cereza percibió un agradable\r\ny penetrante aroma que provenía\r\nde los árboles,",
  "CORE_HTDMMESS_0017_003_H17": "¡Gracias, brujita! Pues nada, a seguir\r\npes... ¡Un momento! ¡Que me he olvidado\r\nla caña!",
  "CORE_DIALOG_TXT_156": "Si te cuesta superar los\r\ncombates, puedes cambiar\r\nlos ajustes de fuerza del\r\nenemigo o del daño sufrido.",
  "AC_NARRATION255_0010": "Cereza y Cheshire encontraron un estanque\r\ncon más nenúfares de los que la vista\r\npodía abarcar.",
  "CORE_ARCHIVE_TXT_01": "Personajes de la historia",
  "CORE_DIALOG_TXT_152": "Cambia el tipo de control de los combos\r\nde bridas y «¡Ñam!». «Mantener/Soltar»\r\nte ofrece mayor control, pero con «Pulsar»\r\nejecutarás las técnicas con más rapidez.",
  "LV_009911_0010_NAR": "Parece que Cheshire se niega a moverse.\r\nSu gesto dice: «¿Por qué no lo haces tú?».",
  "CORE_ARCHIVE_TXT_05": "Fuegos fatuos ayudados",
  "CORE_SNPSS_4060": "Cereza y Cheshire han logrado\r\nal fin destruir los cuatro\r\nnúcleos elementales.\r\nGuiados por el lobo blanco,\r\nse ponen en marcha\r\npara encontrarse con Lukaon.",
  "CORE_HTDMQUEST_TXT_0028": "¡Dolor!... ¡Quiero dolor!\r\nTú... ¡Dame el dolor que necesito!",
  "CORE_WISP_TALK_38_H24": "(Cereza presta atención,\r\npero solo escucha ruidos...)",
  "CORE_HTDMMESS_0008_002_H08": "Soy un cazador, así que lo lógico\r\nes que dispare yo la flechas...\r\n¡y no que me las lancen a mí!",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "Requisitos: Encuentra\r\npáginas de diario y...",
  "CORE_DIALOG_TXT_114": "Has recibido el atuendo\r\n«Días de antaño».",
  "CORE_WISP_TALK_45_H31": "Gracias por ayudarme. Por cierto...\r\n¿sabes si mis plantas están bien?",
  "CORE_HTDMMESS_0037_002_H37": "Trabajar es mi pasión, pero Ávalon\r\nes un lugar aterrador. A veces necesito\r\ndesconectar de la presión de este bosque.",
  "CORE_HAIR_CERESSA_TXT_01": "Por defecto",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "Compresión",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "Luz avasalladora",
  "CORE_WISP_TALK_52_H38": "Por fin llegan los refuerzos... Menos mal\r\nque he aguantado. Y ahora, de vuelta\r\na la rutina de siempre.",
  "CORE_SNPSS_2050": "Tras derrotar juntos a\r\nAmadán Dubh, el mandamás\r\ndel circo, Cereza y Cheshire\r\nregistran la carpa en busca\r\nde un núcleo elemental.",
  "TA_COM035_0020_CER": "¿¡Cómo!?",
  "AC_IGNIS010_0010": "¿Qué tal? ¡Estaba a punto\r\nde comenzar mi visita guiada\r\na los caminos secretos!",
  "CORE_POSEMENU_TXT_00": "Mueve el cursor para seleccionar.",
  "CORE_HTDMQUEST_TXT_0037": "Creo que necesito un cambio\r\nen mi vida. Quizá un nuevo\r\naroma me bastaría...",
  "CORE_POSEMENU_TXT_04": "Carga una partida guardada.",
  "AC_NARRATION210_0020": "Su confusa arquitectura era fiel\r\nreflejo de la mente retorcida\r\nde las hadas.",
  "TEST_GIMMICK_TALK_01": "Hay un balancín del tamaño\r\nideal para un fuego fatuo.",
  "CORE_WISP_TALK_41_H27": "Tuve una visión en la que me rescatabas...\r\n¿Será nuestro encuentro cosa del destino?",
  "TA_9012_0010_COL": "¡No hagas ninguna locura!",
  "CORE_HTDMMESS_0028_003_H28": "Perfecto... ¡Esto es lo que necesito!\r\nAsí nada podrá hacerme daño.\r\n¡Te veo en el refugio!",
  "TA_COM035_0010_CER": "¿Eh?",
  "AC_CEREZA150_0010": "¡Que te calles! ¡De eso nada!",
  "AC_CEREZA060_0040": "¡Venga, que te eternizas!",
  "AC_NARRATION245_0020": "Cereza recordó la historia de una reina\r\nde las hadas que, tiempo ha, habitaba\r\neste lugar.",
  "CORE_DIALOG_TXT_103": "¿Quieres cambiar\r\nel atuendo de Cheshire?",
  "CORE_HTDMMESS_0032_003_H32": "¡Gracias, a Colm le va a encantar!\r\nEn fin, creo que es hora\r\nde volver al refugio.",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "Aceleración",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "Escaramuza",
  "CORE_DIALOG_TXT_010": "No es posible seleccionar\r\ntu ubicación actual.",
  "CORE_DIALOG_TXT_117": "Has recibido el atuendo\r\n«Maldición de amor».",
  "CORE_DIALOG_TXT_104": "¿Quieres abrir el menú de atuendos?",
  "CORE_HAIR_CERESSA_TXT_02": "Trenzas de aprendiz",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "Origen",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "Liberación",
  "CORE_HTDMQUEST_TXT_0023": "Tengo... tanta hambre... Dame\r\nde comer algo rico... por favor...",
  "AC_CEREZA055_0010": "Eres una llorica malcriada.\r\n¡Vete a hacer pucheros a tu escondite!",
  "CORE_POSEMENU_TXT_03": "Vuelve a la pantalla del título.",
  "TEST_WISP_TALK_11_H00": "Lo siento... Para abrir la puerta,\r\nnecesitaré a dos amigos más.",
  "CORE_SNPSS_2040": "Los fuegos fatuos guían\r\na Cereza y a Cheshire\r\na su refugio secreto.\r\nAprovechan para descansar\r\ny, después, vuelven al bosque\r\npara buscar los núcleos\r\nelementales restantes.",
  "CORE_SVSLT_TXT_03": "Selecciona el archivo que quieras borrar.",
  "CORE_HTDMMESS_0006_003_H06": "¡Por fin! Esto sí que tiene la punta\r\nafilada. ¡Será una aguja perfecta!",
  "TA_COM005_0010_CER": "Oye, Cheshire...",
  "CORE_WH_TALK_15_COL": "¡Gracias por salvar a nuestros amigos!\r\nTomad esto como agradecimiento.",
  "CORE_HTDMMESS_0034_003_H34": "¡Gracias! Ahora me voy al refugio, pero,\r\ncuando me sienta mejor, ¡te cantaré\r\nalgo bonito como agradecimiento!",
  "CORE_WISP_TALK_50_H36": "¡Las hadas son lo peor!\r\n¡Casi me cortan la cabeza!",
  "CORE_HTDMQUEST_TXT_0034": "Arg... La garganta me va a matar.\r\nNo tendrás por ahí algún\r\nmedicamento, ¿verdad?",
  "CORE_POSEMENU_TXT_07": "Selecciona un archivo de guardado.",
  "AC_NARRATION220_0010": "La enorme fortaleza feérica se elevaba\r\ncomo una oscura amenaza entre\r\nlas sombras del bosque.",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "Requisitos: Completa\r\nlas hazañas de Jeanne y...",
  "CORE_WISP_TALK_60_FAS": "¿Por qué no te pasas algún día\r\npor el refugio? A los fuegos fatuos\r\nles haría muchísima ilusión verte.",
  "CORE_HTDMMESS_0029_001_H29": "Qué hastío... Todo me da pereza.\r\n¿Tienes un remedio? Bueno, ¡pero\r\nque sea rapidito!",
  "AC_CEREZA060_0050": "Ni siquiera controlas los elementos...\r\nLamentable.",
  "CORE_DIALOG_TXT_113": "Has recibido el atuendo\r\n«Demonio molesto».",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "Evasión",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "Protección",
  "CORE_HTDMMESS_0023_003_H23": "¡Hala, comida de verdad! ¡Gracias!\r\nTenía tanta hambre que casi\r\nte doy a ti un bocado...",
  "CORE_SNPSS_1050": "El niño de sus sueños le pide\r\na Cereza que destruya los\r\ncuatro núcleos elementales\r\nque hay en el bosque.\r\nCon este nuevo objetivo,\r\nella y Cheshire reanudan\r\nla búsqueda del lobo blanco.",
  "CORE_WH_TALK_06_COL": "Los demás fuegos fatuos se esfuerzan\r\ntanto por colaborar... Tengo que dar\r\nel do de pecho.",
  "CORE_DIALOG_TXT_008": "Se cargarán estos datos\r\ny se perderá el progreso\r\nque no hayas guardado.\r\n¿Quieres continuar?",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "Rotación (Prueba)",
  "CORE_WISP_TALK_66_FAS": "Tu próximo objetivo está un poco lejos.\r\nVoy a enseñarte el camino.",
  "CORE_WH_TALK_09_COL": "Regla número 1 del refugio:\r\nNada de mezclar juegos con trabajo.\r\n¡Y no hay más reglas que valgan!",
  "CORE_DIALOG_TXT_155": "Puedes cambiar estos ajustes\r\ndesde el menú de opciones\r\ncuando quieras.",
  "CORE_ARCHIVE_TXT_02": "Enemigos de Cereza",
  "CORE_HTDMMESS_0039_003_H39": "¡Gracias, brujita! También he encontrado\r\nalgo de comer, así que igual va siendo\r\nhora de volver al refugio.",
  "AC_NARRATION230_0020": "Había sido el símbolo de los reyes\r\nde las hadas durante generaciones.",
  "CORE_WISP_TALK_69_FAS": "El lobo blanco parece estar cerca.\r\n¿Ves su rastro?",
  "CORE_WH_TALK_13_COL": "¿Habéis visto cómo ha crecido el refugio?\r\n¡Ahora tenemos todavía más sitios\r\npara jugar!",
  "CORE_SNPSS_6040": "Cereza ha aprendido mucho\r\ndurante sus andanzas por\r\nÁvalon. Con el recuerdo\r\nde sus amigos vivo en su\r\ncorazón, decide emprender\r\nun nuevo viaje.",
  "CORE_DIALOG_TXT_151": "Normalmente, los ataques especiales\r\nde Cheshire consumen magia, pero, si\r\nquieres jugar de manera relajada, elige\r\n\"Siempre llena\" para que nunca se agote.",
  "CORE_WH_TALK_23_COL": "¡Sois nuestros héroes!\r\nVolved por aquí siempre que os apetezca.\r\n¡Os recibiremos con los brazos abiertos!",
  "CORE_WISP_TALK_59_FAS": "He oído que Colm quiere verte.\r\nQuería comentarte algo, al parecer.",
  "CORE_WISP_TALK_47_H33": "Al fin a salvo... Es a ti a quien debo dar\r\nlas gracias, ¿verdad? Ay... ¿No podrían\r\ndejarnos en paz las hadas?",
  "CORE_WISP_TALK_56_FAS": "El siguiente núcleo está en el fondo\r\ndel lago. Y hace falta trepar a un\r\nárbol altísimo para llegar a él...",
  "CORE_HTDMMESS_0026_002_H26": "¿Por qué tienen que ser tan malas\r\nlas hadas? ¿No podemos llevarnos\r\ntodos bien?"
}
