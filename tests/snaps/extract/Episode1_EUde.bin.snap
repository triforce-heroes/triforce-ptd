{
  "BK_1000_0030_NAR": "Dies waren Feen. Ruchlose Kreaturen,\r\nwelche die Seelen jener Menschen\r\nfingen, die sich in den Wald wagten,\r\num sich an deren Energie zu laben.",
  "PH_1030_0000_CER": "„Ich spüre in dieser Pflanze\r\ndieselbe Energie wie vorhin...“",
  "BK_1060_0080_NAR": "[FONT:9 ]Wer möchte die Vorspeise sein\r\nund wen hebe ich mir zum Nachtisch auf?![FONT:N ]\r\nbrüllte Cheshire mit wallender Mähne und ausgefahrenen Krallen.",
  "LV_001070_0000_CER": "Scheint, als gäb es über\r\nuns auch einen Weg.",
  "BK_1060_0000_CER": "„Wo ist dieser Wolf\r\njetzt wieder hin?“",
  "PH_1b01_0010_NAR": "Die Zerstörung der Vorrichtung jenseits\r\ndes Risses hatte einen zuvor durch\r\nTrugbilder verhüllten Weg offenbart.",
  "IN_1000_0030_CER": "E-erschreckt mich doch nicht so!",
  "PH_1b01_0020_NAR": "Plötzlich entdeckten die zwei den weißen\r\nWolf. Ohne zu zögern folgten sie ihm.",
  "SM_001100_0140_MOR": "„Dieser Wald gehört den Feen, doch wenn du\r\ngründlich suchst, wirst du gewiss Objekte\r\nfinden, mit denen du deine magischen\r\nFähigkeiten weiterentwickeln kannst.“",
  "LV_001005_0010_CER": "Komm schon, Cereza.\r\nEinen Fuß vor den anderen.",
  "BK_1000_0000_NAR": "Cereza wurde das Gefühl nicht los,\r\ndass jemand sie beobachtete.",
  "SM_001020_0000_CER": "„Was ist los?“",
  "SM_001020_0080_NAR": "[FONT:9 ]Wie gedenkst du mich nach\r\nInferno zurückzuschicken?[FONT:N ]\r\nwollte der Dämon wissen.",
  "SM_001100_0260_CER": "„Gut, folgen wir weiter dem weißen Wolf.\r\nWenn wir jene Macht in die Finger\r\nkriegen, wird selbst die ach so\r\nmächtige Morgana beeindruckt sein!“",
  "SM_001090_0020_NAR": "einen zuvor durch Trugbilder\r\nverhüllten Weg offenbart.",
  "SM_001090_0020_NAR#2": "Plötzlich entdeckten die zwei den weißen\r\nWolf. Ohne zu zögern folgten sie ihm.",
  "SM_001040_0030_NAR": "Cereza rannte zu ihm, hob ihn auf\r\nund drückte ihn fest an sich.\r\nIn ihren Armen fühlte Cheshire,\r\nwie seine Kraft zurückkehrte.",
  "LV_001145_0000_NAR": "Der Pfad führte zu einer Reihe gewölbter\r\nBäume, die so gewachsen waren, dass sie\r\neinen Tunnel formten.",
  "BK_1010_0020_NAR": "Wie von einer unsichtbaren Macht\r\ngebunden, war es ihm unmöglich,\r\nCereza anzurühren, egal was\r\ner auch versuchte.",
  "SM_001040_0080_CER": "„Nun halt schon still! Solange du\r\nso klein bist, kannst du nicht\r\nselbst laufen, oder? Ich trage\r\ndich, bis du wieder in der Lage\r\nbist, dich zu verwandeln.“",
  "SM_001090_0010_NAR": "Die Zerstörung der Vorrichtung\r\njenseits des Risses hatte",
  "BK_1010_0010_NAR": "Doch was war das?\r\nDer Dämon kam nicht weiter.",
  "SM_001070_0040_NAR": "Das Mädchen und der Dämon\r\ntauschten verwirrte Blicke aus.",
  "BK_1020_0140_CER": "„W-was ist das denn?\r\nIch fühle mich ganz komisch...“",
  "BK_1020_0050_NAR": "Cheshire sprang aus Cerezas Armen\r\nund stürzte sich auf den Wolf.",
  "LV_001130_0010_NAR": "Cereza bemerkte eine blank polierte Felswand,\r\ndie sich womöglich als Ersatz für den Spiegel\r\nverwenden ließ, vor dem sie stets übte.",
  "BK_1010_0060_NAR": "Der Dämon ließ von seinem\r\nAngriff ab und wandte seine\r\nAufmerksamkeit etwas anderem zu.",
  "LV_001915_0000_CER": "Wie soll man sich hier denn zurechtfinden?",
  "LV_001080_0000_CER": "Ein weißer Wolf... Genau wie\r\njener Junge gesagt hatte!",
  "LV_001095_0010_NAR": "Eine kleine Lichtung von unbeschreiblicher\r\nSchönheit tat sich vor Cereza auf.",
  "PH_1010_0010_CER": "Ist... Ist da jemand?",
  "SM_001010_0080_NAR": "Der Dämon fixierte Cereza und\r\ngab ein tiefes Knurren von sich.",
  "SM_001040_0070_NAR": "[FONT:9 ]Lass mich sofort los![FONT:N ]\r\nAuch in diesem Zustand schien der\r\nDämon gar nicht glücklich darüber,\r\ngeknuddelt zu werden.",
  "SM_001100_0220_CER": "„W-was sagst du da?!\r\nMorgana ist meine Lehrerin,\r\nich lasse nicht zu, dass du\r\nso über sie sprichst!“",
  "SM_001010_0000_CER": "„Ch-Cheshire?“",
  "BK_1020_0020_NAR": "Cereza wollte sich gerade der Säule\r\nnähern, um sie zu untersuchen, als...",
  "SM_001070_0030_NAR": "Bei genauerer Betrachtung fielen\r\nihnen plötzlich Risse in der Luft\r\nauf, als hätte diese einen Sprung.",
  "BK_1020_0090_CER": "„Cheshire, hör doch\r\nbitte auf damit!“",
  "BK_1020_0010_NAR": "Davor saß der weiße Wolf.",
  "SM_001120_0030_CER": "„A-aber ich wette, diese Kraft wird\r\nuns auch irgendwie nützlich sein!“",
  "SM_001070_0000_NAR": "Gemeinsam suchten sie überall nach dem Wolf,\r\ndoch er war wie vom Erdboden verschluckt.",
  "LV_001095_0020_NAR": "Dieser düstere Wald schien\r\nnoch viele Geheimnisse zu bergen.\r\nCereza atmete ein klein wenig auf.",
  "LV_001915_0030_CER": "Hat dieser Armreif etwa die\r\nMacht, Trugbilder zu erkennen?",
  "SM_001010_0120_NAR": "Es war schon kompliziert genug,\r\neinen Dämon in diese Welt zu rufen.\r\nWie man ihn zurückschickt, hatte\r\nCereza noch gar nicht gelernt.",
  "SM_001010_0030_CER": "„Moment... Habe ich etwa einen Dämon\r\nbeschworen, der nun in Cheshire haust?“",
  "SM_001040_0040_NAR": "Cereza beruhigte sich.\r\nIhre Furcht wich Erleichterung.",
  "BK_1060_0040_CER": "„L-lasst uns doch endlich\r\nin Ruhe und verpieselt euch!“",
  "BK_1000_0160_CER": "„Sag bloß...\r\nWar das etwa...“",
  "SM_001100_0130_MOR": "„Cereza... Nun, es wird reichen\r\nmüssen. Wenn du mit diesem Dämon\r\numgehen kannst, erhöht das deine\r\nÜberlebenschancen enorm.“",
  "IN_1030_0000_CER": "„Oh, oh,\r\nich komme nicht mehr runter.\r\n\r\nHey, Cheshire, kannst du mich\r\nhier irgendwie runterholen?“",
  "BK_1000_0040_NAR": "Nun gab es keinen Ausweg mehr.\r\nCereza war umzingelt.",
  "SM_001100_0170_NAR": "Das Mondlicht begann zu schwinden\r\nund damit auch Morganas Antlitz.\r\nEs war beinahe, als habe sich der\r\nWald selbst gegen sie verschworen.",
  "LV_001105_0010_CER": "Was sie damit wohl beschützen wollen...?",
  "SM_001100_0090_MOR": "„Finde du einfach einen Unterschlupf und\r\nversuche, am Leben zu bleiben, bis ich\r\neinen Weg gefunden habe, dich zu retten.“",
  "BK_1030_0000_NAR": "Als sich ihre Augen an das grelle Licht\r\ngewöhnt hatten, erwartete sie ein Anblick,\r\nwie sie ihn nie zuvor gesehen hatten.",
  "LV_001020_0000_NAR": "Cereza hatte endlich einen Ort gefunden,\r\nan dem sie sich etwas ausruhen konnte.",
  "SM_001060_0010_NAR": "Vor ihnen stand ein großer Wolf.\r\nSein schneeweißes Fell schien\r\nwie blasses Silber im Mondlicht.",
  "IN_1050_0000_NAR": "Die massiven Kugeln in der kuriosen Vorrichtung bildeten\r\neine Linie, und ein Pfad aus Licht erschien vor ihnen.",
  "BK_1040_0050_LUC": "„Du... kannst es schaffen...“",
  "BK_1000_0010_CER": "„I-ist da jemand?\r\nZeig dich!“",
  "BK_1050_0010_MOR": "„Habe ich dich also endlich gefunden, Cereza.“",
  "BK_1000_0100_NAR": "Die Feen waren bereit, ihre finsteren Absichten in die Tat umzusetzen.\r\nAlle zugleich sprangen Cereza mit gezückten Waffen entgegen.",
  "BK_1060_0020_NAR": "Wie aus dem Nichts erschien jählings\r\neine bedrohlich wirkende Fee.\r\nCereza erschrak, versuchte aber,\r\nrasch die Fassung wiederzugewinnen.",
  "SM_001060_0040_CER": "„Hey... Warte!“",
  "LV_001065_0000_CER": "Na gut, ich gehe hier allein weiter.",
  "IN_1000_0010_NAR": "Vorsichtig schritt sie voran.",
  "SM_001100_0190_NAR": "Das restliche Mondlicht\r\nverblasste... und Morgana war fort.",
  "BK_1040_0060_LUC": "„Folge...\r\ndem weißen Wolf...“",
  "LV_001130_0000_CER": "Was ist das...?",
  "LV_001075_0020_CER": "Vielleicht bin ich nicht die erste\r\nHexe, die diesen Wald betritt...",
  "BK_1020_0040_CER": "„Was tust du denn da?!“",
  "BK_1020_0150_NAR": "[FONT:9 ]Gib mir auch was von dieser Kraft ab![FONT:N ]\r\nwarf Cheshire brüllend ein.",
  "SM_001120_0060_NAR": "Wo sie gerade vom Wolf sprachen...\r\nWo war er eigentlich abgeblieben?",
  "SM_001010_0060_NAR": "Die Kreatur hatte verzweifelt ein Medium ge-\r\nsucht, um zu überleben. Und anstelle von Haar\r\nhatte es sich mit Stoff zufriedengeben müssen.",
  "SM_001100_0240_NAR": "Cereza wollte wenigstens einmal von Morgana\r\nhören, dass sie etwas gut gemacht hatte.",
  "BK_1010_0030_CER": "„Beruhig dich, sonst platzt\r\ndir noch eine Naht auf!“",
  "SM_001040_0020_CER": "„Cheshire!“",
  "SM_001010_0050_NAR": "Es war genau, wie Cereza befürchtete:\r\nEin Dämon hatte von ihrer geliebten\r\nPlüschkatze Besitz ergriffen.",
  "LV_001130_0030_CER": "Einen Versuch ist's wert...",
  "SM_001020_0090_CER": "„Zuerst müssen wir einen weißen Wolf\r\nfinden. Er wird uns den Weg weisen.“",
  "SM_001070_0060_CER": "„Ich soll es mit Magie öffnen? Na hör\r\nmal, wir wissen doch nicht einmal,\r\nwas auf der anderen Seite lauert!“",
  "BK_1020_0160_NAR": "Er wollte auch ein Stück vom Kuchen!\r\nDoch was hatten sie da überhaupt entfesselt?",
  "SM_001020_0010_NAR": "Der Dämon bleckte die Zähne.\r\nEr schien zu leiden.",
  "SM_001010_0020_NAR": "Aus seinem klaffenden Maul,\r\ndas von einem Ohr zum anderen\r\nreichte, triefte zähflüssiger Speichel.",
  "LV_001915_0020_NAR": "Das Licht des Armreifs offenbarte\r\nCereza Dinge, die sie zuvor nicht\r\nhatte sehen können.",
  "BK_1010_0040_CER": "„Keine Sorge, ich schick\r\ndich schon noch nach Hause.\r\nSobald ich weiß, wie...“",
  "LV_001100_0000_CER": "Ob dieser Schatz den Feen gehört?\r\nDie sind bestimmt stinksauer,\r\nwenn ich den mopse!",
  "SM_001020_0060_NAR": "Der Dämon schien sich beruhigt zu haben.\r\nCereza erinnerte sich, dass er ihr nichts\r\nantun konnte, und atmete erleichtert auf.",
  "SM_001020_0170_CER": "„Irgendwie muss ich dich ja nennen!\r\nWenn dir das so gegen den Strich geht,\r\ndann such dir doch einen anderen Körper!“",
  "LV_001030_0000_CER": "Cheshire, ich hab sie gefesselt!\r\nErledige sie!",
  "BK_1020_0080_NAR": "Cheshire hatte die Nase voll von\r\ndieser Jagd. Er wollte Antworten.",
  "LV_001025_0010_NAR": "Kaum hatte Cheshire ihn bemerkt,\r\nmachte er Cereza deutlich, dass sie\r\nsich sofort davon entfernen solle.",
  "BK_1020_0120_NAR": "Cheshires Krallen verfehlten\r\nihr Ziel und trafen stattdessen\r\nden Elementarkern.\r\nErst folgte Stille. Doch dann...",
  "SM_001070_0020_CER": "„Dort ist irgendetwas...“",
  "IN_1020_0015_NAR": "Er schien langsam, aber sicher\r\nimmer schwächer zu werden.",
  "LV_001025_0020_NAR": "Die Bewohner von Inferno verabscheuten\r\nRosmarin. Sie mussten einen anderen\r\nWeg finden.",
  "SM_001020_0140_CER": "„Du hast keinen Namen?\r\nDas muss schrecklich unpraktisch sein.\r\n\r\nWobei... Ich gebe zu, ich habe keinen\r\nblassen Schimmer von dämonischen Sitten.“",
  "SM_001010_0010_NAR": "Direkt vor ihren Augen verwandelte\r\nsich Cerezas Plüschkatze in eine\r\nArt riesiges Monster.",
  "IN_1020_0000_NAR": "Der Dämon stürmte durch den Wald\r\nauf der Suche nach einem Weg nach Hause.",
  "SM_001010_0100_CER": "„Du... Du willst, dass ich dich\r\nnach Inferno zurückschicke?“",
  "LV_001915_0010_NAR": "Auf einmal begann Cerezas\r\nMagischer Armreif zu leuchten.\r\nWas hatte das zu bedeuten?",
  "LV_001900_0000_CER": "Hm?\r\nWas haben wir denn hier?",
  "IN_1050_0010_CER": "„Das ist ja riesig... Welchem\r\nZweck das wohl dient?“",
  "IN_1000_0060_NAR": "Das Geräusch des Windes, der durch die\r\nBlätter fuhr, klang wie eine krächzende\r\nStimme, die ihr ins Ohr flüsterte.",
  "SM_001060_0000_CER": "„Hey, sieh nur, dort...“",
  "BK_1030_0010_CER": "„Cheshire, ich glaube, wir sind\r\nnicht mehr im Wald von Avalon...“",
  "SM_001100_0070_NAR": "Dieser uralte Zauber war so stark,\r\ndass selbst Morgana ihn nicht ohne\r\nWeiteres zu brechen vermochte.",
  "BK_1000_0140_NAR": "Happs!",
  "BK_1040_0010_LUC": "„Im Zentrum... des Waldes...\r\n...warte auf dich...“",
  "BK_1000_0050_CER": "„Bitte... Diesmal muss es klappen!“",
  "SM_001100_0040_NAR": "Obgleich es sich nur um eine Projektion\r\nvon Morgana handelte, schaffte sie es\r\nirgendwie, noch einschüchternder zu\r\nwirken als in Person. Cereza konnte\r\nbloß den Kopf hängen lassen.",
  "BK_1000_0170_NAR": "Doch ehe Cereza ihre eigene\r\nFrage ausformulieren konnte...",
  "BK_1040_0020_LUC": "„Hilf mir...\r\nDann gebe ich dir...“",
  "SM_001100_0030_MOR": "„Wirklich, Cereza... Den Wald trotz all\r\nmeiner Warnungen zu betreten – und dann\r\nauch noch mit meinem Magischen Armreif!\r\nWas hast du dir nur dabei gedacht?!“",
  "LV_001055_0000_CER": "Woah, das ist neu!",
  "SM_001100_0150_CER": "„So etwas wie diese funkelnden\r\nDinger? Ich hab schon einige davon\r\ngefunden, seit ich hier bin.“",
  "LV_001905_0000_NAR": "Die Welt vor Cereza schien völlig verzerrt.\r\nSie blinzelte energisch, doch es änderte nichts.",
  "IN_1000_0050_NAR": "Während sie ins dunkle Dickicht blickte,\r\nwurde Cereza das Gefühl nicht los,\r\ndass irgendetwas ihren Blick erwiderte.",
  "BK_1050_0005_NAR": "Als sie sich der Stelle näherte,\r\nbegann der Magische Armreif an\r\nCerezas Handgelenk zu leuchten.",
  "SM_001010_0140_NAR": "Da verlor der Dämon die Geduld\r\nund stürzte sich auf sie!",
  "LV_001150_0000_CER": "Wow, sieh dir das an...",
  "LV_001145_0010_NAR": "Könnte es sein, dass jene Feen versucht\r\nhatten, diesen Ort zu beschützen?",
  "SM_001100_0270_CER": "„Ach ja! Da waren noch diese\r\nFunkeldinger, die dich angeblich\r\nstärker machen! Was sie damit\r\nwohl meinte...?“",
  "SM_001020_0180_CER": "„Schön. Dann nenn ich dich, wie ich will.“",
  "LV_001075_0010_NAR": "Es gab Anzeichen dafür, dass eine andere\r\nHexe hier Unterschlupf gesucht hatte.",
  "LV_001060_0000_CER": "Noch mehr Rosmarin...",
  "BK_1020_0070_NAR": "[FONT:9 ]Hör auf wegzulaufen und\r\nsag uns endlich, wie wir\r\nan diese Kraft kommen![FONT:N ]",
  "SM_001020_0100_NAR": "[FONT:9 ]Überlass das mir. Den finde ich.[FONT:N ]\r\nsagte der Dämon und richtete sich auf.",
  "SM_001060_0050_LUC": "„Im Wald von Avalon... Der weiße\r\nWolf... wird dich führen...“",
  "SM_001120_0050_CER": "„Ich weiß, ich weiß!\r\nDeshalb verfolgen wir\r\ndiesen Wolf ja!“",
  "SM_001020_0130_NAR": "[FONT:9 ]Ich habe keinen Namen.[FONT:N ]\r\nantwortete der Dämon schroff.",
  "SM_001070_0050_NAR": "[FONT:9 ]Dieser Wolf lief hier entlang![FONT:N ]\r\nCheshire zögerte nicht lange. Doch was\r\ner auch versuchte, er vermochte die\r\nRisse nicht weiter zu beschädigen.",
  "SM_001020_0020_CER": "„Bist du krank?\r\nOder hast du vielleicht Hunger?“",
  "BK_1010_0000_NAR": "Messerscharfe Klauen\r\nstießen auf Cereza herab!",
  "LV_001015_0010_CER": "Da ist aber einer angriffslustig, was?\r\nIch weiß genau, mit welchem Zauber\r\nich dir Manieren beibringe!",
  "SM_001040_0010_NAR": "Mit einem Mal schrumpfte Cheshires\r\nKörper und wurde wieder zum Plüschtier.",
  "SM_001040_0090_CER": "„Für mich ist es auch mal ganz\r\nentspannend, wenn mir nicht immer\r\nso ein Riesendämon im Nacken sitzt.“",
  "SM_001090_0000_NAR": "Als sie aus dieser seltsamen Welt in den\r\nWald zurückkehrten, fanden sie ihn beinahe\r\nunverändert vor. Bis auf eine Sache...",
  "LV_001070_0010_CER": "Ich werfe dich dort hinauf, Cheshire.\r\nDann kannst du schauen, ob es da\r\nweitergeht.",
  "BK_1060_0010_CER": "„Was mag das da drüben sein?\r\nSehen wir mal nach!“",
  "PH_1b01_0000_NAR": "Als sie aus dieser seltsamen Welt in den\r\nWald zurückkehrten, fanden sie ihn beinahe\r\nunverändert vor. Bis auf eine Sache...",
  "BK_1000_0020_NAR": "Und dann, wie als Antwort\r\nauf ihre Aufforderung...",
  "SM_001100_0160_MOR": "„Ja... Diese Kristallstruktur stellt\r\neine stabile Quelle magischer Energie\r\ndar. Wenn du den Dämon damit fütterst,\r\nerwachen womöglich neue Kräfte in ihm.“",
  "BK_1000_0130_CER": "„Was... Wer bist du?“",
  "SM_001100_0000_CER": "„Morgana?!“",
  "BK_1000_0090_CER": "“Warum?! Es war doch richtig so...“",
  "LV_001005_0000_CER": "Bloß nicht nach unten sehen...",
  "LV_001910_0010_NAR": "Kaum hatte Cereza einen Schritt\r\nhinein gewagt, stockte ihr der Atem.\r\n",
  "BK_1000_0060_NAR": "Cereza hoffte das Beste und begann\r\nden Beschwörungszauber, den sie\r\nvon Morgana gelernt hatte.",
  "SM_001060_0030_NAR": "Cereza war wie gefesselt vom\r\nAnblick des Wolfes. Er wirkte\r\nwie aus einer anderen Welt.",
  "LV_001035_0000_CER": "Ich gehe vor und kümmere mich um\r\neinen Weg für dich. Warte hier.",
  "IN_1030_0020_CER": "„Damit meinte ich doch nicht, dass du\r\ngleich den ganzen Baum fällen solltest!“",
  "SM_001100_0110_MOR": "„Ist das...\r\nDu hast einen Dämon an\r\ndein PLÜSCHTIER gebunden?“",
  "LV_001910_0020_NAR": "Um sie herum traten seltsame und\r\nunheimliche Dinge in Erscheinung,\r\nals wäre sie in einem Albtraum gelandet.",
  "LV_001905_0030_CER": "Ich bin gleich so weit,\r\nnun hetz mich doch nicht!",
  "LV_001110_0010_NAR": "[FONT:10 ]Das liegt nur daran, dass sie\r\nwissen, wie schwach du bist![FONT:N ]\r\nhöhnte Cheshire hochmütig.",
  "SM_001100_0080_MOR": "„Fürs Erste kann ich dich nur\r\naus der Ferne unterstützen.\r\nIch werde nachforschen, wie\r\nman aus dem Wald kommt.“",
  "LV_001105_0000_CER": "So eine Barriere habe ich noch nie gesehen.\r\nIch wette, die Feen stecken dahinter!",
  "SM_001120_0090_NAR": "Die zankenden Gefährten ließen die\r\nÜberreste des Kerns hinter sich und\r\nsetzten ihre Reise durch den Wald fort.",
  "SM_001120_0010_CER": "„Nein, das scheint\r\nwas anderes zu sein...\r\nWir müssen drei weitere dieser\r\nKugeln zerstören, bevor ich dich\r\nzurückschicken kann.“",
  "SM_001020_0050_CER": "„Was sagst du da?\r\nIch muss stets in deiner Nähe bleiben?\r\nVon so einem Zauber habe ich noch nie gehört...“",
  "PH_1010_0000_CER": "Was war das?!\r\nDas... muss ein Kaninchen oder irgendwie\r\nso was gewesen sein, stimmt's, Cheshire?",
  "SM_001010_0090_NAR": "Als der erste Schreck verflogen war,\r\nbemerkte Cereza, dass sie verstehen\r\nkonnte, was der Dämon sagte.",
  "SM_001100_0230_CER": "„Es tut mir leid, ihr Sorgen zu\r\nbereiten... Aber ich weiß gar nicht,\r\nwieso sie so überfürsorglich ist. Ich\r\nhabe ja sogar einen Dämon beschworen!“",
  "LV_001050_0000_CER": "Hm! Selbst mit dir dadrin\r\nwiegt Cheshire immer noch\r\nso viel wie vorher.",
  "BK_1010_0070_NAR": "Von Neugier und Angst zugleich gepackt,\r\nbeschloss Cereza, ihm zu folgen... mit etwas Abstand.",
  "LV_001080_0010_CER": "Das heißt, wenn wir diesem Wolf folgen...\r\nKomm, Cheshire, beeilen wir uns!",
  "BK_1040_0000_CER": "„Du bist der Junge\r\naus meinem Traum...“",
  "BK_1040_0030_CER": "„In Ordnung,\r\nich muss einfach nur dem\r\nweißen Wolf folgen, richtig?“",
  "SM_001010_0130_NAR": "Erneut vernahm Cereza die Worte des\r\nDämons, diesmal deutlicher als zuvor:\r\n[FONT:9 ]Ich will zurück! Ich will zurück![FONT:N ]\r\nDer Dämon wurde mit jeder\r\nSekunde zorniger, doch Cereza\r\nkonnte nichts für ihn tun.",
  "SM_001070_0090_CER": "„Das sollte keine Ausrede sein!“",
  "SM_001070_0010_NAR": "[FONT:9 ]Hier entlang![FONT:N ]\r\nCheshire hatte den Wolf gewittert.",
  "SM_001070_0100_CER": "„Na schön, ich mach's ja schon!\r\nAlso gut, Cereza, du hast so was geübt...“",
  "BK_1020_0000_NAR": "Sie erreichten eine mysteriöse Kugel\r\nauf einer Säule... Ob es sich hierbei\r\num den Elementarkern handelte, den der\r\nJunge in Cerezas Traum erwähnt hatte?",
  "SM_001100_0250_NAR": "Morganas Standpauke hatte sie\r\nbereits wieder vergessen.",
  "SM_001040_0110_NAR": "Obgleich es dem Dämon gar nicht\r\ngefiel, wie ein Plüschtier behandelt\r\nzu werden, blieb ihm nichts anderes,\r\nals seinen Stolz herunterzuschlucken.",
  "LV_001015_0000_NAR": "Was für eine Zwickmühle!\r\nAber Cereza wusste genau,\r\nwie sie hier unbeschadet vorbeikam.",
  "SM_001020_0030_NAR": "Als Cereza näherkam, spürte der Dämon,\r\nwie seine Stärke plötzlich zurückkehrte.\r\nIm Nu war er wieder bei Kräften.",
  "SM_001120_0070_NAR": "Um die restlichen Elementarkerne\r\nzu finden, mussten sie erst den\r\nWolf wiederfinden.",
  "SM_001020_0120_CER": "„Ähm... Ich bin Cereza.\r\nUnd wie heißt du?“",
  "LV_001075_0030_CER": "Wie auch immer... Das heißt,\r\nwir können uns hier ausruhen!",
  "LV_001075_0000_CER": "Was haben wir hier...?",
  "LV_001130_0020_CER": "Hey...\r\nOhne Morgana im Nacken kann ich\r\nhier bestimmt richtig gut trainieren.",
  "SM_001020_0190_NAR": "Und so machten sich diese seltsamen\r\nGefährten auf die Suche nach dem\r\nweißen Wolf. Welch Geheimnisse sie\r\nwohl im Wald von Avalon erwarten?",
  "SM_001010_0040_NAR": "Als wollte es damit ihre Frage\r\nbeantworten, knurrte das Biest und\r\nbleckte seine blutroten Fangzähne.",
  "LV_001150_0010_NAR": "Dieser Ort war von einer Stille erfüllt,\r\ndie Cereza zutiefst beruhigte.",
  "BK_1000_0110_NAR": "Sie schloss die Augen,\r\naufs Schlimmste gefasst.\r\nEin Moment der Stille verging.\r\nDann noch einer. Doch sie spürte nichts,\r\nnicht einmal einen kleinen Piks.",
  "SM_001100_0050_MOR": "„Ich bin schon sehr gespannt, wie\r\ndu mir das zu erklären gedenkst,\r\nwenn du wieder zu Hause bist, doch\r\nich befürchte, es wird nicht leicht,\r\naus dem Wald von Avalon zu entkommen.“",
  "BK_1040_0040_LUC": "„Zerstöre... die vier...\r\nElementarkerne...“",
  "BK_1000_0080_NAR": "Der Beschwörungskreis war\r\nbereits wieder erloschen, doch\r\nniemand war ihrem Ruf gefolgt.",
  "LV_001010_0000_CER": "Eine Pflanze aus Inferno?\r\nIch frage mich, wie sie auf\r\nmeine Magie reagieren würde...",
  "SM_001100_0010_NAR": "Cereza rieb sich ungläubig die Augen,\r\nals das geisterhafte Abbild ihrer\r\nLehrerin im Mondlicht erschien.",
  "AC_CEREZA010_0010_CER": "Weißer Wolf, warte!",
  "SM_001100_0100_CER": "„Keine Sorge, Morgana! Sieh nur,\r\nich habe es sogar geschafft, meinen\r\neigenen Dämon heraufzubeschwören!“",
  "IN_1000_0080_CER": "Ich darf jetzt keinen Rückzieher machen...\r\nIch werde eine echte Hexe und rette Mami!",
  "IN_1000_0000_NAR": "Mächtige Bäume verschluckten die\r\nmeisten Strahlen des Mondlichts und\r\neine unheimliche Stille umgab Cereza.",
  "LV_001920_0000_CER": "H-hey! Worauf stehe ich gerade?!",
  "LV_001110_0000_CER": "Diese frechen Feen...\r\nWas haben die nur für ein Problem?!",
  "LV_001905_0020_NAR": "[FONT:10 ]Na los, wir müssen uns immer\r\nnoch diesen Wolf schnappen![FONT:N ]",
  "LV_001910_0030_CER": "A-alles gut! Es braucht schon\r\nmehr, um mir Angst einzujagen!",
  "SM_001100_0060_NAR": "Mit ernstem Gesichtsausdruck\r\nerklärte Morgana, dass die Magie\r\nder Feen den Wald zu einer\r\nlabyrinthartigen Falle machte,\r\nin der Cereza derzeit gefangen war.",
  "BK_1000_0150_NAR": "Jenes Biest, dunkel wie eine mondlose\r\nNacht... Hatte sie das alles nur geträumt?",
  "SM_001100_0180_MOR": "„Cereza, hör gut zu: Dämonen sind\r\nWaffen, die wir Hexen einsetzen,\r\nkeine Freunde zum Knuddeln. Denke\r\ndaran, sie entsprechend zu behandeln.“",
  "BK_1060_0070_NAR": "Mit einem Knurren ließ Cheshire\r\nCereza hinter sich und sprang\r\nder Fee entgegen.",
  "SM_001020_0200_NAR": "",
  "PH_1060_0000_CER": "Weißer Wolf, warte!",
  "LV_001905_0010_NAR": "War dies ein Zaubertrick der Feen?\r\nCheshire indessen verlor langsam die\r\nGeduld mit seiner zögerlichen Gefährtin.",
  "SM_001100_0020_MOR": "„Zum Glück bist du unversehrt...\r\nAls mir klar wurde, dass du dich\r\nin den Wald geschlichen hast,\r\nwar ich krank vor Sorge.“",
  "LV_001910_0000_CER": "Was zum...?",
  "BK_1050_0000_NAR": "Auf einer Lichtung des Waldes\r\nbemerkte Cereza einen Fleck,\r\nder vom Mondlicht besonders\r\nerhellt wurde.",
  "LV_001025_0000_NAR": "Der frische Duft kitzelte Cerezas Nase. Es\r\nhandelte sich um Rosmarin, welcher oft zum\r\nEinsatz kam, um böse Geister fernzuhalten.",
  "SM_001070_0080_NAR": "Cheshire schnaubte bloß spöttisch\r\nangesichts Cerezas Feigheit.",
  "BK_1010_0050_CER": "„Ich bin gerade unterwegs, um\r\neine mächtige Kraft zu erhalten.\r\nDamit sollte es ein Kinderspiel\r\nsein, dich zurückzuschicken.“",
  "SM_001100_0210_NAR": "Cheshire schien übel gelaunt.",
  "LV_001900_0010_CER": "Ich bin gar nicht mal so ungeschickt,\r\nwas die Kunst des Brauens angeht.\r\nVersuchen wir es doch mal...",
  "SM_001010_0110_CER": "„...Und wie genau stellt\r\nman so was an?“",
  "IN_1020_0010_NAR": "Seine rasiermesserscharfen Klauen\r\nsausten durch die Luft... Doch\r\nirgendetwas stimmte hier nicht.",
  "SM_001020_0150_CER": "„Darf ich dich Cheshire nennen?\r\nImmerhin ist das der Name der\r\nPlüschkatze, in der du haust.“",
  "BK_1020_0130_NAR": "Ein tosender Energiestrudel strömte aus dem Kern heraus.\r\nCereza stand darin und spürte, wie sie eine seltsame Kraft erfüllte.",
  "SM_001020_0040_NAR": "Sein Körper war durch mächtige\r\nMagie mit Cereza verbunden.\r\nWenn er sich von ihr entfernte,\r\nverlor er seine Energie.",
  "SM_001120_0000_NAR": "Sie hatten eine neue Fähigkeit erlangt.\r\n[FONT:9 ]War's das? Kann ich jetzt nach Hause?[FONT:N ]\r\nfragte Cheshire aufgeregt.",
  "SM_001120_0080_CER": "„Meine Güte, ihr Dämonen raubt\r\neinem echt den letzten Nerv!\""
}
