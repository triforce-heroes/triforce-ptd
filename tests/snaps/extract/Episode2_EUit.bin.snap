{
  "SM_002100_0150_COL": "\"Grazie!\"",
  "BK_2000_0060_CER": "\"Su, Cereza. Riprendi il controllo.\r\nDiven... diventerò una vera strega!\"",
  "LV_002905_0000_NAR": "[FONT:10 ]Si avverte un grande potere qui.[FONT:N ]\r\nCheshire percepiva qualcosa nei paraggi.",
  "SM_002100_0040_NAR": "Cereza pensò al suo prossimo sogno\r\ne non poté evitare di sorridere.",
  "SM_002140_0050_FAS": "\"Non mi sono ancora presentata.\r\nMi chiamo Ignis e sono la custode\r\ndi questa foresta.\"",
  "SM_002060_0030_CER": "\"Attento, Cheshire!\r\nNon so se gli spiritelli sono deboli\r\ndi cuore, ma spaventi del genere\r\nnon possono certo fare bene.\"",
  "LV_002035_0120_CER": "Ora smettila! Non ti dimenticare a\r\nchi appartiene la magia elementale\r\nche ti serve per trasformarti!",
  "CE_002815_0000_CER": "Unnngh... unnngh... aah!",
  "SM_002140_0060_FAS": "\"Avete fatto un bel lavoro al circo.\r\nSapevo di non sbagliarmi sul\r\nvostro conto.\"",
  "SM_002060_0000_COL": "\"Questa è la nostra base segreta.\r\nDi solito possono accedervi soltanto\r\ngli spiritelli, ma farò un'eccezione.\"",
  "BK_2000_0050_CER": "\"C-ce la faccio a combattere!\r\nNon mi trattare come se fossi\r\nuna bambina indifesa!\"",
  "LV_002035_0015_NAR": "disse Cheshire con acidità.",
  "SM_002130_0135_CER": "\"OK, allora... dimmi di più.\"",
  "LV_002900_0000_CER": "Che fa quel buffone?\r\nÈ sempre in mezzo ai piedi!",
  "SM_002010_0100_COL": "\"Voglio aiutarli, ma non posso\r\naffrontare le fate da solo!\"",
  "SM_002010_0180_NAR": "Cheshire rese chiaro che non\r\nintendeva partecipare a questa\r\nfolle azione di soccorso.\r\nMa Cereza era determinata.",
  "SM_002010_0010_NAR": "Cereza si ricordò di una cosa\r\nche Morgana le aveva detto\r\nmolto tempo prima.\r\nGli spiritelli sono le anime dei bambini\r\ndeceduti ad Avalon, condannati a\r\nvagare per sempre nella foresta...",
  "CE_002070_0000_CER": "È il momento del gran finale!",
  "LV_002080_0020_NAR": "Cereza all'improvviso sbadigliò.\r\nEra esausta.",
  "SM_002140_0100_NAR": "Appena capì che la voce\r\napparteneva a uno spiritello,\r\nCereza si sentì sollevata.",
  "SM_002130_0150_FAS": "\"Quel pazzo del direttore del circo\r\ncostringe quei poverini a esibirsi\r\nnegli spettacoli finché non muoiono.\"",
  "SM_002040_0050_CER": "\"Guarda come sono contenti!\r\nColm e i suoi amici potranno\r\ntornare a vivere insieme.\r\n\r\nForse troveranno un po' di serenità\r\nin questa foresta maledetta...\"",
  "SM_002140_0010_CER": "\"Quella voce...\"",
  "SM_002140_0210_FAS": "\"Qualcosa non va?\"",
  "SM_002110_0090_CER": "\"Hai idea di quanto siano\r\nimportanti i capelli per una\r\nstrega? Stai più attento!\"",
  "_05": "",
  "SM_002130_0120_FAS": "\"Ma non ti sarà tanto facile\r\ntrovare quei nuclei elementali.\"",
  "LV_002930_0000_CER": "Ah, a te non piace il rosmarino.\r\nAllora rimani dove sei.",
  "SM_002140_0045_CER": "\"E così sei tu quella che\r\nparlava prima con noi!\"",
  "CE_002040_0000_CER": "Ehi, gli interruttori si sono girati\r\ne ora non posso schiacciarli!",
  "SM_002130_0080_FAS": "\"Oh, ma tu sei in cerca di\r\nun lupo bianco, se non erro...\"",
  "_01": "",
  "SM_002130_0110_FAS": "\"Abbi fiducia nel sentiero che stai\r\nper prendere... È quello giusto.\"",
  "SM_002040_0180_CER": "\"Se fossi stata più forte,\r\nquella notte avrei potuto salvarla...\"",
  "SM_002040_0100_NAR": "Ma nell'istante in cui pronunciava\r\nquelle parole, Cereza capì...",
  "IN_2000_0010_NAR": "Cereza prese in giro il demone, che le\r\nlanciò in risposta un'occhiata gelida.",
  "LV_002070_0010_NAR": "Cereza lanciò un urlo di gioia.\r\nDopotutto, era ancora una bambina.",
  "SM_002140_0180_FAS": "\"Non devi preoccuparti.\r\nBasta prosciugare l'acqua!\"",
  "_54": "",
  "LV_002005_0030_NAR": "[FONT:10 ]Sembra buono. Prendiamolo, presto![FONT:N ]",
  "SM_002100_0110_COL": "\"Posso disturbarvi con\r\nun'ultima richiesta?\"",
  "SM_002080_0010_CER": "\"Non male, eh?\r\nTe l'avevo detto che so fare di più\r\nche portarti in giro in braccio.\"",
  "SM_002050_0000_COL": "\"Grazie, Cereza!\"",
  "SM_002140_0220_CER": "\"No, niente!\r\nCampanili... statue giganti...\r\nMa sì, le streghe amano i posti alti!\r\nGrazie dell'aiuto!\"",
  "LV_002010_0010_CER": "Le fate stanno tormentando uno\r\ndi quegli spiritelli... Ma da sola\r\nnon riesco ad aiutarlo...",
  "SM_002100_0120_COL": "\"Se nella foresta incontrate altri dei\r\nmiei amici che sono stati catturati,\r\nsareste così gentili da salvarli e\r\nrimandarli qui?\"",
  "IN_2000_0020_NAR": "[FONT:10 ]Faccio fuori chiunque mi si avvicini.[FONT:N ]",
  "CE_002080_0000_CER": "Unnngh!",
  "SM_002130_0160_CER": "\"Finché non... muoiono?\"",
  "SM_002080_0040_NAR": "Cereza ne aveva abbastanza\r\ndell'arroganza di Cheshire.",
  "LV_002035_0115_NAR": "Cheshire guardò Cereza\r\ncon aria minacciosa.",
  "LV_002040_0030_CER": "Mi sarebbe piaciuto giocare in\r\nun posto così con la mia mamma...",
  "BK_2000_0040_NAR": "[FONT:9 ]Levati dai piedi![FONT:N ]\r\ngridò Cheshire a Cereza,\r\nche era terrorizzata.",
  "SM_002060_0090_COL": "\"E per te ho questo.\r\nNon sappiamo come si usa,\r\nma dev'essere magico.\"",
  "CE_002800_0000_CER": "Non otterremo niente finché sta\r\nsu quella palla. Tiriamogliela via!",
  "SM_002060_0100_CER": "\"Grazie!\"",
  "IN_2000_0040_CER": "Ah, è così?",
  "SM_002130_0010_CER": "\"C-chi sei!?\"",
  "CE_002000_0000_CER": "Scendi da lì!",
  "SM_002060_0130_COL": "\"Figurati! Fammi sapere\r\nse hai bisogno di altro.\"",
  "LV_002035_0020_CER": "La fai così lunga che sembra che\r\nla lingua ti serva piuttosto per\r\nlamentarti. Vuoi andare a casa o no?\r\n",
  "SM_002130_0210_FAS": "\"Bene, ora devo andare. Auguro\r\na entrambi di fare buon viaggio.\"",
  "SM_002100_0050_CER": "\"Il lupo bianco!\"",
  "LV_002055_0010_NAR": "Il fatto di aver salvato gli spiritelli\r\nrisollevò l'animo di Cereza.",
  "LV_002905_0010_CER": "Il nucleo elementale è vicino!\r\nForse è dentro la tenda?",
  "LV_002090_0010_CER": "Che cos'è quello?",
  "BK_2010_0040_LUC": "\"Asciugati le lacrime...\"",
  "SM_002010_0030_COL": "\"Chi sei? Ti sei persa?\"",
  "SM_002040_0040_NAR": "[FONT:9 ]Mi puoi ricordare perché abbiamo\r\ndovuto salvare quei cosi?[FONT:N ]\r\nchiese Cheshire flemmatico.",
  "SM_002110_0070_CER": "\"Cheshire! Aaah, ora i miei\r\ncapelli sono tutti appiccicosi!\"",
  "SM_002010_0000_CER": "\"È uno... spiritello?\"",
  "SM_002130_0060_FAS": "\"Se non mi credi, prova a chiedermi\r\nqualcosa. Risponderò a qualsiasi\r\ndomanda.\"",
  "SM_002140_0030_NAR": "Cereza guardò in direzione della voce\r\ne vide uno strano spiritello con\r\nun cappello sceso fin sul volto.",
  "SM_002040_0070_NAR": "[FONT:9 ]Chi se ne importa di loro?[FONT:N ]\r\nrispose Cheshire.\r\nSi sa che i demoni sono esseri\r\nmolto egoisti.",
  "SM_002140_0120_CER": "\"Hai detto di chiamarti Ignis, vero?\"",
  "SM_002010_0190_CER": "\"Ci andrò anche se dovessi\r\naffrontare quelle fate da sola!\"",
  "LV_002915_0000_CER": "Yuppi!\r\nChissà dove mi porterà.",
  "LV_002050_0010_CER": "Devo stare attenta.\r\nSe mi scoprono, sarò nei guai.",
  "SM_002130_0180_FAS": "\"Ma non devi preoccuparti.\r\nTu e il tuo demone non ci lascerete\r\nle penne tanto facilmente.\"",
  "SM_002140_0150_CER": "\"In fondo al lago?!\"",
  "SM_002040_0110_CER": "\"Oh... Forse anch'io ti ho allontanato\r\ndai tuoi cari quando ti ho chiesto\r\ndi venire in questo mondo...\"",
  "SM_002040_0190_NAR": "Mentre parlava, rivedeva davanti\r\nai suoi occhi la notte in cui non\r\nera riuscita a salvare sua madre.",
  "SM_002010_0160_NAR": "La ragazza e il demone si prepararono\r\na scontrarsi. Nessuno dei due voleva\r\ncedere.",
  "SM_002010_0070_CER": "\"Sembri preoccupato, Colm.\r\nCos'è successo?\"",
  "SM_002040_0080_CER": "\"Che stai dicendo?\r\nLi avresti abbandonati?\"",
  "LV_002925_0000_CER": "Ci siamo... scambiati di posto?",
  "SM_002020_0080_NAR": "[FONT:9 ]Ah, sì? E una rammollita come te\r\ncome farà a salvare tutti?[FONT:N ]\r\nIl demone rise di lei, con il muso\r\nstretto in un ghigno.",
  "SM_002020_0000_CER": "\"Cheshire!\"",
  "SM_002140_0160_CER": "\"Beh, direi che sono fortunata.\r\nSono sempre stata più brava\r\nad andare sott'acqua che a nuotare.\"",
  "SM_002110_0080_NAR": "Cheshire mangiava tranquillo\r\nmentre Cereza cercava invano\r\ndi levarsi la polpa dai capelli.",
  "SM_002010_0040_CER": "\"Ma tu p-parli?!\"",
  "SM_002060_0050_NAR": "[FONT:9 ]Abbiamo un compito.\r\nNon c'è tempo per giocare\r\ncon quei moscerini.[FONT:N ]\r\ndisse Cheshire, guardando Colm.",
  "LV_002005_0010_CER": "Cos'è questo?",
  "SM_002050_0010_NAR": "Colm era allegro e disse che voleva\r\ndimostrare loro la sua riconoscenza\r\nper aver salvato i suoi amici.",
  "SM_002080_0000_NAR": "Avevano sconfitto la terribile fata.\r\nCereza ebbe l'impressione di\r\naver contribuito, anche se poco.",
  "BK_8100_0010_CER": "\"Lo so, aspetta.\r\nQuale potere otterrai\r\nstavolta?\"",
  "CE_002030_0000_CER": "Che cosa sono quegli interruttori\r\ndavanti alle colonne?",
  "CE_002100_0000_CER": "Cheshire! Aiuto!",
  "SM_002130_0050_CER": "\"... Disse quella voce sinistra\r\nproveniente dalle tenebre.\"",
  "SM_002140_0080_FAS": "\"Che peccato.\"",
  "IN_2000_0000_CER": "L'hai fatta tanto lunga,\r\nma alla fine hai deciso di aiutarmi!",
  "SM_002010_0080_COL": "\"I miei amici...\r\nLe fate li hanno portati via.\"",
  "SM_002130_0170_FAS": "\"Scusami... Ti ho forse spaventata?\"",
  "SM_002010_0110_CER": "\"Me ne occupo io\r\ndi quelle ignobili fate!\"",
  "LV_002095_0010_CER": "Ehi, una volta ho visto questo numero\r\na una fiera. Non avrei mai pensato\r\ndi doverlo eseguire io, un giorno...",
  "SM_002010_0044_CER": "\"Io mi chiamo Cereza. E tu?\"",
  "SM_002140_0230_FAS": "\"Di nulla.\"",
  "SM_002020_0040_NAR": "[FONT:9 ]Se succede qualcosa a te,\r\nci andrò di mezzo anch'io.[FONT:N ]\r\nIn fondo il demone stava cercando\r\ndi proteggere se stesso.",
  "SM_002120_0000_NAR": "[FONT:10 ]Non puoi correre più velocemente?[FONT:N ]\r\nIl lupo stava scappando e Cheshire\r\nnon ne era per niente felice.",
  "LV_002030_0020_CER": "Forse possiamo usarlo per andare in\r\nposti che prima erano irraggiungibili!",
  "CE_002805_0000_CER": "Riesce a schivare ogni tiro!\r\nCi deve essere un modo per colpirlo...",
  "LV_002030_0010_CER": "Questo nuovo potere...",
  "SM_002010_0120_COL": "\"Cosa?! Dici... sul serio?!\"",
  "SM_002040_0150_NAR": "[FONT:9 ]Appena nato, ma forte!\r\nImmagina quanto lo sarò da grande![FONT:N ]\r\nIl demone interruppe i pensieri\r\ndi Cereza con una tonante risata.",
  "SM_002140_0110_NAR": "Ma Cheshire non disse una parola.\r\nNon mostrava alcun interesse\r\nnei confronti dello spiritello.",
  "LV_002080_0030_NAR": "Decise di riposare un po' lì.",
  "SM_002130_0140_FAS": "\"Più avanti c'è una vecchia tenda\r\nda circo usata dalle fate per\r\nattirare i bambini nella foresta.\"",
  "SM_002130_0090_CER": "\"C-come... fai a saperlo?\"",
  "LV_002910_0000_CER": "Cos'è questo rumore?!\r\nSi avvicina a noi!",
  "SM_002100_0140_CER": "\"Hai la mia parola!\"",
  "SM_002100_0060_NAR": "Alla vista del lupo,\r\nCereza balzò in piedi.",
  "LV_002055_0020_CER": "Quelle fate sono terribili.\r\nNiente paura, spiritelli! Vi salvo io!",
  "CE_002060_0000_CER": "Oh, funzionano come gli interruttori.",
  "SM_002100_0170_COL": "\"Stai attenta, Cereza.\r\nE anche tu, gattino!\"",
  "LV_002090_0020_NAR": "In lontananza si trovava un'enorme tenda\r\ncolor sangue. Sembrava burlarsi di\r\nCereza, mentre l'attirava verso di sé.",
  "SM_002140_0070_FAS": "\"Qualcosa mi dice che il direttore\r\nnon potrà più godersi il suo trapezio.\"",
  "SM_002060_0010_COL": "\"Ehi, dov'è andato il tuo amichetto?\"",
  "SM_002130_0020_NAR": "Quella voce improvvisa fece\r\nsobbalzare il cuore di Cereza.",
  "SM_002130_0130_CER": "\"Sai anche dei nuclei elementali!?\"",
  "LV_002035_0010_NAR": "[FONT:10 ]La lingua mi serve per leccare le prede.\r\nPer quanto devo ancora continuare?[FONT:N ]",
  "SM_002100_0100_CER": "\"Mi dispiace, abbiamo fretta.\"",
  "LV_002005_0020_NAR": "Cereza ha scoperto qualcosa.\r\nSembra un frutto.",
  "SM_002140_0200_CER": "\"L'albero più alto, uhm...\"",
  "SM_002080_0030_CER": "\"Che demonio presuntuoso!\"",
  "SM_002100_0090_COL": "\"Ah, ve ne andate di già?\"",
  "SM_002100_0010_NAR": "Le ultime parole del giovane\r\nle echeggiavano ancora nelle orecchie.",
  "SM_002050_0020_COL": "\"Seguitemi!\"",
  "SM_002140_0190_FAS": "\"Ma per fare ciò, devi salire\r\nsu un albero enorme.\r\nPer raggiungere il fondo del lago,\r\ndevi scalare l'albero più alto\r\ndella foresta. Non è poetico?\"",
  "LV_002920_0000_CER": "Viene da questa parte!\r\nChe cos'è?!",
  "LV_002065_0010_CER": "Colm, cammini veloce per avere\r\ndelle gambe così corte.",
  "SM_002140_0000_FAS": "\"Vi siete divertiti al circo?\"",
  "SM_002030_0010_NAR": "Cereza prese in giro il demone, che le\r\nlanciò in risposta un'occhiata gelida.",
  "SM_002060_0060_COL": "\"Che gatto scorbutico!\r\nHo qualcosa anche per te!\"",
  "CE_002050_0000_CER": "A cosa servono queste leve?",
  "SM_002060_0140_NAR": "Detto ciò, Colm corse via\r\na giocare con i suoi amici eterei.",
  "SM_002030_0020_NAR": "[FONT:10 ]Faccio fuori chiunque mi si avvicini.\r\nAl contrario di te, io mi so difendere\r\nda solo.[FONT:N ]\r\nrimbrottò il demone.\r\n",
  "IN_2000_0030_NAR": "[FONT:10 ]Al contrario di te, io mi so difendere\r\nda solo.[FONT:N ] rimbrottò il demone.\r\n",
  "SM_002100_0130_COL": "\"Vi ricompenseremo,\r\nlo prometto!\"",
  "SM_002100_0020_NAR": "Cereza sentì scaldarsi il petto,\r\ncome se, nel mezzo di quell'oscura\r\ne fredda foresta, una fiamma fosse\r\nstata accesa in fondo al suo cuore.",
  "SM_002130_0220_NAR": "La voce svanì e il silenzio avvolse\r\nnuovamente la foresta.",
  "SM_002120_0040_NAR": "Il demone non disse nulla.\r\nIl suo sguardo bastò come risposta.",
  "_71": "",
  "SM_002040_0120_NAR": "[FONT:9 ]Ero appena nato.\r\nNon ho nessuno che mi stia a cuore.\r\nNessun bisogno di amore. Solo di forza.[FONT:N ]\r\nLa filosofia del demone era semplice.",
  "SM_002110_0110_CER": "\"Z-zitto!\r\nCi sto lavorando su. Aspetta e vedrai!\"",
  "SM_002010_0150_CER": "\"Beh, non possiamo certo abbandonarli!\"",
  "BK_2010_0020_CER": "\"M-mamma?\r\nDove sei, mamma?\"",
  "CE_002035_0000_CER": "Calpestandolo, la luce illumina\r\nla base della colonna.",
  "SM_002130_0100_FAS": "\"Ora sei parte di questa foresta.\r\nE ciò significa che gli affari tuoi\r\nsono anche affar mio.\"",
  "BK_2010_0010_CER": "\"Perché... Perché non si apre?\"",
  "SM_002040_0000_CER": "\"Per fortuna siete tutti sani e salvi.\r\nÈ stato più complicato del previsto.\"",
  "SM_002140_0040_CER": "\"Uno spiritello?\"",
  "CE_002090_0000_CER": "Non riesco... a muovermi...",
  "SM_002020_0030_NAR": "In cuor suo Cereza era felice di vedere\r\nCheshire, mentre lui stava in silenzio\r\nimbronciato.",
  "SM_002010_0020_CER": "\"Ciao, piccolino... Come va?\"",
  "SM_002140_0090_CER": "\"Era un tipo violento! E io avrei dovuto\r\nfare la comparsa nello spettacolo di\r\nqualcun altro? No, grazie!\"",
  "SM_002130_0040_FAS": "\"Beh, almeno non sono una fata.\r\nSu questo puoi credermi.\"",
  "LV_002025_0010_CER": "Non possiamo abbandonarlo!",
  "CE_002810_0000_CER": "Sono stanca dei tuoi trucchi!\r\nCheshire!",
  "SM_002120_0020_CER": "Potrei andare più veloce,\r\nse tu mi portassi in groppa!",
  "SM_002020_0060_CER": "\"Senti, con o senza di te,\r\nio aiuterò quegli spiritelli.\r\nStai a guardare!\"",
  "SM_002130_0240_CER": "\"Ma... chi era?\"",
  "CE_002010_0000_CER": "Questa è la nostra chance!",
  "SM_002120_0010_CER": "Sto correndo più veloce che posso!",
  "SM_002020_0050_CER": "\"Uhm.\"",
  "LV_002080_0010_CER": "",
  "SM_002140_0130_CER": "\"Ignis, per caso sai dove\r\npossiamo trovare... i nuclei\r\nelementali che ci mancano?\"",
  "SM_002040_0170_CER": "\"A-anch'io sarò forte!\r\nMa lo farò con eleganza, a differenza\r\ndi certe creature di mia conoscenza!\"",
  "LV_002045_0010_NAR": "Per entrare bisogna abbassare\r\nquel ponte levatoio.",
  "SM_002140_0020_NAR": "Una voce familiare echeggiò\r\ndi nuovo fra gli alberi.",
  "SM_002010_0090_NAR": "Le labbra di Colm tremavano\r\nmentre parlava.\r\n\r\nSpiegò che le fate si divertivano\r\na catturare gli spiritelli e a\r\ntormentarli.",
  "SM_002060_0110_COL": "\"Cereza, sembri stanca.\r\nQui siamo al sicuro.\r\nPerché non ti riposi un po'?\"",
  "SM_002060_0080_CER": "\"Non l'ho mai visto così felice.\r\nGrazie.\"",
  "LV_002035_0110_NAR": "[FONT:10 ]Mpf, non sai fare niente senza di me![FONT:N ]",
  "BK_2010_0060_LUC": "\"Il caldo abbraccio di una madre...\r\nLo sentirai di nuovo. E anch'io...\"",
  "LV_002085_0020_NAR": "Le piaceva giocare con gli spiritelli,\r\nma il viaggio non era ancora finito.",
  "LV_002040_0020_CER": "O forse... ci vivevano degli umani?",
  "SM_002100_0160_NAR": "Salutarono Colm e proseguirono\r\nalla ricerca del lupo bianco,\r\nche si trovava poco più avanti!",
  "SM_002100_0070_CER": "\"Cheshire, ora hai recuperato\r\nle forze, vero?",
  "LV_002040_0010_CER": "Dove... siamo?\r\nIn un parco giochi per fate?",
  "BK_2010_0050_LUC": "\"Sei più forte di quanto credi...\r\nIl tuo desiderio di salvare\r\ngli altri ti darà la forza...\"",
  "LV_002085_0010_NAR": "Cereza si addentrò nella foresta.",
  "SM_002130_0200_FAS": "\"Ciò prova soltanto che hanno paura di\r\nte. E di quel demone, ovviamente...\"",
  "CE_002000_0010_CER": "Cheshire non ci arriva così in alto.\r\nNon è giusto!",
  "SM_002060_0120_CER": "\"Ora che lo dici... Sono stata\r\nsotto pressione fin da quando\r\nsono arrivata in questa foresta.\r\n\r\nGrazie di tutto, Colm.\"",
  "SM_002140_0140_FAS": "\"Certamente.\r\nIl prossimo nucleo\r\nsi trova in fondo al lago.\"",
  "SM_002100_0030_CER": "Chissà se lo rivedrò...",
  "SM_002060_0040_NAR": "[FONT:9 ]Non potrebbe importarmene\r\ndi meno degli smidollati come lui.[FONT:N ]",
  "SM_002130_0070_CER": "\"Va bene... Ehm...\r\nUltimamente hai visto dei lupi\r\nbian-... cioè, neri, nella foresta?\"",
  "SM_002030_0030_CER": "\"Ah, è così?\"",
  "LV_002065_0110_CER": "Sinceramente, prima di conoscerti\r\npensavo che gli spiritelli esistessero\r\nsolo nelle favole.",
  "SM_002030_0000_CER": "\"L'hai fatta tanto lunga,\r\nma alla fine hai deciso di aiutarmi!\"",
  "SM_002060_0070_NAR": "[FONT:9 ]Pensi che la fame di un demone\r\nsi plachi tanto facilmente?[FONT:N ]\r\nMa la saliva che gli colava dalla bocca\r\ntradiva la sua apparente freddezza.",
  "LV_002935_0000_CER": "Vedi?\r\nTi avevo detto che li avrei salvati io.",
  "SM_002080_0020_NAR": "Ma Cheshire non era affatto convinto.",
  "SM_002100_0000_CER": "\"E anch'io...\"",
  "BK_8100_0000_CER": "\"È come l'altra volta...\"",
  "BK_2000_0020_NAR": "Una fata enorme li colse di sorpresa.\r\nAncora una volta, Cereza rimase\r\npietrificata per la paura.",
  "SM_002020_0020_CER": "\"Sapevo che saresti venuto.\r\nDopotutto hai bisogno del mio\r\npotere magico. Dal momento che\r\nsei qui, posso contare sul tuo aiuto?\"",
  "SM_002040_0090_CER": "\"Non sai come ci si sente a essere\r\nallontanati da qualcuno che ami?\"",
  "SM_002130_0000_FAS": "\"Salve, signorina.\"",
  "SM_002040_0010_NAR": "Cereza si sforzò di fare la dura,\r\nma si vergognava di essere stata\r\nsalvata ancora una volta dal demone.",
  "SM_002010_0060_COL": "\"Io sono Colm!\"",
  "SM_002130_0190_FAS": "\"Hai provocato un gran subbuglio\r\nfra quelle fate, da quando ti sei\r\naddentrata in questa foresta.\"",
  "LV_002015_0010_CER": "Cheshire, c'è uno spiritello nei guai.\r\nAndiamo ad aiutarlo!",
  "SM_002040_0020_NAR": "Cheshire non si aspettava altro.\r\nSedutosi, osservava gli spiritelli\r\ncon un'espressione disinteressata.",
  "SM_002130_0030_FAS": "\"Ottima domanda. Diciamo che...\r\nsono colei a cui chiedere, se vuoi\r\nsapere qualcosa su questa foresta.\"",
  "SM_002010_0140_NAR": "Lo spiritello non fu l'unico a stupirsi\r\ndell'audace affermazione di Cereza.",
  "CE_002020_0000_CER": "Tu non vai da nessuna parte!",
  "SM_002110_0100_NAR": "[FONT:9 ]Ah! Hai tutto quel pelo sulla testa\r\ne non ti serve a niente.[FONT:N ]\r\nreplicò il demone con insolenza.",
  "SM_002140_0170_CER": "\"Il problema è... ritornare in superficie.\"",
  "SM_002040_0130_CER": "\"Eri appena nato?\r\nAllora tu sei...\"",
  "SM_002020_0090_NAR": "Cereza fece finta di non sentire\r\ne proseguì in fretta.",
  "SM_002120_0050_CER": "Lo sapevo...",
  "SM_002130_0230_CER": "\"È... sparita.\""
}
