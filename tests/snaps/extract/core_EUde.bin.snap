{
  "CORE_DIALOG_TXT_112": "Du hast das Kostüm\r\n„Cereza im Wunderland“\r\nerhalten.",
  "CORE_DIALOG_TXT_101": "Wähle in einem Unterschlupf\r\n„Kostüme“, um Cerezas und\r\nCheshires Aussehen zu ändern.",
  "AC_NARRATION235_0010": "Die reißende Strömung dieses Wasserfalls\r\nergoss sich in den See Nimueh.",
  "CORE_SNPSS_4020": "Cereza entdeckt, dass Cheshire\r\nvon den Feen gefangen wurde.\r\nSie beschließt, ihren Streit mit\r\nihm erst mal zu vergessen und\r\nschleicht sich in die Festung,\r\nwobei ihr der weiße Wolf ein\r\nwenig hilft.",
  "CORE_WISP_TALK_71_FAS": "Sei gegrüßt, Cereza. Hast du Erfolg\r\nbei der Suche der Wolfsspuren?",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "Hindernis",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "Groll",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "Bedingung zum Freischalten:\r\nLerne genug Talente mit Cheshire.",
  "CORE_WH_TALK_11_COL": "Dank euch haben wir hier einen\r\nRiesenspaß. Wieso bleibt ihr\r\nnicht ein wenig und spielt mit?",
  "CORE_SNPSS_6010": "Als Lukaon die beiden hintergeht,\r\narbeiten Cereza und Cheshire\r\nzusammen, um ihn aufzuhalten.\r\nSchließlich kommt Lukaon wieder\r\nzur Vernunft und hilft ihnen\r\nbei der Suche nach einem Weg\r\naus dem Wald.",
  "CORE_HTDMMESS_0039_001_H39": "Hust, hust... Entschuldige...\r\nMir geht's nicht so gut.\r\nHast du vielleicht Medizin?",
  "CORE_HTDMQUEST_TXT_0026": "Auch im Wald ist ein gepflegtes\r\nErscheinungsbild wichtig! Ich\r\nmöchte eine Blume, die mir steht.",
  "AC_NARRATION260_0010": "Cereza und Cheshire hatten so viele\r\nIrrlichter gerettet, dass die unterdrückten\r\nSeelen Avalons sie als Helden feierten.",
  "CORE_WH_TALK_04_COL": "Wow, eine Menge Irrlichter sind zurück!\r\nAlles dank dir und deinem, ähm... Dämon?",
  "CORE_POSEMENU_TXT_06": "Verlasse das Tír na nÓg.",
  "CORE_HTDMMESS_0023_001_H23": "Puuuh, echt fies, dieser Hunger...\r\nIch hab einen solchen Kohldampf...\r\nWo finde ich bloß was zu essen?",
  "CORE_WISP_TALK_64_FAS": "Ich bin deine Führerin durch\r\nAvalon. Ich bringe dich hin,\r\nwo immer du möchtest.",
  "CORE_SNPSS_3030": "In einem harten Kampf\r\nbezwingen Cereza und\r\nCheshire den Jabberwock.\r\nDer weiße Wolf führt sie\r\nzu dem Schrein des\r\nElementarkerns.",
  "CORE_SVSLT_TXT_02": "Wähle eine Datei zum Laden.",
  "AC_CEREZA040_0010": "Niemand kann dich leiden.\r\nGlaubst du wirklich, du hast das\r\nZeug zu einer großartigen Hexe?",
  "CORE_SNPSS_1000": "Cereza schreitet durch\r\ndas unwirtliche Gebiet.\r\nIhre Schritte wirken\r\ndabei irgendwie gehetzt...",
  "CORE_HTDMMESS_0013_002_H13": "Ich kann sie hören, weißt du...\r\nDie Stimmen, die mich aus fremden\r\nDimensionen zu sich rufen...",
  "CORE_WISP_TALK_28_H14": "Juchhu! Endlich frei! Ich muss sofort\r\nzurück zu den anderen und ein riesiges\r\nFestmahl für alle zubereiten!",
  "CORE_HTDMMESS_0021_002_H21": "Vielleicht eine Feder für den Hut...\r\nDamit wäre man gewiss populär!",
  "CORE_POSEMENU_TXT_02": "Sieh dir Tutorials an.",
  "CORE_POSEMENU_TXT_11": "Setze dein Spiel ab dem\r\nletzten Speichern fort.",
  "CORE_WISP_TALK_17_H03": "Du hast mich gerettet... Danke dafür.\r\nGut! Dann wollen wir mal das Tor öffnen!",
  "TA_9011_0010_COL": "Sei bloß vorsichtig!",
  "CORE_DIALOG_TXT_005": "Gelöschte Daten können nicht\r\nwiederhergestellt werden.\r\nSpeicherdaten trotzdem löschen?",
  "CORE_DIALOG_TXT_116": "Du hast die Kostüme\r\n„Ursprüngliche Erz-Eva“,\r\n„Jeanne“ und „Charles“ erhalten.",
  "CORE_DIALOG_TXT_105": "Kostüm-Menü schließen?",
  "CORE_HAIR_CERESSA_TXT_03": "Entschlossen",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "Verwünschung",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "Tiefe Finsternis",
  "CORE_WH_TALK_21_COL": "Wenn ihr irgendwelchen Irrlichtern\r\nbegegnet, sagt ihnen, wo die Zuflucht\r\nist. Sie irren sonst allein umher...",
  "CORE_WISP_TALK_21_H07": "Jippie, ich kann mich wieder bewegen!\r\nDanke, vielen Dank! Das ist echt toll!",
  "TEST_WISP_TALK_13_H00": "Hmm... Ich hab ein sehr ungutes Gefühl...\r\nIst es in Ordnung, wenn wir hier warten\r\nund ihr erst einmal vorgeht?\r\n",
  "CORE_HTDMMESS_0004_002_H04": "Puuuh... Hoffentlich kommen mich die\r\nFeen nicht holen! Bitte, du musst mir\r\nhelfen, mich vor ihnen zu verstecken!",
  "CORE_DIALOG_TXT_150": "Hier kannst du ändern, wie viel Schaden\r\nCereza nehmen soll. „Weniger“ verringert\r\nden erlittenen Schaden, „Keiner“ lässt\r\ndich gar keinen Schaden nehmen.",
  "TA_COM030_0010_CER": "Hmpf!",
  "CORE_HTDMQUEST_TXT_0039": "Ich fühle mich gar nicht gut...\r\nHast du eine Idee, was man\r\ngegen eine Erkältung tun kann?",
  "CORE_WH_TALK_18_COL": "Oh! Cereza, Cheshire!\r\nDanke, dass ihr alle gerettet habt!",
  "TA_COM030_0020_CER": "Hey!",
  "CORE_DIALOG_TXT_154": "Wenn dir der Hexenpuls Schwierigkeiten\r\nbereitet, kannst du auch einstellen,\r\ndass Cereza sich automatisch darum\r\nkümmert. Was ist dir lieber?",
  "CORE_WISP_TALK_25_H11": "Danke für die Hilfe!\r\nUnd jetzt nichts wie weg hier!",
  "CORE_ARCHIVE_TXT_03": "Im Wald gefundene Aufzeichnungen.",
  "AC_CEREZA130_0010": "Das ist nicht wahr!",
  "CORE_WH_TALK_02_COL": "Falls ihr noch mehr unserer Freunde findet,\r\nerzählt ihnen unbedingt von diesem Ort!\r\nAnsonsten verlaufen sie sich nur im Wald.",
  "CORE_WISP_TALK_32_H18": "Huch! Danke, dass du mich gerettet\r\nhast! Diese verdammten Feen...\r\nDie können was erleben!",
  "CORE_HTDMMESS_0029_003_H29": "Diese Medizin... Hmmm... Ist das...?\r\nIch glaube, davon könnte ich\r\ntatsächlich etwas wacher werden.",
  "AC_NARRATION225_0020": "Sie hatten keine Ahnung, was sie\r\nnun erwarten würde...",
  "CORE_HTDMMESS_0034_001_H34": "Örks, mein Hals macht mich fertig...\r\nHast du irgendwas dabei, das mir\r\nhelfen könnte?",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "Unheil (Prüfung)",
  "CORE_WH_TALK_17_COL": "Bitte, das ist für euch.\r\nIch hoffe, es wird euch helfen!",
  "CORE_HTDMMESS_0006_001_H06": "Du hast nicht zufällig etwas, das ich als\r\nNadelersatz nehmen könnte? Egal was,\r\nHauptsache spitz.",
  "CORE_SNPSS_2010": "Cereza und Cheshire begegnen\r\nColm, einem Irrlicht, dessen\r\nFreunde von den Feen entführt\r\nwurden. Nach einem Streit mit\r\nCheshire bricht Cereza allein\r\nauf, um Colms Freunde zu retten.",
  "CORE_DIALOG_TXT_009": "In dieses Gebiet reisen?",
  "CORE_SNPSS_0020": "Cereza vertraut dem Jungen, den\r\nsie in ihren Träumen gesehen hat,\r\nund widersetzt sich dem Verbot\r\nihrer Lehrerin. Ihre Furcht so gut\r\nes geht beiseiteschiebend, betritt\r\nsie den großen, unbekannten Wald.",
  "CORE_WISP_TALK_30_H16": "Vielen Dank für deine Hilfe. Ich habe\r\ngehört, dass sich noch viele meiner\r\nFreunde in diesem Turm befinden...",
  "AC_CEREZA035_0010": "Lass gut sein.\r\nDu wirst dich nie ändern.",
  "TA_COM000_0010_CER": "Hm?",
  "CORE_HTDMQUEST_TXT_0029": "Puuuh, ist das alles öde hier...\r\nWäre toll, wenn jemand für\r\netwas Schwung sorgen könnte.",
  "CORE_WISP_TALK_15_H01": "Gähn... Danke für die Hilfe. Ich suche mir\r\nerst mal einen Ort für ein Nickerchen...",
  "CORE_DIALOG_TXT_153": "Hier kannst du den Schwierigkeitsgrad der\r\nGegner ändern. „Schwach“ macht Gegner weniger\r\naggressiv und lässt sie seltener angreifen.\r\n„Schwächling“ reduziert ferner ihre Anzahl.",
  "CORE_DIALOG_TXT_140": "Alle bisherigen Reiseweisheiten\r\nnoch einmal ansehen? (Du kannst\r\ndie Reiseweisheiten auch jeder-\r\nzeit im Systemmenü aufrufen.)",
  "CORE_SNPSS_5010": "Cereza kann Cheshire erfolgreich\r\nberuhigen, nachdem dieser von\r\nPúca mit einem Zauber belegt\r\nworden war. Die beiden erkennen,\r\nwie sehr sie einander inzwischen\r\nvertrauen, und brechen schließlich\r\nwieder auf, um Lukaon zu finden.",
  "CORE_ARCHIVE_TXT_04": "Erinnerungen an die Reise.",
  "CORE_HTDMMESS_0032_001_H32": "Colm gibt immer sein Bestes für uns.\r\nIch will mich dafür irgendwie erkenntlich\r\nzeigen. Fällt dir vielleicht etwas ein?",
  "TA_COM000_0020_CER": "Was ist das...?",
  "AC_NARRATION240_0010": "Klares, glitzerndes Wasser\r\nsprudelte fortwährend hervor und\r\nversorgte ganz Avalon mit Leben.",
  "CORE_WISP_TALK_23_H09": "Vielen Dank für deine Hilfe.\r\nIch nehme an, mein einzigartiger\r\nCharme hat dich dazu verleitet?",
  "AC_NARRATION215_0010": "Die Zuflucht der Irrlichter, eine geheime\r\nBasis, tief im Wald verborgen...",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "Nahtod",
  "CORE_HTDMMESS_0028_001_H28": "Wenn ich lerne, Schmerzen zu ertragen,\r\nwerden mir auch die Feen keine Angst mehr\r\nmachen! Also bitte, hilf mir dabei...",
  "CORE_DIALOG_TXT_119": "Du hast das Kostüm\r\n„Ungeschickte Hexe“\r\nerhalten.",
  "CORE_WISP_TALK_14_02_H16": "Drinnen soll es von Feen nur so wimmeln.\r\nIch hoffe, den anderen geht es gut...",
  "CORE_HTDMMESS_0017_001_H17": "Dicke Fische! So richtig große Oschis!\r\nHey, Hexenmädchen! Hast du eine Idee,\r\nwo ich ein paar gute Köder finde?",
  "AC_NARRATION250_0020": "Als sie den warmen Sand und die kühle Brise\r\ngenoss, fragte sich Cereza, ob die Herzen\r\nder Feen wohl doch etwas Sanftmut besaßen.",
  "CORE_DIALOG_TXT_011": "Reise zum gewählten Zielort\r\nmomentan nicht möglich.",
  "AC_CEREZA145_0010": "Hör auf... Hör auf zu reden!",
  "CORE_DIALOG_TXT_002": "Auf diesem Speicherplatz wurden\r\nbereits Daten gespeichert.\r\nMöchtest du sie überschreiben?",
  "CORE_HAIR_CERESSA_TXT_04": "Ein neues Kapitel",
  "CORE_DIALOG_TXT_111": "Du hast das Kostüm\r\n„Eleganter Schwan“\r\nerhalten.",
  "CORE_DIALOG_TXT_102": "Möchtest du das gewählte\r\nOutfit für Cereza verwenden?",
  "CORE_WISP_TALK_62_COL": "Ich bin so froh, dass alle\r\nin Sicherheit sind.\r\nVielen Dank, Cereza!",
  "CORE_SNPSS_4030": "Cereza rettet den schwer\r\nverletzten Cheshire. Endlich\r\nsind sie wieder vereint! Dann\r\nerscheint der weiße Wolf tief\r\nim Innern der Festung und\r\ngemeinsam folgen sie ihm.",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "Wendung",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "Ketten",
  "CORE_POSEMENU_TXT_05": "Beginne erneut vom letzten\r\nCheckpoint im Tír na nÓg.",
  "CORE_SNPSS_1010": "Cereza, die unter der Trennung\r\nvon ihrer Mutter Rosa leidet,\r\nwird zur Schülerin der Hexe\r\nMorgana und übt täglich,\r\num eines Tages selbst eine\r\nmächtige Hexe zu werden.",
  "CORE_HTDMQUEST_TXT_0032": "Ich würde meinem Freund gern\r\neine kleine Freude bereiten. Weißt\r\ndu nicht ein Geschenk für ihn?",
  "CORE_HTDMQUEST_TXT_0021": "Ich suche nach einer Verzierung,\r\ndie meine edle Persönlichkeit\r\nnoch besser zur Geltung bringt.",
  "CORE_POSEMENU_TXT_01": "Ändere verschiedene\r\nSpieleinstellungen.",
  "AC_IGNIS005_0010": "Hallo. Benötigst du meine Dienste?\r\nDu kannst auf mich zählen,\r\nwenn es um Geheimwege geht!",
  "CORE_SNPSS_3020": "Dank Cerezas Einfall konnten sie\r\ndas Monster zu zweit vertreiben.\r\nMit etwas mehr Selbstvertrauen\r\nnimmt sie mit Cheshire an ihrer\r\nSeite die Suche nach dem nächsten\r\nElementarkern wieder auf.",
  "CORE_SVSLT_TXT_01": "Wähle einen Speicherplatz.",
  "CORE_DIALOG_TXT_115": "Du hast die Kostüme\r\n„Das rechte Auge“ und\r\n„Beobachterin der Zeit“\r\nerhalten.",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "Eile",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "Eisregen",
  "CORE_HTDMMESS_0015_002_H15": "Hallo, ich muss nur gerade\r\nmeine Notizen fertigschreiben,\r\neinen Moment...",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "Bedingung zum Freischalten:\r\nFinde alle Tír na nÓg-Schätze.",
  "CORE_DIALOG_TXT_006": "Sind sie gelöscht, können sie\r\nnicht wiederhergestellt werden.\r\nMöchtest du die Speicherdaten\r\nwirklich löschen?",
  "CORE_MISSION_TEXT_0007": "Überwinde alle Hürden und\r\nschließe das Tír na nÓg ab!",
  "CORE_COSTUME_CHESHIRE_TXT_03": "Ich brauch nur meinen Hut und\r\nalles ist gut. Kümmer dich nicht\r\num jene, die mich verrückt nennen.",
  "CORE_DIALOG_TXT_160": "Möchtest du Tutorials für diesen\r\nSpieldurchlauf abstellen? Du\r\nkannst sie jederzeit wieder\r\nin den Optionen aktivieren.",
  "AC_CEREZA060_0030": "Falsche Richtung.",
  "CORE_HTDMMESS_0008_001_H08": "Ich will so stark sein, dass ich\r\ngegen jede Fee ankomme, die ich\r\nsehe! Kannst du mir dabei helfen?",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "Groll (Prüfung)",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "Raserei (Prüfung)",
  "CORE_CSRELEASE_CERESSA_TXT_04": "Bedingung zum Freischalten:\r\nLerne genug Talente mit Cereza.",
  "TEST_WISP_TALK_10": "Puh... Ich bin natürlich froh,\r\nentkommen zu sein... Nur mit\r\nHöhen hab ich es nicht so...",
  "TEST_WISP_TALK_03": "Vielen Dank. Folgt mir.\r\nIch öffne euch das Tor.",
  "CORE_HTDMMESS_0015_003_H15": "Das... Das ist von einer Mandragora!\r\nUnd gut erhalten noch dazu! Das muss\r\nich unbedingt genauer studieren!",
  "AC_CEREZA050_0010": "Du bekommst doch allein gar nichts hin.\r\nAber, hey – irgendwer wird schon kommen\r\nund dich retten, stimmt's?",
  "CORE_WISP_TALK_44_H30": "Was für eine Schmach, dass sie mich\r\ntatsächlich erwischt haben... Aber\r\njetzt werde ich alle beschützen!",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "Cereza, die unter der Trennung\r\nvon ihrer Mutter Rosa leidet,\r\nwird zur Schülerin der Hexe\r\nMorgana und übt täglich,\r\num eines Tages selbst eine\r\nmächtige Hexe zu werden.",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "Vergeltung",
  "CORE_SNPSS_2020": "Cereza und Cheshire sind wieder\r\nvereint. Gemeinsam stoßen sie\r\nauf die Feenreich-Warte, wo die\r\nIrrlichter von den Feen gefoltert\r\nwerden. Sie bahnen sich einen\r\nWeg hinein.",
  "CORE_NPC_TXT_11": "Verwende Zutaten,\r\num Items zu brauen.",
  "TEST_WISP_TALK_07": "Pass bloß auf, wenn du weitergehst!\r\nDieser Zirkus ist total gruselig...",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "Zwielicht (Prüf.)",
  "AC_NARRATION225_0010": "Alle Elementarkerne waren zerstört\r\nworden. Somit stand ihnen keine\r\nBarriere mehr im Weg.",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "Getrampel (Prüf.)",
  "CORE_MISSION_TEXT_0003": "1 Treffer tötet dich. Weiche\r\njedem aus und besiege alle!",
  "CORE_WISP_TALK_34_H20": "Bah... Mir tut alles weh...\r\nDanke für die Hilfe, kleine Hexe.",
  "CORE_WISP_TALK_54_H40": "Sehet her, ich kehre zurück\r\nin diese Zeit, in dieses Leben!",
  "CORE_DIALOG_TXT_090": "Wähle einen Spielstand für deine\r\nDurchspiel-Daten. Mit diesem Spielstand\r\nkannst du weitere Geheimnisse suchen\r\nund Gegenden erkunden.",
  "CORE_CSRELEASE_CERESSA_TXT_08": "Bedingung zum Freischalten:\r\nErlebe Jeannes Heldentaten.",
  "CORE_WISP_TALK_14_H16": "Wenn wir es schaffen, diesen Hebel zu\r\nbetätigen, solltet ihr in den Turm kommen!",
  "CORE_BAND_CHESHIRE_TXT_02": "Widerstandsfähig",
  "AC_NARRATION260_0020": "Die friedlichen Einwohner des Waldes würden\r\nnoch für viele Jahre Lieder über die gütige\r\nHexe und ihren standhaften Dämonen singen.",
  "CORE_COSTUME_CERESSA_TXT_07": "Eine starke und zugleich gütige\r\nHexe eilt ihrer Freundin zu Hilfe.\r\nDie Zukunft wird ihr gehören.",
  "CORE_DIALOG_TXT_031": "Tír na nÓg verlassen?",
  "TA_COM025_0020_CER": "Okay!",
  "CORE_WISP_TALK_14_03_H16": "Ich hab gehört, dass ihr meinen Freunden\r\ngeholfen habt! Das muss ich unbedingt den\r\nanderen erzählen...",
  "CORE_SNPSS_6020": "Púca ruft eine ganze Feenarmee\r\nherbei, um Cereza aufzuhalten.\r\nCheshire lässt Cereza daraufhin\r\nauf seinem Rücken reiten und so\r\neilen die zwei einer Lichtsäule\r\nentgegen, die von Morgana\r\nerschaffen wurde.",
  "AC_NARRATION235_0020": "Im Angesicht der tosenden Stromschnellen\r\nfühlte Cereza sich ganz klein.",
  "CORE_WISP_TALK_49_H35": "Oho, ich wurde befreit! Dann kann\r\nich ja endlich zurück und wieder\r\ntolle neue Sachen erfinden!",
  "CORE_SNPSS_4010": "Die Feen erschaffen ein Trugbild\r\nvon Cerezas Mutter, wodurch\r\nes am Ende zu einem schlimmen\r\nStreit zwischen Cereza und\r\nCheshire kommt. Cereza lässt\r\nCheshire zurück und begibt\r\nsich allein zur Festung.",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "Tapferkeit",
  "TA_COM025_0010_CER": "Puh!",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "Abwärts",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "Limitationen",
  "CORE_RETRY_TXT_01": "Möchtest du die benötigten\r\nItems verwenden, um dieses\r\nTír na nÓg freizuschalten?",
  "AC_CEREZA015_0020": "Keine Sorge, ich rette dich.",
  "CORE_COSTUME_CERESSA_TXT_03": "Das Mädchen plant ein Buch über\r\nihre Reise ins wundersame Land,\r\nfalls sie es nach Hause schafft.",
  "CORE_SNPSS_1030": "Cerezas schicksalhafte Begegnung\r\nmit Cheshire. Die zwei beginnen\r\nihre Suche nach dem weißen Wolf,\r\nwelcher angeblich in der Lage sein\r\nsoll, ihnen zu einer unglaublichen\r\nKraft zu verhelfen, mit der Cereza\r\nhoffentlich auch Cheshire wieder\r\nnach Inferno heimschicken kann.",
  "CORE_HTDMMESS_0037_001_H37": "Ich mag die Ruhe hier, aber manchmal\r\nhätte ich auch gerne etwas Abwechslung.\r\nHast du irgendwelche Ideen?",
  "CORE_WISP_TALK_39_H25": "I-ist mir k-k-kalt! Ich dachte schon, ich\r\nmüsste hier zum Eiszapfen werden! Danke.\r\nIrgendwann zahl ich's den Feen heim...",
  "CORE_HTDMQUEST_TXT_0006": "Ich wünschte, ich hätte eine\r\nNadel zum Nähen. Du weißt nicht,\r\nwo ich eine finden kann?",
  "CORE_HTDMQUEST_TXT_0015": "Ich habe mich lange nicht mehr\r\nder Pflanzenforschung gewidmet.\r\nMagst du mir dabei assistieren?",
  "CORE_BAND_CHESHIRE_TXT_01": "Standard",
  "CORE_MISSION_TEXT_0008": "Besiege alle Feen!",
  "CORE_HTDMMESS_0029_002_H29": "Seitdem mich diese Feen gefangen\r\nhaben... erscheint mir einfach\r\nalles so lästig...",
  "CORE_WH_TALK_03_COL": "Diese Feen... Ich frage mich, wie sie\r\nnur so grausam sein können...",
  "CORE_WH_TALK_19_COL": "Alle wollen sich bei euch bedanken.\r\nHey, Leute, kommt her!",
  "CORE_WISP_TALK_63_FAS": "Cereza. Wenn du dich je\r\nim Wald verirrst, bitte\r\neinfach mich um Hilfe.",
  "CORE_NPC_TXT_09": "Versuche dich erneut an einem Tír\r\nna nÓg oder spiele gegen die Zeit.",
  "CORE_DIALOG_TXT_121": "Du hast das Kostüm\r\n„Beobachterin der Zeit“\r\nerhalten.",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "Illusion",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "Unheil",
  "CORE_WH_TALK_16_COL": "Cereza, Cheshire, danke für alles!\r\nHier ist ein Zeichen meiner Wertschätzung.",
  "CORE_COSTUME_CERESSA_TXT_04": "„Bring mich zurück nach Inferno\r\noder ich reiße dich in Stücke!“\r\nHihi, ziemlich überzeugend, oder?",
  "CORE_DIALOG_TXT_021": "Brauvorgang beginnen?",
  "CORE_DIALOG_TXT_032": "Möchtest du das Tír na nÓg\r\nerneut beginnen?\r\n(Der aktuelle Spielfortschritt\r\ngeht dabei verloren.)",
  "CORE_SNPSS_6030": "Morgana offenbart ihre Absicht,\r\nCheshire zu opfern, um das Leben\r\nihres Sohnes zu retten. Cereza\r\nnimmt allen Mut zusammen, um\r\nsich der Hexe entgegenzustellen,\r\ndie einst ihre Lehrerin war.",
  "CORE_WISP_TALK_36_H22": "Ich... Ich kann mich wieder bewegen?\r\nUnd du hast mich gerettet? Danke!",
  "AC_NARRATION250_0010": "Dieser helle Strand mit sanft plätschernden\r\nWellen stellte einen ziemlichen Kontrast\r\nzum sonst so unheimlichen Wald dar.",
  "TEST_WISP_TALK_12_H00": "Fast geschafft! Ein Irrlicht noch,\r\ndann sollte das klappen!",
  "CORE_HTDMMESS_0004_003_H04": "Danke für deine Hilfe! Moment, wie\r\nwar das? Ein Unterschlupf? Wo denn?\r\nDort ist's bestimmt sicherer als hier!",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "Lebensgefahr",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "Einstich",
  "TA_COM015_0010_CER": "Das ist es!",
  "CORE_RETRY_TXT_02": "Dieses Tír na nÓg\r\nerneut beginnen?",
  "TEST_WISP_TALK_08": "Wenn der Anführer euch\r\nfindet, ist alles aus.\r\nSeid bloß vorsichtig.",
  "CORE_SNPSS_3010": "Das Duo wird überrascht\r\nvon einem Monster mit einer\r\nPanzerung, gegen welche selbst\r\nCheshires Klauen sich als\r\nnutzlos erweisen. Von Angst\r\nergriffen flüchtet Cereza in den\r\nWald, um sich zu verstecken.",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "Druck (Prüfung)",
  "CORE_SNPSS_1020": "Cereza vertraut dem Jungen, den\r\nsie in ihren Träumen gesehen hat,\r\nund widersetzt sich dem Verbot\r\nihrer Lehrerin. Ihre Furcht so gut\r\nes geht beiseiteschiebend, betritt\r\nsie den großen, unbekannten Wald.",
  "CORE_HTDMMESS_0013_003_H13": "Hehe... Großartig! Du hast es\r\ntatsächlich besorgt. Danke für\r\ndie Hilfe, Schwester.",
  "CORE_HTDMMESS_0026_001_H26": "Man sollte stets auf sein Äußeres achten,\r\nauch hier. Bringst du mir also bitte eine\r\nhübsche Blume, wenn du Zeit hast?",
  "CORE_DIALOG_TXT_170": "In Jeannes Geschichte wird das Spiel\r\nan bestimmten Punkten automatisch\r\ngespeichert. Beachte bitte, dass\r\nmanuelles Speichern nicht möglich ist.",
  "AC_CEREZA060_0020": "Du bist so unbeholfen, das\r\nist schon nicht mehr witzig.",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "Schutz (Prüfung)",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "Einstich (Prüf.)",
  "CORE_CSRELEASE_CERESSA_TXT_07": "Bedingung zum Freischalten:\r\nSchließe die Verbotene Erzählung ab.",
  "CORE_HTDMMESS_0021_003_H21": "Oh, wie wunderbar! Genau, was ich gesucht\r\nhabe! Da fehlen mir glatt die Worte!\r\nDas muss ich sofort allen zeigen!",
  "CORE_NPC_TXT_05": "Speichere deinen Spielfortschritt.",
  "CORE_MISSION_TEXT_0004": "Besiege alle Gegner! Achtung:\r\nBesiegte hinterlassen Flüche.",
  "CORE_WH_TALK_20_COL": "Es befinden sich immer noch Irrlichter\r\nim Wald. Bitte, ihr müsst ihnen helfen!",
  "CORE_COSTUME_CERESSA_TXT_08": "Ich trotze allen Widrigkeiten und\r\nfand mein wahres Ich. Nun werde\r\nich mit meinem Prinzen vereint.",
  "AC_IGNIS015_0010": "Wie läuft es mit der Reise durch den Wald?\r\nWenn ich dir einen Schleichweg zeigen soll,\r\nlass es mich einfach wissen.",
  "AC_NARRATION215_0020": "Dank Cereza und Cheshire begann sich\r\ndieser Ort wieder mit freudigen und\r\nverspielten Stimmen zu füllen.",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "Getrampel",
  "CORE_WH_TALK_10_COL": "Cereza! Und dein vierpfotiger Freund!\r\nWie geht es euch? Wir haben euch vermisst!",
  "CORE_ARCHIVE_TXT_99": "Noch nicht freigeschaltet.",
  "CORE_SNPSS_2030": "Cereza und Cheshire retten Colms\r\nFreunde vor den Feen. Nach einem\r\nfreudigen Wiedersehen unter den\r\nIrrlichtern folgen Cereza und\r\nCheshire ihren neuen Kameraden.",
  "CORE_WISP_TALK_70_FAS": "Falls du dich verläufst, suche die\r\nSpuren des weißen Wolfs. Er kennt\r\nden Wald ebenso gut wie ich.",
  "CORE_WISP_TALK_65_FAS": "Hast du Wolfsspuren gefunden?\r\nIch kann dich in ihre Nähe\r\nbringen, wenn du magst.",
  "AC_CEREZA155_0010": "Hör auf... Bitte!",
  "CORE_COSTUME_CHESHIRE_TXT_04": "[FONT:10 ]„Ich werde eine starke Hexe und\r\nrette dann meine Mami und so!“\r\nHa. Perfekt imitiert.[FONT:N ]",
  "AC_NARRATION240_0020": "Cereza und Cheshire tranken davon\r\nund fühlten sich im Nu erfrischt.",
  "TEST_WISP_TALK_04": "Ich dachte schon, ich\r\nbekomme einen langen Hals.\r\nHütet euch vor den Feen!",
  "CORE_CSRELEASE_CERESSA_TXT_03": "Bedingung zum Freischalten:\r\nSchneide gut ab in Kämpfen auf Zeit.",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "Abwärts (Prüfung)",
  "CORE_WH_TALK_05_COL": "In letzter Zeit halten wir abwechselnd\r\nWache. Die Feen dürfen diesen\r\nZufluchtsort auf keinen Fall entdecken!",
  "CORE_WH_TALK_22_COL": "Entschuldigt, dass ich euch so oft um\r\nHilfe bitte, aber wenn es euch irgendwie\r\nmöglich ist, dann rettet unsere Freunde!",
  "CORE_BAND_CHESHIRE_TXT_04": "Bandage der Bande",
  "CORE_WISP_TALK_58_FAS": "Hütet euch vor den Feen.\r\nSie kennen keine Gnade.",
  "AC_IGNIS200_0010_0020": "Der geheime Pfad erwartet uns...",
  "TEST_WISP_TALK_09": "Ich werde mich hier verstecken.\r\nVerrate das bloß niemandem!",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "Flucht (Prüfung)",
  "AC_CEREZA030_0010": "Was für ein Feigling...\r\nDu bist zum Scheitern verurteilt!",
  "CORE_SNPSS_2060": "Nachdem sie den zweiten\r\nElementarkern zerstört haben,\r\nprobieren Cereza und Cheshire\r\nihre neu gewonnenen Kräfte aus,\r\nwährend sie erneut dem weißen\r\nWolf hinterherjagen.",
  "CORE_HTDMMESS_0021_001_H21": "Ich hasse es, mich ständig verstecken zu\r\nmüssen. Beschaffe mir etwas, das mich\r\nwirklich hervorstechen lässt!",
  "CORE_WISP_TALK_57_FAS": "Ich hoffe, ihr schafft das auch ohne\r\nKletterausrüstung und Taucheranzug.\r\nEs liegt eine Menge Arbeit vor euch.",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "Beschränkung",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "Jagd",
  "CORE_HTDMMESS_0013_001_H13": "Hehe... Hilfst du mir, Schwester?\r\nDas wird echt abgefahren, das\r\nkannst du mir glauben...",
  "CORE_HTDMMESS_0026_003_H26": "Oh, du wundervolle Hexe!\r\nIch könnte dich glatt küssen!",
  "CORE_COSTUME_CERESSA_TXT_01": "Eine junge Hexe, die ihre Mutter\r\nretten will, reist nach Avalon\r\nund begegnet einem Dämon.",
  "CORE_SNPSS_6035": "Cereza sieht das Ende von\r\nMorgana und Lukaon mit an,\r\nwelche beide Opfer eines\r\ngrausamen und traurigen\r\nSchicksals waren.\r\nDann wendet sie sich Cheshire\r\nzu, um endgültig Abschied zu\r\nnehmen, und schließlich...",
  "CORE_COSTUME_CERESSA_TXT_05": "Cerezas Kleidung aus früheren\r\nTagen. Sie erinnert sich noch, wie\r\nsie darin ihre Mami gesucht hat.",
  "CORE_DIALOG_TXT_033": "Möchtest du das Tír na nÓg\r\nerneut beginnen?",
  "CORE_WISP_TALK_67_FAS": "Der weiße Wolf scheint recht\r\nweit fort zu sein. Das ist aber\r\nfür Ignis kein Problem.",
  "AC_NARRATION245_0010": "Der Zahn der Zeit hatte an diesem Palast\r\nseine Spuren hinterlassen, doch ein Funken\r\nder einstigen Pracht war noch verblieben.",
  "CORE_WH_TALK_07_COL": "In der Zuflucht ist so viel los wie nie\r\nzuvor! Ich hoffe, wir können sie zu einem\r\nsicheren Ort für alle Irrlichter machen.",
  "CORE_DIALOG_TXT_120": "Du hast das Kostüm\r\n„Das rechte Auge“\r\nerhalten.",
  "CORE_HTDMMESS_0023_002_H23": "Bitte, du musst mir helfen...\r\nHast du nicht was Feines, damit\r\nmein Bäuchlein Ruhe gibt?",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "Raserei",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "Dornengefängnis",
  "CORE_HTDMMESS_0039_002_H39": "Keuch... Und ich dachte, als Irrlicht\r\nwerde ich nicht mehr krank...",
  "CORE_WISP_TALK_68_FAS": "Im Wald von Avalon verläuft man\r\nsich leicht. Soll ich dich in die\r\nNähe des weißen Wolfs bringen?",
  "CORE_WH_TALK_12_COL": "Ich habe ein wenig trainiert. Sieht man\r\ndas? Ich kann mich ja nicht ewig von\r\ndiesen Feen herumschubsen lassen.",
  "CORE_WISP_TALK_24_H10": "Danke, ähm... wer immer du bist.\r\nIch folge dir mal ein wenig.",
  "CORE_WH_TALK_08_COL": "Habt ihr gehört, dass wir jetzt einen\r\nSpähtrupp haben? Auch wenn wir im Kampf\r\nnicht wirklich gegen die Feen ankommen...",
  "CORE_WISP_TALK_33_H19": "Danke sehr. Es hat auch nur...\r\n34 506 250 Sekunden gedauert,\r\nbis mich jemand gerettet hat.",
  "AC_NARRATION210_0010": "Ein gigantischer Turm, erbaut von\r\nden Feen... Seltsame Gerätschaften\r\nlagen am Fuße dieses Turms verstreut.",
  "AC_NARRATION255_0020": "Wie lange es wohl gedauert hatte, bis so\r\nviele herangewachsen waren? Ehrfürchtig\r\nbestaunten sie das Werk dieses Waldes.",
  "TEST_WISP_TALK_05": "Selbst gegen eine kleine Fee\r\nkomme ich nicht an... Ich bin\r\necht zu nichts zu gebrauchen...",
  "CORE_CSRELEASE_CERESSA_TXT_02": "Bedingung zum Freischalten:\r\nRette genug Irrlichter.",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "Showdown (Prüf.)",
  "CORE_HTDMMESS_0006_002_H06": "Hmm... Diese Nadeln taugen alle nichts.\r\nWie soll man so nur arbeiten?",
  "CORE_MISSION_TEXT_0001": "Nur Dornenfessel ermöglicht\r\nSchaden. Besiege alle Gegner!",
  "CORE_HTDMMESS_0034_002_H34": "Ich muss hier eigentlich Wache schieben,\r\naber... wie soll ich denn um Hilfe rufen,\r\nwenn meine Stimme fast weg ist?!",
  "CORE_WH_TALK_14_COL": "Die Zuflucht der Irrlichter ist\r\nnoch größer geworden! Spielt\r\ndoch ein wenig mit uns, ja?",
  "CORE_COSTUME_CHESHIRE_TXT_05": "Im Spielzeugladen „Pygmalion“\r\ngekauft. Die Steuerung wechselt\r\nzu Jeanne/Charles.",
  "CORE_COSTUME_TXT_01": "Wähle ein neues Kostüm.",
  "CORE_SNPSS_1070": "Nachdem sie den ersten\r\nElementarkern erfolgreich\r\nzerstört haben, setzen Cereza\r\nund Cheshire ihre Reise in die\r\nTiefen des Waldes fort, um auch\r\ndie restlichen drei zu finden.",
  "TA_COM020_0010_CER": "Ach...",
  "CORE_WH_TALK_01_COL": "Hey, Cereza. Habt ihr noch mehr\r\nvon unseren Freunden gefunden?",
  "AC_NARRATION200_0020": "Sie vernahm das Flüstern einer mysteriösen\r\nKraft, das auf dem Wind aus den Tiefen\r\ndes Waldes an sie herangetragen wurde.",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "Dunkle Projektion",
  "CORE_SNPSS_3040": "Cereza und Cheshire zerstören den\r\ndritten Elementarkern. Mit ihren\r\nneu erlangten Kräften bahnen sie\r\nsich einen Weg in Richtung des\r\nletzten Exemplars.",
  "CORE_WISP_TALK_61_FAS": "Ich habe eine Nachricht von Colm. Er\r\nmöchte euch wiedersehen und fragt daher,\r\nob ihr bald mal wieder vorbeikommt.",
  "CORE_EVENT_PAUSE_TXT_01": "Drücke zum Fortfahren [BTN:START ].",
  "CORE_WISP_TALK_16_H02": "Danke! Ich gehe zurück zur Zuflucht und werde\r\nein paar Regeln dazu entwerfen, wie man sich\r\nim Fall einer Entführung durch Feen verhält...",
  "TA_COM020_0020_CER": "Ah...",
  "AC_IGNIS200_0000_0010": "Trödel nicht rum!",
  "CORE_COSTUME_CERESSA_TXT_09": "Die traditionelle Kleidung einer\r\nHexe in Ausbildung. Die Steuerung\r\nwechselt zu Jeanne/Charles.",
  "CORE_HTDMMESS_0004_001_H04": "Manchmal will ich mich einfach nur vor\r\nallem verstecken. Vielleicht hilft mir da\r\neine Pflanze weiter? Was denkst du?",
  "CORE_MISSION_TEXT_0005": "Beseitige Barrieren der Gegner\r\nmit passenden Elementen.",
  "CORE_COSTUME_CHESHIRE_TXT_01": "Verirrter Dämon mit Temperament.\r\nAuch sein neuer Flauschekörper\r\nkann seine Wildheit nicht zähmen.",
  "TEST_WISP_TALK_55_COL": "In diesem Turm sind noch weitere von\r\nuns gefangen... Ihr müsst sie retten!",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "Gefecht (Prüfung)",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "Jagd (Prüfung)",
  "TEST_WISP_TALK_01": "Danke, echt lieb von dir!",
  "CORE_SNPSS_4050": "Die zwei zerstören erfolgreich\r\nden letzten Elementarkern. Mit\r\nden dadurch gewonnenen neuen\r\nKräften lassen sie den Schrein\r\ndes Elementarkerns hinter sich.",
  "CORE_MISSION_TEXT_0002": "Besiege alle Gegner vor Ablauf\r\nder Zeit! Bezwungene Gegner\r\nverlängern das Zeitlimit!",
  "CORE_WISP_TALK_19_H05": "Puh, ich fühle mich schon viel besser!\r\nDanke, kleines Kätzchen. Wir sehen uns!",
  "AC_NARRATION230_0010": "Ein prächtiger Baum erhob sich vor ihnen,\r\ndessen schneeweiße Äste sich erstreckten,\r\nso weit das Auge reichte.",
  "CORE_DIALOG_TXT_091": "Glückwunsch! Es gibt jetzt neue Optionen:\r\n- Bei Spielstart Schwierigkeitsgrad wählen\r\n- Eine besondere Geschichte mit Jeanne\r\n- Ein Kostüm-Menü",
  "CORE_HTDMMESS_0028_002_H28": "Nur damit das klar ist: Ich mag\r\nSchmerzen genauso wenig wie jeder\r\nandere. Ich bin ja kein Masochist!",
  "CORE_NPC_TXT_10": "Ändere die Kostüme von\r\nCereza und Cheshire.",
  "TEST_WISP_TALK_06": "Meine Freunde wurden alle von\r\nden Feen geschnappt und sind\r\nbis heute nicht zurückgekommen...",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "Ketten (Prüfung)",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "Wendung (Prüfung)",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "Narretei",
  "CORE_SNPSS_3050": "Cereza und Cheshire finden\r\nheraus, dass der letzte\r\nElementarkern sich in\r\nPúcas Festung befindet.\r\nUm Lukaons, aber auch um\r\nihrer selbst willen fasst\r\nCereza den Entschluss, in\r\ndie Festung einzudringen.",
  "CORE_SNPSS_1060": "Morgana nimmt mithilfe eines\r\nZaubers Kontakt mit Cereza auf\r\nund erklärt ihr, dass es eine\r\nWeile dauern wird, ehe sie den\r\nWald verlassen kann.\r\nCereza beschließt, dem weißen\r\nWolf weiter zu folgen.",
  "CORE_WISP_TALK_26_H12": "Bin ich... frei? Ich habe zwar Angst,\r\naber ich muss jetzt stark sein...!",
  "CORE_HTDMMESS_0032_002_H32": "Ich habe nach einem Geschenk für Colm\r\ngesucht und mich dabei total verlaufen.",
  "TA_COM010_0010_CER": "Hmmm.",
  "AC_CEREZA045_0010": "Läufst mal wieder fort, was?\r\nDas überrascht mich nicht.",
  "CORE_HTDMMESS_0037_003_H37": "Danke... Das... Uff, das ist ein intensiver\r\nGeruch... Ich kehre lieber zur Zuflucht\r\nzurück, bevor die Feen mich finden.",
  "TA_COM010_0020_CER": "Mmm...",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "Nahtod (Prüfung)",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "Transport (Prüf.)",
  "CORE_CSRELEASE_CERESSA_TXT_05": "Bedingung zum Freischalten:\r\nSammle genug Erinnerungen.",
  "TEST_WISP_TALK_02": "Folge mir! Ich öffne das Tor!",
  "CORE_SNPSS_4040": "Nach ihrem Sieg über den selbst\r\nernannten Feenkönig Púca und\r\ndessen herbeigerufenen Engel\r\nbegeben Cereza und Cheshire\r\nsich zum letzten Elementarkern.",
  "CORE_MISSION_TEXT_0006": "Beeilung! Je länger die Zeit,\r\ndesto schlechter dein Rang.",
  "CORE_COSTUME_CHESHIRE_TXT_02": "Der Dämon verfluchte die Prinzes-\r\nsin und ihr Streben nach Liebe...\r\nCheshire ist das alles zu hoch.",
  "CORE_HTDMQUEST_TXT_0008": "Ich wäre gern stärker. Du bist\r\ndoch eine Hexe, oder? Kannst\r\ndu mir nicht helfen?",
  "CORE_SNPSS_2070": "Die zwei sind unterwegs zum\r\ndritten Elementarkern, welcher\r\nsich am Boden des Sees Nimueh\r\nbefinden soll. Um alles Wasser\r\naus dem See zu lassen, muss\r\nCereza jedoch erst den höchsten\r\nBaum des Waldes erklimmen.",
  "CORE_HTDMMESS_0015_001_H15": "In diesem Wald gibt es so viele\r\nWunder... Sag Bescheid, wenn du\r\neine seltsame Pflanze findest!",
  "CORE_HTDMQUEST_TXT_0013": "Ich würde zu gern aufsteigen...\r\nin eine höhere Existenzebene.\r\nHilf mir, Schwester...",
  "CORE_COSTUME_CERESSA_TXT_02": "Eine graziöse Ballerina spielt\r\neine Prinzessin, die in einen\r\nweißen Schwan verwandelt wurde.",
  "AC_IGNIS020_0010": "Der Wald von Avalon ist gefährlich.\r\nDa können sich Geheimpfade als\r\nsehr nützlich erweisen.",
  "CORE_HTDMMESS_0008_003_H08": "Ob mich das stärker macht? Puh,\r\ndas stinkt... Nun, ich werd's in\r\nder Zuflucht ausprobieren. Danke!",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "Showdown",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "Rotation",
  "CORE_DIALOG_TXT_130": "Du näherst dich dem Ende der\r\nGeschichte. Bist du bereit?",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "Führung",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "Zwielicht",
  "AC_CEREZA135_0010": "Ich... Ich...!",
  "AC_NARRATION220_0020": "Darüber prangte ein gewaltiger Riss am\r\nHimmel wie ein zackiges Maul. Was mochten\r\ndie Feen in der Festung nur planen...?",
  "CORE_COSTUME_CERESSA_TXT_06": "Nach einem 500-jährigen Schlaf ist\r\nsie erst Gefangene des Schicksals,\r\ndoch dann formt sie es selbst.",
  "CORE_DIALOG_TXT_030": "Diese Etage zurücksetzen?\r\nGesammelte Items werden\r\ntrotzdem behalten.",
  "CORE_HTDMQUEST_TXT_0004": "Immer nur Angst haben ist\r\ndoof... Kann ich mich nicht\r\nirgendwo verkriechen?",
  "CORE_HTDMQUEST_TXT_0017": "Dicke Fische zieht man nur mit\r\nden richtigen Ködern an Land!\r\nHilfst du mir, welche zu finden?",
  "CORE_BAND_CHESHIRE_TXT_03": "Bedauernswerter Fehler",
  "CORE_CSRELEASE_CERESSA_TXT_09": "Bedingung zum Freischalten:\r\nErlebe Jeannes Heldentaten.",
  "CORE_HTDMMESS_0017_002_H17": "Die Fische hier sind echte Kawentsmänner,\r\naber total schnäubig. Wenn ich nicht gut\r\naufpasse, ende ICH noch als Köder!",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "Stürmische Wogen",
  "CORE_DIALOG_TXT_118": "Du hast das Kostüm\r\n„Verrückter Hutmacher“\r\nerhalten.",
  "CORE_SNPSS_1040": "Cereza und Cheshire begegnen\r\ndem weißen Wolf, doch dieser\r\nläuft vor ihnen davon. Sie\r\nverfolgen ihn und dringen\r\ndabei noch tiefer in den\r\nWald vor.",
  "AC_NARRATION200_0010": "Ein frischer, wohltuender Duft, der direkt\r\nvon den Bäumen stammte, umgab Cereza.",
  "CORE_HTDMMESS_0017_003_H17": "Echt lieb von dir, Hexenmädchen!\r\nNehmt euch in acht, Fische, ich kooo–\r\nSekunde mal. Wo ist meine Angel?",
  "CORE_DIALOG_TXT_156": "Falls du Probleme im Kampf hast,\r\nwäre es vielleicht eine Idee,\r\ndie Gegnerstärke oder den\r\nerlittenen Schaden anzupassen.",
  "AC_NARRATION255_0010": "Cereza und Cheshire waren auf ein Gewässer\r\ngestoßen, auf dem sich Seerosenblätter\r\nerstreckten, so weit das Auge reichte.",
  "CORE_ARCHIVE_TXT_01": "Die Charaktere dieser Geschichte.",
  "CORE_DIALOG_TXT_152": "Wähle, ob du Fessel-Kombos und „Happs!“ durch\r\nHalten und Loslassen der Angriffstaste präzise\r\nbestimmen willst oder ob Cheshire sie bei\r\nVerfügbarkeit durch einmaliges Drücken ausführt.",
  "LV_009911_0010_NAR": "Cheshire macht keine Anstalten, sich zu\r\nrühren – fast, als wolle er dir sagen:\r\n„Kümmer dich doch allein darum!“",
  "CORE_ARCHIVE_TXT_05": "Irrlichter, denen du geholfen hast.",
  "CORE_SNPSS_4060": "Cereza und Cheshire haben\r\nendlich alle vier\r\nElementarkerne zerstört.\r\nVom weißen Wolf geführt\r\nmachen sie sich auf den\r\nWeg zu Lukaon.",
  "CORE_HTDMQUEST_TXT_0028": "Schmerzen... Ich will noch\r\nmehr Schmerzen empfinden!\r\nDu da... Hilf mir dabei!",
  "CORE_WISP_TALK_38_H24": "(Cereza versucht zuzuhören,\r\nversteht aber kein einziges Wort...)",
  "CORE_HTDMMESS_0008_002_H08": "Ich bin eine Jägerin. Ich sollte\r\nPfeile verschießen, nicht Pfeile\r\nabbekommen!",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "Bedingung zum Freischalten:\r\nFinde genug Aufzeichnungen.",
  "CORE_DIALOG_TXT_114": "Du hast das Kostüm\r\n„Junge Jahre“ erhalten.",
  "CORE_WISP_TALK_45_H31": "Danke für deine Hilfe. Weißt du zufällig,\r\nob es meinen Pflanzen gut geht?",
  "CORE_HTDMMESS_0037_002_H37": "Ich arbeite viel, und der Wald von Avalon\r\nist echt gruselig. Da braucht man ab und\r\nzu was, um auf andere Gedanken zu kommen.",
  "CORE_HAIR_CERESSA_TXT_01": "Standard",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "Druck",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "Imposantes Licht",
  "CORE_WISP_TALK_52_H38": "Endlich Verstärkung... Ich bin froh, dass\r\nich so lange ausgehalten habe. Jetzt kann\r\nich mich wieder meiner Routine widmen.",
  "CORE_SNPSS_2050": "Cereza und Cheshire besiegen\r\ngemeinsam den Zirkusanführer\r\nAmadán Dubh und durchsuchen\r\ndanach sein Zelt nach einem\r\nElementarkern.",
  "TA_COM035_0020_CER": "Hä?!",
  "AC_IGNIS010_0010": "Was macht das werte Befinden?\r\nIch hatte gerade darüber nachgedacht,\r\neine Schleichpfad-Tour zu starten!",
  "CORE_POSEMENU_TXT_00": "Bewege den Cursor und triff eine Auswahl.",
  "CORE_HTDMQUEST_TXT_0037": "Etwas Abwechslung käme mir\r\ngerade recht. Vielleicht ein neuer\r\nDuft oder so was in der Art...",
  "CORE_POSEMENU_TXT_04": "Lade einen Spielstand.",
  "AC_NARRATION210_0020": "Die willkürlich wirkende Bauweise\r\ndieses Turms schien die chaotische\r\nNatur der Feen widerzuspiegeln.",
  "TEST_GIMMICK_TALK_01": "Es befindet sich eine kleine Wippe am\r\nTor, gerade groß genug für Irrlichter.",
  "CORE_WISP_TALK_41_H27": "Ich hatte eine Vision davon, wie du\r\nmich rettest. Es muss Schicksal sein,\r\ndass wir uns begegnen.",
  "TA_9012_0010_COL": "Pass gut auf da draußen!",
  "CORE_HTDMMESS_0028_003_H28": "Exzellent... Das war genau richtig!\r\nJetzt können sie mir nichts mehr anhaben.\r\nWir sehen uns dann in der Zuflucht!",
  "TA_COM035_0010_CER": "Hm?",
  "AC_CEREZA150_0010": "Stimmt nicht! Sei still!",
  "AC_CEREZA060_0040": "Nun trödel doch nicht so rum!",
  "AC_NARRATION245_0020": "Cereza erinnerte sich, einmal gehört zu\r\nhaben, dass vor langer Zeit ein Feenkönig\r\nin einem Palast gewohnt haben soll.",
  "CORE_DIALOG_TXT_103": "Möchtest du das gewählte\r\nOutfit für Cheshire verwenden?",
  "CORE_HTDMMESS_0032_003_H32": "Danke, Colm wird das lieben!\r\nUnd ich mach mich dann mal auf\r\nden Weg zur Zuflucht der Irrlichter.",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "Zuspitzung",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "Gefecht",
  "CORE_DIALOG_TXT_010": "Du kannst nicht zu diesem Ort\r\nreisen, da du dich bereits dort\r\nbefindest.",
  "CORE_DIALOG_TXT_117": "Du hast das Kostüm\r\n„Verflucher der Liebe“\r\nerhalten.",
  "CORE_DIALOG_TXT_104": "Kostüm-Menü öffnen?",
  "CORE_HAIR_CERESSA_TXT_02": "Lehrlingszöpfe",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "Ursprung",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "Errettung",
  "CORE_HTDMQUEST_TXT_0023": "Ich hab solchen Hunger!\r\nBitte... gib mir was\r\nLeckeres zu essen.",
  "AC_CEREZA055_0010": "Du bist nichts weiter als eine große Heulsuse!\r\nVerkriech dich in die Schatten und flenn wieder!",
  "CORE_POSEMENU_TXT_03": "Kehre zum Titelbildschirm zurück.",
  "TEST_WISP_TALK_11_H00": "Tut mir leid... Ich denke,\r\nich brauche noch zwei weitere\r\nFreunde, um dieses Tor zu öffnen.",
  "CORE_SNPSS_2040": "Die Irrlichter führen Cereza und\r\nCheshire zu ihrer geheimen\r\nZuflucht. Nachdem die zwei sich\r\ndort ausgeruht haben, begeben\r\nsie sich wieder in den dichten\r\nWald, um ihre Suche nach den\r\nElementarkernen fortzusetzen.",
  "CORE_SVSLT_TXT_03": "Wähle eine Datei zum Löschen.",
  "CORE_HTDMMESS_0006_003_H06": "Ja! Und so schön spitz!\r\nRichtig spitze! Daraus kann\r\nman eine prima Nadel machen!",
  "TA_COM005_0010_CER": "Hey, Cheshire.",
  "CORE_WH_TALK_15_COL": "Danke, dass ihr unsere Freunde\r\ngerettet habt! Hier habt ihr etwas\r\nals Dank von allen!",
  "CORE_HTDMMESS_0034_003_H34": "Danke. Ich gehe jetzt zur Zuflucht der\r\nIrrlichter. Wenn es mir wieder besser\r\ngeht, könnte ich etwas für dich singen!",
  "CORE_WISP_TALK_50_H36": "Diese Feen sind wirklich das\r\nLetzte! Sie hätten mich beinahe\r\neinen Kopf kürzer gemacht!",
  "CORE_HTDMQUEST_TXT_0034": "Uff... Mein Hals bringt mich noch\r\num! Du hast nicht zufällig etwas\r\nMedizin einstecken?",
  "CORE_POSEMENU_TXT_07": "Wähle einen Spielstand.",
  "AC_NARRATION220_0010": "Eine massive Feenfestung, die aus\r\nden Schatten des Waldes aufragte...",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "Bedingung zum Freischalten:\r\nErlebe Jeannes Heldentaten.",
  "CORE_WISP_TALK_60_FAS": "Schaut doch einmal bei der Zuflucht der\r\nIrrlichter vorbei. Ich bin mir sicher, sie\r\nwürden sich alle freuen, euch zu sehen.",
  "CORE_HTDMMESS_0029_001_H29": "Ich bin sooo... müde... Hab keine Lust\r\nauf nichts... Hm? Medizin könnte\r\nhelfen? Wenn's denn sein muss...",
  "AC_CEREZA060_0050": "Beherrschst nicht mal die Elemente... erbärmlich.",
  "CORE_DIALOG_TXT_113": "Du hast das Kostüm\r\n„Vorlauter Dämon“\r\nerhalten.",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "Flucht",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "Schutz",
  "CORE_HTDMMESS_0023_003_H23": "Hui, richtiges Essen! Danke schön!\r\nUm ein Haar hätte ich DICH verputzt!",
  "CORE_SNPSS_1050": "Der Junge in ihren Träumen bittet\r\nCereza, die vier Elementarkerne\r\nzu zerstören, die sich irgendwo\r\nim Wald befinden. Mit diesem\r\nneuen Ziel vor Augen brechen\r\nCereza und Cheshire wieder auf\r\nund setzen ihre Suche nach dem\r\nweißen Wolf fort.",
  "CORE_WH_TALK_06_COL": "Die anderen Irrlichter helfen auf so\r\nvielfältige Weise... Ich muss mir\r\nauch noch mehr Mühe geben.",
  "CORE_DIALOG_TXT_008": "Dieser Spielstand wird geladen.\r\nNicht gespeicherte Daten\r\ngehen dabei verloren.\r\nWillst du wirklich fortfahren?",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "Rotation (Prüf.)",
  "CORE_WISP_TALK_66_FAS": "Dein nächstes Ziel ist etwas weit\r\nentfernt. Komm, ich führe dich hin.",
  "CORE_WH_TALK_09_COL": "Zuflucht-der-Irrlichter-Regel 1:\r\nVermische nie Arbeit und Vergnügen.\r\nDas ist unsere einzige Regel!",
  "CORE_DIALOG_TXT_155": "Wenn du es dir anders überlegst,\r\nkannst du diese Einstellungen\r\njederzeit in den Optionen unter\r\n„Spielunterstützungseinst.“ ändern.",
  "CORE_ARCHIVE_TXT_02": "Die Gegner, denen Cereza begegnet.",
  "CORE_HTDMMESS_0039_003_H39": "Danke, kleine Hexe. Etwas zu essen\r\nhabe ich inzwischen auch gefunden.\r\nIch gehe dann mal zur Zuflucht zurück.",
  "AC_NARRATION230_0020": "Dieser Baum galt schon seit Generationen\r\nals Symbol der Feenkönige von Avalon.",
  "CORE_WISP_TALK_69_FAS": "Der weiße Wolf scheint nahe\r\nzu sein. Siehst du vielleicht\r\nirgendwelche Spuren?",
  "CORE_WH_TALK_13_COL": "Wir haben unseren Zufluchtsort ausgebaut.\r\nIst euch das aufgefallen? Jetzt gibt es\r\nnoch mehr Spielmöglichkeiten!",
  "CORE_SNPSS_6040": "Durch ihre Zeit in Avalon ist\r\nCereza über sich hinausgewachsen.\r\nMit den Erinnerungen an ihre\r\nneu gewonnenen Freunde im\r\nHerzen bricht sie zu einer\r\nneuen Reise auf.",
  "CORE_DIALOG_TXT_151": "Normalerweise nimmt Cheshires Magie-Anzeige\r\nab, wenn er spezielle Fähigkeiten einsetzt,\r\naber wenn du entspannter spielen willst, wähle\r\n„Immer voll“ und er hat unbegrenzte Magie.",
  "CORE_WH_TALK_23_COL": "Ihr zwei seid unsere Helden! Ihr könnt\r\nuns besuchen, wann immer ihr wollt!\r\nWir freuen uns schon darauf!",
  "CORE_WISP_TALK_59_FAS": "Übrigens, Colm möchte euch sehen.\r\nEr wollte euch irgendetwas mitteilen.",
  "CORE_WISP_TALK_47_H33": "Puh, endlich gerettet. Da sollte ich dir\r\nwohl danken. Wäre nur schön, wenn\r\ndie Feen endlich mit so was aufhörten.",
  "CORE_WISP_TALK_56_FAS": "Der nächste Kern ist also am Grunde\r\ndes Sees und um dorthin zu gelangen,\r\nmüsst ihr einen hohen Baum erklettern.",
  "CORE_HTDMMESS_0026_002_H26": "Es ist schrecklich, dass die Feen so\r\ngemein sein müssen. Wenn wir doch nur\r\nirgendwie alle miteinander auskämen..."
}
