{
  "CORE_DIALOG_TXT_112": "已获得\r\n瑟蕾莎的服装“梦游仙境的少女”！",
  "CORE_DIALOG_TXT_101": "在魔女藏身处选择“更换服装”，\r\n即可进行更换。",
  "AC_NARRATION235_0010": "飞流直下的大瀑布溅着水花\r\n流入妮姆薇湖。",
  "CORE_SNPSS_4020": "瑟蕾莎发现了被妖精们捉住的\r\n小柴猫。她不再介怀之前的争吵，\r\n和狼一起潜入要塞营救小柴猫。",
  "CORE_WISP_TALK_71_FAS": "小妹妹，你好。\r\n找到白狼的足迹了吗？",
  "CORE_ILLUSIONLIFT_NAME_TXT_23": "障壁的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_30": "怨念的妖域",
  "CORE_CSRELEASE_CHESHIRE_TXT_04": "【想要获得的话……】\r\n小柴猫学习许多技能会发生什么……？",
  "CORE_WH_TALK_11_COL": "多亏了你们，我们每天都很开心！\r\n快来和我们一起玩吧！",
  "CORE_SNPSS_6010": "瑟蕾莎和小柴猫齐心协力\r\n打倒了袭击他们的莱卡翁。\r\n莱卡翁洗心革面后，帮助两人\r\n寻找走出森林的方法。",
  "CORE_HTDMMESS_0039_001_H39": "咳咳。魔女，真不好意思，\r\n我有点不舒服……你身上有没有药？",
  "CORE_HTDMQUEST_TXT_0026": "就算在森林里也要好好打扮，\r\n我想要能衬托我气质的鲜花！",
  "AC_NARRATION260_0010": "瑟蕾莎她们救出了许许多多的人魂，\r\n成为了森林里最受欢迎的人。",
  "CORE_WH_TALK_04_COL": "呵呵，大家都陆续回来了。\r\n这都是大姐姐和猫先生的功劳。",
  "CORE_POSEMENU_TXT_06": "离开提尔纳诺。",
  "CORE_HTDMMESS_0023_001_H23": "呜呜，我饿了……\r\n我要吃的、吃的、吃的……",
  "CORE_WISP_TALK_64_FAS": "有我带路，你就放一百个心吧。\r\n我会带你去任何地方。",
  "CORE_SNPSS_3030": "激战过后，瑟蕾莎和小柴猫\r\n终于打倒了贾巴沃克，\r\n两人朝核心所在的神祠走去，\r\n白狼也走在前面领路。",
  "CORE_SVSLT_TXT_02": "请选择要读取的页面。",
  "AC_CEREZA040_0010": "所有人都讨厌你，\r\n你是不可能成为优秀魔女的！",
  "CORE_SNPSS_1000": "瑟蕾莎在不可思议的空间中\r\n战战兢兢地前进着。\r\n她似乎有不得不赶路的理由……",
  "CORE_HTDMMESS_0013_002_H13": "呵呵……我听到了，我听到了低语声……\r\n我很快也能提升到那个次元了……",
  "CORE_WISP_TALK_28_H14": "太好啦，这样我就自由了！\r\n好，我该回去做好吃的饭菜了！",
  "CORE_HTDMMESS_0021_002_H21": "只要把饰品装点在帽子上……嗯哼。\r\n我就一定可以变成大红人！",
  "CORE_POSEMENU_TXT_02": "可查看玩法说明。",
  "CORE_POSEMENU_TXT_11": "可从中途开始继续游玩故事。",
  "CORE_WISP_TALK_17_H03": "是你救了我吗……谢谢你。\r\n好！跟我来，我会帮你开门的！",
  "TA_9011_0010_COL": "大姐姐，你要当心啊。",
  "CORE_DIALOG_TXT_005": "将删除保存于该位置的故事记录。\r\n是否确定？",
  "CORE_DIALOG_TXT_116": "已获得\r\n瑟蕾莎的服装“统治者·夏娃·原型”、\r\n瑟蕾莎的服装“贞德”、\r\n小柴猫的服装“查尔斯”！",
  "CORE_DIALOG_TXT_105": "是否离开更衣室？",
  "CORE_HAIR_CERESSA_TXT_03": "决心的证明",
  "CORE_ILLUSIONLIFT_NAME_TXT_27": "诅咒的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_34": "瞑目的妖域",
  "CORE_WH_TALK_21_COL": "要是你找到了我们的伙伴，就告诉他们这个地方吧。\r\n大家现在一定都在受苦……",
  "CORE_WISP_TALK_21_H07": "哇哈，我能动啦！\r\n谢谢大姐姐！哇哈哈哈哈！",
  "TEST_WISP_TALK_13_H00": "哆哆嗦嗦！有种不祥的预感……\r\n我们可以在这里等吗……？",
  "CORE_HTDMMESS_0004_002_H04": "唉，应该没事吧，妖精不会来这边吧。\r\n拜托你了，帮我找点能藏身的东西！",
  "CORE_DIALOG_TXT_150": "请设置瑟蕾莎与小柴猫受到的伤害量。\r\n若设置为“较少”，将减少受到的伤害；\r\n若设置为“不受伤害”，则免受任何伤害。",
  "TA_COM030_0010_CER": "讨厌！",
  "CORE_HTDMQUEST_TXT_0039": "我的身体不太舒服，\r\n你能分我点药吗？",
  "CORE_WH_TALK_18_COL": "啊！大姐姐、猫先生！\r\n谢谢你们救了大家！",
  "TA_COM030_0020_CER": "喂！",
  "CORE_DIALOG_TXT_154": "今后发动魔女脉冲时将面对更难的情况。\r\n若有担忧，可设置为自动发动魔女脉冲。\r\n若选择“托管”，即使不推动[BTN:LS ]，\r\n瑟蕾莎也将成功发动魔女脉冲。",
  "CORE_WISP_TALK_25_H11": "谢谢你救了我！\r\n大姐姐，我们一起逃走吧……！",
  "CORE_ARCHIVE_TXT_03": "在森林中捡到的笔记，不知道主人是谁。",
  "AC_CEREZA130_0010": "才、才不会呢！",
  "CORE_WH_TALK_02_COL": "你要是救了人魂，就告诉他们怎么来这个地方吧。\r\n因为有的人可能不认识路……",
  "CORE_WISP_TALK_32_H18": "噗哈！谢谢你救了我！\r\n我绝对饶不了那些可恶的妖精……！",
  "CORE_HTDMMESS_0029_003_H29": "这就是药吗……唔……你都帮我到这份上了……\r\n要不我也稍微……试着加把劲吧……",
  "AC_NARRATION225_0020": "前面究竟还会有什么状况\r\n等待着两人呢……？",
  "CORE_HTDMMESS_0034_001_H34": "唔，嗓子不能正常发声了……\r\n魔女，你有没有药啊？",
  "CORE_ILLUSIONLIFT_NAME_TXT_38": "战祸的考验",
  "CORE_WH_TALK_17_COL": "请你们收下这个吧！\r\n这是我准备的礼物……希望能派上用场。",
  "CORE_HTDMMESS_0006_001_H06": "哎，你有没有能替代针的东西啊？\r\n我想要一个比较顺手的物件……",
  "CORE_SNPSS_2010": "人魂柯尔姆因为\r\n伙伴被妖精抓走而悲伤不已。\r\n瑟蕾莎和小柴猫一边斗嘴，\r\n一边前去营救柯尔姆的伙伴。",
  "CORE_DIALOG_TXT_009": "是否移动至该地点？",
  "CORE_SNPSS_0020": "瑟蕾莎听信了梦中男孩的话，\r\n她违背了老师摩根娜的警告，\r\n进入了森林。\r\n她小心翼翼地在森林中前进。",
  "CORE_WISP_TALK_30_H16": "谢谢你救了我。\r\n我听说塔里还关着许多伙伴……",
  "AC_CEREZA035_0010": "赶紧放弃吧。\r\n你不一直都是这样的吗！？",
  "TA_COM000_0010_CER": "哎呀？",
  "CORE_HTDMQUEST_TXT_0029": "嗯……做什么都提不起劲……\r\n就连活着也……好麻烦……",
  "CORE_WISP_TALK_15_H01": "嗯……谢谢你救了我……\r\n我想去……能晒太阳的地方……",
  "CORE_DIALOG_TXT_153": "请设置敌人强度。\r\n若设置为“较弱”，\r\n将改变敌人的行动模式；\r\n若设置为“最弱”，\r\n还将改变敌人的组合模式。",
  "CORE_DIALOG_TXT_140": "是否确认冒险的智慧，\r\n复习至今为止的玩法说明？\r\n※可随时在系统中确认冒险的智慧。\r\n",
  "CORE_SNPSS_5010": "瑟蕾莎成功安抚住了\r\n受普卡操纵而失控的小柴猫。\r\n两人加深了彼此的友谊，\r\n加速赶往莱卡翁所在的地方。",
  "CORE_ARCHIVE_TXT_04": "在森林中留下的回忆。",
  "CORE_HTDMMESS_0032_001_H32": "柯尔姆平时总是那么辛劳，我想送他点东西表示感谢。\r\n魔女，不好意思，能不能麻烦你帮帮忙？",
  "TA_COM000_0020_CER": "这是……？",
  "AC_NARRATION240_0010": "清澈的水流不住地涌出。\r\n这是阿瓦隆森林的生命之源。",
  "CORE_WISP_TALK_23_H09": "哎呀，是你救了我吗，你真是个大善人。\r\n你会救我一定是因为我的美貌吧……呵呵。",
  "AC_NARRATION215_0010": "人魂们的秘密基地\r\n静静地伫立在森林里。",
  "CORE_ILLUSIONLIFT_NAME_TXT_28": "生死的妖域",
  "CORE_HTDMMESS_0028_001_H28": "只要感受到了疼痛、知晓疼痛，就不会害怕妖精了。\r\n小姑娘，弄疼我吧……",
  "CORE_DIALOG_TXT_119": "已获得\r\n小柴猫的服装“狂暴魔女”！",
  "CORE_WISP_TALK_14_02_H16": "塔里好像到处都是妖精……\r\n希望大家平安……",
  "CORE_HTDMMESS_0017_001_H17": "我要钓到大鱼！钓到许多大鱼！\r\n这位魔女先别急着走，能给我点鱼饵吗！",
  "AC_NARRATION250_0020": "妖精的心里说不定也尚存善念……\r\n瑟蕾莎脑海里突然闪过了这样的想法。",
  "CORE_DIALOG_TXT_011": "当前无法移动至该地点。",
  "AC_CEREZA145_0010": "别说了……我不想听！",
  "CORE_DIALOG_TXT_002": "该页面已存在故事记录。\r\n是否覆盖故事记录？",
  "CORE_HAIR_CERESSA_TXT_04": "踏上旅程的魔女",
  "CORE_DIALOG_TXT_111": "已获得\r\n瑟蕾莎的服装“美丽主演”！",
  "CORE_DIALOG_TXT_102": "是否更换瑟蕾莎的服装？",
  "CORE_WISP_TALK_62_COL": "大家没事就好……\r\n大姐姐，太谢谢你了！",
  "CORE_SNPSS_4030": "瑟蕾莎救出了受伤的小柴猫，\r\n两人平安会合。\r\n他们为了寻找消失的狼，\r\n一起向要塞深处跑去。",
  "CORE_ILLUSIONLIFT_NAME_TXT_20": "突破的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_33": "枷锁的妖域",
  "CORE_POSEMENU_TXT_05": "从提尔纳诺内的检查点重新开始。",
  "CORE_SNPSS_1010": "与母亲罗莎分离，让瑟蕾莎的心灵\r\n蒙上了阴影。为了成为强大的魔女，\r\n她拜魔女摩根娜为师，\r\n每天辛勤修炼。",
  "CORE_HTDMQUEST_TXT_0032": "我想送点东西慰劳疲惫的朋友。\r\n你能帮帮我吗？",
  "CORE_HTDMQUEST_TXT_0021": "我想变得更引人注目，\r\n请你帮我找到华丽的饰品！",
  "CORE_POSEMENU_TXT_01": "可进行各种设置。",
  "AC_IGNIS005_0010": "你好，找我有事吗？\r\n想知道秘密通道就尽管问我吧！",
  "CORE_SNPSS_3020": "两人成功赶走了怪物，\r\n其中也有瑟蕾莎的功劳。\r\n她稍微有了些信心，\r\n再次踏上寻找核心的旅途。",
  "CORE_SVSLT_TXT_01": "请选择记录页面。",
  "CORE_DIALOG_TXT_115": "已获得\r\n瑟蕾莎的服装“觉醒的黑暗之眼”、\r\n瑟蕾莎的服装“时空旅行者”！",
  "CORE_ILLUSIONLIFT_NAME_TXT_24": "刹那的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_37": "冰雨的妖域",
  "CORE_HTDMMESS_0015_002_H15": "唔，我得记下来……\r\n这种植物的生态是……",
  "CORE_CSRELEASE_CHESHIRE_TXT_03": "【想要获得的话……】\r\n获得提尔纳诺中的所有宝箱会发生什么……？",
  "CORE_DIALOG_TXT_006": "真的不后悔吗？\r\n删除后记录将无法复原。\r\n是否确定？",
  "CORE_MISSION_TEXT_0007": "跨越各种各样的障碍\r\n攻略提尔纳诺！",
  "CORE_COSTUME_CHESHIRE_TXT_03": "只要戴上帽子就会感到幸福。\r\n就算被别人骂成怪物百般嫌弃，\r\n平凡的一天也都是快乐的派对。",
  "CORE_DIALOG_TXT_160": "是否在此次故事中，\r\n将玩法说明设置为显示？\r\n※可随时在设置的“基础”中更改是否显示。",
  "AC_CEREZA060_0030": "要去的不是那边啦。",
  "CORE_HTDMMESS_0008_001_H08": "我想拥有力量，想要不输于妖精的力量……\r\n你是魔女吧？那你应该……有主意吧？",
  "CORE_ILLUSIONLIFT_NAME_TXT_51": "怨念的考验",
  "CORE_ILLUSIONLIFT_NAME_TXT_42": "失控的考验",
  "CORE_CSRELEASE_CERESSA_TXT_04": "【想要获得的话……】\r\n瑟蕾莎学习许多技能会发生什么……？",
  "TEST_WISP_TALK_10": "呜呜……能逃到这儿来算我走运，\r\n可我恐高啊……",
  "TEST_WISP_TALK_03": "谢谢大姐姐！\r\n跟我来！我会帮你把门打开的！",
  "CORE_HTDMMESS_0015_003_H15": "哇，这不是曼陀罗吗！而且还长得这么茁壮！\r\n我要赶紧回去开始研究！再见啦！",
  "AC_CEREZA050_0010": "凭你自己就什么也做不到。\r\n反正你肯定在指望别人来帮忙对吧！？",
  "CORE_WISP_TALK_44_H30": "我居然会被抓，真是失策！小姑娘，谢谢你！\r\n这样我就又可以保护大家了！",
  "CORE_TITLE_TEXT_00": "[BTN:L2 ] + [BTN:R2 ]",
  "CORE_SNPSS_0010": "与母亲罗莎分离一事让瑟蕾莎的\r\n心灵蒙上了阴影。\r\n为了成为强大的魔女，她拜魔女\r\n摩根娜为师，每天都在辛勤修炼。",
  "CORE_ILLUSIONLIFT_NAME_TXT_08": "报复的妖域",
  "CORE_SNPSS_2020": "瑟蕾莎和小柴猫会合后，\r\n找到了折磨人魂的妖精乐园之塔，\r\n他们决定潜入塔内。",
  "CORE_NPC_TXT_11": "可调制可用道具。",
  "TEST_WISP_TALK_07": "再往前走可要当心啊！\r\n前面有个超级恐怖的马戏团！",
  "CORE_ILLUSIONLIFT_NAME_TXT_55": "妖光的考验",
  "AC_NARRATION225_0010": "瑟蕾莎她们破坏了所有元素核心，\r\n解开了大规模的结界。",
  "CORE_ILLUSIONLIFT_NAME_TXT_46": "跺地的考验",
  "CORE_MISSION_TEXT_0003": "敌人的所有攻击都会造成致命伤害！\r\n躲避所有攻击并将敌人全部消灭！",
  "CORE_WISP_TALK_34_H20": "呜啊，身上好疼……\r\n魔女，谢谢你救了我！",
  "CORE_WISP_TALK_54_H40": "过了那么久，我终于又回来了。\r\n我要……走上新的人生之路……",
  "CORE_DIALOG_TXT_090": "可记录已读完的故事。\r\n读取已读完的故事记录，\r\n即可继承当前状态，\r\n继续体验故事。",
  "CORE_CSRELEASE_CERESSA_TXT_08": "【想要获得的话……】\r\n目睹贞德的英姿会发生什么……？",
  "CORE_WISP_TALK_14_H16": "好像只要拉下操纵杆就能进到塔里了！\r\n拜托你救救大家吧……！",
  "CORE_BAND_CHESHIRE_TXT_02": "坚毅的铁腕",
  "AC_NARRATION260_0020": "森林里的人们谁也不会忘记……\r\n结下深厚友谊的善良魔女与恶魔的事迹。",
  "CORE_COSTUME_CERESSA_TXT_07": "坚强善良的魔女，会拯救朋友于水火。\r\n我将来会成为这样的人，\r\n我一定能掌握自己的未来。",
  "CORE_DIALOG_TXT_031": "是否离开提尔纳诺？",
  "TA_COM025_0020_CER": "好！",
  "CORE_WISP_TALK_14_03_H16": "听说你救了我们的伙伴！\r\n我也得告诉其他人魂才行……！",
  "CORE_SNPSS_6020": "普卡召唤出了一大群妖精。\r\n小柴猫让瑟蕾莎骑在它的背上，\r\n朝着摩根娜放出的光柱奔去。",
  "AC_NARRATION235_0020": "响彻体内的轰鸣声\r\n让瑟蕾莎不由自主地屏住了呼吸。",
  "CORE_WISP_TALK_49_H35": "好像是你救了我吧，谢谢你哦。\r\n我要快点回去试试刚想到的新点子。",
  "CORE_SNPSS_4010": "瑟蕾莎和小柴猫因为妖精操纵的\r\n母亲幻象而大吵一架。\r\n瑟蕾莎离开小柴猫，\r\n独自朝要塞走去。",
  "CORE_ILLUSIONLIFT_NAME_TXT_13": "奋战的妖域",
  "TA_COM025_0010_CER": "呼……",
  "CORE_ILLUSIONLIFT_NAME_TXT_17": "滑行的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_04": "制约的妖域",
  "CORE_RETRY_TXT_01": "是否使用道具解锁计时模式？",
  "AC_CEREZA015_0020": "放心吧，我会救你的。",
  "CORE_COSTUME_CERESSA_TXT_03": "踏上奇境之旅的少女决定，\r\n等回来之后要把这趟旅程写成书……\r\n前提是能回得来。",
  "CORE_SNPSS_1030": "瑟蕾莎遇见了恶魔小柴猫。\r\n为了送小柴猫返回魔界，\r\n她需要寻找\r\n知晓力量之源位置的白狼。",
  "CORE_HTDMMESS_0037_001_H37": "我虽然很喜欢这里安静的氛围，\r\n但也想换换心情。有什么有意思的东西吗？",
  "CORE_WISP_TALK_39_H25": "好冷好冷好冷好冷啊！差点冻死了！\r\n谢谢你！我要向妖精报仇……！",
  "CORE_HTDMQUEST_TXT_0006": "我想要用来缝纫的针。\r\n你知道哪里有吗？",
  "CORE_HTDMQUEST_TXT_0015": "我想调查珍稀植物。\r\n不好意思，麻烦你帮帮我吧！",
  "CORE_BAND_CHESHIRE_TXT_01": "默认",
  "CORE_MISSION_TEXT_0008": "打败拦路的妖精！",
  "CORE_HTDMMESS_0029_002_H29": "自从被妖精抓住虐待之后……\r\n我就……失去了干劲……",
  "CORE_WH_TALK_03_COL": "妖精……\r\n它们为什么那么残忍呢……",
  "CORE_WH_TALK_19_COL": "大家都想向你们道谢呢！\r\n大家快来呀～！",
  "CORE_WISP_TALK_63_FAS": "小妹妹、小妹妹，\r\n要是迷路了就来找我吧。",
  "CORE_NPC_TXT_09": "可重新挑战提尔纳诺或进行计时模式。",
  "CORE_DIALOG_TXT_121": "已获得\r\n瑟蕾莎的服装“时空旅行者”！",
  "CORE_ILLUSIONLIFT_NAME_TXT_10": "幻术的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_03": "战祸的妖域",
  "CORE_WH_TALK_16_COL": "大姐姐、猫先生，谢谢你们！\r\n请收下这份谢礼！",
  "CORE_COSTUME_CERESSA_TXT_04": "快送我回魔界！\r\n不然我就吃了你！\r\n呵呵……是不是学得很像？",
  "CORE_DIALOG_TXT_021": "是否开始调制？",
  "CORE_DIALOG_TXT_032": "是否重新进入计时模式？\r\n（当前记录将消失。）",
  "CORE_SNPSS_6030": "摩根娜露出真面目，\r\n为了用小柴猫的灵魂作为祭品\r\n而向两人发动攻击。\r\n瑟蕾莎下定决心与她一战。",
  "CORE_WISP_TALK_36_H22": "哎呀，我能动了……？\r\n哦，是你救了我吧，谢谢你。",
  "AC_NARRATION250_0010": "波浪舒缓地拍打在色彩鲜明的岸上，\r\n这里的气氛与阴森的森林截然不同。",
  "TEST_WISP_TALK_12_H00": "唔，还差一点！只要再找一个人，\r\n就能打开这扇门了……",
  "CORE_HTDMMESS_0004_003_H04": "得救了……什么，你知道怎么去秘密基地吗！？\r\n太好了！藏在那里肯定比藏在这儿更安全！",
  "CORE_ILLUSIONLIFT_NAME_TXT_14": "致命的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_07": "刚枪的妖域",
  "TA_COM015_0010_CER": "我知道了！",
  "CORE_RETRY_TXT_02": "是否重新挑战该提尔纳诺？",
  "TEST_WISP_TALK_08": "万一被马戏团团长发现了就……呜呜。\r\n大姐姐，你一定要当心啊……",
  "CORE_SNPSS_3010": "两人被可怕的怪物袭击，\r\n连小柴猫的爪子攻击也不起作用。\r\n惴惴不安的瑟蕾莎\r\n悄无声息地在森林里前进。",
  "CORE_ILLUSIONLIFT_NAME_TXT_49": "碎骨的考验",
  "CORE_SNPSS_1020": "瑟蕾莎听信了梦中男孩的话，\r\n她违背了老师摩根娜的警告，\r\n进入了森林。\r\n她小心翼翼地在森林中前进。",
  "CORE_HTDMMESS_0013_003_H13": "呵呵……好开心，你居然真的给我带来了。\r\n大姐姐，谢谢你愿意帮我。",
  "CORE_HTDMMESS_0026_001_H26": "无论境遇如何，心中都要怀有对美的追求。\r\n那边那位魔女，你能给我找来能衬托我气质的鲜花吗？",
  "CORE_DIALOG_TXT_170": "在贞德外传中，\r\n每当进入故事节点，\r\n将自动记录故事。\r\n请注意，将无法手动记录。",
  "AC_CEREZA060_0020": "你真笨。还好意思笑别人呢。",
  "CORE_ILLUSIONLIFT_NAME_TXT_52": "守护的考验",
  "CORE_ILLUSIONLIFT_NAME_TXT_41": "刚枪的考验",
  "CORE_CSRELEASE_CERESSA_TXT_07": "【想要获得的话……】\r\n读完禁忌传说会发生什么……？",
  "CORE_HTDMMESS_0021_003_H21": "多么优秀！多么美丽！多么优雅！\r\n谢谢你！我要向秘密基地的伙伴好好显摆显摆！！",
  "CORE_NPC_TXT_05": "可记录冒险进度。",
  "CORE_MISSION_TEXT_0004": "打倒敌人后会在地面上留下诅咒！\r\n打倒敌人的同时注意避开！",
  "CORE_WH_TALK_20_COL": "森林里应该还有我们的伙伴……\r\n拜托你救救大家……！",
  "CORE_COSTUME_CERESSA_TXT_08": "只要战胜强敌，找到真正的自我，\r\n就一定可以和我的王子成为灵魂伴侣。\r\n心怀这样虚幻的梦想，明天继续踏上旅途。",
  "AC_IGNIS015_0010": "在森林里的冒险还顺利吗？\r\n你也要善加利用秘密通道哦。",
  "AC_NARRATION215_0020": "在瑟蕾莎一行的努力之下，\r\n这里恢复了以往的欢声笑语。",
  "CORE_ILLUSIONLIFT_NAME_TXT_18": "跺地的妖域",
  "CORE_WH_TALK_10_COL": "大姐姐、猫先生，欢迎你们！\r\n大家都很想见你们哦！",
  "CORE_ARCHIVE_TXT_99": "本项目尚未解锁。",
  "CORE_SNPSS_2030": "瑟蕾莎和小柴猫救出了\r\n柯尔姆被妖精抓走的伙伴。\r\n沉浸在重逢喜悦中的人魂们\r\n催促瑟蕾莎和小柴猫跟上他们。",
  "CORE_WISP_TALK_70_FAS": "迷了路就该去找白狼的足迹。\r\n它也是优秀的引路人……呵呵。",
  "CORE_WISP_TALK_65_FAS": "找到白狼的足迹了吗？\r\n要不我带你到足迹附近去？",
  "AC_CEREZA155_0010": "不……别说了！",
  "CORE_COSTUME_CHESHIRE_TXT_04": "我绝对会成为强大的魔女！\r\n绝对会救出妈妈！\r\n哼……那家伙总是这个样子。",
  "AC_NARRATION240_0020": "瑟蕾莎和小柴猫在这里喝了个够，\r\n重获新生。",
  "TEST_WISP_TALK_04": "我盼得脖子都长了！\r\n要当心妖精们哦！",
  "CORE_CSRELEASE_CERESSA_TXT_03": "【想要获得的话……】\r\n在计时模式中取得优异成绩会发生什么……？",
  "CORE_ILLUSIONLIFT_NAME_TXT_45": "滑行的考验",
  "CORE_WH_TALK_05_COL": "大家最近都在放哨，\r\n毕竟要是让妖精找到了这里就糟了！",
  "CORE_WH_TALK_22_COL": "不好意思总是麻烦你们……\r\n今后也请多多关照我们的伙伴。",
  "CORE_BAND_CHESHIRE_TXT_04": "情谊的绷带",
  "CORE_WISP_TALK_58_FAS": "你要当心妖精们啊。\r\n那些家伙是不懂手下留情的。",
  "AC_IGNIS200_0010_0020": "欢迎来到秘密通道！",
  "TEST_WISP_TALK_09": "我是特意藏在这儿的。\r\n你不要告诉别人哦！",
  "CORE_ILLUSIONLIFT_NAME_TXT_48": "逃避的考验",
  "AC_CEREZA030_0010": "你这种胆小鬼肯定会失败的啦！",
  "CORE_SNPSS_2060": "瑟蕾莎和小柴猫\r\n破坏了第2个元素核心，\r\n他们运用着全新的力量，\r\n寻找起了狼的痕迹。",
  "CORE_HTDMMESS_0021_001_H21": "我不想默默无闻地生活！\r\n我想打扮得漂漂亮亮，比妖精们还光彩夺目！",
  "CORE_WISP_TALK_57_FAS": "先是高处再是水边……\r\n对你来说真是连环考验啊，哈哈。",
  "CORE_ILLUSIONLIFT_NAME_TXT_15": "束缚的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_06": "追踪的妖域",
  "CORE_HTDMMESS_0013_001_H13": "呵呵……大姐姐，帮我个忙吧……\r\n我想要能让我变得很厉害的仪式道具……",
  "CORE_HTDMMESS_0026_003_H26": "谢谢你，可爱的魔女！\r\n这样我今天也可以保持好心情了！呵呵！",
  "CORE_COSTUME_CERESSA_TXT_01": "一名少女，是稚嫩的见习魔女。\r\n为了得到拯救母亲的力量进入阿瓦隆森林，\r\n遇见了她注定要遇上的迷途恶魔。",
  "CORE_SNPSS_6035": "被命运玩弄于股掌的摩根娜与莱卡翁。\r\n瑟蕾莎目睹了他们的结局，\r\n告别了小柴猫后……",
  "CORE_COSTUME_CERESSA_TXT_05": "瑟蕾莎的日常装扮。\r\n寻母之旅的经验已经\r\n深深印在了她的心中。",
  "CORE_DIALOG_TXT_033": "是否重新进入提尔纳诺？",
  "CORE_WISP_TALK_67_FAS": "白狼所在的位置……有些远啊。\r\n好，交给我这个林中引路人吧！",
  "AC_NARRATION245_0010": "一座豪华的宫殿静静地立在那儿，\r\n好像被遗忘在了时间的长河中。",
  "CORE_WH_TALK_07_COL": "秘密基地变得很热闹了吧！\r\n希望大家能在这里安心生活。",
  "CORE_DIALOG_TXT_120": "已获得\r\n瑟蕾莎的服装“觉醒的黑暗之眼”！",
  "CORE_HTDMMESS_0023_002_H23": "我饿……我饿……\r\n我要……吃的……呜呜……",
  "CORE_ILLUSIONLIFT_NAME_TXT_11": "失控的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_02": "荆牢的妖域",
  "CORE_HTDMMESS_0039_002_H39": "咳咳……呜呜，我本来以为……\r\n变成人魂之后连病都能治好呢……咳咳。",
  "CORE_WISP_TALK_68_FAS": "在这座森林里是很容易迷路的。\r\n我来带你去白狼身边吧？",
  "CORE_WH_TALK_12_COL": "我决定锻炼自己的体魄，\r\n再也不让任何人被妖精抓走……！",
  "CORE_WISP_TALK_24_H10": "谢谢你……可以叫你大姐姐吗？\r\n大姐姐，我会跟着你的。",
  "CORE_WH_TALK_08_COL": "听我说听我说，我组建了秘密基地防卫队！\r\n不过大概还是敌不过妖精啦……",
  "CORE_WISP_TALK_33_H19": "从我被抓后已经过了34506250秒……\r\n非常感谢你让我重获自由。",
  "AC_NARRATION210_0010": "非常巨大的妖精之塔，\r\n有奇妙的交通工具在上面行驶。",
  "AC_NARRATION255_0020": "要历经多少岁月才能发展得如此壮大啊，\r\n森林的生态系统让人不禁发出了感慨。",
  "TEST_WISP_TALK_05": "我真是太弱了……\r\n甚至不敢去挑战妖精……",
  "CORE_CSRELEASE_CERESSA_TXT_02": "【想要获得的话……】\r\n救助许多人魂会发生什么……？",
  "CORE_ILLUSIONLIFT_NAME_TXT_44": "死战的考验",
  "CORE_HTDMMESS_0006_002_H06": "唔，这些针都不顺手，真头疼。\r\n这样我都没法工作了……",
  "CORE_MISSION_TEXT_0001": "只有拘束住敌人才能造成伤害！\r\n使用荆棘束缚战斗吧！",
  "CORE_HTDMMESS_0034_002_H34": "我算是个放哨的……\r\n要是嗓子不好，就不能在紧要关头大声警示了……",
  "CORE_WH_TALK_14_COL": "呵呵，秘密基地变得更宽敞啦！\r\n你们也多去玩玩吧！",
  "CORE_COSTUME_CHESHIRE_TXT_05": "高级人偶店皮格马利翁的热卖商品，\r\n质感光滑亲肤，附身体验极佳，\r\n※将变为贞德＆查尔斯的操作模式。",
  "CORE_COSTUME_TXT_01": "请选择想要换上的服装。",
  "CORE_SNPSS_1070": "瑟蕾莎和小柴猫破坏了\r\n第1个元素核心。\r\n两人为了破坏剩下的3个核心，\r\n继续向森林深处走去。",
  "TA_COM020_0010_CER": "唉……",
  "CORE_WH_TALK_01_COL": "啊，大姐姐。\r\n你有没有……看到其他伙伴们？",
  "AC_NARRATION200_0020": "从内部吹来的风\r\n带来了神奇的力量。",
  "CORE_ILLUSIONLIFT_NAME_TXT_19": "暗影的妖域",
  "CORE_SNPSS_3040": "瑟蕾莎和小柴猫\r\n破坏了第3个元素核心。\r\n两人借助着新获得的水之力，\r\n前往最后一个核心的所在地。",
  "CORE_WISP_TALK_61_FAS": "我帮柯尔姆传个话，\r\n他希望你能去看看他们。",
  "CORE_EVENT_PAUSE_TXT_01": "点击[BTN:START ]继续阅读。",
  "CORE_WISP_TALK_16_H02": "谢谢你，我会记住你的大恩大德。\r\n我该回基地修订被妖精抓到时的规矩了……",
  "TA_COM020_0020_CER": "唉。",
  "AC_IGNIS200_0000_0010": "别跟丢了！",
  "CORE_COSTUME_CERESSA_TXT_09": "学习正统暗影魔导术的见习魔女。\r\n与瑟蕾莎互相认可，是一位好对手。\r\n※将变为贞德＆查尔斯的操作模式。",
  "CORE_HTDMMESS_0004_001_H04": "这里到处都是可怕的东西。我得把自己藏起来……\r\n对了，伪装成植物就好了……！你过来帮帮忙！",
  "CORE_MISSION_TEXT_0005": "敌人张开了屏障！\r\n灵活选择变身类型去战斗吧！",
  "CORE_COSTUME_CHESHIRE_TXT_01": "脾气暴躁的迷途恶魔。\r\n困在小小的玩偶体内也毫不在意，\r\n今天也在用自豪的爪子大战妖精。",
  "TEST_WISP_TALK_55_COL": "妖精的塔里还有我的伙伴……\r\n大姐姐，请你救救他们……！",
  "CORE_ILLUSIONLIFT_NAME_TXT_53": "混战的考验",
  "CORE_ILLUSIONLIFT_NAME_TXT_40": "追踪的考验",
  "TEST_WISP_TALK_01": "谢谢大姐姐！",
  "CORE_SNPSS_4050": "两人破坏了最后的核心\r\n得到火之力。\r\n随后，他们试用新的力量，\r\n离开了神祠。",
  "CORE_MISSION_TEXT_0002": "在限制时间内打倒所有敌人！\r\n打倒敌人可以延长时间限制！",
  "CORE_WISP_TALK_19_H05": "哎呀，身体变得轻快了！\r\n谢谢你，小猫咪，后会有期！",
  "AC_NARRATION230_0010": "近乎透明的纯白大树\r\n高得一眼望不到树顶。",
  "CORE_DIALOG_TXT_091": "恭喜你读完了整个故事！\r\n・可选择故事难度了。\r\n・可游玩贞德外传了。\r\n・可在魔女藏身处“更换服装”了。",
  "CORE_HTDMMESS_0028_002_H28": "我先说清楚……你可别误会了。\r\n我能正常地感知疼痛，并不喜欢疼痛的感觉。",
  "CORE_NPC_TXT_10": "可更换为其他已有的服装。",
  "TEST_WISP_TALK_06": "被妖精抓住的伙伴……\r\n谁也没能回来……",
  "CORE_ILLUSIONLIFT_NAME_TXT_54": "枷锁的考验",
  "CORE_ILLUSIONLIFT_NAME_TXT_47": "突破的考验",
  "CORE_ILLUSIONLIFT_NAME_TXT_09": "小丑的妖域",
  "CORE_SNPSS_3050": "两人得知最后的元素核心\r\n在妖精们的要塞里。\r\n瑟蕾莎下定决心，哪怕是为了\r\n莱卡翁也要潜入要塞。",
  "CORE_SNPSS_1060": "瑟蕾莎借助魔法与摩根娜交谈，\r\n得知当下很难马上离开森林，\r\n于是决定继续追赶白狼。",
  "CORE_WISP_TALK_26_H12": "呜呜，我得救了……？\r\n好可怕……但我也会加把劲的……",
  "CORE_HTDMMESS_0032_002_H32": "我本来在到处物色慰问品，结果不知不觉\r\n走到这种地方来了，我自己也犯愁呢。",
  "TA_COM010_0010_CER": "唔——",
  "AC_CEREZA045_0010": "你又要逃了吧？\r\n我早就猜到了！",
  "CORE_HTDMMESS_0037_003_H37": "谢谢你……呜，气味好冲啊……\r\n万一被妖精发现就糟了，还是先回去一趟吧……",
  "TA_COM010_0020_CER": "嗯……",
  "CORE_ILLUSIONLIFT_NAME_TXT_50": "生死的考验",
  "CORE_ILLUSIONLIFT_NAME_TXT_43": "搬运的考验",
  "CORE_CSRELEASE_CERESSA_TXT_05": "【想要获得的话……】\r\n收集许多回忆书签会发生什么……？",
  "TEST_WISP_TALK_02": "跟我来！\r\n我会帮你打开门的！",
  "CORE_SNPSS_4040": "瑟蕾莎和小柴猫打倒了\r\n自称妖精王的普卡和他召唤出的\r\n幻象亲和。为了破坏核心，\r\n两人继续往要塞内部走去。",
  "CORE_MISSION_TEXT_0006": "评价会随着时间改变！\r\n尽快攻略目标吧！",
  "CORE_COSTUME_CHESHIRE_TXT_02": "恶魔诅咒了美丽的公主，\r\n肆意玩弄纯洁的爱情……\r\n小柴猫也会觉得这种服装很奇怪吧？",
  "CORE_HTDMQUEST_TXT_0008": "我想变强。\r\n你是魔女，应该有办法吧？",
  "CORE_SNPSS_2070": "据说第3个核心在湖底沉眠。\r\n为了吸干湖水，瑟蕾莎和小柴猫\r\n要爬上森林里最高的巨树树顶。",
  "CORE_HTDMMESS_0015_001_H15": "哎呀，这座森林里有好多有趣的东西！\r\n我说你啊，身上有带着什么珍稀植物吗？",
  "CORE_HTDMQUEST_TXT_0013": "我想提升自己的次元，\r\n你能借我仪式道具吗？",
  "CORE_COSTUME_CERESSA_TXT_02": "幼小可爱的芭蕾舞演员，\r\n扮演被诅咒变成天鹅的公主。\r\n为了变成闪耀在最顶端的那颗星而演绎剧目。",
  "AC_IGNIS020_0010": "阿瓦隆森林里危机四伏。\r\n秘密通道一定可以帮到你的。",
  "CORE_HTDMMESS_0008_003_H08": "这就是变强的道具吗？呕……太难闻了！\r\n等我回到秘密基地就试试看……谢谢你！",
  "CORE_ILLUSIONLIFT_NAME_TXT_16": "死战的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_05": "轮转的妖域",
  "CORE_DIALOG_TXT_130": "继续前进将进入故事的结局，\r\n你做好准备了吗？",
  "CORE_ILLUSIONLIFT_NAME_TXT_12": "引导的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_01": "妖光的妖域",
  "AC_CEREZA135_0010": "我……我……！",
  "AC_NARRATION220_0020": "上面有一条险恶异常的裂缝。\r\n妖精们究竟在密谋什么？",
  "CORE_COSTUME_CERESSA_TXT_06": "时隔500年终于苏醒的睡美人\r\n寻回了记忆直面命运。\r\n这件神秘服装能让人联想到如此情境。",
  "CORE_DIALOG_TXT_030": "是否重置当前所在的楼层？\r\n不会重置已获得的宝箱。",
  "CORE_HTDMQUEST_TXT_0004": "我不想再遇到可怕的事了。\r\n我得想办法躲起来活下去……",
  "CORE_HTDMQUEST_TXT_0017": "要想钓到大鱼，就需要优质鱼饵！\r\n拜托你帮我弄点最高档的来！",
  "CORE_BAND_CHESHIRE_TXT_03": "疏忽的伤痕",
  "CORE_CSRELEASE_CERESSA_TXT_09": "【想要获得的话……】\r\n目睹贞德的英姿会发生什么……？",
  "CORE_HTDMMESS_0017_002_H17": "这附近的鱼不仅个头大，嘴还很刁。\r\n我要是一不小心就会进到鱼肚子里啦。",
  "CORE_ILLUSIONLIFT_NAME_TXT_29": "怒涛的妖域",
  "CORE_DIALOG_TXT_118": "已获得\r\n小柴猫的服装“疯帽子”！",
  "CORE_SNPSS_1040": "虽然发现了白狼的踪迹，\r\n但它立刻就离开了。\r\n瑟蕾莎和小柴猫跟着白狼\r\n继续往森林深处走去。",
  "AC_NARRATION200_0010": "清新的树木香气\r\n包围着瑟蕾莎。",
  "CORE_HTDMMESS_0017_003_H17": "谢谢你，魔女！事不宜迟，我这就开始……\r\n什么！我居然忘带鱼竿了！",
  "CORE_DIALOG_TXT_156": "战斗太难了？\r\n可更改敌人强度与受到的伤害量。",
  "AC_NARRATION255_0010": "瑟蕾莎和小柴猫\r\n发现了一大片莲花田。",
  "CORE_ARCHIVE_TXT_01": "在故事中登场的人物。",
  "CORE_DIALOG_TXT_152": "请设置便利的技能\r\n“束缚连击”和“咬杀！”的发动方式。\r\n“长按后放开”是基本的发动方式，\r\n也可设置为更便捷的“按下一次”来发动。",
  "LV_009911_0010_NAR": "小柴猫完全不打算动，\r\n仿佛在说“你一个人搞定好了”。",
  "CORE_ARCHIVE_TXT_05": "在森林中结识并交好的人魂。",
  "CORE_SNPSS_4060": "瑟蕾莎和小柴猫\r\n终于破坏了4个元素核心。\r\n在狼的带领下，\r\n直闯莱卡翁的所在之处。",
  "CORE_HTDMQUEST_TXT_0028": "疼痛……我渴望疼痛！\r\n小姑娘，弄疼我吧……！",
  "CORE_WISP_TALK_38_H24": "唔……嘎……\r\n嘎……唔，啊……",
  "CORE_HTDMMESS_0008_002_H08": "我是个猎人。是拉弓射箭的人……\r\n我可不想被箭射中……",
  "CORE_CSRELEASE_CHESHIRE_TXT_02": "【想要获得的话……】\r\n收集各式各样的笔记会发生什么……？",
  "CORE_DIALOG_TXT_114": "已获得\r\n瑟蕾莎的服装“旧日回忆”！",
  "CORE_WISP_TALK_45_H31": "谢谢你救了我。\r\n对了，我的植物们还好吗？",
  "CORE_HTDMMESS_0037_002_H37": "一味地工作会让神经绷得很紧。\r\n虽然这片森林充满危险，\r\n但是偶尔放松一下也很重要哦。",
  "CORE_HAIR_CERESSA_TXT_01": "默认",
  "CORE_ILLUSIONLIFT_NAME_TXT_25": "碎骨的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_36": "威光的妖域",
  "CORE_WISP_TALK_52_H38": "援兵来了啊，果然隐忍是正确的选择。\r\n好了，我要让被打乱的行动规律恢复正常……",
  "CORE_SNPSS_2050": "两人齐心协力打倒了\r\n马戏团团长阿玛丹·杜布。\r\n搜查马戏团帐篷内部，\r\n寻找元素核心。",
  "TA_COM035_0020_CER": "嗯！？",
  "AC_IGNIS010_0010": "状态如何？\r\n现在可以开始秘密通道之旅哦！",
  "CORE_POSEMENU_TXT_00": "请移动光标选择选项。",
  "CORE_HTDMQUEST_TXT_0037": "我想换换心情。\r\n你有没有香水之类的东西？",
  "CORE_POSEMENU_TXT_04": "可读取记录的故事。",
  "AC_NARRATION210_0020": "吵闹的情景展现了妖精们丑陋的心，\r\n这让瑟蕾莎十分消沉。",
  "TEST_GIMMICK_TALK_01": "门上有小小的跷跷板。\r\n正好和人魂差不多大。",
  "CORE_WISP_TALK_41_H27": "我早就通过占卜得知你会来救我。\r\n莫非……你是我的有缘人……？",
  "TA_9012_0010_COL": "大姐姐，不要勉强自己哦。",
  "CORE_HTDMMESS_0028_003_H28": "呵呵，这样我就能忍耐更强烈的疼痛了……！\r\n小姑娘，谢谢你！秘密基地见！",
  "TA_COM035_0010_CER": "咦！？",
  "AC_CEREZA150_0010": "不、不是的！我没有！",
  "AC_CEREZA060_0040": "喂，再这样下去太阳都要落山了哦？",
  "AC_NARRATION245_0020": "据说很久以前，妖精王的王妃就住在里面……\r\n就连瑟蕾莎也听过这个传说。",
  "CORE_DIALOG_TXT_103": "是否更换小柴猫的服装？",
  "CORE_HTDMMESS_0032_003_H32": "谢谢你，柯尔姆收到这个一定会开心的！\r\n另外……能不能顺便告诉我基地怎么走？",
  "CORE_ILLUSIONLIFT_NAME_TXT_21": "激化的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_32": "混战的妖域",
  "CORE_DIALOG_TXT_010": "无法移动至当前所在地点。",
  "CORE_DIALOG_TXT_117": "已获得\r\n小柴猫的服装“诅咒爱情之影”！",
  "CORE_DIALOG_TXT_104": "是否前往更衣室？",
  "CORE_HAIR_CERESSA_TXT_02": "见习魔女的麻花辫",
  "CORE_ILLUSIONLIFT_NAME_TXT_26": "始源的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_35": "恩宠的妖域",
  "CORE_HTDMQUEST_TXT_0023": "呜呜呜，我饿了……\r\n我要吃的……",
  "AC_CEREZA055_0010": "爱哭鬼，胆小鬼，没志气！\r\n像你这种人就该偷偷摸摸缩在阴影里！",
  "CORE_POSEMENU_TXT_03": "返回标题画面。",
  "TEST_WISP_TALK_11_H00": "抱歉哦，得再找两个伙伴来，\r\n才能打开这扇门……",
  "CORE_SNPSS_2040": "瑟蕾莎和小柴猫被带领到\r\n人魂们生活的秘密基地。\r\n两人养精蓄锐后，再次向森林\r\n进发，踏上破坏核心的旅途。",
  "CORE_SVSLT_TXT_03": "请选择要删除的页面。",
  "CORE_HTDMMESS_0006_003_H06": "哎呀，好锋利的尖尖！加工一下就能当针用了！\r\n小魔女，谢谢你帮我解决了一个大难题！",
  "TA_COM005_0010_CER": "哎，小柴猫。",
  "CORE_WH_TALK_15_COL": "谢谢你们救了我们的伙伴！\r\n这是大家一起给你们准备的谢礼哦！",
  "CORE_HTDMMESS_0034_003_H34": "谢谢你！我要回秘密基地去了。\r\n等我恢复了就来听我唱歌吧！",
  "CORE_WISP_TALK_50_H36": "妖精真是太粗鲁了！要是我的头碎掉了可怎么办！\r\n你也是这么想的对吧！？对吧！？",
  "CORE_HTDMQUEST_TXT_0034": "我的嗓子很不舒服……\r\n这位魔女，你有药吗？",
  "CORE_POSEMENU_TXT_07": "请选择记录页面。",
  "AC_NARRATION220_0010": "妖精们的巨大要塞耸立在阴影里。",
  "CORE_CSRELEASE_CHESHIRE_TXT_05": "【想要获得的话……】\r\n目睹贞德的英姿会发生什么……？",
  "CORE_WISP_TALK_60_FAS": "你有时间也去秘密基地露个面吧？\r\n大家好像都很想和你一起玩哦。",
  "CORE_HTDMMESS_0029_001_H29": "唔，好累啊……做什么都提不起劲……\r\n什么，药……？好吧，只要不麻烦……",
  "AC_CEREZA060_0050": "你不太会用元素之力嘛。",
  "CORE_DIALOG_TXT_113": "已获得\r\n瑟蕾莎的服装“高傲恶魔”！",
  "CORE_ILLUSIONLIFT_NAME_TXT_22": "逃避的妖域",
  "CORE_ILLUSIONLIFT_NAME_TXT_31": "守护的妖域",
  "CORE_HTDMMESS_0023_003_H23": "太好了，谢谢你给我吃的！\r\n我差点就要吃掉你了，嘻嘻！",
  "CORE_SNPSS_1050": "梦中的男孩拜托瑟蕾莎\r\n破坏4个元素核心。\r\n确定目标后两人继续追赶白狼。",
  "CORE_WH_TALK_06_COL": "伙伴们都非常可靠。\r\n我也要再加把劲才行……",
  "CORE_DIALOG_TXT_008": "将读取该故事的进度继续游玩。\r\n未记录的故事将会消失。\r\n是否确定？",
  "CORE_ILLUSIONLIFT_NAME_TXT_39": "轮转的考验",
  "CORE_WISP_TALK_66_FAS": "你要去的地方还在前头，\r\n来，我带你去吧。",
  "CORE_WH_TALK_09_COL": "“玩乐尽兴，工作尽职”。\r\n这是秘密基地唯一的规矩！",
  "CORE_DIALOG_TXT_155": "若不想设置为自动，\r\n可在设置的“游玩轻松度”中\r\n进行更改。",
  "CORE_ARCHIVE_TXT_02": "瑟蕾莎面对的敌人。",
  "CORE_HTDMMESS_0039_003_H39": "谢谢你，魔女。\r\n食物也找到了，我该回基地去了……",
  "AC_NARRATION230_0020": "那是阿瓦隆森林的神树，\r\n自古以来有许多位精灵王之灵都祭奠在那里。",
  "CORE_WISP_TALK_69_FAS": "附近有白狼的气息，\r\n你看，那边有足迹吧？",
  "CORE_WH_TALK_13_COL": "看到了吗，我们扩建了秘密基地哦？\r\n多了很多好玩的地方！",
  "CORE_SNPSS_6040": "在阿瓦隆森林冒险一番后，\r\n瑟蕾莎获得了突飞猛进的成长。\r\n她铭记着与挚友的约定，\r\n踏上了全新的旅途。",
  "CORE_DIALOG_TXT_151": "小柴猫想尽情地战斗，\r\n请调整它使用技能时魔力计量条的消耗量。\r\n若设置为“不减少”，\r\n魔力计量条将不会减少。",
  "CORE_WH_TALK_23_COL": "你们是我们的英雄！\r\n我们随时都欢迎你们来玩！",
  "CORE_WISP_TALK_59_FAS": "对了，柯尔姆在急着找你呢。\r\n他说有事要告诉你。",
  "CORE_WISP_TALK_47_H33": "唔……是你救了我吗？我一定得好好报答你。\r\n那些妖精能不能稍微安分一点啊。",
  "CORE_WISP_TALK_56_FAS": "下一个核心在湖底。\r\n你要先到大树那儿去。",
  "CORE_HTDMMESS_0026_002_H26": "唉，妖精们为什么要做这么残忍的事呢？\r\n如果能和平共处，大家就能过上幸福日子了……"
}
