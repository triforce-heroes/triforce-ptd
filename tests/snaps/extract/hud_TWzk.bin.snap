{
  "HUD_PURPOSE_TXT_6020": "阻止萊卡翁",
  "HUD_INTERACT_TEXT_0036_CER": "呃……嗯……\r\n太暗了，實在沒辦法閱讀……",
  "HUD_NOTICE_TXT_04": "已登錄人魂！",
  "HUD_PURPOSE_TXT_4010": "前往妖精的要塞",
  "HUD_INTERACT_TEXT_0039_CER": "曼德拉草……應該已經沒了吧？\r\n畢竟這玩意兒稍不留神馬上就會長出來。",
  "HUD_GAMEOVER_TXT_0007": "瑟蕾莎的心願尚未實現，\r\n就在途中敗給了妖精。\r\n而她的身邊依偎著一具白狼的屍骸。",
  "HUD_INTERACT_TEXT_0009_CER": "啊，發現了好可愛的魚。\r\n希望牠能健康長大，呵呵。",
  "HUD_GAMEOVER_TXT_0003": "妖精們捉住了瑟蕾莎，\r\n並曝晒在妖精樂園之塔的頂端，\r\n她在風雨的侵蝕下逐漸腐朽。",
  "HUD_GAMEOVER_TXT_0010": "妖精們的笑聲響徹四方，\r\n瑟蕾莎和小柴貓被一股\r\n不可思議的力量彈出了提爾納諾。",
  "HUD_PURPOSE_TXT_1030": "繼續趕路",
  "HUD_PURPOSE_TXT_1130": "兩人一起在森林中前進",
  "HUD_INTERACT_TEXT_0013_CER": "從森林回來之後\r\n得添些燈油才行。",
  "HUD_INTERACT_TEXT_0301_CER": "鐵製的……妖精人偶？\r\n這也是馬戲團的道具嗎？",
  "HUD_INTERACT_TEXT_0006_CER": "水瓶已經很老舊了。\r\n不知道能不能換成輕一點的？",
  "HUD_PREVENT_TEXT_0005_CER": "我、我得想辦法阻止那傢伙！\r\n鼓起勇氣上吧，瑟蕾莎！",
  "HUD_INTERACT_TEXT_0402_CER": "咦……\r\n這個轉來轉去的東西壞掉了，真可惜。",
  "HUD_INTERACT_TEXT_0404_CER": "周遭的樹木都枯萎了……\r\n一定是妖精的建築害的。",
  "HUD_PREVENT_TEXT_0003_CER": "有妖精……\r\n往這邊走的話會被發現的。",
  "HUD_PURPOSE_TXT_1091": "前往北邊的廣場",
  "HUD_INTERACT_TEXT_0000_CER": "這裡是摩根娜的家。\r\n現在回去會被罵的……",
  "HUD_PURPOSE_TXT_7000": "打倒受拘束的敵人！",
  "HUD_INTERACT_TEXT_0307_CER": "不會吧……無路可走了……？\r\n不想點辦法的話，那傢伙又會……",
  "HUD_ITEMOBTAIN_TEXT_006": "保存在礦石裡的魔女專用調製素材。\r\n它會動不動就尖叫，\r\n要記得放置在行李深處。",
  "HUD_PURPOSE_TXT_5030": "在被埋沒的聖地中前進",
  "HUD_ITEMOBTAIN_TEXT_002": "森林的魔力所化成的結晶體。\r\n濃郁香甜的滋味滲透至體內深處，\r\n只要吃過一次就會愛上。",
  "HUD_ITEMOBTAIN_TEXT_011": "裝在尖銳瓶子裡的魔女藥水。\r\n使用後會引發小型衝擊波，\r\n讓敵人失去意識。\r\n取得之後，已經能夠調製了！",
  "HUD_ITEMOBTAIN_TEXT_102": "由命櫻花瓣結合而成的巨大寶石。\r\n據說非常堅硬，能承受任何衝擊，\r\n並使持有者長命百歲。",
  "HUD_PURPOSE_TXT_7004": "打倒屏障護身的敵人！",
  "HUD_PURPOSE_TXT_2020": "尋找進入妖精樂園之塔的方法",
  "HUD_PURPOSE_TXT_1195": "前往馬戲團帳篷",
  "HUD_INTERACT_TEXT_0030_CER": "等待已久的訓練時間終於到了！\r\n哪有閒情逸致回家啊！",
  "HUD_PURPOSE_TXT_1081": "用荊棘束縛捕捉香草",
  "HUD_ITEMOBTAIN_TEXT_005": "蘊藏月之力的圓形寶石。\r\n月之力是魔女的力量來源，\r\n據說能讓持有寶石的魔女成長。",
  "HUD_INTERACT_TEXT_0101_CER": "嗯——空氣真清新～！\r\n感覺可以在這裡好好休息一下！",
  "HUD_PURPOSE_TXT_5020": "趕緊跟著狼去找萊卡翁",
  "HUD_GAMEOVER_TXT_0008": "人魂不斷呼救。\r\n但瑟蕾莎已經倒下了，\r\n無法對祂們伸出援手。",
  "HUD_PURPOSE_TXT_7003": "越過咒障並打倒敵人！",
  "HUD_INTERACT_TEXT_0209_CER": "真是破舊的鞦韆。\r\n要是誰能修理……在森林裡太強人所難了嗎？",
  "HUD_INTERACT_TEXT_0223_CER": "竟然把人魂當成表演的材料！？\r\n真是太過分了……！",
  "HUD_ITEMOBTAIN_TEXT_101": "小巧美麗的花瓣形寶石。\r\n是森林生命力的結晶，\r\n收集數個後可提升持有者的體力。",
  "HUD_ITEMOBTAIN_TEXT_012": "裝在花瓣形瓶子裡的魔女藥水。\r\n使用後可稍微恢復瑟蕾莎的體力。\r\n取得之後，已經能夠調製了！",
  "HUD_PURPOSE_TXT_2030": "在妖精樂園之塔中前進",
  "HUD_PURPOSE_TXT_6030": "與萊卡翁對話",
  "HUD_PURPOSE_TXT_4100": "跟著狼去找萊卡翁",
  "HUD_GAMEOVER_TXT_0004": "用盡力氣的瑟蕾莎沉到了陰暗水底，\r\n然後就再也沒有浮上來了。\r\n她的下場只有魚兒們知道。",
  "HUD_ITEMOBTAIN_TEXT_009": "裝在蝶形瓶子裡的魔女藥水。\r\n使用後瑟蕾莎將暫時成為無敵狀態，\r\n並縮短再次使用魔導術所需的時間。\r\n取得之後，已經能夠調製了！",
  "HUD_PURPOSE_TXT_1120": "尋找回魔界的路",
  "HUD_PURPOSE_TXT_3010": "與龍族怪物戰鬥",
  "HUD_INTERACT_TEXT_0900_CER": "這道門上面有蹺蹺板。\r\n正好是人魂可以乘坐的大小……",
  "HUD_INTERACT_TEXT_0107_CER": "咦？這是什麼……！？\r\n沒辦法……回去了……！？",
  "HUD_PURPOSE_TXT_1020": "和貞德一起趕路",
  "HUD_NOTICE_TXT_03": "已登錄記錄檔案！",
  "HUD_INTERACT_TEXT_0108_CER": "不讓我離開這座森林是吧……",
  "HUD_INTERACT_TEXT_0214_CER": "竟然把別人的通緝令扔在這種地方！\r\n不要這麼隨便好不好！",
  "HUD_INTERACT_TEXT_0106_CER": "好大的湖……！\r\n嗯？那裡……好像有什麼東西卡住了……？",
  "HUD_INTERACT_TEXT_0901_CER": "一、二、三……\r\n好像要湊滿三個人魂，門才會開啟……",
  "HUD_GAMEOVER_TXT_1004": "嘎喔。嘎吱嘎吱，咕嚕。\r\n不久之後，回歸寂靜的森林裡\r\n又迴響起了悲痛的喊叫聲。",
  "HUD_INTERACT_TEXT_0201_CER": "這裡的木板都腐蝕了……！？\r\n嗚——希望不要踩破……",
  "HUD_MAPCL_B_10": "他們把純白樹幹的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_03": "他們把新葉庭園的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_ITEMRECIPE_TEXT_009": "裝在蝶形瓶子裡的魔女藥水。\r\n使用後瑟蕾莎將暫時成為無敵狀態，\r\n並縮短再次使用魔導術所需的時間。",
  "HUD_PURPOSE_TXT_2010": "獨自去拯救人魂",
  "HUD_MAPCL_B_14": "他們把封印之地的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_07": "他們把寒風大樹的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_A_08": "他們通過大地的水瓶的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_ITEMOBTAIN_TEXT_021": "蝴蝶形狀的淡紫色水滴。\r\n喝了可提升專注力，\r\n縮短再次使用魔導術所需的時間。",
  "HUD_MAPCL_A_00": "他們通過未知場所的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_13": "他們通過被遺忘的山丘的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_PURPOSE_TXT_4020": "獨自前往妖精的要塞",
  "HUD_ITEMRECIPE_TEXT_012": "裝在花瓣形瓶子裡的魔女藥水。\r\n撒在周圍會瞬間揮發，\r\n並稍微回復瑟蕾莎的體力。",
  "HUD_PURPOSE_TXT_6010": "從萊卡翁手中奪回小柴貓",
  "HUD_MAPCL_B_18": "他們把普卡的要塞的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_PURPOSE_TXT_1100": "前往阿瓦隆森林",
  "HUD_STATUSUP_TEXT_202": "吸收到的魔力充斥著魔導器，\r\n並開始流進瑟蕾莎的體內——！",
  "HUD_INTERACT_TEXT_0208_CER": "看起來十分老舊。\r\n似乎已被閒置在這很長一段時間了。",
  "HUD_MAPCL_A_04": "他們通過妮姆薇湖的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_17": "他們通過枯木森林的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_INTERACT_TEXT_0212_CER": "上面畫的該不會是我跟小柴貓吧！？\r\n好歹也把我畫得漂亮一點啊！",
  "HUD_MAPCL_A_03": "他們通過新葉庭園的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_10": "他們通過純白樹幹的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_INTERACT_TEXT_0031_CER": "夜深了，\r\n還是別去城鎮了吧。",
  "HUD_PURPOSE_TXT_4030": "追上小柴貓",
  "HUD_ITEMRECIPE_TEXT_011": "裝在尖銳瓶子裡的魔女藥水。\r\n撒在周圍會與空氣中的魔力結合，\r\n引發小型衝擊波，讓敵人失去意識。",
  "HUD_MAPCL_B_08": "他們把大地的水瓶的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_INTERACT_TEXT_0001_CER": "這是通往城鎮的門。\r\n但我並不想去城鎮……",
  "HUD_PREVENT_TEXT_0002_CER": "不行不行，現在得認真跑腿。\r\n否則她又要大發雷霆了！",
  "HUD_INTERACT_TEXT_0309_CER": "每個牢籠都破破爛爛的……\r\n是有人大鬧了一場嗎……",
  "HUD_INTERACT_TEXT_0405_CER": "到處都是火焰、火焰、火焰……\r\n害我都汗流浹背了……",
  "HUD_MAPCL_A_07": "他們通過寒風大樹的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_14": "他們通過封印之地的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_PURPOSE_TXT_1010": "繼續前進",
  "HUD_PURPOSE_TXT_1110": "嘗試在森林中前進",
  "HUD_STATUSUP_TEXT_201": "命櫻之花發出耀眼的光輝，\r\n力量從體內滿溢而出——！",
  "HUD_INTERACT_TEXT_0014_CER": "唔哇！好多蟲子……！？\r\n不要過來～！",
  "HUD_PURPOSE_TXT_3020": "抽乾湖水",
  "HUD_INTERACT_TEXT_0300_CER": "唔哇——都是灰塵……\r\n是那個妖精的倉庫嗎？",
  "HUD_INTERACT_TEXT_0012_CER": "來對著蠟燭許願吧。\r\n希望我的夢想能在森林中實現！",
  "HUD_INTERACT_TEXT_0008_CER": "嗯——景色真棒……！\r\n就這樣悠悠哉哉地……沒時間了！",
  "HUD_PURPOSE_TXT_5010": "安撫失控的小柴貓",
  "HUD_MAPCL_B_13": "他們把被遺忘的山丘的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_00": "他們把未知場所的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_PREVENT_TEXT_0004_CER": "不是這邊。\r\n現在得去追白狼才行！",
  "HUD_INTERACT_TEXT_0007_CER": "我的課本竟然掉在這種地方！\r\n等一下要偷偷把它收起來才行。",
  "HUD_GAMEOVER_TXT_1003": "偉大的普卡打倒了所有礙事的傢伙。\r\n已經沒有人能阻止祂了。\r\n統治世界的日子，就在眼前。",
  "HUD_PURPOSE_TXT_2100": "往大樹的方向前進",
  "HUD_MAPCL_B_17": "他們把枯木森林的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_04": "他們把妮姆薇湖的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_INTERACT_TEXT_0037_CER": "摩根娜的家……\r\n到了晚上，就變得有點可怕……",
  "HUD_ITEMOBTAIN_TEXT_022": "蘊藏力量的新月形水晶。\r\n本來只能在魔界取得。\r\n吸收後會全身充滿魔力。",
  "HUD_INTERACT_TEXT_0038_CER": "這裡好暗，一不小心踩空就糟了！\r\n還是不要靠近池塘吧……",
  "HUD_MAPCL_A_18": "他們通過普卡的要塞的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_PURPOSE_TXT_2050": "在魔女藏身處休息一下",
  "HUD_INTERACT_TEXT_0401_CER": "蓮葉真的幫了我好多忙。\r\n一下讓我當船，一下讓我站在上面。",
  "HUD_GAMEOVER_TXT_2001": "用盡力氣後，\r\n貞德的靈魂開始消逝，\r\n只剩下兩個布偶靜靜躺在森林之中。",
  "HUD_MAPCL_A_06": "他們通過流光廣場的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_15": "他們通過被埋沒的聖地的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_PREVENT_TEXT_0006_CER": "門後的東西真讓人在意。\r\n小柴貓，我們去那裡看看吧！",
  "HUD_INTERACT_TEXT_0010_CER": "摩根娜，\r\n我要出發了。",
  "HUD_INTERACT_TEXT_0302_CER": "這台捲繞機竟然比我還大。\r\n到底是用來捲什麼的呢？",
  "HUD_MAPCL_B_09": "他們把飛龍湖畔的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_INTERACT_TEXT_0020_CER": "我送的紫花地丁……\r\n不知道摩根娜有沒有好好珍惜……",
  "HUD_ITEMRECIPE_TEXT_010": "裝在新月形瓶子裡的魔女香水。\r\n散發著令惡魔興奮的香味，\r\n可暫時讓小柴貓不消耗魔力。",
  "HUD_MAPCL_A_02": "他們通過翠綠樂園的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_11": "他們通過妖精樂園之塔的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_INTERACT_TEXT_0035_CER": "汲水、搬運……\r\n這真的算得上訓練嗎……",
  "HUD_INTERACT_TEXT_0033_CER": "雖然還是很髒，\r\n但晚上摩根娜應該看不出來。",
  "HUD_INTERACT_TEXT_0029_CER": "唔哇！黏答答的……！\r\n不小心沾到手上了……",
  "HUD_FORESTGUIDE_TEXT_001": "溫暖的光芒指引出\r\n前往魔女藏身處的路——",
  "HUD_PURPOSE_TXT_4090": "離開要塞並在森林中前進",
  "HUD_PURPOSE_TXT_1140": "幫助瑟蕾莎",
  "HUD_PURPOSE_TXT_2012": "兩人一起拯救人魂",
  "HUD_PURPOSE_TXT_3070": "尋找最後的元素核心",
  "HUD_MAPCL_B_16": "他們把妖精王的祭壇的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_05": "他們把日光海灘的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_GAMEOVER_TXT_1002": "賈巴沃克吃了瑟蕾莎，\r\n但這點東西根本填不飽祂的肚子。\r\n祂飛到天上繼續尋找食物。",
  "HUD_PURPOSE_TXT_1040": "去找摩根娜",
  "HUD_GAMEOVER_TXT_1006": "摩根娜和萊卡翁順利重逢了。\r\n這對母子在克服了重重苦難後，\r\n從此過著幸福快樂的生活。",
  "HUD_PURPOSE_TXT_2105": "在寒風大樹上前進",
  "HUD_INTERACT_TEXT_0304_CER": "搖來晃去的植物……\r\n看久了總覺得有點精神恍惚……",
  "HUD_INTERACT_TEXT_0016_CER": "呵呵，我偷偷存了一些水！\r\n這樣摩根娜也可以放心了吧！",
  "HUD_MAPCL_B_12": "他們把監視哨塔的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_01": "他們把誘惑之路的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_PURPOSE_TXT_4060": "在要塞中前進以尋找狼的所在",
  "HUD_PREVENT_TEXT_0000_CER": "得快點去找摩根娜才行。\r\n否則不知道會遭到何種處罰！",
  "HUD_INTERACT_TEXT_0003_CER": "燈具好重，清理起來很辛苦。\r\n啊——又髒掉了……",
  "HUD_INTERACT_TEXT_0407_CER": "轉個不停……\r\n一直盯著看都要眼花了……",
  "HUD_INTERACT_TEXT_0019_CER": "這麼晚了，\r\n魚兒應該也睡了吧？",
  "HUD_PURPOSE_TXT_4080": "破壞最後的元素核心",
  "HUD_MAPCL_A_09": "他們通過飛龍湖畔的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_GAMEOVER_TXT_1001": "馬戲團以名為瑟蕾莎的表演節目\r\n博得了妖精們的喝采。\r\n「本公演沒有使用戲法和機關」",
  "HUD_PURPOSE_TXT_1050": "去東邊的水井汲水",
  "HUD_PURPOSE_TXT_8000": "突破提爾納諾！",
  "HUD_INTERACT_TEXT_0220_CER": "仔細一看，這個牢籠相當破舊。\r\n是因為用不到所以被丟棄了嗎？",
  "HUD_PURPOSE_TXT_1150": "兩人一起在森林中前進",
  "HUD_PURPOSE_TXT_2011": "拯救被擄走的人魂",
  "HUD_PURPOSE_TXT_3060": "破壞第三個元素核心",
  "HUD_MAPCL_B_15": "他們把被埋沒的聖地的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_06": "他們把流光廣場的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_11": "他們把妖精樂園之塔的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_MAPCL_B_02": "他們把翠綠樂園的\r\n提爾納諾全都破壞了！\r\n籠罩這一帶的詭異氣息隨之消散，\r\n能看出這個區域裡有什麼了。",
  "HUD_GAMEOVER_TXT_1005": "萊卡翁終於找回了肉體和力量。\r\n他背負眾多犧牲，下定決心\r\n以妖精王的身分統治森林。",
  "HUD_PURPOSE_TXT_6040": "乘著小柴貓逃出森林",
  "HUD_PURPOSE_TXT_4070": "打倒親和",
  "HUD_MAPCL_A_05": "他們通過日光海灘的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_16": "他們通過妖精王的祭壇的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_INTERACT_TEXT_0219_CER": "那真的是個長到不行的溜滑梯……\r\n光是回想起來就覺得屁股發熱……",
  "HUD_PURPOSE_TXT_2040": "跟著人魂走",
  "HUD_INTERACT_TEXT_0203_CER": "嗯？好像刻了什麼字……\r\n「闖入森林的人類，必捕！」……？",
  "HUD_INTERACT_TEXT_0104_CER": "那、那是什麼？！\r\n那也是妖精幹的好事嗎……！？",
  "HUD_INTERACT_TEXT_0216_CER": "呼、呼……\r\n那麼幹勁十足，到底打算搬運什麼啊……？",
  "HUD_INTERACT_TEXT_0500_CER": "到處都結凍了。\r\n身體也覺得好冷……\r\n",
  "HUD_MAPCL_A_01": "他們通過誘惑之路的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_MAPCL_A_12": "他們通過監視哨塔的提爾納諾了！\r\n看樣子，這個區域\r\n好像還有其他的提爾納諾。",
  "HUD_PURPOSE_TXT_1070": "前往南邊的香草田",
  "HUD_PURPOSE_TXT_1170": "離開提爾納諾吧",
  "HUD_PURPOSE_TXT_3040": "尋找第三個元素核心",
  "HUD_PURPOSE_TXT_6060": "對抗摩根娜吧",
  "HUD_GAMEOVER_TXT_0009": "瑟蕾莎在要塞被捉了，\r\n妖精們把她的靈魂拿去火爐烤。\r\n似乎因為燒得很旺而大受好評。",
  "HUD_PURPOSE_TXT_7002": "在無傷狀態下打倒敵人！",
  "HUD_ITEMOBTAIN_TEXT_004": "外型可怕的魔界水果。\r\n偶爾會生長在魔力充沛的地方。\r\n營養豐富，如地獄般甜膩。",
  "HUD_PURPOSE_TXT_4050": "謹慎前進，不要被妖精發現",
  "HUD_INTERACT_TEXT_0218_CER": "「本馬戲團非常歡迎人類！」……？\r\n為什麼要用人類的文字寫呢……",
  "HUD_PURPOSE_TXT_1180": "追上狼，尋找元素核心",
  "HUD_PURPOSE_TXT_1080": "用魔導術栽培香草",
  "HUD_INTERACT_TEXT_0217_CER": "「稀世天才——阿瑪丹‧杜布！\r\n在大天幕見證奇蹟吧！」……？",
  "HUD_INTERACT_TEXT_0105_CER": "哇啊……！\r\n草好濕，滑滑的真難走！",
  "HUD_NOTICE_TXT_02": "已解鎖魔女藏身處！",
  "HUD_INTERACT_TEXT_0211_CER": "這是……墳墓？\r\n究竟是誰的墓呢……",
  "HUD_PURPOSE_TXT_9000": "探索森林",
  "HUD_GAMEOVER_TXT_0001": "瑟蕾莎在阿瓦隆森林耗盡力量。\r\n在神隱之森失蹤的她，\r\n終究還是被人們遺忘了。",
  "HUD_PURPOSE_TXT_2060": "前往馬戲團",
  "HUD_PURPOSE_TXT_2090": "尋找第三個元素核心",
  "HUD_ITEMOBTAIN_TEXT_008": "保存在礦石裡的魔女專用調製素材。\r\n將獨角獸的角整根折斷取得。\r\n外型漂亮的長角也可作為觀賞用。",
  "HUD_GAMEOVER_TXT_0005": "瑟蕾莎在普卡的要塞倒下了。\r\n結晶化的她\r\n被悄悄棄置在要塞的一角。",
  "HUD_INTERACT_TEXT_0017_CER": "只要去森林，就能成為強大的魔女。\r\n我已經不需要課本那種東西了！",
  "HUD_NOTICE_TXT_01": "已解鎖地圖！",
  "HUD_PURPOSE_TXT_2070": "打倒阿瑪丹‧杜布",
  "HUD_INTERACT_TEXT_0018_CER": "暫時看不到這片景色了。\r\n即使如此，我也要為了媽咪……！",
  "HUD_INTERACT_TEXT_0406_CER": "竟然蓋了如此巨大的建築物。\r\n看來這裡一定是很重要的地方……",
  "HUD_GAMEOVER_TXT_0002": "瑟蕾莎在深邃森林裡殞命。\r\n結晶化的她被落葉掩埋，\r\n回歸了森林的大地。",
  "HUD_INTERACT_TEXT_0002_CER": "每次看到這塊岩石都覺得好像利齒。\r\n該不會有巨大的怪物被埋在地底下吧！",
  "HUD_INTERACT_TEXT_0310_CER": "看來有人一邊看著我們，\r\n一邊享受著下午茶呢……",
  "HUD_GAMEOVER_TXT_0006": "命數已盡的瑟蕾莎，\r\n在妖精創造的空間中\r\n度過等同於永劫的漫長時光。",
  "HUD_PURPOSE_TXT_2080": "破壞第二個元素核心",
  "HUD_PURPOSE_TXT_1160": "追上狼",
  "HUD_PURPOSE_TXT_3050": "打倒賈巴沃克",
  "HUD_PURPOSE_TXT_1060": "把井水交給摩根娜",
  "HUD_INTERACT_TEXT_0021_CER": "怎麼這麼高……！？\r\n要是不小心掉下去……嗚——",
  "HUD_INTERACT_TEXT_0034_CER": "晚上的燈光真美……\r\n不管看多久都不會膩。",
  "HUD_ITEMOBTAIN_TEXT_003": "魔界黑薔薇的花瓣。\r\n自帶些微魔力，\r\n相傳妖精很喜歡。",
  "HUD_ITEMOBTAIN_TEXT_010": "裝在新月形瓶子裡的魔女香水。\r\n使用後可暫時讓小柴貓不消耗魔力。\r\n取得之後，已經能夠調製了！",
  "HUD_ITEMOBTAIN_TEXT_007": "保存在礦石裡的魔女專用調製素材。\r\n這是烤得恰到好處的蠑螈，\r\n其火烤程度會改變素材的性質。",
  "HUD_PURPOSE_TXT_4040": "和狼一起尋找小柴貓",
  "HUD_PREVENT_TEXT_0007_CER": "我不能在這裡回頭。\r\n為了柯爾姆，我必須振作……",
  "HUD_INTERACT_TEXT_0004_CER": "這盞燈，是摩根娜挑選的嗎？\r\n呵呵，我們的喜好說不定很像喔！",
  "HUD_INTERACT_TEXT_0400_CER": "湖對我而言只是小意思。\r\n我才不怕呢……",
  "HUD_PURPOSE_TXT_7001": "在限制時間內打倒敵人！",
  "HUD_PURPOSE_TXT_1090": "把香草送去給摩根娜",
  "HUD_PREVENT_TEXT_0008_CER": "啊，我忘了拿裝香草的籃子。\r\n空手回到摩根娜那裡有點……",
  "HUD_INTERACT_TEXT_0011_CER": "我要去的不是城鎮。\r\n是阿瓦隆森林！",
  "HUD_PURPOSE_TXT_1190": "尋找第二個元素核心"
}
