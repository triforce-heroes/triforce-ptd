{
  "CE_005020_0000_CER": "Wenn du nicht sofort aufhörst...\r\nwerde ich dir niemals verzeihen!",
  "SM_005020_0210_FAS": "„Passt auf euch auf, ihr zwei.\r\nMöge Avalon euch behüten.“",
  "CE_005110_0000_CER": "Zwei geschafft, zwei fehlen noch!",
  "SM_005020_0020_CER": "„Ignis!“",
  "CE_005820_0000_CER": "Beruhige dich, alles ist gut!",
  "BK_5010_0000_NAR": "Cheshire war wieder zur Besinnung\r\ngekommen. Doch der Tobsuchtsanfall\r\nhatte ihm viel abverlangt.",
  "BK_5000_0260_NAR": "Völlig in Rage richtete\r\nCheshire den Blick auf Cereza.\r\nDer Dämon bleckte die Zähne...\r\nund sprang!",
  "IN_5000_0010_CER": "„Recht hast du, Cheshire.\r\nZeigen wir ihm, was wir draufhaben!“",
  "LV_005010_0020_NAR": "Cheshires ruhige Stimme erfüllte Cereza mit Mut.",
  "SM_005020_0060_FAS": "„Aber ich muss schon sagen...\r\nIch bin wirklich beeindruckt, dass\r\ndu es so weit geschafft hast.“",
  "BK_5000_0010_NAR": "Vor ihnen stand Púca, die protzige\r\nFee von zuvor. Die Explosion schien\r\nihn ein wenig angekohlt zu haben.",
  "LV_005010_0010_NAR": "[FONT:10 ]Spring einfach mit ausgefahrenen Krallen\r\nrein. Lass der Angst gar keine Chance.[FONT:N ]",
  "BK_5000_0180_NAR": "Erneut hatte Cheshire\r\nPúcas Angebot ausgeschlagen.",
  "SM_005020_0050_FAS": "„Ich leiste nur meinen Beitrag.\r\nWie ich dir bereits sagte, ist\r\nes meine Aufgabe zu wissen,\r\nwas im Wald von Avalon vorgeht.“",
  "BK_5000_0100_CER": "„Cheshire?“",
  "IN_5000_0020_CER": "„E-ein Engel?!\r\nWas macht der denn hier?“",
  "BK_5000_0060_NAR": "Die Fee Púca versuchte, Cheshire\r\ndamit zu locken, dass sie ihn nach\r\nInferno zurückschicken würde. Hatte\r\nPúca tatsächlich die Macht, hier und\r\njetzt ein solches Portal zu öffnen?",
  "LV_005905_0000_CER": "Cheshire, fühlst du dich besser?\r\nOder tut dir noch was weh?",
  "_01": "",
  "SM_005020_0180_FAS": "„Ich glaube, dafür bist du\r\nin diesen Wald gekommen.“",
  "BK_5000_0170_POO": "„Ein wollwüchsiger Wicht ist er!\r\nEine hexenhörige Hauskatze!“",
  "LV_005905_0030_CER": "Das hört man gerne!",
  "CE_005010_0000_CER": "Lukaon, hör endlich auf!",
  "CE_005120_0000_CER": "Gut, damit hätten wir drei.",
  "SM_005010_0020_CER": "„Dieses Gefühl... Lukaon ist nicht\r\nmehr fern. Ich bin mir sicher!“",
  "BK_5010_0040_NAR": "Cheshire sagte nichts. Stattdessen\r\nschloss er seine müden Augen.",
  "CE_005805_0010_NAR": "Cheshire war in Raserei verfallen. Seine\r\nAntwort bestand nur aus wildem Knurren.",
  "CE_005810_0000_CER": "Ich halte das nicht mehr lange durch...\r\nAber ich werde Cheshire nicht so lassen!",
  "BK_5010_0010_CER": "„Cheshire... Wieso bist du nicht\r\ndurch das Portal gegangen?“",
  "CE_005835_0000_CER": "Cheshire... Hör auf!",
  "LV_005015_0000_NAR": "Ein bitterkalter Wind wehte ohne Unterlass.\r\nIhre Herzen jedoch waren alles andere als kalt.",
  "CE_005090_0000_CER": "Ich hole mir zurück, was du\r\nvon Cheshire gestohlen hast.",
  "CE_005050_0000_CER": "Irgendwie muss ich\r\ndiese Maschine stoppen...",
  "BK_5000_0110_NAR": "Langsam trat Cheshire\r\nan das Portal heran.",
  "BK_5000_0030_POO": "„Wir sprechen nicht mit ihr.\r\nIhr höllischer Gefährte hingegen\r\nist Uns noch eine Antwort schuldig\r\nbetreffs Unseres... Angebotes.“",
  "CE_005830_0000_NAR": "[FONT:10 ]Lauf... weg...[FONT:N ]\r\nCheshire gewann kurz genug Kontrolle über\r\nsich, um diese Worte herauszupressen.",
  "CE_005825_0010_CER": "Das war knapp!",
  "LV_005010_0000_CER": "Ich habe keine Angst.\r\nCheshire, bist du bereit?",
  "SM_005020_0150_FAS": "„Deshalb habe ich gewartet...\r\nGewartet auf jemanden, der uns\r\naus diesem bösen Traum erweckt.“",
  "BK_5000_0000_POO": "„Halt!“",
  "BK_5000_0120_NAR": "Als er sich der Schwelle des Portals\r\nnäherte, stiegen lauter Erinnerungen an\r\nihre gemeinsame Reise in Cereza auf.",
  "BK_5000_0190_POO": "„So sei es! Doch Infernos Flammen\r\ndürsten nach einem Opfer. Da er nicht\r\nheimzukehren gedenkt, möge er jenes\r\nscheußliche Mädchen an seiner statt\r\ndorthin befördern!“",
  "SM_005020_0110_FAS": "„Nun, du musst wissen...“",
  "LV_005905_0020_NAR": "Aber Cereza könnte schwören,\r\nden Anflug eines Schnurrens in\r\nseiner Stimme gehört zu haben.",
  "CE_005060_0000_CER": "Eine noch...\r\nHalte durch, Cheshire!",
  "BK_5000_0070_POO": "„Der Dämon soll antworten! Einmal\r\nschon verschmähte er Unser großzügiges\r\nAngebot. Doch wie mag es um seine\r\nAntwort stehen, wenn das Feuer von\r\nInferno bereits seine Mähne kitzelt?“",
  "SM_005020_0080_FAS": "„Da könntest du recht haben.\r\nNächstes Mal sollte ich dich\r\nnach dem Weg fragen!“",
  "LV_005020_0000_CER": "Cheshire! Kämpfen wir uns einen Weg frei!",
  "CE_005150_0000_CER": "Ich lasse nicht zu, dass mir irgendjemand\r\nCheshire wegnimmt! Das könnt ihr vergessen!",
  "CE_005815_0010_CER": "Halte durch, Cheshire!",
  "LV_005905_0010_NAR": "[FONT:10 ]Mir geht es gut.[FONT:N ]\r\nMehr sagte Cheshire nicht.",
  "SM_005020_0120_FAS": "„Ich lebe schon seit Ewigkeiten im\r\nWald von Avalon. Er war einmal ein\r\nwunderschöner, freundlicher Ort.“",
  "LV_005910_0000_CER": "Aaaah!",
  "BK_5000_0040_POO": "„Zu lange schon erlag dieser Dämon\r\ndem Joch der Unterdrückung durch\r\njenes lächerliche Hexlein.\r\n\r\nMöge er sich von ihr lossagen!\r\nSogleich würde ihm Unsereins\r\nein Portal gen Inferno öffnen!“",
  "CE_005805_0000_CER": "Cheshire! Bist du dadrin?\r\nErkennst du mich denn nicht?",
  "SM_005020_0160_CER": "„Ignis, warst du etwa...“",
  "CE_005190_0000_CER": "Loooos, Cheshire!!!",
  "SM_005010_0030_NAR": "Irgendetwas sagte Cereza, dass es\r\nkein Zurück mehr gab, wenn sie\r\ndiese Schwelle überschritt.",
  "SM_005010_0000_NAR": "Sie befanden sich wieder im Wald.\r\nEin neuer Pfad tat sich vor ihren\r\nAugen auf.",
  "LV_005005_0020_CER": "Im Herzen des Waldes...\r\nwartet Lukaon.",
  "CE_005030_0000_CER": "Wenn ich davon getroffen\r\nwerde, bin ich erledigt...",
  "IN_5000_0000_CER": "„Schon wieder?!\r\nWarte, irgendwas ist anders...“",
  "CE_005100_0000_CER": "Das wäre schon mal ein Element!",
  "IN_5000_0030_CER": "„Recht hast du, Cheshire.\r\nZeigen wir ihm, was wir draufhaben!“",
  "LV_005005_0010_CER": "Verstehe... Das muss ein Eingang sein...",
  "IN_5010_0010_CER": "„Bist du bereit, Cheshire?\r\nIch bin mir nicht sicher...“",
  "SM_005020_0190_CER": "„Du meinst... Lukaon?“",
  "SM_005020_0200_FAS": "„Schreite voran.\r\nDas Siegel des Altars ist gebrochen.“",
  "SM_005010_0040_CER": "„Wir sind fast da, Cheshire.\r\nWenn du bereit bist,\r\nbringen wir es zu Ende.“",
  "BK_5000_0240_NAR": "\r\nUnd dann...",
  "BK_5010_0020_NAR": "[FONT:9 ]Diesem Irren traue ich nicht.[FONT:N ]\r\nantwortete Cheshire\r\nund wandte sich ab.",
  "CE_005820_0010_CER": "Keine Sorge. Ich bin für dich da.",
  "LV_005900_0010_NAR": "Cheshire schnaubte genervt.\r\n[FONT:10 ]Dauert bestimmt nicht lang, bis der\r\nseine freche Visage wieder zeigt.[FONT:N ]",
  "BK_5010_0060_NAR": "Cereza sang ihm ein Schlaflied,\r\ndas sie von früher kannte.",
  "SM_005020_0040_CER": "„Ohne dich hätten wir das nie\r\ngeschafft, Ignis! Deine Ratschläge\r\nhaben uns echt geholfen.“",
  "SM_005020_0070_CER": "„Wir haben so viel von diesem\r\nWald gesehen. Womöglich kennen\r\nwir ihn bald besser als du!“",
  "BK_5000_0230_NAR": "Cerezas Frage stieß auf taube Ohren.\r\nPúca war zu sehr damit beschäftigt,\r\nirre zu kichern.",
  "CE_005000_0000_CER": "Cheshire!\r\nLukaon, halt! Gib ihn mir zurück!",
  "CE_005130_0000_CER": "Und... vier!\r\nWir haben uns alles zurückgeholt,\r\nwas du uns genommen hast, Lukaon!",
  "SM_005020_0030_FAS": "„Ich gratuliere zur Zerstörung aller\r\nvier Elementarkerne. Du hast die Feen\r\ndamit richtig in Aufruhr versetzt!“",
  "SM_005020_0000_FAS": "„Du hast es endlich vollbracht,\r\nmeine Kleine.“",
  "CE_005800_0000_CER": "Cheshire...",
  "CE_005825_0000_CER": "Aaah!",
  "BK_5000_0090_NAR": "Mit grellem Getöse öffnete die Fee\r\nein feuriges Portal. Cereza spürte\r\ndie Hitze, die auf der anderen\r\nSeite lag, und die vertrauten Klänge\r\ndes Waldes vermischten sich mit den\r\nentfernten Schreien der Verdammten.",
  "LV_005005_0000_NAR": "Da sie alle Elementarkerne zerstört hatten,\r\nwar die Barriere der Feen verschwunden.",
  "SM_005020_0140_FAS": "„Sie verdarben den Wald und\r\nterrorisierten dessen Bewohner.\r\nIch habe Fürchterliches mit ansehen\r\nmüssen und konnte nichts tun.“",
  "CE_005080_0000_CER": "Oh nein, nichts wie weg!",
  "SM_005020_0155_FAS": "„Ich hätte es ja selbst getan,\r\nwenn ich immer noch...“",
  "BK_5000_0020_CER": "„Wenn das mal nicht der selbst ernannte\r\nKönig ist. Was ist denn jetzt schon wieder?“",
  "SM_005020_0170_FAS": "„...Entschuldige, ich habe mich etwas\r\nhinreißen lassen. Gehe weiter und du\r\nfindest, was die Feen so verzweifelt\r\nvon dir fernhalten wollten.“",
  "CE_005040_0000_CER": "Das repariere ich mit\r\nmeiner Magie doch im Nu!",
  "LV_005015_0010_NAR": "Gemeinsam würden sie jedes Hindernis\r\nüberwinden. Diese Überzeugung ließ ihre\r\nHerzen heller strahlen als die Sonne.",
  "CE_005170_0000_CER": "Puh!",
  "BK_5010_0030_CER": "„Das heißt...\r\nmir vertraust du?“",
  "BK_5000_0250_CER": "„Cheshire? Was ist denn los?“",
  "SM_005020_0100_CER": "„Gewartet? Wieso?“",
  "SM_005020_0010_NAR": "Eine Stimme hallte durch die Baumwipfel.\r\nSie zählte zu den wenigen Klängen hier\r\nim Wald, die Cerezas Herz beruhigten.",
  "IN_5010_0000_NAR": "Ab diesem Punkt gibt\r\nes kein Zurück mehr.",
  "CE_005070_0000_CER": "Cheshireeeee!",
  "BK_5000_0220_CER": "\r\n„Was hast du mit ihm gemacht?!“",
  "CE_005805_0020_CER": "Was soll ich nur tun... Vielleicht\r\nkann ich ihm mit meiner Magie helfen?",
  "SM_005010_0010_NAR": "Cereza fühlte sich wie von einer seltsamen\r\nKraft angezogen, als rufe der Pfad nach ihr.",
  "LV_005900_0000_CER": "Glaubst du, dem weißen Wolf geht es gut?",
  "CE_005180_0000_CER": "Uff!",
  "CE_005815_0000_CER": "Jetzt!",
  "SM_005020_0090_FAS": "„...Ich habe schon sehr lange auf jemanden\r\nwie dich gewartet, meine Kleine.“",
  "SM_005020_0130_FAS": "„Doch die Feen haben ihn verändert.“"
}
