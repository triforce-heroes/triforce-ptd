{
  "SM_002100_0150_COL": "「고마워!」",
  "BK_2000_0060_CER": "「무서워하면 안 돼.\r\n난 강한 마녀가 될 거야……!」",
  "LV_002905_0000_NAR": "『느껴져, 커다란 힘이……』\r\n체셔가 무언가를 느꼈습니다.",
  "SM_002100_0040_NAR": "세레자는 무심코\r\n속마음을 입 밖에 내고 있었습니다.",
  "SM_002140_0050_FAS": "「다시 내 소개를 하지.\r\n나는 이 숲의 안내자, 이그니스란다」",
  "SM_002060_0030_CER": "「그만해, 체셔.\r\n코룸이 무서워하잖아.\r\n겁주지 마」\r\n",
  "LV_002035_0120_CER": "뭐야, 엘레멘트의 힘을 쓰고 있는 건 나잖아.\r\n잘난 척하지 마!",
  "CE_002815_0000_CER": "에잇, 에잇, 에잇, 에잇~!",
  "SM_002140_0060_FAS": "「서커스를 잘 극복해 냈구나.\r\n역시 내 눈은 틀리지 않았어」",
  "SM_002060_0000_COL": "「여긴 우리 비밀 기지야.\r\n원래 친구들 말고는 알려 주면 안 되는데\r\n누나한테는 특별히 알려 줄게」",
  "BK_2000_0050_CER": "「나도 싸울 수 있어!\r\n무시하지 마!」",
  "LV_002035_0015_NAR": "체셔가 불만스럽게 으르렁댑니다.",
  "SM_002130_0135_CER": "「……근데, 무슨 뜻이야?」",
  "LV_002900_0000_CER": "대체 뭐야, 저 피에로 모자!\r\n계속 방해나 하고 말이야!",
  "SM_002010_0100_COL": "「잡혀간 친구를\r\n구해 주러 가고 싶은데\r\n난 아무것도 할 수가 없어서……」",
  "SM_002010_0180_NAR": "성을 내던 체셔는\r\n결국 고개를 돌리며 무시했습니다.\r\n\r\n그래도 세레자는 코룸을\r\n내버려 둘 수 없습니다.",
  "SM_002010_0010_NAR": "세레자는 모르가나가 해 준 이야기를\r\n떠올렸습니다.\r\n\r\n숲에는 힘이 다해\r\n죽은 사람이 \"도깨비불\"이 되어\r\n떠돌아다니고 있다고……",
  "CE_002070_0000_CER": "자, 피날레의 시간이야!",
  "LV_002080_0020_NAR": "자기도 모르게 하품을 하는 세레자.\r\n몸이 너무 피곤합니다.",
  "SM_002140_0100_NAR": "상대가 도깨비불이라는 걸 알고\r\n세레자의 말투도 자연스레 풀어졌습니다.",
  "SM_002130_0150_FAS": "「그곳에서 실성한 단장이\r\n지금도 홀로 공연하고 있지.\r\n만약 그 단장에게 들키면……\r\n\r\n죽을 때까지 함께 서커스를\r\n하게 될 거야」",
  "SM_002040_0050_CER": "「다들 저렇게 기뻐하잖아.\r\n\r\n이제 코룸도, 다른 아이들도\r\n다시 함께 지낼 수 있어」",
  "SM_002140_0010_CER": "「이, 이 목소리는!」",
  "SM_002140_0210_FAS": "「문제라도 있니?」",
  "SM_002110_0090_CER": "「마녀에게 머리카락은 중요하단 말이야!\r\n좀 더 조심해 줘!」",
  "_05": "",
  "SM_002130_0120_FAS": "「……하지만 다음 엘레멘트 코어까지는\r\n그리 간단하게 갈 수 없단다」",
  "LV_002930_0000_CER": "로즈메리? ……맞아, 액막이 꽃이었지.\r\n너는 무리할 필요 없어",
  "SM_002140_0045_CER": "「네가 그 목소리의 주인공이야?」",
  "CE_002040_0000_CER": "어라?\r\n스위치가 뒤집혀서 안 눌리는데?",
  "SM_002130_0080_FAS": "「찾고 있는 건 하얀 늑대가 아니니?」",
  "_01": "",
  "SM_002130_0110_FAS": "「꼬마 아가씨는 지금\r\n목적을 향해서 바른길로 가고 있구나」",
  "SM_002040_0180_CER": "「내가 강했더라면\r\n그때 엄마를……」\r\n",
  "SM_002040_0100_NAR": "그렇게 말한 세레자는\r\n문득 깨달았습니다.",
  "IN_2000_0010_NAR": "세레자가 짓궂게 말했지만\r\n체셔는 시치미를 뗍니다.",
  "LV_002070_0010_NAR": "즐거워서 자기도 모르게 소리를 지르는 세레자.\r\n아직 어린애입니다.",
  "SM_002140_0180_FAS": "「하하, 그건 걱정할 필요 없단다.\r\n호수 물을 빼 버리면 그만이니」",
  "_54": "",
  "LV_002005_0030_NAR": "『맛있어 보이네, 내가 먹어 주지』",
  "SM_002100_0110_COL": "「그럼 마지막으로\r\n하나만 더 부탁해도 돼?」",
  "SM_002080_0010_CER": "「어때? 체셔.\r\n나도 한다면 하지?」\r\n",
  "SM_002050_0000_COL": "「고마워, 누나!」",
  "SM_002140_0220_CER": "「아니, 없어. 전혀 문제없어.\r\n나 높은 곳도…… 아무렇지 않아.\r\n자세하게 알려 줘서 고마워!」",
  "LV_002010_0010_CER": "도깨비불을 괴롭히고 있어……\r\n하지만 나 혼자서는 아무것도 못 해……",
  "SM_002100_0120_COL": "「혹시 숲속에서 요정한테 잡혀 있는\r\n우리 친구들을 발견하면……\r\n아까처럼 또 도와줬으면 좋겠어」",
  "IN_2000_0020_NAR": "『귀찮은 것들이 오길래 정리했을 뿐이야.",
  "CE_002080_0000_CER": "큭…!\r\n으윽…… 읏…… 으으……!",
  "SM_002130_0160_CER": "「죽을 때까지……」",
  "SM_002080_0040_NAR": "무시하는 체셔의 태도에\r\n세레자는 불만만 쌓입니다.",
  "LV_002035_0115_NAR": "체셔가 무시하듯이 웃었습니다.",
  "LV_002040_0030_CER": "……나도 엄마랑 같이 놀고 싶었는데",
  "BK_2000_0040_NAR": "『방해되니까 저리 가 있어!』\r\n허둥대는 세레자에게\r\n체셔가 고함을 질렀습니다.",
  "SM_002060_0090_COL": "「누나한텐 이걸 줄게.\r\n신기한 힘이 깃들어 있다니까\r\n뭔가 도움이 될지도 몰라」",
  "CE_002800_0000_CER": "저 공에 타고 있는 게 거슬리네!\r\n떨어트려 버려야겠어!",
  "SM_002060_0100_CER": "「고마워!」",
  "IN_2000_0040_CER": "……아, 그러셔!",
  "SM_002130_0010_CER": "「누, 누구야!?」",
  "CE_002000_0000_CER": "이리 내려와!",
  "SM_002060_0130_COL": "「응! 혹시 문제가 생기면\r\n뭐든 말해 줘」",
  "LV_002035_0020_CER": "너도 숲 깊은 곳까지 가고 싶잖아?\r\n그럼 불평하지 마.",
  "SM_002130_0210_FAS": "「그럼 나는 이쯤에서 가 볼까.\r\n너희의 여행이 무사히 끝나길 기도하마」",
  "SM_002100_0050_CER": "「늑대!?」",
  "LV_002055_0010_NAR": "도깨비불을 도와준 덕분에\r\n세레자의 마음이 조금 가벼워졌습니다.",
  "LV_002905_0010_CER": "엘레멘트 코어가 근처에 있나 봐.\r\n분명 이 앞에 있는 서커스장일 거야.",
  "LV_002090_0010_CER": "저게…… 뭐지?",
  "BK_2010_0040_LUC": "「울지 마……」",
  "SM_002010_0030_COL": "「누나는 누구야? 길을 잃었어?」",
  "SM_002040_0040_NAR": "『저런 걸 도와줘서 뭐해?』\r\n체셔는 기가 차다는 듯이 말했습니다.",
  "SM_002110_0070_CER": "「어휴, 체셔 이 바보야!\r\n머리가 끈적끈적해졌잖아!」",
  "SM_002010_0000_CER": "「저건…… 혹시 도깨비불?」",
  "SM_002130_0060_FAS": "「그럼 속는 셈 치고 뭐든지 물어보렴.\r\n무엇이든지 대답해 줄 테니」",
  "SM_002140_0030_NAR": "세레자가 고개를 돌리니\r\n그곳에는 모자를 깊게 눌러쓴\r\n살짝 별난 도깨비불이 서 있었습니다.",
  "SM_002040_0070_NAR": "『다른 사람이 어찌 되든 상관없어』\r\n체셔가 퉁명스럽게 말했습니다.",
  "SM_002140_0120_CER": "「그보다……\r\n이름이 이그니스라고 했지?」",
  "SM_002010_0190_CER": "「어쨌든 난 갈 거야!」\r\n",
  "LV_002915_0000_CER": "재미있다~!\r\n이거 어디까지 이어져 있을까?",
  "LV_002050_0010_CER": "들키지 않게 조심해서 가야겠다……",
  "SM_002130_0180_FAS": "「하지만 걱정할 것 없단다.\r\n아가씨와 그 악마가 함께라면\r\n쉽게 죽지는 않을 테니 말이야」",
  "SM_002140_0150_CER": "「호수 밑……!?」",
  "SM_002040_0110_CER": "「……그렇구나. 내가 너를\r\n여기로 불러와 버렸지」",
  "SM_002040_0190_NAR": "세레자는 그렇게 말하며, 구하지 못한\r\n엄마의 모습을 떠올렸습니다.",
  "SM_002010_0160_NAR": "팽팽히 대립하는 세레자와 체셔.\r\n서로를 노려보며\r\n한 치도 양보하지 않습니다.",
  "SM_002010_0070_CER": "「코룸. 아까부터\r\n쓸쓸해 보이던데……\r\n무슨 일 있니?」",
  "SM_002040_0080_CER": "「무슨 말이야.\r\n그럼 내버려 둬도 괜찮다는 거야?」\r\n",
  "LV_002925_0000_CER": "어라!?\r\n우리…… 서로 뒤바뀐 거야!?",
  "SM_002020_0080_NAR": "『너 같은 겁쟁이가 뭘 할 수 있지?』\r\n체셔는 코웃음을 칩니다.",
  "SM_002020_0000_CER": "「체셔!?」",
  "SM_002140_0160_CER": "「그, 그거 잘됐네.\r\n나 잠수에는 자신 있거든」",
  "SM_002110_0080_NAR": "황급히 머리를 닦는 세레자를\r\n체셔는 거들떠보지도 않습니다.",
  "SM_002010_0040_CER": "「너 말을 할 수 있어!?」",
  "SM_002060_0050_NAR": "『그보다 용건이 있으면 빨리 좀 끝내』\r\n마음이 급한 체셔는\r\n그렇게 말하며 코룸을 노려봅니다.",
  "LV_002005_0010_CER": "저건 뭘까?",
  "SM_002050_0010_NAR": "기운을 되찾은 코룸은\r\n친구들을 구해 준 보답을 하고 싶다고\r\n말했습니다.",
  "SM_002080_0000_NAR": "만만찮은 요정을 물리친 세레자와 체셔.\r\n세레자는 이번 싸움에서 이전과는 달리\r\n살짝 잘 싸웠단 생각이 들었습니다.",
  "BK_8100_0010_CER": "「알고 있어.\r\n이번에는 어떤 힘일지\r\n시험해 보자」",
  "CE_002030_0000_CER": "기둥 앞에 있는 스위치가 수상하네",
  "CE_002100_0000_CER": "체셔…… 도와줘!!",
  "SM_002130_0050_CER": "「믿어 달라고 해도……」",
  "SM_002140_0080_FAS": "「불쌍도 하지!」",
  "IN_2000_0000_CER": "뭐야, 결국 도와줄 거면서",
  "SM_002010_0080_COL": "「요정이…… 내 친구를\r\n끌고 가 버렸어……」",
  "SM_002130_0170_FAS": "「이런……\r\n겁을 줘 버렸나?」",
  "SM_002010_0110_CER": "「……괜찮아. 우리가 도와줄게」\r\n",
  "LV_002095_0010_CER": "옛날에 이런 공연을 본 적 있어.\r\n설마 내가 하게 될 줄이야……!",
  "SM_002010_0044_CER": "「나는 세레자라고 해. 너는?」",
  "SM_002140_0230_FAS": "「별말씀을」",
  "SM_002020_0040_NAR": "『네가 죽으면 나도 죽어.\r\n그래서 따라왔을 뿐이야』\r\n\r\n그렇게 말하고 싶은 듯한 표정입니다.",
  "SM_002120_0000_NAR": "『더 빨리 달려!』\r\n늑대를 따라가지 못하는\r\n세레자를 보고 체셔가 짜증을 냅니다.",
  "LV_002030_0020_CER": "그걸 쓰면 지금까지 못 갔던 곳도\r\n갈 수 있을지 몰라!",
  "CE_002805_0000_CER": "바로 피해 버리잖아!\r\n대포를 맞히려면 어떻게 해야 하지……!",
  "LV_002030_0010_CER": "아까 얻은 힘……",
  "SM_002010_0120_COL": "「정말!?」",
  "SM_002040_0150_NAR": "『태어난 지 얼마 안 됐어도\r\n난 너보다 한참 강해』\r\n세레자가 하려는 말을 끊고\r\n체셔는 가소롭다는 듯이 웃었습니다.",
  "SM_002140_0110_NAR": "하지만 체셔는 아무 말도 하지 않습니다.\r\n도깨비불에 전혀 관심이 없나 봅니다.",
  "LV_002080_0030_NAR": "세레자는 여기서 잠깐 쉬고 가기로 했습니다.",
  "SM_002130_0140_FAS": "「이 앞에는 옛날에\r\n요정이 인간 아이들을\r\n숲으로 끌어들이기 위해 사용한\r\n낡은 서커스장이 남아 있단다」",
  "SM_002130_0090_CER": "「어, 어떻게 알았어?」",
  "LV_002910_0000_CER": "이게 무슨 소리야!?\r\n이쪽으로 오고 있어!",
  "SM_002100_0140_CER": "「내가 할 수 있다면 언제든 도와줄게」",
  "SM_002100_0060_NAR": "멀어져 가는 늑대의 모습을 보고\r\n세레자는 벌떡 일어났습니다.",
  "LV_002055_0020_CER": "요정들 진짜 너무하네.\r\n도깨비불은 모두 내가 구할 거야!",
  "CE_002060_0000_CER": "스위치랑 이어져 있구나",
  "SM_002100_0170_COL": "「누나, 고양아, 다음에 봐~!」",
  "LV_002090_0020_NAR": "멀리 보이는 커다란 텐트 같은 건물.\r\n피처럼 붉은 모습으로 마치 세레자를\r\n유혹하듯이 서 있습니다.",
  "SM_002140_0070_FAS": "「단장은 두 번 다시\r\n공중그네를 타지 못할 거야」",
  "SM_002060_0010_COL": "「어라? 같이 있던 고양이는 어딨어?」",
  "SM_002130_0020_NAR": "세레자는 갑자기 들린 목소리에 놀라\r\n심장이 쪼그라들 뻔했습니다.",
  "SM_002130_0130_CER": "「엘레멘트 코어까지 알고 있어!?」",
  "LV_002035_0010_NAR": "『내 혀는 사냥감을 맛보기 위한 거야.\r\n언제까지 이런 짓을 해야 하지?』",
  "SM_002100_0100_CER": "「응, 조금 급해서」",
  "LV_002005_0020_NAR": "세레자가 과일 같은 것을 발견했습니다.",
  "SM_002140_0200_CER": "「가장 높은 곳……」",
  "SM_002080_0030_CER": "「흥! 체셔 나빴어!」",
  "SM_002100_0090_COL": "「누나, 벌써\r\n가는 거야?」",
  "SM_002100_0010_NAR": "꿈에서 깬 세레자는 속으로 몇 번이나\r\n소년의 말을 되새겼습니다.",
  "SM_002050_0020_COL": "「따라와!」",
  "SM_002140_0190_FAS": "「……다만 그러기 위해서는\r\n거대수를 넘어서야 한단다.\r\n\r\n깊은 호수 밑바닥에 가려면\r\n이 숲에서 가장 높은 곳에\r\n올라가야만 하지.\r\n철학적이지 않니?」",
  "LV_002920_0000_CER": "이쪽으로 오고 있어……!?\r\n저게 대체 뭐야!?",
  "LV_002065_0010_CER": "코룸, 너는 그렇게 작은데\r\n걸음이 엄청 빠르구나",
  "SM_002140_0000_FAS": "「서커스는 재미있었니?」",
  "SM_002030_0010_NAR": "세레자가 짓궂게 말했지만\r\n체셔는 시치미를 뗍니다.",
  "SM_002060_0060_COL": "「성질 급한 고양아.\r\n네 선물은 저거야!」",
  "CE_002050_0000_CER": "이 레버는 뭘까?",
  "SM_002060_0140_NAR": "그렇게 말하고 코룸은\r\n친구들이 있는 곳으로 달려갔습니다.",
  "SM_002030_0020_NAR": "『귀찮은 것들이 오길래 정리했을 뿐이야.\r\n너와 달리 난 강하거든』\r\n\r\n그렇게 말하며 체셔는 또\r\n가소롭다는 듯이 콧방귀를 뀝니다.",
  "IN_2000_0030_NAR": "너와 달리 난 강하거든』 ……그렇게 말하며\r\n체셔는 또 가소롭다는 듯이 콧방귀를 뀝니다.",
  "SM_002100_0130_COL": "「최대한 보답할 테니까!」\r\n",
  "SM_002100_0020_NAR": "그러자 가슴 한편에\r\n환한 등불이 켜진 듯이\r\n마음이 따뜻해졌습니다.",
  "SM_002130_0220_NAR": "그 말이 끝나자\r\n주변이 다시 고요해졌습니다.",
  "SM_002120_0040_NAR": "체셔는 아무 말도 하지 않고\r\n언짢다는 듯이 세레자를 노려봤습니다.",
  "_71": "",
  "SM_002040_0120_NAR": "『난 태어난 지 얼마 안 됐다.\r\n소중한 것 따위 없고, 필요도 없어』\r\n체셔는 관심 없단 표정으로 말했습니다.",
  "SM_002110_0110_CER": "「시, 시끄러워!\r\n금세 잘 다루게 될 거야!」",
  "SM_002010_0150_CER": "「그럼, 그냥 저렇게 놔둬!?」",
  "BK_2010_0020_CER": "「보고 싶어…… 보고 싶어, 엄마……」",
  "CE_002035_0000_CER": "밟으면 스포트라이트가 기둥을 비추는구나",
  "SM_002130_0100_FAS": "「지금은 꼬마 아가씨도\r\n숲의 일부라 할 수 있지. 그러니\r\n아가씨가 생각하는 것도 다 보인단다」",
  "BK_2010_0010_CER": "「왜 안 열리는 거야……?」",
  "SM_002040_0000_CER": "「다들 무사해서 다행이야.\r\n사, 살짝 고생 좀 했지만」",
  "SM_002140_0040_CER": "「도깨비불……?」",
  "CE_002090_0000_CER": "우, 움직일 수…… 없어……!",
  "SM_002020_0030_NAR": "사실 세레자는 내심 기뻤지만,\r\n체셔는 언짢은 듯 입을 열지 않습니다.",
  "SM_002010_0020_CER": "「……얘, 왜 그러고 있어?」",
  "SM_002140_0090_CER": "「그 녀석 진짜 난폭하다니까?\r\n난 그런 녀석의 공연에\r\n끌려다니고 싶지 않아!」",
  "SM_002130_0040_FAS": "「적어도 요정은 아니란다.\r\n믿어 주렴」",
  "LV_002025_0010_CER": "……역시 저 도깨비불을 그냥 두고 갈 수 없어!",
  "CE_002810_0000_CER": "네 공연도 이제 질렸어!\r\n체셔!",
  "SM_002120_0020_CER": "……그래 체셔,\r\n나를 등에 업고 달리면 안 돼?\r\n그러면 곧바로 따라잡을 거야!",
  "SM_002020_0060_CER": "「네가 안 도와주더라도\r\n도깨비불은 나 혼자서\r\n구할 수 있거든!」",
  "SM_002130_0240_CER": "「대체 누구였을까……?」",
  "CE_002010_0000_CER": "지금이 기회야!",
  "SM_002120_0010_CER": "최대한 빨리 달리고 있는 거야!",
  "SM_002020_0050_CER": "「흥!」",
  "LV_002080_0010_CER": "후아아아암……",
  "SM_002140_0130_CER": "「이그니스, 너 혹시\r\n다른 엘레멘트 코어의 위치를\r\n알고 있다거나…… 그래?」",
  "SM_002040_0170_CER": "「나, 나도 금방 강해질 거야.\r\n야만스러운 악마랑은 달라!」\r\n",
  "LV_002045_0010_NAR": "저 다리를 내려야 안으로 들어갈 수 있겠네",
  "SM_002140_0020_NAR": "들어 본 적 있는 목소리가\r\n어디선가 들려왔습니다.",
  "SM_002010_0090_NAR": "코룸은 울먹이는 목소리로\r\n말했습니다.\r\n\r\n듣자 하니 요정들은 도깨비불을\r\n몹시 괴롭히고 있으며 개중에는 \r\n영영 못 돌아오는 친구도 있다고 합니다.",
  "SM_002060_0110_COL": "「……누나 많이 지쳤지?\r\n여긴 안전하니까 쉬다 가도 돼」\r\n",
  "SM_002060_0080_CER": "「말은 저렇게 해도\r\n좋아하고 있는 거야」",
  "LV_002035_0110_NAR": "『흥, 나 없이는\r\n넌 아무것도 못 하겠지』",
  "BK_2010_0060_LUC": "「분명 어머니를 만날 날이 올 거야……\r\n너도, 나도……」",
  "LV_002085_0020_NAR": "도깨비불과 노는 건 즐겁지만\r\n세레자에게는 해야 할 일이 있습니다.",
  "LV_002040_0020_CER": "아니면 옛날에 사람들이 살았던 곳인가……?",
  "SM_002100_0160_NAR": "이렇게 세레자와 체셔는\r\n코룸과 헤어지고\r\n하얀 늑대를 찾아 나섰습니다.",
  "SM_002100_0070_CER": "「체셔, 이제 만족했지?」\r\n",
  "LV_002040_0010_CER": "여긴 뭐야?\r\n요정들이 노는 곳일까……?",
  "BK_2010_0050_LUC": "「너에겐 굳센 의지가 있어……\r\n소중한 사람을 지키려는 강한 마음……\r\n그러니까 괜찮아……」",
  "LV_002085_0010_NAR": "세레자는 다시 숲속을 향해 갑니다.",
  "SM_002130_0200_FAS": "「그 정도로 너희들을\r\n두려워하고 있다는 소리지.\r\n특히나 그 악마를……」",
  "CE_002000_0010_CER": "체셔 발이 안 닿는 곳으로\r\n도망만 다니잖아!",
  "SM_002060_0120_CER": "「듣고 보니……\r\n이 숲에 들어온 뒤로 계속 고생만 했네.\r\n잠시 쉬다 갈까?\r\n\r\n여러모로 고마워, 코룸」",
  "SM_002140_0140_FAS": "「물론이고말고.\r\n다음 코어는 호수 밑에 잠들어 있단다」",
  "SM_002100_0030_CER": "다음엔 또 언제\r\n걔가 나오는 꿈을 꿀 수 있을까……",
  "SM_002060_0040_NAR": "『이렇게 맛없어 보이는 녀석은 필요 없어』\r\n체셔가 관심 없단 표정으로 말했습니다.",
  "SM_002130_0070_CER": "「뭐?\r\n어어…… 그럼, 하……\r\n검은 늑대가 어디로 갔는지 알아?」",
  "SM_002030_0030_CER": "「……아, 그러셔!」",
  "LV_002065_0110_CER": "너랑 만날 때까지 도깨비불이 정말 있으리라곤\r\n생각도 못 해 봤어",
  "SM_002030_0000_CER": "「뭐야, 결국 도와줄 거면서」",
  "SM_002060_0070_NAR": "『뭐야 겨우 이거야?』\r\n체셔는 마음에 안 든다는 투로\r\n말하면서도 잰걸음으로 달려갑니다.",
  "LV_002935_0000_CER": "에헴!\r\n어때? 나 혼자서 모두를 구했다고!",
  "SM_002080_0020_NAR": "하지만 체셔는 냉담한 반응입니다.",
  "SM_002100_0000_CER": "「\"나도\"……?」",
  "BK_8100_0000_CER": "「또 그때랑 똑같아……」",
  "BK_2000_0020_NAR": "갑자기 요정이 덮쳐 왔습니다.\r\n세레자는 이번에도\r\n발이 얼어붙어 버렸습니다.",
  "SM_002020_0020_CER": "「……결국 따라왔구나.\r\n그래, 넌 나하고 떨어질 수 없지.\r\n\r\n……그래서, 도와줄 거야?」",
  "SM_002040_0090_CER": "「너도 소중한 사람과\r\n떨어지는 고통을……」",
  "SM_002130_0000_FAS": "「꼬마 아가씨, 잠깐 괜찮니?」",
  "SM_002040_0010_NAR": "세레자는 그렇게 허세를 부렸지만\r\n체셔에게 도움만 받았다는 사실이\r\n너무나 분했습니다.",
  "SM_002010_0060_COL": "「나는 코룸이야」",
  "SM_002130_0190_FAS": "「실제로 너희들이\r\n숲에 들어온 이후로\r\n요정들이 모두 야단법석이야」",
  "LV_002015_0010_CER": "체셔, 저기서 도깨비불을 괴롭히고 있었어!\r\n도와주러 가자!",
  "SM_002040_0020_NAR": "한편 체셔는\r\n기뻐하는 도깨비불들을\r\n관심 없다는 표정으로 바라봅니다.",
  "SM_002130_0030_FAS": "「글쎄다……\r\n\"이 숲을 누구보다 잘 아는 자\"\r\n라고 해 둘까?」",
  "SM_002010_0140_NAR": "세레자의 말에 귀를 의심한 체셔는\r\n곧장 반발했습니다.",
  "CE_002020_0000_CER": "안 놓칠 거야!",
  "SM_002110_0100_NAR": "『제대로 쓰지도 못하면서\r\n손질은 참 열심이네』\r\n체셔가 놀리듯이 웃었습니다.",
  "SM_002140_0170_CER": "「……떠오르지는 못하지만」",
  "SM_002040_0130_CER": "「태어난 지…… 얼마 안 됐다고?\r\n그럼 너는……」\r\n",
  "SM_002020_0090_NAR": "하지만 세레자는\r\n안 들리는 척했습니다.",
  "SM_002120_0050_CER": "그럴 줄 알았어. ……치사해!",
  "SM_002130_0230_CER": "「사라졌어……」"
}
