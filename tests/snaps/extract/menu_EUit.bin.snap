{
  "MENU_HELP_TXT_019_01": "Aumenta la velocità di recupero\r\ndel potere magico quando sei\r\nin modalità abbraccio durante\r\nun combattimento.",
  "MENU_HELP_TXT_103_02": "Cheshire recupera la propria\r\nenergia vitale quando è in\r\nmodalità abbraccio.",
  "MENU_HELP_TXT_115_01": "Permette a Cheshire di sferrare\r\nun attacco con il corpo in modalità\r\nbelva tenendo premuto [BTN:R2 ] e poi\r\nrilasciandolo.",
  "MENU_HELP_TXT_021_01": "Permette a Cheshire di deviare\r\nproiettili nemici quando è esteso\r\nin modalità abbraccio con [BTN:RS ].",
  "MENU_HELP_TXT_204_01": "Nell'archivio, tra le altre cose,\r\npuoi leggere approfondimenti\r\nsu personaggi o nemici incontrati\r\nnel corso della tua avventura.",
  "MENU_SKILLTREE_DIALOG_TXT_01": "Qui puoi provare le tecniche\r\nche hai imparato. Vuoi andare\r\nnella sala di pratica?",
  "MENU_HELP_TXT_212_02": "Per imparare nuove tecniche,\r\na Cereza servono le rose d'onice,\r\na Cheshire le gocce di Avalon.",
  "MENU_HELP_TXT_104_01": "Quando Cheshire è in una delle sue\r\nforme elementali, i suoi attacchi\r\nsono molto più potenti di quand'è\r\nnella sua forma base.",
  "MENU_HELP_TXT_112_02": "In modalità belva, Cheshire può\r\nschivare con [BTN:L1 ] ed eseguire\r\nun attacco devastante con [BTN:R1 ].",
  "MENU_HELP_TXT_249_01": "Ignis ti guiderà verso il Santuario\r\npiù vicino al prossimo obiettivo\r\ndi Cereza se selezioni \"Sentieri\r\ndi Ignis\".",
  "MENU_HELP_TXT_008_01": "Gli oggetti hanno vari tipi\r\ndi effetti utili. Per usarne\r\nuno, tieni premuto il pulsante\r\ndi direzione corrispondente ([BTN:DP ]).",
  "MENU_HELP_TXT_215_01": "La modalità abbraccio consiste\r\nin Cereza che porta in braccio\r\nCheshire nella sua forma di\r\nanimale di pezza.",
  "MENU_HELP_TXT_211_01": "Nel menu Preparativi, Cereza\r\ne Cheshire possono cambiare\r\ni loro costumi con altri, ottenibili\r\nsoddisfacendo certe condizioni.",
  "MENU_HELP_TXT_207_02": "Avvicinati a un Santuario per\r\nsbloccarlo e aggiungerlo alla\r\nmappa. Ricorda di sbloccare\r\ntutti i Santuari che incontri.",
  "MENU_SKILLTREE_TXT_327": "Mentre tieni premuto [BTN:L2 ], ruota [BTN:LS ]\r\nper riportare gli oggetti alla\r\nloro condizione originale.",
  "MENU_HELP_TXT_229_01": "Certi spiritelli, dopo essere stati\r\naiutati, seguiranno Cereza.\r\nAttenzione, perché verranno\r\nsconfitti al primo colpo ricevuto.",
  "MENU_SKILLTREE_TXT_423": "Con Cheshire fuoco, alla fine di\r\nuna Combo legaccio puoi eseguire\r\nun Attacco elementale fuoco.",
  "MENU_HELP_TXT_129_01": "Cheshire può tirare Cereza con [BTN:RS ]\r\nmentre è esteso in modalità abbraccio\r\naffinché entrambi si muovano più\r\nvelocemente.",
  "MENU_SKILLTREE_TXT_427": "Gli attacchi di Cheshire\r\ninfliggono ancora più danni.",
  "MENU_HELP_TXT_216_02": "In modalità belva, puoi\r\nmuovere Cereza con [BTN:LS ]\r\ne Cheshire con [BTN:RS ].",
  "MENU_HELP_TXT_025_01": "Per questo Battito di strega, tieni\r\ninclinato [BTN:LS ] mentre l'indicatore\r\nsi sposta lungo la linea rossa\r\nallungata.",
  "MENU_SKILLTREE_TXT_330": "Ti permette di tenere\r\nmolti più oggetti.",
  "MENU_SKILLTREE_TXT_323": "Ti permette di tenere ancora\r\npiù oggetti.",
  "MENU_HELP_TXT_111_01": "Cheshire è un demone e quindi non\r\npuò passare vicino al rosmarino.\r\nPer passare oltre, dovrai fargli\r\ntrovare un'altra strada.",
  "MENU_HELP_TXT_107_02": "Afferra qualcosa con la lingua\r\ne poi tieni premuto [BTN:R1 ]\r\nper attirarlo a te.",
  "MENU_HELP_TXT_238_01": "I corni di unicorno sono\r\ningredienti da mischiare purificati\r\nin un cristallo rosso brillante.\r\nUsali per creare altri oggetti.",
  "MENU_HELP_TXT_207_01": "Gli archi rossi che trovi nella\r\nforesta rappresentano i Santuari,\r\npunti fondamentali per trovare\r\nla strada attraverso Avalon.",
  "MENU_HELP_TXT_022_01": "Crea un'onda d'urto che stordisce\r\ni nemici circostanti quando prendi\r\nin braccio Cheshire nella sua\r\nforma di animale di pezza.",
  "MENU_SKILLTREE_TXT_324": "Quando estendi Cheshire con [BTN:RS ]\r\npuoi deviare i proiettili nemici.",
  "MENU_SKILLTREE_TXT_420": "Cereza sale a cavallo di Cheshire,\r\nstabilizzando il suo potere\r\ndemonico con la propria magia.",
  "MENU_HELP_TXT_116_01": "Permette a Cheshire di sferrare\r\nun Attacco caricato vicino a nemici\r\nindeboliti per finirli tenendo\r\npremuto e rilasciando [BTN:R2 ].",
  "MENU_SKILLTREE_TXT_424": "In modalità Abbraccio, premi [BTN:R2 ] per\r\nfar colpire i nemici a Cheshire,\r\ndistraendoli per breve tempo.",
  "MENU_HELP_TXT_216_01": "Quando Cheshire è in forma di\r\ndemone, si può muovere in modo\r\nindipendente da Cereza. Questo\r\nprende il nome di \"modalità belva\".",
  "MENU_POSEMENU_DIALOG_TXT_03": "Perderai ogni progresso\r\nnon salvato. Vuoi tornare\r\nallo schermo del titolo?",
  "MENU_HELP_TXT_107_01": "Premi [BTN:Y ] per trasformarti in\r\nCheshire legno. In questa forma\r\nCheshire può allungare la lingua\r\ncon [BTN:R1 ].",
  "MENU_HELP_TXT_999_01": "???",
  "MENU_SKILLTREE_TXT_320": "Aumenta ulteriormente la velocità\r\ncon cui l'indicatore di ricarica\r\nmagica si riempie.",
  "MENU_HELP_TXT_109_03": "Cheshire acqua può anche nuotare,\r\nma attenzione: se passi a qualsiasi\r\naltra forma mentre è in acqua,\r\nCheshire torna alla forma acqua.",
  "MENU_SKILLTREE_TXT_328": "Premi [BTN:L1 ] in modalità abbraccio\r\naffinché Cereza infonda energia\r\nmagica in Cheshire, riempiendo\r\nla sua barra della magia in un attimo.",
  "MENU_HELP_TXT_103_01": "Cheshire ha la propria energia\r\nvitale. Quando la esaurisce, si\r\nritrasforma in animale di pezza\r\ne torna in braccio a Cereza.",
  "MENU_HELP_TXT_212_01": "Se premi [BTN:L1 ] presso gli specchi\r\nvicini alle lanterne, puoi\r\naccedere al menu Albero\r\ndelle tecniche.",
  "MENU_SKILLTREE_DIALOG_TXT_02": "Hai finito di fare pratica?",
  "MENU_HELP_TXT_112_01": "Cereza può usare il suo potere\r\nper placare la potenza demonica\r\ndi Cheshire e, in certe situazioni,\r\nsalirgli in groppa e cavalcarlo.",
  "MENU_HELP_TXT_249_02": "Se perdi l'orientamento, dirigiti\r\nverso le aree contrassegnate dalla\r\nzampa di lupo bianco. Potresti\r\ntrovare sue tracce nelle vicinanze.",
  "MENU_HELP_TXT_104_02": "Gli attacchi elementali possono\r\nanche avere effetti speciali, tra\r\ncui rimuovere le barriere nemiche.",
  "MENU_HELP_TXT_215_02": "In modalità abbraccio, puoi\r\nmuovere Cereza con [BTN:LS ] ed estendere\r\nCheshire con [BTN:RS ] per raggiungere\r\noggetti vicini.",
  "MENU_HELP_TXT_203_01": "Nel menu di stato puoi controllare\r\nle condizioni di Cereza e Cheshire,\r\ne anche gli oggetti in tuo possesso.",
  "MENU_HELP_TXT_026_01": "Quando usi Battito di strega,\r\ninclina rapidamente due volte\r\n[BTN:LS ] quando i due cerchi\r\nsi sovrappongono.",
  "MENU_SKILLTREE_TXT_413": "Premi rapidamente due volte [BTN:L1 ] per\r\nrichiamare all'istante Cheshire in\r\nmodalità abbraccio, travolgendo\r\ntutti i nemici lungo il tragitto.",
  "MENU_HELP_TXT_108_03": "Cheshire pietra ha una corazza\r\nesterna che lo rende invulnerabile\r\nalla maggior parte degli attacchi,\r\nma che consuma potere magico.",
  "MENU_HELP_TXT_102_01": "Premi [BTN:R2 ] per far sferrare\r\ndelle artigliate a Cheshire. È utile\r\nanche per liberare il sottobosco,\r\nrompere vasi e altri oggetti.",
  "MENU_HELP_TXT_221_03": "Dentro a un Tír na nÓg, premi [BTN:START ]\r\nper accedere a un menu dove puoi\r\nscegliere di uscire e tornare\r\nnella foresta.",
  "MENU_HELP_TXT_213_01": "Quando impari nuove tecniche,\r\npremi [BTN:SELECT ] per accedere a una sala\r\ndi pratica dove poterle provare.",
  "MENU_SKILLTREE_TXT_304": "Durante gli scontri, passa alla\r\nmodalità abbraccio per recuperare\r\ngradualmente il tuo potere magico.",
  "MENU_SKILLTREE_TXT_317": "Rallenta ulteriormente i movimenti\r\ndei nemici intrappolati da Legaccio\r\ndi rovi.",
  "MENU_HELP_TXT_009_02": "Bloccare i nemici in questo modo\r\nconsuma l'indicatore di ricarica\r\nmagica, che si rigenera a poco a\r\npoco o quando usi degli oggetti.",
  "MENU_HELP_TXT_113_01": "In modalità belva, Cheshire\r\npuò deviare attacchi con [BTN:R1 ].\r\nNel farlo, consuma potere magico.",
  "MENU_HELP_TXT_105_02": "Cheshire recupera il proprio\r\npotere magico quando è in\r\nmodalità abbraccio.",
  "MENU_HELP_TXT_027_01": "Certi nemici volanti sono molto\r\ndeboli e basta Legaccio di rovi\r\nper sconfiggerli.",
  "MENU_SKILLTREE_TXT_404": "Usa [BTN:R3 ] per schivare con Cheshire.",
  "MENU_SKILLTREE_TXT_417": "Con Cheshire pietra, alla fine di\r\nuna Combo legaccio puoi eseguire\r\nun Attacco elementale pietra.",
  "MENU_HELP_TXT_202_01": "Nella sezione della mappa puoi\r\nvedere tutto il mondo di gioco o la\r\nsingola area in cui ti trovi. Passa\r\nda una visuale all'altra con [BTN:Y ].",
  "MENU_HELP_TXT_023_01": "Aumenta il numero di oggetti\r\nche puoi tenere con te.",
  "MENU_HELP_TXT_206_01": "Premi [BTN:L1 ] vicino alle lanterne\r\nper accedere al menu Preparativi,\r\ndove tra le altre cose puoi\r\nsalvare la tua partita.",
  "MENU_HELP_TXT_210_02": "Per creare un oggetto, devi prima\r\ntrovarne un esemplare da usare\r\ncome riferimento. Tieni gli occhi\r\nbene aperti!",
  "MENU_CHALLENGE_TXT_12": "Scegli la Sfida a tempo del\r\nTír na nÓg che vuoi provare.",
  "MENU_CHALLENGE_TXT_01": "Cimentati di nuovo nei Tír na\r\nnÓg che hai già completato.",
  "MENU_SKILLTREE_TXT_308": "Mentre esegui Legaccio di rovi\r\nsu un nemico, i suoi movimenti\r\nsaranno rallentati.",
  "MENU_HELP_TXT_228_02": "Alcune porte richiedono un certo\r\nnumero di spiritelli per essere\r\naperte. Cerca altri spiritelli\r\nda aiutare nei paraggi.",
  "MENU_HELP_TXT_117_01": "Permette a Cheshire di recuperare\r\npotere magico quando elimina\r\ni nemici con Gnam!",
  "MENU_HELP_TXT_217_01": "Premi [BTN:L1 ] per passare alla modalità\r\nabbraccio, riportando Cheshire\r\nalla forma di animale di pezza.",
  "MENU_HELP_TXT_106_01": "Premi [BTN:L1 ] per assorbire sorgenti\r\nelementali nel tuo bracciale.\r\nRaccogline abbastanza e aumenterai\r\nla barra della magia di Cheshire.",
  "MENU_SKILLTREE_TXT_408": "Allunga Cheshire con [BTN:RS ]\r\nnella direzione in cui stai\r\nprocedendo per velocizzare\r\nun po' il tuo movimento.",
  "MENU_HELP_TXT_110_02": "Questo attacco può bruciare\r\ncerti oggetti e sciogliere il\r\nghiaccio. Cheshire fuoco può\r\nanche camminare tra le fiamme.",
  "MENU_HELP_TXT_210_01": "Nel menu Preparativi puoi usare\r\ningredienti per creare oggetti\r\nda usare poi nella tua avventura.",
  "MENU_SKILLTREE_TXT_318": "Intrappolando un nemico dopo certi\r\nattacchi, aumenterai la durata e i\r\ndanni inflitti da Legaccio di rovi.",
  "MENU_HELP_TXT_228_01": "Le porte degli spiritelli che\r\nincontri possono essere aperte\r\ncon l'aiuto degli spiritelli.",
  "MENU_CHALLENGE_TXT_11": "Scegli il Tír na nÓg che vuoi\r\nprovare di nuovo.",
  "MENU_CHALLENGE_TXT_02": "Prova diverse sfide a tempo.",
  "MENU_HELP_TXT_101_01": "Muovi Cheshire con [BTN:RS ]. Quando si\r\nmuove, Cheshire salta automaticamente\r\noltre piccoli scalini o bordi.\r\n",
  "MENU_HELP_TXT_128_01": "Permette a Cheshire di cambiare\r\nelementi senza interrompere la\r\ncombo. Si attiva con [BTN:A ], [BTN:B ], [BTN:X ] o [BTN:Y ]\r\ndurante un attacco o una schivata.",
  "MENU_HELP_TXT_217_02": "In modalità abbraccio, premi [BTN:R1 ]\r\nper evocare Cheshire in forma\r\ndi demone, passando alla\r\nmodalità belva.",
  "MENU_HELP_TXT_201_01": "Apri il menu con [BTN:START ]\r\ne naviga tra mappa, archivio,\r\nmenu di stato e sistema\r\ncon [BTN:L1 ] e [BTN:R1 ].",
  "MENU_HELP_TXT_024_01": "Aumenta l'efficacia\r\ndi tutti i miscugli.",
  "MENU_HELP_TXT_110_01": "Premi [BTN:A ] per trasformarti in\r\nCheshire fuoco. In questa forma,\r\nCheshire può eseguire Sputafuoco\r\nse premi [BTN:R1 ].",
  "MENU_SKILLTREE_TXT_418": "Elimina un nemico con Gnam!\r\nper recuperare un po' di\r\npotere magico.",
  "MENU_HELP_TXT_239_01": "I gechi cotti sono ingredienti\r\nda mischiare purificati in\r\nun cristallo giallo brillante.\r\nUsali per creare altri oggetti.",
  "MENU_SKILLTREE_TXT_510": "Aumenta l'area d'effetto\r\ndi Legaccio di rovi.",
  "MENU_HELP_TXT_018_01": "Permette di recuperare lentamente\r\npotere magico se sei in modalità\r\nabbraccio durante un combattimento.",
  "MENU_HELP_TXT_114_01": "Permette a Cheshire di sferrare\r\nun attacco aggiuntivo premendo\r\n[BTN:R2 ] dopo aver contrattaccato con\r\nsuccesso un nemico.",
  "MENU_SKILLTREE_TXT_403": "Tieni premuto e poi rilascia [BTN:R2 ]\r\nvicino a un nemico indebolito per\r\neseguire un Attacco caricato e\r\ndargli così il colpo di grazia.",
  "MENU_SKILLTREE_TXT_410": "Esegui un Attacco elementale\r\nlegno alla fine di una Combo\r\nlegaccio con Cheshire legno.",
  "MENU_HELP_TXT_205_01": "Nel menu di sistema puoi caricare\r\nun altro salvataggio, vedere i Consigli\r\ndi viaggio o modificare le opzioni.",
  "MENU_HELP_TXT_020_01": "Premi [BTN:L1 ] in modalità abbraccio\r\naffinché Cereza incanali energia\r\nmagica in Cheshire e riempia la sua\r\nbarra della magia in un attimo.",
  "MENU_SKILLTREE_TXT_314": "Raccogli Cheshire per creare\r\nuna piccola onda d'urto che\r\nstordisce i nemici.",
  "MENU_HELP_TXT_226_03": "Nella sezione Spiritelli salvati\r\ndell'Archivio puoi vedere gli\r\nspiritelli che hai aiutato.",
  "MENU_HELP_TXT_105_01": "La barra sopra Cheshire mostra\r\nil suo potere magico, che cala\r\nquando usa certe tecniche.",
  "MENU_SKILLTREE_TXT_303": "Tieni premuto [BTN:L2 ] per evocare dei\r\nrovi che intrappolano il nemico. Per\r\nrifarlo, devi aspettare che si riempia\r\nl'indicatore di ricarica magica.",
  "MENU_SKILLTREE_TXT_310": "Aumenta la capacità dell'indicatore\r\ndi ricarica magica, permettendo a\r\nCereza di eseguire Legaccio di rovi\r\nper due volte in rapida successione.",
  "MENU_HELP_TXT_009_01": "Tieni premuto [BTN:L2 ] vicino a un\r\nnemico per eseguire Legaccio di rovi\r\ne immobilizzarlo temporaneamente.",
  "MENU_HELP_TXT_248_01": "I tuoi progressi verranno salvati\r\nautomaticamente alle lanterne o\r\nin altri punti della storia. Tieni\r\nd'occhio l'icona in basso a destra.",
  "MENU_SKILLTREE_TXT_407": "Premi [BTN:R2 ] mentre schivi\r\nper eseguire un attacco in tuffo.",
  "MENU_SKILLTREE_TXT_414": "Cambia elemento con Cheshire\r\nmentre schivi o attacchi per\r\ntrasformarti senza interrompere\r\nla combo.",
  "MENU_HELP_TXT_202_02": "La nebbia che nasconde alcune parti\r\ndella mappa può essere fatta svanire\r\nsoddisfacendo certe condizioni.",
  "MENU_HELP_TXT_214_01": "Parla con Ignis per ritornare\r\nrapidamente a ogni Santuario\r\nche Cereza ha già visitato\r\nin precedenza.",
  "MENU_SKILLTREE_TXT_419": "Gli attacchi di Cheshire\r\ninfliggono più danni.",
  "MENU_HELP_TXT_225_01": "Usa [BTN:L1 ] per registrare ricordi\r\ndi luoghi memorabili che Cereza\r\ne Cheshire visitano durante\r\nla loro avventura.",
  "MENU_HELP_TXT_241_01": "Riempie l'indicatore di ricarica\r\nmagica e ti permette quindi di\r\nriutilizzare le Arti di Umbra più\r\nvelocemente.",
  "MENU_CHALLENGE_DIALOG_TXT_02": "Vuoi provare questo\r\nTír na nÓg?",
  "MENU_HELP_TXT_222_02": "Se non soddisfi le condizioni\r\ndi queste missioni, non potrai\r\ncompletare il Tír na nÓg.",
  "MENU_HELP_TXT_234_01": "Le rose d'onice sono fiori\r\noriginari delle profondità\r\ninfernali. Cereza ne ha bisogno\r\nper imparare nuove tecniche.",
  "MENU_HELP_TXT_250_01": "Certe volte, ad esempio in presenza\r\ndi rosmarino o se Cheshire è troppo\r\nlontano, Cereza non potrà richiamarlo\r\nin modalità abbraccio.",
  "MENU_HELP_TXT_011_01": "Aumenta il recupero di potere\r\nmagico dopo aver eseguito\r\ncon successo Legaccio di rovi\r\nsu un nemico.",
  "MENU_HELP_TXT_125_01": "Permette a Cheshire di eseguire\r\nun attacco in tuffo con [BTN:R2 ]\r\nquando schiva un attacco.",
  "MENU_HELP_TXT_029_01": "Il Battito di strega deve essere\r\neseguito con successo per più\r\nvolte di fila. Tieni premuto [BTN:L2 ]\r\nfino a quando non l'hai completato.",
  "MENU_HELP_TXT_208_01": "Salva i tuoi progressi nel menu\r\nPreparativi. Oltre ai salvataggi\r\nautomatici, è consigliabile salvare\r\nmanualmente di tanto in tanto.",
  "MENU_HELP_TXT_121_01": "Permette di cambiare l'ultimo\r\nattacco di una Combo legaccio\r\nin un attacco elementale pietra.",
  "MENU_SKILLTREE_TXT_406": "Se sferri un Attacco caricato\r\nsu un nemico che Cereza ha\r\nintrappolato, eseguirai una\r\npotente combo.",
  "MENU_SKILLTREE_TXT_415": "Permette a Cheshire di subire\r\npiù danni prima di ritrasformarsi\r\nin animale di pezza.",
  "MENU_HELP_TXT_230_01": "Salta sui grandi funghi con\r\nCheshire pietra per rimbalzare\r\nin alto e arrivare in aree\r\naltrimenti irraggiungibili.",
  "MENU_HELP_TXT_015_01": "Tieni premuto [BTN:L2 ] e ruota [BTN:LS ] vicino\r\na un oggetto rotto per riportarlo\r\ntemporaneamente alla condizione originale\r\ngrazie a Magia riparatrice di Cereza.",
  "MENU_HELP_TXT_119_01": "Permette di eseguire un potente\r\nattacco ad ampio raggio con [BTN:R2 ]\r\nal termine di una Combo legaccio.",
  "MENU_HELP_TXT_226_02": "Alcuni spiritelli ti faranno\r\ndelle richieste: aiutali e\r\npotresti ricevere in cambio\r\nqualcosa di utile.",
  "MENU_SKILLTREE_TXT_302": "Esegui Legaccio di rovi su un\r\nnemico per recuperare un po'\r\ndi potere magico.",
  "MENU_SKILLTREE_TXT_311": "Aumenta la velocità di recupero\r\ndi potere magico in modalità\r\nabbraccio.",
  "MENU_SKILLTREE_TXT_306": "Aumenta leggermente la velocità\r\ncon cui l'indicatore di ricarica\r\nmagica si riempie.",
  "MENU_SKILLTREE_TXT_315": "Ti permette di recuperare più\r\npotere magico dopo aver eseguito\r\nLegaccio di rovi con successo.",
  "MENU_HELP_TXT_130_01": "In modalità abbraccio, Cheshire\r\npuò sferrare un colpo al nemico\r\ncon [BTN:R2 ] per distrarlo brevemente.",
  "MENU_HELP_TXT_219_01": "Le impronte lasciate dal lupo\r\nbianco per tutta la foresta.\r\nAvvicinati a esse per rivelare\r\nil suo cammino.",
  "MENU_SKILLTREE_TXT_402": "Tieni premuto [BTN:R2 ] per caricare\r\ne poi rilascia per far eseguire a\r\nCheshire un potente attacco.",
  "MENU_HELP_TXT_108_01": "Premi [BTN:B ] per trasformarti in\r\nCheshire pietra. In questa forma,\r\nCheshire può effettuare potenti\r\nattacchi con [BTN:R1 ].",
  "MENU_SKILLTREE_TXT_411": "Usa [BTN:R2 ] per infliggere un attacco\r\naggiuntivo dopo un contrattacco.",
  "MENU_HELP_TXT_004_01": "Le icone a forma di fiore in basso\r\na sinistra mostrano l'energia\r\nvitale di Cereza, che cala se\r\nviene colpita dai nemici.",
  "MENU_HELP_TXT_245_01": "Profumo in un'ampolla a mezzaluna.\r\nTieni premuto [BTN:DP_R ] affinché Cheshire\r\ndisponga temporaneamente di potere\r\nmagico illimitato per le sue tecniche.",
  "MENU_HELP_TXT_221_01": "Le illusioni delle fate hanno origine\r\nnei cosiddetti Tír na nÓg, che puoi\r\ntrovare sparsi in tutta la foresta.",
  "MENU_SKILLTREE_TXT_405": "Permette a Cheshire di subire\r\nleggermente più danni prima di\r\nritrasformarsi in animale di pezza.",
  "MENU_SKILLTREE_TXT_416": "Con Cheshire acqua, alla fine di\r\nuna Combo legaccio puoi eseguire\r\nun Attacco elementale acqua.",
  "MENU_HELP_TXT_242_01": "Un cristallo imbevuto di potere\r\na forma di mezzaluna. Raccogline\r\nuno per recuperare un po' di potere\r\nmagico.",
  "MENU_HELP_TXT_226_01": "Troverai spiritelli intrappolati\r\nun po' ovunque. Quando ne\r\nincontri uno, liberalo con [BTN:L1 ].",
  "MENU_HELP_TXT_003_01": "Premi [BTN:L2 ] vicino a un obiettivo\r\ne poi inclina [BTN:LS ] nella direzione\r\ne nel momento giusti per eseguire\r\nBattito di strega di Cereza.",
  "MENU_SKILLTREE_TXT_301": "Tenendo premuto [BTN:L2 ], inclina [BTN:LS ]\r\nal momento giusto per infondere\r\ndi magia piante e altri oggetti.",
  "MENU_SKILLTREE_TXT_312": "Ti permette di tenere più oggetti.",
  "MENU_HELP_TXT_219_02": "Le impronte del lupo bianco\r\nguidano Cereza verso il suo\r\nprossimo obiettivo. Cercale\r\nquando ti perdi.",
  "MENU_HELP_TXT_126_01": "Premi [BTN:R1 ] appena prima che un attacco\r\nnemico vada a segno affinché\r\nCheshire passi alla modalità belva\r\ned esegua un contrattacco.",
  "MENU_HELP_TXT_004_02": "Quando l'energia vitale arriva\r\na zero, è game over. Tieni sempre\r\nd'occhio quanta energia vitale\r\nti resta!",
  "MENU_HELP_TXT_221_02": "Distruggi il nucleo al centro\r\ndi un Tír na nÓg per far svanire\r\nle illusioni da esso generate.",
  "MENU_HELP_TXT_012_01": "Aumenta la velocità di riempimento\r\ndell'indicatore di ricarica magica.",
  "MENU_HELP_TXT_237_01": "Le radici di mandragora sono\r\ningredienti da mischiare purificati\r\nin un cristallo verde brillante.\r\nUsale per creare altri oggetti.",
  "MENU_SKILLTREE_TXT_401": "Premi [BTN:R1 ] per far deviare\r\na Cheshire certi attacchi.",
  "MENU_HELP_TXT_108_02": "Questi colpi possono essere\r\nusati come attacco oppure per\r\nschiacciare, sollevare o ribaltare\r\ncerti oggetti.",
  "MENU_HELP_TXT_016_01": "Schiva un attacco all'ultimo istante\r\ncon [BTN:L1 ] per attivare il Sabbat\r\ntemporale e muoverti a velocità\r\nestrema per alcuni secondi.",
  "MENU_HELP_TXT_233_01": "Le gocce di Avalon sono dolci\r\ngocce di magia cristallizzate.\r\nCheshire ne ha bisogno per\r\nimparare nuove tecniche.",
  "MENU_SKILLTREE_TXT_409": "Premi [BTN:R2 ] al termine di una\r\nCombo legaccio per eseguire un\r\npotente attacco ad ampio raggio.",
  "MENU_CHALLENGE_DIALOG_TXT_01": "Vuoi usare degli oggetti per\r\nsbloccare questo Tír na nÓg?",
  "MENU_HELP_TXT_122_01": "Permette di cambiare l'ultimo\r\nattacco di una Combo legaccio\r\nin un attacco elementale acqua.",
  "MENU_HELP_TXT_250_02": "Controlla i dintorni e cerca un\r\nmodo per riunire Cereza e Cheshire.",
  "MENU_SKILLTREE_TXT_309": "Usa [BTN:L3 ] per schivare con Cereza.",
  "MENU_HELP_TXT_222_01": "Certi Tír na nÓg prevedono\r\ndelle missioni con condizioni\r\nspeciali da soddisfare.",
  "MENU_HELP_TXT_246_01": "Pozione in un'ampolla rivestita\r\ndi spine. Tieni premuto [BTN:DP_D ] per\r\ncreare un'onda d'urto che stordisce\r\ntutti i nemici circostanti.",
  "MENU_HELP_TXT_007_01": "In modalità abbraccio puoi lanciare\r\nCheshire con [BTN:L1 ] per farlo arrivare\r\na certi punti elevati. A volte\r\ndovrete separarvi per procedere.",
  "MENU_HELP_TXT_133_01": "Aumenta la potenza di tutti\r\ngli attacchi di Cheshire.",
  "MENU_HELP_TXT_232_01": "Cheshire può distruggere i nuclei\r\nelementali. Distruggi tutti quelli\r\nche incontri per completare\r\nla missione di Cereza.",
  "MENU_SKILLTREE_TXT_332": "Riempie l'indicatore di ricarica\r\nmagica al massimo, così Cereza\r\npuò usare Legaccio di rovi 4 volte\r\nin rapida successione.",
  "MENU_HELP_TXT_017_01": "Permette a Cereza di\r\nschivare con [BTN:L3 ].",
  "MENU_SKILLTREE_TXT_425": "A volte i nemici, se colpiti\r\ncon Soffice pugno, lasciano\r\ncadere degli oggetti.",
  "MENU_HELP_TXT_123_01": "Permette di cambiare l'ultimo\r\nattacco di una Combo legaccio\r\nin un attacco elementale fuoco.",
  "MENU_SKILLTREE_TXT_525": "Aumenta ulteriormente l'area\r\nd'effetto di Legaccio di rovi.",
  "MENU_SKILLTREE_TXT_532": "Aumenta ancora di più l'area\r\nd'effetto di Legaccio di rovi.",
  "MENU_HELP_TXT_010_02": "Morsa di rovi blocca i nemici\r\npiù a lungo e con più danni di\r\nLegaccio di rovi, così Cheshire\r\npuò eliminarli più rapidamente.",
  "MENU_HELP_TXT_006_01": "Premi [BTN:L2 ] per usare le Arti di\r\nUmbra. Se un obiettivo è abbastanza\r\nvicino, Cereza lo prenderà di mira\r\nautomaticamente.",
  "MENU_HELP_TXT_247_01": "Se ti perdi, cerca le luci guida\r\nsospese in giro per la foresta:\r\nti condurranno al Santuario più\r\nvicino.",
  "MENU_HELP_TXT_223_01": "In combattimento, alcune fate\r\nsi proteggono con delle barriere,\r\nsulle quali gli attacchi normali\r\nnon hanno effetto.",
  "MENU_SKILLTREE_TXT_421": "In modalità abbraccio, premi [BTN:R1 ]\r\ngiusto prima che un attacco nemico\r\nti colpisca per evocare Cheshire\r\ne fargli eseguire un contrattacco.",
  "MENU_HELP_TXT_132_01": "Aumenta l'energia vitale\r\ndi Cheshire.",
  "MENU_SKILLTREE_TXT_325": "Aumenta ulteriormente la capacità\r\ndell'indicatore di ricarica magica,\r\ncosì Cereza può usare Legaccio di\r\nrovi 3 volte in rapida successione.",
  "MENU_HELP_TXT_209_02": "In alcuni Tír na nÓg puoi anche\r\naffrontare le Sfide a tempo.\r\nCompletale per ottenere ricompense\r\na seconda della tua bravura.",
  "MENU_HELP_TXT_002_01": "Se premi [BTN:L1 ], Cereza può\r\ninteragire con vari oggetti.\r\n",
  "MENU_HELP_TXT_227_01": "Dopo aver salvato un certo numero\r\ndi spiritelli, visita Colm nel\r\nsuo rifugio e potresti ottenere\r\nuna ricompensa.",
  "MENU_HELP_TXT_243_01": "Medicina di Umbra in un'ampolla\r\na forma di petalo. Tieni premuto [BTN:DP_U ]\r\nper far recuperare a Cereza un po'\r\ndi energia vitale.",
  "MENU_HELP_TXT_127_01": "Cheshire torna in modalità abbraccio\r\nin un lampo, travolgendo qualsiasi\r\nnemico lungo il suo percorso quando\r\nsi preme [BTN:L1 ] due volte.",
  "MENU_SKILLTREE_TXT_329": "Ti permette di recuperare\r\nancora più potere magico dopo\r\naver eseguito Legaccio di rovi\r\ncon successo.",
  "MENU_HELP_TXT_236_01": "Le perle di luna sono cristalli\r\ndi puro potere magico che puoi\r\nusare per far imparare a Cereza\r\ntecniche particolarmente potenti.",
  "MENU_HELP_TXT_109_02": "Torrente ha una vasta\r\ngittata e può spingere diversi\r\noggetti nonché estinguere\r\nle fiamme.",
  "MENU_HELP_TXT_013_01": "Rallenta il movimento\r\ndi tutti i nemici su cui\r\nesegui Legaccio di rovi.",
  "MENU_HELP_TXT_209_01": "Nel menu Preparativi puoi riprovare\r\nogni Tír na nÓg già completato per\r\nottenere i tesori che potresti\r\naver lasciato indietro.",
  "MENU_HELP_TXT_120_01": "Permette di cambiare l'ultimo\r\nattacco di una Combo legaccio\r\nin un attacco elementale legno.",
  "MENU_HELP_TXT_014_01": "Aumenta la capacità dell'indicatore\r\ndi ricarica magica, così Cereza\r\npuò eseguire Legaccio di rovi per\r\ndue volte in rapida successione.",
  "MENU_HELP_TXT_112_03": "Può anche sferrare potenti attacchi\r\nelementali con [BTN:A ], [BTN:B ], [BTN:X ] o [BTN:Y ].",
  "MENU_HELP_TXT_231_01": "Premi [BTN:L1 ] per assorbire sorgenti\r\nelementali nel tuo bracciale.\r\nPuoi assorbire potere elementale\r\nda una sorgente solo una volta.",
  "MENU_HELP_TXT_118_01": "Permette di sferrare un Attacco\r\ncaricato in modalità belva premendo\r\n[BTN:R2 ] vicino a un nemico intrappolato.",
  "MENU_HELP_TXT_227_02": "Quando Colm ha qualcosa da dirti,\r\nsulla mappa apparirà il simbolo\r\ndegli spiritelli. A quel punto, vai\r\na fargli visita e parla con lui.",
  "MENU_HELP_TXT_131_01": "Fa cadere oggetti ai nemici\r\ncolpiti da Soffice pugno.",
  "MENU_HELP_TXT_218_01": "In modalità abbraccio, puoi\r\nafferrare le code di volpe con [BTN:RS ]\r\ne poi premere [BTN:L1 ] per spiccare\r\nun balzo.",
  "MENU_HELP_TXT_109_01": "Premi [BTN:X ] per trasformarti in\r\nCheshire acqua. In questa forma\r\nCheshire può sparare getti\r\nd'acqua con [BTN:R1 ].",
  "MENU_HELP_TXT_220_01": "Nelle distorsioni create dalle fate,\r\nCereza incontra molte illusioni.\r\nTieni premuto [BTN:L2 ] per evocare\r\nuna luce e rivelare oggetti nascosti.",
  "MENU_HELP_TXT_244_01": "Una pozione in un'ampolla a forma di\r\nfarfalla. Tieni premuto [BTN:DP_L ] per\r\nessere temporaneamente invincibile ed\r\neseguire le Arti di Umbra in meno tempo.",
  "MENU_HELP_TXT_005_01": "Con cinque petali della vitalità\r\no un solo bocciolo della vitalità\r\npuoi incrementare l'energia\r\nvitale totale di Cereza.",
  "MENU_HELP_TXT_240_01": "Raccogli 5 petali della vitalità\r\nper formare un bocciolo della\r\nvitalità e aumentare l'energia\r\nvitale massima di Cereza.\r\n",
  "MENU_HELP_TXT_224_01": "Raccogli i diari che trovi nella foresta\r\nper aggiungerli all'Archivio, dove\r\npotrai leggerli in seguito con calma.",
  "MENU_HELP_TXT_001_01": "Muovi Cereza con [BTN:LS ]. Quando si\r\nmuove, Cereza salta automaticamente\r\noltre piccoli scalini o bordi.\r\n",
  "MENU_SKILLTREE_TXT_331": "Schiva un attacco nemico\r\nall'ultimo momento con [BTN:L1 ] per\r\naumentare temporaneamente\r\nla tua percezione e velocità.",
  "MENU_SKILLTREE_TXT_322": "Aumenta l'efficacia\r\ndegli oggetti creati.",
  "MENU_HELP_TXT_135_01": "Premi [BTN:R1 ] per far saltare\r\nCheshire da luoghi di una certa\r\naltezza. Cerca i punti evidenziati\r\nin bianco.",
  "MENU_SKILLTREE_TXT_426": "Aumenta le probabilità che i nemici\r\ncolpiti con Soffice pugno lascino\r\ncadere oggetti; aumenta la varietà\r\ndegli oggetti lasciati cadere.",
  "MENU_HELP_TXT_216_03": "Se Cheshire si allontana\r\nda Cereza troppo a lungo,\r\npasseranno dei guai. Cerca\r\ndi tenerli sempre vicini.",
  "MENU_HELP_TXT_006_02": "L'indicatore di ricarica magica\r\ndi Cereza si consuma usando\r\nle Arti di Umbra, ma si rigenera\r\ngradualmente.",
  "MENU_HELP_TXT_223_02": "Per distruggere le barriere, prova\r\na usare gli attacchi elementali.\r\nOgni tipo di barriera è vulnerabile\r\na uno specifico elemento.",
  "MENU_SKILLTREE_TXT_422": "Permette a Cheshire di subire\r\nancora più danni prima di\r\nritrasformarsi in animale di pezza.",
  "MENU_HELP_TXT_010_01": "Alcuni nemici, se colpiti da certi\r\nattacchi, restano vulnerabili.\r\nIn tal caso, tieni premuto [BTN:L2 ]\r\nper eseguire Morsa di rovi.",
  "MENU_HELP_TXT_235_01": "I frutti infernali sono frutti speciali\r\nche puoi usare per far imparare\r\na Cheshire delle tecniche\r\nparticolarmente potenti.",
  "MENU_HELP_TXT_124_01": "Permette a Cheshire di schivare\r\ngli attacchi con [BTN:R3 ]\r\nin modalità belva.",
  "MENU_SKILLTREE_TXT_326": "Aumenta ulteriormente la velocità\r\ndi recupero di potere magico\r\nin modalità abbraccio.",
  "MENU_HELP_TXT_028_01": "Premi [BTN:L1 ] per far saltare\r\nCereza da luoghi di una certa\r\naltezza. Cerca i punti\r\nevidenziati in bianco."
}
