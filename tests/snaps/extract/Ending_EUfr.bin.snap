{
  "BK_7000_0100_NAR": "Cereza ignorait ce qu'il advenait\r\nde l'âme des fées dans ce monde\r\nchaotique, mais où que Lukaon aille,\r\nelle espérait qu'il y trouverait la paix.",
  "BK_7000_0080_LUC": "« Je suis heureux d'avoir pu revoir\r\nton visage... une dernière fois... »",
  "BK_7010_0030_CER": "« Ce portail te renverra\r\nen Enfer. »",
  "BK_7010_0120_NAR": "Le calme revint sur la forêt d'Avalon.\r\nComme pour laver la douleur de la\r\nnuit, les premiers rayons du soleil\r\nenveloppèrent Cereza, la baignant\r\nde leur douce chaleur.",
  "BK_7010_0040_CER": "« Dépêche-toi, avant qu'il ne se referme... »",
  "BK_7020_0000_CER": "« J'ai réussi, maman. Je suis une\r\nsorcière. Je suis forte, et je vais\r\ndevenir encore plus forte. Tu n'as\r\nplus besoin de t'inquiéter. »",
  "BK_7020_0030_CER": "« Maman ! »",
  "BK_7020_0040_ROS": "« Quelle sorcière remarquable\r\ntu es devenue, Cereza.\r\nTout ira bien pour toi... »",
  "BK_7000_0170_NAR": "Tel est le destin qui attend\r\ntoutes les sorcières de l'Umbra :\r\nune éternité d'errance dans les\r\nprofondeurs de l'Enfer.",
  "BK_7000_0090_MOR": "« Bonne nuit, mon enfant.\r\nFais de beaux rêves... »",
  "BK_7000_0030_NAR": "L'heure des adieux à\r\nLukaon approchait.",
  "SM_007020_0000_JEA": "« Tu vas pouvoir te débrouiller\r\nseule, maintenant, Cereza. »",
  "BK_7020_0060_NAR": "Des rencontres et des adieux...\r\nSongeant à la promesse qu'elle\r\navait faite à son ami, Cereza sut\r\nqu'elle avait gagné quelque chose\r\nd'irremplaçable.",
  "BK_7010_0020_NAR": "Le voyage avait épuisé le démon.\r\nPeinant à garder les yeux ouverts,\r\nil regardait pensivement le portail\r\nqui le ramènerait chez lui.",
  "BK_7000_0010_LUC": "« Cereza... Chouchou... »",
  "BK_7000_0020_LUC": "« Vous avez eu raison de\r\nstopper ma mère. C'est\r\nun honneur de vous avoir\r\nrencontrés. »",
  "BK_7010_0090_CER": "« Je vais devenir encore plus\r\nforte, promis ! »",
  "BK_7010_0010_NAR": "Mais le portail devenait déjà\r\ninstable. Il pouvait se refermer\r\nà tout instant.",
  "BK_7020_0050_NAR": "Dès lors, le cauchemar qui\r\navait régulièrement hanté\r\nCereza ne revint jamais.",
  "BK_7000_0050_LUC": "« Mais nous le sommes, Cereza.\r\nEt je t'en suis reconnaissant. »",
  "BK_7010_0045_NAR": "Chouchou regarda Cereza.\r\nSon visage exprimait ce qu'ils\r\npensaient tous deux.\r\n[FONT:9 ]Si je repars, tu seras seule.[FONT:N ]",
  "SM_007010_0000_JEA": "Je savais que tu réussirais.",
  "BK_7010_0100_NAR": "Un bruit assourdissant\r\nprovint du portail. Mais la\r\nvoix de Chouchou retentit\r\nà travers le fracas :\r\n[FONT:9 ]J'attendais rien de moins ![FONT:N ]",
  "BK_7020_0010_ROS": "« Cereza. »",
  "BK_7000_0040_CER": "« J'aurais aimé...\r\nqu'on devienne amis. »",
  "BK_7000_0150_NAR": "La fin de Morgana la sorcière\r\navait sonné.",
  "BK_7000_0175_NAR": "Cereza ne détourna pas le regard.\r\nElle regarda l'âme de Morgana se faire emporter en Enfer.",
  "BK_7000_0160_NAR": "Son expression paisible fit\r\nplace au supplice. C'en était\r\npresque trop douloureux à voir.",
  "BK_7010_0050_CER": "« Après tout ce qu'on a vécu ensemble,\r\ntu me traites encore comme un gamine ?\r\nTu verras, bientôt je serai assez forte\r\npour t'invoquer sans problème. »",
  "BK_7010_0060_CER": "« En attendant, repose-toi un peu, OK ? »",
  "BK_7020_0070_NAR": "La nuit avait à peine commencé...\r\nCereza repartit à l'aventure,\r\nla lune pâle lui éclairant le chemin.",
  "SM_007020_0010_CER": "« Jeanne... Merci.\r\nOn se reverra quand\r\ntout ça sera fini. »",
  "BK_7010_0000_NAR": "Chouchou réalisa que cet\r\névénement inattendu était une\r\naubaine pour lui : un portail vers\r\nl'Enfer était ouvert, là, devant lui.",
  "BK_7010_0110_CER": "« Et t'as intérêt à être\r\nsacrément féroce la\r\nprochaine fois ! »",
  "SM_007010_0010_JEA": "« Viens, allons-y ! »",
  "BK_7000_0060_NAR": "Mère et enfant se serraient\r\ntendrement dans les bras.\r\nIl avait tant de fois rêvé\r\nde cette douceur.",
  "BK_7010_0070_NAR": "Chouchou se retourna\r\ndoucement vers le portail.",
  "BK_7000_0070_LUC": "« Merci de toujours veiller sur\r\nmoi, mère. Tu peux te reposer,\r\nmaintenant... »"
}
