{
  "CE_005020_0000_CER": "Si tu n'arrêtes pas maintenant...\r\nje ne te le pardonnerai jamais !",
  "SM_005020_0210_FAS": "« Soyez prudents, tous les deux.\r\nQu'Avalon vous protège. »",
  "CE_005110_0000_CER": "Deux de repris, deux à reprendre !",
  "SM_005020_0020_CER": "« Ignis ! »",
  "CE_005820_0000_CER": "Calme-toi, tout va bien !",
  "BK_5010_0000_NAR": "Chouchou avait retrouvé la raison.\r\nMais son coup de folie lui avait\r\ncoûté très cher.",
  "BK_5000_0260_NAR": "Chouchou, fou de rage, se tourna vers Cereza.\r\nIl découvrit les crocs... et bondit !",
  "IN_5000_0010_CER": "« Tu as raison, Chouchou. On va lui\r\nmontrer de quoi on est capables ! »",
  "LV_005010_0020_NAR": "La voix calme de Chouchou emplit Cereza de courage.",
  "SM_005020_0060_FAS": "« Mais quand même...\r\nje suis impressionné que\r\ntu sois arrivée aussi loin. »",
  "BK_5000_0010_NAR": "Devant eux se tenait Púca,\r\nla fée grandiloquente. Il semblait\r\navoir été quelque peu roussi\r\npar l'explosion.",
  "LV_005010_0010_NAR": "[FONT:10 ]Bondis vite toutes griffes dehors.\r\nNe laisse aucune chance à la peur.[FONT:N ]",
  "BK_5000_0180_NAR": "Une fois encore, Chouchou\r\navait refusé l'offre de Púca.",
  "SM_005020_0050_FAS": "« J'ai juste fait mon devoir.\r\nJe te l'ai dit, c'est à moi qu'on\r\ns'adresse quand on a des\r\nquestions sur Avalon. »",
  "BK_5000_0100_CER": "« Chouchou ? »",
  "IN_5000_0020_CER": "« Un... Un ange ?!\r\nMais qu'est-ce qu'il fait là ? »",
  "BK_5000_0060_NAR": "Púca tentait de convaincre\r\nChouchou en lui offrant de le\r\nrenvoyer dans l'Enfer. Avait-il\r\nréellement le pouvoir d'ouvrir\r\nun portail sur-le-champ ?",
  "LV_005905_0000_CER": "Tu te sens mieux, Chouchou ?\r\nTu as encore mal ?",
  "_01": "",
  "SM_005020_0180_FAS": "« Je crois que c'est la raison qui\r\nt'a amenée dans cette forêt. »",
  "BK_5000_0170_POO": "« Oh, l'esclave en peluche !\r\nLe petit chaton à sa maman ! »",
  "LV_005905_0030_CER": "Ça fait plaisir à entendre.",
  "CE_005010_0000_CER": "Lukaon, arrête tout de suite !",
  "CE_005120_0000_CER": "Et de trois ! Bien !",
  "SM_005010_0020_CER": "« Je le sens... Lukaon n'est plus\r\ntrès loin. J'en suis certaine ! »",
  "BK_5010_0040_NAR": "Chouchou ne répondit pas.\r\nÉpuisé, il ferma les yeux.",
  "CE_005805_0010_NAR": "Chouchou était en furie. Il ne répondait\r\nque par des feulements sauvages.",
  "CE_005810_0000_CER": "Je tiendrai pas très longtemps... Mais je\r\nlaisserai pas Chouchou dans cet état !",
  "BK_5010_0010_CER": "« Chouchou... Pourquoi tu\r\nn'as pas utilisé le portail ? »",
  "CE_005835_0000_CER": "Chouchou... arrête !",
  "LV_005015_0000_NAR": "Un vent glacial soufflait sans trêve.\r\nMais la chaleur régnait dans leurs cœurs.",
  "CE_005090_0000_CER": "Je vais reprendre ce que\r\ntu as volé à Chouchou.",
  "CE_005050_0000_CER": "Si seulement je pouvais\r\nstopper cette machine...",
  "BK_5000_0110_NAR": "Chouchou se dirigeait\r\nlentement vers le portail.",
  "BK_5000_0030_POO": "« Nous n'avons pas de mots pour toi,\r\npetite. Ton compatriote infernal,\r\nen revanche, nous doit une réponse\r\nquant à notre... proposition. »",
  "CE_005830_0000_NAR": "[FONT:10 ]Fuis... vite...[FONT:N ]\r\nChouchou reprit le contrôle un instant,\r\njuste assez pour prononcer ces mots.",
  "CE_005825_0010_CER": "C'était juste !",
  "LV_005010_0000_CER": "Je n'ai pas peur.\r\nTu es prêt, Chouchou ?",
  "SM_005020_0150_FAS": "« Voilà pourquoi j'attendais...\r\nquelqu'un qui nous sortirait\r\nde ce mauvais rêve. »",
  "BK_5000_0000_POO": "« Halte-là ! »",
  "BK_5000_0120_NAR": "Alors qu'il s'approchait du seuil,\r\nCereza fut envahie par les\r\nsouvenirs de leur aventure.",
  "BK_5000_0190_POO": "« Ainsi soit-il ! Mais l'Enfer réclame\r\nson dû, alors si tu refuses d'y\r\nretourner, c'est cette vile sorcière\r\nqui ira à ta place ! »",
  "SM_005020_0110_FAS": "« Vois-tu... »",
  "LV_005905_0020_NAR": "Mais Cereza aurait pu jurer\r\navoir entendu un ronronnement\r\nténu dans sa voix.",
  "CE_005060_0000_CER": "Plus qu'un...\r\nTiens bon, Chouchou !",
  "BK_5000_0070_POO": "« Eh bien, démon ? Une fois déjà, tu as\r\neu l'audace de rejeter notre généreuse\r\noffre. Changeras-tu de refrain lorsque les\r\nflammes de l'enfer te roussiront le poil ? »",
  "SM_005020_0080_FAS": "« Tu as peut-être raison.\r\nLa prochaine fois, c'est moi\r\nqui te demanderai le chemin ! »",
  "LV_005020_0000_CER": "Allons-y, Chouchou !",
  "CE_005150_0000_CER": "Personne ne me prendra Chouchou !\r\nN'y songe même pas !",
  "CE_005815_0010_CER": "Tiens bon, Chouchou !",
  "LV_005905_0010_NAR": "[FONT:10 ]Ça va très bien.[FONT:N ]\r\nChouchou n'ajouta rien d'autre.",
  "SM_005020_0120_FAS": "« Je vis déjà depuis bien longtemps\r\ndans la forêt d'Avalon. C'était jadis\r\nun lieu enchanteur et accueillant. »",
  "LV_005910_0000_CER": "Aaaaah !",
  "BK_5000_0040_POO": "« Il subit depuis trop longtemps \r\nle joug du despotisme de cette\r\nchétive sorcière.\r\n\r\nLibère-toi d'elle ! Et de nos mains\r\nnous ouvrirons un portail vers l'Enfer,\r\npour toi ! »",
  "CE_005805_0000_CER": "Chouchou, tu es là-dedans ?\r\nTu me reconnais pas ?",
  "SM_005020_0160_CER": "« Ignis, étais-tu... »",
  "CE_005190_0000_CER": "Alleeeez, Chouchou !!!",
  "SM_005010_0030_NAR": "Quelque chose disait à Cereza que\r\nsi elle s'aventurait plus loin, elle ne\r\npourrait plus faire demi-tour.",
  "SM_005010_0000_NAR": "Ils étaient à nouveau dans la forêt.\r\nUn nouveau chemin apparut\r\ndevant eux.",
  "LV_005005_0020_CER": "Le cœur de la forêt...\r\nLà où Lukaon nous attend.",
  "CE_005030_0000_CER": "Si l'explosion m'atteint,\r\nc'en sera fini de moi...",
  "IN_5000_0000_CER": "« Encore ? Attends, quelque\r\nchose n'est pas pareil... »",
  "CE_005100_0000_CER": "OK, un élément récupéré !",
  "IN_5000_0030_CER": "« Tu as raison, Chouchou. On va lui\r\nmontrer de quoi on est capables ! »",
  "LV_005005_0010_CER": "Je vois... Ça doit être une entrée...",
  "IN_5010_0010_CER": "« Tu es prêt, Chouchou ?\r\nMoi, je ne suis pas sûre... »",
  "SM_005020_0190_CER": "« Tu veux dire... Lukaon ? »",
  "SM_005020_0200_FAS": "« Vas-y. Le sceau de\r\nl'autel a été brisé. »",
  "SM_005010_0040_CER": "« On y est presque, Chouchou.\r\nQuand tu seras prêt,\r\nfinissons-en. »",
  "BK_5000_0240_NAR": "Et puis...",
  "BK_5010_0020_NAR": "[FONT:9 ]Je fais pas confiance à ce cinglé.[FONT:N ]\r\nRépondit Chouchou\r\navant de se détourner.",
  "CE_005820_0010_CER": "Ne t'inquiète pas. Je suis là pour toi.",
  "LV_005900_0010_NAR": "Chouchou souffla d'agacement.\r\n[FONT:10 ]Je suis sûr qu'il va montrer son\r\nsale museau d'ici peu.[FONT:N ]",
  "BK_5010_0060_NAR": "Cereza lui chanta une berceuse\r\nqu'elle avait entendue petite.",
  "SM_005020_0040_CER": "« Sans toi, Ignis, ça n'aurait pas\r\nété possible ! Tes conseils nous\r\nont vraiment aidés. »",
  "SM_005020_0070_CER": "« On l'a tellement explorée, cette\r\nforêt, qu'on la connaît sûrement\r\nmieux que toi, maintenant. »",
  "BK_5000_0230_NAR": "Púca ignora la question de Cereza,\r\ntrop occupé à follement glousser.",
  "CE_005000_0000_CER": "Chouchou !\r\nArrête, Lukaon ! Rends-le-moi !",
  "CE_005130_0000_CER": "Et... quatre ! On a repris tout ce\r\nque tu as volé, Lukaon !",
  "SM_005020_0030_FAS": "« Bravo, tu as réussi à détruire les\r\nquatre noyaux élémentaires. Tu as\r\nmis les fées dans un de ces états ! »",
  "SM_005020_0000_FAS": "« Tu as enfin réussi, petite. »",
  "CE_005800_0000_CER": "Chouchou...",
  "CE_005825_0000_CER": "Ahh !",
  "BK_5000_0090_NAR": "Dans un crépitement flamboyant,\r\nla fée ouvrit un immense portail\r\nembrasé. Cereza pouvait sentir la\r\nchaleur qui en émanait. Les sons\r\nfamiliers de la forêt se mêlaient\r\naux hurlements des damnés.",
  "LV_005005_0000_NAR": "Les noyaux élémentaires ayant été détruits,\r\nla barrière créée par les fées avait disparu.",
  "SM_005020_0140_FAS": "« Elles ont corrompu la forêt et\r\nterrorisé ses résidents. Je les ai\r\nvues faire des choses horribles,\r\net j'étais totalement impuissant. »",
  "CE_005080_0000_CER": "Oh non, courons !",
  "SM_005020_0155_FAS": "« Je l'aurais fait moi-même,\r\nsi j'étais encore... »",
  "BK_5000_0020_CER": "« Tiens donc, le souverain autoproclamé\r\nde ces bois. Qu'est-ce qu'il y a encore ? »",
  "SM_005020_0170_FAS": "« Pardon, je me suis laissé emporter.\r\nSi tu continues, tu trouveras ce que\r\nles fées se sont efforcées de te\r\ncacher à tout prix. »",
  "CE_005040_0000_CER": "Heureusement que j'ai\r\nma magie !",
  "LV_005015_0010_NAR": "Ensemble, ils pouvaient tout surmonter.\r\nEt ce sentiment fit rayonner leurs cœurs\r\nplus fort encore qu'un soleil.",
  "CE_005170_0000_CER": "Gnah !",
  "BK_5010_0030_CER": "« Ça veut dire... que tu\r\nme fais confiance ? »",
  "BK_5000_0250_CER": "« Chouchou ? Qu'est-ce qu'il y a ? »",
  "SM_005020_0100_CER": "« Attendu... pourquoi ? »",
  "SM_005020_0010_NAR": "Une voix était transportée par les arbres.\r\nC'était l'un des rares sons de cette forêt\r\nqui pouvait apaiser le cœur de Cereza.",
  "IN_5010_0000_NAR": "Passé ce point, plus\r\nde retour possible.",
  "CE_005070_0000_CER": "Chouchouuuu !",
  "BK_5000_0220_CER": "« Qu'est-ce que tu lui as fait ?! »",
  "CE_005805_0020_CER": "Que faire... Je peux peut-être\r\nl'aider avec ma magie ?",
  "SM_005010_0010_NAR": "Il semblait appeler Cereza, comme\r\nsi une force étrange l'attirait.",
  "LV_005900_0000_CER": "Tu crois que le loup blanc va bien ?",
  "CE_005180_0000_CER": "Gnnnagh !",
  "CE_005815_0000_CER": "Maintenant !",
  "SM_005020_0090_FAS": "« J'ai attendu longtemps la venue\r\nde quelqu'un comme toi, petite. »",
  "SM_005020_0130_FAS": "« Mais les fées ont tout chamboulé. »"
}
