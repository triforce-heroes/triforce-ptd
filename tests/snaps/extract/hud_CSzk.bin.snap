{
  "HUD_PURPOSE_TXT_6020": "阻止莱卡翁",
  "HUD_INTERACT_TEXT_0036_CER": "唔……嗯……\r\n这里实在太暗了，看不清啊……",
  "HUD_NOTICE_TXT_04": "已登录人魂！",
  "HUD_PURPOSE_TXT_4010": "前往妖精要塞",
  "HUD_INTERACT_TEXT_0039_CER": "曼陀罗……已经没有了。\r\n一不当心它们很快就会长出来。",
  "HUD_GAMEOVER_TXT_0007": "瑟蕾莎功亏一篑，败给了妖精。\r\n白狼的尸骸倒在她的身旁，\r\n与她相依相伴。",
  "HUD_INTERACT_TEXT_0009_CER": "啊，发现可爱的小鱼了。\r\n要是能快点长大就好了，呵呵。",
  "HUD_GAMEOVER_TXT_0003": "瑟蕾莎被妖精抓住了，\r\n她被挂在妖精乐园之塔塔顶，\r\n在风吹雨淋下渐渐化作枯骨。",
  "HUD_GAMEOVER_TXT_0010": "在妖精们的哄堂大笑中，\r\n瑟蕾莎和小柴猫被神奇的力量\r\n弹出了提尔纳诺。",
  "HUD_PURPOSE_TXT_1030": "加速前进",
  "HUD_PURPOSE_TXT_1130": "两人一起在森林里前进",
  "HUD_INTERACT_TEXT_0013_CER": "等我从森林回来后，\r\n要记得添点灯油。",
  "HUD_INTERACT_TEXT_0301_CER": "铁铸的……妖精玩偶？\r\n这也是马戏团的用品吗？",
  "HUD_INTERACT_TEXT_0006_CER": "水壶看起来也很旧了，\r\n能不能换一个更轻便的水壶呢？",
  "HUD_PREVENT_TEXT_0005_CER": "必、必须阻止那家伙才行！\r\n鼓起勇气上吧，瑟蕾莎！",
  "HUD_INTERACT_TEXT_0402_CER": "哎呀……\r\n这个转来转去的东西已经坏了，真可惜。",
  "HUD_INTERACT_TEXT_0404_CER": "附近的树木都枯死了……\r\n一定是妖精的建筑物害的。",
  "HUD_PREVENT_TEXT_0003_CER": "有妖精在看守……\r\n要是走这边会被发现的。",
  "HUD_PURPOSE_TXT_1091": "前往北边的广场",
  "HUD_INTERACT_TEXT_0000_CER": "这是摩根娜的家。\r\n现在回去会被她批评的。",
  "HUD_PURPOSE_TXT_7000": "打倒被拘束的敌人！",
  "HUD_INTERACT_TEXT_0307_CER": "不会吧……走进死胡同了……？\r\n再不想想办法，那家伙又要……",
  "HUD_ITEMOBTAIN_TEXT_006": "用矿石保存处理的魔女调制素材。\r\n因为它们动不动就会大声尖叫，\r\n最好放到行李的深处保管。",
  "HUD_PURPOSE_TXT_5030": "在被埋没的圣地前进",
  "HUD_ITEMOBTAIN_TEXT_002": "这是森林魔力的结晶。\r\n尝过一次便会被那\r\n浸透心脾的浓厚香甜味道所俘获。",
  "HUD_ITEMOBTAIN_TEXT_011": "装在尖刺药瓶里的魔女秘传毒药。\r\n使用它可以激起冲击波，使敌人昏迷。\r\n获得后即可在调制中制作！",
  "HUD_ITEMOBTAIN_TEXT_102": "命樱花瓣聚合而成的大块宝石。\r\n据说它坚固到能承受任何冲击，\r\n拥有它的人必将长命百岁。",
  "HUD_PURPOSE_TXT_7004": "打倒屏障护身的敌人！",
  "HUD_PURPOSE_TXT_2020": "寻找进入妖精乐园之塔的方法",
  "HUD_PURPOSE_TXT_1195": "前往马戏团帐篷",
  "HUD_INTERACT_TEXT_0030_CER": "现在是我期待已久的训练时间！\r\n还没到回家的时候！",
  "HUD_PURPOSE_TXT_1081": "用荆棘束缚捕捉香草",
  "HUD_ITEMOBTAIN_TEXT_005": "蕴含月光之力的圆形宝石。\r\n月光之力是魔女的力量之源，\r\n会给得到它的魔女带来成长。",
  "HUD_INTERACT_TEXT_0101_CER": "嗯，空气好清新～！\r\n感觉可以在这里休息一下！",
  "HUD_PURPOSE_TXT_5020": "跟着狼加速前往莱卡翁所在地",
  "HUD_GAMEOVER_TXT_0008": "人魂们还在不停求救。\r\n然而瑟蕾莎已经倒下，\r\n没有人可以拯救他们了。",
  "HUD_PURPOSE_TXT_7003": "越过咒障并打倒敌人！",
  "HUD_INTERACT_TEXT_0209_CER": "是一架破破烂烂的秋千。\r\n要是有人能修一下……\r\n不过在这片森林里也没法修吧。",
  "HUD_INTERACT_TEXT_0223_CER": "表演节目居然会用到人魂吗！？\r\n太残忍了……！",
  "HUD_ITEMOBTAIN_TEXT_101": "小巧美丽的花瓣形宝石。\r\n是森林生命力的结晶，\r\n多收集一些可以提升持有者的体力。",
  "HUD_ITEMOBTAIN_TEXT_012": "装在花瓣造型药瓶里的魔女秘传药水。\r\n使用后能让瑟蕾莎回复少量体力。\r\n获得后即可在调制中制作！",
  "HUD_PURPOSE_TXT_2030": "在妖精乐园之塔里前进",
  "HUD_PURPOSE_TXT_6030": "和莱卡翁谈谈",
  "HUD_PURPOSE_TXT_4100": "跟着狼前往莱卡翁的所在地",
  "HUD_GAMEOVER_TXT_0004": "瑟蕾莎筋疲力尽，沉到了阴暗的水底，\r\n再也没有浮上来。\r\n只有鱼儿们知道她的结局。",
  "HUD_ITEMOBTAIN_TEXT_009": "装在蝴蝶造型药瓶里的魔女秘传药水。\r\n使用它即可使瑟蕾莎暂时保持无敌状态，\r\n缩短使用魔导术的间隔时间。\r\n获得后即可在调制中制作！",
  "HUD_PURPOSE_TXT_1120": "寻找回到魔界的路",
  "HUD_PURPOSE_TXT_3010": "与龙形怪物战斗",
  "HUD_INTERACT_TEXT_0900_CER": "这扇门上有跷跷板。\r\n正好是人魂可以坐上去的大小……",
  "HUD_INTERACT_TEXT_0107_CER": "这、这是什么……！？\r\n已经……没办法回去了……！？",
  "HUD_PURPOSE_TXT_1020": "与贞德一起加速前进",
  "HUD_NOTICE_TXT_03": "已登录记录档案！",
  "HUD_INTERACT_TEXT_0108_CER": "看来是不想让我从这座森林回去啊……",
  "HUD_INTERACT_TEXT_0214_CER": "居然就这么乱扔别人的通缉令！\r\n拜托爱惜一点好吗！",
  "HUD_INTERACT_TEXT_0106_CER": "好大的湖……！\r\n嗯，那边好像……有东西堵住了……？",
  "HUD_INTERACT_TEXT_0901_CER": "1、2、3……看来要有3个人魂\r\n才能打开这扇门……",
  "HUD_GAMEOVER_TXT_1004": "嘶啦……嘎吱嘎吱，咕嘟。\r\n过了一会儿，悲痛的哭喊声\r\n响彻了刚刚恢复安静的森林。",
  "HUD_INTERACT_TEXT_0201_CER": "这里的木板都腐朽了啊……！？\r\n呜呜，希望不会掉下去……",
  "HUD_MAPCL_B_10": "两人摧毁了纯白树干的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_03": "两人摧毁了新叶庭园的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_ITEMRECIPE_TEXT_009": "装在蝴蝶造型药瓶里的魔女秘传药水。\r\n使用它即可使瑟蕾莎暂时保持无敌状态，\r\n缩短使用魔导术的间隔时间。",
  "HUD_PURPOSE_TXT_2010": "独自救助人魂",
  "HUD_MAPCL_B_14": "两人摧毁了封印之地的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_07": "两人摧毁了寒风大树的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_A_08": "两人成功突破了大地的水瓶的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_ITEMOBTAIN_TEXT_021": "蝴蝶形的淡紫色水滴。\r\n摄入它可以提高注意力，\r\n缩短使用魔导术的间隔时间。",
  "HUD_MAPCL_A_00": "两人成功突破了未知地点的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_13": "两人成功突破了被遗忘的山丘的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_PURPOSE_TXT_4020": "独自前往妖精要塞",
  "HUD_ITEMRECIPE_TEXT_012": "装在花瓣造型药瓶里的魔女秘传药水。\r\n把它喷洒在周围可以立即生效，\r\n让瑟蕾莎回复少量体力。",
  "HUD_PURPOSE_TXT_6010": "从莱卡翁手中夺回小柴猫",
  "HUD_MAPCL_B_18": "两人摧毁了普卡的要塞的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_PURPOSE_TXT_1100": "前往阿瓦隆森林",
  "HUD_STATUSUP_TEXT_202": "吸收的魔力充满魔导器，\r\n并向瑟蕾莎体内流去——！",
  "HUD_INTERACT_TEXT_0208_CER": "好陈旧啊。\r\n看来应该放在这里很久了。",
  "HUD_MAPCL_A_04": "两人成功突破了妮姆薇湖的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_17": "两人成功突破了枯木森林的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_INTERACT_TEXT_0212_CER": "这难道是我和小柴猫！？\r\n讨厌……倒是画得漂亮点呀！",
  "HUD_MAPCL_A_03": "两人成功突破了新叶庭园的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_10": "两人成功突破了纯白树干的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_INTERACT_TEXT_0031_CER": "夜深了，\r\n还是不要去镇上了。",
  "HUD_PURPOSE_TXT_4030": "追上小柴猫",
  "HUD_ITEMRECIPE_TEXT_011": "装在尖刺药瓶里的魔女秘传毒药。\r\n把它喷洒在周围可以与空气中的魔力结合，\r\n激起冲击波，使敌人昏迷。",
  "HUD_MAPCL_B_08": "两人摧毁了大地的水瓶的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_INTERACT_TEXT_0001_CER": "这是通往镇上的门。\r\n可我不想去镇上。",
  "HUD_PREVENT_TEXT_0002_CER": "不行，现在得专心做交代我去办的事。\r\n不然又要挨批了！",
  "HUD_INTERACT_TEXT_0309_CER": "所有笼子都破破烂烂的……\r\n好像有什么人在这里大闹过一场……",
  "HUD_INTERACT_TEXT_0405_CER": "到处都是火、火、火……\r\n烤得我浑身是汗……",
  "HUD_MAPCL_A_07": "两人成功突破了寒风大树的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_14": "两人成功突破了封印之地的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_PURPOSE_TXT_1010": "前进",
  "HUD_PURPOSE_TXT_1110": "在森林里小心前进",
  "HUD_STATUSUP_TEXT_201": "命樱之花发出夺目的光芒，\r\n体内渐渐充满力量——！",
  "HUD_INTERACT_TEXT_0014_CER": "哇，好多虫子……！？\r\n都别过来～！",
  "HUD_PURPOSE_TXT_3020": "抽干湖水",
  "HUD_INTERACT_TEXT_0300_CER": "哇，全是灰尘……\r\n这大概是那只妖精的仓库吧。",
  "HUD_INTERACT_TEXT_0012_CER": "要不要先对蜡烛许个愿呢？\r\n愿我能在森林里实现梦想！",
  "HUD_INTERACT_TEXT_0008_CER": "嗯，风景真美……！\r\n就这么休息一会儿……现在可不行！",
  "HUD_PURPOSE_TXT_5010": "安抚发狂的小柴猫",
  "HUD_MAPCL_B_13": "两人摧毁了被遗忘的山丘的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_00": "两人摧毁了未知地点的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_PREVENT_TEXT_0004_CER": "不该走这条路。\r\n现在得去追白狼才行！",
  "HUD_INTERACT_TEXT_0007_CER": "我的课本居然在这里！\r\n之后得赶紧悄悄收起来。",
  "HUD_GAMEOVER_TXT_1003": "伟大的普卡打倒了碍事的家伙。\r\n再也没有人能阻止他了。\r\n普卡统一世界的日子即将到来。",
  "HUD_PURPOSE_TXT_2100": "前往大树所在地",
  "HUD_MAPCL_B_17": "两人摧毁了枯木森林的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_04": "两人摧毁了妮姆薇湖的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_INTERACT_TEXT_0037_CER": "摩根娜的家……\r\n晚上看起来有点吓人……",
  "HUD_ITEMOBTAIN_TEXT_022": "蕴含力量的新月形水晶。\r\n原本只能在魔界获得。\r\n服用它可以让体内充满魔力。",
  "HUD_INTERACT_TEXT_0038_CER": "天这么黑，万一踩空就惨了！\r\n一定要离池塘远点……",
  "HUD_MAPCL_A_18": "两人成功突破了普卡的要塞的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_PURPOSE_TXT_2050": "在魔女藏身处休息一下",
  "HUD_INTERACT_TEXT_0401_CER": "荷叶帮了我很多忙呢，\r\n又是让我当船用又是让我站在上面。",
  "HUD_GAMEOVER_TXT_2001": "耗尽力气的贞德灵魂消散，\r\n森林里只剩下两个玩偶\r\n躺在无人知晓的地方。",
  "HUD_MAPCL_A_06": "两人成功突破了流光广场的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_15": "两人成功突破了被埋没的圣地的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_PREVENT_TEXT_0006_CER": "有些在意门的那边有什么。\r\n过去看看吧，小柴猫。",
  "HUD_INTERACT_TEXT_0010_CER": "摩根娜。\r\n我去去就回。",
  "HUD_INTERACT_TEXT_0302_CER": "这台卷线器比我还大。\r\n究竟是用来卷什么的呢？",
  "HUD_MAPCL_B_09": "两人摧毁了飞龙湖畔的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_INTERACT_TEXT_0020_CER": "摩根娜会不会珍惜\r\n我送给她的紫罗兰呢……",
  "HUD_ITEMRECIPE_TEXT_010": "装在新月造型药瓶里的魔女秘传香水。\r\n它发出的香气能让恶魔兴奋，\r\n能让小柴猫暂时不会消耗魔力。",
  "HUD_MAPCL_A_02": "两人成功突破了翠绿乐园的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_11": "两人成功突破了妖精乐园之塔的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_INTERACT_TEXT_0035_CER": "打水，搬水……\r\n这真的算训练吗……",
  "HUD_INTERACT_TEXT_0033_CER": "灯又脏了，不过天这么黑，\r\n摩根娜应该看不出来吧。",
  "HUD_INTERACT_TEXT_0029_CER": "哇，黏糊糊的……！\r\n都粘在手上了……",
  "HUD_FORESTGUIDE_TEXT_001": "温暖的光芒指引瑟蕾莎\r\n前往魔女藏身处——！",
  "HUD_PURPOSE_TXT_4090": "离开要塞，在森林里前进",
  "HUD_PURPOSE_TXT_1140": "帮助瑟蕾莎",
  "HUD_PURPOSE_TXT_2012": "两个人一起去救助人魂",
  "HUD_PURPOSE_TXT_3070": "寻找最后的元素核心",
  "HUD_MAPCL_B_16": "两人摧毁了妖精王的祭坛的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_05": "两人摧毁了日光海滩的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_GAMEOVER_TXT_1002": "贾巴沃克吃掉了瑟蕾莎，\r\n但这点量不够它填饱肚子，\r\n于是便飞向天空继续觅食。",
  "HUD_PURPOSE_TXT_1040": "去找摩根娜",
  "HUD_GAMEOVER_TXT_1006": "摩根娜和莱卡翁终于得以重逢。\r\n这对历经千辛万苦的亲子可以\r\n永远幸福地生活在一起了。",
  "HUD_PURPOSE_TXT_2105": "在寒风大树上前进",
  "HUD_INTERACT_TEXT_0304_CER": "摇摇晃晃的植物……\r\n看久了总感觉有点头晕……",
  "HUD_INTERACT_TEXT_0016_CER": "呵呵，我事先悄悄储满了水！\r\n这样摩根娜也不用犯愁了！",
  "HUD_MAPCL_B_12": "两人摧毁了监视哨塔的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_01": "两人摧毁了诱惑之路的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_PURPOSE_TXT_4060": "在要塞中前进并寻找狼",
  "HUD_PREVENT_TEXT_0000_CER": "我得赶紧去见摩根娜。\r\n也不知道会受什么样的惩罚！",
  "HUD_INTERACT_TEXT_0003_CER": "灯具好重，清洁起来好辛苦。\r\n唉，又脏了啊……",
  "HUD_INTERACT_TEXT_0407_CER": "转啊转啊转啊转啊……\r\n一直盯着看头都晕了……",
  "HUD_INTERACT_TEXT_0019_CER": "这么晚了，\r\n鱼儿也都睡了吗？",
  "HUD_PURPOSE_TXT_4080": "破坏最后的元素核心",
  "HUD_MAPCL_A_09": "两人成功突破了飞龙湖畔的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_GAMEOVER_TXT_1001": "马戏团得到了瑟蕾莎这个稀罕玩意儿，\r\n博得了妖精们的热烈喝彩。\r\n“本场演出绝不弄虚作假。”",
  "HUD_PURPOSE_TXT_1050": "去东边的井边打水",
  "HUD_PURPOSE_TXT_8000": "突破提尔纳诺！",
  "HUD_INTERACT_TEXT_0220_CER": "这个笼子仔细一看破破烂烂的。\r\n是因为没用了所以被扔掉了吧。",
  "HUD_PURPOSE_TXT_1150": "两人一起在森林里前进",
  "HUD_PURPOSE_TXT_2011": "救助被抓走的人魂",
  "HUD_PURPOSE_TXT_3060": "破坏第3个元素核心",
  "HUD_MAPCL_B_15": "两人摧毁了被埋没的圣地的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_06": "两人摧毁了流光广场的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_11": "两人摧毁了妖精乐园之塔的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_MAPCL_B_02": "两人摧毁了翠绿乐园的所有提尔纳诺！\r\n笼罩在这一带的诡异气息悉数消散，\r\n可以看清这片区域的事物了。",
  "HUD_GAMEOVER_TXT_1005": "莱卡翁终于夺回了肉体与力量。\r\n他背负着众多生命的的代价，\r\n下定决心作为妖精王统治森林。",
  "HUD_PURPOSE_TXT_6040": "骑上小柴猫逃出森林",
  "HUD_PURPOSE_TXT_4070": "打倒亲和",
  "HUD_MAPCL_A_05": "两人成功突破了日光海滩的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_16": "两人成功突破了妖精王的祭坛的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_INTERACT_TEXT_0219_CER": "那条滑梯真是长得夸张……\r\n光是想想就觉得屁股发烫……",
  "HUD_PURPOSE_TXT_2040": "跟上人魂",
  "HUD_INTERACT_TEXT_0203_CER": "嗯，上面好像刻着什么……\r\n“捉拿所有闯入森林的人类！”……？",
  "HUD_INTERACT_TEXT_0104_CER": "那、那是什么！\r\n那也是妖精干的好事吗……！？",
  "HUD_INTERACT_TEXT_0216_CER": "呼……呼……\r\n跑得那么快是要运输什么东西啊……？",
  "HUD_INTERACT_TEXT_0500_CER": "到处都冻得结结实实。\r\n身体也要冻僵了……",
  "HUD_MAPCL_A_01": "两人成功突破了诱惑之路的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_MAPCL_A_12": "两人成功突破了监视哨塔的提尔纳诺！\r\n看样子，\r\n这个区域好像还有其他的提尔纳诺。",
  "HUD_PURPOSE_TXT_1070": "前往南边的香草田",
  "HUD_PURPOSE_TXT_1170": "逃出提尔纳诺",
  "HUD_PURPOSE_TXT_3040": "寻找第3个元素核心",
  "HUD_PURPOSE_TXT_6060": "迎战摩根娜",
  "HUD_GAMEOVER_TXT_0009": "瑟蕾莎的灵魂在要塞里被捉住，\r\n妖精们把它投进炉火焚烧，\r\n并称赞它能让火烧得很旺。",
  "HUD_PURPOSE_TXT_7002": "在无伤状态下打倒敌人！",
  "HUD_ITEMOBTAIN_TEXT_004": "产自魔界的水果，有着不祥的外形。\r\n只在魔力强大的地方少量生长。\r\n营养丰富，味道像地狱一样甜腻。",
  "HUD_PURPOSE_TXT_4050": "避开妖精们前进",
  "HUD_INTERACT_TEXT_0218_CER": "“本马戏团非常欢迎人类！”\r\n为什么要特意把人类写出来呢……",
  "HUD_PURPOSE_TXT_1180": "追上狼，\r\n寻找元素核心",
  "HUD_PURPOSE_TXT_1080": "用魔导术让香草生长",
  "HUD_INTERACT_TEXT_0217_CER": "“不世出的天才阿玛丹·杜布！\r\n欢迎来到大帐篷见证奇迹！”……？",
  "HUD_INTERACT_TEXT_0105_CER": "哇……！\r\n打湿了的草地好滑啊！",
  "HUD_NOTICE_TXT_02": "已解锁魔女藏身处！",
  "HUD_INTERACT_TEXT_0211_CER": "这是……坟墓？\r\n究竟是谁的坟墓呢……",
  "HUD_PURPOSE_TXT_9000": "在森林里探索",
  "HUD_GAMEOVER_TXT_0001": "瑟蕾莎在阿瓦隆森林里耗尽了力气。\r\n她在神隐森林里失去了下落，\r\n最后被所有人遗忘。",
  "HUD_PURPOSE_TXT_2060": "前往马戏团",
  "HUD_PURPOSE_TXT_2090": "寻找第3个元素核心",
  "HUD_ITEMOBTAIN_TEXT_008": "用矿石保存处理的魔女调制素材。\r\n掰下独角兽的角后得到的东西。\r\n如果造型修长优美，亦可用于观赏。",
  "HUD_GAMEOVER_TXT_0005": "瑟蕾莎在普卡的要塞不支倒地。\r\n她的身体化作结晶，\r\n被悄悄地丢弃在要塞一角。",
  "HUD_INTERACT_TEXT_0017_CER": "只要去森林里就能成为强大的魔女嘛，\r\n我已经不需要什么课本了！",
  "HUD_NOTICE_TXT_01": "已解锁地图！",
  "HUD_PURPOSE_TXT_2070": "打倒阿玛丹·杜布",
  "HUD_INTERACT_TEXT_0018_CER": "我暂时见不到这里的景色了，\r\n可为了妈妈，我愿意做任何事！",
  "HUD_INTERACT_TEXT_0406_CER": "盖了一座这么大的建筑物，\r\n这里一定很重要……",
  "HUD_GAMEOVER_TXT_0002": "瑟蕾莎在幽深的森林里失去了生命。\r\n她化作结晶，被落叶覆盖，\r\n最终归于森林大地。",
  "HUD_INTERACT_TEXT_0002_CER": "每次看到这块岩石都觉得它像牙齿一样。\r\n地面下说不定埋着一只大怪物！",
  "HUD_INTERACT_TEXT_0310_CER": "看来之前有人一边看着我们\r\n一边悠闲地喝茶呢……",
  "HUD_GAMEOVER_TXT_0006": "瑟蕾莎的命运迎来了尽头，\r\n她在妖精打造的空间里\r\n度过了与永恒同等长久的时间。",
  "HUD_PURPOSE_TXT_2080": "破坏第2个元素核心",
  "HUD_PURPOSE_TXT_1160": "追上狼",
  "HUD_PURPOSE_TXT_3050": "打倒贾巴沃克",
  "HUD_PURPOSE_TXT_1060": "把井水交给摩根娜",
  "HUD_INTERACT_TEXT_0021_CER": "居然有这么高……！？\r\n万一掉下去……呜呜……",
  "HUD_INTERACT_TEXT_0034_CER": "夜晚的灯光真漂亮啊……\r\n我可以一直就这么看下去。",
  "HUD_ITEMOBTAIN_TEXT_003": "开在魔界的黑蔷薇花瓣。\r\n自身带有少量的魔力，\r\n据说很受妖精喜爱。",
  "HUD_ITEMOBTAIN_TEXT_010": "装在新月造型药瓶里的魔女秘传香水。\r\n使用它可以让小柴猫暂时不会消耗魔力。\r\n获得后即可在调制中制作！",
  "HUD_ITEMOBTAIN_TEXT_007": "用矿石保存处理的魔女调制素材。\r\n用合适的火候烤制蝾螈而成，\r\n不同的火候可以造就不同品质的素材。",
  "HUD_PURPOSE_TXT_4040": "和狼一起寻找小柴猫",
  "HUD_PREVENT_TEXT_0007_CER": "可不能在这里退缩。\r\n哪怕是为了柯尔姆，\r\n也要努力一把……！",
  "HUD_INTERACT_TEXT_0004_CER": "这盏灯是摩根娜选的吗？\r\n呵呵，我们的喜好可能差不多！",
  "HUD_INTERACT_TEXT_0400_CER": "湖在我眼里根本不算什么，\r\n我一点也不怕……",
  "HUD_PURPOSE_TXT_7001": "在限制时间内打倒敌人！",
  "HUD_PURPOSE_TXT_1090": "把香草交给摩根娜",
  "HUD_PREVENT_TEXT_0008_CER": "啊，我忘了拿回香草篮子。\r\n可不能两手空空地回去见摩根娜……",
  "HUD_INTERACT_TEXT_0011_CER": "我要去的不是镇上，\r\n是阿瓦隆森林！",
  "HUD_PURPOSE_TXT_1190": "寻找第2个元素核心"
}
