{
  "TUT_TUTORIAL_TEXT_ph048": "Ramasser",
  "TUT_TUTORIAL_TEXT_ph015": "Saut sétaire",
  "TUT_TUTORIAL_TEXT_ph006": "Attraper",
  "TUT_TUTORIAL_TEXT_w282": "Lors des défis temporels,\r\ntu obtiens des récompenses\r\nselon ta performance. Tente-les\r\njusqu'à les obtenir toutes !",
  "TUT_TUTORIAL_TEXT_ph011": "Se déplacer (Cereza)",
  "TUT_TUTORIAL_TEXT_ph002": "Sauter",
  "TUT_TUTORIAL_TEXT_w165": "Dans la distorsion, utilise ta\r\nmagie avec [BTN:L2 ] pour dissiper\r\nl'illusion qui entoure les fées\r\nafin de pouvoir les attaquer.",
  "TUT_TUTORIAL_TEXT_w561": "Lorsque Colm a quelque chose\r\nà te dire, un symbole en forme\r\nde wisp s'affiche sur la carte.\r\nFais-y bien attention !",
  "TUT_TUTORIAL_TEXT_g001": "Le menu des tenues a été débloqué.",
  "TUT_TUTORIAL_TEXT_ch029": "Glisser",
  "TUT_TUTORIAL_TEXT_w461": "Appuie sur [BTN:R1 ] au bon\r\nmoment pour que Chouchou\r\ncontre une attaque.",
  "TUT_TUTORIAL_TEXT_ph044": "(Maintenir/relâcher) Multi-entrave",
  "TUT_TUTORIAL_TEXT_w330": "Tu as détruit le noyau élémentaire\r\nde la pierre et reçu son pouvoir !\r\nAppuie sur [BTN:B ] pour\r\ninvoquer Chouchou pierre.",
  "TUT_TUTORIAL_TEXT_w323": "Les techniques élémentaires\r\nutilisent la magie de Chouchou.\r\nSurveille la jauge au-dessus de sa tête et\r\npasse en mode peluche pour la remplir.",
  "TUT_TUTORIAL_TEXT_ch021": "Forme normale",
  "TUT_TUTORIAL_TEXT_ch032": "Esquiver",
  "TUT_TUTORIAL_TEXT_w030": "Les pétales en bas à gauche de\r\nl'écran représentent la jauge de\r\nvitalité de Cereza. Ils tomberont\r\nsi un ennemi attaque Cereza.",
  "TUT_TUTORIAL_TEXT_w023": "Pulsation suprême. Quand un\r\ndouble cercle apparaît, incline\r\ndeux fois rapidement [BTN:LS ]\r\ndans la bonne direction !",
  "TUT_TUTORIAL_TEXT_w130": "Des feuillets de journal sont\r\néparpillés dans la forêt. Si tu\r\nen ramasses un avec [BTN:L1 ], tu\r\npeux le lire dans les archives.",
  "TUT_TUTORIAL_TEXT_ph019": "Absorber l'énergie du feu",
  "TUT_TUTORIAL_TEXT_d002": "Choisis un sanctuaire que tu as déjà visité.",
  "TUT_TUTORIAL_TEXT_w430": "Interagis avec une source\r\nélémentaire de l'eau pour\r\nabsorber son énergie et changer\r\nle niveau d'eau de la zone.",
  "TUT_TUTORIAL_TEXT_ch025": "Contrer",
  "TUT_TUTORIAL_TEXT_w630": "Chouchou peut désormais\r\neffectuer une attaque chargée\r\npour éliminer les ennemis\r\naffaiblis avec [BTN:R2 ].",
  "TUT_TUTORIAL_TEXT_ph040": "Apprendre la technique",
  "TUT_TUTORIAL_TEXT_w730": "Quand elle chevauche Chouchou\r\net le stabilise avec son énergie\r\nmagique, Cereza peut contrôler\r\nsa puissance démoniaque.",
  "TUT_TUTORIAL_TEXT_ch022": "Forme normale",
  "TUT_TUTORIAL_TEXT_ch031": "(Maintenir/relâcher) Combo d'entrave",
  "TUT_TUTORIAL_TEXT_ph047": "(Incliner deux fois) Pulsation",
  "TUT_TUTORIAL_TEXT_w333": "Le pilonnage de Chouchou pierre\r\npermet de débusquer les ennemis\r\ncachés et d'envoyer des ondes\r\nde choc étourdissantes. Essaie-le !",
  "TUT_TUTORIAL_TEXT_w320": "Tu as détruit le noyau élémentaire\r\ndu bois et reçu son pouvoir !\r\nAppuie sur [BTN:Y ] pour\r\ninvoquer Chouchou bois.",
  "TUT_TUTORIAL_TEXT_w120": "Les arches rouges indiquent les\r\nsanctuaires. Prends toujours le\r\ntemps de les déverrouiller en\r\nt'en approchant. ",
  "TUT_TUTORIAL_TEXT_ph009": "(Maintenir) Danser",
  "TUT_TUTORIAL_TEXT_w020": "Fais pousser les plantes\r\ninfernales avec Pulsation :\r\nmaintiens [BTN:L2 ] et incline [BTN:LS ] dans\r\nla bonne direction au bon moment.",
  "TUT_TUTORIAL_TEXT_d001": "Ignis peut guider Cereza aux sanctuaires.",
  "TUT_TUTORIAL_TEXT_w024": "Pulsation est un art de l'Umbra\r\nfondamental qui se base sur la\r\ndanse pour imprégner sa cible\r\nd'énergie magique.",
  "TUT_TUTORIAL_TEXT_w420": "Aucun lac ni cours d'eau\r\nn'arrête Chouchou eau.\r\nAvec [BTN:RS ], il nagera\r\navec grâce à la surface.",
  "TUT_TUTORIAL_TEXT_ph050": "(Maintenir) Entraver l'ennemi suivant",
  "TUT_TUTORIAL_TEXT_ph043": "(Maintenir) Entrave roncière",
  "TUT_TUTORIAL_TEXT_w720": "Les défis temporels te\r\npermettent d'essayer de\r\nbattre ton meilleur temps !",
  "TUT_TUTORIAL_TEXT_ch026": "(Maintenir) Tirer",
  "TUT_TUTORIAL_TEXT_w171": "Trouve et détruis le noyau au cœur\r\ndes tír na nÓg. Appuie sur [BTN:START ]\r\npour ouvrir le menu si tu as\r\nbesoin de te retirer un instant.",
  "TUT_TUTORIAL_TEXT_ph016": "Absorber l'énergie du bois",
  "TUT_TUTORIAL_TEXT_ph005": "Monter/descendre (échelle)",
  "TUT_TUTORIAL_TEXT_ph012": "(Maintenir) Entrave roncière",
  "TUT_TUTORIAL_TEXT_ph001": "Sauter (d'un rebord)",
  "TUT_TUTORIAL_TEXT_w281": "Tu peux relever les défis\r\ntemporels des tír na nÓg,\r\nen tentant de réaliser le\r\nmeilleur temps possible.",
  "TUT_TUTORIAL_TEXT_w081": "Lorsque Cereza porte Chouchou,\r\nutilise [BTN:LS ] pour te déplacer,\r\net [BTN:RS ] pour tendre Chouchou.",
  "TUT_TUTORIAL_TEXT_w462": "Les ennemis contrés seront\r\ntemporairement étourdis.\r\nAttention : certaines attaques\r\nne peuvent pas être contrées.",
  "TUT_TUTORIAL_TEXT_w100": "Tu peux à tout instant choisir de\r\nte déplacer en duo ou séparément.\r\nChaque mode possède ses\r\navantages selon la situation.",
  "TUT_TUTORIAL_TEXT_ph029": "Détruire le noyau",
  "TUT_TUTORIAL_TEXT_w000": "Cereza peut examiner\r\ndiverses choses avec [BTN:L1 ].\r\nSi quelque chose attire\r\nton attention, utilise [BTN:L1 ] !",
  "TUT_TUTORIAL_TEXT_e009": "Et que la concoction commence !",
  "TUT_TUTORIAL_TEXT_ch011": "Nager",
  "TUT_TUTORIAL_TEXT_ch002": "Sauter (incliner vers un rebord)",
  "TUT_TUTORIAL_TEXT_w300": "Choisis un emplacement pour\r\ngarder une trace de ton histoire.\r\nLa sauvegarde automatique s'effectue\r\nsur un emplacement séparé.",
  "TUT_TUTORIAL_TEXT_w700": "Maintiens et relâche [BTN:R2 ]\r\nprès d'un ennemi entravé pour\r\nlancer une puissante attaque.",
  "TUT_TUTORIAL_TEXT_ch015": "Pilonnage",
  "TUT_TUTORIAL_TEXT_ch006": "Se déplacer (Chouchou)",
  "TUT_TUTORIAL_TEXT_w400": "Au bon moment, esquive avec [BTN:L1 ]\r\npour activer l'Envoûtement, qui permet\r\nde se déplacer très vite un court instant.\r\nSers-toi de ce pouvoir pour battre Morgana !",
  "TUT_TUTORIAL_TEXT_b002": "Chouchou a besoin\r\nde dragées d'Avalon.",
  "TUT_TUTORIAL_TEXT_ph025": "Transformation (feu)",
  "TUT_TUTORIAL_TEXT_ph036": "Absorber l'énergie de l'eau",
  "TUT_TUTORIAL_TEXT_w351": "Avec [BTN:R1 ], Chouchou feu\r\npeut utiliser Souffle de feu.\r\nCette attaque peut brûler ou\r\nfaire fondre ses cibles.",
  "TUT_TUTORIAL_TEXT_e005": "Voici quelques ingrédients.\r\nIl y en a d'autres dans la forêt.",
  "TUT_TUTORIAL_TEXT_w051": "Ils ne peuvent pas rester\r\ntrop loin l'un de l'autre très\r\nlongtemps. Alors surveille\r\nleur distance.",
  "TUT_TUTORIAL_TEXT_ch019": "Transformation (feu)",
  "TUT_TUTORIAL_TEXT_e012": "Utilise les objets concoctés en maintenant [BTN:DP ].",
  "TUT_TUTORIAL_TEXT_e001": "Tu peux désormais préparer des concoctions.",
  "TUT_TUTORIAL_TEXT_ph032": "Mode démon",
  "TUT_TUTORIAL_TEXT_w900": "Jeanne peut aussi utiliser Entrave roncière\r\navec [BTN:L2 ]. Sa version impacte une\r\nlarge zone et les ennemis y sont tous\r\nentravés simultanément.",
  "TUT_TUTORIAL_TEXT_w751": "Certains fruits infernaux\r\nsont indiqués sur la carte.\r\nD'autres peuvent apparaître\r\nen terminant un tír na nÓg.",
  "TUT_TUTORIAL_TEXT_w651": "L'utilisation successive\r\nd'Entrave roncière permet\r\nà Cereza d'entraver deux\r\nennemis en même temps.",
  "TUT_TUTORIAL_TEXT_b006": "Cereza a besoin\r\nde roses d'onyx.",
  "TUT_TUTORIAL_TEXT_ph026": "(Maintenir) Joug roncier",
  "TUT_TUTORIAL_TEXT_ph035": "Lancer le wisp",
  "TUT_TUTORIAL_TEXT_b001": "Les techniques de Chouchou\r\nse trouvent à droite.",
  "TUT_TUTORIAL_TEXT_e006": "Ceci est un objet. Pour apprendre à\r\nle concocter, tu dois t'en procurer un.",
  "TUT_TUTORIAL_TEXT_w141": "Tu rencontreras parfois des\r\nwisps soucieux. Aide-les à\r\nrésoudre leurs problèmes, tu\r\npourrais ne pas le regretter !",
  "TUT_TUTORIAL_TEXT_w441": "Chaque type de barrière a un point\r\nfaible spécifique. Une onde de choc\r\ndevrait être efficace contre les\r\nbarrières d'élément pierre.",
  "TUT_TUTORIAL_TEXT_e011": "Et voilà !",
  "TUT_TUTORIAL_TEXT_e002": "Sélectionne Concoctions\r\ndans le menu...",
  "TUT_TUTORIAL_TEXT_b005": "Les techniques de Cereza\r\nse trouvent à gauche.",
  "TUT_TUTORIAL_TEXT_ph022": "Transformation (bois)",
  "TUT_TUTORIAL_TEXT_ph031": "Tendre Chouchou",
  "TUT_TUTORIAL_TEXT_w910": "Son sort nécessite un long temps\r\nde régénération, mais l'effet est\r\ndévastateur quand il est utilisé\r\ncontre un large groupe.",
  "TUT_TUTORIAL_TEXT_w752": "Des objets cachés dans la forêt\r\npermettent à Cereza d'apprendre\r\nde nouvelles techniques. Utilise\r\nla carte pour tous les trouver !",
  "TUT_TUTORIAL_TEXT_w010": "Lors de ton voyage, utilise [BTN:L1 ] près des\r\nlanternes pour sauvegarder ta progression.",
  "TUT_TUTORIAL_TEXT_ph039": "Dissiper l'illusion",
  "TUT_TUTORIAL_TEXT_w310": "Appuie sur [BTN:L1 ] pour absorber\r\nl'énergie élémentaire de la\r\nforêt dans le bracelet\r\nmagique de Cereza.",
  "TUT_TUTORIAL_TEXT_ch012": "Torrent aqua",
  "TUT_TUTORIAL_TEXT_ch001": "Attaquer",
  "TUT_TUTORIAL_TEXT_ch016": "Transformation (bois)",
  "TUT_TUTORIAL_TEXT_ch005": "Taillader",
  "TUT_TUTORIAL_TEXT_w710": "Utilise des objets avec [BTN:DP ] :\r\nils peuvent changer l'issue du\r\ncombat, alors si tu en possèdes,\r\nutilise-les !",
  "TUT_TUTORIAL_TEXT_w510": "Essaie de guider les wisps dans\r\nle tír na nÓg. Attention, s'ils se\r\nfont toucher, ce sera fini.",
  "TUT_TUTORIAL_TEXT_f001": "Le menu des tír na nÓg a été débloqué.",
  "TUT_TUTORIAL_TEXT_w410": "Après certaines attaques ennemies,\r\nun symbole apparaît au-dessus de leur tête :\r\nc'est le moment d'utiliser [BTN:L2 ] afin de\r\nréaliser une entrave plus puissante !",
  "TUT_TUTORIAL_TEXT_ph023": "Transformation (pierre)",
  "TUT_TUTORIAL_TEXT_ph030": "Se déplacer (Cereza)",
  "TUT_TUTORIAL_TEXT_w740": "Cereza n'est à ce stade pas en\r\nmesure de vaincre un ennemi seule.\r\nUtilise les arts de l'Umbra pour\r\nentraver les ennemis et avancer.",
  "TUT_TUTORIAL_TEXT_w640": "Maintiens et relâche [BTN:R2 ] pour\r\nlancer une attaque chargée près\r\nd'un ennemi entravé, et Chouchou\r\neffectuera un puissant combo.",
  "TUT_TUTORIAL_TEXT_b004": "et maintiens le bouton pour\r\napprendre cette technique.",
  "TUT_TUTORIAL_TEXT_w440": "Certaines fées sont protégées\r\npar des barrières élémentaires\r\nsur lesquelles la plupart des\r\nattaques n'ont aucun effet.",
  "TUT_TUTORIAL_TEXT_ch008": "(Maintenir) Tirer",
  "TUT_TUTORIAL_TEXT_e010": "Ajoute les ingrédients,\r\npuis mélange le tout !",
  "TUT_TUTORIAL_TEXT_e003": "pour fabriquer tes propres objets.",
  "TUT_TUTORIAL_TEXT_w140": "Des wisps sont séquestrés par\r\nles fées partout dans Avalon.\r\nLorsque tu en trouves un,\r\nlibère-le avec [BTN:L1 ].",
  "TUT_TUTORIAL_TEXT_w040": "Avec ses griffes et ses crocs\r\nacérés, le démon se joue des\r\nfées. Taillade avec [BTN:R2 ] et\r\ndéchaîne ton infernale férocité !",
  "TUT_TUTORIAL_TEXT_e007": "Essayons de concocter un spray curatif.",
  "TUT_TUTORIAL_TEXT_b000": "Ici, Cereza et Chouchou peuvent apprendre des techniques.",
  "TUT_TUTORIAL_TEXT_ph027": "(Maintenir) Danser",
  "TUT_TUTORIAL_TEXT_ph034": "Porter le wisp",
  "TUT_TUTORIAL_TEXT_w340": "Tu as détruit le noyau élémentaire\r\nde l'eau et reçu son pouvoir !\r\nAppuie sur [BTN:X ] pour\r\ninvoquer Chouchou eau.",
  "TUT_TUTORIAL_TEXT_w411": "Avec Joug roncier, les ennemis\r\nsont entravés plus longtemps et\r\nsubissent plus de dégâts. Teste\r\nce nouveau pouvoir !",
  "TUT_TUTORIAL_TEXT_w511": "Les wisps sont très faibles.\r\nIls ne peuvent survivre à\r\naucune attaque. Guide-les\r\navec prudence !",
  "TUT_TUTORIAL_TEXT_ch017": "Transformation (pierre)",
  "TUT_TUTORIAL_TEXT_ch004": "Contrer",
  "TUT_TUTORIAL_TEXT_ch013": "Torrent aqua",
  "TUT_TUTORIAL_TEXT_ch000": "Se déplacer",
  "TUT_TUTORIAL_TEXT_w311": "Une fois que le bracelet a absorbé\r\nassez d'énergie, la jauge de magie\r\naugmente.",
  "TUT_TUTORIAL_TEXT_w102": "En mode peluche, Cereza se déplace\r\nen portant Chouchou. Lorsqu'ils sont\r\nséparés, appuie sur [BTN:L1 ] pour\r\npasser au mode peluche.",
  "TUT_TUTORIAL_TEXT_ph038": "Détruire le noyau élémentaire",
  "TUT_TUTORIAL_TEXT_w011": "Le jeu sauvegarde automatiquement\r\nà différents moments de l'histoire.\r\nL'icône en bas à droite de l'écran\r\napparaîtra pour l'indiquer.",
  "TUT_TUTORIAL_TEXT_ch014": "Souffle de feu",
  "TUT_TUTORIAL_TEXT_ch007": "Taillader",
  "TUT_TUTORIAL_TEXT_e008": "Sélectionne combien tu\r\nveux en concocter...",
  "TUT_TUTORIAL_TEXT_ch010": "Pilonnage",
  "TUT_TUTORIAL_TEXT_ch003": "Sauter",
  "TUT_TUTORIAL_TEXT_w101": "Chouchou peut se déplacer\r\nséparément en mode démon.\r\nAppuie sur [BTN:R1 ] quand tu le\r\nportes pour qu'il descende.",
  "TUT_TUTORIAL_TEXT_ph028": "(Incliner) Pulsation",
  "TUT_TUTORIAL_TEXT_w650": "La jauge de régénération de Cereza\r\na augmenté, ce qui lui permet de lancer\r\ndeux Entraves roncières à la suite !",
  "TUT_TUTORIAL_TEXT_b007": "Essaie les différentes techniques disponibles !",
  "TUT_TUTORIAL_TEXT_ph020": "(Pivoter) Magie restauratrice",
  "TUT_TUTORIAL_TEXT_ph033": "Mode peluche",
  "TUT_TUTORIAL_TEXT_w750": "Dévorer des fruits infernaux\r\npermet à Chouchou d'apprendre\r\nde puissantes techniques.",
  "TUT_TUTORIAL_TEXT_w550": "Si tu t'égares, cherche les\r\nlumières conductrices, elles\r\nte guideront vers le sanctuaire\r\nle plus proche.",
  "TUT_TUTORIAL_TEXT_w450": "La jauge de magie se remplit\r\nprogressivement en mode\r\npeluche. Utilise ce mode\r\npour récupérer de la magie.",
  "TUT_TUTORIAL_TEXT_ch018": "Transformation (eau)",
  "TUT_TUTORIAL_TEXT_e013": "Avec [BTN:Y ], tu peux vérifier quel objet tu obtiendras.",
  "TUT_TUTORIAL_TEXT_e004": "Voici le menu des concoctions.",
  "TUT_TUTORIAL_TEXT_w050": "Cereza et Chouchou peuvent\r\nse déplacer séparément.\r\nDéplace Cereza avec [BTN:LS ]\r\net Chouchou avec [BTN:RS ].",
  "TUT_TUTORIAL_TEXT_ph024": "Transformation (eau)",
  "TUT_TUTORIAL_TEXT_ph037": "Mode peluche (récupérer de la magie)",
  "TUT_TUTORIAL_TEXT_w343": "Chouchou eau peut utiliser\r\nTorrent aqua avec [BTN:R1 ].\r\nAvec sa puissance et sa portée,\r\ncette technique est très versatile !",
  "TUT_TUTORIAL_TEXT_w350": "Tu as détruit le noyau élémentaire\r\ndu feu et reçu son pouvoir !\r\nAppuie sur [BTN:A ] pour\r\ninvoquer Chouchou feu.",
  "TUT_TUTORIAL_TEXT_b003": "Déplace le curseur sur\r\nla technique de ton choix...",
  "TUT_TUTORIAL_TEXT_ch027": "Se déplacer gauche/droite",
  "TUT_TUTORIAL_TEXT_ph042": "Esquiver",
  "TUT_TUTORIAL_TEXT_w732": "Il peut utiliser [BTN:A ][BTN:B ][BTN:X ][BTN:Y ]\r\npour réaliser de puissantes attaques\r\nélémentaires ! Ces pouvoirs peuvent\r\nte donner l'avantage !",
  "TUT_TUTORIAL_TEXT_w721": "Le chronomètre se déclenche sur\r\nla ligne de départ ou au début d'un\r\ncombat. Franchis l'arrivée, et tu auras\r\nune récompense selon ton temps.",
  "TUT_TUTORIAL_TEXT_w325": "Appuie sur [BTN:Y ] pour invoquer\r\nla forme normale de Chouchou.\r\nSous cette forme, il peut\r\nuniquement contrer les attaques !",
  "TUT_TUTORIAL_TEXT_w125": "Les empreintes du loup blanc.\r\nLes suivre pourrait t'aider à\r\navancer. Fouille les environs\r\npour en trouver d'autres !",
  "TUT_TUTORIAL_TEXT_w025": "Ces plantes infernales sont plus\r\ngrandes que les herbes de Morgana.\r\nPour les faire pousser au maximum,\r\nil faut utiliser Pulsation plus longtemps.",
  "TUT_TUTORIAL_TEXT_w421": "Attention, seul Chouchou eau\r\npeut nager. S'il plonge sous\r\nune autre forme, Chouchou eau\r\nsera automatiquement invoqué.",
  "TUT_TUTORIAL_TEXT_ph008": "(Incliner) Pulsation",
  "TUT_TUTORIAL_TEXT_ph046": "(Incliner/maintenir) Pulsation",
  "TUT_TUTORIAL_TEXT_w332": "Chouchou pierre est doté d'une\r\ncarapace capable de résister à\r\nla plupart des attaques, mais cela\r\nconsomme de la magie.",
  "TUT_TUTORIAL_TEXT_w321": "Utilise l'attaque élémentaire\r\nde Chouchou bois avec [BTN:R2 ]\r\net profite de sa puissance\r\ndestructrice au combat !",
  "TUT_TUTORIAL_TEXT_ch023": "Forme normale",
  "TUT_TUTORIAL_TEXT_ch030": "(Maintenir/relâcher) Miam !",
  "TUT_TUTORIAL_TEXT_w080": "Lorsque Chouchou est en\r\nmode peluche, tu peux le\r\nporter et l'emmener avec toi.",
  "TUT_TUTORIAL_TEXT_w670": "Sur la carte, l'empreinte du loup blanc\r\nindique l'endroit où Ignis te conseille\r\nde te rendre. Très utile si tu ne sais\r\nplus quoi faire !",
  "TUT_TUTORIAL_TEXT_w280": "Dans les sanctuaires, tu peux\r\nretenter les tír na nÓg déjà\r\nterminés. Tu peux ainsi y\r\nrécupérer tous les trésors !",
  "TUT_TUTORIAL_TEXT_ph013": "Lancer Chouchou",
  "TUT_TUTORIAL_TEXT_ph000": "Se déplacer",
  "TUT_TUTORIAL_TEXT_ph017": "Absorber l'énergie de la pierre",
  "TUT_TUTORIAL_TEXT_ph004": "(Maintenir [BTN:L1 ]) Tirer/pousser caisse",
  "TUT_TUTORIAL_TEXT_w270": "Ignis peut guider Cereza vers\r\nles sanctuaires. N'hésite pas\r\nà y retourner, tu pourrais y\r\ntrouver des surprises.",
  "TUT_TUTORIAL_TEXT_w680": "Quand il est trop loin ou bloqué par du\r\nromarin, Chouchou ne peut pas revenir\r\nen mode peluche. Le cas échéant,\r\ntrouve un autre moyen de les réunir.",
  "TUT_TUTORIAL_TEXT_w480": "Les champolines sont de\r\ngrands champignons que\r\nChouchou pierre peut utiliser\r\npour se propulser en l'air.",
  "TUT_TUTORIAL_TEXT_w070": "Maintiens [BTN:L2 ] pour invoquer des\r\nronces infernales qui entravent l'ennemi.\r\nCette technique consomme une unité\r\nde la jauge de régénération.",
  "TUT_TUTORIAL_TEXT_w170": "Les tír na nÓg sont à l'origine\r\ndes illusions féériques. Ils ont\r\nété installés un peu partout\r\ndans Avalon.",
  "TUT_TUTORIAL_TEXT_w090": "En mode peluche, lance Chouchou\r\navec [BTN:L1 ] pour atteindre les lieux\r\nen hauteur. Cherche partout de\r\nnouveaux chemins !",
  "TUT_TUTORIAL_TEXT_ch028": "Sauter",
  "TUT_TUTORIAL_TEXT_w460": "Chouchou attaque les ennemis\r\navec ses crocs et ses griffes,\r\nmais il peut aussi contrer leurs\r\nattaques.",
  "TUT_TUTORIAL_TEXT_w560": "Lorsque tu auras secouru quelques wisps,\r\nva voir Colm au refuge des wisps.\r\nIl te donnera peut-être une récompense.",
  "TUT_TUTORIAL_TEXT_ph010": "(Incliner) Pulsation",
  "TUT_TUTORIAL_TEXT_ph003": "Tirer de l'eau",
  "TUT_TUTORIAL_TEXT_w390": "Maintiens [BTN:L2 ] en pivotant [BTN:LS ]\r\nprès d'objets cassés pour utiliser\r\nla magie restauratrice de Cereza\r\net les réparer temporairement.",
  "TUT_TUTORIAL_TEXT_w660": "Certains ennemis volants sont\r\ntrès faibles et peuvent être vaincus\r\navec une seule Entrave roncière.",
  "TUT_TUTORIAL_TEXT_w260": "Dans le menu des tenues, Cereza\r\net Chouchou peuvent changer de\r\nlook. À chaque humeur son style !",
  "TUT_TUTORIAL_TEXT_w690": "Laisse Chouchou foncer sur les\r\npiliers puis essaie de le calmer.\r\nUtilise la magie restauratrice\r\nsi les piliers s'écroulent.",
  "TUT_TUTORIAL_TEXT_ph014": "Tendre Chouchou",
  "TUT_TUTORIAL_TEXT_ph007": "(Maintenir) Danser",
  "TUT_TUTORIAL_TEXT_w160": "La distorsion créée par les fées\r\nest peuplée d'illusions. Utilise ta\r\nmagie avec [BTN:L2 ] pour dissiper\r\nces illusions et révéler la vérité.",
  "TUT_TUTORIAL_TEXT_ph049": "(Maintenir) Entraver le premier ennemi",
  "TUT_TUTORIAL_TEXT_w490": "Dans chaque sanctuaire,\r\nChouchou peut attaquer\r\nles noyaux élémentaires\r\net les détruire.",
  "TUT_TUTORIAL_TEXT_w060": "Les démons ne supportent pas\r\nle romarin. Quand il en apparaît,\r\nChouchou doit trouver un chemin\r\ndifférent.",
  "TUT_TUTORIAL_TEXT_ph041": "(Maintenir) Entrave roncière",
  "TUT_TUTORIAL_TEXT_w731": "Chouchou démon peut esquiver\r\navec [BTN:L1 ] et utiliser une\r\npuissante attaque physique\r\navec [BTN:R1 ].",
  "TUT_TUTORIAL_TEXT_w722": "Les montres que tu récupères\r\nbaissent ton temps, tandis que les\r\ndégâts que tu subis l'augmentent,\r\nalors fais bien attention !",
  "TUT_TUTORIAL_TEXT_w326": "[BTN:Y ] invoque également\r\nChouchou bois. Tu peux\r\nvérifier l'élément invoqué\r\nen bas à droite de l'écran.",
  "TUT_TUTORIAL_TEXT_ch024": "Forme normale",
  "TUT_TUTORIAL_TEXT_d003": "Ignis suggère d'aller à cet endroit.",
  "TUT_TUTORIAL_TEXT_w026": "Maintiens [BTN:L2 ] jusqu'à ce que l'art\r\nde Pulsation ait été utilisé plusieurs fois\r\navec succès. Ne relâche pas avant !",
  "TUT_TUTORIAL_TEXT_ph018": "Absorber l'énergie de l'eau",
  "TUT_TUTORIAL_TEXT_w031": "Si la jauge de vitalité de Cereza\r\ns'épuise, l'histoire prend fin.\r\nAlors surveille-la attentivement.",
  "TUT_TUTORIAL_TEXT_w022": "Tente une Pulsation avancée !\r\nQuand Cereza danse, incline et\r\nmaintiens [BTN:LS ] pendant que le\r\ncurseur se déplace sur la ligne rouge.",
  "TUT_TUTORIAL_TEXT_ch020": "Torrent aqua",
  "TUT_TUTORIAL_TEXT_ph045": "(Maintenir) Entrave roncière",
  "TUT_TUTORIAL_TEXT_w331": "Chouchou pierre peut exécuter\r\nun puissant pilonnage avec [BTN:R1 ]\r\npour détruire, retourner ou\r\ndéterrer certains objets.",
  "TUT_TUTORIAL_TEXT_w322": "Avec sa langue, Chouchou bois\r\npeut aussi attraper des objets\r\navec [BTN:R1 ]. Maintiens [BTN:R1 ]\r\npour rapporter ces objets."
}
