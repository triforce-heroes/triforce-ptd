{
  "BK_1000_0030_NAR": "Les fées ! Des êtres perfides\r\nqui se repaissent de l'âme des\r\nhumains dont l'audace a été\r\nde s'aventurer dans les bois.",
  "PH_1030_0000_CER": "« Cette plante émet toujours\r\nla même énergie qu'avant... »",
  "BK_1060_0080_NAR": "[FONT:9 ]Qui me fera office d'entrée,\r\net qui de dessert ?![FONT:N ]\r\nGronda Chouchou, la crinière hérissée et toutes griffes dehors.",
  "LV_001070_0000_CER": "On dirait qu'il y a aussi un\r\nchemin plus haut.",
  "BK_1060_0000_CER": "« Où diable est passé\r\nle loup blanc ? »",
  "PH_1b01_0010_NAR": "La destruction du mécanisme dans le\r\nnoyau de la faille semblait avoir altéré\r\nl'illusion, révélant ainsi le chemin.",
  "IN_1000_0030_CER": "N-Ne nous effrayons pas comme ça !",
  "PH_1b01_0020_NAR": "Ils aperçurent le loup blanc.\r\nSans un instant d'hésitation,\r\nils se lancèrent à sa poursuite.",
  "SM_001100_0140_MOR": "« Cette forêt appartient aux fées, mais\r\nsi tu cherches bien, je suis certaine que\r\ntu trouveras des objets qui t'aideront à\r\ndévelopper tes talents de sorcière. »",
  "LV_001005_0010_CER": "Allez Cereza,\r\nun pied devant l'autre...",
  "BK_1000_0000_NAR": "Cereza avait toujours le\r\nsentiment d'être épiée.",
  "SM_001020_0000_CER": "« Qu'est-ce qu'il y a ? »",
  "SM_001020_0080_NAR": "[FONT:9 ]Comment tu comptes me\r\nrenvoyer en Enfer ?[FONT:N ]\r\nDemanda le démon.",
  "SM_001100_0260_CER": "« Repartons à la poursuite du loup blanc.\r\nSi nous obtenons ce pouvoir, même la\r\ngrande Morgana sera bien obligée de\r\nreconnaître que je suis la meilleure ! »",
  "SM_001090_0020_NAR": "semblait avoir altéré l'illusion,\r\nrévélant ainsi le chemin.",
  "SM_001090_0020_NAR#2": "Ils aperçurent le loup blanc.\r\nSans un instant d'hésitation,\r\nils se lancèrent à sa poursuite.",
  "SM_001040_0030_NAR": "Cereza courut ramasser Chouchou\r\net le serra contre elle.\r\nDans ses bras, il sentit ses\r\nforces lui revenir.",
  "LV_001145_0000_NAR": "Le chemin atteignit une rangée d'arbres\r\narqués qui formaient un tunnel.",
  "BK_1010_0020_NAR": "Comme entravé par une force invisible,\r\net malgré toute sa volonté, il ne pouvait\r\natteindre Cereza.",
  "SM_001040_0080_CER": "« Arrête de gigoter ! Comme ça,\r\ntu es trop petit pour marcher\r\ntout seul, non ?\r\nJe te porterai jusqu'à ce que\r\ntu puisses te retransformer. »",
  "SM_001090_0010_NAR": "La destruction du mécanisme\r\ndans le noyau de la faille",
  "BK_1010_0010_NAR": "Mais que se passe-t-il ?\r\nLe démon s'est arrêté net.",
  "SM_001070_0040_NAR": "Interloqués, la jeune fille et le démon\r\néchangèrent un regard.",
  "BK_1020_0140_CER": "« Qu-Qu'est-ce que c'était ?\r\nJe me sens bizarre... »",
  "BK_1020_0050_NAR": "Se libérant de l'étreinte de Cereza,\r\nChouchou bondit sur le loup.",
  "LV_001130_0010_NAR": "Il y avait là une roche tellement lustrée\r\nqu'elle pourrait remplacer le miroir que\r\nCereza utilisait pour s'entraîner.",
  "BK_1010_0060_NAR": "Le démon cessa son attaque\r\net reporta son attention\r\nautre part.",
  "LV_001915_0000_CER": "Comment je suis censée m'orienter, ici ?",
  "LV_001080_0000_CER": "Un loup blanc...\r\ncomme le garçon avait dit !",
  "LV_001095_0010_NAR": "Un mince sillon de beauté indescriptible\r\ns'ouvrit devant Cereza.",
  "PH_1010_0010_CER": "Y a... Y a quelqu'un ?",
  "SM_001010_0080_NAR": "Le démon aperçut Cereza et\r\nexhala un profond grondement.",
  "SM_001040_0070_NAR": "[FONT:9 ]Lâche-moi tout de suite ![FONT:N ]\r\nMême sous cette forme,\r\nle démon ne semblait pas\r\napprécier de se faire câliner.",
  "SM_001100_0220_CER": "« P-Pardon ?!\r\nMorgana est ma maîtresse,\r\nalors gare à ce que tu dis ! »",
  "SM_001010_0000_CER": "« Ch... Chouchou ? »",
  "BK_1020_0020_NAR": "Mais lorsque Cereza fit un pas\r\nen avant pour l'observer...",
  "SM_001070_0030_NAR": "En regardant de plus près,\r\ndes distorsions apparurent,\r\ncomme si l'air se déchirait.",
  "BK_1020_0090_CER": "« Chouchou, arrête ! »",
  "BK_1020_0010_NAR": "Et devant se tenait le loup blanc.",
  "SM_001120_0030_CER": "« M-Mais je suis sûre que cette\r\npuissance nous sera utile ! »",
  "SM_001070_0000_NAR": "Ensemble, ils cherchèrent le loup dans chaque\r\ncoin et recoin, mais il s'était volatilisé.",
  "LV_001095_0020_NAR": "Cette sombre forêt semblait receler\r\nbien des secrets. Cereza se\r\ndétendit un tout petit peu.",
  "LV_001915_0030_CER": "Ce bracelet... a-t-il le pouvoir\r\nde dissiper les illusions ?",
  "SM_001010_0120_NAR": "Cereza maîtrisait à peine les sorts\r\nd'invocation des démons...\r\nElle n'avait même pas commencé\r\nà apprendre comment les renvoyer.",
  "SM_001010_0030_CER": "« Aurais-je invoqué un démon qui a\r\npris possession de mon Chouchou ? »",
  "SM_001040_0040_NAR": "Cereza se calma.\r\nSa peur se dissipa.",
  "BK_1060_0040_CER": "« Allez donc effrayer quelqu'un\r\nd'autre et fichez-nous la paix ! »",
  "BK_1000_0160_CER": "« Est-ce que...\r\nce ne serait pas... »",
  "SM_001100_0130_MOR": "« Cereza... Bien, il fera l'affaire.\r\nEt si tu es capable de contrôler ce\r\ndémon, tes chances de survie\r\nsont bien meilleures. »",
  "IN_1030_0000_CER": "« Oh ho, je ne peux\r\npas descendre.\r\n\r\nDis, Chouchou, tu pourrais\r\nm'aider ?",
  "BK_1000_0040_NAR": "Il n'y avait nulle part où fuir.\r\nCereza était acculée.",
  "SM_001100_0170_NAR": "La lueur de la lune se mit à faiblir.\r\nLe visage de Morgana s'effaçait.\r\nOn aurait dit que la forêt tentait elle\r\naussi de contrarier leurs plans.",
  "LV_001105_0010_CER": "Que peut-elle bien garder... ?",
  "SM_001100_0090_MOR": "« Quant à toi, trouve un lieu sûr,\r\net essaie de rester en vie jusqu'à\r\nce que je trouve comment te secourir. »",
  "BK_1030_0000_NAR": "Lorsque leurs yeux se furent accoutumés à\r\nla luminosité, ils découvrirent un univers\r\njamais vu auparavant.",
  "LV_001020_0000_NAR": "Cereza trouva enfin un endroit où se reposer.",
  "SM_001060_0010_NAR": "Devant eux se tenait un gros loup.\r\nSa blanche toison semblait argentée\r\nà la lueur de la lune.",
  "IN_1050_0000_NAR": "Dans l'étrange dispositif, les sphères immenses\r\ns'alignèrent, et un chemin de lumière se forma.",
  "BK_1040_0050_LUC": "« Tu en es... capable... »",
  "BK_1000_0010_CER": "« Il... Il y a quelqu'un ?\r\nMontrez-vous ! »",
  "BK_1050_0010_MOR": "« Te voilà enfin, Cereza. »",
  "BK_1000_0100_NAR": "Les fées en profitèrent pour reprendre leurs sinistres desseins.\r\nElles se ruèrent sur Cereza, toutes armes dehors.",
  "BK_1060_0020_NAR": "Soudain, une fée menaçante surgit\r\nde nulle part ! Cereza tressaillit, mais\r\ns'efforça de garder son sang-froid.",
  "SM_001060_0040_CER": "« Hé... Attends ! »",
  "LV_001065_0000_CER": "Bon, je vais aller là sans toi.",
  "IN_1000_0010_NAR": "Prudemment, elle avançait.",
  "SM_001100_0190_NAR": "La lune disparut, et\r\nMorgana avec elle.",
  "BK_1040_0060_LUC": "« Suis...\r\nle loup blanc... »",
  "LV_001130_0000_CER": "Qu'est-ce que c'est... ?",
  "LV_001075_0020_CER": "Je ne suis peut-être pas la première\r\nsorcière à visiter ces bois...",
  "BK_1020_0040_CER": "« Mais qu'est-ce que tu fais ?! »",
  "BK_1020_0150_NAR": "[FONT:9 ]File-moi un peu de cette puissance ![FONT:N ]\r\nMaugréa Chouchou.",
  "SM_001120_0060_NAR": "D'ailleurs, le loup blanc...\r\nOù est-il donc passé ?",
  "SM_001010_0060_NAR": "La créature avait cherché un\r\nmoyen de survivre dans notre monde.\r\nElle a dû se contenter d'étoffe...",
  "SM_001100_0240_NAR": "Cereza aurait bien voulu que,\r\npour une fois, Morgana la félicite...",
  "BK_1010_0030_CER": "« Calme-toi, ou tu vas faire\r\ncraquer tes coutures ! »",
  "SM_001040_0020_CER": "« Chouchou ! »",
  "SM_001010_0050_NAR": "Comme le redoutait Cereza,\r\nun démon avait pris possession\r\nde sa peluche adorée.",
  "LV_001130_0030_CER": "Je n'ai rien à perdre...",
  "SM_001020_0090_CER": "« On doit d'abord trouver un loup blanc.\r\nIl nous montrera le chemin. »",
  "SM_001070_0060_CER": "« Utiliser la magie pour les ouvrir ?\r\nAllons, on ne sait même pas ce\r\nqui nous attend de l'autre côté ! »",
  "BK_1020_0160_NAR": "Il voulait sa part du gâteau.\r\nMais qu'avaient-ils déchaîné exactement ?",
  "SM_001020_0010_NAR": "Le démon montra les crocs.\r\nIl souffrait visiblement.",
  "SM_001010_0020_NAR": "De sa gueule béant d'une oreille à l'autre\r\ns'échappa une écume épaisse.",
  "LV_001915_0020_NAR": "La lueur du bracelet révéla à\r\nCereza des choses qu'elle ne\r\npouvait pas voir auparavant.",
  "BK_1010_0040_CER": "« Ne t'inquiète pas, je vais te\r\nrenvoyer chez toi ! Dès que je\r\nsaurai comment... »",
  "LV_001100_0000_CER": "Est-ce... un trésor de fée ?\r\nElles seraient furieuses si\r\nje leur chipais !",
  "SM_001020_0060_NAR": "Le démon semblait calmé. Se rappelant\r\nqu'il ne pouvait pas la toucher, Cereza\r\npoussa un soupir de soulagement.",
  "SM_001020_0170_CER": "« Mais tu as besoin d'un nom !\r\nSi tu veux jouer les difficiles,\r\nt'as qu'à te trouver un autre corps ! »",
  "LV_001030_0000_CER": "Chouchou, je la tiens !\r\nAchève-la !",
  "BK_1020_0080_NAR": "Chouchou en avait ras la truffe de\r\ncette poursuite. Il voulait des réponses.",
  "LV_001025_0010_NAR": "Dès que l'odeur atteignit les narines de\r\nChouchou, il fit comprendre à Cereza\r\nqu'il fallait s'en éloigner.",
  "BK_1020_0120_NAR": "Manquant leur proie, les griffes\r\nde Chouchou s'abattirent sur\r\nle noyau élémentaire. Il ne se\r\npassa d'abord rien. Puis...",
  "SM_001070_0020_CER": "« Il y a quelque chose ici... »",
  "IN_1020_0015_NAR": "Oui, quelque chose n'allait pas.\r\nIl semblait se vider de ses forces.",
  "LV_001025_0020_NAR": "Les habitants de l'Enfer exécraient\r\nle romarin. Il leur fallait donc trouver\r\nun autre chemin.",
  "SM_001020_0140_CER": "« Tu n'as pas de nom ?\r\nÇa ne doit pas être pratique du tout.\r\n\r\nQuoique... j'ignore tout des\r\ncoutumes démoniaques. »",
  "SM_001010_0010_NAR": "Sous ses yeux, le chat en peluche\r\nde Cereza se transforma en une\r\ncréature monstrueuse.",
  "IN_1020_0000_NAR": "Le démon galopait dans la forêt,\r\ncherchant un chemin pour rentrer chez lui.",
  "SM_001010_0100_CER": "« Tu... Tu veux que je te\r\nrenvoie dans l'Enfer ? »",
  "LV_001915_0010_NAR": "Soudain, le bracelet magique de\r\nCereza se mit à luire.\r\nQue cela signifiait-il ?",
  "LV_001900_0000_CER": "Hm ?\r\nMais qu'avons-nous là ?",
  "IN_1050_0010_CER": "« C'est immense... Mais qu'est-ce\r\nque ça peut bien être ? »",
  "IN_1000_0060_NAR": "Cereza entendait le murmure sourd\r\ndes feuilles qui bruissaient au vent.",
  "SM_001060_0000_CER": "« Oh, là, regarde... »",
  "BK_1030_0010_CER": "« Chouchou, je crois que nous\r\nne sommes plus en Avalon. »",
  "SM_001100_0070_NAR": "Ce sortilège ancien était tellement\r\npuissant que même Morgana ne\r\npouvait le briser si facilement.",
  "BK_1000_0140_NAR": "Miam !",
  "BK_1040_0010_LUC": "« Centre... de la forêt...\r\nJe... t'attends... »",
  "BK_1000_0050_CER": "« Faites que ça marche, cette fois ! »",
  "SM_001100_0040_NAR": "Étrangement, sous forme spectrale,\r\nles reproches de Morgana étaient plus\r\ncinglants encore qu'en personne.\r\nCereza était penaude.",
  "BK_1000_0170_NAR": "Mais avant que Cereza ne\r\npuisse finir sa question...",
  "BK_1040_0020_LUC": "« Aide-moi...\r\n... un pouvoir... »",
  "SM_001100_0030_MOR": "« Mais Cereza, t'aventurer dans la\r\nforêt en dépit de mes mises en garde...\r\nEt en emportant mon bracelet magique,\r\nen plus. Tu as perdu la tête ! »",
  "LV_001055_0000_CER": "Wouah, c'est nouveau, ça !",
  "SM_001100_0150_CER": "« Des objets comme ces machins\r\nbrillants ? J'en ai ramassé plein\r\ndepuis que je suis ici. »",
  "LV_001905_0000_NAR": "Le monde semblait se distordre devant Cereza.\r\nElle cligna des yeux, mais rien ne changea.",
  "IN_1000_0050_NAR": "Scrutant les sombres fourrés,\r\nCereza avait l'intime conviction\r\nqu'elle était épiée.",
  "BK_1050_0005_NAR": "Alors qu'elle s'approchait, son\r\nbracelet magique se mit à luire.",
  "SM_001010_0140_NAR": "À court de patience,\r\nle démon bondit !",
  "LV_001150_0000_CER": "Oooh, regarde ça...",
  "LV_001145_0010_NAR": "Les fées tentaient-elles\r\ndonc de protéger ce lieu ?",
  "SM_001100_0270_CER": "« Ah, oui, les petits trucs brillants qui\r\nsont censés te rendre plus puissant...\r\nmais puissant comment, exactement ?",
  "SM_001020_0180_CER": "« Alors je t'appellerai comme je veux. »",
  "LV_001075_0010_NAR": "Des signes indiquaient qu'une\r\nsorcière s'était abritée là.",
  "LV_001060_0000_CER": "Encore du romarin...",
  "BK_1020_0070_NAR": "[FONT:9 ]Cesse de fuir, et dis-nous\r\nplutôt comment obtenir\r\nce pouvoir ![FONT:N ]",
  "SM_001020_0100_NAR": "[FONT:9 ]Je vais te le trouver, moi, ton\r\nloup blanc,[FONT:N ] dit le démon en se relevant.",
  "SM_001060_0050_LUC": "« Forêt d'Avalon... le loup\r\nblanc... te guidera... »",
  "SM_001120_0050_CER": "« Mais oui, je sais !\r\nC'est pour ça qu'on\r\nsuit le loup blanc ! »",
  "SM_001020_0130_NAR": "[FONT:9 ]Je n'ai pas de nom,[FONT:N ]\r\nrépondit sèchement le démon.",
  "SM_001070_0050_NAR": "[FONT:9 ]Le loup est droit devant ![FONT:N ]\r\nChouchou n'hésita pas longtemps.\r\nMais malgré ses efforts, il ne\r\nparvenait pas à élargir les déchirures.",
  "SM_001020_0020_CER": "« Tu es malade ?\r\nOu tu as faim, peut-être ? »",
  "BK_1010_0000_NAR": "Des griffes acérées\r\nfondirent sur Cereza !",
  "LV_001015_0010_CER": "On est d'humeur bagarreuse, hm ?\r\nL'invocation que je te réserve\r\nt'apprendra le savoir-vivre !",
  "SM_001040_0010_NAR": "En un instant, Chouchou\r\nreprit sa forme de peluche.",
  "SM_001040_0090_CER": "« Et puis je suis moins inquiète\r\nquand je n'ai pas un gros démon\r\nqui me souffle dans la nuque. »",
  "SM_001090_0000_NAR": "Quittant l'étrange monde, ils regagnèrent\r\nla forêt. Celle-ci était inchangée...\r\nou presque.",
  "LV_001070_0010_CER": "Je vais te lancer là-haut, Chouchou.\r\nEssaie de voir si on peut emprunter\r\ncette voie.",
  "BK_1060_0010_CER": "« C'est quoi, ça, là ?\r\nAllons voir ! »",
  "PH_1b01_0000_NAR": "Quittant l'étrange monde, ils regagnèrent\r\nla forêt. Celle-ci était inchangée...\r\nou presque.",
  "BK_1000_0020_NAR": "Et en guise de réponse à sa question...",
  "SM_001100_0160_MOR": "« Oui... Cette structure cristalline est\r\nune source durable d'énergie magique.\r\nSi tu nourris le démon avec, tu pourrais\r\néveiller en lui des pouvoirs magiques. »",
  "BK_1000_0130_CER": "« Qui... Qui es-tu ? »",
  "SM_001100_0000_CER": "« Morgana ?! »",
  "BK_1000_0090_CER": "« Pourquoi ? J'ai pourtant\r\ntout fait correctement... »",
  "LV_001005_0000_CER": "Ne regarde pas en bas.",
  "LV_001910_0010_NAR": "Dès qu'elle posa le pied à l'intérieur,\r\nson souffle se figea dans sa poitrine.",
  "BK_1000_0060_NAR": "Croisant les doigts, Cereza\r\nprépara l'invocation que\r\nMorgana lui avait apprise.",
  "SM_001060_0030_NAR": "Cereza semblait captivée par\r\nle loup. Il semblait tout droit\r\nsorti d'un autre monde.",
  "LV_001035_0000_CER": "Je pars devant pour ouvrir un chemin\r\nAttends-moi là.",
  "IN_1030_0020_CER": "« Je t'avais pas demandé de\r\nfaire tomber l'arbre tout entier ! »",
  "SM_001100_0110_MOR": "« Mais c'est...\r\nTu as invoqué un démon et\r\ntu l'as mis dans ta peluche ? »",
  "LV_001910_0020_NAR": "Tout autour d'elle, des visions étranges et\r\nodieuses, comme si elle avait été plongée\r\ndans un cauchemar.",
  "LV_001905_0030_CER": "Une seconde, je suis\r\npresque prête !",
  "LV_001110_0010_NAR": "[FONT:10 ]C'est parce qu'elles savent\r\nque t'es faible ![FONT:N ]\r\nCracha Chouchou.",
  "SM_001100_0080_MOR": "« Je peux uniquement t'aider à\r\ndistance. Je dois d'abord trouver\r\nun moyen de te sortir de la forêt. »",
  "LV_001105_0000_CER": "Je n'ai encore jamais vu une barrière\r\npareille. Sûrement l'œuvre des fées !",
  "SM_001120_0090_NAR": "Sans cesser de se chamailler, les\r\ncompères abandonnèrent les restes\r\ndu noyau et s'enfoncèrent dans la forêt.",
  "SM_001120_0010_CER": "« Non, ce n'est pas tout à fait ça...\r\nOn va devoir briser trois autres de ces\r\nchoses avant que tu puisses rentrer. »",
  "SM_001020_0050_CER": "« Quoi donc ? Je dois rester près de toi ?\r\nJe n'avais encore jamais entendu parler\r\nde ce genre de magie. »",
  "PH_1010_0000_CER": "C'était quoi, ça ?!\r\nSûrement un lapin, ou un truc\r\ndans le genre, hein Chouchou ?",
  "SM_001010_0090_NAR": "Surmontant sa terreur initiale,\r\nCereza réalisa qu'elle comprenait\r\nce que disait le démon.",
  "SM_001100_0230_CER": "« Je m'en veux de l'avoir inquiétée...\r\nMais pourquoi elle me couve autant,\r\naussi ? Qui a invoqué un démon,\r\nhein ? Oui, moi ! »",
  "LV_001050_0000_CER": "Hm, même avec toi à l'intérieur,\r\nChouchou ne pèse pas plus\r\nlourd qu'avant.",
  "BK_1010_0070_NAR": "Intriguée, et quelque peu inquiète,\r\nCereza décida de le suivre à bonne distance.",
  "LV_001080_0010_CER": "Alors si on suit ce loup...\r\nVite, Chouchou, dépêchons !",
  "BK_1040_0000_CER": "« Tu es le garçon de mon rêve... »",
  "BK_1040_0030_CER": "« Et donc...\r\nje dois juste suivre\r\nle loup blanc, c'est ça ? »",
  "SM_001010_0130_NAR": "Le démon répéta ses paroles,\r\ncette fois plus fermement.\r\n[FONT:9 ]Renvoie-moi ! Renvoie-moi ![FONT:N ]\r\nLa colère du démon enflait à\r\nchaque seconde. Mais Cereza\r\nétait impuissante.",
  "SM_001070_0090_CER": "« Je ne cherche pas à me défiler ! »",
  "SM_001070_0010_NAR": "[FONT:9 ]Par ici ![FONT:N ]\r\nChouchou avait senti le loup.",
  "SM_001070_0100_CER": "« Alors très bien ! Vas-y, Cereza,\r\nfais comme tu as appris... »",
  "BK_1020_0000_NAR": "Un orbe étrange sur un pilier...\r\nPourrait-il s'agir du noyau élémentaire\r\ndont avait parlé le garçon dans le\r\nrêve de Cereza ?",
  "SM_001100_0250_NAR": "Elle avait déjà oublié le courroux\r\nde Morgana.",
  "SM_001040_0110_NAR": "Bien qu'appréciant peu de se\r\nfaire traiter comme une peluche,\r\nle démon n'avait d'autre choix\r\nque de ravaler sa fierté.",
  "LV_001015_0000_NAR": "Les choses se présentaient mal.\r\nMais Cereza savait comment\r\ns'en sortir sans une égratignure.",
  "SM_001020_0030_NAR": "Alors que Cereza approchait, le démon\r\nsentait ses forces revenir. Et en un instant,\r\nil recouvra ainsi toute sa puissance.",
  "SM_001120_0070_NAR": "Pour trouver les autres noyaux\r\nélémentaires, ils doivent d'abord\r\nle retrouver.",
  "SM_001020_0120_CER": "« Mon... Mon nom est Cereza.\r\nEt toi, comment tu t'appelles ? »",
  "LV_001075_0030_CER": "Enfin, ça signifie au moins qu'on\r\na un endroit où se reposer.",
  "LV_001075_0000_CER": "Qu'est-ce qu'on a là...",
  "LV_001130_0020_CER": "Oh...\r\nSans Morgana sur le dos, peut-être que\r\nje pourrai m'entraîner plus efficacement.",
  "SM_001020_0190_NAR": "Et ainsi, cet étrange duo se mit\r\nà la recherche du loup blanc.\r\nQuels mystères les attendaient-ils\r\ndans la forêt d'Avalon ?",
  "SM_001010_0040_NAR": "En guise de réponse, la bête\r\ngronda et découvrit ses crocs\r\nrouge sang.",
  "LV_001150_0010_NAR": "De ce lieu émanait une sérénité\r\nqui envahit Cereza.",
  "BK_1000_0110_NAR": "Elle ferma les yeux,\r\nse préparant au pire.\r\nUn instant passa, puis un autre,\r\nsans qu'elle ne ressente sur sa peau\r\nle moindre aiguillon.",
  "SM_001100_0050_MOR": "« J'espère que tu auras une bonne\r\nexplication à me fournir quand tu\r\nrentreras. Mais t'échapper de la forêt\r\nd'Avalon ne sera pas une mince\r\naffaire. »",
  "BK_1040_0040_LUC": "« Détruis... les quatre...\r\nnoyaux élémentaires... »",
  "BK_1000_0080_NAR": "Le cercle d'invocation s'était\r\ndéjà évaporé, mais personne\r\nn'avait répondu à son appel.",
  "LV_001010_0000_CER": "Une plante de l'Enfer ?\r\nJe me demande comment\r\nelle réagirait à ma magie...",
  "SM_001100_0010_NAR": "Incrédule, Cereza se frotta les yeux.\r\nLa silhouette fantomatique de sa maîtresse\r\nse découpait à la lueur de la lune.",
  "AC_CEREZA010_0010_CER": "Loup blanc, attends !",
  "SM_001100_0100_CER": "« Ne t'inquiète pas, Morgana !\r\nRegarde, j'ai même réussi à\r\ninvoquer un démon, toute seule ! »",
  "IN_1000_0080_CER": "Je ne peux pas abandonner...\r\nJe vais devenir une sorcière\r\net je vais sauver ma maman !",
  "IN_1000_0000_NAR": "D'immenses arbres occultaient\r\nla lueur de la lune, et un silence\r\ninquiétant enveloppait Cereza.",
  "LV_001920_0000_CER": "M-Mais ! Je suis où, exactement ?!",
  "LV_001110_0000_CER": "Ces filoutes de fées...\r\nc'est quoi leur problème ?",
  "LV_001905_0020_NAR": "[FONT:10 ]Réveille-toi, on a encore\r\nun loup à retrouver ![FONT:N ]",
  "LV_001910_0030_CER": "M-Même pas peur !\r\nJe suis pas une poule mouillée, moi !",
  "SM_001100_0060_NAR": "Morgana avait l'air sombre.\r\nElle expliqua que la magie des\r\nfées transformait la forêt en\r\npiège labyrinthique. Et Cereza\r\ns'était jetée dans ce piège.",
  "BK_1000_0150_NAR": "Cette bête, aussi sombre que la nuit...\r\nN'était-elle qu'un rêve ?",
  "SM_001100_0180_MOR": "« Écoute bien, Cereza. Les démons\r\nsont des armes au service des\r\nsorcières, et non des jouets à\r\ncâliner. Traite-les comme tels. »",
  "BK_1060_0070_NAR": "Chouchou soupira et se mit\r\ndevant Cereza afin de défier\r\nles fées.",
  "SM_001020_0200_NAR": "",
  "PH_1060_0000_CER": "Attends, loup blanc !",
  "LV_001905_0010_NAR": "Serait-ce une illusion créée par les fées ?\r\nChouchou s'impatientait du trouble de Cereza.",
  "SM_001100_0020_MOR": "« Tu es saine et sauve... Quand j'ai\r\nappris que tu étais dans la forêt,\r\nje me suis fait un sang d'encre. »",
  "LV_001910_0000_CER": "Qu'est-ce que... ?",
  "BK_1050_0000_NAR": "Cereza remarqua que dans\r\nune clairière non loin, la lune\r\néclairait un point précis.",
  "LV_001025_0000_NAR": "Un parfum frais chatouilla Cereza...\r\nC'était du romarin, une herbe utilisée\r\npour chasser les mauvais esprits.",
  "SM_001070_0080_NAR": "Chouchou émit un reniflement narquois.\r\nCette Cereza, quelle trouillarde !",
  "BK_1010_0050_CER": "« Je suis en route pour obtenir\r\nun pouvoir prodigieux.\r\nAvec ça, te renvoyer sera\r\nun jeu d'enfant ! »",
  "SM_001100_0210_NAR": "Chouchou était d'humeur exécrable.",
  "LV_001900_0010_CER": "Je ne suis pas mauvaise en concoctions,\r\nalors essayons...",
  "SM_001010_0110_CER": "« Et comment on fait ça,\r\nexactement ? »",
  "IN_1020_0010_NAR": "Ses griffes acérées tailladaient les\r\nbroussailles... mais il y avait un problème.",
  "SM_001020_0150_CER": "« Je peux t'appeler Chouchou ?\r\nAprès tout, c'est le nom de la peluche\r\nque tu as décidé de posséder. »",
  "BK_1020_0130_NAR": "Une tornade d'énergie s'échappa du noyau.\r\nCereza sentit une étrange puissance l'envahir.",
  "SM_001020_0040_NAR": "Cereza et lui étaient liés par\r\nune puissante magie.\r\nLorsqu'il s'éloignait d'elle,\r\nil perdait toutes ses forces.",
  "SM_001120_0000_NAR": "Ils avaient obtenu un nouveau pouvoir.\r\n[FONT:9 ]Alors ? Je peux rentrer chez moi ?[FONT:N ]\r\nDemanda Chouchou avec exaltation.",
  "SM_001120_0080_CER": "« Ma parole, vous les démons êtes\r\nvraiment des enquiquineurs ! »"
}
