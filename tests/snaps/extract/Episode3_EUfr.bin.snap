{
  "SM_003040_0080_NAR": "S'il ne regagnait pas très vite l'Enfer,\r\nChouchou risquait de mourir. Alors se\r\ndire qu'il poursuivait les rêves d'une\r\njeune sotte transie d'amour le fit\r\nbouillir de rage.\r\n",
  "SM_003035_0020_CER": "« Mais je ne sais même pas\r\ncomment tu t'appelles. »",
  "SM_003020_0030_NAR": "Chouchou secoua seulement\r\nla tête, de peur que sa voix ne\r\ntrahisse son émoi.",
  "CE_003040_0010_CER": "Je dois l'aider !",
  "SM_003020_0080_CER": "« Si je veux devenir une sorcière de\r\nl'Umbra, je ne peux pas laisser un\r\ngros lézard me faire peur. La prochaine\r\nfois, on l'aura, Chouchou ! »",
  "SM_003035_0010_CER": "« V-Vraiment ? Merci... »",
  "SM_003020_0000_NAR": "Son armure déchiquetée, la\r\ncréature s'enfuit à tire-d'aile.",
  "SM_003080_0040_FAS": "« Vous n'avez pas été\r\nblessés, si ? »",
  "SM_003010_0040_NAR": "Pour une fois, Chouchou\r\nn'en menait pas large.",
  "SM_003035_0080_LUC": "« Mais en tant que sorcière,\r\ntu as certainement le pouvoir\r\nde briser cette malédiction. »",
  "SM_003080_0200_FAS": "« Je peux vous emmener aux lieux\r\nque vous avez déjà visités. »",
  "CE_003050_0000_CER": "Mange, mange...\r\nMange jusqu'à éclater !",
  "LV_003010_0000_CER": "Oh, quel endroit familier...",
  "SM_003050_0140_MOR": "« Ne l'oublie jamais si tu as l'intention\r\nd'affronter d'autres créatures de cette\r\nforêt... et de survivre. »",
  "LV_003910_0040_CER": "Je... vais devenir plus forte !",
  "BK_3000_0030_CER": "« Tu ne me fais pas peur...\r\nPlus maintenant ! »",
  "SM_003030_0010_NAR": "Chouchou regardait ailleurs. Il semblait\r\naussi abattu qu'après leur dernière\r\naltercation avec la créature.",
  "SM_003035_0120_LUC": "« Oui... cela fait des lunes que ma\r\nmère m'attend hors de cette forêt. »",
  "BK_3030_0070_CER": "\r\n« Chouchou ! »",
  "LV_003920_0000_CER": "Je... ne... peux pas...",
  "SM_003050_0130_MOR": "« La valeur d'une sorcière\r\ndépend de son talent à\r\ncontrôler les démons. »",
  "LV_003035_0010_NAR": "D'un grondement, Chouchou\r\nincita Cereza à avancer.",
  "SM_003035_0150_LUC": "« Nous pourrons sortir de cette forêt\r\nensemble. Je t'aiderai à retrouver ta\r\nmaman.\r\nEt nous serons enfin réunis avec\r\nnos familles ! »",
  "LV_003020_0000_CER": "Ce sont... des griffures ?",
  "BK_3030_0080_NAR": "C'était inévitable, Chouchou allait\r\nse faire déborder. Était-ce la fin ?",
  "LV_003035_0020_NAR": "Mais Cereza ne trouva pas la\r\nforce de répliquer.",
  "SM_003030_0050_NAR": "La bonne humeur de Cereza\r\navait été anéantie.",
  "SM_003050_0090_MOR": "« Bon, Cereza. J'ai commencé les\r\npréparatifs pour te sortir de cette forêt. »",
  "LV_003905_0010_NAR": "Le corps de la créature était dur\r\ncomme fer. Chouchou gronda\r\nde frustration.",
  "LV_003040_0000_NAR": "Cereza distingua le Sanctuaire de l'eau\r\nau loin. Devant celui-ci se trouvait un\r\nétrange assemblage de tuyaux en métal.",
  "SM_003080_0070_CER": "« Tu sais où il est, non ? »",
  "CE_003805_0000_CER": "Ça... Ça pourrait marcher !",
  "BK_3020_0090_NAR": "Cédant à la peur, Cereza\r\nattrapa Chouchou et s'enfuit.",
  "LV_003025_0000_NAR": "Un vieil arbre tombé barrait la route à\r\nCereza en lui montrant les crocs.",
  "SM_003035_0060_CER": "« Qui es-tu, Lukaon ?\r\nPourquoi tu m'aides\r\ncomme ça ? »",
  "SM_003020_0070_NAR": "Il n'ignorait pas que sans\r\nCereza, il aurait finit en\r\npâtée pour dragon.\r\n\r\nMais il ne pouvait accepter\r\nd'avoir été sauvé par une\r\npersonne qu'il considérait\r\ntellement inférieure à lui.",
  "SM_003080_0030_FAS": "« Vous avez aussi détruit un autre\r\nnoyau élémentaire, et pourtant,\r\ntu n'as pas l'air contente. »",
  "LV_003050_0020_NAR": "Mais elle savait qu'il était trop\r\ntard pour rebrousser chemin.",
  "LV_003045_0030_CER": "Je... Je...",
  "LV_003915_0000_NAR": "Cereza retint ses larmes et d'un effort\r\nsurhumain, elle se força à avancer.",
  "LV_003050_0010_NAR": "Lorsqu'elle prononça ces mots,\r\nCereza fut envahie par la peur.",
  "SM_003010_0000_NAR": "Ils avaient sauvé leur peau, mais\r\nChouchou était furieux que Cereza\r\nait lâchement fui.",
  "SM_003040_0070_CER": "« Je sais ce que tu penses,\r\nmais jusqu'ici, tout s'est réalisé !\r\nLukaon n'avait pas menti quant\r\naux noyaux élémentaires !\r\nCe n'était pas juste un rêve ! »",
  "SM_003080_0190_FAS": "« Je connais tous les chemins\r\nsecrets de cette forêt. »",
  "SM_003080_0000_FAS": "« Ça alors. Ça me surprend\r\nbeaucoup que vous soyez\r\narrivés jusqu'ici. »",
  "CE_003020_0000_CER": "Ah !",
  "SM_003080_0140_FAS": "« Personne n'est jamais ressorti\r\nvivant de cette forteresse. Tu es\r\nsûre que tu veux y aller ? »",
  "SM_003020_0100_NAR": "Blessé dans sa fierté, le démon se\r\ndétourna, feignant de ne pas l'entendre.",
  "LV_003060_0000_CER": "Je dois aider Chouchou !",
  "SM_003035_0110_CER": "« Toi aussi, tu essaies de\r\nretrouver ta mère ? »",
  "SM_003020_0090_NAR": "Lorsqu'elle prononça ces mots,\r\nChouchou remarqua qu'elle semblait\r\ndifférente de la gamine craintive\r\nqu'il connaissait.",
  "PH_3020_0000_CER": "Je dois pouvoir faire quelque\r\nchose pour le sauver !",
  "SM_003080_0170_FAS": "« Mais avec le travail d'équipe\r\nque vous faites, vous n'avez\r\npeut-être rien à redouter. »",
  "LV_003075_0020_NAR": "À quoi servaient ces cages... ?\r\nCereza y songea un instant, puis se\r\ndit qu'il valait mieux ne pas savoir.",
  "SM_003020_0020_CER": "« Ça va, Chouchou ?\r\nTu es blessé ? »",
  "SM_003040_0100_CER": "« Lukaon est plus doué que toi\r\npour parler aux femmes... »",
  "SM_003040_0010_NAR": "Chouchou remarqua que les\r\njoues de Cereza avaient rosi\r\net la regarda avec curiosité.",
  "BK_3000_0020_NAR": "Le moment était venu de\r\nrégler les comptes.",
  "SM_003050_0120_CER": "« O-Oui madame ! »",
  "LV_003005_0000_CER": "Qu'est-ce que... ?",
  "LV_003010_0010_NAR": "Ils étaient déjà venus là. Leurs\r\npas les avaient ramenés au\r\npoint d'origine de leur aventure.",
  "SM_003080_0100_CER": "« Allez, ne nous fais pas\r\nde cachotteries ! »",
  "SM_003080_0090_CER": "« Tu parles comme\r\nma maîtresse ! »",
  "SM_003035_0180_LUC": "« C'est exact. C'est la première fois que\r\nje rencontre quelqu'un qui comprend\r\nma peine... et partage mon rêve... »",
  "BK_3030_0050_NAR": "Chouchou attaquait inlassablement,\r\nmais il perdait du terrain à chaque\r\nassaut.",
  "BK_8110_0030_CER": "« OK, ça te ramènera pas chez toi,\r\nmais c'est mieux que rien ! »",
  "SM_003050_0070_NAR": "Venant de Morgana, les compliments\r\nétaient aussi rares qu'un igloo en Enfer.\r\nCereza dut se forcer à ne pas sautiller\r\nde bonheur.",
  "SM_003050_0000_MOR": "« Cereza, tu n'as rien,\r\nquel soulagement... »",
  "LV_003905_0000_CER": "Hmpf... c'est inutile.\r\nIl est trop fort !",
  "LV_003910_0050_CES": "Mais comment tu feras ?\r\nTout le monde sait que tu\r\nes une ratée.",
  "BK_3030_0130_CER": "« Pour devenir une sorcière,\r\nil faut que je sois forte ! »",
  "BK_3030_0020_NAR": "Presque machinalement, Cereza\r\ntrouva une cachette. Sans un\r\ninstant d'hésitation, Chouchou\r\nse rua sur l'ennemi.",
  "SM_003035_0050_LUC": "« Cereza... quel joli nom... »",
  "BK_3030_0100_CER": "« Je ne peux... sauver personne... »",
  "BK_3030_0010_NAR": "[FONT:9 ]Cache-toi quelque part ![FONT:N ]\r\nCria Chouchou en se\r\npréparant au combat.",
  "BK_3030_0090_CER": "« J-Je ne peux pas... »",
  "SM_003050_0040_NAR": "Cereza ne pouvait contenir sa joie\r\nd'enfant. Elle raconta comment\r\nils avaient vaincu Jabberwock.",
  "BK_8110_0000_CER": "« Un nouvel élément ! »",
  "SM_003020_0050_CER": "« Je me demande si cette fée\r\nreviendra. Mais maintenant,\r\non sait qu'elle n'est pas\r\ninvincible ! »",
  "CE_003010_0000_CER": "Chouchou ! Utilisons ton pouvoir\r\nélémentaire de pierre !",
  "SM_003040_0060_NAR": "Chouchou était sans voix.\r\nS'enfoncer dans cette forêt à\r\ncause des vagues promesses\r\nd'un garçon dont elle avait rêvé ?!",
  "SM_003010_0010_CER": "« ... »",
  "LV_003045_0010_NAR": "Chouchou cria fort sa bravade\r\npour que Cereza ne manque\r\npas de l'entendre.",
  "LV_003050_0000_CER": "Je me demande si nous sommes\r\nsur le territoire de ce monstre...",
  "LV_003080_0010_CER": "S'il te plaît, emmène-moi au\r\ndernier noyau élémentaire !",
  "_31": "",
  "LV_003045_0020_NAR": "Mais ça ne la rassura pas\r\npour autant.",
  "SM_003080_0130_FAS": "« Dans une forteresse\r\nréservée aux fées les\r\nplus diaboliques. »",
  "BK_3020_0000_NAR": "Les griffes de Chouchou\r\nsemblaient dérisoires face\r\naux ailes d'acier de la créature.",
  "SM_003035_0160_CER": "« Très bien, Lukaon... je ferai\r\ntout ce qui est en mon pouvoir ! »",
  "BK_3000_0010_CER": "« La créature ! »",
  "SM_003035_0085_LUC": "« De plus... »",
  "LV_003910_0060_CER": "Maman... Maman croyait en moi !",
  "LV_003920_0020_CER": "Aaah...\r\nSuffit...\r\nSilence !",
  "LV_003070_0020_NAR": "Chouchou grondait furieusement.\r\nL'envie de se battre le démangeait.",
  "SM_003035_0100_LUC": "« Ton rêve...\r\nTu désires sauver ta mère,\r\nn'est-ce pas ? C'est un\r\nsentiment que je ne connais\r\nque trop bien. »",
  "SM_003080_0210_FAS": "« Si vous voulez que je vous guide,\r\nprévenez-moi. »",
  "SM_003030_0030_NAR": "Chouchou se mit à rouspéter\r\nqu'à courir partout pendant le\r\ncombat, Cereza l'avait gêné.",
  "SM_003035_0130_LUC": "« Il faut que j'aille sécher ses larmes ! »",
  "LV_003920_0010_CER": "Qu-Quoi ?!",
  "LV_003065_0000_CER": "On dirait que la créature a perdu ça...\r\nElle n'est donc pas invincible !",
  "LV_003070_0010_NAR": "[FONT:10 ]Comme si j'allais fuir, moi.[FONT:N ]",
  "SM_003080_0220_FAS": "« Ce sera ma façon de vous\r\nremercier de vous occuper\r\nde ces sales fées. »",
  "SM_003030_0000_NAR": "Ils avaient vaincu le monstrueux\r\nJabberwock. Cereza était folle\r\nde joie !",
  "SM_003030_0080_CER": "« Ah ! »",
  "SM_003050_0030_CER": "« Morgana, j'ai vaincu un\r\nmonstre gigantesque !\r\nTu aurais dû voir ça ! »",
  "CE_003040_0000_CER": "Chouchou !",
  "SM_003010_0060_NAR": "[FONT:9 ]Me gêne pas, ce sera déjà bien ![FONT:N ]\r\nSe contenta de dire le démon.",
  "SM_003040_0090_NAR": "[FONT:9 ]Si tu ne me renvoies pas en Enfer,\r\nla dernière chose que j'accomplirai\r\ndans ce monde minable sera de\r\nt'arracher chaque membre ![FONT:N ]\r\nRugit le féroce démon.",
  "SM_003040_0020_CER": "« Hmm ?\r\nOh, c-c'est rien.\r\n\r\nMais l'occasion est parfaite pour\r\nt'expliquer quelque chose. »",
  "SM_003010_0050_NAR": "Il se remémorait le combat.\r\nPour la première fois, il avait\r\ngoûté à la défaite, et ce goût\r\namer lui était insupportable.",
  "LV_003075_0010_CER": "Regarde toutes ces cages...",
  "SM_003010_0020_NAR": "Cereza se tenait là, les poings serrés.\r\nElle ne se pardonnait pas d'avoir\r\ncédé à sa peur.",
  "SM_003020_0060_NAR": "Galvanisée par le combat,\r\nCereza avait gagné de\r\nl'assurance. Chouchou, lui,\r\nétait de sale humeur.",
  "SM_003080_0020_FAS": "« Jamais j'aurais imaginé\r\nqu'une sorcière le battrait. »",
  "LV_003025_0010_NAR": "Cereza ne pouvait s'empêcher\r\nde penser que la forêt se liguait\r\ncontre elle.",
  "BK_3020_0080_NAR": "[FONT:9 ]Espèce de sale mauviette ![FONT:N ]\r\nMême sous forme de peluche,\r\nses paroles restaient tranchantes.",
  "LV_003030_0000_CER": "Qu'est-ce que c'était ?!",
  "SM_003080_0010_FAS": "« Et vous avez même éliminé\r\nJabberwock, ce monstre brutal...\r\nmême pour une fée. »",
  "SM_003035_0040_CER": "« Moi, c'est Cereza. »",
  "SM_003080_0180_FAS": "« Moi aussi, j'en ai marre de ces\r\nméchantes fées. J'espère bien\r\nque vous les rosserez ! »",
  "SM_003050_0200_CER": "« Pff, tu es pénible, parfois ! »",
  "LV_003900_0000_CER": "Wouhou !\r\nJe vole !",
  "LV_003915_0010_NAR": "« Ne pleure pas... sois forte ! »\r\nSe murmura-t-elle tout bas pour\r\nque Chouchou n'entende pas.",
  "SM_003035_0140_LUC": "« Je t'en prie, Cereza, tu dois briser la\r\nmalédiction. Détruis le dernier noyau\r\nélémentaire, rends-toi au cœur de la forêt,\r\net mon rêve... nos rêves se réaliseront !",
  "LV_003020_0010_CER": "Impossible... aucune créature n'a\r\ndes griffes pareilles... non ?",
  "LV_003035_0000_NAR": "[FONT:10 ]Tu veux trouver le dernier noyau\r\nélémentaire, non ? Alors bouge-toi ![FONT:N ]",
  "SM_003080_0050_CER": "« Non, tout va bien. »",
  "SM_003050_0150_NAR": "Lorsque Morgana eut disparu,\r\nChouchou gronda de colère.",
  "LV_003910_0020_CER": "Je ne... fuirai plus !",
  "SM_003050_0110_MOR": "« La forêt d'Avalon est protégée par la\r\npuissante magie des fées. Seul un\r\nsortilège tout aussi puissant pourra la\r\nbriser.\r\n\r\nJ'ai lancé une incantation, mais\r\nelle ne sera pas finie avant l'aube.\r\nTu dois survivre jusque-là. »",
  "SM_003080_0060_CER": "« Hé, dis-nous plutôt où trouver\r\nle dernier noyau élémentaire ! »",
  "LV_003040_0010_NAR": "C'était une cage, si grande qu'elle aurait pu\r\ncontenir le manoir de Morgana tout entier.",
  "LV_003055_0000_CER": "Nous approchons... Nous ne\r\nsommes plus très loin, je le sens.",
  "SM_003050_0080_MOR": "« Tu es mûre pour des techniques\r\nde magie plus puissantes.\r\nElles te permettront de tirer\r\npleinement parti des forces de\r\nton démon. »",
  "LV_003910_0000_CES": "Tu te sauves à chaque fois.\r\nC'est comme ça que tu comptes\r\ndevenir une sorcière ?",
  "CE_003030_0000_CER": "Oh, oh, qu'est-ce qui se passe, encore ?\r\nOn l'a énervé ?",
  "SM_003050_0050_MOR": "« C'est un miracle que tu t'en sois\r\nsortie sauve. Je t'avais ordonné\r\nde trouver une cachette ! »",
  "SM_003030_0090_NAR": "Interrompant leur dispute,\r\nils se mirent à la poursuite\r\ndu loup blanc.",
  "SM_003035_0030_LUC": "« Je suis Lukaon.\r\nEt toi ? »",
  "LV_003070_0000_CER": "Plus question de fuir.\r\nViens, Chouchou !",
  "SM_003030_0020_CER": "« C'est quoi ton problème, là ?\r\nOn a gagné ! »",
  "SM_003035_0000_LUC": "« Ainsi, vous avez vaincu le\r\nterrible Jabberwock. J'ai peine\r\nà croire que c'est toi, la gamine\r\nqui pleurnichait toute seule dans\r\nun sombre cauchemar. Comme\r\ntu es forte, à présent. »",
  "BK_3030_0040_NAR": "Ses griffes atteignirent leur cible,\r\nmais comme la fois d'avant,\r\nla créature y sembla insensible.",
  "LV_003920_0030_NAR": "[FONT:10 ]Ressaisis-toi ! Bouge ![FONT:N ]\r\nGronda le démon afin de\r\nramener Cereza à la réalité.",
  "SM_003050_0010_NAR": "La projection de Morgana\r\napparut à nouveau devant elle.\r\n\r\nElle semblait soulagée.",
  "SM_003050_0100_CER": "« Quoi ? »",
  "SM_003050_0060_MOR": "« Mais je dois reconnaître que je\r\nsuis surprise. Tu es peut-être devenue\r\nplus forte que je ne croyais. »",
  "LV_003005_0010_CER": "Quelqu'un nous espionnait... ?",
  "LV_003910_0030_CES": "Tu as peur, hein ? Alors va pleurer\r\ndans un coin, sale lâche !",
  "SM_003050_0180_NAR": "Chouchou répondit d'un\r\nreniflement dédaigneux.",
  "BK_3000_0000_NAR": "Miam miam...",
  "PH_3020_0010_CER": "Là !",
  "SM_003035_0090_CER": "« De plus quoi ? »",
  "LV_003075_0000_NAR": "Des cages brisées étaient\r\néparpillées partout.",
  "LV_003060_0010_CER": "Je dois bien pouvoir faire quelque chose !",
  "BK_3020_0060_NAR": "Chouchou tentait désespérément\r\nde se transformer, mais la panique\r\nde Cereza interférait avec sa magie,\r\net il demeurait une peluche.",
  "CE_003020_0010_CER": "Ugh !",
  "SM_003040_0000_NAR": "Une nouvelle rencontre avec Lukaon.\r\nSe rappelant son rêve, Cereza\r\nsentit son cœur frissonner d'émotion.",
  "SM_003010_0070_CER": "« ... »",
  "LV_003015_0000_CER": "Ouh là, comme c'est haut ! Tout ira bien...\r\nFaut juste pas regarder... en bas...",
  "SM_003040_0110_CER": "« J'ai rien dit ! Allons plutôt chercher\r\nce fameux noyau. »",
  "SM_003080_0160_FAS": "« Faut l'espérer... »",
  "BK_3020_0050_NAR": "Tel le faucon chassant la souris,\r\nla fée-dragon cherchait sa proie.",
  "LV_003045_0000_NAR": "[FONT:10 ]Si cette chose hideuse ose se montrer\r\nà nouveau, je la pulvérise ![FONT:N ]",
  "LV_003080_0000_CER": "Le loup blanc !\r\nOuf, tu vas bien !",
  "SM_003050_0210_NAR": "Instantanément, la bonne\r\nhumeur de Cereza disparut.",
  "SM_003010_0080_NAR": "Submergée par le désespoir,\r\nCereza entendit à peine\r\nces mots.",
  "SM_003080_0110_FAS": "« Eh bien eh bien... »",
  "SM_003080_0080_FAS": "« Ma chère... je t'ai déjà dit que la\r\nprécipitation ne te mènera à rien. »",
  "SM_003020_0040_CER": "« Quel soulagement... »",
  "SM_003035_0170_CER": "« Je veux en savoir plus sur toi.\r\nOn a tellement en commun ! »",
  "SM_003080_0120_FAS": "« Le dernier noyau élémentaire...\r\nse trouve dans une zone\r\nparticulièrement dangereuse. »",
  "BK_3020_0010_NAR": "La créature avait changé de cible.\r\nCereza savait qu'elle devait se\r\nbattre, mais la peur la pétrifiait.",
  "SM_003010_0030_CER": "« Les attaques de Chouchou\r\nn'ont même pas éraflé\r\nl'armure de cette créature...\r\n\r\nJ-Je fais quoi, moi, maintenant ? »",
  "SM_003040_0040_NAR": "Cereza raconta à Chouchou pourquoi elle\r\ns'était aventurée dans la forêt d'Avalon.\r\nL'apparition de Lukaon dans son rêve...\r\nSa mère qu'elle devait sauver...\r\nLe pouvoir qu'on lui avait promis, et\r\nqui l'attendait au cœur de la forêt.",
  "CE_003000_0000_CER": "Allez, laisse-moi t'aider !",
  "BK_3030_0120_CER": "« Plus question de fuir ! »",
  "SM_003035_0070_LUC": "« Un puissant sortilège me retient\r\nprisonnier au cœur de la forêt. »",
  "SM_003050_0170_CER": "« Oh, Morgana parle toujours ainsi.\r\nT'en fais pas, je sais bien que\r\ntu n'es pas juste une arme !\r\n\r\nMais ça te ferait pas de mal\r\nde m'écouter de temps à autre. »",
  "SM_003080_0150_CER": "« Oh, sûre et certaine !\r\nJe suis une sorcière. Et je suis\r\nbien plus forte que quand je suis\r\narrivée dans cette forêt ! »",
  "SM_003050_0020_MOR": "« Tu sembles... transformée.\r\nT'est-il arrivé quelque chose ? »",
  "BK_8110_0010_CER": "« Un souci ? Ça t'intéresse\r\nplus, d'obtenir de nouveaux\r\npouvoirs ? »",
  "BK_3030_0000_NAR": "Ils firent à nouveau face\r\nà la créature.",
  "CE_003800_0000_CER": "Ça, ça ferait très mal...\r\nConcentre-toi ! Avance !",
  "BK_3030_0110_CER": "« Non ! Pas cette fois-ci ! »",
  "SM_003030_0060_CER": "« Tu réalises que sans mon aide,\r\non aurait jamais gagné ? Un petit\r\n\"merci\", ça te coûterait quoi ? »"
}
