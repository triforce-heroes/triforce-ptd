  "CORE_ILLUSIONLIFT_NAME_TXT_49": "[RUBY:BASE ]粉骨[RUBY:BEGIN ]ふんこつ[RUBY:END ]の[RUBY:BASE ]試練[RUBY:BEGIN ]しれん[RUBY:END ]",
