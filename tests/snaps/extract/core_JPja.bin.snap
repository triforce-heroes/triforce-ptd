  "CORE_NPC_TXT_05": "[RUBY:BASE ]冒険[RUBY:BEGIN ]ぼうけん[RUBY:END ]の[RUBY:BASE ]進[RUBY:BEGIN ]すす[RUBY:END ]み[RUBY:BASE ]具合[RUBY:BEGIN ]ぐあい[RUBY:END ]を[RUBY:BASE ]記録[RUBY:BEGIN ]きろく[RUBY:END ]します。",
  "CORE_MISSION_TEXT_0004": "[RUBY:BASE ]敵[RUBY:BEGIN ]てき[RUBY:END ]を[RUBY:BASE ]倒[RUBY:BEGIN ]たお[RUBY:END ]すと[RUBY:BASE ]地面[RUBY:BEGIN ]じめん[RUBY:END ]に[RUBY:BASE ]呪[RUBY:BEGIN ]のろ[RUBY:END ]いが[RUBY:BASE ]残[RUBY:BEGIN ]のこ[RUBY:END ]る！\r\n[RUBY:BASE ]注意[RUBY:BEGIN ]ちゅうい[RUBY:END ]しながら[RUBY:BASE ]敵[RUBY:BEGIN ]てき[RUBY:END ]を[RUBY:BASE ]倒[RUBY:BEGIN ]たお[RUBY:END ]せ！",
  "CORE_WH_TALK_20_COL": "[RUBY:BASE ]仲間[RUBY:BEGIN ]なかま[RUBY:END ]たちはまだ[RUBY:BASE ]森[RUBY:BEGIN ]もり[RUBY:END ]にいるはず……。\r\nみんなのこと、[RUBY:BASE ]頼[RUBY:BEGIN ]たの[RUBY:END ]んだよ……！",
