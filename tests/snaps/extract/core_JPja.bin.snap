  "CORE_POSEMENU_TXT_02": "[RUBY:BASE ]遊[RUBY:BEGIN ]あそ[RUBY:END ]び[RUBY:BASE ]方[RUBY:BEGIN ]かた[RUBY:END ]を[RUBY:BASE ]確認[RUBY:BEGIN ]かくにん[RUBY:END ]します。",
  "CORE_POSEMENU_TXT_11": "[RUBY:BASE ]物語[RUBY:BEGIN ]ものがたり[RUBY:END ]の[RUBY:BASE ]続[RUBY:BEGIN ]つづ[RUBY:END ]きから[RUBY:BASE ]遊[RUBY:BEGIN ]あそ[RUBY:END ]ぶことができます。",
  "CORE_WISP_TALK_17_H03": "[RUBY:BASE ]俺[RUBY:BEGIN ]おれ[RUBY:END ]を[RUBY:BASE ]助[RUBY:BEGIN ]たす[RUBY:END ]けてくれたのか……[RUBY:BASE ]恩[RUBY:BEGIN ]おん[RUBY:END ]に[RUBY:BASE ]着[RUBY:BEGIN ]き[RUBY:END ]る。\r\nよし！　[RUBY:BASE ]扉[RUBY:BEGIN ]とびら[RUBY:END ]を[RUBY:BASE ]開[RUBY:BEGIN ]あ[RUBY:END ]けるからついて[RUBY:BASE ]来[RUBY:BEGIN ]き[RUBY:END ]てくれ！",
  "TA_9011_0010_COL": "[RUBY:BASE ]気[RUBY:BEGIN ]き[RUBY:END ]を[RUBY:BASE ]付[RUBY:BEGIN ]つ[RUBY:END ]けてね、おねえちゃん",
