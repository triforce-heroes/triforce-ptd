  "CORE_ILLUSIONLIFT_NAME_TXT_42": "[RUBY:BASE ]暴走[RUBY:BEGIN ]ぼうそう[RUBY:END ]の[RUBY:BASE ]試練[RUBY:BEGIN ]しれん[RUBY:END ]",
