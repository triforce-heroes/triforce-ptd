  "CORE_ILLUSIONLIFT_NAME_TXT_55": "[RUBY:BASE ]妖光[RUBY:BEGIN ]ようこう[RUBY:END ]の[RUBY:BASE ]試練[RUBY:BEGIN ]しれん[RUBY:END ]",
