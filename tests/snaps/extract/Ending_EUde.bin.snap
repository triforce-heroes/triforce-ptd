{
  "BK_7000_0100_NAR": "Cereza wusste nicht, was mit Feenseelen\r\ngeschah in dieser chaotischen Welt,\r\ndoch wohin auch immer Lukaon ging,\r\nsie hoffte, er würde dort Frieden finden.",
  "BK_7000_0080_LUC": "„Ich bin glücklich, dass ich dich...\r\nein letztes Mal habe sehen können...“",
  "BK_7010_0030_CER": "„Dieses Tor bringt dich\r\nzurück nach Inferno.“",
  "BK_7010_0120_NAR": "Stille kehrte wieder ein im Wald von\r\nAvalon. Cereza spürte, wie die ersten\r\nStrahlen der Morgendämmerung sie in\r\neine Wärme einhüllten, als wollten\r\nsie den Schmerz der Nacht fortspülen.",
  "BK_7010_0040_CER": "„Geh schon, es wird sich bald schließen...“",
  "BK_7020_0000_CER": "„Ich habe es geschafft, Mutter. Ich\r\nbin jetzt eine starke Hexe. Und ich\r\nwerde noch stärker werden. Du musst\r\ndir also keine Sorgen mehr machen.“",
  "BK_7020_0030_CER": "„Mutter!“",
  "BK_7020_0040_ROS": "„Du bist zu einer prächtigen\r\nHexe geworden, Cereza.\r\nDu wirst gut zurechtkommen...“",
  "BK_7000_0170_NAR": "Dieses Schicksal wartet letztlich\r\nauf jede Umbra-Hexe: Sie sind\r\nverdammt dazu, auf ewig durch die\r\nTiefen von Inferno zu irren.",
  "BK_7000_0090_MOR": "„Gute Nacht, mein Sohn.\r\nTräum schön...“",
  "BK_7000_0030_NAR": "\r\nDie Zeit des Abschieds rückte näher.",
  "SM_007020_0000_JEA": "„Sieht aus, als kämst du jetzt\r\nohne mich zurecht, Cereza.“",
  "BK_7020_0060_NAR": "Begegnungen und Abschiede...\r\nCereza dachte an das Versprechen,\r\ndas sie ihrem Freund gegeben hatte,\r\nund ihr wurde klar, dass sie etwas\r\nUnersetzliches gewonnen hatte.",
  "BK_7010_0020_NAR": "Die Reise hatte den Dämon sehr\r\nerschöpft. Mit Mühe und Not hielt\r\ner die Augen offen und starrte\r\nnachdenklich den Weg nach Hause an.",
  "BK_7000_0010_LUC": "„Cereza... Cheshire...“",
  "BK_7000_0020_LUC": "„Es war richtig von euch,\r\nmeine Mutter aufzuhalten.\r\nIch fühle mich geehrt, dass ich\r\neuch beiden begegnen durfte.“",
  "BK_7010_0090_CER": "„Ich werde noch viel stärker,\r\nversprochen!“",
  "BK_7010_0010_NAR": "Doch das Portal wurde bereits\r\ninstabil. Es würde sich jeden\r\nMoment wieder schließen.",
  "BK_7020_0050_NAR": "Von diesem Tage an sah\r\nCereza jenen Albtraum,\r\nder sie einst heimgesucht\r\nhatte, nie wieder.\r\n",
  "BK_7000_0050_LUC": "„Aber das sind wir doch, Cereza...\r\nUnd dafür bin ich dankbar.“",
  "BK_7010_0045_NAR": "Cheshire sah Cereza an. Sein Gesicht\r\nverriet, was sie beide dachten:\r\n[FONT:9 ]Wenn ich zurückgehe,\r\nbist du ganz allein.[FONT:N ]",
  "SM_007010_0000_JEA": "Ich wusste, du schaffst es.",
  "BK_7010_0100_NAR": "Ein gewaltiges Tosen\r\nerfasste das Portal.\r\nDoch Cheshires Stimme\r\ndurchdrang den Lärm:\r\n[FONT:9 ]„Ich erwarte nichts Geringeres!“[FONT:N ]",
  "BK_7020_0010_ROS": "„Cereza.“",
  "BK_7000_0040_CER": "„Ich wünschte...\r\nwir hätten Freunde sein können.“",
  "BK_7000_0150_NAR": "Das Ende von Morgana\r\nder Hexe war gekommen.",
  "BK_7000_0175_NAR": "Cereza wandte den Blick nicht ab.\r\nSie sah mit an, wie Morganas Seele in die Unterwelt gezogen wurde.",
  "BK_7000_0160_NAR": "Ihr friedliches Gesicht wich\r\neinem Ausdruck von Qualen.\r\nEs war nur schwer mit anzusehen.",
  "BK_7010_0050_CER": "„Nach allem, was wir erlebt haben,\r\nbehandelst du mich immer noch\r\nwie ein kleines Kind? Warte nur!\r\nBald bin ich stark genug, um dich\r\nselbst heraufzubeschwören.“",
  "BK_7010_0060_CER": "„Also ruh dich einfach ein wenig aus, ja?“",
  "BK_7020_0070_NAR": "Die Nacht war noch jung...\r\nDas Mondlicht wies Cereza den Weg,\r\nals sie zu neuen Abenteuern aufbrach.",
  "SM_007020_0010_CER": "„Jeanne... Danke.\r\nWir sehen uns wieder,\r\nwenn das hier vorbei ist.“",
  "BK_7010_0000_NAR": "Cheshire bemerkte, dass diese\r\nunerwartete Wendung ihm genau\r\ndas gebracht hatte, was er suchte:\r\nEin Zugang zu Inferno lag vor ihm.",
  "BK_7010_0110_CER": "„Und wehe, du bist kein höllisch\r\nstarker Dämon, wenn wir uns das\r\nnächste Mal sehen!“",
  "SM_007010_0010_JEA": "Komm, gehen wir!",
  "BK_7000_0060_NAR": "Mutter und Kind umarmten\r\neinander zärtlich.\r\nVon dieser Wärme hatte\r\ner immer geträumt.",
  "BK_7010_0070_NAR": "Cheshire schwieg und\r\nwandte sich dem Portal zu.",
  "BK_7000_0070_LUC": "„Danke, dass du stets über\r\nmich gewacht hast, Mutter.\r\nDu kannst nun ruhen...“"
}
