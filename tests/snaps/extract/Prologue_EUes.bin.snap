{
  "SM_000040_0050_NAR": "Pero, a pesar de sus buenas\r\nintenciones, no pudo evitar\r\nmirar hacia el bosque.",
  "BK_0020_0000_NAR": "Cuando hubo completado sus tareas,\r\nllegó la hora de la práctica\r\ndiaria de artes oscuras.",
  "SM_000070_0090_CER": "—¡Nada es suficiente para ella!\r\n¿Has visto las hierbas?\r\n¡Eran perfectas!",
  "BK_0020_0030_NAR": "Antes de saber para qué servía,\r\nCereza ya había quedado cautivada\r\npor el intrincado brazalete.",
  "SM_000020_0050_CER": "—Jeanne... No... No puedo...",
  "SM_000070_0020_NAR": "De repente, recordó\r\nlas palabras del chico del sueño.",
  "LV_000050_0000_CER": "¡No!...",
  "BK_0010_0070_NAR": "Era un sueño que se sabía de memoria.\r\nPero esta vez había algo distinto.",
  "LV_000900_0000_NAR": "[FONT:10 ]No estoy de humor para alimañas.\r\n¡Preparaos para mis garras![FONT:N ]\r\nEl demonio se abalanzó sobre las hadas.",
  "SM_000040_0180_MOR": "",
  "SM_000055_0070_CER": "—El color de estas flores hará\r\njuego con los ojos de Morgana.",
  "SM_000040_0060_NAR": "Morgana no lo pasó por alto.",
  "SM_000060_0070_MOR": "—Ah, por cierto, Cereza,\r\ntu pelo carece hoy del brillo habitual.\r\n¿No habrás descuidado\r\ntambién tu cabello, además\r\nde las tareas del jardín?",
  "LV_000035_0000_CER": "¿Qué?",
  "SM_000060_0110_CER": "—Entendido. Me encargaré de todo\r\nantes del entrenamiento de hoy.",
  "SM_000020_0060_JEA": "—Venga, deja de lloriquear.",
  "SM_000060_0080_CER": "—¡No, señora, ahora me iba a poner!",
  "SM_000070_0030_LUC": "—Cereza... te doy...\r\npoder para salvar a tu madre...",
  "SM_000060_0000_NAR": "Cereza, orgullosa, le entregó la cesta a Morgana.\r\nEstaba repleta.",
  "LV_000105_0000_CER": "Un poco más.",
  "BK_0000_0050_NAR": "Su único consuelo eran las noches\r\nen que se escabullía para ir a la cárcel a ver a su madre.",
  "SM_000060_0185_NAR": "Aquella noche...",
  "SM_000050_0040_NAR": "Cuánto le habría gustado que\r\nesta tarea no formara parte de\r\nsus deberes...",
  "LV_000905_0000_CER": "Un cofre...\r\n¿Será de las hadas?\r\n¿Qué habrá dentro?",
  "BK_0000_0060_NAR": "\r\nSu madre apenas podía moverse en la gélida y miserable celda.\r\nPero, cuando su hija iba a verla, la bruja siempre le ofrecía su mejor sonrisa.",
  "LV_000090_0000_CER": "¡A cenar!\r\n¡Marchando una ración de magia!",
  "LV_000085_0010_NAR": "Crecían bajo tierra para evitar la luz del sol,\r\npero brotaban con un poco de magia.",
  "SM_000050_0070_NAR": "Cereza se dirigió al jardín\r\nde hierbas intentando no pensar\r\nen la tarea que la aguardaba.",
  "IN_0010_0040_JEA": "¡Ya casi estamos! ¡Corre!",
  "SM_000060_0030_NAR": "Sobre las hierbas había una\r\npequeña corona. Morgana echó un vistazo.",
  "IN_0025_0002_JEA": "¡Cereza!",
  "SM_000050_0000_NAR": "Tras comprobar de un vistazo que el cubo\r\nestaba lleno, Morgana hizo un gesto de aprobación.",
  "LV_000055_0000_MOR": "¡Cereza! ¡Cerezaaa!",
  "BK_0000_0010_NAR": "Los clanes establecieron reglas\r\nmuy estrictas para garantizar\r\nla paz, pero una pareja de amantes\r\ndesgraciados contravino la ley,\r\ny de aquella unión nació una criatura\r\ncon sangre de sabio y de bruja.",
  "BK_0010_0020_LUC": "—Cereza... te doy...\r\npoder para salvar a tu madre...",
  "LV_000005_0000_CER": "Ahí hay algo...",
  "SM_000060_0040_NAR": "Sin cambiar de expresión,\r\nle habló a Cereza en el tono de siempre.",
  "SM_000020_0020_JEA": "—¿Pero qué haces?",
  "IN_0010_0000_JEA": "¡De prisa, Cereza,\r\nno tenemos toda la noche!",
  "LV_000935_0000_CER": "Es casi la hora de la práctica de hoy.\r\nSi no me doy prisa, me tocará reprimenda.",
  "BK_0020_0200_NAR": "Morgana hizo caso omiso\r\nde sus ruegos y se dio media vuelta.",
  "BK_0000_0020_NAR": "Era una hermosa niña.",
  "SM_000070_0050_NAR": "La mirada de Cereza volvió al bosque.\r\nLas advertencias de Morgana no dejaban\r\nlugar a la ambigüedad. Pero...",
  "IN_0010_0030_CER": "—¡G-gracias!",
  "SM_000070_0140_CER": "—Estoy segura de que, si hubiera\r\npodido probar otra vez, habría\r\nlogrado controlar a ese demonio\r\nsin problema.",
  "IN_0000_0040_WIC": "—¿Qué crees que estás haciendo?",
  "BK_0010_0110_CER": "El bosque prohibido...",
  "IN_0000_0030_WID": "¡No deberías estar aquí!",
  "SM_000055_0000_CER": "—¡Lo he conseguido!",
  "SM_000040_0100_CER": "—Sí, Morgana, lo sé...",
  "SM_000055_0030_CER": "—¡Qué ganas tengo de ver\r\nla cara que pone Morgana!",
  "SM_000030_0000_JEA": "—¡Oh, no! Nos han descubierto.\r\nYo me encargo de los guardias.\r\n¡Tú sigue avanzando!",
  "IN_0025_0004_JEA": "¡Por aquí!",
  "SM_000040_0110_MOR": "—Entonces, deja de soñar\r\ndespierta y acaba las tareas\r\nantes de que salga la luna, señorita.",
  "BK_0010_0060_CER": "—Otra vez ese sueño...\r\nPero el final...",
  "SM_000040_0160_NAR": "Cereza intentaba recordar\r\nque las tareas formaban parte\r\nde su formación.",
  "LV_000080_0000_NAR": "Llevar un cubo lleno de agua...\r\nPodría parecer sencillo,",
  "BK_0020_0100_NAR": "Cereza estaba de muy buen humor,\r\nconvencida de que por fin lo lograría.",
  "SM_000070_0080_NAR": "Cereza pensaba en las afrentas que\r\nhabía soportado y le hervía la sangre.",
  "SM_000070_0110_NAR": "Mientras se desahogaba con Cheshire,\r\nvio de repente cómo brillaba\r\nel brazalete mágico bajo la luna.",
  "BK_0010_0140_NAR": "Morgana, la maestra de Cereza, la esperaba junto a la puerta.\r\nIncluso desde lejos se le notaba el ceño fruncido.",
  "SM_000040_0040_CER": "—¡Sí, señora, de inmediato!",
  "SM_000040_0150_NAR": "Morgana también había sido\r\nexpulsada del pueblo. Ella\r\nentendía bien el dolor de Cereza,\r\ny su frialdad no era más que\r\nsu forma de expresar cariño.",
  "BK_0010_0130_MOR": "—Cereza, ¿dónde estás, niña?",
  "BK_0010_0050_CER": "—¡Iré, lo prometo!",
  "SM_000060_0020_CER": "—También he cortado estas violetas...\r\nSon para ti.\r\nHe pensado que te gustarían...",
  "SM_000060_0130_NAR": "Dicho esto, Morgana se dio media vuelta\r\ny regresó al calor del hogar.",
  "SM_000050_0060_CER": "—¡No, señora!",
  "LV_000910_0000_CER": "¡E-eh! ¡Ya está bien!",
  "BK_0000_0150_NAR": "Se llamaba Cereza.",
  "IN_0025_0003_JEA": "¡Nos van a encontrar!",
  "LV_000110_0000_CER": "¡Perfecto!",
  "SM_000060_0010_CER": "—¿Qué te parece, Morgana?\r\nMenuda cosecha, ¿verdad?",
  "LV_000020_0000_CER": "¡V-vale!",
  "BK_0000_0120_NAR": "La niña abandonó el pueblo\r\ny fue acogida por una bruja\r\nexiliada que vivía a las afueras.",
  "LV_000920_0000_CER": "—¿Mamá?",
  "SM_000060_0090_MOR": "—Recuerda, Cereza...",
  "IN_0020_0030_WIA": "¡Menuda carga!",
  "SM_000020_0080_JEA": "",
  "SM_000060_0170_NAR": "Enseguida recuperó su buen ánimo\r\ny decidió acabar con sus tareas\r\nen tiempo récord.",
  "SM_000060_0100_MOR": "—El cabello es la herramienta más versátil\r\nde una bruja de Umbra. Puede tornarse\r\nen armadura, arma o incluso medio\r\nde invocación de demonios infernales.\r\nAl igual que la sangre corre por las venas,\r\nla magia fluye por el pelo de una bruja.\r\nCuídalo como si de la herramienta\r\nmás preciosa se tratase, y defiéndelo\r\ncomo defenderías tu propio corazón.",
  "LV_001025_0010_NAR": "En cuanto Cheshire percibió el olor,\r\nse retiró con disgusto.",
  "LV_000120_0000_CER": "Puaj... Si no fuera por el olor,\r\nno me importaría tanto...",
  "SM_000070_0170_LUC": "—El bosque de Ávalon...\r\nEl lobo blanco... guiará...",
  "IN_0020_0000_WIA": "¿Por qué no te marchas?",
  "LV_001025_0020_NAR": "Al parecer, los demonios no podían\r\nsoportar estar cerca de estas plantas.",
  "BK_0000_0080_NAR": "El día en que la niña cumplió\r\ndiez años, llevaron a su madre\r\na una celda aún más profunda,\r\nun lugar que ni el más ínfimo rayo\r\nde luz podía penetrar.",
  "LV_000010_0000_CER": "¿Por qué decís eso?",
  "BK_0000_0110_NAR": "De aquello han pasado ya muchas lunas.",
  "LV_00015_0010_CER": "¡Jeanne, espera!\r\nHaces que todo\r\nparezca muy fácil.",
  "LV_000075_0000_CER": "Ufff...\r\n¡Solo tenía que llenarlo hasta el borde!",
  "PH_0020_0010_NAR": "Ni siquiera sospechaba que aquello\r\nque la aguardaba en el oscuro bosque\r\ncambiaría su destino para siempre.",
  "SM_000055_0020_NAR": "Normalmente, incluso hechizos\r\nrudimentarios como este le salían mal.",
  "BK_0010_0010_CER": "—¿Quién eres?",
  "SM_000055_0010_NAR": "Cereza se llevó una agradable sorpresa.",
  "IN_0000_0010_WIB": "Nos traerá la desgracia...",
  "LV_000125_0000_NAR": "Cereza se estremeció pensando\r\nen qué la esperaba más allá.\r\nPero la curiosidad pudo con ella.",
  "SM_000070_0150_NAR": "Acompañada de un demonio,\r\nseguro que aniquilar a una hada\r\no dos sería pan comido.",
  "SM_000070_0040_CER": "—«El bosque de Ávalon...»",
  "BK_0020_0140_NAR": "La situación era delicada. A menos que\r\nlo amarrara con el cabello, no lograría\r\ncontrolar al demonio.",
  "BK_0000_0040_NAR": "El clan de las brujas acogió\r\na la pequeña, pero creció repudiada\r\ncomo una paria, maldita por las\r\ncircunstancias de su nacimiento.",
  "BK_0020_0210_MOR": "—¿Qué clase de bruja teme\r\na su propia invocación?\r\nY pensar que creía que estabas\r\npreparada para esta práctica...",
  "SM_000020_0070_JEA": "—¡Ven! ¡Sígueme!",
  "SM_000020_0040_JEA": "—¡Se acaba el tiempo, Cereza!\r\nEs tu última oportunidad...\r\nSi no te das prisa, no podrás\r\nvolver a ver a tu madre jamás.",
  "SM_000060_0050_MOR": "—Este tipo de naderías no te\r\ngranjearán ningún elogio por mi parte.",
  "BK_0000_0070_NAR": "Sin embargo, incluso estos\r\nmomentos felices tocaron a su fin.",
  "LV_000040_0000_CER": "Ugggh... ¡Urggg!",
  "BK_0010_0040_LUC": "—El bosque de Ávalon...\r\nEl lobo blanco... guiará...",
  "LV_000085_0000_NAR": "Las hierbas del jardín de Morgana no eran\r\nni albahaca, ni tomillo, nada de eso. Ella cultivaba\r\nplantas infernales, que emanaban un hedor absoluto.",
  "SM_000050_0010_MOR": "—Bien. Ahora recoge las hierbas\r\ndel jardín.",
  "SM_000070_0000_NAR": "Cereza se quedó desanimada\r\nen el jardín. Como de costumbre,\r\nempezó a contarle sus penas\r\na Cheshire.",
  "BK_0020_0060_MOR": "—Además, hoy practicamos bajo\r\nla luna llena de la noche bisiesta.\r\nCuando la energía oscura que las\r\nUmbra empleamos llegue a su cénit...\r\n\r\n¿Me estás escuchando, jovencita?",
  "BK_0020_0010_NAR": "Hoy al fin iba a intentar algo\r\nque llevaba semanas\r\npracticando: ¡la invocación\r\nde un demonio infernal!",
  "LV_000025_0000_CER": "Un poco más...\r\n¡Aguanta, mamá!",
  "BK_0020_0090_CER": "—Sí, señora.",
  "LV_000115_0000_CER": "Eso bastará, ¿no?",
  "SM_000010_0000_CER": "He de darme prisa...",
  "SM_000040_0000_MOR": "—Me encuentro las tareas sin hacer,\r\ny a mi aprendiza echando un sueñecito...",
  "LV_000915_0000_CER": "Hala...\r\n¡Jeanne, eres increíble!",
  "BK_0020_0050_MOR": "—Es una herramienta para quienes\r\naún no dominan el flujo de la magia.",
  "IN_0000_0020_WIC": "¡Alejaos: no confiéis en ella!",
  "SM_000070_0120_CER": "—¿Qué dices, Pimpollo?\r\n¿Que coja el brazalete y me vaya al bosque?\r\n¡Menudo azote nos daría\r\nMorgana si nos pillase!",
  "BK_0010_0090_CER": "—Apareció un chico extraño\r\ny me dijo algo increíble:\r\nque, si voy al bosque de Ávalon,\r\nme dará un poder fantástico.",
  "LV_000015_0000_CER": "¡Jeanne, espera!\r\nNo puedo correr tan rápido.",
  "SM_000040_0070_MOR": "—Te lo he dicho una y mil veces...\r\nJamás se te ocurra adentrarte en el bosque.",
  "BK_0010_0100_CER": "—Con ese poder, sería\r\nfacilísimo rescatar a mamá.",
  "BK_0020_0020_MOR": "—Hoy, para practicar,\r\nvoy a prestarte algo de ayuda.",
  "LV_000925_0000_CER": "¿Qué es esto? ¡No os acerquéis!",
  "BK_0020_0180_MOR": "—Hemos acabado por hoy.",
  "SM_000070_0160_CER": "—¡Decidido: me voy al bosque!\r\nY cuando vuelva con ese\r\nfantástico poder, Morgana\r\ntendrá que retirar lo que dijo\r\nde que no estoy preparada.\r\nVamos, Pimpollo. ¡Ávalon nos espera!",
  "SM_000070_0070_NAR": "Los adultos suelen exagerar para\r\nmantener a los niños bajo control.",
  "SM_000020_0000_CER": "—Mamá...",
  "SM_000040_0120_CER": "—Sí... agua del pozo,\r\n¡marchando!",
  "SM_000040_0030_NAR": "Cereza empezó a poner excusas,\r\npero, al ver la cara de Morgana,\r\ndesistió.",
  "IN_0025_0001_JEA": "¡No te entretengas!",
  "BK_0020_0220_NAR": "Morgana le dijo a Cereza\r\nque se quitase el brazalete\r\nmágico antes de volver a casa.",
  "SM_000060_0140_CER": "—Sí, señora...",
  "BK_0000_0000_NAR": "Hace mucho mucho tiempo había\r\ndos clanes: los Lumen, sabios de\r\nla luz, y las Umbra, brujas de las\r\ntinieblas. Juntos controlaban\r\nun misterioso poder.",
  "LV_000940_0000_CER": "Es como si mis hechizos fueran\r\nmás potentes... ¿Será por el brazalete?",
  "LV_000005_0010_CER": "Este lugar...",
  "LV_000055_0010_MOR": "¡¿Dónde estás, Cereza?!",
  "SM_000050_0050_MOR": "—¿Algún problema?",
  "BK_0000_0030_NAR": "Como castigo por su amor\r\nprohibido, los amantes fueron\r\nseparados: el padre fue exiliado\r\na una tierra remota, y la madre,\r\nencerrada en una solitaria celda.",
  "SM_000050_0020_NAR": "Al pensar en las hierbas,\r\na Cereza se le torció el gesto.",
  "IN_0010_0010_JEA": "¡Usa esto!",
  "LV_000070_0000_CER": "¡Mmmpñiii!",
  "SM_000030_0010_CER": "—¡Espera, Jeanne!\r\nNo puedo hacerlo sola.",
  "BK_0000_0140_NAR": "Quería llegar a ser una poderosa bruja\r\npara salvar así un día a su madre.",
  "SM_000070_0130_NAR": "Pero, con la brillante luz de la luna,\r\nla situación era ideal para una\r\npequeña excursión nocturna al bosque.",
  "BK_0020_0120_NAR": "Paso a paso, Cereza\r\ncompletó sin errores la danza\r\nde la invocación. Y entonces...",
  "SM_000040_0090_MOR": "—Dada tu falta de pericia,\r\nno tardarías en caer presa\r\nde alguna de las hadas\r\nque lo habitan.",
  "LV_000095_0000_CER": "¡Sal de ahí!",
  "IN_0025_0000_JEA": "¡Date prisa!",
  "SM_000040_0170_NAR": "Se apresuró hacia el pozo\r\npara complacer a su maestra.",
  "LV_000080_0010_NAR": "pero requiere un preciso control, y es\r\nun entrenamiento de Umbra perfecto.",
  "SM_000040_0140_NAR": "A pesar de su apariencia estricta,\r\nCereza apreciaba a su maestra.",
  "LV_000100_0000_CER": "¡Muy bien!",
  "IN_0000_0000_WIA": "¡La niña impura!",
  "SM_000040_0130_MOR": "—Me basta con un «sí».\r\nY ahora, ve.",
  "SM_000055_0040_NAR": "Cereza empezó a tararear una alegre\r\nmelodía mientras recogía las hierbas.\r\nEntonces vio una hermosa flor\r\nque crecía entre la maleza.",
  "LV_000030_0000_CER": "¡Mamá!",
  "LV_000060_0000_MOR": "Cereza,\r\n¿has acabado tus tareas?",
  "SM_000070_0010_CER": "—¿Así voy a regresar al pueblo\r\na rescatar a mamá? A este paso,\r\nni siquiera lograré ser bruja.",
  "BK_0020_0190_CER": "—Déjame volver a probar,\r\n¡por favor!",
  "BK_0010_0120_NAR": "Cereza recordó la advertencia de su maestra:\r\n«En el bosque de Ávalon viven las hadas, unos\r\nseres que secuestran a niños. ¡Mantente lejos de allí!».",
  "BK_0010_0030_CER": "—¿Poder?",
  "BK_0020_0160_NAR": "El demonio se convirtió\r\nen cenizas ante Cereza.\r\nLos demonios no pueden vivir\r\nen nuestro mundo sin el medio adecuado.",
  "PH_0020_0000_NAR": "Y así, Cereza decidió hacer caso omiso\r\nde las advertencias de su profesora\r\ny se dirigió al bosque de Ávalon.",
  "SM_000070_0060_CER": "—Morgana siempre está con que si eso\r\nes peligroso, con que no me acerque\r\na tal sitio... Pero ¿por qué habría\r\nde asustarme de un viejo bosque?",
  "BK_0020_0080_MOR": "—Hoy te veo muy decidida.\r\nQuizás debería dejarte echar\r\nla siesta más a menudo.",
  "LV_000930_0000_CER": "¡No sabía que podían hacer esto!\r\n¡Tengo que atraparla, rápido!",
  "LV_000130_0000_CER": "Vamos, Pimpollo.",
  "SM_000040_0010_CER": "—Lo siento. Solo había\r\ncerrado los ojos un segundo...",
  "LV_000945_0010_CER": "Qué desagradable...",
  "BK_0010_0080_NAR": "Cereza decidió consultar\r\ncon su amigo Cheshire.",
  "LV_001025_0000_NAR": "El fuerte aroma le hizo cosquillas a Cereza\r\nen la nariz. Era romero, una hierba\r\ntípica para ahuyentar espíritus.",
  "LV_000065_0000_CER": "Mmmpfff... Mmmpf...",
  "IN_0020_0020_WIA": "¡Le está bien empleado!",
  "SM_000060_0160_NAR": "Aunque sabía que solo quería\r\nlo mejor para ella.",
  "BK_0000_0130_NAR": "Bajo su estricta supervisión,\r\ncontinuó su aprendizaje\r\nde las artes oscuras.",
  "BK_0000_0100_NAR": "Más sola que nunca, la niña se aferró a lo único que\r\ntenía: un gato de peluche que le había hecho su madre.\r\nSe llamaba Cheshire o, cariñosamente, «Pimpollo».",
  "LV_000010_0010_CER": "¡Dejadme en paz!",
  "BK_0000_0090_NAR": "Desesperada, la niña\r\nintentó rescatarla.\r\nPero aún era demasiado\r\njoven, y el intento fracasó.",
  "SM_000060_0120_MOR": "—Bien. Ahora, vuelve al trabajo.\r\nLas sombras se alargan;\r\npronto aparecerá la luna.",
  "SM_000060_0150_NAR": "En ocasiones, Cereza se entristecía\r\npor la frialdad de Morgana.",
  "IN_0020_0010_WIA": "¡Nadie te quiere!"
}
