{
  "MENU_HELP_TXT_019_01": "전투 중, 허그 모드 상태면\r\n마력 회복 속도가 오르는 스킬입니다.",
  "MENU_HELP_TXT_103_02": "체셔의 체력은 허그 모드로\r\n전환하면 회복됩니다.",
  "MENU_HELP_TXT_115_01": "언리시 모드일 때 [BTN:R2 ]을\r\n길게 눌렀다 떼면\r\n체셔가 돌진 공격을 하는 스킬입니다.",
  "MENU_HELP_TXT_021_01": "허그 모드 상태에서\r\n[BTN:RS ]으로 체셔를 늘여서\r\n적의 원거리 공격을 튕겨 내는 스킬입니다.",
  "MENU_HELP_TXT_204_01": "메뉴 화면의 아카이브에서는\r\n캐릭터나 적의 정보,\r\n주운 수기의 내용 등을\r\n볼 수 있습니다.",
  "MENU_SKILLTREE_DIALOG_TXT_01": "스킬을 연습할 수 있습니다.\r\n연습장으로 이동하시겠습니까?",
  "MENU_HELP_TXT_212_02": "세레자가 스킬을 습득하기 위해선\r\n오닉스 로즈가,\r\n체셔가 스킬을 습득하기 위해선\r\n아발론 드롭이 각각 필요합니다.",
  "MENU_HELP_TXT_104_01": "변신한 체셔의 공격은\r\n일반 공격보다 큰 위력을\r\n갖고 있습니다.",
  "MENU_HELP_TXT_112_02": "각성 상태가 된 체셔는\r\n[BTN:L1 ]로 회피하고,\r\n[BTN:R1 ]로 강력한 공격을 펼칩니다.",
  "MENU_HELP_TXT_249_01": "월드 맵과 길 안내에서는 이그니스가\r\n목적지에서 가까운 지역을\r\n추천해 줍니다.",
  "MENU_HELP_TXT_008_01": "사용 아이템은 여러 효과가 있습니다.\r\n가지고 있는 사용 아이템은\r\n[BTN:DP ]을 길게 눌러 쓸 수 있습니다.",
  "MENU_HELP_TXT_215_01": "인형 상태의 체셔를 안고\r\n같이 이동하는 상태를\r\n\"허그 모드\"라고 합니다.",
  "MENU_HELP_TXT_211_01": "모험 준비에서는\r\n세레자와 체셔의 의상을\r\n바꿀 수 있습니다. 의상은\r\n조건을 만족하면 얻을 수 있습니다.",
  "MENU_HELP_TXT_207_02": "마녀의 은신처는 가까이 가면\r\n개방되며 지도에 기록됩니다.\r\n마녀의 은신처를 발견하면\r\n반드시 들러 둡시다.",
  "MENU_SKILLTREE_TXT_327": "[BTN:L2 ]을 누른 상태로 [BTN:LS ]을 돌리면\r\n부서진 물건을 복구한다.",
  "MENU_HELP_TXT_229_01": "일부 도깨비불은 도와주면\r\n세레자 뒤를 따라옵니다.\r\n하지만 도깨비불은 공격받으면\r\n순식간에 당합니다.",
  "MENU_SKILLTREE_TXT_423": "불속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n불의 오의가 된다.",
  "MENU_HELP_TXT_129_01": "허그 모드일 때 이동 방향으로\r\n[BTN:RS ]을 기울여 체셔를 늘이면\r\n이동 속도가 조금 오르는 스킬입니다.",
  "MENU_SKILLTREE_TXT_427": "체셔의 공격에 따라\r\n적에게 주는 대미지가 더욱 늘어난다.",
  "MENU_HELP_TXT_216_02": "언리시 모드일 때는\r\n[BTN:LS ]으로 세레자를, [BTN:RS ]으로 체셔를\r\n각각 이동시킬 수 있습니다.",
  "MENU_HELP_TXT_025_01": "위치 펄스를 사용할 때\r\n세레자 주변의 원 사이가\r\n길게 이어지는 구간에서는\r\n[BTN:LS ]을 계속 기울입시다.",
  "MENU_SKILLTREE_TXT_330": "소유할 수 있는 사용 아이템 개수가\r\n많이 늘어난다.",
  "MENU_SKILLTREE_TXT_323": "소유할 수 있는 사용 아이템 개수가\r\n더욱 늘어난다.",
  "MENU_HELP_TXT_111_01": "악마인 체셔는 액막이로 쓰이는\r\n로즈메리가 자라난 곳을\r\n지나갈 수 없습니다.\r\n다른 길을 찾아봅시다.",
  "MENU_HELP_TXT_107_02": "물건을 잡은 상태에서\r\n[BTN:R1 ]을 누르고 있으면\r\n잡은 물건을 끌어당길 수 있습니다.",
  "MENU_HELP_TXT_238_01": "유니콘의 뿔은\r\n붉은 광석으로 보존된\r\n마녀의 조합 재료 중 하나입니다.\r\n사용 아이템을 만들 때 씁니다.",
  "MENU_HELP_TXT_207_01": "빨간 아치가 있는 곳은\r\n마녀의 은신처라고 하며\r\n숲을 탐색하기 위한 거점이 됩니다.",
  "MENU_HELP_TXT_022_01": "인형이 되어 땅에 떨어진\r\n체셔를 주울 때, 주위의 적을 밀어내는\r\n충격파를 일으키는 스킬입니다.",
  "MENU_SKILLTREE_TXT_324": "[BTN:RS ]으로 체셔를 길게 늘이면\r\n적의 원거리 공격을 튕겨 낸다.",
  "MENU_SKILLTREE_TXT_420": "세레자가 체셔의 등에 올라타\r\n마력을 주면 체셔의 숨겨진 힘과\r\n공명해 각성 상태가 된다.",
  "MENU_HELP_TXT_116_01": "언리시 모드일 때, 빈사 상태의 적\r\n근처에서 차지 스트라이크를 쓰면\r\n체셔가 적에게 최후의 일격을\r\n날리는 스킬입니다.",
  "MENU_SKILLTREE_TXT_424": "허그 모드 중, [BTN:R2 ]로\r\n체셔가 적을 찔러\r\n적을 조금 경직시킨다.",
  "MENU_HELP_TXT_216_01": "체셔를 소환하여\r\n세레자와 체셔가 따로\r\n이동하는 상태를\r\n\"언리시 모드\"라고 합니다.",
  "MENU_POSEMENU_DIALOG_TXT_03": "타이틀 화면으로 돌아갑니다.\r\n기록하지 않은 이야기는 삭제됩니다.\r\n계속하시겠습니까?",
  "MENU_HELP_TXT_107_01": "[BTN:Y ]를 누르면 체셔가\r\n나무속성으로 변합니다.\r\n나무속성 체셔는 [BTN:R1 ]로 덩굴 혀를\r\n길게 늘여 물건을 잡을 수 있습니다.",
  "MENU_HELP_TXT_999_01": "???",
  "MENU_SKILLTREE_TXT_320": "가시 바인드의 재사용 대기 시간이\r\n더욱 줄어든다.",
  "MENU_HELP_TXT_109_03": "또한, 물속성 체셔는\r\n물속을 자유롭게 헤엄칩니다.\r\n물에 들어가면 자동으로\r\n물속성 체셔가 됩니다.",
  "MENU_SKILLTREE_TXT_328": "허그 모드에서 [BTN:L1 ]을 누르면\r\n세레자가 체셔에게 힘을 보내\r\n마력을 회복한다.",
  "MENU_HELP_TXT_103_01": "체셔에게도 체력이 있기 때문에\r\n공격을 계속 받아 체력이 다 떨어지면\r\n인형으로 돌아갑니다.",
  "MENU_HELP_TXT_212_01": "일부 랜턴 근처에 있는\r\n거울을 [BTN:L1 ]로 조사하면\r\n스킬을 습득할 수 있습니다.",
  "MENU_SKILLTREE_DIALOG_TXT_02": "연습을 종료하고\r\n연습장에서 나가시겠습니까?",
  "MENU_HELP_TXT_112_01": "특정 상황에서 세레자가\r\n체셔의 등에 올라타 마력을 주면\r\n체셔는 각성 상태가 됩니다.",
  "MENU_HELP_TXT_249_02": "길을 잃었을 때 발자국 마크가 있는\r\n지역으로 이동해 봅시다.\r\n근처에서 늑대 발자국을\r\n찾을 수 있을 겁니다.",
  "MENU_HELP_TXT_104_02": "또한, 변신 중 공격은\r\n적의 방패를 빼앗는 등\r\n특수한 사용법도 있습니다.",
  "MENU_HELP_TXT_215_02": "허그 모드일 때는\r\n[BTN:LS ]으로 세레자를 이동시킵니다.\r\n[BTN:RS ]을 기울이면 체셔가 늘어나\r\n주위에 있는 것을 잡을 수 있습니다.",
  "MENU_HELP_TXT_203_01": "메뉴 화면의 스테이터스에서는\r\n세레자와 체셔의 상태,\r\n가지고 있는 아이템 개수를\r\n확인할 수 있습니다.",
  "MENU_HELP_TXT_026_01": "위치 펄스를 사용할 때\r\n세레자 주변의 원이\r\n두 개 겹쳐서 표시되면\r\n[BTN:LS ]을 빠르게 두 번 기울입시다.",
  "MENU_SKILLTREE_TXT_413": "[BTN:L1 ]을 빠르게 두 번 누르면\r\n주위의 적을 날려 버리면서\r\n허그 모드로 전환된다.",
  "MENU_HELP_TXT_108_03": "또한, 돌속성 체셔는 몸이 단단해\r\n대부분의 공격을 막을 수 있습니다.\r\n단, 공격받을 때마다\r\n마력이 소비됩니다.",
  "MENU_HELP_TXT_102_01": "체셔는 [BTN:R2 ]로 할퀴기 공격을 합니다.\r\n체셔의 공격은 나무줄기나 항아리 같은\r\n단단한 것도 부술 수 있습니다.",
  "MENU_HELP_TXT_221_03": "티르 너 노그 안에서 [BTN:START ]를 눌러\r\n티르 너 노그 메뉴를 열면\r\n일시적으로 탈출할 수도 있습니다.",
  "MENU_HELP_TXT_213_01": "스킬 습득 화면에서 [BTN:SELECT ]를 누르면\r\n연습장으로 이동합니다.\r\n연습장에서는 스킬이나 전투 방법을\r\n자유롭게 시험할 수 있습니다.",
  "MENU_SKILLTREE_TXT_304": "전투 중, 허그 모드 상태면\r\n마력이 조금씩 회복된다.",
  "MENU_SKILLTREE_TXT_317": "가시 바인드가 완성될 때까지\r\n적의 움직임이 더욱 둔해진다.",
  "MENU_HELP_TXT_009_02": "단, 적을 속박한 경우에는\r\n마도술 게이지 하나를 소비합니다.\r\n마도술 게이지는 시간이 지나면\r\n조금씩 회복됩니다.",
  "MENU_HELP_TXT_113_01": "언리시 모드일 때 [BTN:R1 ]을 누르면\r\n체셔가 공격을 튕깁니다.\r\n쓸 때마다 마력이 소비됩니다.",
  "MENU_HELP_TXT_105_02": "체셔의 마력은 허그 모드로 전환하면\r\n조금씩 회복됩니다.",
  "MENU_HELP_TXT_027_01": "일부 날아다니는 적은 무척 약하므로\r\n가시 바인드로 잡기만 해도\r\n쓰러트릴 수 있습니다.\r\n날아다니는 적은 일단 구속합시다.",
  "MENU_SKILLTREE_TXT_404": "[BTN:R3 ]을 누르면\r\n체셔가 회피 동작을 한다.",
  "MENU_SKILLTREE_TXT_417": "돌속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n돌의 오의가 된다.",
  "MENU_HELP_TXT_202_01": "메뉴 화면의 지도에는\r\n상세 지도와 월드 맵이 있으며\r\n[BTN:Y ]로 전환할 수 있습니다.",
  "MENU_HELP_TXT_023_01": "소지할 수 있는 사용 아이템의\r\n최대치가 늘어나는 스킬입니다.",
  "MENU_HELP_TXT_206_01": "각지에 있는 랜턴을 [BTN:L1 ]로 조사하면\r\n이야기를 기록하기 등,\r\n모험 준비를 할 수 있습니다.",
  "MENU_HELP_TXT_210_02": "단, 사용 아이템을 조합하려면\r\n그 아이템을 한 번이라도 \r\n얻어야 합니다.\r\n숲 곳곳을 조사해 봅시다.",
  "MENU_CHALLENGE_TXT_12": "타임 어택에 도전할\r\n티르 너 노그를 선택해 주십시오.",
  "MENU_CHALLENGE_TXT_01": "지금까지 공략한 티르 너 노그에\r\n재도전합니다.",
  "MENU_SKILLTREE_TXT_308": "가시 바인드가 완성될 때까지\r\n적의 움직임이 둔해진다.",
  "MENU_HELP_TXT_228_02": "게이트에 따라 여는데 필요한\r\n도깨비불의 수가 다릅니다.\r\n주위에 도깨비불이 없는지\r\n빠짐없이 조사해 봅시다.",
  "MENU_HELP_TXT_117_01": "덥석!으로 적에게 최후의 일격을\r\n날렸을 때 마력이 회복되는 스킬입니다.",
  "MENU_HELP_TXT_217_01": "언리시 모드일 때 [BTN:L1 ]을 누르면\r\n체셔가 인형으로 돌아가면서\r\n허그 모드로 전환됩니다.\r\n",
  "MENU_HELP_TXT_106_01": "\"엘레멘트의 조각\"은 [BTN:L1 ]로\r\n마도기에 흡수할 수 있습니다.\r\n일정 수치 이상의 힘을 흡수하면\r\n마력 게이지의 최대치가 증가합니다.",
  "MENU_SKILLTREE_TXT_408": "이동 방향으로 [BTN:RS ]을 기울여 체셔를\r\n늘이면 이동 속도가 조금 오른다.",
  "MENU_HELP_TXT_110_02": "화염탄은 특정 목표물을 불태우거나\r\n얼음을 녹일 수 있습니다.\r\n또한, 불속성 체셔는\r\n불 속을 지나다닐 수 있습니다.",
  "MENU_HELP_TXT_210_01": "모험 준비에서는 재료를 가지고\r\n사용 아이템을 조합할 수 있습니다.\r\n조합한 아이템은\r\n필드에서 사용할 수 있습니다.",
  "MENU_SKILLTREE_TXT_318": "적의 특정 공격이 있은 뒤에 구속하면\r\n상대를 구속하는 시간이 늘어나며\r\n일정 시간 동안 상대에게 주는\r\n대미지가 증가한다.",
  "MENU_HELP_TXT_228_01": "각지에 있는 도깨비불 게이트는\r\n도깨비불의 힘을 빌려\r\n열 수 있습니다.",
  "MENU_CHALLENGE_TXT_11": "재도전할 티르 너 노그를\r\n선택해 주십시오.",
  "MENU_CHALLENGE_TXT_02": "티르 너 노그를 공략하는 시간을\r\n측정하는 타임 어택에 도전합니다.",
  "MENU_HELP_TXT_101_01": "체셔는 [BTN:RS ]으로 이동합니다.\r\n조금 높은 언덕이나 턱이 있으면\r\n그 방향으로 [BTN:RS ]을 기울여\r\n뛰어넘거나 올라갈 수 있습니다.",
  "MENU_HELP_TXT_128_01": "언리시 모드일 때 체셔가\r\n공격・회피 중에 속성을 바꾸면\r\n변신하면서 특별한 공격을\r\n펼치는 스킬입니다.",
  "MENU_HELP_TXT_217_02": "그리고 허그 모드일 때 [BTN:R1 ]을 누르면\r\n체셔를 불러내면서\r\n언리시 모드로 전환됩니다.",
  "MENU_HELP_TXT_201_01": "[BTN:START ]로 메뉴 화면을 엽니다.\r\n메뉴 화면에서는 지도, 스테이터스,\r\n아카이브, 시스템이라는 네 항목을\r\n[BTN:L1 ][BTN:R1 ]로 전환할 수 있습니다.",
  "MENU_HELP_TXT_024_01": "사용 아이템을 사용했을 때의\r\n효과가 상승하는 스킬입니다.\r\n모든 사용 아이템에 적용됩니다.",
  "MENU_HELP_TXT_110_01": "[BTN:A ]를 누르면 체셔가\r\n불속성으로 변합니다.\r\n불속성 체셔는 [BTN:R1 ]을 누르면\r\n화염탄을 발사합니다.",
  "MENU_SKILLTREE_TXT_418": "덥석!으로 적에게 최후의 일격을\r\n날렸을 때 마력이 회복된다.",
  "MENU_HELP_TXT_239_01": "까맣게 구운 도마뱀은\r\n노란 광석으로 보존된\r\n마녀의 조합 재료 중 하나입니다.\r\n사용 아이템을 만들 때 씁니다.",
  "MENU_SKILLTREE_TXT_510": "가시 바인드를 사용할 때\r\n마법진의 확장 범위가\r\n조금 넓어진다.",
  "MENU_HELP_TXT_018_01": "전투 중, 허그 모드 상태면\r\n마력이 조금씩 회복되는 스킬입니다.",
  "MENU_HELP_TXT_114_01": "카운터로 적의 공격을 튕겼을 때\r\n[BTN:R2 ]로 추가 공격을 하는 스킬입니다.",
  "MENU_SKILLTREE_TXT_403": "빈사 상태의 적 근처에서\r\n차지 스트라이크를 사용하면\r\n적에게 최후의 일격을 날린다.",
  "MENU_SKILLTREE_TXT_410": "나무속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n나무의 오의가 된다.",
  "MENU_HELP_TXT_205_01": "메뉴 화면의 시스템에서는\r\n이야기를 불러오기, 모험의 지혜,\r\n설정 등을 선택할 수 있습니다.",
  "MENU_HELP_TXT_020_01": "허그 모드에서 [BTN:L1 ]을 누르면\r\n세레자가 체셔에게 힘을 보내\r\n마력을 회복하는 스킬입니다.",
  "MENU_SKILLTREE_TXT_314": "땅에 떨어진 체셔를 주울 때\r\n주위 적을 밀어내는 충격파를 일으킨다.",
  "MENU_HELP_TXT_226_03": "도와준 도깨비불의 정보는\r\n아카이브의 \"만난 도깨비불\"에\r\n등록됩니다.",
  "MENU_HELP_TXT_105_01": "체셔 머리 위에 표시되는 게이지는\r\n체셔의 마력을 나타냅니다.\r\n마력은 특정 기술을 사용할 때마다\r\n줄어듭니다.",
  "MENU_SKILLTREE_TXT_303": "[BTN:L2 ]을 길게 누르면\r\n가시덩굴을 소환해 적을 구속한다.\r\n재사용하기까지 조금 시간이 걸린다.",
  "MENU_SKILLTREE_TXT_310": "가시 바인드로\r\n동시에 다수의 적을\r\n구속할 수 있게 된다.",
  "MENU_HELP_TXT_009_01": "적 근처에서 [BTN:L2 ]을 길게 누르면\r\n세레자가 가시덩굴을 소환해 적을\r\n일정 시간 행동 불능으로 만듭니다.\r\n이것을 \"가시 바인드\"라고 합니다.",
  "MENU_HELP_TXT_248_01": "마법의 랜턴을 조사했을 때나\r\n이야기의 특정 지점에 도달했을 때,\r\n오른쪽 아래에 아이콘이 표시되며\r\n이야기가 자동으로 기록됩니다.",
  "MENU_SKILLTREE_TXT_407": "회피하는 중에 [BTN:R2 ]을 누르면\r\n뛰어들기 공격을 한다.",
  "MENU_SKILLTREE_TXT_414": "체셔가 공격・회피 중에 속성을 바꾸면\r\n변신하면서 특별한 공격을 펼친다.",
  "MENU_HELP_TXT_202_02": "상세 지도 일부를 가리는 안개는\r\n특정 조건을 만족하면 사라져\r\n주위에 있는 것을\r\n확인할 수 있게 됩니다.",
  "MENU_HELP_TXT_214_01": "마녀의 은신처에 있는\r\n이그니스에게 말을 걸면\r\n이미 개방된 지역으로\r\n갈 수 있습니다.",
  "MENU_SKILLTREE_TXT_419": "체셔의 공격에 따라\r\n적에게 주는 대미지가 조금 늘어난다.",
  "MENU_HELP_TXT_225_01": "숲 각지에서 세레자가 인상 깊게 본\r\n장소를 [BTN:L1 ]로 조사하면\r\n아카이브에 \"추억의 책갈피\"로\r\n등록되어 확인할 수 있게 됩니다.",
  "MENU_HELP_TXT_241_01": "매직 버터플라이는 나비 모양을 한\r\n연보랏빛 물방울입니다.\r\n섭취하면 집중력이 높아지고\r\n마도술 재사용 시간이 줄어듭니다.",
  "MENU_CHALLENGE_DIALOG_TXT_02": "이 티르 너 노그에\r\n도전하시겠습니까?",
  "MENU_HELP_TXT_222_02": "미션의 조건을 어기면\r\n공략 실패가 됩니다.\r\n조건은 반드시 지킵시다.",
  "MENU_HELP_TXT_234_01": "오닉스 로즈는\r\n마계의 장미 꽃잎입니다.\r\n세레자의 스킬을 습득하기 위해\r\n필요합니다.",
  "MENU_HELP_TXT_250_01": "체셔와 세레자가 멀리 있거나,\r\n근처에 로즈메리가 있을 때는\r\n체셔를 허그 모드로 들 수 없습니다.",
  "MENU_HELP_TXT_011_01": "가시 바인드로 적을 구속했을 때\r\n마력 회복량이 증가하는 스킬입니다.",
  "MENU_HELP_TXT_125_01": "데몬 닷지로 회피하는 중에\r\n[BTN:R2 ]을 누르면 체셔가\r\n뛰어들기 공격을 하는 스킬입니다.",
  "MENU_HELP_TXT_029_01": "위치 펄스는 몇 번인가\r\n연속해서 성공시켜야 합니다.\r\n위치 펄스가 발동할 때까지는\r\n[BTN:L2 ]에서 손을 떼지 맙시다.",
  "MENU_HELP_TXT_208_01": "모험 준비에서는\r\n이야기를 기록할 수 있습니다.\r\n자동 기록과는 별개로 특정 지점마다\r\n기록해 두는 것도 좋겠습니다.",
  "MENU_HELP_TXT_121_01": "돌속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n돌의 오의가 되는 스킬입니다.",
  "MENU_SKILLTREE_TXT_406": "구속된 적 근처에서\r\n차지 스트라이크를 사용하면\r\n강력한 연계 공격을 날린다.",
  "MENU_SKILLTREE_TXT_415": "체셔의 체력이 더욱 늘어난다.",
  "MENU_HELP_TXT_230_01": "숲에 있는 커다란 버섯에서\r\n돌속성 체셔가 발 구르기를 하면\r\n높게 점프할 수 있습니다.\r\n높은 곳을 탐색할 때 활용합시다.",
  "MENU_HELP_TXT_015_01": "부서진 물건 가까이에서\r\n[BTN:L2 ]을 누른 상태로 [BTN:LS ]을 돌리면\r\n부서진 물건을 원상 복구할 수 있습니다.\r\n이것을 \"레스터레이션\"이라 합니다.",
  "MENU_HELP_TXT_119_01": "바인드 콤보 마지막에\r\n[BTN:R2 ]을 누르면 강력하고 광범위한\r\n피니시 공격을 하는 스킬입니다.",
  "MENU_HELP_TXT_226_02": "개중에 고민이 있는\r\n도깨비불도 있습니다.\r\n그들의 고민을 해결해 주면\r\n좋은 일이 있을지도 모릅니다.",
  "MENU_SKILLTREE_TXT_302": "가시 바인드로 적을 구속했을 때\r\n마력 회복량이 조금 늘어난다.",
  "MENU_SKILLTREE_TXT_311": "전투 중, 허그 모드 상태면\r\n마력의 회복 속도가 조금 오른다.",
  "MENU_SKILLTREE_TXT_306": "가시 바인드의 재사용 대기 시간이\r\n조금 줄어든다.",
  "MENU_SKILLTREE_TXT_315": "가시 바인드로 적을 구속했을 때\r\n마력 회복량이 더욱 늘어난다.",
  "MENU_HELP_TXT_130_01": "허그 모드일 때 [BTN:R2 ]로\r\n체셔가 적을 찔러\r\n적을 조금 경직시키는 스킬입니다.",
  "MENU_HELP_TXT_219_01": "숲 곳곳에는 하얀 늑대의\r\n발자국이 남아 있습니다.\r\n발자국은 다가가면 더 선명해집니다.",
  "MENU_SKILLTREE_TXT_402": "[BTN:R2 ]을 길게 눌러 힘을 모은다.\r\n잠시 모은 뒤에 [BTN:R2 ]을 떼면\r\n체셔가 돌진 공격을 한다.",
  "MENU_HELP_TXT_108_01": "[BTN:B ]를 누르면 체셔가\r\n돌속성으로 변합니다.\r\n돌속성 체셔는 [BTN:R1 ]을 누르면\r\n뛰어올라 아래로 발을 구릅니다.",
  "MENU_SKILLTREE_TXT_411": "카운터로 적의 공격을 튕겼을 때\r\n[BTN:R2 ]로 적에게 추가 공격을 한다.",
  "MENU_HELP_TXT_004_01": "화면 좌측 하단에 있는 꽃 마크는\r\n세레자의 체력을 나타냅니다.\r\n체력은 적의 공격을\r\n받으면 줄어듭니다.",
  "MENU_HELP_TXT_245_01": "데모닉 미스트는 초승달 모양 병에\r\n들어 있는 사용 아이템입니다.\r\n[BTN:DP_R ]으로 사용하면 일시적으로\r\n체셔의 마력이 줄어들지 않습니다.",
  "MENU_HELP_TXT_221_01": "요정들이 만드는 환영의 발생지를\r\n\"환영 요역 티르 너 노그\"라 합니다.\r\n티르 너 노그는 숲 곳곳에\r\n여러 개 존재합니다.",
  "MENU_SKILLTREE_TXT_405": "체셔의 체력이 조금 늘어난다.\r\n체력이 다 떨어지면\r\n체셔는 인형 상태로 돌아간다.",
  "MENU_SKILLTREE_TXT_416": "물속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n물의 오의가 된다.",
  "MENU_HELP_TXT_242_01": "크레센트 클러스터는 힘을 지니고 있는\r\n초승달 모양의 결정입니다.\r\n흡수하면 마력이 조금 회복됩니다.",
  "MENU_HELP_TXT_226_01": "숲 곳곳에는 도깨비불이 있습니다.\r\n요정에게 잡힌 도깨비불은\r\n[BTN:L1 ]로 구해 줄 수 있습니다.",
  "MENU_HELP_TXT_003_01": "대상 주위에서 [BTN:L2 ]을 눌러\r\n세레자 주변에 보이는 원에 맞추고\r\n타이밍 좋게 [BTN:LS ]을 기울이면\r\n위치 펄스가 발동됩니다.",
  "MENU_SKILLTREE_TXT_301": "[BTN:L2 ]을 누른 상태로\r\n타이밍에 맞춰 [BTN:LS ]을 기울이면\r\n식물이나 장치에 영향을 준다.",
  "MENU_SKILLTREE_TXT_312": "소유할 수 있는 사용 아이템 개수가\r\n조금 늘어난다.",
  "MENU_HELP_TXT_219_02": "늑대 발자국은\r\n목적지로 가는 실마리가 됩니다.\r\n길을 모를 때는 발자국을 찾아봅시다.",
  "MENU_HELP_TXT_126_01": "허그 모드일 때\r\n적의 공격이 닿는 순간\r\n[BTN:R1 ]을 누르면 체셔를 소환하여\r\n적에게 반격하는 스킬입니다.",
  "MENU_HELP_TXT_004_02": "체력이 없어지면\r\n세레자는 목숨을 잃고 맙니다.\r\n항상 남은 체력에 주의합시다.",
  "MENU_HELP_TXT_221_02": "티르 너 노그 깊숙한 곳에\r\n숨겨진 핵을 부수어\r\n티르 너 노그를 돌파합시다.",
  "MENU_HELP_TXT_012_01": "가시 바인드의 재사용 대기 시간을\r\n줄이는 스킬입니다.",
  "MENU_HELP_TXT_237_01": "만드라고라의 뿌리는\r\n녹색 광석으로 보존된\r\n마녀의 조합 재료 중 하나입니다.\r\n사용 아이템을 만들 때 씁니다.",
  "MENU_SKILLTREE_TXT_401": "[BTN:R1 ]로 체셔가 공격을 튕겨 낸다.",
  "MENU_HELP_TXT_108_02": "발 구르기는 적을 공격할 뿐 아니라\r\n아래에 있는 것을 부수거나\r\n찍어 누를 수 있습니다.",
  "MENU_HELP_TXT_016_01": "공격을 당하기 직전에 피하면\r\n일시적으로 감각이 날카로워져\r\n초고속으로 움직일 수 있습니다.\r\n이것을 \"위치 타임\"이라 합니다.",
  "MENU_HELP_TXT_233_01": "아발론 드롭은\r\n달콤한 마력의 결정입니다.\r\n체셔의 스킬을 습득하기 위해\r\n필요합니다.",
  "MENU_SKILLTREE_TXT_409": "바인드 콤보 마지막에 [BTN:R2 ]을 누르면\r\n강력한 광범위 피니시 공격을 펼친다.",
  "MENU_CHALLENGE_DIALOG_TXT_01": "아이템을 사용해서\r\n이 타임 어택을 개방하겠습니까?",
  "MENU_HELP_TXT_122_01": "물속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n물의 오의가 되는 스킬입니다.",
  "MENU_HELP_TXT_250_02": "주변의 지형을 잘 관찰하고,\r\n세레자와 체셔가 합류할 방법을\r\n생각해 봅시다.",
  "MENU_SKILLTREE_TXT_309": "[BTN:L3 ]을 누르면\r\n세레자가 회피 동작을 한다.",
  "MENU_HELP_TXT_222_01": "티르 너 노그 안에서는\r\n미션이라는 특수한 조건이\r\n붙는 경우가 있습니다.",
  "MENU_HELP_TXT_246_01": "블래스트 칵테일은 뾰족뾰족한\r\n병에 들어 있는 사용 아이템입니다.\r\n[BTN:DP_D ]로 사용하면 폭발을\r\n일으켜 주위의 적을 기절시킵니다.",
  "MENU_HELP_TXT_007_01": "허그 모드일 때, 일부 높은 곳을 향해\r\n[BTN:L1 ]로 체셔를 던질 수 있습니다.\r\n위, 아래에서 서로 협력해야\r\n열리는 길도 있습니다.",
  "MENU_HELP_TXT_133_01": "체셔의 공격으로 적에게 입히는\r\n대미지가 늘어나는 스킬입니다.\r\n체셔의 모든 공격에 유효합니다.",
  "MENU_HELP_TXT_232_01": "사당에 있는 엘레멘트 코어는\r\n체셔의 공격으로 부술 수 있습니다.\r\n세레자의 목표를 달성하기 위해\r\n거침없이 부숴 버립시다.",
  "MENU_SKILLTREE_TXT_332": "가시 바인드로 동시에 구속할 수 있는\r\n적의 수가 더욱 늘어난다.",
  "MENU_HELP_TXT_017_01": "[BTN:L3 ]을 누르면 세레자가\r\n회피 동작을 하는 스킬입니다.",
  "MENU_SKILLTREE_TXT_425": "체셔 찌르기에 당한 적이\r\n가끔 아이템을 떨어트린다.",
  "MENU_HELP_TXT_123_01": "불속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n불의 오의가 되는 스킬입니다.",
  "MENU_SKILLTREE_TXT_525": "가시 바인드를 사용할 때\r\n마법진의 확장 범위가\r\n더욱 넓어진다.",
  "MENU_SKILLTREE_TXT_532": "가시 바인드를 사용할 때\r\n마법진의 확장 범위가\r\n아주 넓어진다.",
  "MENU_HELP_TXT_010_02": "발동 중에는 적이 일정 시간 동안\r\n저항하지 못하고, 방어력이 내려가므로\r\n체셔의 공격으로 더 강한 대미지를\r\n줄 수 있습니다.",
  "MENU_HELP_TXT_006_01": "세레자는 [BTN:L2 ]로 마도술을 씁니다.\r\n마도술의 대상이 근처에 있으면\r\n자동으로 목표를 정합니다.",
  "MENU_HELP_TXT_247_01": "숲에서 길을 잃으면 곳곳에 있는\r\n숲의 이정표를 조사해 봅시다.\r\n가까운 마녀의 은신처로 가는\r\n길을 알려 줍니다.",
  "MENU_HELP_TXT_223_01": "일부 요정은 전투 중에\r\n배리어를 두르기도 합니다.\r\n배리어를 두른 적에게는\r\n일반적인 공격은 효과가 없습니다.",
  "MENU_SKILLTREE_TXT_421": "허그 모드에서 적의 공격이 닿는 순간\r\n[BTN:R1 ]을 누르면 체셔를 소환해\r\n적에게 반격한다.",
  "MENU_HELP_TXT_132_01": "체셔의 체력이 늘어나는 스킬입니다.",
  "MENU_SKILLTREE_TXT_325": "가시 바인드로 동시에\r\n구속할 수 있는 적의 수가 늘어난다.",
  "MENU_HELP_TXT_209_02": "또한, 티르 너 노그의 공략 타임을 측정하는\r\n타임 어택에 도전할 수 있습니다.\r\n타임 어택을 공략하면,\r\n평가에 따른 보상을 얻을 수 있습니다.",
  "MENU_HELP_TXT_002_01": "세레자는 [BTN:L1 ]로 다양한 것을 잡거나\r\n조사할 수 있습니다.",
  "MENU_HELP_TXT_227_01": "어느 정도 도깨비불을 구하고\r\n도깨비불 비밀 기지에 있는\r\n코룸에게 가면\r\n보답이 있을……지도 모릅니다.",
  "MENU_HELP_TXT_243_01": "힐링 토닉은 꽃잎 모양 병에\r\n들어 있는 사용 아이템입니다.\r\n[BTN:DP_U ]로 사용하면\r\n세레자의 체력이 조금 회복됩니다.",
  "MENU_HELP_TXT_127_01": "[BTN:L1 ]을 빠르게 두 번 누르면\r\n체셔가 주위의 적을 날려 버리며\r\n허그 모드로 전환되는 스킬입니다.",
  "MENU_SKILLTREE_TXT_329": "가시 바인드로 적을 구속했을 때\r\n마력 회복량이 많이 늘어난다.",
  "MENU_HELP_TXT_236_01": "문 펄은\r\n순수한 마력의 결정입니다.\r\n세레자의 강력한 스킬을\r\n습득하기 위해 필요합니다.",
  "MENU_HELP_TXT_109_02": "아쿠아스트림은 사정거리가 길고\r\n다양한 것들을 돌리거나\r\n움직일 수 있습니다.\r\n그리고 불을 끌 수도 있습니다.",
  "MENU_HELP_TXT_013_01": "가시 바인드가 완성될 때까지\r\n마법진 안에 있는 적의 움직임이\r\n둔해지는 스킬입니다.",
  "MENU_HELP_TXT_209_01": "모험 준비에서는 한번 클리어한\r\n티르 너 노그에 재도전할 수 있으며,\r\n놓친 보물 상자 등을\r\n다시 모을 수 있습니다.",
  "MENU_HELP_TXT_120_01": "나무속성 체셔로 변신 중일 때\r\n바인드 콤보의 피니시 공격이\r\n나무의 오의가 되는 스킬입니다.",
  "MENU_HELP_TXT_014_01": "가시 바인드 마법진 안에 있는\r\n다수의 적을 동시에\r\n구속할 수 있는 스킬입니다.",
  "MENU_HELP_TXT_112_03": "또한, [BTN:A ][BTN:B ][BTN:X ][BTN:Y ]로 \r\n불・돌・물・나무속성 공격을\r\n펼칠 수 있습니다.",
  "MENU_HELP_TXT_231_01": "숲 곳곳에 있는 엘레멘트의 조각은\r\n[BTN:L1 ]로 흡수할 수 있습니다.\r\n한번 흡수한 엘레멘트의 조각은\r\n다시 생성되지 않습니다.",
  "MENU_HELP_TXT_118_01": "언리시 모드일 때\r\n가시 바인드로 잡은 적 근처에서\r\n차지 스트라이크를 쓰면\r\n강력한 연계 공격을 하는 스킬입니다.",
  "MENU_HELP_TXT_227_02": "코룸이 하고 싶은 말이 있을 때\r\n지도에 도깨비불 마크가\r\n표시됩니다. 마크를 찾으면\r\n코룸에게 말을 걸어 봅시다.",
  "MENU_HELP_TXT_131_01": "체셔 찌르기에 당한 적이\r\n가끔 아이템을 떨어트리게\r\n되는 스킬입니다.",
  "MENU_HELP_TXT_218_01": "허그 모드일 때\r\n[BTN:RS ]으로 강아지풀을 잡고\r\n[BTN:L1 ]을 누르면 높이 점프합니다.",
  "MENU_HELP_TXT_109_01": "[BTN:X ]를 누르면 체셔가\r\n물속성으로 변합니다.\r\n물속성 체셔는 [BTN:R1 ]을 누르면\r\n아쿠아스트림을 뿜습니다.",
  "MENU_HELP_TXT_220_01": "요정이 만든 왜곡된 공간 안에는\r\n다양한 환각이 길을 막습니다.\r\n[BTN:L2 ]을 길게 눌러 주변을 비추면\r\n보이지 않았던 물건이나 적이 보입니다.",
  "MENU_HELP_TXT_244_01": "엄브란 시럽은 나비 모양을 한 병에 든\r\n사용 아이템입니다. [BTN:DP_L ]으로 사용하면\r\n일시적으로 세레자가 무적이 되고,\r\n마도술의 재사용 시간이 짧아집니다.",
  "MENU_HELP_TXT_005_01": "생명의 꽃잎을 다섯 장\r\n또는 생명의 꽃을 한 개 모으면\r\n세레자의 체력 최대치가 증가합니다.",
  "MENU_HELP_TXT_240_01": "생명의 꽃잎은 꽃잎의 형태를 한\r\n작은 보석입니다. 다섯 개를 모으면\r\n생명의 꽃이 되어 세레자의\r\n체력 최대치를 늘립니다.",
  "MENU_HELP_TXT_224_01": "숲 곳곳에 떨어진 수기를\r\n주우면 아카이브에 등록되고\r\n내용을 읽을 수 있게 됩니다.",
  "MENU_HELP_TXT_001_01": "세레자는 [BTN:LS ]으로 이동합니다.\r\n조금 높은 언덕이나 턱이 있으면\r\n그 방향으로 [BTN:LS ]을 기울이면\r\n뛰어넘거나 올라갈 수 있습니다.",
  "MENU_SKILLTREE_TXT_331": "적의 공격을 [BTN:L1 ]로 피하면\r\n감각이 날카로워져\r\n초고속으로 움직일 수 있다.",
  "MENU_SKILLTREE_TXT_322": "사용 아이템을 사용했을 때의\r\n효과가 상승한다.",
  "MENU_HELP_TXT_135_01": "체셔도 세레자처럼\r\n일정 높이 이상의 장소에서는\r\n[BTN:R1 ]로 점프해 뛰어내릴 수 있습니다.\r\n하얀 마크를 찾아봅시다.",
  "MENU_SKILLTREE_TXT_426": "체셔 찌르기에 당한 적의\r\n아이템을 떨어트릴 확률이 증가하고\r\n떨어트리는 아이템의 종류가 늘어난다.",
  "MENU_HELP_TXT_216_03": "세레자와 체셔는 너무 많은 시간\r\n떨어져 있으면 안 됩니다.\r\n아무쪼록 주의합시다.",
  "MENU_HELP_TXT_006_02": "마도술에 필요한 원형 게이지를\r\n\"마도술 게이지\"라고 합니다.\r\n마도술을 사용할 때마다 소비되며\r\n시간이 지나면 조금씩 회복됩니다.",
  "MENU_HELP_TXT_223_02": "배리어를 없애기 위해서는\r\n변신이 중요합니다.\r\n상대의 약점을 잘 노려\r\n배리어를 깨 버립시다.",
  "MENU_SKILLTREE_TXT_422": "체셔의 체력이 많이 늘어난다.",
  "MENU_HELP_TXT_010_01": "몇몇 적은 특정 행동 중\r\n머리 위에 마크가 나타납니다.\r\n이 타이밍에 [BTN:L2 ]을 길게 누르면\r\n\"가시 감옥\"이 발동됩니다.",
  "MENU_HELP_TXT_235_01": "인페르노 프루트는\r\n마계의 귀한 과일입니다.\r\n체셔의 강력한 스킬을\r\n습득하기 위해 필요합니다.",
  "MENU_HELP_TXT_124_01": "언리시 모드일 때\r\n[BTN:R3 ]을 누르면 체셔가\r\n회피 동작을 하는 스킬입니다.",
  "MENU_SKILLTREE_TXT_326": "전투 중, 허그 모드 상태면\r\n마력의 회복 속도가 더욱 오른다.",
  "MENU_HELP_TXT_028_01": "세레자는\r\n일정 높이 이상의 장소에서는\r\n[BTN:L1 ]을 눌러 점프해 뛰어내릴 수 있습니다.\r\n하얀 마크를 찾아봅시다."
}
