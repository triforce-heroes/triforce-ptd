{
  "BK_7000_0100_NAR": "瑟蕾莎並不知道，\r\n妖精死後魂魄將前往何處。\r\n\r\n但她衷心祈禱，\r\n他的靈魂得以安息。",
  "BK_7000_0080_LUC": "「好溫暖……\r\n我一直很想再像這樣\r\n睡在母親的懷抱中……」",
  "BK_7010_0030_CER": "「你可以從這裡回家吧？」\r\n",
  "BK_7010_0120_NAR": "阿瓦隆森林回歸平靜。\r\n不知不覺天邊已是一片魚肚白，\r\n暖洋洋的陽光輕柔地灑落在瑟蕾莎身上。\r\n",
  "BK_7010_0040_CER": "「快去，門要關了。」",
  "BK_7020_0000_CER": "「媽咪……我已經是個厲害的魔女。\r\n不用再為我操心了。」",
  "BK_7020_0030_CER": "「媽咪……！」",
  "BK_7020_0040_ROS": "「瑟蕾莎已經是個比媽媽還了不起的\r\n魔女了。我相信你一定沒問題……」\r\n",
  "BK_7000_0170_NAR": "所有的暗影魔女，\r\n死後都會被拖入黑暗世界，\r\n永遠漫無目的地徘徊。",
  "BK_7000_0090_MOR": "「晚安，萊卡翁。\r\n祝你有個好夢……」",
  "BK_7000_0030_NAR": "與萊卡翁離別的時刻到來了。\r\n",
  "SM_007020_0000_JEA": "「看來不需要我幫忙了。」\r\n",
  "BK_7020_0060_NAR": "瑟蕾莎並沒有失去什麼。\r\n她帶著滿滿的回憶，\r\n還有與重要友人許下的約定，\r\n邁出通往未來的第一步。",
  "BK_7010_0020_NAR": "小柴貓筋疲力盡，\r\n連站著都很勉強，\r\n但祂卻一動也不動地盯著門看。\r\n",
  "BK_7000_0010_LUC": "「瑟蕾莎、小柴貓……」",
  "BK_7000_0020_LUC": "「謝謝你們幫我阻止母親。\r\n真的很高興認識你們。」",
  "BK_7010_0090_CER": "「我一定會變得更強、更厲害！」",
  "BK_7010_0010_NAR": "但那道門不穩地晃動，\r\n似乎馬上就要關閉。\r\n",
  "BK_7020_0050_NAR": "從此以後，\r\n瑟蕾莎再也沒有做惡夢。\r\n",
  "BK_7000_0050_LUC": "「我們已經是朋友了！」\r\n",
  "BK_7010_0045_NAR": "小柴貓的表情像在說：\r\n「我回去，就剩你一個人了。」\r\n",
  "SM_007010_0000_JEA": "你來了。",
  "BK_7010_0100_NAR": "在震耳欲聾的轟響中，\r\n瑟蕾莎清楚聽到小柴貓這麼說：\r\n『約好囉！』",
  "BK_7020_0010_ROS": "「瑟蕾莎。」",
  "BK_7000_0040_CER": "「真想跟你做朋友……」",
  "BK_7000_0150_NAR": "魔女迎來死期。",
  "BK_7000_0175_NAR": "但瑟蕾莎堅決不移開目光。",
  "BK_7000_0160_NAR": "摩根娜神情痛苦，\r\n發出慘絕人寰的叫聲，\r\n令人不忍直視。",
  "BK_7010_0050_CER": "「真是的，你還當我是見習魔女嗎？\r\n我很快就會變強，\r\n到時再召喚你出來。」\r\n",
  "BK_7010_0060_CER": "「所以……你就先休息一下吧。」",
  "BK_7020_0070_NAR": "唯有月亮靜靜凝視著，\r\n小魔女的嶄新啟程。",
  "SM_007020_0010_CER": "「謝謝你，貞德。下次再一起玩吧。」\r\n",
  "BK_7010_0000_NAR": "小柴貓好像注意到了什麼。\r\n通往魔界的大門在吞噬摩根娜之後，\r\n現在依然敞開著。\r\n",
  "BK_7010_0110_CER": "「你一定要成為了不起的惡魔！\r\n我們說好了喔！」",
  "SM_007010_0010_JEA": "「走吧，跟我來！」",
  "BK_7000_0060_NAR": "母親輕柔溫暖的懷抱，\r\n是他渴望已久的溫度。\r\n",
  "BK_7010_0070_NAR": "小柴貓默默走向那道門。\r\n",
  "BK_7000_0070_LUC": "「謝謝母親一直保護我。\r\n不過，已經夠了。」"
}
