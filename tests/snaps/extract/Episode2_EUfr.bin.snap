{
  "SM_002100_0150_COL": "« Merci ! »",
  "BK_2000_0060_CER": "« Reprends-toi, Cereza.\r\nTu vas... Tu vas devenir\r\nune sorcière ! »",
  "LV_002905_0000_NAR": "[FONT:10 ]Il y a un pouvoir très puissant par ici...[FONT:N ]\r\nChouchou avait senti quelque chose.",
  "SM_002100_0040_NAR": "À la simple pensée de son prochain\r\nrêve, elle se prit à sourire.",
  "SM_002140_0050_FAS": "« Je ne me suis pas présentée...\r\nje suis Ignis, gardienne de ces\r\nbois. »",
  "SM_002060_0030_CER": "« Attention, Chouchou ! Je sais pas\r\nsi le cœur des wisps peut s'arrêter,\r\nmais des frayeurs pareilles, ça fait\r\njamais de bien ! »",
  "LV_002035_0120_CER": "Non mais genre, comme si tu n'avais\r\npas besoin des noyaux élémentaires\r\npour te transformer !",
  "CE_002815_0000_CER": "Unnggh... ungghh... haa !",
  "SM_002140_0060_FAS": "« Vous avez pris grand soin du\r\ncirque. Je savais que je ne m'étais\r\npas trompée à votre sujet. »",
  "SM_002060_0000_COL": "« Là, c'est notre base secrète.\r\nNormalement, c'est interdit aux non-wisps,\r\nmais on va faire une exception. »",
  "BK_2000_0050_CER": "« J-Je veux me battre aussi !\r\nArrête de me traiter comme\r\nun bébé ! »",
  "LV_002035_0015_NAR": "Chouchou avait l'air amer.",
  "SM_002130_0135_CER": "« Bon, eh bien... dis-m'en plus. »",
  "LV_002900_0000_CER": "Qui c'est, ce guignol ?\r\nIl nous embête, à la fin !",
  "SM_002010_0100_COL": "« Je veux aller les aider,\r\nmais j'ai aucune chance\r\ncontre ces fées ! »",
  "SM_002010_0180_NAR": "Chouchou refusa net de participer\r\nà cette folle mission de secours.\r\n\r\nMais Cereza était déterminée.",
  "SM_002010_0010_NAR": "Cereza se rappela quelque\r\nchose que Morgana lui avait\r\nun jour dit.\r\nLes wisps sont les âmes\r\ndamnées des enfants ayant\r\npéri en Avalon, condamnés\r\nà hanter la forêt à jamais...",
  "CE_002070_0000_CER": "Et pour le bouquet final... !",
  "LV_002080_0020_NAR": "Cereza bailla bruyamment.\r\nElle était épuisée.",
  "SM_002140_0100_NAR": "Cereza était infiniment rassurée\r\nde savoir que la voix émanait\r\nd'un wisp.",
  "SM_002130_0150_FAS": "« Le directeur du cirque est un fou\r\nqui capture ces pauvres êtres\r\net les exploite de force dans ses\r\nspectacles jusqu'à ce qu'ils meurent. »",
  "SM_002040_0050_CER": "« Regarde comme ils sont joyeux !\r\nColm a enfin retrouvé ses amis.\r\nPeut-être trouveront-ils la sérénité\r\ndans cette forêt oubliée... »",
  "SM_002140_0010_CER": "« Cette voix... ! »",
  "SM_002140_0210_FAS": "« Un souci ? »",
  "SM_002110_0090_CER": "« Tu sais à quel point les cheveux\r\ndes sorcières sont importants ?\r\nAlors fais attention ! »",
  "_05": "",
  "SM_002130_0120_FAS": "« Mais les noyaux élémentaires\r\nseront moins aisés à trouver\r\nque tu ne le crois. »",
  "LV_002930_0000_CER": "Ah oui, tu ne supportes pas le romarin.\r\nReste là, alors.",
  "SM_002140_0045_CER": "« Alors c'est toi qui nous\r\nparlais tout à l'heure ! »",
  "CE_002040_0000_CER": "Hé, les interrupteurs se sont retournés,\r\net je peux plus appuyer dessus !",
  "SM_002130_0080_FAS": "« Oh, mais c'est un loup blanc\r\nque tu cherches, pas vrai ? »",
  "_01": "",
  "SM_002130_0110_FAS": "« Aie foi dans la voie que tu suis...\r\ncelle-ci est la bonne. »",
  "SM_002040_0180_CER": "« Si j'avais été plus forte, j'aurais\r\npu la sauver cette nuit-là... »",
  "SM_002040_0100_NAR": "Mais alors qu'elle prononçait ces\r\nmots, Cereza réalisa quelque chose...",
  "IN_2000_0010_NAR": "Cereza taquinait le démon,\r\nqui lui répondit d'un regard glacial.",
  "LV_002070_0010_NAR": "Cereza s'esclaffa de joie. Après tout,\r\nelle n'était encore qu'une enfant.",
  "SM_002140_0180_FAS": "« T'inquiète pas pour ça.\r\nSuffit de drainer le lac ! »",
  "_54": "",
  "LV_002005_0030_NAR": "[FONT:10 ]Ça a l'air délicieux, ça, prends-le ![FONT:N ]",
  "SM_002100_0110_COL": "« Je peux juste te demander\r\nun dernier truc ? »",
  "SM_002080_0010_CER": "« T'as vu, hein ? Je t'avais bien\r\ndit que j'étais pas bonne qu'à\r\nte porter ! »",
  "SM_002050_0000_COL": "« Merci, Cereza ! »",
  "SM_002140_0220_CER": "« Oh non ! Clochers... Statues\r\nimmenses... Les sorcières\r\nadorent les hauteurs.\r\nMerci pour ton aide ! »",
  "LV_002010_0010_CER": "Un wisp se fait embêter...\r\nmais toute seule, je peux\r\nrien faire...",
  "SM_002100_0120_COL": "« Si tu rencontres d'autres\r\nde mes amis capturés dans\r\nla forêt, tu pourras les libérer\r\net les envoyer ici ? »",
  "IN_2000_0020_NAR": "[FONT:10 ]Je massacre quiconque s'approche\r\ntrop.[FONT:N ]",
  "CE_002080_0000_CER": "Gnnnah !",
  "SM_002130_0160_CER": "« Jusqu'à ce qu'ils... meurent ? »",
  "SM_002080_0040_NAR": "Cereza en avait assez de\r\nl'arrogance de Chouchou.",
  "LV_002035_0115_NAR": "Chouchou défia Cereza du regard.",
  "LV_002040_0030_CER": "J'aurais bien aimé jouer avec\r\nmaman dans un endroit pareil...",
  "BK_2000_0040_NAR": "[FONT:9 ]Dégage de là ![FONT:N ]\r\nHurla Chouchou à la pauvre Cereza.",
  "SM_002060_0090_COL": "« Et voilà pour toi. On ne sait pas\r\ncomment ça s'utilise, mais ça a\r\nl'air d'être un truc magique. »",
  "CE_002800_0000_CER": "Tant qu'il sera assis sur cette balle,\r\ncelui-là, on sera coincés. Pas le choix,\r\nil faut qu'on la lui prenne !",
  "SM_002060_0100_CER": "« Merci beaucoup ! »",
  "IN_2000_0040_CER": "Sans blague !",
  "SM_002130_0010_CER": "« Q-Qui est là ?! »",
  "CE_002000_0000_CER": "Descends de là !",
  "SM_002060_0130_COL": "« Pas de souci ! Et si tu as\r\nbesoin de quoi que ce soit,\r\nt'as qu'à me le dire. »",
  "LV_002035_0020_CER": "J'ai remarqué que tu t'en servais surtout\r\npour te plaindre. Tu veux rentrer chez\r\ntoi, oui ou non ?",
  "SM_002130_0210_FAS": "« Le devoir m'appelle\r\nailleurs. Je vous\r\nsouhaite bonne chance\r\npour la suite. »",
  "SM_002100_0050_CER": "« Le loup blanc ! »",
  "LV_002055_0010_NAR": "Chaque wisp qu'elle secourait apportait\r\nde la joie dans le cœur de Cereza.",
  "LV_002905_0010_CER": "Le noyau élémentaire est proche !\r\nPeut-être dans ce chapiteau... ?",
  "LV_002090_0010_CER": "Qu'est-ce que c'est ?",
  "BK_2010_0040_LUC": "« Sèche tes larmes... »",
  "SM_002010_0030_COL": "« T-T'es qui ? Tu t'es perdue ? »",
  "SM_002040_0040_NAR": "[FONT:9 ]Tu peux me rappeler pourquoi\r\non a secouru ces zozos ?[FONT:N ]\r\nDemanda-t-il avec lassitude.",
  "SM_002110_0070_CER": "« Chouchou ! Aaah, mes cheveux\r\nsont tout gluants, maintenant ! »",
  "SM_002010_0000_CER": "« Est-ce... un wisp ? »",
  "SM_002130_0060_FAS": "« Pose-moi donc une question, si\r\ntu ne me crois pas. Je répondrai\r\nà toutes tes interrogations. »",
  "SM_002140_0030_NAR": "Cereza suivit le son de la voix et\r\naperçut un étrange wisp affublé\r\nd'un grand chapeau.",
  "SM_002040_0070_NAR": "[FONT:9 ]Mais ça, on s'en cogne, non ?[FONT:N ]\r\nRépliqua Chouchou. Décidément,\r\nles démons sont terriblement\r\négoïstes.",
  "SM_002140_0120_CER": "« Donc, tu t'appelles Ignis,\r\nc'est bien ça ? »",
  "SM_002010_0190_CER": "« Moi, j'y vais, même si je dois\r\naffronter les fées toute seule ! »",
  "LV_002915_0000_CER": "Youhouuu !\r\nJe me demande où ça va me mener.",
  "LV_002050_0010_CER": "Je dois être prudente. Si je me fais\r\nrepérer, je serai dans de beaux draps.",
  "SM_002130_0180_FAS": "« Ne t'inquiète pas. Il ne vous\r\nenverra pas ad patres si\r\nfacilement, toi et ton démon. »",
  "SM_002140_0150_CER": "« Au fond du lac ?! »",
  "SM_002040_0110_CER": "« Oh... si ça se trouve, je t'ai arraché\r\nà un être cher quand je t'ai invoqué\r\ndans ce monde... »",
  "SM_002040_0190_NAR": "Alors qu'elle parlait, elle se remémora\r\nla nuit où elle avait échoué à sauver\r\nsa mère...",
  "SM_002010_0160_NAR": "La jeune fille et le démon se défiaient\r\ndu regard sans flancher.",
  "SM_002010_0070_CER": "« Tu as l'air soucieux, Colm.\r\nQu'est-ce qu'il y a ? »",
  "SM_002040_0080_CER": "« Pardon ? Tu les abandonnerais\r\ncomme ça ? »",
  "LV_002925_0000_CER": "On a... échangé nos places ?",
  "SM_002020_0080_NAR": "[FONT:9 ]Ah ouais ? Et comment tu comptes\r\nt'y prendre, mauviette ?[FONT:N ]\r\nRicana le démon, sa bouche\r\ntordue en un rictus cruel.",
  "SM_002020_0000_CER": "« Chouchou ! »",
  "SM_002140_0160_CER": "« Bah, c'est peut-être une\r\nchance, en fait. Je suis plus\r\ndouée pour couler que nager. »",
  "SM_002110_0080_NAR": "Chouchou se régalait pendant que\r\nCereza, elle, tentait en vain d'ôter\r\nla pulpe de ses cheveux.",
  "SM_002010_0040_CER": "« T-Tu peux parler ? »",
  "SM_002060_0050_NAR": "[FONT:9 ]On a une mission à accomplir.\r\nOn a pas le temps de faire\r\nmumuse avec ces morveux.[FONT:N ]\r\nDit Chouchou en louchant sur Colm.",
  "LV_002005_0010_CER": "Qu'est-ce que ça peut bien être ?",
  "SM_002050_0010_NAR": "Colm était ravi. Il leur dit qu'il voulait\r\nleur exprimer sa gratitude pour avoir\r\nsecouru ses amis.",
  "SM_002080_0000_NAR": "Ils avaient vaincu l'abominable fée.\r\nEt Cereza avait l'impression d'y\r\navoir un tout petit peu contribué.",
  "BK_8100_0010_CER": "« Attends. Je me demande\r\nquel pouvoir tu vas obtenir\r\ncette fois... »",
  "CE_002030_0000_CER": "À quoi servent les interrupteurs\r\ndevant chaque pilier ?",
  "CE_002100_0000_CER": "Chouchou, à l'aide !",
  "SM_002130_0050_CER": "« ... dit la voix pas louche du tout,\r\ncachée dans l'ombre. »",
  "SM_002140_0080_FAS": "« Quel dommage. »",
  "IN_2000_0000_CER": "Alors après avoir tant chouiné,\r\ntu as décidé de m'aider !",
  "SM_002010_0080_COL": "« Mes amis...\r\nLes fées les ont enlevés. »",
  "SM_002130_0170_FAS": "« Mes excuses... t'ai-je effrayée ? »",
  "SM_002010_0110_CER": "« Je vais m'en occuper, moi,\r\nde ces vilaines fées ! »",
  "LV_002095_0010_CER": "Hé, mais j'ai déjà vu ce numéro dans une\r\nfoire. J'étais loin de penser que ce serait\r\nun jour moi qui en serais la vedette...",
  "SM_002010_0044_CER": "« Je m'appelle Cereza. Et toi ? »",
  "SM_002140_0230_FAS": "« Avec plaisir. »",
  "SM_002020_0040_NAR": "[FONT:9 ]Si quelque chose t'arrive,\r\nça me retombera dessus.[FONT:N ]\r\nLe démon ne songeait donc\r\nqu'à ses propres intérêts.",
  "SM_002120_0000_NAR": "[FONT:10 ]Tu pourrais te magner ?[FONT:N ]\r\nLe loup leur échappait, et cela\r\nne plaisait pas à Chouchou.",
  "LV_002030_0020_CER": "Peut-être qu'on peut l'utiliser\r\npour atteindre des endroits\r\nqui étaient hors de portée !",
  "CE_002805_0000_CER": "Il esquive tous les tirs ! Il faut\r\nqu'on trouve comment l'atteindre...",
  "LV_002030_0010_CER": "Ce nouveau pouvoir....",
  "SM_002010_0120_COL": "« P-Pour de vrai ?! »",
  "SM_002040_0150_NAR": "[FONT:9 ]Si fort alors que je viens\r\nde naître ! Imagine plus tard ![FONT:N ]\r\nLe démon interrompit la réflexion\r\nde Cereza d'un rire tonitruant.",
  "SM_002140_0110_NAR": "Mais Chouchou ne disait rien.\r\nIl semblait totalement\r\nindifférent envers le wisp.",
  "LV_002080_0030_NAR": "Elle décida de se reposer\r\nun instant.",
  "SM_002130_0140_FAS": "« Un peu plus loin se trouve un vieux\r\ncirque que les fées utilisent pour\r\nattirer les enfants dans la forêt. »",
  "SM_002130_0090_CER": "« Co-Comment tu sais ça ? »",
  "LV_002910_0000_CER": "Ce bruit... !\r\nIl approche !",
  "SM_002100_0140_CER": "« Je t'en donne ma parole ! »",
  "SM_002100_0060_NAR": "Dès qu'elle vit le loup blanc,\r\nCereza bondit sur ses pieds.",
  "LV_002055_0020_CER": "Ces fées sont abominables. N'ayez pas\r\npeur, petits wisps, je vais vous sauver !",
  "CE_002060_0000_CER": "Oh, je vois, ils sont liés aux interrupteurs.",
  "SM_002100_0170_COL": "« Sois prudente, Cereza !\r\nEt toi aussi, petit chat ! »",
  "LV_002090_0020_NAR": "Au loin se dressait une gigantesque tente couleur\r\nsang. Cereza se sentit irrémédiablement attirée,\r\ncomme hypnotisée.",
  "SM_002140_0070_FAS": "« Quelque chose me dit que le\r\ndirecteur du cirque ne pourra plus\r\nfaire de trapèze de sitôt. »",
  "SM_002060_0010_COL": "« Hé, où est passé ton copain chat ? »",
  "SM_002130_0020_NAR": "Cette voix surprit tant Cereza que\r\nson cœur bondit dans sa poitrine.",
  "SM_002130_0130_CER": "« Tu es aussi au courant pour\r\nles noyaux élémentaires ? »",
  "LV_002035_0010_NAR": "[FONT:10 ]Si j'ai une langue, c'est pour lécher\r\nles proies. Tu vas me faire faire ça souvent ?[FONT:N ]",
  "SM_002100_0100_CER": "« Désolée, on est pressés ! »",
  "LV_002005_0020_NAR": "Cereza repéra quelque chose\r\nqui avait l'air d'un fruit.",
  "SM_002140_0200_CER": "« Le plus grand arbre, hm... »",
  "SM_002080_0030_CER": "« Pff, t'es bien snob pour un démon ! »",
  "SM_002100_0090_COL": "« Oh non, tu t'en vas déjà ? »",
  "SM_002100_0010_NAR": "Les derniers mots du garçon\r\nrésonnèrent en elle.",
  "SM_002050_0020_COL": "« Suivez-moi ! »",
  "SM_002140_0190_FAS": "« Mais pour y arriver, tu devras passer\r\npar-dessus un grand arbre. N'est-ce pas\r\npoétique, de devoir grimper au sommet\r\ndu plus grand arbre afin de pouvoir\r\natteindre le fond du lac ? »",
  "LV_002920_0000_CER": "Ça approche !\r\nMais qu'est-ce que c'est ?!",
  "LV_002065_0010_CER": "Colm, tu marches drôlement vite\r\navec des jambes si courtes !",
  "SM_002140_0000_FAS": "« Vous avez aimé le cirque ? »",
  "SM_002030_0010_NAR": "Cereza taquinait le démon,\r\nqui lui répondit d'un regard glacial.",
  "SM_002060_0060_COL": "« Quel chaton mal léché, celui-là !\r\nTiens, pour toi ! »",
  "CE_002050_0000_CER": "Que font ces leviers... ?",
  "SM_002060_0140_NAR": "... Et sur ces paroles, Colm\r\nalla rejoindre ses fantomatiques\r\ncamarades.",
  "SM_002030_0020_NAR": "[FONT:10 ]Je massacre quiconque s'approche\r\ntrop. Contrairement à toi, je\r\npeux me défendre tout seul.[FONT:N ]\r\nfustigea le démon.",
  "IN_2000_0030_NAR": "[FONT:10 ]Contrairement à toi, je peux\r\nme défendre tout seul.[FONT:N ]\r\nFustigea le démon.",
  "SM_002100_0130_COL": "« Tu le regretteras pas,\r\npromis ! »",
  "SM_002100_0020_NAR": "Une douce chaleur envahit Cereza,\r\ncomme si, dans cette forêt froide\r\net sombre, une flamme s'était\r\nallumée dans son cœur.",
  "SM_002130_0220_NAR": "La voix s'évanouit, et le silence\r\nretomba sur la forêt.",
  "SM_002120_0040_NAR": "Le démon ne dit rien. Il se contenta de\r\nfoudroyer Cereza du regard.",
  "_71": "",
  "SM_002040_0120_NAR": "[FONT:9 ]Je venais tout juste de naître.\r\nJe n'ai aucun être cher.\r\nPas besoin d'amour. Juste de force.[FONT:N ]\r\nLa philosophie du démon était simple.",
  "SM_002110_0110_CER": "« T-Tais-toi !\r\nJ'y travaille, un peu de patience ! »",
  "SM_002010_0150_CER": "« On ne va quand même pas\r\nles abandonner à leur sort ! »",
  "BK_2010_0020_CER": "« M-Maman ?\r\nOù es-tu, maman ? »",
  "CE_002035_0000_CER": "Quand on appuie dessus, le spot\r\ns'allume au sommet du pilier...",
  "SM_002130_0100_FAS": "« Toi aussi, tu fais partie de cette\r\nforêt. Ce qui signifie que tes affaires\r\nsont aussi mes affaires. »",
  "BK_2010_0010_CER": "« Pourquoi ça ne s'ouvre pas ? »",
  "SM_002040_0000_CER": "« Ouf, vous êtes tous sains et saufs.\r\nOn a vraiment eu chaud, là ! »",
  "SM_002140_0040_CER": "« Un wisp ? »",
  "CE_002090_0000_CER": "Peux plus... bouger...",
  "SM_002020_0030_NAR": "Secrètement, Cereza était heureuse de\r\nvoir Chouchou. Quant à lui, il boudait. ",
  "SM_002010_0020_CER": "« Hé, petit... Ça va ? »",
  "SM_002140_0090_CER": "« Quelle brute épaisse ce type !\r\nFaire de la figuration dans le spectacle\r\nde quelqu'un d'autre ? Jamais ! »",
  "SM_002130_0040_FAS": "« Ah, et je ne suis pas une fée.\r\nCrois-moi sur parole. »",
  "LV_002025_0010_CER": "On ne peut pas l'abandonner !",
  "CE_002810_0000_CER": "Y en a marre de tes petits tours de\r\npasse-passe ! Chouchou !",
  "SM_002120_0020_CER": "On irait plus vite si tu me\r\nportais sur ton dos !",
  "SM_002020_0060_CER": "« Bah, avec ou sans toi, j'aiderai\r\nces wisps. T'auras qu'à admirer\r\nle spectacle ! »",
  "SM_002130_0240_CER": "« Mais qui était-ce... ? »",
  "CE_002010_0000_CER": "À nous de jouer !",
  "SM_002120_0010_CER": "Je vais aussi vite que je peux !",
  "SM_002020_0050_CER": "« Grmpf. »",
  "LV_002080_0010_CER": "",
  "SM_002140_0130_CER": "« Et dis-moi, Ignis, tu ne saurais\r\npas par hasard où se trouvent\r\nles autres noyaux élémentaires ? »",
  "SM_002040_0170_CER": "« J-Je vais aussi devenir forte !\r\nMais je vais le faire avec grâce,\r\ncontrairement à un certain rustre ! »",
  "LV_002045_0010_NAR": "Il faut qu'on abaisse le pont-levis pour entrer.",
  "SM_002140_0020_NAR": "La voix familière résonna à travers les arbres.",
  "SM_002010_0090_NAR": "Les lèvres de Colm frémirent\r\nà ces paroles.\r\n\r\nIl dit que les fées s'amusaient\r\nsouvent à rassembler des\r\nwisps pour se moquer d'eux.",
  "SM_002060_0110_COL": "« Tu as l'air fatiguée, Cereza. Tu\r\nes en sécurité, ici, alors tu peux\r\nte reposer un peu, si tu veux. »",
  "SM_002060_0080_CER": "« Je crois pas l'avoir encore\r\nvu aussi heureux. Merci ! »",
  "LV_002035_0110_NAR": "[FONT:10 ]Hmpf, sans moi, c'est toi\r\nqu'iras nulle part ![FONT:N ]",
  "BK_2010_0060_LUC": "« Les doux bras d'une mère...\r\ntu retrouveras ceux de la tienne.\r\nEt moi aussi... »",
  "LV_002085_0020_NAR": "Elle aimait jouer avec les wisps, mais\r\nson aventure était loin d'être terminée.",
  "LV_002040_0020_CER": "Ou... des humains vivaient ici jadis ?",
  "SM_002100_0160_NAR": "Faisant leurs au revoir à Colm,\r\nils se remirent à la poursuite\r\ndu loup blanc.",
  "SM_002100_0070_CER": "« Tu es gonflé à bloc,\r\nj'espère, Chouchou ? »",
  "LV_002040_0010_CER": "On est où, là ? Dans une sorte\r\nde terrain de jeu pour fées ?",
  "BK_2010_0050_LUC": "« Tu es plus forte que tu ne\r\nl'imagines. Ta volonté de\r\nsauver les autres te portera. »",
  "LV_002085_0010_NAR": "Cereza reprit son périple à travers la forêt.",
  "SM_002130_0200_FAS": "« C'est bien la preuve qu'elles ont\r\npeur de toi. Et du démon, bien sûr... »",
  "CE_002000_0010_CER": "Chouchou ne peut pas aller\r\naussi haut. C'est pas juste !",
  "SM_002060_0120_CER": "« Tu as raison... Je suis sur le\r\nqui-vive depuis qu'on est dans\r\ncette forêt.\r\n\r\nMerci pour tout, Colm. »",
  "SM_002140_0140_FAS": "« Mais bien sûr que\r\nje sais. Déjà, y en a un\r\nau fond du lac. »",
  "SM_002100_0030_CER": "Je me demande quand je le reverrai...",
  "SM_002060_0040_NAR": "[FONT:9 ]Je me contrecarre des\r\nfalots en son genre.[FONT:N ]",
  "SM_002130_0070_CER": "« OK, alors... Est-ce que\r\ndernièrement, tu as vu un\r\nloup bl... noir dans la forêt ? »",
  "SM_002030_0030_CER": "« Sans blague ! »",
  "LV_002065_0110_CER": "Tu sais, avant de te rencontrer, je\r\ncroyais que les wisps n'existaient\r\nque dans les légendes.",
  "SM_002030_0000_CER": "« Alors après avoir tant chouiné,\r\ntu as décidé de m'aider ! »",
  "SM_002060_0070_NAR": "[FONT:9 ]Tu crois qu'un démon se\r\ncontentera de ça ?[FONT:N ]\r\nMais la salive qui s'échappait de\r\nsa gueule en disait autrement.",
  "LV_002935_0000_CER": "Tu as vu ? Je t'avais bien dit que\r\nje pouvais me débrouiller seule.",
  "SM_002080_0020_NAR": "Mais il en fallait plus pour\r\nimpressionner Chouchou.",
  "SM_002100_0000_CER": "« Et moi aussi... »",
  "BK_8100_0000_CER": "« Comme l'autre fois... »",
  "BK_2000_0020_NAR": "Une fée colossale les surprit.\r\nUne fois de plus, Cereza se\r\nretrouva pétrifiée par la peur.",
  "SM_002020_0020_CER": "« Je savais que tu viendrais.\r\nAprès tout, tu as besoin de mon\r\nénergie magique. J'espère que je\r\npeux compter sur toi pour m'aider ? »",
  "SM_002040_0090_CER": "« Tu sais pas ce que ça fait\r\nd'être arraché à un être cher ? »",
  "SM_002130_0000_FAS": "« Bonjour, mon enfant. »",
  "SM_002040_0010_NAR": "Cereza s'efforça de faire bonne figure,\r\nmais elle avait honte que le démon\r\nait à nouveau dû lui sauver la mise.",
  "SM_002010_0060_COL": "« Moi, c'est Colm ! »",
  "SM_002130_0190_FAS": "« Les fées sont en émoi\r\ndepuis votre arrivée dans\r\nla forêt. »",
  "LV_002015_0010_CER": "Chouchou, un wisp est en\r\ndétresse. Allons l'aider !",
  "SM_002040_0020_NAR": "Chouchou, lui, s'y attendait.\r\nIl s'assit et regarda les wisps\r\navec un total désintérêt.",
  "SM_002130_0030_FAS": "« Bonne question. Disons que...\r\nc'est à moi qu'on s'adresse quand\r\non a des questions sur cette forêt. »",
  "SM_002010_0140_NAR": "Les fières paroles de Cereza\r\nn'avaient pas surpris que le wisp.",
  "CE_002020_0000_CER": "Tu n'iras nulle part !",
  "SM_002110_0100_NAR": "[FONT:9 ]Ah ouais ? Pourtant, ce paquet de poils\r\nsur ton crâne n'a servi à rien ![FONT:N ]\r\nRépliqua le démon avec une insolence\r\ncinglante.",
  "SM_002140_0170_CER": "« Le problème, c'est de\r\nremonter à la surface. »",
  "SM_002040_0130_CER": "« Tu venais de naître ?\r\nMais alors... »",
  "SM_002020_0090_NAR": "Feignant de ne pas l'entendre,\r\nCereza pressa le pas.",
  "SM_002120_0050_CER": "C'est bien ce que je me disais.",
  "SM_002130_0230_CER": "« Elle est partie... »"
}
