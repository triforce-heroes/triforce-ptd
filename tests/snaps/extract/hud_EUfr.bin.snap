{
  "HUD_PURPOSE_TXT_6020": "Stoppe Lukaon.",
  "HUD_INTERACT_TEXT_0036_CER": "Hmm... il fait bien trop sombre\r\npour lire.",
  "HUD_NOTICE_TXT_04": "Nouveau wisp ajouté !",
  "HUD_PURPOSE_TXT_4010": "Dirige-toi vers la\r\nforteresse des fées.",
  "HUD_INTERACT_TEXT_0039_CER": "C'est bon, plus de mandragore ?\r\nJe dois les surveiller, elles\r\npoussent tellement vite...",
  "HUD_GAMEOVER_TXT_0007": "Les fées mirent fin au rêve\r\nde Cereza. Le loup blanc\r\ns'allongea près de son\r\ncadavre, comme pour ne\r\npas la laisser seule.",
  "HUD_INTERACT_TEXT_0009_CER": "Bonjour, petit poisson ! J'espère\r\nque tu deviendras grand et fort !",
  "HUD_GAMEOVER_TXT_0003": "Capturée par les fées, Cereza\r\nfut scellée au sommet du donjon\r\nféérique, son cercueil de cristal\r\ns'érodant lentement sous l'effet\r\nde la pluie et du vent.",
  "HUD_GAMEOVER_TXT_0010": "Le rire mauvais des fées\r\nretentit, et Cereza et Chouchou\r\nfurent éjectés du tír na nÓg\r\npar une force mystérieuse.",
  "HUD_PURPOSE_TXT_1030": "Dépêche-toi !",
  "HUD_PURPOSE_TXT_1130": "Avancez dans la forêt ensemble.",
  "HUD_INTERACT_TEXT_0013_CER": "Je ne devrai pas oublier de remettre\r\nde l'huile dans cette lampe quand je\r\nrentrerai de la forêt.",
  "HUD_INTERACT_TEXT_0301_CER": "Un automate féérique... en métal ?\r\nLe cirque l'utilise aussi... ?",
  "HUD_INTERACT_TEXT_0006_CER": "Cette cruche a l'air antique.\r\nCe serait bien d'en avoir une\r\nneuve un peu plus légère.",
  "HUD_PREVENT_TEXT_0005_CER": "A-Allez Cereza ! Tu vas y arriver !",
  "HUD_INTERACT_TEXT_0402_CER": "Ah... ce truc tournoyant a l'air\r\nhors service, c'est dommage.",
  "HUD_INTERACT_TEXT_0404_CER": "Tous les arbres sont morts...\r\nSûrement l'œuvre des fées.",
  "HUD_PREVENT_TEXT_0003_CER": "Des fées... Si je vais par là, elles\r\nvont m'attraper en un clin d'œil.",
  "HUD_PURPOSE_TXT_1091": "Dirige-toi vers le terrain d'entraînement.",
  "HUD_INTERACT_TEXT_0000_CER": "La demeure de Morgana...\r\nSi je rentre maintenant, elle sera furieuse.",
  "HUD_PURPOSE_TXT_7000": "Entrave et élimine tous les ennemis !",
  "HUD_INTERACT_TEXT_0307_CER": "Oh non, un cul-de-sac ?\r\nIl faut que je trouve une solution,\r\nsinon...",
  "HUD_ITEMOBTAIN_TEXT_006": "Ingrédient enfermé dans un cristal.\r\nÉmet des cris stridents au moindre\r\nsigne de danger. Mieux vaut le ranger\r\nau plus profond de son sac.",
  "HUD_PURPOSE_TXT_5030": "Avance dans le\r\nSanctuaire efflorescent.",
  "HUD_ITEMOBTAIN_TEXT_002": "Énergie magique cristallisée par Avalon.\r\nIl suffit d'en croquer une pour être\r\nimmédiatement émerveillé par son\r\nirrésistible douceur sucrée.",
  "HUD_ITEMOBTAIN_TEXT_011": "Potion de l'Umbra dans un flacon\r\nde ronces. Génère une onde de choc\r\nqui étourdit les ennemis alentours.\r\n*Peut désormais être concocté !",
  "HUD_ITEMOBTAIN_TEXT_102": "Bijou en forme de grande fleur formé\r\nà partir de plusieurs pétales de vitalité.\r\nRésistant à tous les maux, il garantirait\r\nune longue vie.",
  "HUD_PURPOSE_TXT_7004": "Élimine tous les ennemis protégés\r\npar une barrière magique !",
  "HUD_PURPOSE_TXT_2020": "Trouve un moyen d'entrer\r\ndans le donjon féérique.",
  "HUD_PURPOSE_TXT_1195": "Dirigez-vous vers le chapiteau du cirque.",
  "HUD_INTERACT_TEXT_0030_CER": "Je ne peux pas rentrer maintenant !\r\nJe dois m'entraîner ! J'ai attendu ça\r\ntoute la journée !",
  "HUD_PURPOSE_TXT_1081": "Attrape les herbes\r\navec Entrave roncière.",
  "HUD_ITEMOBTAIN_TEXT_005": "Bijou rond infusé du pouvoir de la lune, la source\r\nde puissance des sorcières. On dit qu'il améliore\r\nles compétences de la sorcière qui le trouve.\r\n*Débloque des techniques puissantes (Cereza).",
  "HUD_INTERACT_TEXT_0101_CER": "Ooh, l'air sent tellement bon !\r\nC'est l'endroit idéal pour\r\nse reposer...",
  "HUD_PURPOSE_TXT_5020": "Suis le loup blanc\r\njusqu'à Lukaon.",
  "HUD_GAMEOVER_TXT_0008": "Les wisps continuent d'implorer,\r\nmais Cereza est morte, et\r\npersonne ne viendra...",
  "HUD_PURPOSE_TXT_7003": "Esquive les malédictions et remporte le combat.",
  "HUD_INTERACT_TEXT_0209_CER": "Cette balançoire est en sale état.\r\nSi seulement quelqu'un dans cette\r\nforêt pouvait la réparer...",
  "HUD_INTERACT_TEXT_0223_CER": "Les wisps servent d'accessoires\r\nde cirque ? Mais c'est cruel !",
  "HUD_ITEMOBTAIN_TEXT_101": "Petit bijou en forme de pétale.\r\nFormé à partir de l'essence vitale\r\nde la forêt. En collecter plusieurs\r\naugmenterait la jauge de vitalité.",
  "HUD_ITEMOBTAIN_TEXT_012": "Remède dans un flacon en forme de\r\npétale. Restaure un peu de la vitalité\r\nde Cereza.\r\n*Peut désormais être concocté !",
  "HUD_PURPOSE_TXT_2030": "Progresse dans le\r\ndonjon féérique.",
  "HUD_PURPOSE_TXT_6030": "Parle à Lukaon.",
  "HUD_PURPOSE_TXT_4100": "Suis le loup blanc\r\njusqu'à Lukaon.",
  "HUD_GAMEOVER_TXT_0004": "Cereza s'enfonça dans les\r\nprofondeurs abyssales du lac.\r\nSeules les créatures des\r\nprofondeurs savent ce qu'il\r\nadvint d'elle.",
  "HUD_ITEMOBTAIN_TEXT_009": "Potion de l'Umbra dans un flacon en forme de\r\npapillon. Confère une invincibilité temporaire\r\net permet de lancer les sorts plus rapidement.\r\n*Peut désormais être concocté !",
  "HUD_PURPOSE_TXT_1120": "Cherche un moyen de retourner en Enfer.",
  "HUD_PURPOSE_TXT_3010": "Affronte le dragon\r\nmonstrueux.",
  "HUD_INTERACT_TEXT_0900_CER": "Cette porte est équipée d'une\r\nbalançoire à bascule pile à\r\nla taille des wisps...",
  "HUD_INTERACT_TEXT_0107_CER": "C'est quoi ce truc ?! Bon,\r\nje crois que si je veux faire\r\ndemi-tour, c'est râpé...",
  "HUD_PURPOSE_TXT_1020": "Suis Jeanne.",
  "HUD_NOTICE_TXT_03": "Nouvelle archive débloquée !",
  "HUD_INTERACT_TEXT_0108_CER": "J'ai l'impression que cette forêt\r\nne me laissera pas m'en aller\r\nsi facilement...",
  "HUD_INTERACT_TEXT_0214_CER": "Qui a éparpillé nos avis de recherche\r\npartout ? Quelle bande de malotrus !",
  "HUD_INTERACT_TEXT_0106_CER": "Quel lac immense !\r\nHm ? Quelque chose\r\nest coincé là ?",
  "HUD_INTERACT_TEXT_0901_CER": "Un, deux, trois... on dirait qu'il faut\r\ntrois wisps pour ouvrir cette porte.",
  "HUD_GAMEOVER_TXT_1004": "« Miam, slurp, croc, gloups... »\r\n\r\nQuelques instants plus tard,\r\nun cri de désespoir résonna\r\ndans la forêt silencieuse.",
  "HUD_INTERACT_TEXT_0201_CER": "Le bois est pourri ! J'espère\r\nque les planches ne vont\r\npas céder...",
  "HUD_MAPCL_B_10": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg du Plateau de la souche !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_03": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg du Havre verdoyant !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_ITEMRECIPE_TEXT_009": "Potion dans un flacon en forme de papillon.\r\nOctroie une invincibilité temporaire et permet\r\nd'utiliser plus rapidement les arts de l'Umbra.",
  "HUD_PURPOSE_TXT_2010": "Sauve les amis de Colm\r\ntoute seule.",
  "HUD_MAPCL_B_14": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg des Terres interdites !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_07": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg des Méandres alizés !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_A_08": "Ensemble, le duo a anéanti un\r\ntír na nÓg du Bassin du Géant !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_ITEMOBTAIN_TEXT_021": "Permet de recharger la jauge de\r\nrégénération et donc d'utiliser les\r\narts de l'Umbra plus rapidement.",
  "HUD_MAPCL_A_00": "Ensemble, le duo a anéanti un\r\ntír na nÓg dans un lieu inconnu !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_MAPCL_A_13": "Ensemble, le duo a anéanti un\r\ntír na nÓg des Hauteurs oubliées !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_PURPOSE_TXT_4020": "Dirige-toi seule vers la\r\nforteresse des fées.",
  "HUD_ITEMRECIPE_TEXT_012": "Remède dans un flacon en forme de\r\npétale. Restaure un peu de la vitalité\r\nde Cereza.",
  "HUD_PURPOSE_TXT_6010": "Reprends Chouchou\r\nà Lukaon.",
  "HUD_MAPCL_B_18": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de la forteresse de\r\nPúca ! Le brouillard sinistre s'est\r\ndissipé, révélant des points d'intérêt.",
  "HUD_PURPOSE_TXT_1100": "Rends-toi dans la forêt d'Avalon.",
  "HUD_STATUSUP_TEXT_202": "Le bracelet s'imprègne de la magie absorbée\r\npar Cereza, et lui offre son pouvoir !",
  "HUD_INTERACT_TEXT_0208_CER": "Ce truc a l'air vieux...\r\nil doit être là depuis longtemps.",
  "HUD_MAPCL_A_04": "Ensemble, le duo a anéanti un\r\ntír na nÓg du lac Nimueh !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_MAPCL_A_17": "Ensemble, le duo a anéanti un\r\ntír na nÓg du Bois Écorché !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_INTERACT_TEXT_0212_CER": "C'est censé être moi et Chouchou ?\r\nIls m'ont super mal dessinée, je suis\r\nbien plus mignonne que ça !",
  "HUD_MAPCL_A_03": "Ensemble, le duo a anéanti un\r\ntír na nÓg du Havre verdoyant !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_MAPCL_A_10": "Ensemble, le duo a anéanti un\r\ntír na nÓg du Plateau de la souche !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_INTERACT_TEXT_0031_CER": "Il est bien trop tard pour\r\naller en ville !",
  "HUD_PURPOSE_TXT_4030": "Trouve Chouchou.",
  "HUD_ITEMRECIPE_TEXT_011": "Potion de l'Umbra dans un flacon\r\nde ronces. Génère une onde de choc\r\nqui étourdit les ennemis alentours.",
  "HUD_MAPCL_B_08": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg du Bassin du Géant !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_INTERACT_TEXT_0001_CER": "Ce portail mène à la ville...\r\npas que j'aie envie d'y aller.",
  "HUD_PREVENT_TEXT_0002_CER": "Je dois me concentrer sur mes tâches...\r\nou Morgana me passera un savon\r\nmonumental.",
  "HUD_INTERACT_TEXT_0309_CER": "Toutes les cages sont complètement\r\ndéfoncées. Quelqu'un a dû piquer une\r\ngrosse colère...",
  "HUD_INTERACT_TEXT_0405_CER": "Des flammes partout ! Même les\r\npires entraînements de Morgana\r\nne me font pas autant suer !",
  "HUD_MAPCL_A_07": "Ensemble, le duo a anéanti un\r\ntír na nÓg des Méandres alizés !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_MAPCL_A_14": "Ensemble, le duo a anéanti un\r\ntír na nÓg des Terres interdites !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_PURPOSE_TXT_1010": "Avance.",
  "HUD_PURPOSE_TXT_1110": "Avance dans la forêt.",
  "HUD_STATUSUP_TEXT_201": "La fleur émet une lumière brillante\r\net transmet son énergie !",
  "HUD_INTERACT_TEXT_0014_CER": "Berk, des insectes partout !\r\nLaissez-moi tranquille !",
  "HUD_PURPOSE_TXT_3020": "Draine le lac.",
  "HUD_INTERACT_TEXT_0300_CER": "Qu'est-ce que c'est poussiéreux, ici...\r\nC'est une sorte d'entrepôt féérique ?",
  "HUD_INTERACT_TEXT_0012_CER": "Peut-être que cette chandelle exauce les\r\nvœux ? S'il te plaît, petite chandelle...\r\nexauce mes rêves d'Avalon !",
  "HUD_INTERACT_TEXT_0008_CER": "Oooh, quelle belle vue !\r\nJe pourrais rester ici des\r\nheures... si j'avais le temps.",
  "HUD_PURPOSE_TXT_5010": "Calme Chouchou.",
  "HUD_MAPCL_B_13": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg des Hauteurs oubliées !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_00": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de la zone mystère !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_PREVENT_TEXT_0004_CER": "Non, pas par là... je dois rattraper\r\nle loup blanc !",
  "HUD_INTERACT_TEXT_0007_CER": "Qu'est-ce que mon cahier fait\r\nici ? Je devrais le ranger.",
  "HUD_GAMEOVER_TXT_1003": "Púca le magnanime avait éliminé\r\ntous ses opposants. Il pouvait\r\ndésormais conquérir le monde.",
  "HUD_PURPOSE_TXT_2100": "Dirige-toi vers le\r\ngrand arbre.",
  "HUD_MAPCL_B_17": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg du Bois Écorché !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_04": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg du lac Nimueh !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_INTERACT_TEXT_0037_CER": "La demeure de Morgana a l'air \r\nencore plus sinistre la nuit...",
  "HUD_ITEMOBTAIN_TEXT_022": "Cristal en croissant de lune, imprégné de\r\nmagie. Provient exclusivement de l'Enfer.\r\nRestaure un peu d'énergie magique.",
  "HUD_INTERACT_TEXT_0038_CER": "Il fait si sombre... je risque de\r\ntrébucher ! Alors je ferais mieux\r\nd'éviter l'étang...",
  "HUD_MAPCL_A_18": "Ensemble, le duo a anéanti un\r\ntír na nÓg de la forteresse de\r\nPúca ! Mais il y en a encore\r\nd'autres dans la région...",
  "HUD_PURPOSE_TXT_2050": "Repose-toi au sanctuaire.",
  "HUD_INTERACT_TEXT_0401_CER": "Ces nénuphars sont bien utiles...\r\nils peuvent servir de bateaux,\r\nou de marchepieds...",
  "HUD_GAMEOVER_TXT_2001": "À bout de forces, Jeanne\r\nsentit son âme s'évanouir.\r\nDans la forêt ne restèrent\r\nque deux jouets inanimés.",
  "HUD_MAPCL_A_06": "Ensemble, le duo a anéanti un\r\ntír na nÓg de la Clairière\r\npoudroyante ! Mais il y en a\r\nencore d'autres dans la région...",
  "HUD_MAPCL_A_15": "Ensemble, le duo a anéanti\r\nun tír na nÓg du Sanctuaire\r\nefflorescent ! Mais il y en a\r\nencore d'autres dans la région...",
  "HUD_PREVENT_TEXT_0006_CER": "Tu brûles de savoir ce qu'il y a\r\nderrière cette porte, pas vrai ?\r\nBon, allons voir.",
  "HUD_INTERACT_TEXT_0010_CER": "Je reviendrai bientôt, promis.",
  "HUD_INTERACT_TEXT_0302_CER": "Cette machine est plus grande\r\nque moi ! Je me demande à\r\nquoi elle sert...",
  "HUD_MAPCL_B_09": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de la Cascade de la\r\nvouivre ! Le brouillard sinistre s'est\r\ndissipé, révélant des points d'intérêt.",
  "HUD_INTERACT_TEXT_0020_CER": "J'espère que Morgana prend soin\r\ndes violettes que je lui ai offertes...",
  "HUD_ITEMRECIPE_TEXT_010": "Parfum dans un flacon en forme de\r\nlune. Octroie temporairement de\r\nl'énergie magique illimitée à Chouchou.",
  "HUD_MAPCL_A_02": "Ensemble, le duo a anéanti un\r\ntír na nÓg de la Colline de jade !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_MAPCL_A_11": "Ensemble, le duo a anéanti un\r\ntír na nÓg du donjon féérique !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_INTERACT_TEXT_0035_CER": "« Va chercher de l'eau, Cereza ! »\r\nPff... c'est vraiment digne d'un\r\nentraînement de sorcière, ça ?",
  "HUD_INTERACT_TEXT_0033_CER": "J'ai oublié de nettoyer celle-là...\r\nJe crois qu'il fait trop sombre\r\npour que Morgana le remarque.",
  "HUD_INTERACT_TEXT_0029_CER": "Pouah, ça colle ! Bravo, j'en ai\r\nplein les mains, maintenant...",
  "HUD_FORESTGUIDE_TEXT_001": "Une lueur chaleureuse guide Cereza\r\nvers le sanctuaire le plus proche...",
  "HUD_PURPOSE_TXT_4090": "Quitte la forteresse et\r\ncontinue dans la forêt.",
  "HUD_PURPOSE_TXT_1140": "Porte secours à Cereza.",
  "HUD_PURPOSE_TXT_2012": "Sauvez les wisps ensemble.",
  "HUD_PURPOSE_TXT_3070": "Cherche le dernier\r\nnoyau élémentaire.",
  "HUD_MAPCL_B_16": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de l'Autel du roi des fées !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_05": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de la Côte astrée !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_GAMEOVER_TXT_1002": "Engloutir Cereza ne suffit pas\r\nà rassasier Jabberwock.\r\nIl prit son envol pour trouver\r\nsa prochaine collation.",
  "HUD_PURPOSE_TXT_1040": "Va voir Morgana.",
  "HUD_GAMEOVER_TXT_1006": "Morgana et Lukaon avaient surmonté\r\ntous les obstacles. Plus rien ne les\r\nséparerait jamais.",
  "HUD_PURPOSE_TXT_2105": "Avance à travers les\r\nMéandres alizés.",
  "HUD_INTERACT_TEXT_0304_CER": "Comme cette plante ondule...\r\nc'est hypnotisant...",
  "HUD_INTERACT_TEXT_0016_CER": "J'ai puisé toute cette eau sans que Morgana\r\nme voie. Ça ne pourra pas se plaindre !",
  "HUD_MAPCL_B_12": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de la tour de guet !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_01": "Cereza et Chouchou ont anéanti\r\ntous les tír na nÓg du Chemin des\r\nmurmures ! Le brouillard sinistre s'est\r\ndissipé, révélant des points d'intérêt.",
  "HUD_PURPOSE_TXT_4060": "Cherche le loup blanc.",
  "HUD_PREVENT_TEXT_0000_CER": "Je devrais aller voir Morgana.\r\nJe suis déjà en retard, elle doit être furieuse !",
  "HUD_INTERACT_TEXT_0003_CER": "Ces lanternes sont si lourdes...\r\npas facile de les nettoyer. Et bien\r\nsûr, elles sont de nouveau sales...",
  "HUD_INTERACT_TEXT_0407_CER": "Ces mécanismes me donnent\r\nle tournis...",
  "HUD_INTERACT_TEXT_0019_CER": "Tu crois que les poissons dorment ?",
  "HUD_PURPOSE_TXT_4080": "Détruis le dernier\r\nnoyau élémentaire.",
  "HUD_MAPCL_A_09": "Ensemble, le duo a anéanti un\r\ntír na nÓg de la Cascade de la\r\nvouivre ! Mais il y en a encore\r\nd'autres dans la région...",
  "HUD_GAMEOVER_TXT_1001": "Les fées accueillirent la\r\nnouvelle attraction par une\r\nsalve d'applaudissements.\r\n« Assistez à la véritable\r\nmagie, mes amis... »",
  "HUD_PURPOSE_TXT_1050": "Tire de l'eau du puits est.",
  "HUD_PURPOSE_TXT_8000": "Termine le tír na nÓg !",
  "HUD_INTERACT_TEXT_0220_CER": "Cette cage est complètement\r\ndéfoncée. Je me demande si\r\nelle a été abandonnée là.",
  "HUD_PURPOSE_TXT_1150": "Avancez dans la forêt ensemble.",
  "HUD_PURPOSE_TXT_2011": "Libère les wisps capturés.",
  "HUD_PURPOSE_TXT_3060": "Détruis le troisième\r\nnoyau élémentaire.",
  "HUD_MAPCL_B_15": "Cereza et Chouchou ont anéanti\r\ntous les tír na nÓg du Sanctuaire\r\nefflorescent ! Le brouillard sinistre s'est\r\ndissipé, révélant des points d'intérêt.",
  "HUD_MAPCL_B_06": "Cereza et Chouchou ont anéanti\r\ntous les tír na nÓg de la Clairière\r\npoudroyante ! Le brouillard sinistre s'est\r\ndissipé, révélant des points d'intérêt.",
  "HUD_MAPCL_B_11": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg du donjon féérique !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_MAPCL_B_02": "Cereza et Chouchou ont anéanti tous\r\nles tír na nÓg de la Colline de jade !\r\nLe brouillard sinistre s'est dissipé,\r\nrévélant des points d'intérêt.",
  "HUD_GAMEOVER_TXT_1005": "Après avoir retrouvé son corps et\r\nses pouvoirs, Lukaon fut couronné\r\nroi d'Avalon. Il se recueillit un instant\r\nà la mémoire de tous ceux qui\r\navaient perdu la vie.",
  "HUD_PURPOSE_TXT_6040": "Chevauche Chouchou et\r\néchappe-toi de la forêt.",
  "HUD_PURPOSE_TXT_4070": "Triomphe d'Affinity.",
  "HUD_MAPCL_A_05": "Ensemble, le duo a anéanti un\r\ntír na nÓg de la Côte astrée !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_MAPCL_A_16": "Ensemble, le duo a anéanti un\r\ntír na nÓg de l'Autel du roi des fées !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_INTERACT_TEXT_0219_CER": "Quel immense toboggan...\r\nRien que d'y penser, ça me\r\ndonne mal au popotin.",
  "HUD_PURPOSE_TXT_2040": "Suis les wisps.",
  "HUD_INTERACT_TEXT_0203_CER": "Hm ? Quelque chose est gravé...\r\n« Capturez tous les humains qui\r\nentrent dans la forêt ! »",
  "HUD_INTERACT_TEXT_0104_CER": "Qu-Qu'est-ce que c'est ?\r\nC'était aussi les fées, ça ?!",
  "HUD_INTERACT_TEXT_0216_CER": "Pff, pff... Qu'est-ce qu'il\r\ntransporte avec tant de hâte ?",
  "HUD_INTERACT_TEXT_0500_CER": "Tout est complètement gelé...\r\net moi aussi si je m'attarde ici.",
  "HUD_MAPCL_A_01": "Ensemble, le duo a anéanti un\r\ntír na nÓg du Chemin des\r\nmurmures ! Mais il y en a\r\nencore d'autres dans la région...",
  "HUD_MAPCL_A_12": "Ensemble, le duo a anéanti un\r\ntír na nÓg de la tour de guet !\r\nMais il y en a encore d'autres\r\ndans la région...",
  "HUD_PURPOSE_TXT_1070": "Rends-toi au jardin d'herbes sud.",
  "HUD_PURPOSE_TXT_1170": "Évadez-vous du tír na nÓg.",
  "HUD_PURPOSE_TXT_3040": "Détruis le troisième\r\nnoyau élémentaire.",
  "HUD_PURPOSE_TXT_6060": "Triomphe de Morgana.",
  "HUD_GAMEOVER_TXT_0009": "Capturée par les fées de la\r\nforteresse, l'esprit de Cereza\r\nfut enfermé dans une lanterne,\r\noù il brilla à tout jamais.",
  "HUD_PURPOSE_TXT_7002": "Élimine les ennemis sans te faire toucher !",
  "HUD_ITEMOBTAIN_TEXT_004": "Fruit infernal rare d'aspect méphitique.\r\nPoussant uniquement dans du terreau enrichi\r\npar la magie, il est très sucré et nutritif.\r\n*Débloque des techniques puissantes (Chouchou).",
  "HUD_PURPOSE_TXT_4050": "Avance sans te faire repérer.",
  "HUD_INTERACT_TEXT_0218_CER": "« Les humains sont acceptés ! »\r\nTiens, c'est écrit en langue humaine... ?",
  "HUD_PURPOSE_TXT_1180": "Suivez le loup et trouvez le noyau élémentaire.",
  "HUD_PURPOSE_TXT_1080": "Fais pousser les herbes avec\r\nles arts de l'Umbra de Cereza.",
  "HUD_INTERACT_TEXT_0217_CER": "« Le Grand cirque d'Amadán en\r\nexclusivité en Avalon ! Réservez\r\nvos places ! »... Hein ?",
  "HUD_INTERACT_TEXT_0105_CER": "Wouah ! L'herbe est toute\r\nmouillée ! Ça glisse !",
  "HUD_NOTICE_TXT_02": "Sanctuaire débloqué !",
  "HUD_INTERACT_TEXT_0211_CER": "C'est quoi, ça, une tombe ?\r\nLa tombe de qui, je me demande...",
  "HUD_PURPOSE_TXT_9000": "Explore la forêt.",
  "HUD_GAMEOVER_TXT_0001": "Cereza périt dans la forêt\r\nd'Avalon, et avec le temps,\r\ntous finirent par l'oublier.",
  "HUD_PURPOSE_TXT_2060": "Rends-toi au cirque.",
  "HUD_PURPOSE_TXT_2090": "Trouve le troisième\r\nnoyau élémentaire.",
  "HUD_ITEMOBTAIN_TEXT_008": "Ingrédient enfermé dans un cristal.\r\nPrélevé sur une pauvre licorne. Peut\r\nservir d'ornement en fonction de sa\r\nlongueur et de son lustre.",
  "HUD_GAMEOVER_TXT_0005": "La forteresse de Púca vint à\r\nbout de Cereza. Son cercueil\r\nde cristal fut abandonné dans\r\nun coin obscur.",
  "HUD_INTERACT_TEXT_0017_CER": "Si je vais dans la forêt, je deviendrai\r\nune puissante sorcière. Et comme ça,\r\nplus besoin d'étudier !",
  "HUD_NOTICE_TXT_01": "Nouvelle carte débloquée !",
  "HUD_PURPOSE_TXT_2070": "Triomphe d'Amadán Dubh.",
  "HUD_INTERACT_TEXT_0018_CER": "Je ne vais plus pouvoir admirer ce\r\npaysage... mais je dois devenir forte\r\npour maman !",
  "HUD_INTERACT_TEXT_0406_CER": "Quel bâtiment gigantesque...\r\nSûrement un lieu important.",
  "HUD_GAMEOVER_TXT_0002": "Cereza rendit son dernier soupir\r\nau cœur d'Avalon, et son cercueil\r\nde cristal fut lentement englouti par\r\nl'humus de la forêt.",
  "HUD_INTERACT_TEXT_0002_CER": "Ce caillou ressemble à un croc...\r\nEt si c'était le croc d'un monstre\r\ngéant, tapi juste dessous ?",
  "HUD_INTERACT_TEXT_0310_CER": "Quelqu'un doit être en train de nous\r\nobserver en sirotant une tasse de thé...",
  "HUD_GAMEOVER_TXT_0006": "La chance de Cereza l'avait\r\nabandonnée. Elle fut condamnée\r\nà passer l'éternité dans une cage\r\nféérique d'illusions.",
  "HUD_PURPOSE_TXT_2080": "Détruis le second\r\nnoyau élémentaire.",
  "HUD_PURPOSE_TXT_1160": "Suivez le loup.",
  "HUD_PURPOSE_TXT_3050": "Triomphe de Jabberwock",
  "HUD_PURPOSE_TXT_1060": "Apporte l'eau du puits à Morgana.",
  "HUD_INTERACT_TEXT_0021_CER": "Qu'est-ce que c'est haut !\r\nImagine si on tombe de là...\r\nbrr...",
  "HUD_INTERACT_TEXT_0034_CER": "Je pourrais passer la nuit entière\r\nà regarder les flammes danser\r\ndans l'obscurité...",
  "HUD_ITEMOBTAIN_TEXT_003": "Pétale d'une rose noire qui pousse\r\nen Enfer. Émet une légère énergie\r\nmagique qui en fait une fleur très\r\nprisée par les fées.",
  "HUD_ITEMOBTAIN_TEXT_010": "Parfum de l'Umbra dans un flacon en\r\ncroissant de lune. Octroie temporairement\r\nde l'énergie magique illimitée à Chouchou.\r\n*Peut désormais être concocté !",
  "HUD_ITEMOBTAIN_TEXT_007": "Ingrédient enfermé dans un cristal.\r\nCurieusement, il peut avoir divers\r\neffets selon sa cuisson.",
  "HUD_PURPOSE_TXT_4040": "Cherche Chouchou\r\navec le loup blanc.",
  "HUD_PREVENT_TEXT_0007_CER": "J-je ne peux pas abandonner\r\nmaintenant. Allez, Cereza...\r\nC'est pour Colm que tu le fais !",
  "HUD_INTERACT_TEXT_0004_CER": "Je me demande si c'est Morgana qui\r\na choisi ces lanternes. On a peut-être\r\ndes goûts en commun, après tout !",
  "HUD_INTERACT_TEXT_0400_CER": "Un lac ? Même pas peur !\r\nL'eau, c'est mon élément...",
  "HUD_PURPOSE_TXT_7001": "Élimine les ennemis dans le temps imparti.",
  "HUD_PURPOSE_TXT_1090": "Apporte les herbes à Morgana.",
  "HUD_PREVENT_TEXT_0008_CER": "J'ai oublié le panier d'herbes !\r\nMieux vaut ne pas retourner\r\nla voir les mains vides...",
  "HUD_INTERACT_TEXT_0011_CER": "Je ne vais pas en ville.\r\nJe vais en Avalon !",
  "HUD_PURPOSE_TXT_1190": "Trouvez le second noyau élémentaire."
}
