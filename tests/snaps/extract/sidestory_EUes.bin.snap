{
  "BK_9080_0360_NAR": "Ya sabemos cómo prosiguió el viaje de Cereza y Cheshire,\r\npero ¿qué fue de Jeanne? ¿Qué le ocurrió tras conocer su destino?",
  "BK_9040_0080_NAR": "¡Casi! Quienquiera que estuviera\r\ndetrás de esto había decidido mantener\r\nseparadas a las chicas. Charles mostró\r\nlos dientes y comenzó a rugir.",
  "SM_009010_0260_JEA": "—Muy bien, demonio. ¡Entra en tu nuevo cuerpo!",
  "LV_009045_0000_SIN": "Mi valiente amiga... Márchate, te lo ruego.",
  "BK_9020_0030_NAR": "Esta joven había protegido y vigilado\r\na Cereza en la distancia desde\r\nhacía mucho. Se llamaba Jeanne\r\ny también era una bruja de Umbra\r\nque acababa de comenzar su formación.",
  "BK_9060_0060_JEA": "—No... No... ¡Déjalo!",
  "LV_009035_0000_JEA": "¿Qué es este lugar?\r\nEl pestazo a hada es abrumador...",
  "SM_009020_0210_JEA": "—Pero ¡venga ya! Te tiene que gustar\r\neste cuerpo más que el montón de trapo de Cereza.",
  "BK_9040_0130_SIN": "Puedes referirte a mí como... el que constata los sucesos.",
  "SM_009020_0170_NAR": "Charles parpadeó con incredulidad.\r\n¿Volver... a Inferno?\r\nEso no lo esperaba.\r\n¿Jeanne poseía ese poder?",
  "CE_009805_0000_SIN": "Jeanne, márchate. No es demasiado tarde.",
  "BK_9080_0350_NAR": "Y así concluye la aventura de Jeanne y Charles.",
  "SM_009010_0130_NAR": "Jeanne conocía bien a Cereza.\r\nAl ver al gato de trapo poseído por el\r\ndemonio, lo comprendió todo al instante.",
  "BK_9070_0040_JEA": "—No temo mi destino.\r\nVenga lo que venga,\r\nle haré frente.",
  "LV_009020_0020_NAR": "[FONT:10 ]¿Que me gusta? ¡Cuento los segundos\r\nhasta que me devuelva a Inferno![FONT:N ]",
  "BK_9050_0110_SIN": "—Jeanne, te he mostrado\r\ntu futuro. Si no te alejas\r\nde ella, esa visión\r\nse hará realidad.",
  "BK_9040_0000_JEA": "—¡¿Cereza?!\r\nNoto un rastro débil de su magia.\r\nY no está sola...",
  "BK_9050_0100_NAR": "[FONT:9 ]¡Déjate de truquitos! ¡Te voy a despedazar![FONT:N ]\r\nPor mucho que lo intentó,\r\nCharles fue incapaz de moverse.",
  "BK_9050_0090_NAR": "Una imagen de Jeanne adulta...\r\nrecibiendo un golpe letal\r\npor parte de un desconocido.",
  "SM_009010_0010_JEA": "—¿Es... el gato de trapo de Cereza?\r\n¡Sabía que se había metido en un lío!",
  "BK_9050_0130_NAR": "El espectro se alzó una vez más.\r\nLos observó desde el aire con su\r\nmirada penetrante. Lentamente,\r\nse volvió hacia Cereza.",
  "LV_009055_0030_NAR": "Lo que se encontraba ante ellos\r\npodría cambiar su destino para siempre...",
  "SM_009010_0340_NAR": "Y así es como comenzó el viaje de Jeanne\r\ny Chesh... Charles en busca de Cereza.",
  "BK_9060_0160_SIN": "—¿Qué...? ¿Qué ocurre?\r\nLa Arquieva original...\r\n¡¿Ha despertado?!",
  "SM_009010_0020_JEA": "—Como imaginaba... ¡No es magia feérica!",
  "BK_9050_0120_SIN": "Pero este destino aún no está decidido.\r\nMárchate ahora y quizás logres evitarlo.",
  "LV_009055_0040_NAR": "Jeanne tenía una extraña sensación,\r\nun miedo inexplicable que iba en aumento.",
  "SM_009010_0330_NAR": "A Cheshire no le gustaba su nuevo\r\nnombre, pero no era el momento:\r\nlas protestas debían esperar.",
  "BK_9060_0080_SIN": "—Cuando acabe con él, te tocará a ti.\r\nTe advertí que no te involucraras...\r\nEs una pena que no me hicieras caso.",
  "LV_009015_0020_JEA": "¿«Llorica»? Ah, te refieres a Cereza.",
  "BK_9050_0150_SIN": "—¡Y entonces, al fin, los sucesos serán constatados!",
  "CE_009825_1000_SIN": "Increíble... ¿has conseguido meter un demonio ahí?",
  "SM_009020_0260_CER": "—Cheshire... ahí estás.\r\nNo me ausento ni un minuto y vuelves a perderte.",
  "BK_9050_0160_SIN": "",
  "SM_009010_0300_NAR": "[FONT:9 ]¡¿Charles?![FONT:N ] Quizás el demonio le había\r\ntomado más cariño a «Cheshire»\r\nde lo que estaba dispuesto a admitir.",
  "BK_9060_0120_SIN": "—Imposible.\r\nLa Arquieva original está sometida\r\na mi hechizo. No despertará... jamás.",
  "CE_009825_5000_SIN": "Demonio patético... ¿crees que puedes conmigo?",
  "BK_9040_0070_JEA": "",
  "BK_9020_0070_NAR": "Sabía bien que no debía usar la proyección\r\nde almas a la ligera, pero dudó apenas\r\nunos instantes.",
  "SM_009020_0100_NAR": "Las mejillas de Cereza\r\nempezaron a recuperar su color.",
  "SM_009010_0140_NAR": "Pensó por un momento\r\ny entonces se le ocurrió una idea.",
  "BK_9010_0000_NAR": "Ya conocemos la historia de la extraña amistad entre\r\nuna pequeña bruja y un demonio perdido, pero aún queda\r\nun capítulo secreto oculto entre las páginas de este cuento.",
  "CE_009825_2000_SIN": "¡Una invocación ridícula!",
  "SM_009010_0210_JEA": "—Como quieras.\r\nTe deseo suerte.",
  "LV_009005_0000_JEA": "¿Qué... es eso?",
  "BK_9040_0200_JEA": "—Menuda sarta de tonterías.\r\nNo permitiré que le pongas las manos encima\r\na mi hermana de Umbra.",
  "BK_9040_0170_SIN": "—Un pequeño error de cálculo, pero pronto\r\nserá mía en cualquier caso y, entonces,\r\n¡se constatará la supremacía de mi mundo!",
  "SM_009020_0130_NAR": "Jeanne estaba empezando\r\na desvanecerse. La técnica había\r\nalcanzado el límite y su alma anhelaba\r\nvolver a su cuerpo.",
  "BK_9020_0040_NAR": "A diferencia de Cereza, Jeanne vivía\r\nen el pueblo de las Brujas de Umbra.\r\nAunque estaba prohibido, a menudo\r\nsalía para medir fuerzas con su rival.",
  "BK_9010_0050_CER": "",
  "BK_9040_0020_NAR": "[FONT:9 ]¡Mira, allí![FONT:N ]\r\nCharles había visto algo.",
  "CE_009810_0000_SIN": "Muy bien...",
  "SM_009010_0030_NAR": "[FONT:9 ]¿Quién eres?[FONT:N ]\r\nLa voz de Cheshire alarmó a Jeanne.",
  "CE_009800_2000_SIN": "¡Te tengo!",
  "BK_9070_0060_NAR": "Una vez que se extinguió su poder,\r\nel espectro empezó a titilar,\r\ndesvaneciéndose.",
  "LV_009020_0000_JEA": "Aunque... no me sorprende\r\nque invocara a un demonio dentro de un gato de trapo.",
  "CE_009810_0020_NAR": "El espectro abrió un pergamino\r\ny de la nada hizo aparecer una hada.",
  "LV_009050_0000_SIN": "Si sigues avanzando, lo lamentarás...",
  "BK_9040_0010_NAR": "Algo puso a Jeanne en alerta.\r\nNo era la presencia de ninguna hada.",
  "SM_009010_0190_NAR": "Comparado con el fieltro andrajoso\r\nde Cheshire, el terciopelo de su\r\npelaje brillaba con esplendor. Pero...",
  "BK_9010_0060_CER": "—¿Qué lugar es este?\r\n¿Cheshire?\r\nCheshire, ¿dónde estás?",
  "LV_009055_0010_JEA": "Tienes a Cereza, ¿verdad?\r\n¡¿Dónde está?!",
  "BK_9050_0080_JEA": "",
  "SM_009010_0000_NAR": "Al avanzar por el bosque,\r\nJeanne notó algo peculiar.",
  "BK_9040_0180_NAR": "La locura se apoderaba del espectro mientras\r\nhablaba. Sus ojos ardían con una energía oscura.",
  "BK_9060_0070_NAR": "Charles profirió un grito agonizante.\r\nLas llamas espectrales lo consumían\r\nlentamente.",
  "LV_009035_0010_NAR": "[FONT:10 ]Sí, esto está lleno de esos bichos.\r\nPerfecto para un aperitivo rápido.[FONT:N ]",
  "BK_9020_0010_JEA": "—Oh, no... Creía que podría atravesar\r\nel bosque sin mí, pero este poder\r\nes distinto a los que conozco.",
  "SM_009020_0160_JEA": "—Te estoy preguntando\r\nsi quieres volver al muñeco andrajoso\r\no si prefieres que te envíe a Inferno.",
  "BK_9080_0340_JEA": "—Sea lo que sea lo que me espera...\r\n¡estaré preparada! ¡Seré la bruja más fuerte!",
  "SM_009010_0120_JEA": "—Un momento... Un demonio, aquí...\r\n¿Te invocó Cereza?",
  "SM_009010_0240_NAR": "Y con razón.\r\nEl vacío estaba a punto\r\nde absorberlo para siempre.",
  "CE_009800_1000_SIN": "¡Es hora de constatar los sucesos!",
  "BK_9060_0050_SIN": "Y cuando vuestra súplica no es satisfecha...\r\nEs entonces cuando experimentáis\r\nla verdadera desesperación.",
  "LV_009035_0020_NAR": "El demonio había aprendido algunos trucos\r\ndurante el viaje y quería presumir de ellos.",
  "SM_009020_0230_NAR": "[FONT:9 ]Además, tú eres demasiado bruta.\r\nAl menos con esa mocosa descanso de vez en cuando.[FONT:N ]",
  "BK_9020_0020_JEA": "—Va contra las enseñanzas de Umbra,\r\npero no me queda más remedio.",
  "CE_009835_0000_JEA": "¡Deja de jugar con sus recuerdos, monstruo!",
  "SM_009010_0200_NAR": "[FONT:9 ]¿Cómo voy a confiar en una humana?\r\n¡Sois todos iguales![FONT:N ],\r\nrugió Cheshire.",
  "BK_9050_0070_NAR": "Un instante después, un torrente de espantosas\r\nvisiones inundó la mente de Jeanne.",
  "SM_009020_0120_JEA": "—Creo que se recuperará.\r\nPodrán regresar al bosque y...\r\nSe me acaba el tiempo, me temo.",
  "BK_9020_0050_JEA": "—A esa chica le gusta\r\nmantenerme ocupada.",
  "SM_009020_0270_NAR": "Cereza abrazó a Cheshire,\r\ncontenta de volver a verlo.",
  "BK_9050_0050_SIN": "—Te lo mostraré. Verás lo que puede\r\nocurrir si sigues por este camino.",
  "BK_9070_0090_JEA": "¡¿Cereza?!",
  "SM_009010_0150_JEA": "—Te propongo algo, demonio:\r\nyo te saco de ahí, y tú me ayudas\r\na encontrar a Cereza.",
  "BK_9060_0010_SIN": "—¿Acaso no he hablado con claridad?\r\n¡Lograré la constatación de los sucesos!\r\n¡Es estadísticamente imposible\r\nque logréis impedirlo!",
  "SM_009010_0230_NAR": "[FONT:9 ]¡E-espera![FONT:N ], gritó Cheshire,\r\nincapaz de ocultar su angustia.",
  "BK_9040_0140_JEA": "—Uf, qué rebuscado...\r\nEres peor que este sin nombre\r\nde aquí. En fin, da igual. Si osas\r\nenfrentarte a las Umbra, pagarás.",
  "LV_009000_1000_JEA": "La anciana me echaría un buen rapapolvo\r\nsi se enterara de que estoy aquí.\r\nEn fin, ya estoy acostumbrada.",
  "CE_009820_0000_SIN": "¡Arquieva original, muéstranos tu dolor!",
  "BK_9010_0110_SIN": "—Me sorprende que alguien tan joven haya podido\r\nresistir mi poder. Pero serás mía.",
  "LV_009000_2000_JEA": "Cereza, ¿dónde estás?\r\nEsta chica siempre se mete en líos...",
  "SM_009010_0310_JEA": "—¿Por qué te pones así?\r\nCualquier nombre vale.\r\nVamos, Charles.\r\nNo tenemos tiempo que perder.",
  "BK_9070_0030_SIN": "Jeanne...\r\nhas tomado una decisión...\r\n¡Ese destino ahora será inmutable!",
  "BK_9000_0000_JEA": "—¿Qué...? ¿Qué era eso?\r\nCereza... ¡No!",
  "LV_009010_0000_JEA": "¿Control elemental? Impresionante.\r\nPara haberte invocado Cereza, no estás mal.",
  "BK_9080_0380_NAR": "Le deseamos suerte en su viaje,\r\ny pondremos este capítulo a buen recaudo.",
  "BK_9010_0090_NAR": "Y Cheshire... No había ni rastro de él.\r\n¿Sería obra de las hadas?",
  "LV_009015_0000_NAR": "[FONT:10 ]¿Conoces a esa llorica?[FONT:N ]",
  "SM_009010_0320_JEA": "Has tardado menos de lo que esperaba.\r\nYo he cumplido mi parte del trato.\r\n¡Ahora te toca a ti!",
  "BK_9070_0000_SIN": "",
  "BK_9040_0050_NAR": "Jeanne la miró a la cara: estaba pálida\r\ncomo el hielo.",
  "BK_9050_0220_SIN": "—Jeanne, has visto lo que te aguarda.\r\n¿Y aun así vas a enfrentarte a mí?",
  "BK_9060_0110_JEA": "¡Abre los ojos, idiota!",
  "BK_9070_0010_NAR": "El grito desgarrador del espectro\r\npareció fracturar el mismo aire.",
  "SM_009020_0190_NAR": "[FONT:9 ]¿Y me voy a fiar de ti con algo así?\r\nTe lo pondré fácil. Vuelve a dejarme\r\ndonde me encontraste.[FONT:N ]",
  "LV_009050_0010_JEA": "¿Quién anda ahí?",
  "LV_009020_0030_NAR": "A Jeanne le pareció que Charles\r\nestaba algo más rojo de lo normal.",
  "SM_009020_0320_NAR": "[FONT:9 ]Pero... me has salvado el pellejo,\r\nasí que haré una excepción, solo por esta vez[FONT:N ],\r\nañadió Cheshire quedamente.",
  "BK_9060_0150_NAR": "La sala quedó inundada por una luz\r\nmás brillante que el sol. Todo lo que\r\nlos rodeaba parecía disolverse\r\nen el radiante esplendor.",
  "LV_009055_0000_SIN": "No disfruto viéndote morir...\r\nuna vez me basta.",
  "SM_009020_0310_NAR": "[FONT:9 ]Yo no obedezco a humanos.[FONT:N ]",
  "BK_9020_0100_JEA": "—Cereza, ¿dónde estás?",
  "CE_009805_2000_SIN": "Sabiendo lo que aguarda, ¿te rebelas?",
  "BK_9020_0090_JEA": "—Ahora estoy segura...\r\nAlgo pasa en este bosque,\r\ny no se trata de las hadas.",
  "SM_009020_0280_NAR": "Cheshire suspiró y frunció el ceño.\r\nPero en el fondo sintió un profundo alivio.",
  "LV_009025_0000_JEA": "Cereza... ¡Está cerca, lo presiento!\r\nPero ¿dónde?",
  "LV_009055_0020_NAR": "La voz de Jeanne resonó\r\nen el silencioso bosque.",
  "BK_9060_0170_SIN": "",
  "LV_009015_0040_JEA": "Cereza y yo debemos hacernos más fuertes:\r\nhemos de proteger el legado de las Umbra.",
  "CE_009815_0000_SIN": "¿No te mueres por saber qué pasará ahora?",
  "SM_009020_0150_NAR": "[FONT:9 ]¿Eh? ¿A qué te refieres?[FONT:N ]\r\nCharles parecía estar confundido.",
  "SM_009010_0270_JEA": "—Quién me iba a decir que usaría\r\nesto aquí. Dime tu nombre, demonio.",
  "SM_009010_0110_NAR": "[FONT:9 ]Bah, no sé dónde está esa cría[FONT:N ],\r\ndijo Cheshire intentando camuflar\r\nla desesperación de su voz sin lograrlo.",
  "BK_9040_0090_NAR": "El origen de la inquietud de Jeanne\r\napareció ante ellos, suspendido\r\nen el aire como un espectro.",
  "CE_009805_1000_SIN": "¿Preparada para asumir tu destino, Jeanne?",
  "BK_9050_0000_JEA": "—¿Qué pasa?\r\nNo me digas que ya vas a abandonar.",
  "BK_9040_0100_NAR": "Ambos quedaron hipnotizados\r\npor su mirada y apenas osaron respirar.",
  "SM_009010_0080_NAR": "[FONT:9 ]Cereza... ¿De qué la conoces?[FONT:N ]\r\nCheshire entrecerró los ojos\r\ny observó a Jeanne con interés.",
  "BK_9080_0370_NAR": "Quizás nadie pueda cambiar su destino, pero\r\nel espíritu indomable y la determinación de Jeanne\r\nle mostrarán su auténtico camino.",
  "LV_009040_0000_JEA": "¡Eh! Estas grietas... ¡Siento que Cereza\r\nestá al otro lado!",
  "BK_9040_0120_SIN": "—Amiga mía, volvemos a encontrarnos.\r\nEs hora de presentarse.",
  "SM_009020_0200_JEA": "—Ya veo...\r\nComo desees.",
  "BK_9050_0040_JEA": "—¿Cómo...? ¿Cómo sabes mi nombre?",
  "CE_009825_3000_SIN": "¡No te interpongas!",
  "BK_9010_0020_NAR": "Esta es la historia de dos jóvenes brujas unidas\r\npor un poderoso vínculo, que debe permanecer\r\npara siempre en el mayor de los secretos.",
  "BK_9060_0000_JEA": "—¡Charles!",
  "SM_009020_0110_NAR": "Aún no había despertado, pero,\r\npor la sonrisa de su cara, se habría dicho\r\nque soñaba con algo agradable.",
  "BK_9020_0060_NAR": "Mediante esa técnica, Jeanne separó\r\nsu alma de su cuerpo y voló\r\nhacia el bosque de Ávalon.",
  "BK_9040_0150_SIN": "—Arquieva original...",
  "BK_9060_0030_JEA": "—¡Basta!",
  "BK_9040_0160_SIN": "Y pensar que han sido sus constantes\r\ndesafíos los que me han traído aquí...",
  "SM_009020_0240_JEA": "—Ja... ya veo.",
  "BK_9040_0210_JEA": "—¡Devuélveme a Cereza\r\no prepárate para experimentar la ira de las Umbra!",
  "CE_009830_0000_JEA": "Usar el dolor de Cereza... ¡Qué cobarde!",
  "SM_009010_0160_NAR": "[FONT:9 ]¿Encontrar a Cereza?...[FONT:N ]\r\nEl demonio observaba a Jeanne con recelo.",
  "BK_9010_0010_NAR": "Aquellos de vosotros que hayáis leído el cuento\r\nhasta el final quizás recordéis esta parte.\r\nEl capítulo secreto comienza aquí.",
  "BK_9050_0140_SIN": "—Arquieva original,\r\nno podrás resistir mucho más.\r\nPronto me darás lo que deseo.",
  "BK_9050_0230_JEA": "—No pienso huir.\r\n¡Seré la bruja más fuerte!",
  "LV_009015_0030_JEA": "Sí que gimotea de vez en cuando,\r\npero también posee un poder espectacular.",
  "CE_009825_4000_SIN": "¡Aléjate de mí!",
  "SM_009010_0040_JEA": "—¿Quién anda ahí? ¡Muéstrate!",
  "SM_009010_0280_NAR": "[FONT:9 ]¡No tengo ninguno![FONT:N ]\r\nEl demonio mostró su gratitud del único\r\nmodo que conocía: rugiendo con furia.",
  "BK_9040_0060_JEA": "—¡Cereza!",
  "SM_009010_0070_JEA": "—¿Eres... un demonio?\r\n¿Y qué haces aquí?\r\n¿Dónde está Cereza?",
  "CE_009825_0000_SIN": "¿Me está atacando un muñeco gigante?",
  "SM_009010_0250_NAR": "[FONT:9 ]¡Vale, méteme en ese maldito gato!\r\nPero, si es un truco, ¡te las verás\r\ncon mis colmillos![FONT:N ]\r\nEl demonio aceptó el plan a regañadientes.",
  "CE_009800_0000_SIN": "La resistencia es inútil.",
  "BK_9050_0020_NAR": "Pero el espectro permanecía impasible.\r\nEntonces se levantó mostrando\r\nuna siniestra sonrisa.",
  "LV_009040_0020_NAR": "¿Qué se encontraría al otro lado?\r\n¿Habrían localizado a Cereza por fin?",
  "BK_9020_0000_JEA": "—¡Cereza!",
  "BK_9050_0030_SIN": "—Aún no lo entiendes,\r\n¿verdad, Jeanne?\r\nLo que ocurrirá\r\nsi te enfrentas a mí...",
  "LV_009030_0000_JEA": "¿Qué son esas fisuras?\r\n¿Ilusiones de hadas?",
  "CE_009800_4000_SIN": "¡La Arquieva original será mía!",
  "SM_009020_0140_JEA": "—¿Y bien, Charles, qué me dices?",
  "SM_009020_0220_NAR": "[FONT:9 ]Bah, detesto los dos por igual[FONT:N ],\r\ngruñó Charles, irritado.",
  "BK_9050_0190_SIN": "—Quizás he sido demasiado delicado.\r\nObserva una vez más tu cruel destino.\r\n",
  "BK_9060_0040_SIN": "—Sí...\r\nEso es lo que decís los humanos ante la derrota.",
  "LV_009045_0010_JEA": "Charles, ¿has sido tú?",
  "SM_009010_0100_JEA": "—¿Qué le has hecho?\r\n¡Sal de ahí y explícate!",
  "BK_9050_0180_NAR": "Jeanne se le encaró, desafiante.",
  "LV_009040_0010_NAR": "[FONT:10 ]¡¿Cómo?![FONT:N ]\r\nEl demonio abrió los ojos como platos.",
  "BK_9050_0010_NAR": "[FONT:9 ]Seguro que está malísimo.\r\nSerá mejor que me lo trague de un bocado.[FONT:N ]\r\nEl demonio ya se estaba relamiendo.",
  "BK_9040_0110_JEA": "—Tú has hablado antes conmigo.\r\n¿Quién eres?",
  "SM_009010_0090_JEA": "—Soy una bruja de Umbra...\r\nen formación. Me llamo Jeanne,\r\ny he venido a salvar a Cereza.",
  "LV_009020_0010_JEA": "Y diría que te gusta.",
  "SM_009020_0300_JEA": "—Ni se te ocurra decirle a Cereza\r\nlo que ha ocurrido. Te lo advierto.",
  "BK_9020_0110_NAR": "Jeanne había logrado llegar a Ávalon.\r\nEl aire del bosque estaba impregnado\r\nde una presencia maligna.",
  "BK_9020_0080_NAR": "Si aspiraba a superar a Cereza y llegar a ser\r\nla bruja de Umbra más poderosa de todas,\r\nla cobardía no era una opción.",
  "BK_9070_0070_NAR": "A continuación se abrieron grietas\r\ny fisuras a su alrededor y el mundo\r\ncomenzó a resquebrajarse.",
  "SM_009020_0290_JEA": "—Adiós, Charles... Cheshire.",
  "LV_009025_0010_NAR": "Charles oyó a Jeanne, pero no dijo nada.",
  "CE_009810_0010_SIN": "Aquí tienes una muestra del miedo\r\nque reside en la Arquieva original.",
  "BK_9010_0040_CER": "—¿Cheshire?\r\n¿Dónde estás, Cheshire?",
  "BK_9040_0030_NAR": "Jeanne siguió la mirada de Charles.\r\nA lo lejos divisó una pequeña figura flotante.",
  "BK_9040_0190_NAR": "Pero Jeanne y Charles no se amedrentaron.",
  "BK_9070_0050_SIN": "",
  "SM_009010_0180_NAR": "Jeanne sacó su propio animal\r\nde trapo: un precioso gato rojo.",
  "BK_9010_0070_CER": "",
  "SM_009020_0330_JEA": "—Cualquiera diría que hablo\r\ncon un humano...\r\nCuida de mi amiga, bola de trapo.",
  "CE_009800_3000_SIN": "No tiene sentido.",
  "BK_9060_0140_JEA": "Cumple tu promesa.\r\nYa que dices ser bruja de Umbra...\r\n¡es hora de demostrarlo!",
  "CE_009810_0030_NAR": "Con la magia del reino de las hadas,\r\nesta técnica daba forma al dolor que yacía en Cereza.",
  "LV_009025_0020_NAR": "En el fondo de su corazón, estaba preocupado\r\ny suspiró.",
  "BK_9050_0210_NAR": "[FONT:9 ]Esa niñata me hizo una promesa\r\nque aún tiene que cumplir. ¡No será tuya![FONT:N ]\r\nLa bestia rugió con ferocidad.",
  "LV_009015_0010_NAR": "Charles observó a Jeanne con recelo\r\nmientras hablaba.",
  "SM_009010_0290_JEA": "—Ya veo.\r\nEntonces te llamaré Charles.",
  "BK_9010_0080_NAR": "Cereza había quedado atrapada\r\nen un extraño vacío, petrificada\r\npor una fuerza misteriosa.",
  "BK_9050_0170_JEA": "—Te lo he advertido. ¡No le pongas la mano encima\r\na mi hermana de Umbra!",
  "SM_009010_0060_NAR": "Pero las fuerzas se le iban en evitar\r\nser absorbido. Apenas le quedaban\r\nenergías para moverse.",
  "BK_9070_0020_SIN": "—Esto es... ¡inconcebible!",
  "BK_9080_0390_NAR": "Esta historia será nuestro pequeño secreto...\r\npor siempre jamás.",
  "BK_9060_0130_JEA": "—Cereza, ¿has olvidado nuestra promesa?\r\nJuramos que nos haríamos más fuertes... ¡juntas!",
  "BK_9010_0100_SIN": "—Gracias...\r\nEl poder de las hadas resonó entre\r\ntus recuerdos y me guio hasta aquí.",
  "BK_9050_0200_SIN": "—¡¿Tú también?!",
  "BK_9060_0100_JEA": "—Cereza... ¡Cereza!",
  "SM_009020_0180_NAR": "Por unos instantes, Charles contempló a Jeanne\r\nsin decir nada. Al final, habló.",
  "BK_9060_0090_JEA": "—¡Cereza, despierta!",
  "BK_9010_0030_CER": "—¿Estoy otra vez en el bosque?",
  "BK_9040_0040_NAR": "Era Cereza.\r\nEstaba muy quieta, como si algún\r\npoder desconocido la inmovilizara.",
  "SM_009010_0050_NAR": "[FONT:9 ]No te hagas la tonta.\r\nEres tú la que me ha atrapado aquí, ¿no?[FONT:N ],\r\ndijo Cheshire intentando liberarse\r\npor todos los medios.",
  "BK_9060_0020_NAR": "La mano derecha del espectro empezó a brillar.",
  "SM_009020_0250_NAR": "Jeanne se dio cuenta de que el sonrojado demonio\r\nfingía y le sonrió. Usó sus Artes de Umbra\r\npara concederle el deseo y lo devolvió\r\na su cuerpo anterior.",
  "BK_9050_0060_NAR": "Jeanne y Charles se quedaron inmóviles.\r\nEl espectro los había hechizado.",
  "LV_009000_0000_JEA": "Así que este es el famoso bosque de las hadas...\r\nPero noto otra presencia... Estoy segura.",
  "SM_009010_0170_JEA": "—Ese es el trato.\r\nSi aceptas, te trasladaré\r\na un cuerpo en el que estarás a salvo.\r\nTengo algo perfecto.",
  "SM_009010_0220_NAR": "Jeanne le dio la espalda al orgulloso\r\ndemonio y se dispuso a marchar sola.",
  "BK_9070_0080_JEA": "—Todo se está desintegrando.\r\n¿No era más que una ilusión?",
  "CE_009840_0000_JEA": "Tus trucos ya no funcionan. ¡Vamos!"
}
