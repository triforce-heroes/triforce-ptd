{
  "MENU_HELP_TXT_019_01": "可提升战斗中\r\n抱抱模式下的魔力回复速度。",
  "MENU_HELP_TXT_103_02": "切换为抱抱模式后，\r\n将慢慢回复小柴猫的体力。",
  "MENU_HELP_TXT_115_01": "处于解放模式时，\r\n可在长按[BTN:R2 ]后松开，\r\n使小柴猫发动冲刺攻击。",
  "MENU_HELP_TXT_021_01": "在抱抱模式下推动[BTN:RS ]，\r\n可拉伸小柴猫\r\n以弹飞敌人的远程武器。",
  "MENU_HELP_TXT_204_01": "在菜单画面的记录档案中\r\n可阅览角色与敌人的情报，\r\n以及捡到的笔记内容等等。",
  "MENU_SKILLTREE_DIALOG_TXT_01": "可练习技能。\r\n是否前往练习房间？",
  "MENU_HELP_TXT_212_02": "瑟蕾莎的技能\r\n需要通过缟玛瑙蔷薇来学习；\r\n小柴猫的技能\r\n需要通过阿瓦隆结晶来学习。",
  "MENU_HELP_TXT_104_01": "小柴猫在变身时发动的攻击，\r\n威力高于普通攻击。",
  "MENU_HELP_TXT_112_02": "觉醒后的小柴猫，\r\n按下[BTN:L1 ]可进行回避，\r\n按下[BTN:R1 ]可发动强力攻击。",
  "MENU_HELP_TXT_249_01": "在世界地图中，或在带路时，\r\n伊古妮丝会推荐\r\n目的地附近的区域。",
  "MENU_HELP_TXT_008_01": "可用道具有多种效果。\r\n可长按[BTN:DP ]，\r\n使用拥有的可用道具。",
  "MENU_HELP_TXT_215_01": "抱着变为玩偶的小柴猫，\r\n两人一起行动的状态\r\n为“抱抱模式”。",
  "MENU_HELP_TXT_211_01": "进行冒险的事前准备时，\r\n可更换瑟蕾莎和小柴猫的服装。\r\n满足一定条件即可获得服装。",
  "MENU_HELP_TXT_207_02": "靠近魔女藏身处后，\r\n藏身处将自动开启\r\n并记录在地图上。\r\n看到它时还请靠近。",
  "MENU_SKILLTREE_TXT_327": "按下[BTN:L2 ]的同时转动[BTN:LS ]，\r\n可恢复损坏的物品。",
  "MENU_HELP_TXT_229_01": "部分人魂在得到帮助后，\r\n会跟在瑟蕾莎身后。\r\n但人魂一旦受到攻击，\r\n将会瞬间消失。",
  "MENU_SKILLTREE_TXT_423": "当变身为火灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为火之奥义。",
  "MENU_HELP_TXT_129_01": "处于抱抱模式时，\r\n可朝移动方向推动[BTN:RS ]拉伸小柴猫，\r\n稍微提升移动速度。",
  "MENU_SKILLTREE_TXT_427": "进一步提升小柴猫攻击\r\n对敌人造成的伤害。",
  "MENU_HELP_TXT_216_02": "处于解放模式时，\r\n推动[BTN:LS ]可移动瑟蕾莎，\r\n推动[BTN:RS ]可移动小柴猫。",
  "MENU_HELP_TXT_025_01": "发动魔女脉冲时，\r\n在瑟蕾莎周围的圆圈\r\n变长伸展时，\r\n长推[BTN:LS ]。",
  "MENU_SKILLTREE_TXT_330": "大幅提升可持有的\r\n可用道具数量。",
  "MENU_SKILLTREE_TXT_323": "进一步提升可持有的\r\n可用道具数量。",
  "MENU_HELP_TXT_111_01": "小柴猫是恶魔，\r\n因此无法通过\r\n带有驱魔效果的迷迭香生长处。\r\n请为小柴猫另寻他路。",
  "MENU_HELP_TXT_107_02": "抓住物品时长按[BTN:R1 ]，\r\n可拉动抓着的物品。",
  "MENU_HELP_TXT_238_01": "用红色矿石保存的\r\n独角兽的角，\r\n是魔女的调制素材之一。\r\n可用于制作可用道具。",
  "MENU_HELP_TXT_207_01": "存在于各处的红色拱门区域\r\n为魔女藏身处，\r\n是探索森林时的据点。",
  "MENU_HELP_TXT_022_01": "捡起掉在地上的小柴猫时，\r\n可激起让周围敌人畏缩的冲击波。",
  "MENU_SKILLTREE_TXT_324": "推动[BTN:RS ]拉伸小柴猫，\r\n可弹飞敌人的远程武器。",
  "MENU_SKILLTREE_TXT_420": "瑟蕾莎将坐在小柴猫的背上赋予魔力，\r\n可与小柴猫的力量产生共鸣，\r\n使其进入觉醒状态。",
  "MENU_HELP_TXT_116_01": "处于解放模式时，\r\n可在濒死的敌人附近\r\n使用蓄力突击，\r\n令小柴猫发动致命攻击。",
  "MENU_SKILLTREE_TXT_424": "在抱抱模式下，\r\n按下[BTN:R2 ]，小柴猫将戳击敌人，\r\n使敌人稍微畏缩。",
  "MENU_HELP_TXT_216_01": "召唤小柴猫，\r\n使瑟蕾莎和小柴猫分头移动的\r\n状态为“解放模式”。",
  "MENU_POSEMENU_DIALOG_TXT_03": "即将返回标题画面，\r\n将失去目前为止未记录的故事。\r\n是否确定？",
  "MENU_HELP_TXT_107_01": "按下[BTN:Y ]\r\n可变身为木灵小柴猫。\r\n按下[BTN:R1 ]可使木灵小柴猫\r\n伸出藤蔓舌头抓住物品。",
  "MENU_HELP_TXT_999_01": "？？？",
  "MENU_SKILLTREE_TXT_320": "进一步缩短可再次使用\r\n荆棘束缚的所需时间。",
  "MENU_HELP_TXT_109_03": "此外，水灵小柴猫\r\n可在水中自如地游动。\r\n跳入水中后，小柴猫\r\n将自动变身为水灵小柴猫。",
  "MENU_SKILLTREE_TXT_328": "在抱抱模式下按下[BTN:L1 ]，\r\n瑟蕾莎可向小柴猫传输力量，\r\n回复魔力。",
  "MENU_HELP_TXT_103_01": "小柴猫也有体力，\r\n若持续受到攻击，体力耗尽，\r\n则将变回玩偶。",
  "MENU_HELP_TXT_212_01": "部分灯笼附近有镜子，\r\n按下[BTN:L1 ]调查，\r\n即可学习技能。",
  "MENU_SKILLTREE_DIALOG_TXT_02": "是否结束练习，\r\n离开练习房间？",
  "MENU_HELP_TXT_112_01": "在特定状况下，\r\n当瑟蕾莎坐在小柴猫背上\r\n并给予魔力时，\r\n小柴猫将进入觉醒状态。",
  "MENU_HELP_TXT_249_02": "如果在森林里迷了路，\r\n就去有足迹标记的区域看看吧。\r\n在那附近应该能找到白狼的足迹。",
  "MENU_HELP_TXT_104_02": "此外，变身时的攻击\r\n也有特殊的使用方法，\r\n例如夺取敌人的盾牌。",
  "MENU_HELP_TXT_215_02": "处于抱抱模式时，\r\n推动[BTN:LS ]可移动瑟蕾莎。\r\n推动[BTN:RS ]可拉伸小柴猫，\r\n抓住周围的物品。",
  "MENU_HELP_TXT_203_01": "在菜单画面的状态中，\r\n不仅能确认\r\n瑟蕾莎和小柴猫的状态，\r\n还可确认持有道具的数量。",
  "MENU_HELP_TXT_026_01": "发动魔女脉冲时，\r\n当瑟蕾莎周围的圆圈\r\n两两重合时，\r\n快速推动两次[BTN:LS ]。",
  "MENU_SKILLTREE_TXT_413": "快速连按两次[BTN:L1 ]，\r\n可在击飞周围敌人的同时\r\n切换为抱抱模式。",
  "MENU_HELP_TXT_108_03": "此外，石灵小柴猫身体坚硬，\r\n可抵御大部分攻击。\r\n但每次抵御攻击时，\r\n都会消耗魔力。",
  "MENU_HELP_TXT_102_01": "按下[BTN:R2 ]\r\n可使小柴猫发动抓挠攻击。\r\n小柴猫的攻击同样可破坏\r\n树枝、壶等坚硬物体。",
  "MENU_HELP_TXT_221_03": "在提尔纳诺内按下[BTN:START ]\r\n可打开提尔纳诺菜单，\r\n暂时离开。",
  "MENU_HELP_TXT_213_01": "在技能显示时，按下[BTN:SELECT ]\r\n可移至练习房间。\r\n在练习房间内，\r\n可自由尝试技能及战斗方式。",
  "MENU_SKILLTREE_TXT_304": "战斗时若处于抱抱模式，\r\n魔力将徐徐回复。",
  "MENU_SKILLTREE_TXT_317": "在荆棘束缚完成前，\r\n敌人的动作将更加迟钝。",
  "MENU_HELP_TXT_009_02": "但捉住敌人时，\r\n将消耗1条魔导术计量条。\r\n魔导术计量条\r\n将随着时间流逝慢慢回复。",
  "MENU_HELP_TXT_113_01": "在解放模式下按下[BTN:R1 ]\r\n可使小柴猫弹开攻击。\r\n使用时将消耗魔力。",
  "MENU_HELP_TXT_105_02": "切换为抱抱模式后，\r\n将慢慢回复小柴猫的魔力。",
  "MENU_HELP_TXT_027_01": "部分飞行敌人不经打，\r\n以荆棘束缚就能打倒它们，\r\n遇上飞行敌人时，\r\n先试试拘束吧。",
  "MENU_SKILLTREE_TXT_404": "按下[BTN:R3 ]使小柴猫回避。",
  "MENU_SKILLTREE_TXT_417": "当变身为石灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为石之奥义。",
  "MENU_HELP_TXT_202_01": "菜单画面的地图分为\r\n详细地图和世界地图。\r\n可按下[BTN:Y ]切换。",
  "MENU_HELP_TXT_023_01": "可提升可持有\r\n可用道具的最大数量。",
  "MENU_HELP_TXT_206_01": "按下[BTN:L1 ]调查各地的灯笼，\r\n即可记录故事，\r\n并做好冒险的事前准备。",
  "MENU_HELP_TXT_210_02": "但是，瑟蕾莎只能调制\r\n曾获得过的可用道具。\r\n在森林各地找找看吧。",
  "MENU_CHALLENGE_TXT_12": "请选择\r\n在计时模式中要挑战的提尔纳诺。",
  "MENU_CHALLENGE_TXT_01": "可重新挑战\r\n已攻略的提尔纳诺。",
  "MENU_SKILLTREE_TXT_308": "在荆棘束缚完成前，\r\n敌人的动作将稍显迟钝。",
  "MENU_HELP_TXT_228_02": "根据大门的不同，\r\n所需人魂的数量也有所差异。\r\n仔细寻找一下\r\n周围是否存在人魂。",
  "MENU_HELP_TXT_117_01": "可使用咬杀！对敌人\r\n使出致命一击并回复魔力。",
  "MENU_HELP_TXT_217_01": "处于解放模式时按下[BTN:L1 ]\r\n可使小柴猫变回玩偶，\r\n切换为抱抱模式。",
  "MENU_HELP_TXT_106_01": "按下[BTN:L1 ]，\r\n可将“元素碎片”吸收至魔导器内。\r\n吸收了一定力量后，\r\n可提升魔力计量条的最大值。",
  "MENU_SKILLTREE_TXT_408": "朝移动方向\r\n推动[BTN:RS ]拉伸小柴猫，\r\n可稍微提升移动速度。",
  "MENU_HELP_TXT_110_02": "火焰弹可点燃特定物体\r\n或融化冰块。\r\n此外，火灵小柴猫\r\n可在火焰中前行。",
  "MENU_HELP_TXT_210_01": "进行冒险的事前准备时，\r\n可使用素材调制可用道具。\r\n可在场景内使用\r\n调制好的道具。",
  "MENU_SKILLTREE_TXT_318": "在敌人进行特定攻击后拘束，\r\n可延长拘束时间，\r\n提升一定时间内造成的伤害。",
  "MENU_HELP_TXT_228_01": "借助人魂的力量，\r\n可打开各处的人魂大门。",
  "MENU_CHALLENGE_TXT_11": "请选择\r\n要重新挑战的提尔纳诺。",
  "MENU_CHALLENGE_TXT_02": "可挑战计时模式，\r\n比拼攻略提尔纳诺的时间。",
  "MENU_HELP_TXT_101_01": "推动[BTN:RS ]可移动小柴猫。\r\n遇到部分悬崖或高低坡时，\r\n朝对应方向推动[BTN:RS ]，\r\n即可飞跃悬崖、翻越高低坡。",
  "MENU_HELP_TXT_128_01": "处于解放模式时，\r\n若小柴猫在攻击、回避时变身，\r\n可在变身的同时发动特殊攻击。",
  "MENU_HELP_TXT_217_02": "此外，\r\n处于抱抱模式时按下[BTN:R1 ]，\r\n即可召唤小柴猫，\r\n切换为解放模式。",
  "MENU_HELP_TXT_201_01": "按下[BTN:START ]可打开菜单画面。\r\n按下[BTN:L1 ][BTN:R1 ]可在菜单画面中\r\n切换地图、状态、\r\n记录档案及系统这4个项目。",
  "MENU_HELP_TXT_024_01": "可提升可用道具的效果。\r\n对所有可用道具有效。",
  "MENU_HELP_TXT_110_01": "按下[BTN:A ]\r\n可变身为火灵小柴猫。\r\n按下[BTN:R1 ]可使火灵小柴猫\r\n发射火焰弹。",
  "MENU_SKILLTREE_TXT_418": "使用咬杀！对敌人发动致命一击时，\r\n将回复魔力。",
  "MENU_HELP_TXT_239_01": "用黄色矿石保存的烤蝾螈，\r\n是魔女的调制素材之一。\r\n可用于制作可用道具。",
  "MENU_SKILLTREE_TXT_510": "使用荆棘束缚时，\r\n稍微扩大\r\n魔法阵的展开范围。",
  "MENU_HELP_TXT_018_01": "可在战斗中的抱抱模式下\r\n徐徐回复魔力。",
  "MENU_HELP_TXT_114_01": "可在使用反击弹开敌人攻击后，\r\n按下[BTN:R2 ]发动追击。",
  "MENU_SKILLTREE_TXT_403": "在濒死的敌人附近\r\n使用蓄力突击，\r\n可对敌人发动致命一击。",
  "MENU_SKILLTREE_TXT_410": "当变身为木灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为木之奥义。",
  "MENU_HELP_TXT_205_01": "在菜单画面的系统中\r\n可查看冒险的智慧、更改设置、\r\n读取故事等等。",
  "MENU_HELP_TXT_020_01": "在抱抱模式下按下[BTN:L1 ]，\r\n瑟蕾莎可向小柴猫传输力量，\r\n回复魔力。",
  "MENU_SKILLTREE_TXT_314": "捡起掉在地上的小柴猫时，\r\n可激起让周围敌人畏惧的冲击波。",
  "MENU_HELP_TXT_226_03": "帮助过的人魂信息\r\n将被登记至\r\n记录档案中的“遇到的人魂”。",
  "MENU_HELP_TXT_105_01": "小柴猫头上的计量条\r\n代表小柴猫的魔力。\r\n每当使用特定招式时，\r\n将减少魔力。",
  "MENU_SKILLTREE_TXT_303": "长按[BTN:L2 ]\r\n即可召唤荆棘拘束敌人。\r\n经过一段时间后可再次使用。",
  "MENU_SKILLTREE_TXT_310": "可使用荆棘束缚\r\n同时拘束多名敌人。",
  "MENU_HELP_TXT_009_01": "在敌人附近长按[BTN:L2 ]，\r\n瑟蕾莎将召唤荆棘，\r\n使敌人在一定时间内无法行动。\r\n其名为“荆棘束缚”。",
  "MENU_HELP_TXT_248_01": "在调查许愿灯笼后，\r\n或当故事进入某个节点时，\r\n右下方将出现图标，\r\n自动记录故事。",
  "MENU_SKILLTREE_TXT_407": "回避时按下[BTN:R2 ]，\r\n发动跳跃攻击。",
  "MENU_SKILLTREE_TXT_414": "在小柴猫攻击、回避时变身，\r\n即可在变身时发动特殊攻击。",
  "MENU_HELP_TXT_202_02": "满足一定条件后\r\n即可驱散覆盖在\r\n部分详细地图上的浓雾，\r\n从而确认周围的事物。",
  "MENU_HELP_TXT_214_01": "向魔女藏身处的伊古妮丝搭话，\r\n即可让她引导瑟蕾莎\r\n前往已解锁的区域。",
  "MENU_SKILLTREE_TXT_419": "稍微提升小柴猫的攻击\r\n对敌人造成的伤害。",
  "MENU_HELP_TXT_225_01": "按下[BTN:L1 ]可调查\r\n森林各处令人印象深刻的地点，\r\n将其制成“回忆书签”。\r\n可在记录档案中查看回忆书签。",
  "MENU_HELP_TXT_241_01": "魔法蝴蝶是\r\n蝴蝶状的淡紫色水滴。\r\n摄入它可以提高注意力，\r\n缩短使用魔导术的间隔时间。",
  "MENU_CHALLENGE_DIALOG_TXT_02": "是否挑战该提尔纳诺？",
  "MENU_HELP_TXT_222_02": "若无法满足任务条件，\r\n攻略即告失败。\r\n请务必遵守条件。",
  "MENU_HELP_TXT_234_01": "缟玛瑙蔷薇是\r\n魔界蔷薇的花瓣，\r\n是瑟蕾莎学习技能时的必需品。",
  "MENU_HELP_TXT_250_01": "当小柴猫与瑟蕾莎离得太远，\r\n或是距离迷迭香太近时，\r\n小柴猫便无法切换为抱抱模式。",
  "MENU_HELP_TXT_011_01": "可提升使用荆棘束缚\r\n拘束敌人时的魔力回复量。",
  "MENU_HELP_TXT_125_01": "使用恶魔躲避回避时，\r\n可按下[BTN:R2 ]\r\n令小柴猫发动跳跃攻击。",
  "MENU_HELP_TXT_029_01": "需要连续发动数次魔女脉冲。\r\n在魔女脉冲发动前，\r\n请勿松开[BTN:L2 ]。",
  "MENU_HELP_TXT_208_01": "进行冒险的事前准备时，\r\n将自动记录故事。\r\n除此之外，也建议在各个节点\r\n进行记录。",
  "MENU_HELP_TXT_121_01": "当变身为石灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为石之奥义。",
  "MENU_SKILLTREE_TXT_406": "在被拘束的敌人附近\r\n使用蓄力突击，\r\n可发动强力的协作攻击。",
  "MENU_SKILLTREE_TXT_415": "进一步提升小柴猫的体力。",
  "MENU_HELP_TXT_230_01": "石灵小柴猫可\r\n践踏森林中的巨大蘑菇\r\n以高高跃起。\r\n能在探索高处时起作用。",
  "MENU_HELP_TXT_015_01": "在损坏的物品附近\r\n按下[BTN:L2 ]并转动[BTN:LS ]，\r\n可将损坏的物品修复如初。\r\n其名为“回复”。",
  "MENU_HELP_TXT_119_01": "可在束缚连击的最后\r\n按下[BTN:R2 ]，\r\n发动大范围的终结攻击。",
  "MENU_HELP_TXT_226_02": "其中还有心存烦恼的人魂。\r\n若能帮助人魂，\r\n说不定会有好事发生。",
  "MENU_SKILLTREE_TXT_302": "使用荆棘束缚拘束敌人时，\r\n稍微提升魔力回复量。",
  "MENU_SKILLTREE_TXT_311": "稍微提升战斗时\r\n抱抱模式的魔力回复速度。",
  "MENU_SKILLTREE_TXT_306": "稍微缩短可再次使用\r\n荆棘束缚的所需时间。",
  "MENU_SKILLTREE_TXT_315": "进一步提升使用荆棘束缚\r\n拘束敌人时的魔力回复量。",
  "MENU_HELP_TXT_130_01": "处于抱抱模式时，\r\n按下[BTN:R2 ]，让小柴猫戳击敌人，\r\n使敌人稍微畏缩。",
  "MENU_HELP_TXT_219_01": "森林各处都留有白狼的足迹。\r\n当接近足迹后，\r\n它将变得更加清晰。",
  "MENU_SKILLTREE_TXT_402": "长按[BTN:R2 ]可蓄力。\r\n蓄力一段时间后松开[BTN:R2 ]，\r\n小柴猫将发动冲刺攻击。",
  "MENU_HELP_TXT_108_01": "按下[BTN:B ]\r\n可变身为石灵小柴猫。\r\n按下[BTN:R1 ]可使石灵小柴猫\r\n高高跃起，践踏正下方。",
  "MENU_SKILLTREE_TXT_411": "使用反击弹开敌人的攻击时，\r\n可按下[BTN:R2 ]发动追击。",
  "MENU_HELP_TXT_004_01": "画面左下方的花朵标记\r\n为瑟蕾莎的体力。\r\n当受到敌人的攻击时，\r\n体力将会减少。",
  "MENU_HELP_TXT_245_01": "恶魔调喷雾是\r\n装在新月造型药瓶里的可用道具。\r\n按下[BTN:DP_R ]使用，\r\n即可让小柴猫暂时不会消耗魔力。",
  "MENU_HELP_TXT_221_01": "妖精们制造的幻象源头\r\n叫“幻影妖域提尔纳诺”。\r\n森林中有若干个提尔纳诺。",
  "MENU_SKILLTREE_TXT_405": "稍微提升小柴猫的体力。\r\n若体力耗尽，\r\n小柴猫将变回玩偶。",
  "MENU_SKILLTREE_TXT_416": "当变身为水灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为水之奥义。",
  "MENU_HELP_TXT_242_01": "新月水晶是\r\n蕴含力量的新月形水晶。\r\n服用它可稍微回复魔力。",
  "MENU_HELP_TXT_226_01": "人魂存在于森林各处。\r\n按下[BTN:L1 ]可救出\r\n被妖精捉住的人魂。",
  "MENU_HELP_TXT_003_01": "靠近对象后按下[BTN:L2 ]，\r\n配合瑟蕾莎周围的圆圈，\r\n抓准时机推动[BTN:LS ]，\r\n可发动魔女脉冲。",
  "MENU_SKILLTREE_TXT_301": "按住[BTN:L2 ]\r\n并抓准时机推动[BTN:LS ]，\r\n即可对植物及机关产生影响。",
  "MENU_SKILLTREE_TXT_312": "稍微提升可持有的\r\n可用道具数量。",
  "MENU_HELP_TXT_219_02": "狼的足迹\r\n是通往目的地的标志。\r\n迷路时就找找足迹吧。",
  "MENU_HELP_TXT_126_01": "处于抱抱模式时，\r\n在敌人的攻击即将命中的瞬间\r\n按下[BTN:R1 ]，将在\r\n召唤小柴猫的同时发动反击。",
  "MENU_HELP_TXT_004_02": "当体力耗尽时，\r\n瑟蕾莎就会失去性命。\r\n请多加留意剩余体力。",
  "MENU_HELP_TXT_221_02": "摧毁藏在提尔纳诺\r\n最深处的核心，\r\n突破提尔纳诺。",
  "MENU_HELP_TXT_012_01": "可缩短使用荆棘束缚后\r\n距离下次使用的所需时间。",
  "MENU_HELP_TXT_237_01": "用绿色的矿石保存的\r\n曼陀罗的根，\r\n是魔女的调制素材之一。\r\n可用于制作可用道具。",
  "MENU_SKILLTREE_TXT_401": "按下[BTN:R1 ]，\r\n可使小柴猫弹开攻击。",
  "MENU_HELP_TXT_108_02": "践踏不仅能攻击敌人，\r\n也可破坏或按下\r\n位于下方的物体。",
  "MENU_HELP_TXT_016_01": "在敌人攻击命中的前一刻进行回避，\r\n感官将暂时变得敏锐，\r\n可以超高速移动。\r\n其名为“魔女时间”。",
  "MENU_HELP_TXT_233_01": "阿瓦隆结晶是\r\n甜甜的魔力结晶，\r\n是小柴猫学习技能时的必需品。",
  "MENU_SKILLTREE_TXT_409": "在束缚连击的最后按[BTN:R2 ]，\r\n可发动强力的大范围终结攻击。",
  "MENU_CHALLENGE_DIALOG_TXT_01": "是否使用道具\r\n解锁该计时模式？",
  "MENU_HELP_TXT_122_01": "当变身为水灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为水之奥义。",
  "MENU_HELP_TXT_250_02": "仔细观察周围的地形，\r\n想办法让他们会合吧。",
  "MENU_SKILLTREE_TXT_309": "按下[BTN:L3 ]使瑟蕾莎回避。",
  "MENU_HELP_TXT_222_01": "在提尔纳诺中，\r\n有时会有一些附带\r\n特殊条件的任务需要完成。",
  "MENU_HELP_TXT_246_01": "爆风鸡尾酒是\r\n装在尖刺药瓶里的可用道具。\r\n按下[BTN:DP_D ]使用，\r\n即可激起冲击波，使敌人昏迷。",
  "MENU_HELP_TXT_007_01": "在抱抱模式下按下[BTN:L1 ]，\r\n可将小柴猫投掷到部分高台。\r\n有些道路需要两人利用地势\r\n高低互相协作才能开启。",
  "MENU_HELP_TXT_133_01": "可提升小柴猫的攻击\r\n对敌人造成的伤害。\r\n对小柴猫的所有攻击生效。",
  "MENU_HELP_TXT_232_01": "小柴猫的攻击可破坏\r\n神祠中的元素核心。\r\n这也是为了达成瑟蕾莎的目标，\r\n请尽情破坏元素核心。",
  "MENU_SKILLTREE_TXT_332": "进一步提升使用荆棘束缚\r\n同时拘束的敌人数量。",
  "MENU_HELP_TXT_017_01": "可按下[BTN:L3 ]令瑟蕾莎回避。",
  "MENU_SKILLTREE_TXT_425": "受小柴猫戳击击中的敌人\r\n偶尔会掉落道具。",
  "MENU_HELP_TXT_123_01": "当变身为火灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为火之奥义。",
  "MENU_SKILLTREE_TXT_525": "使用荆棘束缚时，\r\n进一步扩大\r\n魔法阵的展开范围。",
  "MENU_SKILLTREE_TXT_532": "使用荆棘束缚时，\r\n大幅扩大\r\n魔法阵的展开范围。",
  "MENU_HELP_TXT_010_02": "发动后，敌人在一定时间内\r\n将变得毫无防备，\r\n防御力亦将降低，\r\n小柴猫可对其造成更大的伤害。",
  "MENU_HELP_TXT_006_01": "使用[BTN:L2 ]可使瑟蕾莎使用魔导术。\r\n魔导术的使用对象在附近时，\r\n会自动锁定目标。",
  "MENU_HELP_TXT_247_01": "如果在森林里迷了路，\r\n就去调查各地的森林路标吧。\r\n它将引导你找到魔女藏身处。",
  "MENU_HELP_TXT_223_01": "部分妖精在战斗时将布下屏障。\r\n面对存在屏障的对手，\r\n普通攻击将无效。",
  "MENU_SKILLTREE_TXT_421": "在抱抱模式下，当敌人的攻击\r\n即将命中的瞬间按[BTN:R1 ]，\r\n可边召唤小柴猫，边发动反击。",
  "MENU_HELP_TXT_132_01": "可提升小柴猫的体力。",
  "MENU_SKILLTREE_TXT_325": "提升使用荆棘束缚\r\n同时拘束的敌人数量。",
  "MENU_HELP_TXT_209_02": "此外，可挑战计时模式，\r\n比拼提尔纳诺的攻略时长。\r\n攻略计时模式后，\r\n即可根据评价获得奖励。",
  "MENU_HELP_TXT_002_01": "使用[BTN:L1 ]\r\n可使瑟蕾莎\r\n拿取或调查各种物品。",
  "MENU_HELP_TXT_227_01": "帮助一定数量的人魂后，\r\n与人魂秘密基地里的\r\n柯尔姆见面，说不定……\r\n能得到一些谢礼。",
  "MENU_HELP_TXT_243_01": "疗愈药水是\r\n装在花瓣造型药瓶里的可用道具。\r\n按下[BTN:DP_U ]使用，\r\n即可稍微回复瑟蕾莎的体力。",
  "MENU_HELP_TXT_127_01": "可快速连按两次[BTN:L1 ]\r\n使小柴猫在击飞周围敌人的同时\r\n切换为抱抱模式。",
  "MENU_SKILLTREE_TXT_329": "使用荆棘束缚拘束敌人时，\r\n大幅提升魔力回复量。",
  "MENU_HELP_TXT_236_01": "月之珍珠是\r\n纯粹的魔力结晶。\r\n用于学习瑟蕾莎的强大技能。",
  "MENU_HELP_TXT_109_02": "水柱激流的射程很远，\r\n可以转动、挪动多种物体。\r\n此外，也可用来灭火。",
  "MENU_HELP_TXT_013_01": "在荆棘束缚完成前，\r\n进入魔法阵内的敌人将变得迟钝。",
  "MENU_HELP_TXT_209_01": "进行冒险的事前准备时，\r\n可重新挑战\r\n已通关的提尔纳诺，\r\n以重新收集错过的宝箱等等。",
  "MENU_HELP_TXT_120_01": "当变身为木灵小柴猫时，\r\n束缚连击的终结攻击\r\n将变为木之奥义。",
  "MENU_HELP_TXT_014_01": "可同时拘束位于\r\n荆棘束缚魔法阵中的多名敌人。",
  "MENU_HELP_TXT_112_03": "另外，按下[BTN:A ][BTN:B ][BTN:X ][BTN:Y ]，\r\n可发动火、石、水、木之攻击。",
  "MENU_HELP_TXT_231_01": "按下[BTN:L1 ]可吸收\r\n森林各处的元素碎片。\r\n吸收过的元素碎片\r\n不会再次出现。",
  "MENU_HELP_TXT_118_01": "处于解放模式时，\r\n可在被荆棘束缚拘束的敌人附近\r\n按下[BTN:R2 ]使用蓄力突击，\r\n发动强力的协作技能。",
  "MENU_HELP_TXT_227_02": "当柯尔姆有话想说时，\r\n地图上将显示人魂标记。\r\n看到标记就去跟柯尔姆搭话吧。",
  "MENU_HELP_TXT_131_01": "可使小柴猫戳击\r\n击中的敌人偶尔掉落道具。",
  "MENU_HELP_TXT_218_01": "处于抱抱模式时，\r\n推动[BTN:RS ]抓住狗尾草后\r\n按下[BTN:L1 ]即可高高跃起。",
  "MENU_HELP_TXT_109_01": "按下[BTN:X ]\r\n可变身为水灵小柴猫。\r\n按下[BTN:R1 ]可使水灵小柴猫\r\n喷出水柱激流。",
  "MENU_HELP_TXT_220_01": "在妖精制造的扭曲空间中，\r\n会出现各种幻象迷惑前行的人。\r\n长按[BTN:L2 ]照亮周围，\r\n可以找到隐藏的物品和敌人。",
  "MENU_HELP_TXT_244_01": "暗影糖浆是\r\n装在蝴蝶造型药瓶里的可用道具。\r\n按下[BTN:DP_L ]使用，即可使瑟蕾莎暂时\r\n保持无敌状态，缩短使用魔导术的间隔时间。",
  "MENU_HELP_TXT_005_01": "收集5个命樱花瓣\r\n或1个命樱之花，\r\n可提升瑟蕾莎的体力上限。",
  "MENU_HELP_TXT_240_01": "命樱花瓣是\r\n花瓣状的小小宝石。\r\n收集5个即可化作命樱之花，\r\n提升瑟蕾莎的体力上限。",
  "MENU_HELP_TXT_224_01": "捡起掉落在森林各处的笔记，\r\n即可将其登记至记录档案，\r\n并在记录档案中查看。",
  "MENU_HELP_TXT_001_01": "推动[BTN:LS ]可移动瑟蕾莎。\r\n遇到部分悬崖或高低坡时，\r\n朝对应方向推动[BTN:LS ]，\r\n即可飞跃悬崖、翻越高低坡。",
  "MENU_SKILLTREE_TXT_331": "按下[BTN:L1 ]回避敌人的攻击，\r\n感官将变得敏锐，\r\n可以超高速行动。",
  "MENU_SKILLTREE_TXT_322": "提升可用道具的效果。",
  "MENU_HELP_TXT_135_01": "小柴猫可在有一定高度的地方\r\n按下[BTN:R1 ]从高处跳下。\r\n与瑟蕾莎相同，白色的标记就是标志。",
  "MENU_SKILLTREE_TXT_426": "提升受小柴猫戳击的敌人的\r\n道具掉落概率，\r\n增加掉落道具的种类。",
  "MENU_HELP_TXT_216_03": "瑟蕾莎和小柴猫\r\n不能长时间离得太远。\r\n请务必多加注意。",
  "MENU_HELP_TXT_006_02": "使用魔导术所需的环状计量条\r\n为“魔导术计量条”。\r\n使用魔导术时将消耗该计量条，\r\n随着时间经过将慢慢回复。",
  "MENU_HELP_TXT_223_02": "小柴猫变身\r\n是解除屏障的关键。\r\n可针对对手的弱点破坏屏障。",
  "MENU_SKILLTREE_TXT_422": "大幅提升小柴猫的体力。",
  "MENU_HELP_TXT_010_01": "部分敌人在特定行动后\r\n头上会显示标志。\r\n抓准时机长按[BTN:L2 ]，\r\n即可发动“荆棘牢笼”。",
  "MENU_HELP_TXT_235_01": "炼狱果实是\r\n珍贵的魔界水果，\r\n用于学习小柴猫的强大技能。",
  "MENU_HELP_TXT_124_01": "处于解放模式时，\r\n可按下[BTN:R3 ]\r\n令小柴猫回避。",
  "MENU_SKILLTREE_TXT_326": "进一步提升战斗时抱抱模式的\r\n魔力计量条回复速度。",
  "MENU_HELP_TXT_028_01": "瑟蕾莎可在有一定高度的地方\r\n按下[BTN:L1 ]从高处跳下。\r\n白色的标记就是标志。"
}
