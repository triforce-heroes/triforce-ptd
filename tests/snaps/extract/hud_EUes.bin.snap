{
  "HUD_PURPOSE_TXT_6020": "Detén a Lukaon.",
  "HUD_INTERACT_TEXT_0036_CER": "Mmm... No hay suficiente luz para leer.",
  "HUD_NOTICE_TXT_04": "¡Nuevo fuego fatuo!",
  "HUD_PURPOSE_TXT_4010": "Ve a la fortaleza\r\nde las hadas.",
  "HUD_INTERACT_TEXT_0039_CER": "Ya no queda mandrágora.\r\nTendré que estar alerta:\r\ncrece muy rápido.",
  "HUD_GAMEOVER_TXT_0007": "Las hadas pusieron fin a los\r\nsueños de Cereza. El cadáver\r\ndel lobo blanco yacía a su lado,\r\ncomo si no quisiera alejarse\r\nde ella nunca más.",
  "HUD_INTERACT_TEXT_0009_CER": "¡Ay, qué pececillo más mono!\r\n¡Crece fuerte y sano, pescadito!",
  "HUD_GAMEOVER_TXT_0003": "Las hadas atraparon a Cereza\r\ny la encerraron en un ataúd de\r\ncristal en la cima de la torre,\r\ndonde este acabó erosionado\r\npor los elementos.",
  "HUD_GAMEOVER_TXT_0010": "Las malvadas risas de las hadas\r\nresonaron en la zona cuando\r\nCereza y Cheshire fueron\r\nexpulsados del tír na nÓg\r\npor una fuerza misteriosa.",
  "HUD_PURPOSE_TXT_1030": "Avanza.",
  "HUD_PURPOSE_TXT_1130": "Avanza por el bosque\r\ncon ambos personajes.",
  "HUD_INTERACT_TEXT_0013_CER": "Cuando vuelva del bosque, he de rellenar\r\nel aceite de la lámpara.",
  "HUD_INTERACT_TEXT_0301_CER": "Una hada autómata...\r\n¿La usarán en el circo?",
  "HUD_INTERACT_TEXT_0006_CER": "Esta jarra es viejísima. Ojalá\r\ntuviéramos una más ligera y nueva.",
  "HUD_PREVENT_TEXT_0005_CER": "¡L-lo conseguiré!\r\n¡Vamos, Cereza!",
  "HUD_INTERACT_TEXT_0402_CER": "Vaya... parece que esto tendría\r\nque girar, pero está roto.",
  "HUD_INTERACT_TEXT_0404_CER": "Los árboles están secos. Estoy segura\r\nde que es cosa de las hadas.",
  "HUD_PREVENT_TEXT_0003_CER": "Las hadas... Si voy por ahí,\r\nme atraparían en un abrir y cerrar de ojos.",
  "HUD_PURPOSE_TXT_1091": "Ve al campo de entrenamiento.",
  "HUD_INTERACT_TEXT_0000_CER": "Es la casa de Morgana.\r\nSi vuelvo ahora, se enfadará.",
  "HUD_PURPOSE_TXT_7000": "¡Captura y derrota\r\na todos los enemigos!",
  "HUD_INTERACT_TEXT_0307_CER": "¿Que no hay salida por aquí?\r\nPues he de hacer algo, o si no...",
  "HUD_ITEMOBTAIN_TEXT_006": "Ingrediente cristalizado para pociones.\r\nSe pone a gritar por cualquier cosa.\r\nLo mejor es guardarla en el fondo\r\nde la mochila.",
  "HUD_PURPOSE_TXT_5030": "Avanza hacia\r\nel santuario abandonado.",
  "HUD_ITEMOBTAIN_TEXT_002": "Energía mágica que cristaliza\r\nen Ávalon. Un solo bocado\r\nbasta para colmarte de placer\r\nde pies a cabeza.",
  "HUD_ITEMOBTAIN_TEXT_011": "Poción de Umbra en un frasco\r\npuntiagudo. Al usarla se produce\r\nuna sacudida que aturde a los\r\nenemigos. ¡Puedes prepararla!",
  "HUD_ITEMOBTAIN_TEXT_102": "Una gema grande con forma de\r\nflor compuesta de pétalos vitales.\r\nResistente ante todo mal. Quienes\r\nla adquieren gozan de larga vida.",
  "HUD_PURPOSE_TXT_7004": "¡Derrota a todos los enemigos\r\nprotegidos por una barrera!",
  "HUD_PURPOSE_TXT_2020": "Busca el modo de entrar\r\nen la Torre de las Hadas.",
  "HUD_PURPOSE_TXT_1195": "Ve a la carpa circense.",
  "HUD_INTERACT_TEXT_0030_CER": "Ahora no puedo ir a casa; toca entrenamiento.\r\n¡Estaba desando practicar!",
  "HUD_PURPOSE_TXT_1081": "Atrapa a la hierba fugitiva\r\ncon la brida espinosa.",
  "HUD_ITEMOBTAIN_TEXT_005": "Gema redonda que contiene energía lunar,\r\nel origen del poder de toda bruja. Potencia\r\nlas habilidades de quien la encuentre. Permite\r\na Cereza aprender técnicas potentes.",
  "HUD_INTERACT_TEXT_0101_CER": "Mmm, ¡qué aire más rico!\r\nAquí podré relajarme.",
  "HUD_PURPOSE_TXT_5020": "Sigue al lobo blanco\r\nhasta encontrar a Lukaon.",
  "HUD_GAMEOVER_TXT_0008": "Cereza cayó y dejó\r\ndesamparados a los fuegos\r\nfatuos, quienes siguen\r\nimplorando una ayuda\r\nque ya nunca les llegará.",
  "HUD_PURPOSE_TXT_7003": "¡Evita las maldiciones y\r\nvence a todos los enemigos!",
  "HUD_INTERACT_TEXT_0209_CER": "Pobre columpio... Ojalá hubiera alguien\r\nen el bosque capaz de arreglarlo.",
  "HUD_INTERACT_TEXT_0223_CER": "¡¿Que usan a los fuegos fatuos\r\nen números circenses?! ¡Qué cruel!",
  "HUD_ITEMOBTAIN_TEXT_101": "Gema pequeña con forma de\r\npétalo que contiene la esencia\r\nvital del bosque. Con varias\r\nmejora la vitalidad.",
  "HUD_ITEMOBTAIN_TEXT_012": "Pócima de Umbra en un frasco con\r\nforma de pétalo. Al usarla, Cereza\r\nrecupera vitalidad. ¡Puedes\r\nprepararla!",
  "HUD_PURPOSE_TXT_2030": "Avanza por la Torre\r\nde las Hadas.",
  "HUD_PURPOSE_TXT_6030": "Habla con Lukaon.",
  "HUD_PURPOSE_TXT_4100": "Sigue al lobo blanco\r\nhasta encontrar a Lukaon.",
  "HUD_GAMEOVER_TXT_0004": "Cereza se hundió en la oscuridad\r\nmás profunda del lago. Solo\r\nlos animales que habitan en\r\nel fondo saben qué fue de ella.",
  "HUD_ITEMOBTAIN_TEXT_009": "Poción de Umbra en un frasco con forma\r\nde mariposa. Otorga invencibilidad por\r\nun tiempo y acelera el uso de las Artes\r\nde Umbra. ¡Puedes prepararla!",
  "HUD_PURPOSE_TXT_1120": "Busca el camino de regreso\r\na Inferno.",
  "HUD_PURPOSE_TXT_3010": "Enfréntate al dragón\r\nmonstruoso.",
  "HUD_INTERACT_TEXT_0900_CER": "Hay un balancín encima de la puerta,\r\nde tamaño perfecto para fuegos fatuos.",
  "HUD_INTERACT_TEXT_0107_CER": "¡¿Qué es eso?! Bueno, pues\r\nahora sí que no puedo volver...",
  "HUD_PURPOSE_TXT_1020": "Alcanza a Jeanne.",
  "HUD_NOTICE_TXT_03": "¡Nueva entrada de archivo\r\ndesbloqueada!",
  "HUD_INTERACT_TEXT_0108_CER": "Se ve que el bosque no me va a dejar\r\nescapar tan fácilmente.",
  "HUD_INTERACT_TEXT_0214_CER": "Hay carteles de «Se busca» por todas partes.\r\n¡Las hadas son lo peor!",
  "HUD_INTERACT_TEXT_0106_CER": "¡Menudo lago! ¿Eh?\r\n¿Hay algo ahí... atascado?",
  "HUD_INTERACT_TEXT_0901_CER": "1, 2, 3... Parece que necesitaremos\r\ntres fuegos fatuos para abrir la puerta.",
  "HUD_GAMEOVER_TXT_1004": "«Ñam, glub, crunch, crunch, ñam...»\r\nAl cabo de unos instantes,\r\nun grito desgarrador rompió\r\nel silencio del bosque.",
  "HUD_INTERACT_TEXT_0201_CER": "¡La madera está podrida!\r\nAy, espero que no se rompa...",
  "HUD_MAPCL_B_10": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la Hondonada Caliza.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_03": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del Rincón de la Hojarasca.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_ITEMRECIPE_TEXT_009": "Poción en frasco mariposa para ser\r\ninvencible y usar Artes de Umbra con\r\nmenor tiempo de espera (poca duración).",
  "HUD_PURPOSE_TXT_2010": "Salva a los amigos de Colm\r\ncon Cereza.",
  "HUD_MAPCL_B_14": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de las Tierras Prohibidas.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_07": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del Rincón de los Vientos.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_A_08": "Entre los dos lograron eliminar\r\nun tír na nÓg en la Cuenca\r\ndel Gigante. Pero quedan\r\nmás tír na nÓg en esta zona...",
  "HUD_ITEMOBTAIN_TEXT_021": "Al recoger una, se rellena\r\nel indicador de recarga\r\nde artes para que puedas\r\nvolver a usarlas antes.",
  "HUD_MAPCL_A_00": "Entre los dos lograron eliminar un\r\ntír na nÓg en un lugar desconocido.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_MAPCL_A_13": "Entre los dos lograron eliminar\r\nun tír na nÓg en el Altozano\r\ndel Olvido. Pero quedan más\r\ntír na nÓg en esta zona...",
  "HUD_PURPOSE_TXT_4020": "Ve a la fortaleza\r\nde las hadas con Cereza.",
  "HUD_ITEMRECIPE_TEXT_012": "Pócima en frasco con forma\r\nde pétalo para que Cereza\r\nrecupere un poco de vitalidad.",
  "HUD_PURPOSE_TXT_6010": "Rescata a Cheshire\r\nde manos de Lukaon.",
  "HUD_MAPCL_B_18": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la fortaleza de Púca.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_PURPOSE_TXT_1100": "Ve al bosque de Ávalon.",
  "HUD_STATUSUP_TEXT_202": "¡El brazalete se llena de la magia que\r\nCereza ha absorbido y le concede su poder!",
  "HUD_INTERACT_TEXT_0208_CER": "Esto es muy viejo. Debe de llevar\r\nahí toda la vida.",
  "HUD_MAPCL_A_04": "Entre los dos lograron eliminar\r\nun tír na nÓg en el lago Nimueh.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_MAPCL_A_17": "Entre los dos lograron eliminar un\r\ntír na nÓg en el bosque Ceniciento.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_INTERACT_TEXT_0212_CER": "¿Se supone que somos Cheshire y yo?\r\n¡Pues no me hace justicia!",
  "HUD_MAPCL_A_03": "Entre los dos lograron eliminar\r\nun tír na nÓg en el Rincón\r\nde la Hojarasca. Pero quedan\r\nmás tír na nÓg en esta zona...",
  "HUD_MAPCL_A_10": "Entre los dos lograron eliminar un\r\ntír na nÓg en la Hondonada Caliza.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_INTERACT_TEXT_0031_CER": "¡Es demasiado tarde para ir al pueblo!",
  "HUD_PURPOSE_TXT_4030": "Busca a Cheshire.",
  "HUD_ITEMRECIPE_TEXT_011": "Poción para producir\r\nsacudidas que aturden\r\na los enemigos cercanos.",
  "HUD_MAPCL_B_08": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la Cuenca del Gigante.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_INTERACT_TEXT_0001_CER": "Por ahí se va al pueblo...\r\nNo tengo muchas ganas de ir.",
  "HUD_PREVENT_TEXT_0002_CER": "He de concentrarme en mis tareas\r\nsi no quiero que Morgana vuelva a echar humo.",
  "HUD_INTERACT_TEXT_0309_CER": "Todas las jaulas están destrozadas, como\r\nsi alguien hubiera tenido un ataque de rabia.",
  "HUD_INTERACT_TEXT_0405_CER": "¡Hay llamas por todas partes!\r\nNi los entrenamientos más duros\r\ncon Morgana me hacen sudar así.",
  "HUD_MAPCL_A_07": "Entre los dos lograron eliminar\r\nun tír na nÓg en el Rincón de\r\nlos Vientos. Pero quedan más\r\ntír na nÓg en esta zona...",
  "HUD_MAPCL_A_14": "Entre los dos lograron eliminar un\r\ntír na nÓg en las Tierras Prohibidas.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_PURPOSE_TXT_1010": "Avanza.",
  "HUD_PURPOSE_TXT_1110": "Avanza por el bosque.",
  "HUD_STATUSUP_TEXT_201": "¡La flor emite una brillante luz\r\ny confiere su energía!",
  "HUD_INTERACT_TEXT_0014_CER": "¡Puaj, cuántos bichos!\r\n¡Dejadme en paz!",
  "HUD_PURPOSE_TXT_3020": "Vacía el lago.",
  "HUD_INTERACT_TEXT_0300_CER": "Cuánto polvo hay aquí...\r\n¿Es esto el almacén de alguna hada?",
  "HUD_INTERACT_TEXT_0012_CER": "Voy a pedir un deseo...\r\n¡Que Ávalon haga realidad mis sueños!",
  "HUD_INTERACT_TEXT_0008_CER": "¡Menudas vistas! Me quedaría\r\naquí para siempre... pero no\r\ntengo tiempo.",
  "HUD_PURPOSE_TXT_5010": "Amansa a Cheshire.",
  "HUD_MAPCL_B_13": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del Altozano del Olvido.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_00": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la región desconocida.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_PREVENT_TEXT_0004_CER": "Por aquí no se va. ¡Tengo que alcanzar\r\nal lobo blanco!",
  "HUD_INTERACT_TEXT_0007_CER": "¡¿Pero qué hace aquí mi libro?!\r\nMejor será que lo recoja luego.",
  "HUD_GAMEOVER_TXT_1003": "El magnánimo Púca había\r\nlogrado derrotar al fin a sus\r\ndetractores. El mundo quedaba\r\nal fin a su entera disposición.",
  "HUD_PURPOSE_TXT_2100": "Ve al Gran Árbol.",
  "HUD_MAPCL_B_17": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del bosque Ceniciento.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_04": "Cereza y Cheshire han eliminado\r\ntodos los tír na nÓg del lago Nimueh.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_INTERACT_TEXT_0037_CER": "La casa de Morgana\r\nda más miedo de noche.",
  "HUD_ITEMOBTAIN_TEXT_022": "Cristal imbuido de poder con forma\r\nde luna creciente. Se encuentra en\r\nInferno y puede restaurar la energía\r\nmágica parcialmente.",
  "HUD_INTERACT_TEXT_0038_CER": "Con tan poca luz, es probable que me caiga.\r\nMejor me alejo del estanque...",
  "HUD_MAPCL_A_18": "Entre los dos lograron eliminar un\r\ntír na nÓg en la fortaleza de Púca.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_PURPOSE_TXT_2050": "Descansa en el santuario.",
  "HUD_INTERACT_TEXT_0401_CER": "Los nenúfares son muy prácticos:\r\ncomo barcas, como plataformas...",
  "HUD_GAMEOVER_TXT_2001": "El alma de Jeanne abandonó\r\nsu cuerpo y se desvaneció.\r\nPronto no quedaron en el bosque\r\nmás que dos muñecos\r\nabandonados.",
  "HUD_MAPCL_A_06": "Entre los dos lograron eliminar un\r\ntír na nÓg en la Arboleda Radiante.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_MAPCL_A_15": "Entre los dos lograron eliminar\r\nun tír na nÓg en el santuario\r\nabandonado. Pero quedan\r\nmás tír na nÓg en esta zona...",
  "HUD_PREVENT_TEXT_0006_CER": "Estás deseando ver qué hay tras la puerta,\r\n¿verdad? Bueno, pues vamos allá.",
  "HUD_INTERACT_TEXT_0010_CER": "Volveré pronto, lo prometo.",
  "HUD_INTERACT_TEXT_0302_CER": "¡Esta máquina es más grande que yo!\r\n¿Para qué servirá?",
  "HUD_MAPCL_B_09": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de las Cataratas del Guiverno.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_INTERACT_TEXT_0020_CER": "Espero que Morgana esté cuidando\r\nde las violetas que le regalé...",
  "HUD_ITEMRECIPE_TEXT_010": "Con este perfume Cheshire recibe\r\nenergía mágica ilimitada para usar\r\ntécnicas (poca duración).",
  "HUD_MAPCL_A_02": "Entre los dos lograron eliminar\r\nun tír na nÓg en la colina Jade.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_MAPCL_A_11": "Entre los dos lograron eliminar un\r\ntír na nÓg en la Torre de las Hadas.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_INTERACT_TEXT_0035_CER": "Que llene un cubo de agua y se lo lleve\r\na Morgana... ¿Eso es entrenamiento de bruja?",
  "HUD_INTERACT_TEXT_0033_CER": "Se me ha olvidado limpiar... pero Morgana\r\nno se dará cuenta ahora que es de noche.",
  "HUD_INTERACT_TEXT_0029_CER": "¡Ay, pero qué nido de araña más\r\ngrande! Menos mal que la dueña\r\nno está...",
  "HUD_FORESTGUIDE_TEXT_001": "Una cálida y brillante luz guía\r\na Cereza hacia el siguiente santuario.",
  "HUD_PURPOSE_TXT_4090": "Abandona la fortaleza\r\ny avanza por el bosque.",
  "HUD_PURPOSE_TXT_1140": "Salva a Cereza.",
  "HUD_PURPOSE_TXT_2012": "Salva a los fuegos fatuos\r\ncon ambos personajes.",
  "HUD_PURPOSE_TXT_3070": "Encuentra el último\r\nnúcleo elemental.",
  "HUD_MAPCL_B_16": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del altar del rey de las hadas.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_05": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la Orilla Luminosa.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_GAMEOVER_TXT_1002": "El Jabberwock se tragó a Cereza\r\nde un bocado, pero aún distaba\r\nmucho de quedar satisfecho, por\r\nlo que alzó el vuelo en busca\r\nde su siguiente presa.",
  "HUD_PURPOSE_TXT_1040": "Ve hacia Morgana.",
  "HUD_GAMEOVER_TXT_1006": "Morgana y Lukaon lograron\r\nsuperar todos los obstáculos\r\ny fueron felices y comieron\r\nperdices.",
  "HUD_PURPOSE_TXT_2105": "Avanza por el Rincón\r\nde los Vientos.",
  "HUD_INTERACT_TEXT_0304_CER": "El vaivén de la planta...\r\nes hipnotizante...",
  "HUD_INTERACT_TEXT_0016_CER": "Lo he llenado cuando Morgana no miraba.\r\n¡No se le agotará tan rápidamente!",
  "HUD_MAPCL_B_12": "Cereza y Cheshire han eliminado\r\ntodos los tír na nÓg de la Atalaya.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_01": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del Sendero Susurrante.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_PURPOSE_TXT_4060": "Busca al lobo blanco.",
  "HUD_PREVENT_TEXT_0000_CER": "Será mejor que hable con Morgana.\r\n¡Ya llego tarde y no quiero enfadarla\r\naún más!",
  "HUD_INTERACT_TEXT_0003_CER": "Estas lámparas tan pesadas son difíciles\r\nde limpiar. Ay, ya están sucias otra vez...",
  "HUD_INTERACT_TEXT_0407_CER": "Me mareo solo con mirar.",
  "HUD_INTERACT_TEXT_0019_CER": "¿Estarán dormidos ya los peces?",
  "HUD_PURPOSE_TXT_4080": "Destruye el último\r\nnúcleo elemental.",
  "HUD_MAPCL_A_09": "Entre los dos lograron eliminar\r\nun tír na nÓg en las Cataratas\r\ndel Guiverno. Pero quedan más\r\ntír na nÓg en esta zona...",
  "HUD_GAMEOVER_TXT_1001": "Las hadas rompieron en un aplauso\r\natronador para su nueva atracción.\r\n«Magia de la buena, sin trampa\r\nni cartón...»",
  "HUD_PURPOSE_TXT_1050": "Saca agua del pozo del este.",
  "HUD_PURPOSE_TXT_8000": "¡Completa el tír na nÓg!",
  "HUD_INTERACT_TEXT_0220_CER": "Esta jaula está destrozada,\r\ncomo si la hubieran lanzado por los aires.",
  "HUD_PURPOSE_TXT_1150": "Avanza por el bosque\r\ncon ambos personajes.",
  "HUD_PURPOSE_TXT_2011": "Salva a los fuegos fatuos\r\natrapados.",
  "HUD_PURPOSE_TXT_3060": "Destruye el tercer\r\nnúcleo elemental.",
  "HUD_MAPCL_B_15": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg del santuario abandonado.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_06": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la Arboleda Radiante.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_11": "Cereza y Cheshire han eliminado todos\r\nlos tír na nÓg de la Torre de las Hadas.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_MAPCL_B_02": "Cereza y Cheshire han eliminado\r\ntodos los tír na nÓg de la colina Jade.\r\nLa niebla se ha desvanecido y los puntos\r\nde interés están ahora señalizados.",
  "HUD_GAMEOVER_TXT_1005": "Lukaon logra recuperar su cuerpo\r\ny sus fuerzas y se impone como\r\nverdadero rey de Ávalon, pero\r\nguarda un minuto de silencio\r\npor las almas sacrificadas.",
  "HUD_PURPOSE_TXT_6040": "Monta a lomos de Cheshire\r\ny escapa del bosque.",
  "HUD_PURPOSE_TXT_4070": "Derrota al Affinity.",
  "HUD_MAPCL_A_05": "Entre los dos lograron eliminar un\r\ntír na nÓg en la Orilla Luminosa.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_MAPCL_A_16": "Entre los dos lograron eliminar\r\nun tír na nÓg en el altar del rey\r\nde las hadas. Pero quedan más\r\ntír na nÓg en esta zona...",
  "HUD_INTERACT_TEXT_0219_CER": "Qué tobogán más largo...\r\nSolo de pensarlo me duele el trasero.",
  "HUD_PURPOSE_TXT_2040": "Sigue a los fuegos fatuos.",
  "HUD_INTERACT_TEXT_0203_CER": "A ver qué pone ahí... «¡Capturad a todos\r\nlos humanos que entren en el bosque!»",
  "HUD_INTERACT_TEXT_0104_CER": "¡¿Q-qué ha sido eso?!\r\n¿Otra vez las hadas?",
  "HUD_INTERACT_TEXT_0216_CER": "Aaah... Uf... ¿Qué será\r\nlo que lleva con tantas prisas?",
  "HUD_INTERACT_TEXT_0500_CER": "Todo está congelado. Y yo también\r\nlo estaré si no me doy prisa.",
  "HUD_MAPCL_A_01": "Entre los dos lograron eliminar un\r\ntír na nÓg en el Sendero Susurrante.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_MAPCL_A_12": "Entre los dos lograron eliminar\r\nun tír na nÓg en la Atalaya.\r\nPero quedan más tír na nÓg\r\nen esta zona...",
  "HUD_PURPOSE_TXT_1070": "Ve al jardín de hierbas\r\nque hay al sur.",
  "HUD_PURPOSE_TXT_1170": "Escapa del tír na nÓg.",
  "HUD_PURPOSE_TXT_3040": "Destruye el tercer\r\nnúcleo elemental.",
  "HUD_PURPOSE_TXT_6060": "Derrota a Morgana.",
  "HUD_GAMEOVER_TXT_0009": "Las hadas atraparon a Cereza\r\ne introdujeron su espíritu\r\nen un farol, que ardió con\r\nuna intensidad tan espantosa\r\ncomo extraordinaria.",
  "HUD_PURPOSE_TXT_7002": "¡Derrota a los enemigos\r\nsin que te alcancen!",
  "HUD_ITEMOBTAIN_TEXT_004": "Fruta escasa de aspecto demoniaco y originaria\r\nde Inferno. Requiere terreno rico en magia.\r\nRepleta de nutrientes y dulcísima. Permite\r\na Cheshire aprender técnicas potentes.",
  "HUD_PURPOSE_TXT_4050": "Avanza sin que te descubran.",
  "HUD_INTERACT_TEXT_0218_CER": "«¡Los humanos son bienvenidos en nuestro circo!»\r\n¿Por qué lo pone en mi idioma?",
  "HUD_PURPOSE_TXT_1180": "Sigue al lobo y encuentra\r\nel núcleo elemental.",
  "HUD_PURPOSE_TXT_1080": "Haz crecer hierbas con\r\nArtes de Umbra de Cereza.",
  "HUD_INTERACT_TEXT_0217_CER": "«¡Presentamos al inigualable Amadán Dubh,\r\nen exclusiva en la carpa de Amadán!»",
  "HUD_INTERACT_TEXT_0105_CER": "¡Aaah! ¡La hierba está mojada\r\ny resbala mucho!",
  "HUD_NOTICE_TXT_02": "¡Santuario desbloqueado!",
  "HUD_INTERACT_TEXT_0211_CER": "¿Esto es... una tumba?\r\n¿De quién será?",
  "HUD_PURPOSE_TXT_9000": "Explora el bosque.",
  "HUD_GAMEOVER_TXT_0001": "Cereza falleció en el bosque\r\nde Ávalon y, con el tiempo,\r\ncayó en el olvido.",
  "HUD_PURPOSE_TXT_2060": "Ve al circo.",
  "HUD_PURPOSE_TXT_2090": "Encuentra el tercer\r\nnúcleo elemental.",
  "HUD_ITEMOBTAIN_TEXT_008": "Ingrediente cristalizado para pociones.\r\nCortado de un pobre unicornio. Se puede\r\nusar a modo de adorno dependiendo\r\nde la longitud y el brillo.",
  "HUD_GAMEOVER_TXT_0005": "La vida de Cereza tocó a su fin\r\nen la fortaleza de Púca. Su ataúd\r\nde cristal fue abandonado en\r\nalgún rincón de la fortaleza.",
  "HUD_INTERACT_TEXT_0017_CER": "Si voy al bosque, me convertiré en\r\nuna bruja poderosa. ¡Y no tendré que estudiar!",
  "HUD_NOTICE_TXT_01": "¡Nuevo mapa desbloqueado!",
  "HUD_PURPOSE_TXT_2070": "Derrota a Amadán Dubh.",
  "HUD_INTERACT_TEXT_0018_CER": "Ya no podré disfrutar de las vistas...\r\n¡pero he de ser fuerte por mamá!",
  "HUD_INTERACT_TEXT_0406_CER": "¡Pero qué edificio más grande!\r\nDebe de haber sido muy importante.",
  "HUD_GAMEOVER_TXT_0002": "A Cereza le llegó el fin en lo más\r\nprofundo del bosque. Su féretro\r\nde cristal acabó hundiéndose\r\nentre la tierra y la hojarasca.",
  "HUD_INTERACT_TEXT_0002_CER": "Esta piedra parece un colmillo.\r\nMe imagino un monstruo gigante\r\nagazapado aquí, bajo tierra...",
  "HUD_INTERACT_TEXT_0310_CER": "Parece que alguien nos ha estado observando\r\nmientras se tomaba una tacita de té.",
  "HUD_GAMEOVER_TXT_0006": "Se acabó la suerte de Cereza.\r\nAcabó condenada a pasar\r\nla eternidad en una jaula\r\nfeérica de ilusiones.",
  "HUD_PURPOSE_TXT_2080": "Destruye el segundo\r\nnúcleo elemental.",
  "HUD_PURPOSE_TXT_1160": "Sigue al lobo.",
  "HUD_PURPOSE_TXT_3050": "Derrota al Jabberwock.",
  "HUD_PURPOSE_TXT_1060": "Llévale el agua a Morgana.",
  "HUD_INTERACT_TEXT_0021_CER": "¡Qué sitio más alto!\r\nEspero no caerme...",
  "HUD_INTERACT_TEXT_0034_CER": "Me encanta ver cómo chisporrotean\r\nlas llamas por la noche.",
  "HUD_ITEMOBTAIN_TEXT_003": "El pétalo de una rosa negra de Inferno.\r\nPosee una tenue energía mágica\r\nque la convierte en la flor predilecta\r\nde las hadas para sus jardines.",
  "HUD_ITEMOBTAIN_TEXT_010": "Perfume de Umbra en un frasco con\r\nforma de luna creciente. Otorga a\r\nCheshire energía mágica ilimitada para\r\nusar técnicas. ¡Puedes prepararla!",
  "HUD_ITEMOBTAIN_TEXT_007": "Ingrediente cristalizado para pociones.\r\nDependiendo del punto de cocción,\r\npuede tener diversos efectos en\r\nquien lo consuma.",
  "HUD_PURPOSE_TXT_4040": "Busca a Cheshire\r\ncon el lobo blanco.",
  "HUD_PREVENT_TEXT_0007_CER": "No... No puedo rendirme ahora.\r\n¡Vamos, Cereza, hazlo por Colm!",
  "HUD_INTERACT_TEXT_0004_CER": "¿Habrá elegido Morgana estas lámparas?\r\n¡Pues creo que tenemos gustos parecidos!",
  "HUD_INTERACT_TEXT_0400_CER": "¿Un lago? ¡No me da ni pizca de miedo!\r\nSoy como un pez en el agua.",
  "HUD_PURPOSE_TXT_7001": "¡Vence a los enemigos antes\r\nde que se acabe el tiempo!",
  "HUD_PURPOSE_TXT_1090": "Llévale las hierbas\r\na Morgana.",
  "HUD_PREVENT_TEXT_0008_CER": "¡Se me ha olvidado la cesta\r\ncon las hierbas! Será mejor no\r\nvolver con las manos vacías...",
  "HUD_INTERACT_TEXT_0011_CER": "No voy al pueblo,\r\n¡sino al bosque de Ávalon!",
  "HUD_PURPOSE_TXT_1190": "Encuentra el segundo\r\nnúcleo elemental."
}
